{
  "sourceLanguage" : "en",
  "strings" : {
    "NSUserTrackingUsageDescription" : {
      "comment" : "App Tracking Transparency prompt shown before personalized ads.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُستخدم بياناتك لعرض إعلانات أكثر صلة بك. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje údaje použijeme k zobrazování relevantnějších reklam. Kdykoli to můžeš změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bruges til at vise dig mere relevante reklamer. Du kan altid ændre det i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden genutzt, um dir passendere Werbung zu zeigen. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα σου θα χρησιμοποιούνται για να σου δείχνουμε πιο σχετικές διαφημίσεις. Μπορείς να το αλλάξεις όποτε θέλεις στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data will be used to show you more relevant ads. You can change this anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaremos tus datos para mostrarte anuncios más relevantes. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietojasi käytetään, jotta voimme näyttää sinulle osuvampia mainoksia. Voit muuttaa tätä milloin tahansa Asetuksissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagamitin ang data mo para magpakita sa iyo ng mas angkop na ads. Puwede mo itong baguhin anumang oras sa Mga Setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données serviront à t'afficher des publicités plus pertinentes. Tu peux changer cela à tout moment dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנתונים שלך ישמשו להצגת פרסומות רלוונטיות יותר. אפשר לשנות את זה בכל עת בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डेटा का इस्तेमाल आपको ज़्यादा काम के विज्ञापन दिखाने के लिए किया जाएगा। इसे कभी भी सेटिंग्स में बदला जा सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adataidat arra használjuk, hogy relevánsabb reklámokat mutassunk neked. Ezt bármikor módosíthatod a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamu akan digunakan untuk menampilkan iklan yang lebih relevan untukmu. Kamu bisa mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati verranno usati per mostrarti annunci più pertinenti. Puoi modificare questa scelta in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
