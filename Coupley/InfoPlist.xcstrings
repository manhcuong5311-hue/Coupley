{
  "sourceLanguage" : "en",
  "strings" : {
    "NSUserTrackingUsageDescription" : {
      "comment" : "App Tracking Transparency prompt shown before personalized ads.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jou data sal gebruik word om vir jou meer relevante advertensies te wys. Jy kan dit enige tyd in Instellings verander."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ውሂብዎ ይበልጥ ተዛማጅ የሆኑ ማስታወቂያዎችን ለማሳየት ጥቅም ላይ ይውላል። ይህን በማንኛውም ጊዜ በቅንብሮች ውስጥ መቀየር ይችላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُستخدم بياناتك لعرض إعلانات أكثر صلة بك. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাক অধিক প্ৰাসংগিক বিজ্ঞাপন দেখুৱাবলৈ আপোনাৰ ডেটা ব্যৱহাৰ কৰা হ'ব। আপুনি যিকোনো সময়তে ছেটিংছত ইয়াক সলনি কৰিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Məlumatların sənə daha uyğun reklamlar göstərmək üçün istifadə olunacaq. Bunu istənilən vaxt Ayarlarda dəyişə bilərsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твае даныя будуць выкарыстоўвацца, каб паказваць табе больш дарэчную рэкламу. Змяніць гэта можна ў любы час у наладах."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните ти ще се използват, за да ти показваме по-подходящи реклами. Можеш да промениш това по всяко време в Настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার ডেটা ব্যবহার করে তোমাকে আরও প্রাসঙ্গিক বিজ্ঞাপন দেখানো হবে। সেটিংস থেকে যেকোনো সময় এটা বদলাতে পারো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji podaci koristit će se za prikaz relevantnijih reklama. Ovo možeš bilo kada promijeniti u Postavkama."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves dades s'utilitzaran per mostrar-te anuncis més rellevants. Ho pots canviar quan vulguis a Configuració."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamiton ang imong data aron pakit-an ka og mas haom nga ads. Mausab nimo kini bisan kanus-a sa Settings."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje údaje použijeme k zobrazování relevantnějších reklam. Kdykoli to můžeš změnit v Nastavení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd dy ddata'n cael ei ddefnyddio i ddangos hysbysebion mwy perthnasol i ti. Gelli di newid hyn unrhyw bryd yn y Gosodiadau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bruges til at vise dig mere relevante reklamer. Du kan altid ændre det i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden genutzt, um dir passendere Werbung zu zeigen. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα σου θα χρησιμοποιούνται για να σου δείχνουμε πιο σχετικές διαφημίσεις. Μπορείς να το αλλάξεις όποτε θέλεις στις Ρυθμίσεις."
