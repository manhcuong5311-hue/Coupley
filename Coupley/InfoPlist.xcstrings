        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої дані використовуватимуться, щоб показувати тобі релевантнішу рекламу. Це можна будь-коли змінити в Налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của bạn sẽ được dùng để hiển thị quảng cáo phù hợp hơn với bạn. Bạn có thể thay đổi lựa chọn này bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
