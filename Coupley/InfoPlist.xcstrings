        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données serviront à t'afficher des publicités plus pertinentes. Tu peux changer cela à tout moment dans Réglages."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsáidfear do shonraí chun fógraí níos ábhartha a thaispeáint duit. Is féidir leat é seo a athrú am ar bith sna Socruithe."
