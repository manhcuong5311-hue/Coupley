        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારો ડેટા તમને વધુ સુસંગત જાહેરાતો બતાવવા માટે વપરાશે. તમે સેટિંગ્સમાં ક્યારેય પણ આ બદલી શકો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za a yi amfani da bayananku don nuna muku tallace-tallace masu dacewa. Kuna iya canja wannan a kowane lokaci a Saituna."
