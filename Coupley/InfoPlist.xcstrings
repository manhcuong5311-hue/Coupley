        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji podaci koristit će se za prikaz relevantnijih oglasa. To možeš promijeniti u bilo kojem trenutku u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adataidat arra használjuk, hogy relevánsabb reklámokat mutassunk neked. Ezt bármikor módosíthatod a Beállításokban."
