        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden gebruikt om je relevantere advertenties te tonen. Je kunt dit altijd wijzigen in Instellingen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinthu zanu zidzagwiritsidwa ntchito kukuonetsani zotsatsa zogwirizana nanu kwambiri. Mutha kusintha izi nthawi iliyonse mu Zokonda."
