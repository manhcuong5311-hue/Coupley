        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorenost za promjenu, ali unutar poznate kulture. Želiš novi početak bez neizvjesnosti potpunog preseljenja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvè pou chanjman men nan yon kilti ou konnen. Ou vle yon nouvo kòmansman san tout ensètitid yon gwo demenajman."
