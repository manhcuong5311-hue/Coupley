    "Good moods are great for making plans stick." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزاج الجيد مثالي لخطط تصمد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány udělané v dobré náladě mají větší šanci vyjít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt humør er perfekt til at lave planer, der holder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In guter Stimmung gefasste Pläne halten besser."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με καλή διάθεση τα σχέδια πιάνουν πιο εύκολα."
