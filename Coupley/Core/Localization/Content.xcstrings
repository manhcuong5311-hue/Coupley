        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପିଜା ଉପରେ ଏକ ସୂକ୍ଷ୍ମ ମତ। ଆପଣ ସମ୍ଭବତଃ ଜୀବନର ଅଧିକାଂଶ ପ୍ରଶ୍ନରେ ଏହିପରି ସର୍ତ୍ତସାପେକ୍ଷ ଭାବନା ରଖନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੀਜ਼ਾ ਬਾਰੇ ਬਾਰੀਕ ਸੋਚ। ਸ਼ਾਇਦ ਤੁਸੀਂ ਜ਼ਿੰਦਗੀ ਦੇ ਜ਼ਿਆਦਾਤਰ ਸਵਾਲਾਂ ਉੱਤੇ ਇਸੇ ਤਰ੍ਹਾਂ ਸ਼ਰਤਾਂ ਵਾਲੀ ਸੋਚ ਵਰਤਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
