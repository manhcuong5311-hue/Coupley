        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чечимге багытталгансың. Мамилени талаштан чоң көрөсүң. Бул чыныгы күч."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gees op eng Léisung aus. Fir dech ass är Bezéiung méi grouss wéi de Sträit. Dat ass eng richteg Stäerkt."
