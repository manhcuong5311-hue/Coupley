        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaqiqa. Iintsapho ezahlukeneyo zifuna iindlela ezahlukeneyo. Into ebalulekileyo kukuba nobabini nivumelana."
