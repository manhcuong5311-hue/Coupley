        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခက်ခဲတယ်ထင်တဲ့ အရာ — လူထုရှေ့ စကားပြော၊ ကိုယ်ယုံကြည်မှု"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe jeg synes er vanskelig – snakke foran folk, selvtillit"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मलाई गाह्रो लाग्ने कुरा — सार्वजनिक बोलाइ, आत्मविश्वास"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets wat ik lastig vind – spreken, zelfvertrouwen"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chinthu chimene chimandivuta — kulankhula pagulu, chidaliro"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan natti ulfaatu — ummata duratti dubbachuu, of amanuu"
