          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്വന്തം തീരുമാനം കൊണ്ടോ സാഹചര്യം കൊണ്ടോ സ്വതന്ത്രർ. തുടങ്ങിയിടത്തുനിന്ന് ഏറെക്കുറെ വേറിട്ട് നിങ്ങൾ സ്വന്തം കഥ എഴുതിയിരിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сонголтоор эсвэл аргагүй байдлаар бие даасан. Чи эхэлсэн газраасаа ихээхэн тусдаа өөрийн түүхээ бичсэн."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वभावाने किंवा गरजेपोटी स्वतंत्र. जिथून सुरुवात झाली, त्यापासून बऱ्याच अंशी वेगळी अशी स्वतःची कहाणी तुम्ही लिहिली आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdikari sama ada kerana pilihan atau keperluan. Anda menulis kisah sendiri yang sebahagian besarnya terpisah daripada titik permulaan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendenza, bl-għażla jew bil-bżonn. Ktibt l-istorja tiegħek fil-biċċa l-kbira separata minn fejn bdejt."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရွေးချယ်မှုကြောင့်ဖြစ်ဖြစ် လိုအပ်ချက်ကြောင့်ဖြစ်ဖြစ် လွတ်လပ်တယ်။ စတင်ခဲ့တဲ့ နေရာနဲ့ အများအားဖြင့် သီးခြားစွာ ကိုယ့်ဇာတ်လမ်းကို ကိုယ်ရေးခဲ့တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvstendig av valg eller nødvendighet. Du har skrevet din egen historie, stort sett løsrevet fra der du startet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोजाइले वा बाध्यताले स्वतन्त्र। तपाईंले आफ्नो कथा सुरु भएको ठाउँभन्दा धेरै हदसम्म अलग लेख्नुभएको छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onafhankelijk, uit keuze of uit noodzaak. Je hebt je eigen verhaal grotendeels los van je afkomst geschreven."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wodziimira mwakufuna kapena mosowa chochita. Mwalemba nkhani yanu kwambiri padera ndi kumene munayambira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filannoon ykn dirqamaan walaba. Seenaa kee ofii, bakka itti jalqabde irraa baay'ee adda taasistee barreessite."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଇଚ୍ଛାରେ ହେଉ କି ଦରକାରରେ, ସ୍ୱାଧୀନ। ଆପଣ ଯେଉଁଠୁ ଆରମ୍ଭ କରିଥିଲେ, ତାଠାରୁ ଅନେକାଂଶରେ ଅଲଗା ହୋଇ ନିଜ କାହାଣୀ ନିଜେ ଲେଖିଛନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੀ ਮਰਜ਼ੀ ਜਾਂ ਮਜਬੂਰੀ ਨਾਲ ਆਤਮ-ਨਿਰਭਰ। ਤੁਸੀਂ ਆਪਣੀ ਕਹਾਣੀ ਜ਼ਿਆਦਾਤਰ ਆਪਣੀ ਸ਼ੁਰੂਆਤ ਤੋਂ ਵੱਖਰੀ ਲਿਖੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezależność z wyboru lub z konieczności. Swoją historię piszesz w dużej mierze z dala od miejsca, z którego wychodzisz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خپلواکي — د انتخاب یا اړتیا له مخې. تاسو خپله کیسه تر ډېره بریده د خپل پیل له ځای جلا لیکلې ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independência por escolha ou por necessidade. Você escreveu sua história bem longe de onde começou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independência por escolha ou por necessidade. Escreveste a tua história em grande parte longe de onde começaste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independență din alegere sau din necesitate. Ți-ai scris povestea în mare parte separat de locul de unde ai pornit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Независимость — по выбору или по необходимости. Ты пишешь свою историю во многом отдельно от того, с чего всё начиналось."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wigenga ku bushake cyangwa ku bw'impamvu. Wanditse inkuru yawe ahanini itandukanye n'aho watangiriye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කැමැත්තෙන් හෝ අවශ්‍යතාවෙන් ස්වාධීනයි. ඔබ පටන් ගත්ත තැනින් වැඩි දුරට වෙන්වෙලා ඔබේම කතාව ලියලා තියෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezávislosť z presvedčenia alebo z nutnosti. Svoj príbeh píšeš prevažne oddelene od toho, kde sa začal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neodvisnost po izbiri ali iz nuje. Svojo zgodbo pišeš večinoma ločeno od tega, kje se je začela."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakazvimiririra nekuda kana nekumanikidzwa. Wakanyora nyaya yako yakasiyana zvikuru nekwawakatangira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madax-bannaan, doorasho ama baahi ha ahaatee. Sheekadaada waxaad u qortay si inta badan ka go'an meeshii aad ka bilowday."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pavarësi nga zgjedhja ose nga nevoja. E ke shkruar historinë tënde kryesisht larg nga vendi ku nise."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Независност по избору или из нужде. Своју причу пишеш углавном одвојено од места где је почела."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandiri, boh ku pilihan boh ku kaayaan. Anjeun parantos nyerat carita sorangan, lolobana misah ti tempat anjeun ngamimitian."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självständig av val eller nödvändighet. Du har skrivit din egen historia, till stor del fristående från där du började."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huru kwa makusudi au kwa ulazima. Umeandika hadithi yako mwenyewe kwa kiasi kikubwa mbali na ulikoanzia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விருப்பத்தாலோ தேவையாலோ சுயமாக நிற்பவர். நீங்கள் தொடங்கிய இடத்திலிருந்து பெரும்பாலும் தனியாக உங்கள் கதையை எழுதியிருக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇష్టంతోనో, అవసరంతోనో స్వతంత్రులయ్యారు. మీరు మొదలైన చోటుకు చాలావరకు దూరంగా, మీ కథను మీరే రాసుకున్నారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мустақил аз рӯи интихоб ё зарурат. Ту қиссаи худро асосан ҷудо аз он ҷое, ки оғоз карда будӣ, навиштаӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อิสระโดยเลือกเองหรือด้วยความจำเป็น คุณเขียนเรื่องราวของตัวเองแยกจากจุดเริ่มต้นเป็นส่วนใหญ่"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብምርጫ ወይ ብግዲ ናጻ። ካብቲ ዝጀመርኩምሉ ብብዙሕ ተፈሊኹም ናይ ገዛእ ርእስኹም ታሪኽ ጽሒፍኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Islegiň ýa-da zerurlyk sebäpli garaşsyz. Öz hekaýaňy başlan ýeriňden köp babatda aýry ýazdyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteyerek ya da mecburen bağımsız. Hikâyeni büyük ölçüde başladığın yerden ayrı yazdın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незалежність — з вибору чи з потреби. Ти пишеш свою історію здебільшого окремо від того, з чого все почалося."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوچ سمجھ کر یا مجبوری میں خود مختاری۔ آپ نے اپنی کہانی زیادہ تر اپنی ابتدا سے الگ رہ کر لکھی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanlov yoki zarurat tufayli mustaqil. Oʻz hikoyangizni boshlagan joyingizdan ancha alohida yozgansiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độc lập vì lựa chọn hoặc vì hoàn cảnh. Bạn đã tự viết nên câu chuyện của mình, phần lớn tách biệt khỏi nơi mình bắt đầu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazimela ngokuzikhethela okanye ngokuyimfuneko. Ubhale elakho ibali ngokwahlukileyo kakhulu kwapho waqala khona."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Òmìnira, bóyá nípa yíyàn tàbí nípa dandan. Ẹ ti kọ ìtàn tiyín, tó yàtọ̀ púpọ̀ sí ibi tí ẹ ti bẹ̀rẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因選擇或因需要而獨立。你寫下的故事，大部分跟你的起點無關。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不管是出于选择还是不得已，你都很独立。你的故事基本是自己写的，和起点关系不大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不論是出於選擇還是不得不，你都很獨立。你的故事大多是自己寫的，和起點沒有太大關係。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzimele ngokukhetha noma ngenxa yesidingo. Ubhale indaba yakho ngokwehlukana kakhulu nalapho waqala khona."
          }
        }
      }
    },
