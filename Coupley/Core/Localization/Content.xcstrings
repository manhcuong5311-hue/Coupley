        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekerjasama itu sendiri romantik. Dapur menjadi masa berkualiti tersendiri — dan anda dapat hidangan pada akhirnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kollaborazzjoni bħala rumanz. Il-kċina ssir tip ta' ħin ta' kwalità waħedha — u fl-aħħar ikollkom ikla."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အတူလုပ်ခြင်းကိုယ်တိုင်က အချစ်ပါ။ မီးဖိုချောင်က အတူရှိချိန် တစ်မျိုး ဖြစ်လာတယ် — နောက်ဆုံးမှာ ထမင်းတစ်နပ်လည်း ရတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samarbeid som romantikk. Kjøkkenet blir sin egen form for kvalitetstid – og dere får et måltid til slutt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहकार्य नै रोमान्स। भान्सा आफैँमा गुणस्तरीय समय बन्छ — र अन्त्यमा खाना पनि पाइन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samenwerken als romantiek. Koken wordt zo een eigen vorm van tijd samen – en aan het eind heb je ook nog een maaltijd."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugwirira ntchito limodzi ngati chikondi. Khitchini imakhala nthawi yabwino limodzi — ndipo pamapeto mumapeza chakudya."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waliin hojjechuu akka jaalalaatti. Kushiniin ofii isaatiin yeroo gaarii waliinii ta'a — dhuma irrattis nyaata argattu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସହଯୋଗ ହିଁ ରୋମାନ୍ସ। ରୋଷେଇଘର ନିଜେ ଏକ ପ୍ରକାର ଗୁଣାତ୍ମକ ସମୟ ହୋଇଯାଏ — ଆଉ ଶେଷରେ ଖାଇବାକୁ ମିଳେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਿਲ ਕੇ ਕੰਮ ਕਰਨਾ ਹੀ ਰੋਮਾਂਸ ਹੈ। ਰਸੋਈ ਆਪਣੇ ਆਪ ਵਿੱਚ ਇਕੱਠੇ ਬਿਤਾਇਆ ਖ਼ਾਸ ਸਮਾਂ ਬਣ ਜਾਂਦੀ ਹੈ — ਅਤੇ ਅਖ਼ੀਰ ਵਿੱਚ ਖਾਣਾ ਵੀ ਮਿਲਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współpraca jako romantyzm. Kuchnia staje się waszym wspólnym czasem – a na koniec jest jeszcze posiłek."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همکاري د مینې په توګه. پخلنځی پخپله د ګډ ارزښتناک وخت ځای کېږي — او په پای کې یو خوراک هم لرئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parceria como romance. A cozinha vira um tempo de qualidade — e ainda rende uma refeição no fim."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A colaboração como romance. A cozinha torna-se tempo de qualidade à sua maneira — e no fim ainda há jantar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colaborarea ca formă de romantism. Bucătăria devine un fel de timp petrecut împreună — și la final aveți și o masă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместное дело как романтика. Кухня становится особым временем вдвоём — а в конце ещё и вкусный ужин."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gufatanya nk'urukundo. Igikoni gihinduka igihe cyiza muri kumwe — kandi mukarangiza mufite ifunguro."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එක්ව වැඩ කිරීමම ආදරයක්. කුස්සිය එක්ව ගත කරන කාලයේ වෙනම විදිහක් වෙනවා — අන්තිමට කෑමකුත් ලැබෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolupráca ako romantika. Z kuchyne sa stane vlastný druh času spolu – a na konci máte jedlo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodelovanje kot romantika. Kuhinja postane svojevrsten skupni čas – na koncu pa še obrok."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushanda pamwe chete serudo. Kicheni inova nguva yakakosha yayo pachayo — uye munowana chikafu pakupedzisira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskaashi sida jacayl. Jikadu waxay noqotaa nooc gaar ah oo waqti tayo leh — dhammaadkana cunto ayaad helaysaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bashkëpunimi si romancë. Kuzhina bëhet një lloj kohe cilësore më vete – dhe në fund keni edhe një vakt."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сарадња као романтика. Кухиња постаје посебна врста квалитетног времена — а на крају добијете и оброк."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gawé bareng salaku romansa. Dapur janten waktos babarengan anu istiméwa — sareng pamustunganana aya tuangeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samarbete som romantik. Köket blir en egen sorts kvalitetstid – och ni får en middag på köpet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushirikiana kama mapenzi. Jiko linakuwa aina yake ya muda wa pamoja — na mwishoni mnapata mlo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைந்து செய்வதே காதல். சமையலறை ஒரு வகை தரமான நேரமாகிறது — முடிவில் ஒரு சாப்பாடும் கிடைக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కలిసి చేయడమే రొమాన్స్. వంటగది కలిసి గడిపే ప్రత్యేక సమయంగా మారుతుంది — చివరికి భోజనం కూడా దొరుకుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳамкорӣ ҳамчун ошиқона. Ошхона ба як навъ вақти пурмазмун табдил меёбад — ва дар охир таом ҳам доред."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การร่วมมือกันก็โรแมนติกได้ ห้องครัวกลายเป็นเวลาคุณภาพอีกแบบหนึ่ง และยังได้อาหารอร่อยๆ ในตอนท้าย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምትሕግጋዝ ከም ፍቕሪ። ክሽነ ባዕሉ ዓይነት ፍሉይ ግዜ ይኸውን — ኣብ መወዳእታ ድማ መግቢ ትረኽቡ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bile işlemek — romantika. Aşhana bile geçirilýän aýratyn wagta öwrülýär — soňunda hem nahar bar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte üretmek de romantizmdir. Mutfak, baş başa geçirilen özel bir zamana dönüşüyor ve sonunda bir de yemeğiniz oluyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтика — у спільній справі. На кухні народжується своя особлива близькість — а наприкінці ще й смачна вечеря."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مل کر کام کرنا بھی رومانس ہے۔ باورچی خانہ ساتھ گزارے وقت کی اپنی ایک شکل بن جاتا ہے — اور آخر میں کھانا بھی ملتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamkorlik — romantika sifatida. Oshxona oʻziga xos birga vaqt oʻtkazish joyiga aylanadi — oxirida esa mazali taom ham boʻladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng nhau làm cũng là lãng mạn. Căn bếp trở thành thời gian bên nhau theo cách riêng — và cuối cùng còn có một bữa ngon."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukusebenzisana njengothando. Ikhitshi liba luhlobo lwalo lwexesha elikumgangatho — kwaye nifumana isidlo ekugqibeleni."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iṣẹ́ àjọṣe bí ìfẹ́. Ilé ìdáná di irú àkókò pàtàkì papọ̀ kan — oúnjẹ sì ń dúró dè yín ní ìparí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合作就是浪漫。廚房變成另一種優質時間，最後還有一頓飯可以吃。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合作就是浪漫。厨房成了另一种陪伴时光——最后还能吃上一顿饭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合作就是浪漫。廚房變成另一種相處時光，最後還有一頓飯可以吃。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukusebenzisana njengothando. Ikhishi liba wuhlobo lwalo lwesikhathi esikhethekile — futhi nithola ukudla ekugcineni."
          }
        }
      }
    },
