        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azịza nwere nghọta — ọ na-abụkarịkwa nke kacha mma. Ọnụ ebe ọ dị mkpa, iche ebe ọ bara uru."
