        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut, das früh zu wissen – es prägt, wo ihr esst, was ihr kocht und vielleicht auch, worauf sich dein Schatz einstellen mag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλό είναι να ειπωθεί νωρίς — καθορίζει πού τρώτε, τι μαγειρεύετε και ίσως σε τι είναι διατεθειμένο να προσαρμοστεί το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conviene saberlo pronto — define dónde comen los dos, qué cocinan y, quizá, a qué está dispuesta a adaptarse tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvä tietää ajoissa – se vaikuttaa siihen, missä syötte, mitä kokkaatte ja ehkä siihen, mihin kumppanisi on valmis mukautumaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magandang malaman nang maaga — hinuhubog nito kung saan kayo kakain, ano ang lulutuin, at posibleng kung ano ang handang i-adjust ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon à savoir tôt : ça influence où vous mangez, ce que vous cuisinez, et peut-être jusqu'où l'autre acceptera de s'adapter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לדעת את זה מוקדם — זה משפיע על איפה אוכלים, מה מבשלים, ואולי גם על מה שהצד השני יהיה מוכן להתאים את עצמו אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह शुरू में ही जान लेना अच्छा है — इसी से तय होता है कि कहाँ खाना है, क्या पकाना है, और शायद आपके पार्टनर को किन बातों में ढलना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt jó korán tisztázni – meghatározza, hol esztek, mit főztök, és hogy a párod mennyire hajlandó alkalmazkodni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baik diketahui sejak awal — ini menentukan tempat makan, apa yang dimasak, dan mungkin seberapa jauh pasanganmu mau menyesuaikan diri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meglio saperlo presto — influenza dove mangiate, cosa cucinate e forse anche quanto il tuo partner è disposto ad adattarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早めに伝えておきたいこと。どこで食べるか、何を作るか、そしてパートナーがどこまで合わせられるかにも関わってきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일찍 알아 두면 좋아요. 어디서 먹을지, 무엇을 요리할지, 그리고 연인이 얼마나 맞춰 줄 수 있을지에도 영향을 주니까요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elok diketahui awal — ia menentukan tempat makan, apa yang dimasak, dan mungkin sejauh mana pasangan anda sanggup menyesuaikan diri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greit å vite tidlig – det former hvor dere spiser, hva dere lager, og kanskje hva partneren din er villig til å tilpasse seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed om vroeg te weten – het bepaalt waar je eet, wat je kookt en misschien waar je partner zich aan wil aanpassen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warto o tym powiedzieć wcześnie – to wpływa na to, gdzie jecie, co gotujecie i do czego twoja druga połówka będzie chciała się dostosować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale saber logo no começo — isso define onde vocês comem, o que cozinham e talvez o quanto seu amor topa se adaptar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E bine de știut devreme — influențează unde mâncați, ce gătiți și, poate, la ce e dispus partenerul tău să se adapteze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это лучше обсудить пораньше: от этого зависит, где вы едите, что готовите и насколько партнёру придётся подстраиваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bra att veta tidigt – det styr var ni äter, vad ni lagar och kanske vad din partner är beredd att anpassa sig till."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควรรู้กันตั้งแต่เนิ่นๆ เพราะเรื่องนี้กำหนดว่าจะไปกินที่ไหน ทำอาหารอะไร และอาจรวมถึงว่าคนรักพร้อมจะปรับตัวแค่ไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenden bilinmesi iyi olur; nerede yediğini, ne pişirdiğini ve belki partnerinin neye uyum sağlamaya hazır olduğunu belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це варто знати одразу — від цього залежить, де ви їсте, що готуєте і до чого, можливо, готова пристосуватися твоя половинка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nên biết sớm — nó quyết định hai bạn ăn ở đâu, nấu món gì, và có thể cả việc người ấy sẵn lòng thay đổi đến đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好早点说清楚。它会影响你们去哪儿吃、在家做什么，也可能关系到另一半愿意配合多少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好早點讓對方知道，這會影響你們去哪吃、煮什麼，也關係到另一半願意調整多少。"
          }
        }
      }
    },
    "Worth thinking about together. Supporting each other's wellbeing is one of the best things couples can do." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستحق التفكير فيه معًا. دعم كل منكما لعافية الآخر من أجمل ما يمكن أن يفعله الثنائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stojí za to o tom přemýšlet spolu. Podporovat se navzájem v duševní pohodě je jedna z nejlepších věcí, které pár může dělat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værd at tænke over sammen. At støtte hinandens trivsel er noget af det bedste, et par kan gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denkt gemeinsam darüber nach. Sich gegenseitig beim Wohlbefinden zu unterstützen, gehört zum Besten, was ein Paar tun kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αξίζει να το σκεφτείτε μαζί. Το να στηρίζει ο ένας την ευεξία του άλλου είναι από τα καλύτερα που μπορεί να κάνει ένα ζευγάρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena pensarlo juntos. Apoyarse en el bienestar mutuo es de lo mejor que puede hacer una pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä kannattaa miettiä yhdessä. Toistensa hyvinvoinnin tukeminen on parhaita asioita, mitä pari voi tehdä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magandang pag-isipan nang magkasama. Ang pagsuporta sa kapakanan ng isa’t isa ay isa sa pinakamagandang magagawa ng mag-partner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une piste à explorer ensemble. Prendre soin du bien-être l'un de l'autre est l'une des plus belles choses qu'un couple puisse faire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שווה לחשוב על זה יחד. לתמוך זה ברווחה של זה הוא אחד הדברים הכי טובים שזוג יכול לעשות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पर साथ मिलकर सोचना अच्छा रहेगा। एक-दूसरे की ख़ुशहाली में साथ देना, कपल के लिए सबसे अच्छी चीज़ों में से एक है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érdemes együtt átgondolni. Egymás jóllétének támogatása az egyik legjobb dolog, amit egy pár tehet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layak dipikirkan bersama. Saling mendukung kesejahteraan adalah salah satu hal terbaik yang bisa dilakukan pasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena pensarci insieme. Sostenere il benessere l’uno dell’altro è una delle cose migliori che una coppia possa fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで考えてみる価値があります。お互いの心身の健康を支え合うことは、カップルにできる最高のことのひとつです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 생각해 보면 좋아요. 서로의 건강과 행복을 챙기는 건 커플이 할 수 있는 최고의 일 중 하나예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elok difikirkan bersama. Saling menyokong kesejahteraan antara perkara terbaik yang boleh dilakukan pasangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdt å tenke på sammen. Å støtte hverandres trivsel er noe av det beste et par kan gjøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed om samen over na te denken. Elkaars welzijn steunen is een van de mooiste dingen die je als stel kunt doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warto pomyśleć o tym razem. Wspieranie wzajemnego dobrostanu to jedna z najlepszych rzeczy, jakie para może dla siebie zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale pensar nisso juntos. Apoiar o bem-estar um do outro é uma das melhores coisas que um casal pode fazer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merită să vă gândiți împreună. Să vă sprijiniți reciproc starea de bine e unul dintre cele mai bune lucruri pe care le poate face un cuplu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об этом стоит подумать вместе. Поддерживать благополучие друг друга — едва ли не лучшее, что может делать пара."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värt att fundera på tillsammans. Att stötta varandras välmående är något av det bästa ett par kan göra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น่าคิดเรื่องนี้ไปด้วยกัน การดูแลความเป็นอยู่ที่ดีของกันและกันคือหนึ่งในสิ่งที่ดีที่สุดที่คู่รักทำให้กันได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte düşünmeye değer. Birbirinin iyi oluşunu desteklemek, çiftlerin yapabileceği en güzel şeylerden biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варто подумати про це разом. Дбати про самопочуття одне одного — одна з найкращих речей, які може робити пара."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đáng để hai bạn cùng nghĩ. Chăm lo cho sức khỏe tinh thần của nhau là một trong những điều tuyệt nhất các cặp đôi có thể làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得一起想一想。互相照顾彼此的身心状态，是情侣能为彼此做的最好的事之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得兩人一起想想。支持彼此的身心健康，是情侶能為彼此做的最好的事之一。"
          }
        }
      }
    },
