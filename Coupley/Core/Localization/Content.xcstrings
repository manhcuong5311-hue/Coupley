        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉවුම් පිහුම් තනිවම ආදර භාෂාවක්. ගෙදර හදපු කෑමක් අගය කරන සහකරුවෙක් තමයි ඔබේ පරිපූර්ණ ප්‍රේක්ෂකයා."
