        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවසාන අදියර ඔබ හිතන හැටියෙන්, ඔබ දැන් අගය කරන දේ ගැන ගොඩක් දේ හෙළි වෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, ako si predstavuješ záver, veľa prezrádza o tom, čo si ceníš dnes."
