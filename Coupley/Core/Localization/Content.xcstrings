        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengeli. İşinle gurur duyuyorsun ama içinde kaybolmuyorsun. Bu konuda muhtemelen birlikte olması kolay birisin."
