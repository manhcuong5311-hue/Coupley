    "Join them wherever they are. Don't fill the air — just be there." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضموا إلى شريكك أينما كان. لا تملؤوا الأجواء بالكلام، فقط كونوا هناك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej se k protějšku, ať je kdekoli. Nevyplňuj ticho – prostě buď nablízku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dig ned, hvor din partner er. Du behøver ikke fylde stilheden – bare vær der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh dahin, wo dein Schatz gerade ist. Füll die Stille nicht – sei einfach da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πήγαινε δίπλα στο ταίρι σου, όπου κι αν είναι. Μη γεμίζεις τη σιωπή — απλώς να είσαι εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a donde esté tu pareja. No llenes el silencio: solo quédate ahí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liity hänen seuraansa, missä hän onkin. Älä täytä hiljaisuutta – ole vain läsnä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samahan siya kung nasaan man siya. Hindi kailangang punuin ang katahimikan — nandiyan ka lang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va retrouver l'autre, où que ce soit. Pas besoin de meubler : sois juste là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להצטרף, איפה שזה לא יהיה. לא למלא את השקט — פשוט להיות שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे जहाँ हों, वहीं उनके पास चले जाएँ। बातों से ख़ामोशी न भरें — बस साथ रहें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozz hozzá, bárhol is van. Ne töltsd ki a csendet – csak légy ott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temani dia di mana pun dia berada. Tak perlu mengisi suasana — cukup ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungi il tuo partner ovunque sia. Non riempire il silenzio — stai lì e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーのいるところへ行って、無理に話さず、ただそばにいましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인이 있는 곳으로 가서 함께해 주세요. 굳이 말로 채우지 않아도 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temani dia di mana saja dia berada. Tak perlu isi kesunyian — hadir saja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med der partneren din er. Ikke fyll stillheten – bare vær der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga bij je partner zitten, waar die ook is. Vul de stilte niet – wees er gewoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do drugiej połówki, gdziekolwiek jest. Nie zagaduj ciszy – po prostu bądź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça companhia onde seu amor estiver. Não precisa falar — só esteja ali."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mergi lângă partenerul tău, oriunde ar fi. Nu umple tăcerea — doar fii acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь там же, где партнёр. Не заполняй тишину — просто будь рядом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dig ner där din partner är. Fyll inte tystnaden – bara var där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไปอยู่ข้างๆ คนรักไม่ว่าจะอยู่ตรงไหน ไม่ต้องหาเรื่องคุย แค่อยู่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede olursa olsun yanına git. Sessizliği doldurmaya çalışma, sadece orada ol."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто приєднайся до половинки, де б вона не була. Не заповнюй тишу — просто будь поруч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đến bên người ấy dù đang ở đâu. Không cần lấp đầy khoảng lặng — chỉ cần ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去另一半身边待着。不用找话说，在就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去對方身邊就好。不用找話題，陪著就夠了。"
          }
        }
      }
    },
