    "Anxious processing. Your mind works through repetition and what-ifs. A grounding partner who doesn't dismiss the anxiety helps most." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angstige verwerking. Jou kop werk deur herhaling en “wat as”. ’n Kalm maat wat die angs nie afmaak nie, help die meeste."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በጭንቀት ማስተናገድ። አእምሮዎ በመደጋገምና «ቢሆንስ?» በሚሉ ሀሳቦች ይሠራል። ጭንቀትዎን ችላ የማይሉና የሚያረጋጉዎት አጋር ከሁሉ በላይ ይረዳሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معالجة قلقة. عقلك يعمل بالتكرار و«ماذا لو». أكثر ما يساعدك شريك يمنحك الثبات ولا يستخفّ بقلقك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উদ্বিগ্ন মন। আপোনাৰ মনে বাৰে বাৰে ভাবি আৰু “যদি এনে হয়” ভাবি কথাবোৰ বুজে। উদ্বেগক উৰুৱাই নিদিয়া, শান্ত কৰি ৰখা সংগী এজনে আটাইতকৈ বেছি সহায় কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narahat düşüncə. Ağlın təkrarlar və “bəs əgər…” sualları ilə işləyir. Narahatlığını yüngül saymayan, səni sakitləşdirən partnyor ən çox kömək edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трывожнае асэнсаванне. Твой розум працуе праз паўторы і «а што, калі». Найлепш дапамагае палавінка, якая супакойвае і не адмахваецца ад трывогі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тревожно осмисляне. Умът ти работи чрез повторения и „ами ако“. Най-много помага половинка, която те успокоява, без да омаловажава тревогата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উদ্বেগের মধ্য দিয়ে বোঝা। তোমার মন বারবার ভেবে আর “যদি এমন হয়” দিয়ে সবটা পার করে। এমন পার্টনারই সবচেয়ে বেশি সাহায্য করে, যে তোমাকে স্থির রাখে আর উদ্বেগটাকে উড়িয়ে দেয় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anksiozno premetanje misli. Um ti radi kroz ponavljanje i ‚šta ako’. Najviše pomaže smirena voljena osoba koja tvoju zabrinutost ne odbacuje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processes amb ansietat. La teva ment funciona a base de repetir i de «i si…?». El que més t'ajuda és una parella que et calmi sense menystenir la teva ansietat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úzkostné zpracovávání. Tvoje mysl to přemílá dokola a ptá se „co kdyby“. Nejvíc pomůže protějšek, který tě uzemní a úzkost nezlehčuje."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosesu pryderus. Mae dy feddwl yn gweithio drwy ailadrodd a ‘beth os’. Partner sy'n dy sadio heb wfftio'r pryder sy'n helpu fwyaf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ængstelig bearbejdning. Dit sind arbejder gennem gentagelser og »hvad nu hvis«. En jordnær partner, der ikke afviser uroen, hjælper mest."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verarbeitest über Sorgen. Dein Kopf arbeitet mit Wiederholung und ‚Was wäre, wenn‘. Am meisten hilft ein Mensch, der dich erdet, ohne deine Angst abzutun."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγχώδης επεξεργασία. Το μυαλό σου δουλεύει με επανάληψη και «κι αν…». Βοηθάει πιο πολύ ένα ταίρι που σε γειώνει χωρίς να υποτιμά το άγχος σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesas con ansiedad. Tu mente avanza a base de repetir y de “¿y si…?”. Lo que más te ayuda es una pareja que te centre sin restarle importancia a tu ansiedad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ärev läbitöötamine. Su mõistus käib asju läbi korduste ja „mis siis, kui“ mõtete kaudu. Kõige rohkem aitab rahulik partner, kes ärevust ei pisenda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antsietatez prozesatzen duzu. Zure buruak errepikapenaren eta «eta baldin eta…» guztien bidez lan egiten du. Antsietatea gutxietsi gabe lurrera ekartzen zaituen bikotekidea da laguntzarik onena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هضم کردن با نگرانی. ذهنت با تکرار و «اگرها» کار می‌کند. پارتنری که آرامت کند و نگرانی‌ات را کوچک نشمارد، بیشترین کمک را می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahdistunutta käsittelyä. Mielesi työstää asioita toistamalla ja entä jos -ajatuksilla. Eniten auttaa rauhoittava kumppani, joka ei vähättele huolta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagpoproseso ka sa pag-aalala. Gumagana ang isip mo sa pag-uulit at mga “paano kung”. Pinakamakakatulong ang partner na nagpapakalma at hindi binabalewala ang pag-aalala mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fonctionnement anxieux. Ton esprit avance par répétition et par « et si… ». Ce qui t'aide le plus, c'est quelqu'un d'apaisant qui ne minimise pas ton anxiété."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próiseáil imníoch. Oibríonn d’intinn trí athrá agus “cad a tharlódh dá…”. Is mó a chabhraíonn páirtí socair nach ndéanann beag den imní."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesamento ansioso. A túa mente traballa a base de repeticións e «e se…?». O que máis axuda é unha parella que te ancore sen quitarlle importancia á ansiedade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચિંતાથી વિચારવું. તમારું મન વારંવાર વિચારીને અને “જો આમ થાય તો?”માંથી પસાર થાય છે. ચિંતાને અવગણ્યા વગર તમને સ્થિર રાખે એવા પાર્ટનર સૌથી વધુ મદદ કરે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunani cike da fargaba. Hankalinku na aiki ta maimaitawa da tambayoyin “idan fa…?”. Abokin zama mai kwantar da hankali wanda ba ya watsi da fargabarku ne ya fi taimakawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיבוד דרך חרדה. הראש שלך עובד דרך חזרות ו\"מה אם\". הכי עוזר מישהו שמקרקע ולא מבטל את החרדה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चिंता के साथ सुलझाना। आपका मन बार-बार सोचकर और “अगर ऐसा हुआ तो” से गुज़रकर चीज़ें समझता है। सबसे ज़्यादा मदद उस पार्टनर से मिलती है जो आपको सँभाले और आपकी चिंता को हल्के में न ले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjeskobno prorađivanje. Um ti radi kroz ponavljanje i „što ako”. Najviše pomaže smirena voljena osoba koja ne odbacuje tvoju tjeskobu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou dijere ak enkyetid. Tèt ou travay ak repetisyon ak “e si…”. Yon patnè ki ancre ou san li pa meprize enkyetid ou, se sa ki ede pi plis."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szorongva dolgozod fel. Az elméd ismétléssel és „mi lenne, ha” kérdésekkel birkózik. Leginkább egy földön járó társ segít, aki nem söpri le a szorongásod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անհանգիստ մարսում։ Միտքդ աշխատում է կրկնությունների ու «իսկ եթե»-ների միջոցով։ Ամենից շատ օգնում է հանգստացնող զուգընկերը, ով չի արհամարհում անհանգստությունդ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memproses dengan cemas. Pikiranmu bekerja lewat pengulangan dan ‘bagaimana kalau’. Pasangan yang menenangkan tanpa meremehkan kecemasanmu paling membantu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eji nchegbu aghọta ihe. Uche gị na-arụ ọrụ site n'ikwughachi na ‘ọ bụrụ na…’. Onye na-eme ka obi dajụọ gị ma ghara ileda nchegbu ahụ anya na-enyere aka kacha."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvíðin úrvinnsla. Hugurinn vinnur í gegnum endurtekningar og „hvað ef“. Mest hjálpar maki sem veitir jarðtengingu og gerir ekki lítið úr kvíðanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elaborazione ansiosa. La tua mente lavora per ripetizioni e «e se…». Ti aiuta di più un partner che ti tiene con i piedi per terra senza sminuire l’ansia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不安を通して整理するタイプです。くり返しや「もしも」で考えを進めます。不安を軽く扱わず、落ち着かせてくれるパートナーがいちばんの助けになります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngolah rasa kanthi kuwatir. Pikiran panjenengan makarya liwat mbaleni lan “piye yen…”. Pasangan sing ngayemake lan ora ngremehake rasa kuwatir iku paling mbantu."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შფოთვით ალაგებ ფიქრებს. შენი გონება გამეორებით და „რა იქნება, თუ…“ კითხვებით მუშაობს. ყველაზე მეტად გეხმარება პარტნიორი, რომელიც გამშვიდებს და შენს შფოთვას არ აუფასურებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мазасыз ойлау. Санаң бір нәрсені қайталау мен «ал егер…» деген сұрақтар арқылы қорытады. Уайымыңды елемей тастамай, сабырға шақыратын серік ең көп көмектеседі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការរំលាយអារម្មណ៍ដោយការព្រួយបារម្ភ។ គំនិតរបស់អ្នកដំណើរការតាមរយៈការគិតដដែលៗ និង “ចុះបើ…”។ ដៃគូដែលជួយឲ្យអ្នកនឹងន ហើយមិនមើលរំលងការព្រួយបារម្ភរបស់អ្នក ជួយបានច្រើនបំផុត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆತಂಕದ ಮೂಲಕ ಅರಗಿಸಿಕೊಳ್ಳುವಿಕೆ. ನಿಮ್ಮ ಮನಸ್ಸು ಪುನರಾವರ್ತನೆ ಮತ್ತು “ಹೀಗಾದರೆ?” ಎಂಬ ಯೋಚನೆಗಳ ಮೂಲಕ ಸಾಗುತ್ತದೆ. ನಿಮ್ಮ ಆತಂಕವನ್ನು ತಳ್ಳಿಹಾಕದೆ ನಿಮ್ಮನ್ನು ನೆಲೆಗೊಳಿಸುವ ಸಂಗಾತಿ ಹೆಚ್ಚು ಸಹಾಯ ಮಾಡುತ್ತಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불안하게 곱씹는 타입이에요. 같은 생각과 ‘만약에’를 반복하며 정리하죠. 그 불안을 무시하지 않고 중심을 잡아 주는 연인이 가장 큰 힘이 돼요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hûrkirina bi fikar. Hişê te bi dubarekirin û “eger…” dixebite. Hevjînek ku te aram dike û fikara te piçûk nabîne, herî zêde alîkariyê dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тынчсыздануу аркылуу ойлонуу. Акылың кайталоо жана «эгер…» деген суроолор аркылуу иштейт. Тынчсызданууңду четке какпай, сени тынчтандырган сүйгөнүң баарынан көп жардам берет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ängschtlecht Verschaffen. Däi Kapp schafft mat Widderhuelungen an „wat wier, wann …“. Am meeschten hëlleft e Schatz, deen dir Halt gëtt, ouni deng Angscht ofzedoen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຈັດການດ້ວຍຄວາມກັງວົນ ໃຈຂອງເຈົ້າຄິດວົນໄປວົນມາ ແລະ ຖາມວ່າ “ຖ້າ… ຈະເປັນແນວໃດ” ຄູ່ທີ່ຊ່ວຍໃຫ້ເຈົ້າໃຈໝັ້ນຄົງ ໂດຍບໍ່ປັດຄວາມກັງວົນຂອງເຈົ້າຖິ້ມ ຈະຊ່ວຍໄດ້ຫຼາຍທີ່ສຸດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerimastingas apdorojimas. Tavo protas viską permąsto vėl ir vėl, sukdamasis aplink „o kas, jei…“. Labiausiai padeda rami antroji pusė, kuri nenumoja ranka į tavo nerimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trauksmaina domāšana. Tavs prāts strādā ar atkārtojumiem un „ja nu”. Visvairāk palīdz otrā puse, kas tevi iezemē un trauksmi nenoniecina."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fandinihana feno ahiahy. Amin'ny famerimberenana sy ny hoe “ahoana raha…” no iasan'ny sainao. Ny olon-tiana mampitony anao nefa tsy manao tsinontsinona ny ahiahinao no manampy indrindra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He whakaaro āwangawanga. Ka hurihuri tō hinengaro i ngā mea anō, i ngā mea tērā pea ka pā. Ko te āwhina nui rawa he hoa aroha e whakatau ana i a koe, kāore e whakahāwea ana ki tō āwangawanga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вознемирено премислување. Твојот ум работи преку повторување и „што ако“. Најмногу помага смирена половинка што не ја потценува твојата вознемиреност."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഉത്കണ്ഠയോടെയുള്ള ഉൾക്കൊള്ളൽ. ആവർത്തിച്ചുള്ള ചിന്തകളിലൂടെയും അങ്ങനെ സംഭവിച്ചാലോ എന്ന ആശങ്കകളിലൂടെയുമാണ് നിങ്ങളുടെ മനസ്സ് കാര്യങ്ങൾ കൈകാര്യം ചെയ്യുന്നത്. ഉത്കണ്ഠയെ നിസ്സാരമാക്കാതെ നിങ്ങളെ ശാന്തമാക്കുന്ന പങ്കാളിയാണ് ഏറ്റവും സഹായിക്കുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түгшүүртэй боловсруулалт. Чиний оюун ухаан давталт, «хэрэв…» гэх бодлуудаар дамжиж ажилладаг. Түгшүүрийг чинь үл тоомсорлохгүйгээр тайвшруулдаг хань хамгийн их тусална."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चिंतेतून विचार. तुमचे मन पुनरावृत्ती आणि “असे झाले तर?” यांतून मार्ग काढते. चिंता उडवून न लावता जोडीदाराने तुम्हाला शांतपणे स्थिर केले, तर सर्वात जास्त मदत होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menghadam sesuatu dengan rasa cemas. Minda anda bekerja melalui ulangan dan “bagaimana kalau”. Pasangan yang menenangkan tanpa memperkecil kerisauan anda paling membantu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipproċessar ansjuż. Moħħok jaħdem bir-ripetizzjoni u bil-“u jekk…?”. L-iktar li jgħin hu partner li jżommok b'saqajk mal-art mingħajr ma jwarrab l-ansjetà."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စိုးရိမ်စိတ်နဲ့ စဉ်းစားတတ်တယ်။ သင့်စိတ်က ထပ်ခါထပ်ခါ တွေးခြင်းနဲ့ “ဖြစ်ခဲ့ရင်…” တွေကနေ ဖြေရှင်းတယ်။ စိုးရိမ်စိတ်ကို လျစ်လျူမရှုဘဲ တည်ငြိမ်အောင် ကူညီပေးမယ့် ချစ်သူက အကူအညီ အများဆုံးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engstelig bearbeiding. Hodet ditt jobber gjennom gjentakelse og «hva om». En jordnær partner som ikke avfeier uroen, hjelper mest."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चिन्ताले सुल्झाउने तरिका। तपाईंको दिमाग दोहोर्‍याइ र ‘यस्तो भयो भने’ का प्रश्नमार्फत चल्छ। चिन्तालाई बेवास्ता नगरी तपाईंलाई स्थिर राख्ने पार्टनरले सबैभन्दा बढी मद्दत गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angstig verwerken. Je hoofd werkt het af via herhaling en wat-als-scenario’s. Een rustige partner die je angst niet wegwuift, helpt het meest."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumamvetsa zinthu modera nkhawa. Maganizo anu amagwira ntchito mobwerezabwereza ndi mafunso a “bwanji ngati…”. Wokondedwa wokukhazikitsani amene sanyoza nkhawa yanu amathandiza kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaaddoon hubatta. Sammuun kee irra deddeebi'uu fi “yoo … ta'eehoo?” jedhuun hojjeta. Baay'ee kan si gargaaru, yaaddoon kee utuu hin tuffatamin tasgabbii jaalallee kee irraa argachuu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚିନ୍ତା ଭିତରେ ବୁଝିବା। ଆପଣଙ୍କ ମନ ବାରମ୍ବାର ଭାବି ଓ “ଯଦି…” ପ୍ରଶ୍ନ ଦେଇ କାମ କରେ। ଚିନ୍ତାକୁ ଉଡ଼ାଇ ନ ଦେଇ ଆପଣଙ୍କୁ ସ୍ଥିର କରୁଥିବା ସାଥୀ ସବୁଠାରୁ ଅଧିକ ସାହାଯ୍ୟ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਚਿੰਤਾ ਰਾਹੀਂ ਸਮਝਣਾ। ਤੁਹਾਡਾ ਮਨ ਗੱਲ ਨੂੰ ਵਾਰ-ਵਾਰ ਦੁਹਰਾ ਕੇ ਅਤੇ “ਜੇ ਇੰਝ ਹੋ ਗਿਆ ਤਾਂ” ਸੋਚ ਕੇ ਸੁਲਝਾਉਂਦਾ ਹੈ। ਸਭ ਤੋਂ ਵੱਧ ਮਦਦ ਉਸ ਪਾਰਟਨਰ ਦੀ ਹੁੰਦੀ ਹੈ ਜੋ ਤੁਹਾਨੂੰ ਟਿਕਾਈ ਰੱਖੇ ਅਤੇ ਤੁਹਾਡੀ ਚਿੰਤਾ ਨੂੰ ਹਲਕੇ ਵਿੱਚ ਨਾ ਲਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lękowe przetwarzanie. Twój umysł pracuje przez powtarzanie i „a co, jeśli”. Najbardziej pomaga spokojna druga połówka, która nie bagatelizuje twojego niepokoju."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندېښمن هضم. ستاسو ذهن د تکرار او احتمالي ګواښونو د فکر له لارې کار کوي. هغه ملګری چې آرام مو کړي او اندېښنه مو کمه ونه ګڼي، تر ټولو ډېره مرسته کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processamento ansioso. Sua mente trabalha na repetição e nos “e se…”. O que mais ajuda é alguém que te acalme sem minimizar a ansiedade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processamento ansioso. A tua mente trabalha por repetição e «e se…». Ajuda mais um par que te acalme sem desvalorizar a ansiedade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesare anxioasă. Mintea ta lucrează prin repetiție și „ce-ar fi dacă”. Te ajută cel mai mult un partener care te liniștește fără să-ți minimalizeze anxietatea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты проживаешь стресс через тревогу. Твой ум крутит одно и то же и перебирает «а что, если». Больше всего помогает партнёр, который заземляет и не отмахивается от тревоги."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utekereza ufite impungenge. Ubwenge bwawe bukora binyuze mu gusubiramo no kwibaza “byagenda bite niba…”. Umukunzi ugutuza kandi udasuzugura impungenge zawe ni we ugufasha cyane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කනස්සල්ලෙන් තේරුම් ගැනීම. ඔබේ හිත වැඩ කරන්නේ නැවත නැවත හිතමින් සහ “එහෙම වුණොත්?” කියමින්. කනස්සල්ල නොසලකා හරින්නේ නැතිව ඔබව සමබර කරන සහකරුවෙක් තමයි වැඩියෙන්ම උදව් වෙන්නේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úzkostné spracovanie. Tvoja myseľ to rieši opakovaním a otázkami „čo ak“. Najviac pomôže polovička, ktorá ťa upokojí a úzkosť nezľahčuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tesnobno predelovanje. Tvoj um dela s ponavljanjem in z vprašanji „kaj če“. Najbolj ti pomaga partner, ki te prizemlji in tvoje tesnobe ne odpravi z zamahom roke."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufunga uchinetseka. Pfungwa dzako dzinoshanda nekudzokorora uye ‘ko kana…’. Mudiwa anokugadzikanisa asingashori kunetseka kwako ndiye anobatsira zvakanyanya."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walwal ayaad arrimaha ku dhuuxdaa. Maskaxdaadu waxay ku shaqeysaa ku-celcelin iyo “haddii ay…”. Waxa ugu caawimo badan lammaane ku dejiya oo aan walwalkaaga iska indha tirin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përpunim me ankth. Mendja jote punon me përsëritje dhe „po sikur“. Më shumë të ndihmon një partner që të qetëson pa e nënvlerësuar ankthin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анксиозно сређивање мисли. Ум ти ради кроз понављање и „шта ако“. Највише помаже половина која те смирује и не умањује твоју бригу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngolah ku kahariwang. Pikiran anjeun dianggo ku cara malikan deui sareng “kumaha upami”. Anu pangmangpaatna nyaéta pasangan anu nenangkeun tanpa nganggap enteng kahariwang anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orolig bearbetning. Ditt huvud jobbar med upprepningar och tänk om. En partner som ger dig fotfäste utan att vifta bort oron hjälper mest."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuchakata kwa wasiwasi. Akili yako hufanya kazi kwa kurudia na kwa “itakuwaje kama…”. Mwenzi anayekutuliza bila kupuuza wasiwasi wako husaidia zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதற்றத்துடன் யோசிப்பவர். உங்கள் மனம் திரும்பத் திரும்ப யோசிப்பதன் மூலமும் ‘ஒருவேளை…’ கேள்விகள் மூலமும் இயங்குகிறது. பதற்றத்தை அலட்சியம் செய்யாமல் நிதானப்படுத்தும் துணைதான் மிகவும் உதவுவார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆందోళనతో ఆలోచించడం. మీ మనసు పదే పదే ఆలోచిస్తూ, ఒకవేళ అలా జరిగితే అనుకుంటూ ముందుకు వెళ్తుంది. మీ ఆందోళనను తేలిగ్గా తీసిపారేయకుండా, మిమ్మల్ని స్థిరంగా ఉంచే భాగస్వామి ఎక్కువగా సాయపడతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳазми пурташвиш. Зеҳни ту бо такрор ва «агар…»-ҳо кор мекунад. Аз ҳама бештар ёре кӯмак мекунад, ки туро ба замин баргардонад ва ташвишатро беаҳамият нашуморад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจัดการความรู้สึกผ่านความกังวล ใจคุณทำงานด้วยการคิดซ้ำและคำถามว่า “ถ้าเกิด…” คนรักที่ช่วยให้ใจนิ่งโดยไม่มองข้ามความกังวลจะช่วยได้มากที่สุด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብጭንቀት ምርዳእ። ኣእምሮኹም ብምድግጋምን «እንተ… እንታይ ይኸውን?» ብምባልን ይሰርሕ። ነቲ ጭንቀት ከየነኣኣሰ ዘረጋግእ ደገፍ ካብ መጻምድኹም ብዝያዳ ይሕግዘኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aladaly ýerbe-ýer ediş. Aňyň gaýtalamak we “eger-de…” diýen pikirler arkaly işleýär. Aladaňy ýeňil saýmaýan, seni köşeşdirýän söýgüli iň köp kömek eder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaygıyla sindiriyorsun. Zihnin tekrarlarla ve “ya olursa”larla çalışıyor. En çok, kaygını küçümsemeyen ve seni sakinleştiren bir partner yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тривожне осмислення. Твій розум працює через повтори й «а що, як». Найбільше допомагає половинка, яка заземлює і не знецінює тривогу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فکرمندی میں سوچ بچار۔ آپ کا ذہن بار بار دہرانے اور “اگر ایسا ہوا تو” کے ذریعے چیزیں سلجھاتا ہے۔ سب سے زیادہ مدد ایسے ساتھی سے ملتی ہے جو تسلی دے اور آپ کی پریشانی کو نظرانداز نہ کرے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xavotirli hazm qilish. Fikringiz takrorlash va «agar…» savollari orqali ishlaydi. Xavotiringizni yengil-yelpi qabul qilmaydigan, sizni xotirjamlashtiradigan sherik eng koʻp yordam beradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý bằng lo âu. Đầu óc bạn vận hành qua lặp lại và “nếu như”. Điều giúp bạn nhiều nhất là người ấy điềm tĩnh và không gạt đi nỗi lo của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uqwalasela ngokuxhalaba. Ingqondo yakho isebenza ngokuphindaphinda nangemibuzo ethi “kuthekani ukuba…?”. Iqabane elikuzinzisayo nelingakujongeli phantsi ukuxhalaba lelona likunceda kakhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdààmú ọkàn ni ọ̀nà yín. Ọkàn yín máa ń ṣiṣẹ́ nípa àtúnwí àti “tí ó bá jẹ́ pé…”. Olólùfẹ́ tó ń mú yín balẹ̀ tí kò sì fojú kéré ìdààmú yín ló ń ràn yín lọ́wọ́ jù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦慮式消化。你的腦袋靠反覆思量和各種「萬一」來整理事情。一個能讓你安定、又不輕視你焦慮的另一半最能幫到你。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦虑型消化。你的大脑靠反复琢磨和各种“万一”来处理事情。最能帮到你的，是一个能让你安心、又不轻视你焦虑的另一半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會在焦慮中反覆消化，腦中不斷重播各種「萬一」。最能幫你的，是一個不否定你的焦慮、又能讓你安定下來的另一半。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucubungula ngokukhathazeka. Ingqondo yakho isebenza ngokuphindaphinda nangokuthi “kuthiwani uma…”. Umlingani okuzinzisayo ongakudeleli ukukhathazeka kwakho uyasiza kakhulu."
          }
        }
      }
    },
