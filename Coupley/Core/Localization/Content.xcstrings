        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נדיבות בחוויות — כסף נועד לחיות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुभवों पर खुलकर — पैसा जीने के लिए है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikodušno s iskustvima – novac je za život"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenere pou eksperyans — lajan se pou viv"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élményekre bőkezű – a pénz arra való, hogy éljünk"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առատաձեռն տպավորությունների համար — փողն ապրելու համար է"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Royal untuk pengalaman — uang untuk dinikmati"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ na-amasị m imefu ego n'ahụmahụ — ego bụ maka ndụ"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örlæti á upplifanir – peningar eru til að lifa"
