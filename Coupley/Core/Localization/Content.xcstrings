          "stringUnit" : {
            "state" : "translated",
            "value" : "E rouegt Liewen ouni Stress — Fridden ass alles"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຊີວິດຊ້າໆ ງຽບໆ — ຄວາມສະຫງົບຄືເປົ້າໝາຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lėtas, ramus gyvenimas – esmė yra ramybė"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lēna, klusa dzīve – miers ir galvenais"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiainana miadana sy mangina — ny fiadanana no tanjona"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He oranga āta haere, mārie — ko te rangimārie te tino take"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бавен, тивок живот — мирот е поентата"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പതുക്കെ, ശാന്തമായ ജീവിതം — സമാധാനമാണ് ലക്ഷ്യം"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаан, нам гүм амьдрал — гол нь амар тайван"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संथ, शांत आयुष्य — शांतता हाच उद्देश"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidup perlahan dan tenang — ketenangan itulah tujuannya"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ħajja kwieta u bil-mod — il-paċi hija l-iskop"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နှေးနှေး အေးအေး ဘဝ — ငြိမ်းချမ်းမှုက အဓိကပါ"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et rolig, stille liv – freden er poenget"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढिलो, शान्त जीवन — शान्ति नै मुख्य कुरा"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rustig, stil leven – vrede is het doel"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyo wodekha, wabata — mtendere ndiye cholinga"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jireenya suutaa fi tasgabbaa'aa — nagaan kaayyoo dha"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଧୀର, ଶାନ୍ତ ଜୀବନ — ଶାନ୍ତି ହିଁ ଲକ୍ଷ୍ୟ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੌਲੀ, ਸ਼ਾਂਤ ਜ਼ਿੰਦਗੀ — ਸਕੂਨ ਹੀ ਮਕਸਦ ਹੈ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powolne, ciche życie – chodzi o spokój"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورو او ارام ژوند — موخه سوکالي ده"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vida calma e tranquila — o objetivo é a paz"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vida calma e tranquila — a paz é o objetivo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O viață lentă, liniștită — pacea e scopul"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неспешная, тихая жизнь — главное покой"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuzima butuje, butihuta — amahoro ni yo ntego"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මන්දගාමී, නිස්කලංක ජීවිතයක් — සාමයම තමයි අරමුණ"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalý, tichý život – ide o pokoj"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počasno, mirno življenje – bistvo je mir"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hupenyu hwakadzikama, hwakanyarara — rugare ndicho chinangwa"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nolol deggan oo aamusan — nabaddu waa ujeeddada"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetë e ngadaltë dhe e qetë – paqja është qëllimi"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спор, миран живот — поента је у миру"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hirup anu laun sareng tenang, katentreman anu dipilarian"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett långsamt, stilla liv – lugnet är poängen"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maisha ya taratibu na utulivu — amani ndiyo lengo"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிதானமான, அமைதியான வாழ்க்கை — அமைதியே நோக்கம்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెమ్మదైన, ప్రశాంత జీవితం — శాంతే లక్ష్యం"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зиндагии оҳиста ва ором — гап дар оромӣ аст"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชีวิตช้าๆ เงียบๆ ความสงบคือทุกอย่าง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ህዱእን ቀስ ዝበለን ህይወት — ሰላም እዩ እቲ ዕላማ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haýal, asuda durmuş — esasy zat parahatlyk"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yavaş, sakin bir hayat, asıl amaç huzur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повільне, тихе життя — головне спокій"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دھیمی، پرسکون زندگی، سکون ہی اصل مقصد"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekin, sokin hayot — asosiysi xotirjamlik"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sống chậm, yên tĩnh — bình yên là tất cả"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubomi obucothayo nobuzolileyo — uxolo yeyona njongo"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìgbésí ayé jẹ́ẹ́jẹ́ẹ́, tó dákẹ́ — àlàáfíà ni olórí"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡單寧靜的生活——平靜就是重點"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢下来，安静生活，图的就是平静"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡單安靜的生活，平靜就是重點"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impilo ehamba kancane, ethule — ukuthula yikho okubalulekile"
          }
        }
      }
    },
    "Slower pace, more space. You're drawn to calm over stimulation. A city-loving partner might find this hard." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stadiger pas, meer ruimte. Jy word aangetrek deur kalmte eerder as prikkels. ’n Maat wat lief is vir die stad, kan dit moeilik vind."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዘገምተኛ ኑሮ፣ ሰፊ ቦታ። ከግርግር ይልቅ መረጋጋት ይስብዎታል። ከተማን የሚወዱ አጋር ይህ ሊከብዳቸው ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاع أبطأ ومساحة أوسع. الهدوء يجذبك أكثر من الصخب، وقد يصعب ذلك على شريك يعشق المدينة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাহে লাহে জীৱন, বেছি মুকলি ঠাই। হুলস্থুলতকৈ শান্তিয়ে আপোনাক আকৰ্ষণ কৰে। চহৰ ভাল পোৱা সংগী এজনৰ বাবে এয়া কঠিন হ'ব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yavaş tempo, daha çox məkan. Səni səs-küydən çox sakitlik cəlb edir. Şəhəri sevən partnyora bu çətin gələ bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Павольней і прасторней. Цябе цягне да спакою, а не да мітусні. Палавінцы, якая любіць горад, гэта можа быць няпроста."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-бавно темпо, повече пространство. Привлича те спокойствието, а не динамиката. За половинка, която обича града, това може да е трудно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধীর গতি, বেশি জায়গা। হইচইয়ের চেয়ে শান্তি তোমাকে বেশি টানে। শহরপ্রেমী পার্টনারের জন্য এটা কঠিন হতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporiji tempo, više prostora. Privlači te mir više nego užurbanost. Voljenoj osobi koja obožava grad to bi moglo biti teško."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritme més lent, més espai. T'atrau més la calma que l'estímul. A una parella que estimi la ciutat potser li costaria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalejší tempo, víc prostoru. Táhne tě klid víc než ruch. Pro protějšek, který miluje město, to může být těžké."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bywyd arafach, mwy o le. Mae'n well gen ti lonyddwch na chyffro. Gallai partner sy'n caru'r ddinas ei chael hi'n anodd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere tempo, mere plads. Du drages mod ro frem for liv og larm. En partner, der elsker storbyen, kan have svært ved det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer, mit mehr Platz. Dich zieht Ruhe mehr an als Trubel. Für jemanden, der die Stadt liebt, könnte das schwer sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιο αργοί ρυθμοί, περισσότερος χώρος. Σε τραβάει η ηρεμία πιο πολύ από την ένταση. Ένα ταίρι που λατρεύει την πόλη ίσως το βρει δύσκολο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo más lento, más espacio. Te atrae la calma más que el bullicio. A una pareja muy urbana podría costarle."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aeglasem tempo, rohkem ruumi. Sind tõmbab rahu, mitte melu. Linnaarmastajal partneril võib sellega raske olla."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erritmo motelagoa, leku gehiago. Lasaitasunak gehiago erakartzen zaitu zaratak baino. Hiria maite duen bikotekide bati zaila egin dakioke."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ریتم آهسته‌تر، فضای بیشتر. آرامش را به هیجان ترجیح می‌دهی. شاید برای پارتنری که عاشق شهر است سخت باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitaampi tahti, enemmän tilaa. Sinua vetää puoleensa rauha enemmän kuin hälinä. Kaupunkia rakastavalle kumppanille tämä voi olla vaikeaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas mabagal, mas maluwag. Mas gusto mo ang kalmado kaysa sa ingay. Baka mahirapan dito ang partner na mahilig sa lungsod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rythme plus lent, plus d'espace. Tu préfères le calme à l'agitation. Quelqu'un qui adore la ville pourrait avoir du mal."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luas níos moille, níos mó spáis. Is fearr leat suaimhneas ná spreagadh. B’fhéidir go mbeadh sé seo deacair má tá dúil sa chathair ag do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo máis lento, máis espazo. Atráeche máis a calma ca o bulicio. A unha parella namorada da cidade podería custarlle."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ધીમી ગતિ, વધુ જગ્યા. તમને ભાગદોડ કરતાં શાંતિ ખેંચે છે. શહેર-પ્રેમી પાર્ટનરને આ અઘરું લાગી શકે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayuwa a hankali, sarari mai yawa. Natsuwa ta fi muku hayaniya. Abokin zama mai son birni zai iya ganin wannan da wahala."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קצב איטי יותר, יותר מרחב. רוגע מושך אותך יותר מגירויים. למי שאוהב את העיר זה עלול להיות קשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धीमी रफ़्तार, ज़्यादा खुली जगह। हलचल से ज़्यादा सुकून आपको खींचता है। शहर से प्यार करने वाले पार्टनर के लिए यह मुश्किल हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporiji ritam, više prostora. Privlači te mir više od uzbuđenja. Osobi koja voli grad to bi moglo biti teško."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon ritm pi dousman, plis espas. Ou pito kalm pase eksitasyon. Yon patnè ki renmen lavil ta ka twouve sa difisil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassabb tempó, több tér. A nyugalom jobban vonz, mint a nyüzsgés. Egy városszerető társnak ez nehéz lehet."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դանդաղ ռիթմ, ավելի շատ տարածք։ Քեզ ձգում է անդորրը, ոչ թե եռուզեռը։ Քաղաք սիրող զուգընկերոջ համար սա կարող է դժվար լինել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritme lebih lambat, ruang lebih lega. Kamu lebih tertarik pada ketenangan daripada keramaian. Pasangan yang cinta kota mungkin akan kesulitan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndụ dị nwayọọ, ohere karịa. Udo na-adọta gị karịa mkpọtụ. Onye hụrụ obodo mepere emepe n'anya nwere ike ịhụ ya ka ihe siri ike."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hægari taktur, meira rými. Þú laðast frekar að ró en áreiti. Maki sem elskar borgarlífið gæti átt erfitt með það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmi più lenti, più spazio. Ti attira la calma più della frenesia. Un partner che ama la città potrebbe trovarlo difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆったりしたペースと広い空間。刺激より穏やかさに惹かれる人です。都会好きのパートナーには難しいかもしれません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urip luwih alon, papan luwih jembar. Panjenengan luwih seneng tentrem tinimbang rame. Pasangan sing seneng kutha bisa uga krasa abot."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნელი რიტმი, მეტი სივრცე. სიმშვიდე უფრო გიზიდავს, ვიდრე ხმაური. ქალაქის მოყვარული პარტნიორისთვის ეს შეიძლება რთული იყოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баяу ырғақ, кеңірек орын. Сені қарбаластан гөрі тыныштық тартады. Қаланы жақсы көретін серікке бұл қиын болуы мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ល្បឿនយឺតជាង កន្លែងទូលាយជាង។ អ្នកទាក់ទាញដោយភាពស្ងប់ស្ងាត់ ជាងភាពអ៊ូអរ។ ដៃគូដែលស្រឡាញ់ទីក្រុងអាចយល់ថាពិបាក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಧಾನ ಗತಿ, ಹೆಚ್ಚು ಸ್ಥಳಾವಕಾಶ. ನಿಮಗೆ ಗದ್ದಲಕ್ಕಿಂತ ಶಾಂತಿ ಇಷ್ಟ. ನಗರ ಪ್ರಿಯ ಸಂಗಾತಿಗೆ ಇದು ಕಷ್ಟವಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느린 속도, 넓은 공간을 원해요. 자극보다 고요함에 끌리죠. 도시를 사랑하는 연인에게는 어려울 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rîtmeke hêdîtir, cihê zêdetir. Aramî ji qelebalixê bêtir te dikişîne. Dibe ku ev ji bo hevjînekî ku ji bajêr hez dike zehmet be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шашылбаган жашоо, кенен мейкиндик. Сени ызы-чуудан көрө тынчтык тартат. Шаарды жакшы көргөн сүйгөнүңө бул оор болушу мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méi lues, méi Plaz. Dech zitt et éischter zu Rou wéi zu Trubel. Engem Schatz, deen d'Stad gär huet, kéint dat schwéierfalen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຊີວິດຊ້າລົງ ພື້ນທີ່ກວ້າງຂຶ້ນ ເຈົ້າມັກຄວາມສະຫງົບຫຼາຍກວ່າຄວາມຄຶກຄື້ນ ຄູ່ທີ່ຮັກຊີວິດໃນເມືອງອາດຮູ້ສຶກວ່າເລື່ອງນີ້ຍາກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lėtesnis tempas, daugiau erdvės. Tave traukia ramybė, o ne šurmulys. Miestą mėgstančiai antrajai pusei tai gali būti sunku."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lēnāks ritms, vairāk telpas. Tevi vairāk vilina miers nekā kņada. Otrajai pusei, kas mīl pilsētu, tas varētu būt grūti."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiainana miadana kokoa, toerana malalaka kokoa. Ny fahatoniana no misarika anao fa tsy ny korontana. Mety ho sarotra izany ho an'ny olon-tiana tia tanàn-dehibe."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He āta haere, he wāhi whānui. Ko te mārie tāu e kukume ana, kaua ko te pōrearea. Ka uaua pea tēnei ki tētahi hoa aroha e aroha ana ki te tāone."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Побавно темпо, повеќе простор. Те привлекува мирот повеќе од возбудата. На половинка што го сака градот ова може да ѝ биде тешко."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പതുക്കെയുള്ള ജീവിതം, കൂടുതൽ ഇടം. തിരക്കിനേക്കാൾ ശാന്തതയാണ് നിങ്ങളെ ആകർഷിക്കുന്നത്. നഗരം ഇഷ്ടപ്പെടുന്ന പങ്കാളിക്ക് ഇത് പ്രയാസമായേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаан хэмнэл, илүү их орон зай. Чамайг хөөр баяраас илүү тайван байдал татдаг. Хотод дуртай ханьд энэ хэцүү байж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संथ गती, मोकळी जागा. गजबजाटापेक्षा शांतता तुम्हाला जास्त ओढ लावते. जोडीदाराला शहर आवडत असेल, तर त्यांना हे कठीण वाटू शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rentak lebih perlahan, ruang lebih luas. Anda lebih tertarik kepada ketenangan berbanding hiruk-pikuk. Pasangan yang suka bandar mungkin sukar menerimanya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmu aktar bil-mod, aktar spazju. Tinġibed lejn il-kalma aktar milli lejn l-istimolu. Partner li jħobb il-belt jista' jsibha diffiċli."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပိုနှေးတဲ့ ဘဝ၊ ပိုကျယ်တဲ့ နေရာ။ လှုပ်ရှားဆူညံမှုထက် အေးချမ်းမှုကို ပိုနှစ်သက်တယ်။ မြို့ကြီးကို ချစ်တဲ့ ချစ်သူအတွက်တော့ ခက်ခဲနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere tempo, mer plass. Du trekkes mot ro framfor inntrykk. En partner som elsker byliv, kan synes det er tungt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढिलो गति, धेरै ठाउँ। तपाईं हलचलभन्दा शान्ततातिर आकर्षित हुनुहुन्छ। सहर मन पराउने पार्टनरलाई यो गाह्रो लाग्न सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lager tempo, meer ruimte. Je kiest liever rust dan prikkels. Een partner die van de stad houdt, kan dit lastig vinden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyo wodekha, malo ambiri. Mumakopeka ndi bata kuposa phokoso. Wokondedwa wokonda mzinda angavutike ndi zimenezi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuta jiraachuu, bal'ina caalaa. Sakaalamuu caalaa tasgabbiitti harkifamta. Jaalallee kee biratti magaalaan yoo jaallatame, kun ulfaachuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଧୀର ଗତି, ଅଧିକ ଜାଗା। ଉତ୍ତେଜନାଠାରୁ ଶାନ୍ତି ଆପଣଙ୍କୁ ଅଧିକ ଟାଣେ। ସହର ଭଲପାଉଥିବା ସାଥୀଙ୍କ ପାଇଁ ଏହା କଷ୍ଟକର ହୋଇପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੌਲੀ ਰਫ਼ਤਾਰ, ਵੱਧ ਖੁੱਲ੍ਹ। ਤੁਹਾਨੂੰ ਭੀੜ-ਭੜੱਕੇ ਨਾਲੋਂ ਸਕੂਨ ਖਿੱਚਦਾ ਹੈ। ਜੇ ਪਾਰਟਨਰ ਨੂੰ ਸ਼ਹਿਰ ਪਸੰਦ ਹੈ, ਤਾਂ ਉਨ੍ਹਾਂ ਨੂੰ ਇਹ ਔਖਾ ਲੱਗ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolniejsze tempo, więcej przestrzeni. Ciągnie cię do spokoju, nie do bodźców. Komuś zakochanemu w mieście może być trudno."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورو ژوند، ډېر ځای. تاسو تر هیجان ارامي خوښوئ. هغه ملګری چې ښار خوښوي، شاید دا ورته ستونزمن وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo mais lento, mais espaço. Você prefere calma a agito. Um amor que ama cidade grande pode achar isso difícil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo mais lento, mais espaço. Atrai-te mais a calma do que o estímulo. Um par que adore a cidade pode achar isto difícil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritm mai lent, mai mult spațiu. Te atrage liniștea mai mult decât agitația. Unui partener care iubește orașul i-ar putea fi greu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленный темп, больше простора. Тебя тянет к спокойствию, а не к суете. Партнёру, влюблённому в город, это может быть непросто."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuzima butihuta, umwanya munini. Ukururwa n'ituze kurusha urusaku. Umukunzi ukunda umujyi ashobora kubibona bigoye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මන්දගාමී රිද්මයක්, වැඩි ඉඩක්. උද්දීපනයට වඩා සන්සුන්කමට ඔබ ඇදිලා යනවා. නගරයට ආදරය කරන සහකරුවෙකුට මේක අමාරු වෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalšie tempo, viac priestoru. Ťahá ťa pokoj viac než ruch. Polovička, ktorá miluje mesto, to môže niesť ťažko."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počasnejši tempo, več prostora. Bolj te privlači mir kot vrvež. Partnerju, ki obožuje mesto, bi bilo to morda težko."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufamba zvishoma nezvishoma, nzvimbo yakawanda. Unokweverwa kurunyararo kupfuura ruzha. Mudiwa anoda guta angazviwana zvakaoma."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nolol gaabis ah, meel ballaaran. Degganaanta ayaad ka doorbiddaa buuqa. Lammaane magaalada jecel tani way ku adkaan kartaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritëm më i ngadaltë, më shumë hapësirë. Të tërheq qetësia më shumë se zhurma. Një partner që e do qytetin mund ta ketë të vështirë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спорији ритам, више простора. Привлачи те мир, а не узбуђење. Половини која воли град то би могло да буде тешко."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laju anu langkung lambat, rohangan anu langkung lega. Anjeun katarik kana katenangan tibatan karaméan. Pasangan anu resep kota meureun ngaraos hésé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugnare tempo, mer utrymme. Du dras till ro snarare än intryck. En partner som älskar storstan kan tycka att det är svårt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maisha ya taratibu, nafasi zaidi. Unavutiwa na utulivu kuliko pilikapilika. Mwenzi anayependa jiji anaweza kuona hili kuwa gumu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிதானமான வேகம், அதிக இடம். பரபரப்பைவிட அமைதி உங்களை ஈர்க்கிறது. நகரத்தை நேசிக்கும் துணைக்கு இது கடினமாக இருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెమ్మదైన జీవనం, ఎక్కువ చోటు. హడావుడి కన్నా ప్రశాంతతే మీకు ఇష్టం. నగరాన్ని ఇష్టపడే భాగస్వామికి ఇది కష్టంగా అనిపించవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суръати оҳиста, фазои бештар. Туро оромӣ бештар аз ҳаёҷон ҷазб мекунад. Барои ёре, ки шаҳрро дӯст медорад, ин шояд душвор бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชีวิตช้าลง พื้นที่มากขึ้น คุณชอบความสงบมากกว่าความคึกคัก คนรักที่รักเมืองใหญ่อาจรู้สึกลำบาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝሀድአ ናህሪ፣ ዝሰፍሐ ቦታ። ካብ ዕግርግር ህድኣት ይስሕበኩም። ከተማ ንዝፈቱ መጻምዲ እዚ ከቢድ ክኸውን ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haýal durmuş, köp giňişlik. Saňa galmagaldan has asudalyk ýakyn. Şäheri söýýän söýgüli üçin bu kyn bolup biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yavaş tempo, daha çok alan. Seni hareketlilikten çok sakinlik çekiyor. Şehri seven bir partner bunu zor bulabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повільніший ритм, більше простору. Тебе вабить спокій, а не вир подій. Половинці, яка любить місто, це може бути непросто."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دھیمی رفتار، زیادہ کھلی جگہ۔ ہلچل کے بجائے سکون آپ کو اپنی طرف کھینچتا ہے۔ شہر کے شوقین ساتھی کے لیے یہ مشکل ہو سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekinroq hayot, koʻproq kenglik. Sizni shovqindan koʻra sokinlik oʻziga tortadi. Shaharni sevadigan sherikka bu qiyin boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhịp sống chậm, không gian rộng. Bạn thích bình yên hơn náo nhiệt. Người mê phố thị có thể thấy khó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
