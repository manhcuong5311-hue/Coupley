        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ረጅሙን ጨዋታ እየተጫወቱ ነው። ወደፊት ሁለታችሁም ራሳችሁን ታመሰግናላችሁ።"
