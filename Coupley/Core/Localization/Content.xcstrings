        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når energien er væk, hjælper aflastning mere end beroligende ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Energie weg ist, hilft Entlastung mehr als Zuspruch."
