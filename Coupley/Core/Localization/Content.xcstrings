    "Give me space to decompress alone first" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة لأهدأ وحدي أولًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechat mi nejdřív prostor vydýchat se o samotě"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv mig plads til at falde ned alene først"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst mal Ruhe, um allein runterzukommen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε μου πρώτα χώρο να αποφορτιστώ"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio para desconectar a solas primero"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna ensin tilaa rauhoittua yksin"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigyan muna ako ng espasyo para makapagpahinga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'abord souffler un peu dans mon coin"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודם לתת לי מרחב להירגע לבד"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले थोड़ी देर अकेले में रहने दें"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadd kapcsoljak ki előbb egyedül"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri aku ruang untuk menenangkan diri dulu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
