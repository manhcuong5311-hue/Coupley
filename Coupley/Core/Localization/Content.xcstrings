        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bonne humeur aide les projets à se concrétiser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב רוח טוב הוא זמן מעולה לתוכניות שבאמת מחזיקות."
