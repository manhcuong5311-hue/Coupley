        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razdoblje mijena i mogućnosti. Voljena osoba treba znati što dolazi – kad je riječ o prihodima, vremenu i emocionalnoj snazi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon moman kote tout bagay ap bouje e tout bagay posib. Patnè ou bezwen konnen sa ap vini — pou lajan, pou tan, ak pou fòs emosyonèl ou."
