        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তেওঁৰ শক্তিৰ লগত তাল মিলাওক। ধেমেলীয়া কিবা পঠিয়াওক — এটা ভইচ নোট, এখন হাস্যকৰ ছবি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onun enerjisinə uyğunlaş. Oynaq bir şey göndər — səsli mesaj, gülməli şəkil."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падхапі настрой палавінкі. Дашлі штосьці гуллівае — галасавое, смешнае фота."
