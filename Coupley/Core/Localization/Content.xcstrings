        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-imprevedibbiltà kienet parti mill-esperjenza tiegħek. Forsi għandek sentimenti kumplessi dwar iċ-ċelebrazzjonijiet minħabba f'hekk."
