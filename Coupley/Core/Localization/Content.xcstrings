            "state" : "translated",
            "value" : "Každý den do detailu – všechno si nastuduju"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag planlagt i detaljer – jeg undersøger alt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag durchgeplant – ich recherchiere alles"
