    "Starting from a clean slate. There's real intimacy in tackling someone's financial baggage together." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحة بيضاء من جديد. في مواجهة الأعباء المالية معًا حميمية حقيقية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začít s čistým štítem. Když se spolu pustíte do finančního břemene jednoho z vás, je v tom opravdová blízkost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ren tavle. Der er ægte intimitet i at tage fat på hinandens økonomiske bagage sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Neustart bei null. Es hat etwas sehr Nahes, finanzielle Altlasten gemeinsam anzugehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινάτε από καθαρό χαρτί. Υπάρχει αληθινή οικειότητα στο να αντιμετωπίζετε μαζί τις οικονομικές αποσκευές του άλλου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar con borrón y cuenta nueva. Hay una intimidad real en afrontar juntos las cargas económicas de alguien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhtaalta pöydältä. Toisen taloudellisten taakkojen yhdessä selvittämisessä on todellista läheisyyttä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsimula sa malinis na pahina. May tunay na lapit sa pagharap nang magkasama sa mga pasaning pinansyal ng isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repartir sur des bases saines. Il y a une vraie intimité à affronter ensemble le passif financier de l'un ou de l'autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתחיל מדף נקי. יש אינטימיות אמיתית בהתמודדות משותפת עם המטען הכלכלי של אחד מכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्कुल नए सिरे से शुरुआत। किसी के पैसों के बोझ से मिलकर निपटने में एक सच्ची नज़दीकी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiszta lappal kezdeni. Igazi bensőségesség van abban, ha együtt néztek szembe valakinek a pénzügyi terheivel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dengan lembaran bersih. Ada keintiman nyata saat menghadapi beban keuangan bersama-sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripartire da una pagina bianca. C’è una vera intimità nell’affrontare insieme il bagaglio economico di qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まっさらな状態から始めたいタイプです。相手のお金の悩みに一緒に向き合うことには、深い親密さがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
