        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከየት እንደመጡ ያውቃሉ። የታሪክዎ መልካምም ከባድም ክፍሎች ለእርስዎ ግልጽ ናቸው።"
