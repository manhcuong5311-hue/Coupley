        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A változás és a lehetőségek időszaka. A párodnak tudnia kell, mi vár rátok – a jövedelem, az idő és az érzelmi teherbírás terén is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փոփոխությունների ու հնարավորությունների շրջան։ Զուգընկերդ պետք է իմանա, թե ինչ է սպասվում՝ եկամտի, ժամանակի և հուզական ուժերի առումով։"
