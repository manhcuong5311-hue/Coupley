        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這正在影響一切，包括你的心情、耐心，以及和人連結的能量。值得把它列為優先處理的事。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokhu kuthinta konke — imizwa yakho, ukubekezela kwakho, amandla akho okuxhumana. Kufanele ukubeke phambili."
