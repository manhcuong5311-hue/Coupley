        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагорода за життя, повне праці, — побачити світ. Мабуть, ти вже відкладаєш на свою версію свободи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần thưởng cho cả đời làm việc là được ngắm thế giới. Chắc bạn đang dành dụm cho một kiểu tự do nào đó."
