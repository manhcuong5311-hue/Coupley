        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергија и пристапност. Сакаш сè да ти е на чекор, бучава, удобност. Градот е твоето природно живеалиште."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഊർജവും സൗകര്യവും. നടന്നെത്താവുന്ന ദൂരങ്ങൾ, ബഹളം, സൗകര്യങ്ങൾ — ഇതാണ് നിങ്ങൾക്ക് വേണ്ടത്. നഗരമാണ് നിങ്ങളുടെ സ്വാഭാവിക ഇടം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эрч хүч, хүртээмж. Явганаар хүрэх, шуугиан, тав тух хүсдэг. Хот бол чиний төрөлх орчин."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊर्जा आणि सोय. चालत जाता येणारी ठिकाणे, गजबज, सुविधा तुम्हाला हव्यात. शहर हेच तुमचे नैसर्गिक घर आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenaga dan kemudahan akses. Anda mahu tempat yang boleh dijelajah berjalan kaki, meriah dan serba mudah. Bandar ialah habitat semula jadi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerġija u aċċess. Trid kollox fil-qrib, il-ħajja, il-konvenjenza. Il-belt hija l-ambjent naturali tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အင်အားနဲ့ လက်လှမ်းမီမှု။ လမ်းလျှောက်သွားလို့ရတာ၊ စည်ကားမှု၊ အဆင်ပြေမှုကို လိုချင်တယ်။ မြို့ကြီးက သင့်ရဲ့ သဘာဝ နေရာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi og nærhet. Du vil gå overalt, ha liv rundt deg og alt lett tilgjengelig. Byen er ditt naturlige habitat."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊर्जा र पहुँच। तपाईंलाई हिँडेरै पुगिने ठाउँ, चहलपहल र सुविधा चाहिन्छ। सहर नै तपाईंको स्वाभाविक बासस्थान हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie en alles binnen handbereik. Je wilt alles op loopafstand, reuring en gemak. De stad is je natuurlijke habitat."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mphamvu ndi kufikira zinthu mosavuta. Mumafuna kuyenda wapansi, phokoso, ndi zinthu zapafupi. Mzinda ndi kwanu kwenikweni."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humna fi dhiyeenya. Miillaan deemuu, sagalee fi mijaa'ina barbaadda. Magaalaan iddoo uumamaan kee ti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶକ୍ତି ଓ ସୁବିଧା। ଆପଣ ଚାଲିକି ଯାଇପାରିବା ଭଳି ଜାଗା, ଚହଳ ଓ ସୁବିଧା ଚାହାନ୍ତି। ସହର ହିଁ ଆପଣଙ୍କ ସ୍ୱାଭାବିକ ଘର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰੌਣਕ ਅਤੇ ਸਹੂਲਤ। ਤੁਹਾਨੂੰ ਪੈਦਲ ਪਹੁੰਚ, ਚਹਿਲ-ਪਹਿਲ ਅਤੇ ਆਸਾਨੀ ਚਾਹੀਦੀ ਹੈ। ਸ਼ਹਿਰ ਤੁਹਾਡਾ ਕੁਦਰਤੀ ਟਿਕਾਣਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia i dostęp do wszystkiego. Chcesz mieć wszystko blisko, gwar i wygodę. Miasto to twoje naturalne środowisko."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انرژي او لاسرسی. تاسو پلي ګرځېدل، ګڼه ګوڼه او اسانتیا غواړئ. ښار ستاسو طبیعي چاپېریال دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia e acesso. Você quer fazer tudo a pé, movimento, praticidade. A cidade é o seu habitat natural."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia e acesso. Queres fazer tudo a pé, barulho, conveniência. A cidade é o teu habitat natural."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie și acces. Vrei totul la câțiva pași, zgomot, comoditate. Orașul e habitatul tău natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энергия и доступность. Тебе нужно, чтобы всё было рядом, — шум, удобство, движение. Город — твоя естественная среда."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbaraga n'ubworoherane. Ushaka kugera hose n'amaguru, urusaku n'ibintu byose hafi. Umujyi ni wo uri mu kamere yawe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ශක්තිය සහ පහසුව. ඔබට ඕනේ පයින් යන්න පුළුවන් දුර, ඝෝෂාව, පහසුකම්. නගරය තමයි ඔබේ ස්වාභාවික වාසස්ථානය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia a dostupnosť. Chceš mať všetko na pešo, ruch aj pohodlie. Mesto je tvoje prirodzené prostredie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energija in dostopnost. Želiš si vse na dosegu pešpoti, živahnost in udobje. Mesto je tvoj naravni habitat."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simba nekuwanika kwezvinhu. Unoda kufamba netsoka kwese, ruzha, nyore-nyore. Guta ndiyo nzvimbo yako chaiyo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firfircooni iyo gaarsiin fudud. Waxaad rabtaa meel lagu socon karo, buuq iyo fududaan. Magaaladu waa deegaankaaga dabiiciga ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energji dhe afërsi. Do të ecësh në këmbë kudo, zhurmë, komoditet. Qyteti është habitati yt natyral."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергија и доступност. Желиш да све стигнеш пешке, буку, удобност. Град је твоје природно станиште."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanaga sareng gampil ka mana-mana. Anjeun hoyong tiasa leumpang ka mana waé, ramé, sareng praktis. Kota téh habitat alami anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi och närhet. Du vill ha gångavstånd, liv och bekvämlighet. Staden är din naturliga miljö."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguvu na ufikivu. Unataka kufika kila mahali kwa miguu, kelele, urahisi. Jiji ndilo makazi yako ya asili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆற்றலும் அணுகலும். நடந்தே செல்லும் தூரம், சத்தம், வசதி எல்லாம் வேண்டும். நகரம்தான் உங்கள் இயல்பான வாழிடம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉత్సాహం, అన్నీ అందుబాటులో. నడిచి వెళ్లగలగడం, సందడి, సౌకర్యం మీకు కావాలి. నగరమే మీ సహజ నివాసం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қувват ва дастрасӣ. Ба ту лозим аст, ки ҳама чиз дар масофаи пиёда бошад, ғавғо, роҳатӣ. Шаҳр муҳити табиии туст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคึกคักและการเข้าถึงทุกอย่าง คุณอยากเดินไปไหนมาไหนได้ ชอบเสียงอึกทึกและความสะดวกสบาย เมืองคือที่ที่คุณเป็นตัวเอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጉልበትን ቀረባነትን። ብእግሪ ዝኽየድ፣ ህልውና ዘለዎን ምቹእን ትደልዩ። ከተማ እዩ ናይ ተፈጥሮ መንበሪኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joşgun we elýeterlilik. Pyýada ýetip bolýan ýerleri, galmagaly, amatlylygy isleýärsiň. Şäher — seniň tebigy mekanyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji ve erişim. Yürüyerek her yere ulaşmak, hareket, kolaylık istiyorsun. Şehir senin doğal yaşam alanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія й доступність. Тобі потрібні піші відстані, гамір, зручність. Місто — твоє природне середовище."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توانائی اور رسائی۔ آپ کو پیدل فاصلے، رونق اور سہولت چاہیے۔ شہر ہی آپ کا قدرتی ماحول ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayot va qulaylik. Hamma narsa piyoda masofada boʻlishini, shahar shovqini va qulayliklarni xohlaysiz. Shahar — sizning tabiiy muhitingiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năng lượng và tiện lợi. Bạn muốn đi bộ là tới, muốn nhộn nhịp, muốn tiện nghi. Thành phố là môi trường tự nhiên của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amandla nokufikeleleka. Ufuna ukuhamba ngeenyawo, ingxolo, nokulula kwezinto. Isixeko likhaya lakho lendalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agbára àti ìrọ̀rùn. Ẹ fẹ́ kí ohun gbogbo wà nítòsí, ẹ fẹ́ ariwo àti ìrọ̀rùn. Ìlú ni ibùgbé àdámọ́ yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活力與便利。你想要步行可達、熱鬧又方便。城市就是你的天然棲息地。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活力和便利。你想要步行可达、热闹、方便。城市就是你的天然栖息地。"
          }
