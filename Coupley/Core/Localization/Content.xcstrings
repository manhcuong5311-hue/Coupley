        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸರಿಪಡಿಸುವವರಂತಲ್ಲ, ಸ್ನೇಹಿತರಂತೆ ಕೇಳಿಸಿಕೊಳ್ಳಿ. ಅವರ ಭಾವನೆಯನ್ನು ಮತ್ತೆ ಹೇಳಿ ತೋರಿಸಿ."
