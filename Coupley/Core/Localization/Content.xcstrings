    "Communication unlocks worlds. There's probably somewhere you want to go — or someone you want to understand." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikasie maak wêrelde oop. Daar is waarskynlik ’n plek waarheen jy wil gaan – of iemand wat jy wil verstaan."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መግባባት ዓለማትን ይከፍታል። ምናልባት መሄድ የሚፈልጉት ቦታ — ወይም ሊረዱት የሚፈልጉት ሰው አለ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواصل يفتح عوالم. على الأرجح هناك مكان تحلم بزيارته، أو شخص يشغلك فهمه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাষাই নতুন জগতৰ দুৱাৰ খোলে। হয়তো আপুনি ক'ৰবালৈ যাব বিচাৰে — বা কাৰোবাক বুজিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ünsiyyət yeni dünyalar açır. Yəqin ki, getmək istədiyin bir yer — və ya anlamaq istədiyin biri var."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мова адкрывае цэлыя светы. Мусіць, ёсць месца, куды табе хочацца, — ці чалавек, якога хочаш зразумець."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общуването отключва светове. Вероятно има място, където искаш да отидеш – или човек, когото искаш да разбереш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাষা নতুন জগৎ খুলে দেয়। সম্ভবত এমন কোথাও যেতে চাও — বা এমন কাউকে বুঝতে চাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikacija otvara svjetove. Vjerovatno postoji mjesto kamo želiš otići – ili neko koga želiš razumjeti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicar-se obre mons. Segur que hi ha algun lloc on vols anar — o algú a qui vols entendre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk otevírá celé světy. Nejspíš je někde místo, kam chceš jet – nebo někdo, komu chceš rozumět."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae iaith yn agor bydoedd. Mae'n debyg bod rhywle rwyt ti eisiau mynd iddo — neu rywun rwyt ti eisiau ei ddeall."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprog åbner verdener. Der er nok et sted, du gerne vil hen – eller nogen, du gerne vil forstå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache öffnet Welten. Wahrscheinlich gibt es einen Ort, an den du willst – oder jemanden, den du verstehen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επικοινωνία ανοίγει κόσμους. Μάλλον υπάρχει κάπου που θες να πας — ή κάποιος που θες να καταλάβεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicarte te abre mundos. Seguramente hay un lugar al que quieres ir — o alguien a quien quieres entender."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suhtlemine avab maailmu. Ilmselt on kuskil koht, kuhu tahad minna — või keegi, keda tahad mõista."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikazioak munduak irekitzen ditu. Ziurrenik joan nahi duzun lekuren bat badago, edo ulertu nahi duzun norbait."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتباط، دنیاها را باز می‌کند. احتمالاً جایی هست که می‌خواهی بروی — یا کسی که می‌خواهی بفهمی‌اش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kieli avaa maailmoja. Luultavasti on jokin paikka, jonne haluat mennä – tai joku, jota haluat ymmärtää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbubukas ng mundo ang komunikasyon. Malamang may lugar kang gustong puntahan — o may taong gusto mong maintindihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communiquer ouvre des mondes. Il y a sûrement un endroit où tu veux aller — ou quelqu'un que tu veux comprendre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osclaíonn cumarsáid saolta nua. Is dócha go bhfuil áit ar mhaith leat dul ann — nó duine ar mhaith leat a thuiscint."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicarse abre mundos. Seguramente hai algún lugar ao que queres ir, ou alguén a quen queres entender."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાતચીત દુનિયાના દરવાજા ખોલે છે. કદાચ કોઈ જગ્યા છે જ્યાં તમારે જવું છે — કે કોઈ વ્યક્તિ જેને તમારે સમજવી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadarwa na buɗe sababbin duniyoyi. Wataƙila akwai wurin da kuke son zuwa — ko wani da kuke son fahimta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקשורת פותחת עולמות. כנראה שיש מקום שבא לך להגיע אליו — או מישהו שחשוב לך להבין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बातचीत नई दुनिया के दरवाज़े खोलती है। शायद कोई जगह है जहाँ आपको जाना है — या कोई इंसान, जिसे आपको समझना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikacija otvara svjetove. Vjerojatno postoji mjesto kamo želiš otići – ili netko koga želiš razumjeti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kominikasyon louvri pòt tout mond. Gendwa gen yon kote ou vle ale — oswa yon moun ou vle konprann."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kommunikáció világokat nyit meg. Valószínűleg van egy hely, ahová el akarsz jutni – vagy valaki, akit meg akarsz érteni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաղորդակցությունը նոր աշխարհներ է բացում։ Հավանաբար կա մի վայր, ուր ուզում ես գնալ, կամ մեկը, ում ուզում ես հասկանալ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi membuka banyak dunia. Mungkin ada tempat yang ingin kamu kunjungi — atau seseorang yang ingin kamu pahami."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nkwurịta okwu na-emeghe ụwa. O nwere ike ịbụ na e nwere ebe ị chọrọ ịga — ma ọ bụ onye ị chọrọ ịghọta."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samskipti opna heima. Það er líklega einhver staður sem þig langar á – eða einhver sem þig langar að skilja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicare apre mondi. Probabilmente c’è un posto dove vuoi andare — o qualcuno che vuoi capire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉は世界を広げてくれます。きっと行きたい場所か、理解したい誰かがいるのでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi mbukak donya. Mbokmenawa ana panggonan sing pengin panjenengan parani — utawa wong sing pengin panjenengan mangerteni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ენა ახალ სამყაროებს ხსნის. ალბათ, არის ადგილი, სადაც წასვლა გინდა — ან ადამიანი, რომლის გაგებაც გსურს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіл жаңа әлемдердің есігін ашады. Барғың келетін бір жер, не түсінгің келетін біреу бар шығар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការប្រាស្រ័យទាក់ទងបើកពិភពថ្មីៗ។ ប្រហែលជាមានកន្លែងណាមួយដែលអ្នកចង់ទៅ — ឬនរណាម្នាក់ដែលអ្នកចង់យល់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂವಹನ ಹೊಸ ಲೋಕಗಳನ್ನು ತೆರೆಯುತ್ತದೆ. ನೀವು ಹೋಗಬೇಕೆಂದಿರುವ ಸ್ಥಳ — ಅಥವಾ ಅರ್ಥ ಮಾಡಿಕೊಳ್ಳಬೇಕೆಂದಿರುವ ವ್ಯಕ್ತಿ — ಬಹುಶಃ ಇದ್ದಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소통은 새로운 세상을 열어 줘요. 아마 가 보고 싶은 곳이나 더 이해하고 싶은 누군가가 있을 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ragihandin deriyê dinyayan vedike. Belkî cihek heye ku tu dixwazî biçî — an kesek ku tu dixwazî fêm bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тил жаңы дүйнөлөрдү ачат. Балким, бара турган жериң — же түшүнгүң келген бирөө бардыр."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikatioun mécht Welten op. Et gëtt wahrscheinlech eng Plaz, wous de hiwëlls — oder een, deen s de verstoe wëlls."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການສື່ສານເປີດໂລກໃໝ່ ເຈົ້າຄົງມີບ່ອນທີ່ຢາກໄປ — ຫຼື ຄົນທີ່ຢາກເຂົ້າໃຈ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalba atveria pasaulius. Tikriausiai yra vieta, kur nori nuvykti, – ar žmogus, kurį nori suprasti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saziņa atver pasaules. Droši vien ir kāda vieta, kurp gribi doties – vai kāds, ko gribi saprast."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manokatra tontolo ny fifandraisana. Azo inoana fa misy toerana tianao halehana — na olona tianao hotakarina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka huakina e te reo ngā ao hou. Tērā pea he wāhi e hiahia ana koe ki te haere — he tangata rānei e hiahia ana koe kia mārama."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комуникацијата отвора светови. Веројатно има место каде што сакаш да одиш — или некој што сакаш да го разбереш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആശയവിനിമയം പുതിയ ലോകങ്ങൾ തുറന്നുതരുന്നു. നിങ്ങൾക്ക് പോകാൻ ആഗ്രഹമുള്ള ഒരിടമോ, മനസ്സിലാക്കാൻ ആഗ്രഹമുള്ള ഒരാളോ ഉണ്ടാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Харилцаа шинэ ертөнцийг нээдэг. Очихыг хүссэн газар — эсвэл ойлгохыг хүссэн хүн чинь байгаа байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संवादामुळे नवी जगे खुली होतात. बहुधा तुम्हाला कुठेतरी जायचे असेल — किंवा कुणालातरी समजून घ्यायचे असेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi membuka pintu dunia. Mungkin ada tempat yang anda mahu kunjungi — atau seseorang yang anda mahu fahami."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-komunikazzjoni tiftaħ dinjiet. Probabbilment hemm post fejn trid tmur — jew xi ħadd li trid tifhem."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်သွယ်ပြောဆိုနိုင်ခြင်းက ကမ္ဘာတွေကို ဖွင့်ပေးတယ်။ သင် သွားချင်တဲ့ နေရာ — ဒါမှမဟုတ် နားလည်ချင်တဲ့သူ တစ်ယောက် ရှိလောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk åpner verdener. Det finnes nok et sted du vil reise til – eller noen du vil forstå."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संवादले नयाँ संसार खोलिदिन्छ। सायद तपाईं कतै जान चाहनुहुन्छ — वा कसैलाई बुझ्न चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communicatie opent werelden. Er is vast een plek waar je heen wilt – of iemand die je wilt begrijpen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulankhulana kumatsegula maiko atsopano. Mwina pali malo amene mukufuna kupita — kapena munthu amene mukufuna kumumvetsa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walqunnamtiin addunyaa haaraa bana. Tarii bakki itti deemuu barbaaddu jira — ykn namni hubachuu barbaaddu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଭାଷା ନୂଆ ଦୁନିଆର ଦ୍ୱାର ଖୋଲେ। ସମ୍ଭବତଃ କୌଣସି ସ୍ଥାନକୁ ଆପଣ ଯିବାକୁ ଚାହାନ୍ତି — କିମ୍ବା କାହାକୁ ଭଲ ଭାବେ ବୁଝିବାକୁ ଚାହାନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਭਾਸ਼ਾ ਨਵੀਆਂ ਦੁਨੀਆਂ ਖੋਲ੍ਹਦੀ ਹੈ। ਸ਼ਾਇਦ ਕੋਈ ਥਾਂ ਹੈ ਜਿੱਥੇ ਤੁਸੀਂ ਜਾਣਾ ਚਾਹੁੰਦੇ ਹੋ — ਜਾਂ ਕੋਈ ਇਨਸਾਨ ਜਿਸ ਨੂੰ ਤੁਸੀਂ ਸਮਝਣਾ ਚਾਹੁੰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język otwiera światy. Pewnie jest miejsce, do którego chcesz pojechać – albo ktoś, kogo chcesz zrozumieć."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اړیکه نړۍ پرانیزي. شاید داسې ځای وي چې تلل غواړئ — یا داسې څوک چې پوهېدل یې غواړئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comunicação abre mundos. Deve ter algum lugar aonde você quer ir — ou alguém que você quer entender."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comunicação abre mundos. Deve haver um sítio onde queres ir — ou alguém que queres compreender."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicarea deschide lumi. Probabil există un loc unde vrei să ajungi — sau cineva pe care vrei să-l înțelegi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык открывает целые миры. Наверняка есть место, куда тебе хочется поехать, — или человек, которого хочется понять."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itumanaho rifungura isi nshya. Birashoboka ko hari aho wifuza kujya — cyangwa umuntu wifuza gusobanukirwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සන්නිවේදනය ලෝක විවර කරනවා. ඔබට යන්න ඕනේ තැනක් — නැත්නම් තේරුම් ගන්න ඕනේ කෙනෙක් — ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikácia otvára svety. Určite je niekde miesto, kam chceš ísť – alebo niekto, komu chceš porozumieť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikacija odpira svetove. Verjetno je nekje kraj, kamor si želiš – ali nekdo, ki ga želiš razumeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutaurirana kunovhura nyika. Zvimwe pane kwaunoda kuenda — kana munhu waunoda kunzwisisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isgaarsiintu waxay furtaa adduunyo cusub. Malaha waxa jira meel aad rabto inaad tagto — ama qof aad rabto inaad fahanto."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikimi hap botë të tëra. Ndoshta ka një vend ku do të shkosh – ose dikë që do ta kuptosh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комуникација отвара светове. Вероватно постоји место где желиш да одеш — или неко кога желиш да разумеш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi muka rupa-rupa dunya. Meureun aya tempat anu hoyong didatangan, atanapi jalma anu hoyong dipikaharti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk öppnar världar. Det finns nog ett ställe du vill åka till – eller någon du vill förstå."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mawasiliano hufungua ulimwengu. Huenda kuna mahali unapotaka kwenda — au mtu unayetaka kumwelewa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர்பு உலகங்களைத் திறக்கிறது. நீங்கள் செல்ல விரும்பும் ஓர் இடமோ, புரிந்துகொள்ள விரும்பும் ஒருவரோ இருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "భాష కొత్త ప్రపంచాలను తెరుస్తుంది. మీరు వెళ్లాలనుకునే చోటు — లేదా అర్థం చేసుకోవాలనుకునే వ్యక్తి బహుశా ఉండే ఉంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муошират дари дунёҳоро мекушояд. Эҳтимол ҷое ҳаст, ки мехоҳӣ равӣ — ё касе, ки мехоҳӣ фаҳмӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสื่อสารเปิดประตูสู่โลกใหม่ คุณน่าจะมีที่ไหนสักแห่งที่อยากไป หรือใครสักคนที่อยากเข้าใจ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ርክብ ዓለማት ይኸፍት። ምናልባት ክትከዱዎ እትደልዩ ቦታ — ወይ ክትርድእዎ እትደልዩ ሰብ — ኣሎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aragatnaşyk täze dünýäleri açýar. Megerem, gitmek isleýän ýeriň — ýa-da düşünmek isleýän adamyň bardyr."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İletişim yeni dünyaların kapısını açar. Muhtemelen gitmek istediğin bir yer ya da anlamak istediğin biri var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спілкування відкриває світи. Мабуть, є місце, куди тобі хочеться поїхати, — або людина, яку хочеться зрозуміти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بات چیت نئی دنیائیں کھولتی ہے۔ شاید کوئی ایسی جگہ ہے جہاں جانے کا ارمان ہے، یا کوئی ایسا شخص جسے سمجھنے کی چاہ ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muloqot dunyolarni ochadi. Ehtimol, borishni istagan joyingiz — yoki tushunishni istagan odamingiz bor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao tiếp mở ra cả thế giới. Chắc có nơi nào đó bạn muốn đến — hoặc ai đó bạn muốn hiểu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unxibelelwano luvula amahlabathi. Mhlawumbi kukho indawo ofuna ukuya kuyo — okanye umntu ofuna ukumqonda."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbánisọ̀rọ̀ ń ṣí ayé sílẹ̀. Ó ṣeé ṣe kí ibì kan wà tí ẹ fẹ́ lọ — tàbí ẹnì kan tí ẹ fẹ́ lóye."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溝通能打開新世界。你大概有個很想去的地方，或很想了解的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沟通能打开新世界。也许有个你想去的地方，或者有个你想读懂的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溝通能打開新世界。你大概有個想去的地方，或想更了解的人。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuxhumana kuvula imihlaba. Kungenzeka kukhona lapho ufuna ukuya khona — noma umuntu ofuna ukumqonda."
          }
        }
      }
    },
