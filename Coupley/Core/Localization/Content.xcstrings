        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැලකිල්ල පෙන්නන්න පහසුම ක්‍රමවලින් එකක් කෑම — ඔබේ සහකරු කැමති මොනවද කියලා දැනගැනීම වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedlo je jeden z najjednoduchších spôsobov, ako ukázať starostlivosť – záleží na tom, vedieť, čo tvoja polovička miluje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana je eden najlažjih načinov, da pokažeš skrb – pomembno je vedeti, kaj tvoj partner obožuje."
