        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ඔබේ සහකරුව එදිනෙදා ජීවිතය තුළ ළඟින් තියාගන්නවා. එක්ව කරන පුරුදු සහ ඒ හා බැඳුණු දේවල් ඔබට අර්ථවත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržiavaš si ju blízko v každodennom živote. Spoločné rituály a drobné súvislosti majú pre teba veľký význam."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partnerja ohranjaš prisotnega v vsakdanu. Skupni rituali in asociacije ti veliko pomenijo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unomuchengeta ari pedyo muupenyu hwako hwezuva nezuva. Tsika dzamunogovana nezvinhu zvinokuyeuchidza nezvake zvinokosha kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lammaanahaaga waxaad ku haysaa nolol maalmeedkaaga. Caadooyinka la wadaago iyo waxyaabaha xusuusta leh macno ayay kuu leeyihiin."
