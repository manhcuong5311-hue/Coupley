        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανάλογα με την περίσταση, και με ειλικρίνεια. Αρκεί να μπορείς να λες πώς είσαι, αυτή η ευελιξία δουλεύει μια χαρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el contexto, y con sinceridad. Mientras puedas comunicar cómo estás, esta flexibilidad funciona bien."
