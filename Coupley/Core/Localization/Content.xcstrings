    "Low + sad is a presence-only moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزن مع انخفاض الطاقة لحظة تحتاج إلى الحضور فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Málo energie a smutek – chvíle, kdy stačí být nablízku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træt og trist er et øjeblik for nærvær og intet andet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpft und traurig – jetzt zählt nur, da zu sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλή ενέργεια και λύπη: στιγμή μόνο για παρουσία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin energía y con tristeza: es momento solo de estar presente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väsynyt ja surullinen tarvitsee pelkkää läsnäoloa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag matamlay at malungkot, presensya lang ang kailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue et tristesse : c'est le moment d'être là, simplement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנרגיה נמוכה ועצב — זה רגע שדורש רק נוכחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थकान और उदासी साथ हों, तो बस मौजूद रहना ही काफ़ी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fáradt és szomorú – ilyenkor elég, ha ott vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemas dan sedih adalah momen untuk sekadar hadir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giù di energie e di morale: è il momento di esserci e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元気がなくて悲しいときは、ただそばにいることがいちばんです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기운 없고 슬플 땐 그저 곁에 있어 주는 게 전부예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letih dan sedih ialah masa untuk sekadar hadir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite energi og tristhet: da holder det å bare være der."
