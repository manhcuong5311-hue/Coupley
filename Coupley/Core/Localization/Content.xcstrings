        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag ubos na ang lakas, mas mahalaga ang ginhawa kaysa sa pampalubag-loob."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l'énergie manque, un vrai soulagement vaut mieux que des paroles rassurantes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשאין כוח, הקלה עדיפה על הרגעה."
