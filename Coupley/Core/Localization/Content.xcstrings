        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gulden middenweg. Je waardeert orde, maar je gaat geen ruzie maken om een bord in de gootsteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Złoty środek. Doceniasz porządek, ale nie zrobisz awantury o jeden talerz w zlewie."
