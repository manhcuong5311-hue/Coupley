          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoonallisuutta ympäristöön. Entinen varastohalli, vene, mökki ilman sähköverkkoa – haluat tilan kertovan jotain sinusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalidad sa tirahan. Ni-renovate na bodega, bangka, off-grid na cabin — gusto mong may sinasabi ang espasyo tungkol sa’yo."
