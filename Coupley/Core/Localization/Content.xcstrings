        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए रिश्ता एक साझा प्रोजेक्ट है। बड़े फ़ैसलों में आप दोनों शामिल हों — आपको यही चाहिए।"
