        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמישהו נסער, להרגיש מובנים עדיף על לקבל פתרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई बेचैन हो, तो समझा जाना हल किए जाने से बेहतर है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je netko uznemiren, razumijevanje je bolje od rješenja."
