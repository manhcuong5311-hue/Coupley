        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akunzima ukukwanelisa kwaye uyaziqhelanisa. Qiniseka nje ukuba uyathetha xa kukho into ebalulekileyo kuwe — ukuba ‘lula’ kunokukushiya unenzondo."
