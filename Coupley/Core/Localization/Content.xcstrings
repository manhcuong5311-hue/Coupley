        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 궁합에 따라 휴가가 즐거울 수도, 망칠 수도 있어요. 일찍 알아 두면 좋아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keserasian ketika melancong boleh menentukan berjaya atau gagalnya percutian — elok diketahui awal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om dere passer sammen på reise, kan avgjøre hele ferien – verdt å vite tidlig."
