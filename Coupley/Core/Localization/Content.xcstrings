        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चिंगारी का बुझना ज़रूरी नहीं — पर उसे ज़िंदा क्या रखता है, यह हर किसी के लिए अलग है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
