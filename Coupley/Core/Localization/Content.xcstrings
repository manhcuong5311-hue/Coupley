        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমাকে টেনে ধরার মতো কিছু চাই। ধরন আর কে সাজেস্ট করল তা জরুরি — ঠিক সময়ে ঠিক বই সবকিছু বদলে দেয়।"
