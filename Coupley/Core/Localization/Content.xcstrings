        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሚስብ ነገር ያስፈልግዎታል። ዘውግና ጥቆማ ወሳኝ ናቸው — በትክክለኛው ጊዜ የሚገኝ ትክክለኛ መጽሐፍ ሁሉንም ይለውጣል።"
