        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি কোথা থেকে এসেছ, সে নিয়ে সচেতন। তোমার গল্পের ভালো আর কঠিন, দুটো দিকই তুমি দেখতে পাও।"
