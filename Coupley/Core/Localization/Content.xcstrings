        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaš rješenje, ali ga ne primjenjuješ. Voljena osoba koja ranije liježe mogla bi pomoći – ili te izluditi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou konnen solisyon an men ou pa fè l. Yon patnè ki kouche pi bonè ka ede ou toutbon — oswa fè ou fou."
