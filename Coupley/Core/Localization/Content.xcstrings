        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಏನನ್ನೂ ಬಯಸದ ಸಂದೇಶ, ಖಾಲಿಯಾದ ಮನಸ್ಸಿಗೆ ಹೊರೆಯಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부담 없는 신호는 방전된 배터리를 더 닳게 하지 않아요."
