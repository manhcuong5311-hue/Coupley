        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offene Tür. Das klappt gut, wenn ihr beide euch traut, Dinge auch ohne offizielle Einladung anzusprechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόρτα πάντα ανοιχτή. Δουλεύει καλά όταν και οι δύο νιώθετε άνετα να ανοίγετε θέματα χωρίς επίσημη πρόσκληση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puertas abiertas. Funciona bien cuando los dos se sienten cómodos sacando temas sin necesidad de una invitación formal."
