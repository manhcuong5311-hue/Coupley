        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسم اور کوشش۔ آپ کے خیال میں چنگاری مسلسل توجہ سے قائم رہتی ہے، قسمت پر چھوڑنے سے نہیں۔"
