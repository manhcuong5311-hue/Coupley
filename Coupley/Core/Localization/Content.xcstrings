        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حواس‌جمعی، زبان عشق توست. با عمل کردن به جزئیات کوچک ثابت می‌کنی گوش داده‌ای — و این بی‌صدا قدرتمند است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
