        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ngerti solusine nanging ora ditindakake. Pasangan sing turu luwih gasik bisa mbantu — utawa malah nggawe panjenengan mumet."
