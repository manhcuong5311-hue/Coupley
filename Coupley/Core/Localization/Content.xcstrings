    "Listen like a friend, not a fixer. Echo back what they feel." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصغوا كصديق، لا كمن يصلح الأعطال. ردّدوا ما يشعر به شريكك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslouchej a nesnaž se nic spravovat. Zrcadli, co cítí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyt som en ven, ikke som en problemløser. Spejl de følelser, din partner giver udtryk for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör zu wie unter Freunden, ohne gleich reparieren zu wollen. Spiegle die Gefühle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άκου για να καταλάβεις, όχι για να «διορθώσεις». Επανάλαβε αυτό που νιώθει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha para acompañar, no para arreglar. Repite con tus palabras lo que siente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntele kuin ystävä, älä kuin korjaaja. Sanoita, mitä hän tuntee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makinig na parang kaibigan, hindi tagaayos. Ibalik sa kanya ang nararamdaman niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute pour comprendre, pas pour réparer. Reformule ce que l'autre ressent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להקשיב כדי להבין, לא כדי לתקן. לשקף בחזרה את מה שמרגישים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल बताने वाले की तरह नहीं, दोस्त की तरह सुनें। उनकी भावनाएँ अपने शब्दों में दोहराएँ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallgasd meg barátként, ne problémamegoldóként. Tükrözd vissza, amit érez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengarkan sebagai teman, bukan sebagai pemberi solusi. Ulangi apa yang dia rasakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta con orecchio amico, senza voler risolvere. Rispecchia ciò che prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決役ではなく、友だちとして話を聴きましょう。相手の気持ちをそのまま言葉にして返してみて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해결사 말고 친구처럼 들어 주세요. 연인이 느끼는 감정을 그대로 되짚어 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengar seperti kawan, bukan tukang baiki. Ulang semula apa yang dia rasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytt som en venn, ikke som en reparatør. Speil det partneren din føler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luister als een vriend, niet als een probleemoplosser. Benoem wat je partner voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słuchaj jak przyjaciel, nie jak ktoś od naprawiania. Nazwij na głos to, co czuje druga połówka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escute como quem é amigo, não como quem conserta. Devolva o que seu amor sente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascultă ca un prieten, nu ca un reparator. Spune-i cu vorbele tale ce simte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушай как друг — не пытайся всё исправить. Повторяй своими словами, что чувствует партнёр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssna som en vän, inte som en problemlösare. Spegla det din partner känner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังแบบเพื่อน ไม่ใช่แบบช่างซ่อม สะท้อนความรู้สึกของคนรักกลับไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorun çözücü gibi değil, arkadaş gibi dinle. Hissettiklerini ona geri yansıt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слухай як друг, а не як майстер-ремонтник. Віддзеркалюй почуття половинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lắng nghe như một người bạn, không phải người sửa chữa. Nhắc lại điều người ấy đang cảm thấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像朋友一样倾听，而不是急着解决问题。把另一半的感受复述回去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像朋友一樣聽，不要急著解決。把對方的感受複述一遍。"
          }
        }
      }
    },
