        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आम बात से बेहतर ख़ास बात। “आप कमाल हैं” का असर फीका रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretno > općenito. „Super si” prođe bez traga."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presi > jeneral. “Ou fòmidab” pa rive lwen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A konkrét jobb az általánosnál. A „csodálatos vagy” üresen cseng."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կոնկրետն ավելի լավ է, քան ընդհանուրը։ «Դու հրաշալի ես»-ը չի հասնում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesifik lebih baik daripada umum. “Kamu luar biasa” terasa hambar."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nke a kapịrị ọnụ > nke izugbe. ‘Ị dị ebube’ anaghị eru obi."
          }
        },
        "is" : {
          "stringUnit" : {
