        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhazi, mana ọ naghị anyịgbu. Ọ na-amasị gị oge e ji ebumnuche hazie, n'adịghị ka ọgwụgwọ kwa izu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipulagt en ekki yfirþyrmandi. Þú vilt meðvitaðar stundir án þess að það verði eins og meðferðartími í hverri viku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una certa regolarità, senza esagerare. Ti piacciono i momenti intenzionali, senza che sembri una seduta di terapia ogni settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きちんとしつつ、重すぎない。毎週カウンセリングのようになるのは避けつつ、意識的な時間を持ちたいタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tertata nanging ora ngabotake. Panjenengan seneng wayah sing disengaja tanpa rumangsa kaya terapi saben minggu."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სტრუქტურა, მაგრამ ზედმეტი დატვირთვის გარეშე. გიყვარს გააზრებული მომენტები, ოღონდ ისე, რომ ყოველკვირეულ თერაპიას არ ჰგავდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жүйелі, бірақ шамадан тыс емес. Әр апта терапия сияқты болмайтын саналы сәттерді ұнатасың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានរបៀប ប៉ុន្តែមិនធ្ងន់ពេក។ អ្នកចូលចិត្តពេលវេលាដែលមានចេតនា ដោយមិនឲ្យមានអារម្មណ៍ដូចទៅព្យាបាលរៀងរាល់សប្ដាហ៍។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕ್ರಮಬದ್ಧ, ಆದರೆ ಭಾರವಲ್ಲ. ಪ್ರತಿ ವಾರ ಥೆರಪಿಯಂತೆ ಅನಿಸದ, ಉದ್ದೇಶಪೂರ್ವಕ ಕ್ಷಣಗಳು ನಿಮಗಿಷ್ಟ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체계적이지만 부담스럽지 않게. 매주 상담받는 느낌 없이 의미 있는 순간을 갖고 싶어 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi rêk lê ne giran. Tu kêliyên bi niyet dixwazî, bêyî ku her hefte wekî dermankirinê be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тартиптүү, бирок ашыкча эмес. Атайын көз ирмемдерди жакшы көрөсүң, бирок ар жума терапиядагыдай болбошу керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturéiert, mee net ze vill. Du hues bewosst Momenter gär, ouni datt et sech all Woch wéi Therapie ufillt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ມີແບບແຜນແຕ່ບໍ່ໜັກເກີນໄປ ເຈົ້າມັກຊ່ວງເວລາທີ່ຕັ້ງໃຈ ໂດຍບໍ່ຮູ້ສຶກຄືໄປບຳບັດທຸກອາທິດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktūra be perkrovos. Tau patinka sąmoningos akimirkos, bet ne taip, lyg kiekvieną savaitę lankytumėtės terapijoje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar ritmu, bet bez pārspīlējuma. Tev patīk apzināti brīži, bet ne tā, it kā katru nedēļu būtu terapija."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voalamina nefa tsy mavesatra. Tianao ny fotoana natokana nefa tsy toa fitsaboana isan-kerinandro."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He whai hanganga, engari kāore i te taumaha rawa. He pai ki a koe ngā wā whai whakaaro, kaua kia rite ki te haumanu ia wiki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со структура, но без претерување. Сакаш намерни моменти, а да не изгледа како терапија секоја недела."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചിട്ടയുണ്ട്, പക്ഷേ ഭാരമില്ല. എല്ലാ ആഴ്ചയും തെറാപ്പി പോലെ തോന്നാതെ, മനഃപൂർവമായ നിമിഷങ്ങളാണ് നിങ്ങൾക്കിഷ്ടം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зохион байгуулалттай ч хэт их биш. Чи санаатай мөчүүдэд дуртай, гэхдээ долоо хоног бүр эмчилгээнд суугаа юм шиг байхыг хүсэхгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठरवून, पण दडपण न आणता. तुम्हाला हेतुपूर्वक काढलेले क्षण आवडतात, पण दर आठवड्याला थेरपीसारखे वाटायला नको."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersusun tetapi tidak membebankan. Anda suka saat yang dirancang tanpa terasa seperti sesi terapi setiap minggu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struttura, iżda mhux toqol. Tħobb mumenti intenzjonati mingħajr ma jidher qisu terapija kull ġimgħa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စနစ်ကျပေမဲ့ မလွန်ကဲဘူး။ အပတ်တိုင်း ကုထုံးခံနေရသလို မခံစားရဘဲ ရည်ရွယ်ချက်ရှိတဲ့ အခိုက်အတန့်တွေကို သင် ကြိုက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturert, men ikke overveldende. Du liker bevisste øyeblikk uten at det føles som parterapi hver uke."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यवस्थित तर बोझिलो होइन। तपाईं सोचेर बनाइएका क्षण मन पराउनुहुन्छ, तर हरेक हप्ता थेरापीजस्तो नलागोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestructureerd maar niet overweldigend. Je houdt van bewuste momenten, zonder dat het elke week als therapie voelt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwadongosolo koma osalemetsa. Mumakonda mphindi zokonzedwa mwadala popanda kumva ngati uphungu sabata iliyonse."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qindaa'aa garuu kan nama hin dadhabsiifne. Yeroo kaayyoon qophaa'e jaallatta, garuu torbaan hunda akka yaala hin fakkaannee."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଂଗଠିତ, କିନ୍ତୁ ଅଧିକ ନୁହେଁ। ପ୍ରତି ସପ୍ତାହ ଥେରାପି ଭଳି ନ ଲାଗି ସଚେତନ ମୁହୂର୍ତ୍ତ ଆପଣଙ୍କୁ ଭଲ ଲାଗେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤਰਤੀਬ ਵਾਲਾ ਪਰ ਭਾਰੀ ਨਹੀਂ। ਤੁਹਾਨੂੰ ਸੋਚੇ-ਸਮਝੇ ਪਲ ਪਸੰਦ ਹਨ, ਪਰ ਇਹ ਨਹੀਂ ਕਿ ਹਰ ਹਫ਼ਤੇ ਥੈਰੇਪੀ ਵਰਗਾ ਲੱਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z planem, ale bez przesady. Lubisz świadome chwile, ale bez wrażenia, że co tydzień siedzisz na terapii."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منظم، خو نه ستړی‌کوونکی. تاسو هدفمنې شېبې خوښوئ، پرته له دې چې هره اونۍ د درملنې غونډه ښکاره شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com estrutura, mas sem exagero. Você gosta de momentos intencionais, sem parecer terapia toda semana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com estrutura, mas sem exageros. Gostas de momentos intencionais sem que pareça terapia todas as semanas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structurat, dar fără exces. Îți plac momentele dedicate relației, fără să pară terapie săptămânală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть структура, но без перегруза. Ты любишь осознанные моменты, но без ощущения еженедельной терапии."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifite gahunda ariko ntibiremereye. Ukunda ibihe byateganyijwe nta kumva ko ari ubuvuzi bwa buri cyumweru."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ක්‍රමවත්, ඒත් බරක් නැති. සතියෙන් සතියට ප්‍රතිකාරයක් වගේ නොදැනෙන, හිතලා කරන මොහොතවල් ඔබ කැමතියි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štruktúra, ale nie príliš. Páčia sa ti vedomé chvíle, no nechceš, aby to každý týždeň pôsobilo ako terapia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urejeno, a ne pretirano. Všeč so ti premišljeni trenutki, ne da bi bilo vsak teden kot na terapiji."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakarongeka asi zvisinganyanyi. Unoda nguva dzine chinangwa pasina kunzwa sekuenda kunorapwa vhiki nevhiki."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nidaamsan laakiin aan culays lahayn. Waxaad jeceshahay daqiiqado ujeeddo leh iyadoo aanay u ekaan daaweyn toddobaad kasta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E strukturuar, por jo e rëndë. Të pëlqejnë momentet e qëllimshme, pa u ndier si terapi çdo javë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Са структуром, али не напорно. Волиш намерне тренутке, а да то не личи на терапију сваке недеље."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teratur tapi teu ngabeuratkeun. Anjeun resep waktos anu disengaja tanpa karaos siga terapi unggal minggu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturerat men inte överväldigande. Du gillar medvetna stunder utan att det känns som terapi varje vecka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mpangilio bila kulemewa. Unapenda nyakati za makusudi bila kuhisi kama ni tiba kila wiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒழுங்கானது, ஆனால் சுமையல்ல. ஒவ்வொரு வாரமும் ஆலோசனை அமர்வு போல உணராமல், திட்டமிட்ட தருணங்களை விரும்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక పద్ధతి ఉంది, కానీ భారంగా ఉండదు. ప్రతి వారం థెరపీలా అనిపించకుండా, ఉద్దేశపూర్వకమైన క్షణాలు మీకు ఇష్టం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муташаккил, вале на вазнин. Ту лаҳзаҳои огоҳонаро дӯст медорӣ, бе он ки ҳар ҳафта ба ҷаласаи терапия монанд шавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีแบบแผนแต่ไม่หนักเกินไป คุณชอบให้มีช่วงเวลาคุยกันอย่างตั้งใจ โดยไม่รู้สึกเหมือนต้องเข้าบำบัดทุกสัปดาห์"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስሩዕ ግን ዘየጨንቕ። ሰሙን ሰሙን ከም ፍወሳ ከይመሰለ ዕላማዊ ህሞታት ትፈትዉ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tertipli, ýöne agyr däl. Sen her hepde terapiýa ýaly duýulmaýan, niýetli pursatlary halaýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenli ama bunaltıcı değil. Her hafta terapiye dönüşmeden bilinçli anlar yaşamayı seviyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Є структура, але без перевантаження. Тобі подобаються свідомі моменти, які не перетворюються на щотижневу терапію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منظم مگر بوجھل نہیں۔ آپ کو سوچے سمجھے لمحات پسند ہیں، بغیر اس کے کہ ہر ہفتے تھراپی جیسا لگے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartibli, lekin ortiqcha emas. Har hafta psixoterapiyadek tuyulmaydigan, ongli lahzalarni yoqtirasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có nề nếp nhưng không quá tải. Bạn thích những khoảnh khắc có chủ ý mà không thấy như tuần nào cũng đi trị liệu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kucwangcisiwe kodwa akuxinzelelisi. Uthanda amaxesha anenjongo ngaphandle kokuba kuvakale ngathi lunyango veki nganye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó létò ṣùgbọ́n kò wúwo jù. Ẹ fẹ́ràn àwọn àkókò tí a pète, láìjẹ́ pé ó dà bí ìtọ́jú ọkàn lọ́sọ̀ọ̀sẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有規律但不會壓力太大。你喜歡特意留給彼此的時刻，但不想每星期都像在做輔導。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有规律，又不会有负担。你喜欢有意识的交流时刻，但不想每周都像在做心理咨询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有規律但不會壓力太大。你喜歡刻意留給彼此的時刻，但不想每週都像在做諮商。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuhlelekile kodwa akukhulu kakhulu. Uthanda izikhathi ezinenhloso ngaphandle kokuthi kuzwakale njengokwelashwa masonto onke."
          }
        }
      }
    },
    "Suggest a short walk together — movement takes the edge off." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel ’n kort stappie saam voor – beweging haal die angel uit."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አብራችሁ አጭር የእግር ጉዞ እንድታደርጉ ይጠቁሙ — እንቅስቃሴ ውጥረቱን ያለዝባል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقترحوا نزهة قصيرة معًا، فالحركة تخفف الحدّة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একেলগে অলপ খোজ কাঢ়িবলৈ যোৱাৰ প্ৰস্তাৱ দিয়ক — চলা-ফুৰাই চাপ পাতল কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikdə qısa gəzinti təklif et — hərəkət gərginliyi azaldır."
