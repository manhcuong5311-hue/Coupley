        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيرة صادقة، ولا بأس بذلك، خاصة في مرحلة انتقالية. والشريك الداعم يمكن أن يكون مرساة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ অনিশ্চয়তা। ই একেবাৰে ঠিক — বিশেষকৈ যদি আপুনি এটা পৰিৱৰ্তনৰ সময়ত আছে। সমৰ্থন কৰা সংগী এজন ভৰসাৰ খুঁটি হ'ব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səmimi qeyri-müəyyənlik. Bu, normaldır — xüsusən də keçid dövründəsənsə. Dəstək olan partnyor sənin üçün dayaq ola bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шчырая нявызначанасць. Гэта нармальна — асабліва ў час пераменаў. Палавінка, што падтрымлівае, можа стаць тваёй апорай."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честна несигурност. Това е напълно нормално – особено ако си в преходен период. Половинка, която те подкрепя, може да ти бъде котва."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ অনিশ্চয়তা। এতে কোনো সমস্যা নেই — বিশেষ করে যদি তুমি কোনো পরিবর্তনের মাঝে থাকো। পাশে থাকা একজন পার্টনার তখন ভরসার নোঙর হতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskrena nesigurnost. I to je u redu – naročito ako prolaziš kroz period promjena. Voljena osoba koja te podržava može ti biti oslonac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incertesa sincera. I no passa res — sobretot si ets en una etapa de canvi. Una parella que et doni suport pot ser un punt d'ancoratge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřímná nejistota. To je v pořádku – zvlášť když procházíš změnou. Protějšek, který tě podporuje, může být tvou kotvou."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansicrwydd gonest. Mae hynny'n iawn — yn enwedig os wyt ti mewn cyfnod o newid. Gall partner cefnogol fod yn angor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærlig usikkerhed. Det er okay – især hvis du står i en overgangsfase. En støttende partner kan være et anker."
