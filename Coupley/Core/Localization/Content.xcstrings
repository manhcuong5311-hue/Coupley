          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse. May pride ka sa propesyon mo nang hindi nawawala ang sarili mo. Malamang madali kang pakisamahan pagdating dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l'équilibre. Tu as une fierté professionnelle sans t'y perdre. Sur ce plan, tu es sûrement une personne facile à vivre."
