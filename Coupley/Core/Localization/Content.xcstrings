        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எந்த எல்லையும் தவறல்ல — ஆனால் நீங்கள் எங்கே இருக்கிறீர்கள் என்று தெரிந்தால் ஒரு அணியாகத் திட்டமிட முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఏ అతి కూడా తప్పు కాదు — కానీ మీరు ఎక్కడ ఉన్నారో తెలిస్తే ఒక జట్టుగా ప్లాన్ చేసుకోవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳеҷ як аз ду қутб нодуруст нест — вале донистани ҷойи худ ба шумо кӯмак мекунад, ки ҳамчун даста нақша кашед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีขั้วไหนผิด แต่การรู้ว่าคุณอยู่ตรงไหนช่วยให้วางแผนร่วมกันเป็นทีมได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝኾነ ጽንፊ ጌጋ ኣይኮነን — ኣበይ ከም ዘለኹም ምፍላጥ ግን ከም ጋንታ ክትውጥኑ ይሕግዘኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç bir çäk nädogry däl — ýöne öz ýeriňi bilmek bir topar bolup meýilleşdirmäge kömek edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki uç da yanlış değil; ama nerede durduğunu bilmek, ekip olarak plan yapmanıza yardım eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодна крайність не є помилкою — але, знаючи свою позицію, легше планувати як команда."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی بھی انتہا غلط نہیں — مگر یہ جاننا کہ آپ کہاں ہیں، ایک ٹیم کی طرح منصوبہ بنانے میں مدد دیتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hech bir chekka notoʻgʻri emas — lekin qayerda turganingizni bilish jamoa boʻlib reja tuzishga yordam beradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thái cực nào là sai — nhưng biết mình đứng ở đâu giúp hai bạn lên kế hoạch như một đội."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akukho cala liphosakeleyo — kodwa ukwazi apho ukhoyo kukunceda nicwangcise njengeqela."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kò sí ìkangun kan tó burú — ṣùgbọ́n mímọ ibi tí ẹ dúró sí ń ràn yín lọ́wọ́ láti ṣètò bí ẹgbẹ́ kan."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩個極端都沒有錯，但知道自己的位置，能幫你們像團隊一樣計劃。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪种极端都没有错——但知道自己偏向哪一边，能帮你们像队友一样规划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪個極端都沒有錯，但知道自己的位置，能幫你們像團隊一樣規劃。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asikho isimo esedlulele esingalungile — kodwa ukwazi ukuthi ume kuphi kunisiza nihlele njengethimba."
          }
        }
      }
    },
