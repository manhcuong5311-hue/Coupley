    "Location expectations matter more than people discuss early in relationships." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقعات مكان العيش أهم مما يناقشه الناس في بداية العلاقات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Představy o místě, kde žít, jsou důležitější, než o nich lidé na začátku vztahu mluví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventninger om, hvor man skal bo, betyder mere, end folk taler om tidligt i et forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwartungen an den Wohnort sind wichtiger, als viele am Anfang einer Beziehung besprechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προσδοκίες για τον τόπο μετράνε περισσότερο απ' όσο τις συζητάμε στην αρχή μιας σχέσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cada uno espera sobre dónde vivir importa más de lo que se suele hablar al principio de una relación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asuinpaikkaa koskevat odotukset ovat tärkeämpiä kuin suhteen alussa yleensä puhutaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas mahalaga ang inaasahan ninyo sa lugar na titirhan kaysa sa gaano ito kadalas pag-usapan sa simula ng relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attentes sur le lieu de vie comptent plus qu'on n'en parle au début d'une relation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציפיות לגבי מקום המגורים חשובות יותר ממה שנוהגים לדבר עליהן בתחילת קשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहाँ रहना है, यह उम्मीद उससे कहीं ज़्यादा मायने रखती है जितनी रिश्ते की शुरुआत में इस पर बात होती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lakóhellyel kapcsolatos elvárások többet számítanak, mint amennyit egy kapcsolat elején beszélni szoktak róluk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harapan soal tempat tinggal lebih penting daripada yang biasanya dibahas di awal hubungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aspettative su dove vivere contano più di quanto se ne parli all’inizio di una relazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住む場所についての考えは、付き合い始めに話し合われることが少ないわりに、とても大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디에 살고 싶은지는 연애 초반에 잘 이야기하지 않지만, 생각보다 훨씬 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangkaan tentang tempat tinggal lebih penting daripada yang dibincangkan orang di awal hubungan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventninger om bosted betyr mer enn folk snakker om tidlig i et forhold."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwachtingen over waar je woont doen ertoe – meer dan stellen er in het begin over praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwania co do miejsca do życia znaczą więcej, niż pary zwykle przyznają na początku związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As expectativas sobre onde morar importam mais do que se costuma conversar no começo da relação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așteptările legate de unde veți locui contează mai mult decât se discută la începutul unei relații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вопрос о том, где жить, важнее, чем кажется, — а в начале отношений его редко обсуждают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förväntningar på var man ska bo spelar större roll än man brukar prata om tidigt i en relation."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคาดหวังเรื่องที่อยู่สำคัญกว่าที่คู่รักมักคุยกันในช่วงแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede yaşanacağına dair beklentiler, ilişkinin başında konuşulandan çok daha önemlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікування щодо місця життя важать більше, ніж про них зазвичай говорять на початку стосунків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mong muốn về nơi sống quan trọng hơn mức mọi người hay bàn lúc mới yêu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对居住地的期待很重要，但很多人在感情初期很少聊到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對居住地的期待很重要，只是交往初期大家常常沒聊到。"
          }
        }
      }
    },
