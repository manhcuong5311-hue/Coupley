        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat beaflosst alles — deng Stëmmung, deng Gedold, deng Fäegkeet, no ze sinn. Et lount sech, dat als Prioritéit ze behandelen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເລື່ອງນີ້ມີຜົນຕໍ່ທຸກຢ່າງ — ອາລົມ ຄວາມອົດທົນ ແລະ ຄວາມສາມາດໃນການໃກ້ຊິດກັບຄົນອື່ນ ຄວນໃຫ້ມັນເປັນເລື່ອງສຳຄັນອັນດັບຕົ້ນໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai veikia viską – nuotaiką, kantrybę, gebėjimą užmegzti ryšį. Verta tai laikyti prioritetu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ietekmē visu – noskaņojumu, pacietību, spēku būt tuvumā. Vērts to izvirzīt par prioritāti."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misy fiantraikany amin'ny zava-drehetra izany — ny toe-ponao, ny faharetanao, ny fahafahanao mifandray. Mendrika ho laharam-pahamehana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka pā tēnei ki ngā mea katoa — ki ō kare ā-roto, ki tō manawanui, ki tō kaha ki te hono. Me whakaaro ko tēnei te mea matua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова влијае на сè — расположението, трпението, способноста за блискост. Вреди да го ставиш на прво место."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് എല്ലാറ്റിനെയും ബാധിക്കുന്നു — നിങ്ങളുടെ മൂഡ്, ക്ഷമ, അടുപ്പത്തിനുള്ള കഴിവ്. ഇതിന് മുൻഗണന നൽകുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ бүх юманд нөлөөлж байна — сэтгэл санаа, тэвчээр, ойртох чадварт чинь. Үүнийг нэн тэргүүнд тавих хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "याचा परिणाम सगळ्यावर होत आहे — तुमचा मूड, संयम, नात्यात जवळ येण्याची क्षमता. याला प्राधान्य देणे गरजेचे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menjejaskan segalanya — perasaan, kesabaran dan keupayaan anda untuk mendekat. Elok jadikannya keutamaan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan qed jaffettwa kollox — il-burdata, il-paċenzja, il-kapaċità tiegħek għall-konnessjoni. Ta' min tagħtih prijorità."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒါက အရာအားလုံးကို ထိခိုက်နေတယ် — သင့်စိတ်ခံစားမှု၊ စိတ်ရှည်မှု၊ ချစ်သူနဲ့ နီးစပ်နိုင်စွမ်းအထိပါ။ ဦးစားပေးအဖြစ် ကိုင်တွယ်သင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette påvirker alt – humøret, tålmodigheten og evnen din til nærhet. Verdt å gjøre det til en prioritet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले सबै कुरामा असर गरिरहेको छ — तपाईंको मुड, धैर्य र नजिकिने क्षमता। यसलाई प्राथमिकतामा राख्नु राम्रो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit raakt alles – je stemming, je geduld, je ruimte voor verbinding. Maak er gerust een prioriteit van."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zimenezi zikukhudza chilichonse — mtima wanu, kuleza mtima kwanu, mphamvu zanu zolumikizana ndi ena. Ndi bwino kuziika patsogolo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun waan hunda tuqaa jira — miira kee, obsa kee, dandeettii walitti dhiyaachuu kee. Dursa kennuufiin gaarii dha."
