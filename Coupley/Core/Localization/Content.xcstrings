          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надішли один рядок: «Відповідати не треба — просто думаю про тебе»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک لائن بھیجیں: “جواب کی ضرورت نہیں، بس آپ کی یاد آ رہی ہے۔”"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir qator yozing: «javob shart emas — seni oʻylayapman»."
          }
        },
        "vi" : {
          "stringUnit" : {
