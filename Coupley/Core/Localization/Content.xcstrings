        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Огни Токио. Утро в Киото. Цветущая сакура — с тобой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokyos ljus. Morgnar i Kyoto. Körsbärsblommor med dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงไฟโตเกียว เช้าที่เกียวโต และซากุระกับคุณ"
