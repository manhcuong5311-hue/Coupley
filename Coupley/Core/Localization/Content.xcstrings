        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተወሰነ > አጠቃላይ። «ድንቅ ነዎት» ብቻውን ልብ አይነካም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحدد أفضل من العام. «أنت شخص مذهل» لا تترك أثرًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাধাৰণতকৈ নিৰ্দিষ্ট ভাল। “তুমি অসাধাৰণ” কথাষাৰে বিশেষ প্ৰভাৱ নেপেলায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret > ümumi. “Sən möhtəşəmsən” təsirsiz qalır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Канкрэтнае > агульнае. «Ты супер» не чапляе."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретно > общо. „Невероятен човек си“ звучи кухо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাধারণের চেয়ে নির্দিষ্ট ভালো। “তুমি অসাধারণ” কথাটা তেমন লাগে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretno > općenito. „Ti si nevjerovatna osoba” zvuči prazno."
