          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো উত্তৰেই ভুল নহয় — আপোনাৰ ধৰণ বুজিলে আপোনাৰ সংগীয়ে আপোনাক আপোনাৰ অৱস্থানতে লগ পাব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səhv cavab yoxdur — üslubunu bilmək partnyoruna səni olduğun yerdə qarşılamağa kömək edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няправільных адказаў няма — калі палавінка разумее твой стыль, ёй прасцей знайсці да цябе падыход."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма грешен отговор – когато половинката ти разбира стила ти, може да те срещне там, където си."
