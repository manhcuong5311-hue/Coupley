        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сътрудничеството като романтика. Кухнята се превръща в специално време заедно – а накрая има и вечеря."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথে কাজ করাই রোমান্স। রান্নাঘর নিজেই হয়ে ওঠে একসাথে কাটানো সময় — আর শেষে একটা খাবারও পাও।"
