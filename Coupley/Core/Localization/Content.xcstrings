    "Principled. You have standards and you apply them to pizza. Fruit belongs elsewhere." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginselvas. Jy het standaarde en jy pas dit op pizza toe. Vrugte hoort elders."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የመርህ ሰው። መስፈርት አለዎት፣ በፒዛም ላይ ይተገብሩታል። ፍራፍሬ ቦታው ሌላ ነው።"
