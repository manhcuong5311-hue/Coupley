        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်တွေ့ကျတယ်။ မိသားစု မတူရင် ချဉ်းကပ်ပုံလည်း မတူရဘူး။ အရေးကြီးတာက နှစ်ယောက်စလုံး သဘောထား တူညီနေဖို့ပါ။"
