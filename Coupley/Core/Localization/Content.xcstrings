        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun joku on kiihtynyt, ymmärretyksi tuleminen voittaa ratkaisut."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag may naiinis, mas mahalaga ang maintindihan kaysa bigyan ng solusyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu'un est à cran, se sentir compris compte plus que voir son problème réglé."
