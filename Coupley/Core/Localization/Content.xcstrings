        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preguntas sobre el futuro profundizan la conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulevaan katsovat kysymykset syventävät yhteyttä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinalalalim ng mga tanong tungkol sa hinaharap ang koneksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les questions tournées vers l'avenir renforcent le lien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שאלות שמסתכלות קדימה מעמיקות את החיבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे की बातों पर सवाल जुड़ाव को गहरा करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jövőre irányuló kérdések elmélyítik a kapcsolatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertanyaan tentang masa depan memperdalam kedekatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le domande sul futuro rafforzano il legame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来についての質問は、つながりを深めてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞날을 묻는 질문이 관계를 더 깊게 만들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soalan tentang masa depan mengeratkan hubungan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørsmål om framtiden fordyper båndet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vragen over de toekomst verdiepen jullie band."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pytania o przyszłość pogłębiają więź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntas sobre o que vem pela frente aprofundam a conexão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întrebările despre viitor adâncesc legătura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вопросы о будущем делают связь глубже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framåtblickande frågor fördjupar närheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำถามที่มองไปข้างหน้าช่วยให้ใกล้ชิดกันมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleceğe dönük sorular bağı derinleştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питання про майбутнє поглиблюють зв’язок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những câu hỏi hướng về phía trước giúp gắn kết sâu hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊聊未来的问题，能让彼此更靠近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊聊未來的問題，能讓連結更深。"
          }
        }
      }
    },
    "Freedom and spontaneity — the plan is to have no plan. The best moments are the unplanned ones." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرية وعفوية، والخطة ألّا تكون هناك خطة. أجمل اللحظات هي التي لم يُخطَّط لها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svoboda a spontánnost – plánem je nemít plán. Nejlepší chvíle jsou ty neplánované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frihed og spontanitet – planen er ingen plan. De bedste øjeblikke er dem, der ikke var planlagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freiheit und Spontaneität – der Plan ist, keinen Plan zu haben. Die besten Momente sind die ungeplanten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελευθερία και αυθορμητισμός — το σχέδιο είναι να μην υπάρχει σχέδιο. Οι καλύτερες στιγμές είναι οι απρογραμμάτιστες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libertad y espontaneidad: el plan es no tener plan. Los mejores momentos son los que no se planean."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapautta ja spontaaniutta – suunnitelma on, ettei ole suunnitelmaa. Parhaat hetket ovat niitä suunnittelemattomia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalayaan at pagiging biglaan — ang plano ay walang plano. Ang pinakamagagandang sandali ay ang mga hindi pinlano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberté et spontanéité : le plan, c'est de ne pas en avoir. Les meilleurs moments sont ceux qu'on n'a pas prévus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חופש וספונטניות — התוכנית היא שאין תוכנית. הרגעים הכי טובים הם אלה שלא תוכננו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज़ादी और बेफ़िक्री — प्लान यही है कि कोई प्लान नहीं। सबसे अच्छे पल वही होते हैं जो बिना सोचे आते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szabadság és spontaneitás – az a terv, hogy nincs terv. A legjobb pillanatok a nem tervezettek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebebasan dan spontanitas — rencananya adalah tanpa rencana. Momen terbaik adalah yang nggak direncanakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libertà e spontaneità — il piano è non avere un piano. I momenti migliori sono quelli imprevisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由と気ままさ。予定は「予定を立てないこと」。最高の瞬間は、計画していなかったときに訪れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자유와 즉흥. 계획이 없는 게 계획이에요. 최고의 순간은 늘 계획에 없던 순간이니까요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebebasan dan spontaniti — rancangannya ialah tiada rancangan. Detik terbaik ialah yang tidak dirancang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frihet og spontanitet – planen er å ikke ha noen plan. De beste øyeblikkene er de uplanlagte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijheid en spontaniteit – het plan is geen plan. De mooiste momenten zijn de ongeplande."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolność i spontaniczność – plan jest taki, żeby nie mieć planu. Najlepsze chwile to te niezaplanowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberdade e espontaneidade — o plano é não ter plano. Os melhores momentos são os que ninguém planejou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libertate și spontaneitate — planul e să n-ai niciun plan. Cele mai frumoase momente sunt cele neplanificate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свобода и спонтанность — план в том, чтобы обойтись без плана. Лучшие моменты — незапланированные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frihet och spontanitet – planen är att inte ha någon plan. De bästa stunderna är de oplanerade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อิสระและความเป็นธรรมชาติ แผนคือการไม่มีแผน ช่วงเวลาที่ดีที่สุดคือช่วงที่ไม่ได้วางแผนไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özgürlük ve doğaçlama; plan, plansız olmak. En güzel anlar planlanmayanlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свобода й спонтанність — план полягає в тому, щоб не мати плану. Найкращі моменти — незаплановані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự do và ngẫu hứng — kế hoạch là không có kế hoạch. Những khoảnh khắc đẹp nhất là những điều không định trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由和随性——计划就是没有计划。最美好的时刻总是意料之外的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由又隨性，計畫就是沒有計畫。最棒的時刻，往往都是意料之外的。"
          }
        }
      }
    },
    "Friendly but separate. You can be kind without being entangled. Worth making sure that's mutual." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ودّ مع استقلالية. اللطف ممكن من دون تشابك. من المهم التأكد أن هذا الشعور متبادل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelsky, ale odděleně. Laskavost ti jde i bez zaplétání se do všeho. Ověř si, že to máte nastavené oba stejně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venlig, men på afstand. Du kan være rar uden at blive viklet ind. Sørg for, at det er gensidigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freundlich, aber getrennt. Du kannst nett sein, ohne dich verstricken zu lassen. Stell sicher, dass das auf Gegenseitigkeit beruht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φιλικά αλλά χωριστά. Μπορείς να φέρεσαι με καλοσύνη χωρίς να μπλέκεσαι. Αξίζει να βεβαιωθείς ότι το θέλετε και οι δυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cordialidad, pero por separado. Puedes ser amable sin enredarte. Conviene asegurarse de que sea mutuo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ystävällistä mutta erillistä. Voit olla kiltti sotkeutumatta. Kannattaa varmistaa, että ajatus on yhteinen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabait pero hiwalay. Kaya mong maging mabait nang hindi nadadawit. Siguraduhing pareho kayo ng gusto rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la cordialité, mais chacun de son côté. Tu peux être aimable sans t'empêtrer dans les histoires de famille. Assure-toi que c'est réciproque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ידידות, אבל בנפרד. אפשר להיות נחמדים בלי להסתבך. כדאי לוודא שזה הדדי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्ताना, पर अलग। उलझे बिना भी अच्छा बर्ताव मुमकिन है। बस पक्का कर लें कि दोनों की सोच यही हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barátságos, de különálló. Lehetsz kedves anélkül, hogy belebonyolódnál. Érdemes megbizonyosodni róla, hogy ez kölcsönös."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramah tapi terpisah. Kamu bisa baik tanpa terlalu terlibat. Pastikan pasanganmu juga merasa begitu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cordialità con distanza. Si può essere gentili senza farsi coinvolgere troppo. Assicurati che sia una scelta condivisa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友好的だけど、距離は保つ。深入りしなくても優しくできます。お互いにそう思っているか、確かめておくと安心です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친근하지만 거리는 두는 편이에요. 얽매이지 않고도 친절할 수 있죠. 서로 같은 생각인지 확인해 보면 좋아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesra tetapi berasingan. Anda boleh berbaik tanpa terlalu terikat. Elok pastikan pasangan anda pun rasa begitu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vennlig, men adskilt. Du kan være snill uten å bli viklet inn. Sørg for at dere begge vil det samme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vriendelijk, maar apart. Je kunt aardig zijn zonder verstrikt te raken. Check wel of dat wederzijds is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyjaźnie, ale osobno. Potrafisz okazywać życzliwość bez wikłania się w sprawy rodziny. Warto upewnić się, że to działa w obie strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpatia, mas cada um na sua. Dá para ser gentil sem se enroscar. Vale garantir que isso seja recíproco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prietenie, dar cu distanță. Poți să te porți frumos fără să te implici prea mult. Merită să te asiguri că e reciproc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дружелюбно, но отдельно. Можно проявлять доброту, не переплетая жизни. Стоит убедиться, что это взаимно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänligt men åtskilt. Du kan vara snäll utan att trassla in dig. Se till att det känns likadant för er båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นมิตรแต่แยกกัน คุณใจดีได้โดยไม่ต้องพัวพัน ควรแน่ใจว่าอีกฝ่ายก็คิดแบบเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostça ama ayrı. Karışmadan nazik olabiliyorsun. Bunun karşılıklı olduğundan emin olmaya değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дружньо, але окремо. Можна бути привітними, не втягуючись. Варто переконатися, що це взаємно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thân thiện nhưng tách bạch. Bạn có thể tử tế mà không bị cuốn vào. Nên chắc rằng cả hai cùng nghĩ vậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友好但保持距离。你可以很友善，又不至于纠缠不清。最好确认双方都这么想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友善但保持距離。你可以很親切，又不被牽扯太深。記得確認另一半也這樣想。"
          }
        }
      }
    },
    "Full luxury when possible — it's a treat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فخامة كاملة متى أمكن، إنها مكافأة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luxusně, když to jde – je to odměna"
          }
