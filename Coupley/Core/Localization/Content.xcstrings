        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансовано й реалістично. Без крайнощів — ти любиш поїсти, але й про себе дбаєш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوازن اور حقیقت پسند۔ کوئی انتہا نہیں — کھانے کا لطف بھی ہے اور اپنا خیال بھی۔"
