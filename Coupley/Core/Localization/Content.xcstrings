    "Embodied learning. Getting better at something physical is uniquely satisfying — and often social." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer met jou lyf. Om beter te word in iets fisieks is uniek bevredigend – en dikwels sosiaal."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሰውነት መማር። በአካላዊ ነገር መሻሻል ልዩ እርካታ ይሰጣል — ብዙ ጊዜም ማኅበራዊ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلّم بالجسد. التحسّن في شيء بدني يمنح رضا فريدًا، وغالبًا ما يكون اجتماعيًا أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শৰীৰেৰে শিকা। শাৰীৰিক কিবা এটাত ভাল হৈ উঠাটো অনন্যভাৱে তৃপ্তিদায়ক — আৰু প্ৰায়ে সামাজিকো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bədənlə öyrənmək. Fiziki bir şeydə irəliləmək xüsusi zövq verir — və çox vaxt insanları bir araya gətirir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навучанне праз цела. Расці ў чымсьці фізічным — асаблівае задавальненне, і часта яшчэ і ў кампаніі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учене чрез тялото. Напредъкът в нещо физическо носи уникално удовлетворение – и често е социален."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শরীর দিয়ে শেখা। শারীরিক কিছুতে ভালো হয়ে ওঠার তৃপ্তিটা অন্যরকম — আর প্রায়ই সেটা মানুষের সাথে মেশারও সুযোগ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učenje kroz tijelo. Napredak u nečemu fizičkom donosi posebno zadovoljstvo – a često je i društveno."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendre amb el cos. Millorar en alguna cosa física és especialment satisfactori — i sovint, social."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učení tělem. Zlepšovat se v něčem fyzickém přináší zvláštní uspokojení – a často je to i společenská záležitost."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysgu drwy'r corff. Mae gwella mewn rhywbeth corfforol yn rhoi boddhad unigryw — ac yn aml mae'n gymdeithasol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læring med kroppen. At blive bedre til noget fysisk er helt særligt tilfredsstillende – og ofte socialt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen mit dem Körper. Bei etwas Körperlichem besser zu werden, ist besonders befriedigend – und oft gesellig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθηση μέσα από το σώμα. Το να βελτιώνεσαι σε κάτι σωματικό δίνει μοναδική ικανοποίηση — και συχνά είναι και κοινωνικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender con el cuerpo. Mejorar en algo físico es especialmente satisfactorio — y muchas veces, social."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehaga õppimine. Milleski füüsilises paremaks saamine pakub erilist rahuldust — ja on sageli seltskondlik."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorputzarekin ikastea. Zerbait fisikoan hobetzeak asebetetze berezia ematen du, eta askotan soziala ere bada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادگیری با بدن. بهتر شدن در یک کار بدنی لذتی بی‌نظیر دارد — و اغلب جمعی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehollista oppimista. Fyysisessä kehittymisessä on ainutlaatuista tyydytystä – ja usein se on myös sosiaalista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkatutong ramdam ng katawan. Kakaibang kasiyahan ang gumaling sa isang pisikal na bagay — at madalas, sosyal pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendre par le corps. Progresser dans quelque chose de physique procure une satisfaction unique — et c'est souvent social."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foghlaim tríd an gcorp. Is sásamh ar leith é feabhas a chur ar rud fisiciúil — agus is minic gur rud sóisialta é."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender co corpo. Mellorar en algo físico dá unha satisfacción única, e adoita ser algo social."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શરીરથી શીખવું. કોઈ શારીરિક બાબતમાં આગળ વધવાનો સંતોષ અનોખો છે — અને ઘણી વાર એ લોકો સાથે જોડે પણ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koyo ta jiki. Ƙwarewa a abu na jiki na kawo gamsuwa ta musamman — kuma sau da yawa tare da mutane."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למידה דרך הגוף. להשתפר במשהו פיזי זה סיפוק מיוחד — ולעיתים קרובות גם חברתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीर से सीखना। किसी शारीरिक चीज़ में बेहतर होना अनोखा सुकून देता है — और अक्सर लोगों से जोड़ता भी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učenje kroz tijelo. Napredak u nečemu tjelesnom posebno je ispunjavajući – i često društven."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprann ak kò ou. Vin pi bon nan yon bagay fizik bay yon satisfaksyon espesyal — e souvan li sosyal tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanulás a testeddel. Ha egy mozgásos dologban fejlődsz, az egészen különleges elégedettséget ad – és gyakran közösségi élmény is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սովորել մարմնով։ Ֆիզիկական որևէ բանում ավելի լավը դառնալը յուրահատուկ բավականություն է տալիս, և հաճախ նաև շփում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belajar lewat tubuh. Makin jago dalam hal fisik itu memuaskan dengan cara yang unik — dan sering kali jadi ajang bersosialisasi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmụta site n'ahụ. Ịka mma n'ihe gbasara ahụ na-enye afọ ojuju pụrụ iche — ọ na-abụkarịkwa ihe a na-eme na ndị ọzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lærdómur í gegnum líkamann. Að verða betri í einhverju líkamlegu veitir einstaka ánægju – og er oft félagslegt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imparare con il corpo. Migliorare in qualcosa di fisico dà una soddisfazione unica — e spesso si fa in compagnia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体で覚える学びです。体を使うことが上達する喜びは格別で、人とのつながりも生まれやすいものです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinau liwat awak. Dadi luwih pinter ing bab fisik iku marem banget — lan asring karo srawung."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სხეულით სწავლა. ფიზიკურ საქმეში წინსვლა განსაკუთრებულ სიამოვნებას გაძლევს — და ხშირად ხალხთანაც გაახლოებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дене арқылы үйрену. Бір физикалық іске шеберлену ерекше рахат сыйлайды, әрі көбіне адамдармен жақындастырады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការរៀនតាមរយៈរាងកាយ។ ការពូកែជាងមុនលើអ្វីដែលប្រើកម្លាំងកាយ ផ្ដល់ការពេញចិត្តពិសេស — ហើយជារឿយៗក៏ជាការជួបជុំសង្គមផងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೇಹದಿಂದ ಕಲಿಯುವುದು. ದೈಹಿಕವಾದ ಯಾವುದರಲ್ಲಾದರೂ ಉತ್ತಮರಾಗುವುದು ವಿಶಿಷ್ಟ ತೃಪ್ತಿ ಕೊಡುತ್ತದೆ — ಮತ್ತು ಹಲವು ಬಾರಿ ಜನರ ಜೊತೆ ಬೆರೆಯುವ ಅವಕಾಶವೂ ಹೌದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸으로 배우는 즐거움이에요. 몸 쓰는 실력이 느는 건 특별한 만족감을 주고, 사람들과 함께하게 될 때도 많아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fêrbûna bi laş. Baştirbûna di tiştekî fîzîkî de bi awayekî taybet dilê mirov xweş dike — û gelek caran civakî ye."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дене аркылуу үйрөнүү. Физикалык бир нерседе өсүү өзгөчө ырахат берет — жана көбүнчө адамдар менен бирге болот."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léiere mam Kierper. A kierperleche Saache besser ze ginn, ass besonnesch erfëllend — an dacks och sozial."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮຽນຮູ້ຜ່ານຮ່າງກາຍ ການເກັ່ງຂຶ້ນໃນເລື່ອງທາງກາຍໃຫ້ຄວາມພໍໃຈແບບພິເສດ — ແລະ ມັກໄດ້ເຈິຜູ້ຄົນນຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokymasis kūnu. Tobulėti fiziškai – ypatingai malonu, o dažnai ir smagu kartu su kitais."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mācīšanās ar ķermeni. Pilnveidoties kādā fiziskā nodarbē ir īpaši gandarījoši – un bieži vien arī sabiedriski."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fianarana amin'ny vatana. Mahafa-po tokoa ny fihatsarana amin'ny zavatra ara-batana — ary matetika sosialy koa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ako mā te tinana. He tino whakaea te pai ake i tētahi mea ā-tinana — ā, he mea pāpori i te nuinga o te wā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учење со телото. Напредокот во нешто физичко носи посебно задоволство — а често е и дружење."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ശരീരം കൊണ്ടുള്ള പഠനം. ശാരീരികമായ ഒന്നിൽ മെച്ചപ്പെടുന്നത് പ്രത്യേക സംതൃപ്തി നൽകുന്നു — പലപ്പോഴും കൂട്ടായും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Биеэрээ суралцах. Биеийн ямар нэг зүйлд сайжрах нь онцгой сэтгэл ханамж өгдөг — ихэвчлэн нийгэмч ч байдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीराने शिकणे. एखाद्या शारीरिक गोष्टीत प्रगती करण्याचे समाधान वेगळेच असते — आणि बऱ्याचदा ते इतरांसोबत घडते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belajar melalui tubuh. Menjadi lebih baik dalam sesuatu yang fizikal sangat memuaskan — dan selalunya melibatkan orang lain juga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagħlim bil-ġisem. Li titjieb f'xi ħaġa fiżika jagħti sodisfazzjon uniku — u spiss huwa soċjali wkoll."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခန္ဓာကိုယ်နဲ့ သင်ယူခြင်း။ ကိုယ်ပိုင်းဆိုင်ရာ တစ်ခုခုမှာ ပိုတော်လာတာက ထူးခြားစွာ ကျေနပ်စရာကောင်းတယ် — များသောအားဖြင့် လူတွေနဲ့ အတူလည်း ဖြစ်တတ်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læring med kroppen. Å bli bedre på noe fysisk gir en helt egen tilfredsstillelse – og er ofte sosialt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीरले सिक्ने। कुनै शारीरिक कुरामा राम्रो हुँदै जानुको सन्तुष्टि बेग्लै हुन्छ — र प्रायः साथीहरूसँगै।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leren met je lijf. Beter worden in iets fysieks geeft een unieke voldoening – en is vaak ook sociaal."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuphunzira kudzera m'thupi. Kukhala aluso pa chinthu cha thupi kumakhutiritsa mwapadera — ndipo nthawi zambiri kumakhala kocheza ndi ena."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qaamaan barachuu. Waan qaamaatiin hojjetamu keessatti fooyya'uun gammachuu addaa kenna — yeroo baay'ee hawaasummaas ni qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦେହରେ ଶିଖିବା। ଶାରୀରିକ କୌଣସି କଥାରେ ଭଲ ହେବା ଅନନ୍ୟ ସନ୍ତୋଷ ଦିଏ — ଏବଂ ପ୍ରାୟତଃ ଲୋକଙ୍କ ସହ ମିଶିବାର ସୁଯୋଗ ବି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਰੀਰ ਨਾਲ ਸਿੱਖਣਾ। ਕਿਸੇ ਸਰੀਰਕ ਚੀਜ਼ ਵਿੱਚ ਬਿਹਤਰ ਹੋਣਾ ਖ਼ਾਸ ਤਸੱਲੀ ਦਿੰਦਾ ਹੈ — ਅਤੇ ਅਕਸਰ ਨਵੇਂ ਲੋਕਾਂ ਨਾਲ ਵੀ ਜੋੜਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauka ciałem. Postępy w czymś fizycznym dają wyjątkową satysfakcję – i często łączą ludzi."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د بدن له لارې زده کړه. په یو جسمي کار کې ښه کېدل ځانګړی خوند لري — او اکثره ټولنیز هم وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender com o corpo. Evoluir em algo físico é especialmente gratificante — e muitas vezes social."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender com o corpo. Melhorar em algo físico dá uma satisfação única — e muitas vezes é social."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învățare prin corp. Să progresezi la ceva fizic e o satisfacție aparte — și adesea una socială."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обучение через тело. Прогресс в чём-то физическом приносит особое удовольствие — и часто новые знакомства."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwiga ukoresheje umubiri. Kugenda urushaho kumenya ikintu cy'umubiri biranezeza by'umwihariko — kandi akenshi bihuza abantu."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ශරීරයෙන් ඉගෙනීම. ශාරීරික දෙයකින් දියුණු වීම අපූරු තෘප්තියක් — බොහෝ විට සමාජශීලීත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učenie sa telom. Zlepšovať sa v niečom fyzickom je nesmierne uspokojujúce – a často aj spoločenské."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učenje s telesom. Napredek pri nečem telesnem prinaša posebno zadovoljstvo – in je pogosto tudi družaben."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudzidza nemuviri. Kuvandudza pane chimwe chinhu chemuviri kunogutsa zvakasiyana — uye kazhinji kunoitwa nevamwe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxbarasho jidheed. Inaad wax jidh ah ku horumarto waxay leedahay qanacsanaan gaar ah — inta badanna waa wax bulsho."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mësim me trup. Të përmirësohesh në diçka fizike jep kënaqësi të veçantë – dhe shpesh të bashkon me të tjerët."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учење кроз тело. Напредак у нечем физичком доноси посебно задовољство — и често је друштвен."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diajar ku awak. Janten langkung mahér dina hal fisik téh nyugemakeun pisan, sareng sering dilakukeun babarengan sareng batur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lärande genom kroppen. Att bli bättre på något fysiskt ger en alldeles speciell tillfredsställelse – och är ofta socialt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujifunza kwa mwili. Kuboresha jambo la kimwili kunaridhisha kwa namna ya pekee — na mara nyingi huwakutanisha watu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உடலால் கற்பது. உடல் சார்ந்த ஒன்றில் மேம்படுவது தனித்துவமான திருப்தி தருகிறது — பெரும்பாலும் நண்பர்களையும் சேர்க்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "శరీరంతో నేర్చుకోవడం. శారీరకమైన దేనిలోనైనా మెరుగవడం ప్రత్యేకమైన సంతృప్తినిస్తుంది — తరచుగా అది నలుగురితో కలిసి చేసేదే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омӯзиш бо бадан. Дар чизи ҷисмонӣ беҳтар шудан қаноатмандии махсус медиҳад — ва аксар вақт бо одамон мегузарад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียนรู้ผ่านร่างกาย การเก่งขึ้นในเรื่องทางกายให้ความพอใจที่ไม่เหมือนใคร และมักได้เพื่อนใหม่ด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብኣካል ዝመሃር። ኣብ ኣካላዊ ነገር ምምሕያሽ ፍሉይ ዕግበት ይህብ — መብዛሕትኡ ግዜ ድማ ምስ ሰባት እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beden arkaly öwrenmek. Fiziki bir zatda ussatlaşmak aýratyn kanagatlandyryjy — we köplenç adamlar bilen bile."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedenle öğrenmek. Fiziksel bir şeyde gelişmek eşsiz bir tatmin verir ve çoğu zaman sosyaldir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчання через тіло. Прогрес у чомусь фізичному дає особливе задоволення — і часто нові знайомства."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جسم سے سیکھنا۔ کسی جسمانی کام میں بہتر ہونا ایک انوکھا اطمینان دیتا ہے، اور اکثر لوگوں سے ملنے کا موقع بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tana orqali oʻrganish. Jismoniy mashgʻulotda yaxshilanish oʻzgacha mamnuniyat beradi — va koʻpincha odamlarni yaqinlashtiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Học bằng cơ thể. Tiến bộ ở một điều gì đó thể chất mang lại sự thỏa mãn rất riêng — và thường gắn với bạn bè."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukufunda ngomzimba. Ukuba ngcono kwinto yomzimba kwanelisa ngendlela eyodwa — kwaye kudla ngokwenziwa nabanye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ̀kọ́ tí ara ń kọ́. Mímọ nǹkan ti ara dáadáa ń tẹ́ni lọ́rùn lọ́nà àrà — ó sì sábà máa ń mú ìbákẹ́gbẹ́ wá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用身體去學習。在體能上進步帶來的滿足感獨一無二，而且往往能認識新朋友。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用身体去学习。在身体技能上进步，有种独特的满足感，而且常常能结识朋友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用身體學習。在體能上進步有種獨特的滿足感，而且常常是和別人一起進行的。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukufunda ngomzimba. Ukuba ngcono entweni yomzimba kwanelisa ngendlela ehlukile — futhi kuvame ukuhlanganisa abantu."
          }
        }
      }
    },
