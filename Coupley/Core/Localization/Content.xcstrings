        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़ की रस्में आपको सुकून देती हैं। साथ मिलकर कुछ जाना-पहचाना और दिल को भाने वाला करना अपने आप में एक इलाज है।"
