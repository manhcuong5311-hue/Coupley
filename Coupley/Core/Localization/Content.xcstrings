        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצד השני נשאר נוכח בשגרה שלך. טקסים ואסוציאציות משותפים מלאי משמעות בשבילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप उन्हें अपनी रोज़ की ज़िंदगी में शामिल रखते हैं। साझा रस्में और जुड़ी हुई चीज़ें आपके लिए मायने रखती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hétköznapjaidban is jelen tartod a párodat. A közös rituálék és apró emlékeztetők sokat jelentenek neked."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu membuatnya tetap hadir dalam keseharianmu. Ritual dan hal-hal yang terkait dengannya berarti bagimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il tuo partner presente nella vita di tutti i giorni. Rituali e associazioni condivise hanno un grande significato per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々の暮らしの中に、いつもパートナーの存在を感じていたいタイプです。ふたりの習慣やゆかりのあるものに、大きな意味を感じています。"
