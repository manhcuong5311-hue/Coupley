            "value" : "Mijn partner laten beslissen – ik vind alles goed"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wokondedwa wanga atsogolere — ine ndine womasuka"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dursa jaalallee kootiif nan dhiisa — ani salphaa dha"
