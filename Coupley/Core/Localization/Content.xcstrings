    "Travel compatibility can make or break a holiday — this is worth knowing early." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisverenigbaarheid kan ’n vakansie maak of breek – goed om dit vroeg te weet."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በጉዞ መጣጣም የዕረፍት ጊዜን ሊያሳምር ወይም ሊያበላሽ ይችላል — ይህን ቀደም ብሎ ማወቅ ይጠቅማል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوافق في السفر قد يصنع العطلة أو يفسدها، ومن المفيد معرفة ذلك مبكرًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্ৰমণৰ ধৰণ মিলিলে বা নিমিলিলে এটা বন্ধ সফল বা বিফল হ'ব পাৰে — এইটো আগতীয়াকৈ জনা ভাল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səyahətdə uyğunluq tətili ya gözəl edir, ya da korlayır — bunu erkən bilmək yaxşıdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумяшчальнасць у падарожжах можа зрабіць адпачынак — ці сапсаваць яго. Гэта варта ведаць загадзя."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съвместимостта при пътуване може да направи или да провали една ваканция – добре е да се знае отрано."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণে মিল থাকা না থাকা একটা ছুটি গড়ে দিতে বা ভেস্তে দিতে পারে — আগেভাগে জানা ভালো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usklađenost na putovanju može napraviti ili upropastiti odmor – vrijedi to znati rano."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixar viatjant pot fer o desfer unes vacances — val la pena saber-ho aviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestovatelská kompatibilita může dovolenou zachránit, nebo zničit – vyplatí se o ní vědět včas."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gall cyd-fynd wrth deithio wneud neu dorri gwyliau — mae hyn yn werth ei wybod yn gynnar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om I passer sammen som rejsepartnere, kan være afgørende for ferien – det er værd at vide tidligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob ihr beim Reisen zusammenpasst, kann einen Urlaub retten oder ruinieren – das solltet ihr früh wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αν ταιριάζετε στα ταξίδια μπορεί να κάνει ή να χαλάσει τις διακοπές — αξίζει να το ξέρετε νωρίς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser compatibles al viajar puede salvar o arruinar unas vacaciones; vale la pena saberlo pronto."
