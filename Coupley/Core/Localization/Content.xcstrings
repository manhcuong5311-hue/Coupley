        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Òmìnira ń mú yín ní ìlera. Ẹ ń mú ẹni pípé wá sínú ìbáṣepọ̀ dípò kí ẹ yọ́ pọ̀ pátápátá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
