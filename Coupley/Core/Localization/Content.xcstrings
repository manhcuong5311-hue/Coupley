        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wax-samayn. Malaha waxaad gudaha ku haysaa fikrado aadan weli helin hab aad ku muujiso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të krijosh gjëra. Ndoshta ke ide brenda vetes që ende nuk ke gjetur si t’i shprehësh."
