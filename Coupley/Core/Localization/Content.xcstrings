          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je někdo rozrušený, porozumění vyhrává nad řešením."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan fydd rhywun yn gynhyrfus, mae teimlo'n ddealledig yn well na chael ateb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når nogen er ophidset, er det bedre at blive forstået end at få en løsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer aufgewühlt ist, will Verständnis – keine Lösung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν κάποιος είναι ταραγμένος, το να τον καταλάβουν μετράει περισσότερο από το να του λύσουν το πρόβλημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien está alterado, la comprensión vale más que una solución."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui keegi on ärritunud, on mõistmine parem kui lahendamine."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norbait asaldatuta dagoenean, ulertua izatea konpondua izatea baino hobea da."
