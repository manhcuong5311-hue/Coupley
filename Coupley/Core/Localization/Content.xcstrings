        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वस्थ संलग्नता। तपाईं उपस्थित हुनुहुन्छ, ख्याल गर्नुहुन्छ, तर जोडीको आफ्नै ठाउँ पनि जोगाउनुहुन्छ। यो दिगो छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezonde betrokkenheid. Je bent er, je geeft om ze, maar je beschermt ook de ruimte van jullie als stel. Dat houd je lang vol."
