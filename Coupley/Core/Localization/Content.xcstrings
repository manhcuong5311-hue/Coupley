        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستطيعون المشاركة الاجتماعية، لكن لها ثمنًا. وقت التعافي بعد المناسبات حاجة حقيقية لديكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি সামাজিক কামবোৰ কৰিব পাৰে, কিন্তু তাৰ বাবে মূল্য দিব লগা হয়। সামাজিক অনুষ্ঠানৰ পিছত জিৰণি লোৱাৰ সময় আপোনাৰ বাবে সঁচাকৈয়ে দৰকাৰী।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosial işlərin öhdəsindən gəlirsən, amma bunun bədəlini ödəyirsən. Tədbirlərdən sonra bərpa vaxtı sənin üçün realdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тусоўкі табе пад сілу, але яны каштуюць энергіі. Пасля мерапрыемстваў табе сапраўды патрэбен час на аднаўленне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можеш да се справиш със социалното, но то ти струва. Времето за възстановяване след събития наистина ти е нужно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সামাজিক কাজগুলো তুমি পারো, কিন্তু তার একটা দাম দিতে হয়। আড্ডা-অনুষ্ঠানের পর তোমার সত্যিই সামলে ওঠার সময় লাগে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možeš se družiti, ali to te košta. Vrijeme za oporavak nakon druženja kod tebe je stvarna potreba."
