        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צמיחה בפעולה. זיהית דברים שאין לך רצון להעביר הלאה — והעבודה כבר בעיצומה. זה משמעותי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव की राह पर। आपने पहचाना है कि क्या आगे नहीं ले जाना — और उस पर काम जारी है। यह बड़ी बात है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast na djelu. Prepoznaješ stvari koje ne želiš prenijeti dalje – i radiš na tome. To je značajno."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwasans an aksyon. Ou idantifye bagay ou pa vle transmèt — e w ap fè travay la. Sa gen gwo valè."
