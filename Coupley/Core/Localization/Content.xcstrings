        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ස්වභාවයෙන්ම සමබරයි. බොහෝ සහකරුවන් එක්ක මුදල් ගැන කතාබහ ඔබ බොහෝ විට පහසුවෙන් කරයි."
