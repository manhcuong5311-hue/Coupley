        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατάς το ταίρι σου παρόν στην καθημερινότητά σου. Οι κοινές συνήθειες και οι συνδέσεις έχουν νόημα για σένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes a tu pareja presente en tu día a día. Los rituales y las asociaciones compartidas tienen mucho significado para ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidät toisen läsnä arjessasi. Yhteiset rituaalit ja mielleyhtymät ovat sinulle merkityksellisiä."
