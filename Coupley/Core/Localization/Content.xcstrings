    "Talk is cheap. You believe in proof. This is fair — consistent change is the only real apology." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praat is maklik. Jy glo in bewys. Dis regverdig – volgehoue verandering is die enigste regte verskoning."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወሬ ርካሽ ነው። በማረጋገጫ ያምናሉ። ይህ ፍትሐዊ ነው — ወጥ የሆነ ለውጥ ብቸኛው እውነተኛ ይቅርታ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلام سهل، وأنتم تؤمنون بالدليل. وهذا عادل، فالتغيير المستمر هو الاعتذار الحقيقي الوحيد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখৰ কথাৰ মূল্য কম। আপুনি প্ৰমাণত বিশ্বাস কৰে। এইটো ন্যায্য — ধাৰাবাহিক পৰিৱৰ্তনেই একমাত্ৰ সঁচা ক্ষমা প্ৰাৰ্থনা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söz ucuzdur. Sən sübuta inanırsan. Bu, ədalətlidir — davamlı dəyişiklik yeganə əsl üzrxahlıqdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Словы нічога не каштуюць. Ты верыш доказам. І гэта справядліва — сталыя змены і ёсць сапраўднае прабачэнне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Думите са евтини. Вярваш в доказателствата. Справедливо – трайната промяна е единственото истинско извинение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখে বলা সহজ। তুমি প্রমাণে বিশ্বাস করো। এটা ন্যায্যই — ধারাবাহিক পরিবর্তনই একমাত্র সত্যিকারের ক্ষমা চাওয়া।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priča je jeftina. Vjeruješ dokazima. I to je pošteno – dosljedna promjena je jedino pravo izvinjenje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paraules se les endú el vent. Tu creus en les proves. I és just — un canvi constant és l'única disculpa real."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slova nic nestojí. Věříš důkazům. A právem – jediná skutečná omluva je trvalá změna."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae siarad yn rhad. Rwyt ti'n credu mewn prawf. Mae hyn yn deg — newid cyson yw'r unig ymddiheuriad go iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snak er billigt. Du tror på beviser. Og det er fair – vedvarende forandring er den eneste ægte undskyldning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reden ist billig. Du glaubst an Beweise. Das ist fair – beständige Veränderung ist die einzige echte Entschuldigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα λόγια είναι φτηνά. Εσύ πιστεύεις στις αποδείξεις. Και δικαίως — η σταθερή αλλαγή είναι η μόνη αληθινή συγγνώμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras se las lleva el viento. Tú crees en las pruebas, y es justo: el cambio constante es la única disculpa real."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rääkida on lihtne. Sa usud tõenditesse. Ja õigusega — järjekindel muutus on ainus päris vabandus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitzak merkeak dira. Frogetan sinesten duzu. Bidezkoa da — aldaketa iraunkorra da benetako barkamen bakarra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف زدن آسان است. تو به عمل باور داری. منصفانه هم هست — تغییر پیوسته تنها عذرخواهی واقعی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhe on halpaa. Uskot todisteisiin. Se on reilua – johdonmukainen muutos on ainoa todellinen anteeksipyyntö."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madaling magsalita. Naniniwala ka sa patunay. Patas iyan — ang tuloy-tuloy na pagbabago ang tanging tunay na sorry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles ne coûtent rien. Toi, tu crois aux preuves. Et c'est juste : un changement constant, c'est la seule vraie excuse."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is saor í an chaint. Creideann tú i gcruthúnas. Tá sé sin cothrom — is é athrú seasta an t-aon fhíorleithscéal."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falar é doado. Ti cres nas probas. E é xusto: un cambio constante é a única desculpa de verdade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાતો કરવી સહેલી છે. તમે સાબિતીમાં માનો છો. આ વાજબી છે — સતત બદલાવ જ સાચી માફી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magana ba ta da tsada. Kuna yarda da hujja. Wannan adalci ne — sauyi mai ɗorewa shi ne kawai ainihin neman gafara."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דיבורים לחוד ומעשים לחוד. אצלך מאמינים בהוכחות. וזה הוגן — שינוי עקבי הוא ההתנצלות האמיתית היחידה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बातें करना आसान है। आपको सबूत पर भरोसा है। और यह ठीक भी है — लगातार बदलाव ही असली माफ़ी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riječi su jeftine. Vjeruješ dokazima. I to je fer – dosljedna promjena jedina je prava isprika."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pawòl pa koute anyen. Ou kwè nan prèv. Sa jis — chanjman ki dire se sèl vrè eskiz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szavak olcsók. Te a bizonyítékban hiszel. Ez jogos – a következetes változás az egyetlen igazi bocsánatkérés."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խոսելը հեշտ է։ Դու հավատում ես ապացույցին։ Եվ դա արդար է — հետևողական փոփոխությունն է միակ իրական ներողությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngomong itu gampang. Kamu percaya pada bukti. Itu adil — perubahan yang konsisten adalah satu-satunya permintaan maaf yang nyata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okwu ọnụ adịghị arọ. I kwenyere n'akaebe. Nke a ziri ezi — mgbanwe na-adịgide adịgide bụ naanị ezi ịrịọ mgbaghara."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orð eru ódýr. Þú trúir á sannanir. Það er sanngjarnt – stöðug breyting er eina raunverulega afsökunarbeiðnin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole costano poco. Tu credi nelle prove. Ed è giusto — un cambiamento costante è l’unico vero modo di chiedere scusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口だけなら何とでも言える。目に見える証を信じるタイプです。それはもっともなこと。変わり続けることこそが、本当の謝罪です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omongan iku gampang. Panjenengan percaya bukti. Kuwi adil — owah-owahan sing ajeg iku siji-sijine njaluk ngapura sing temenan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიტყვა იაფია. შენ დასტურის გჯერა. ეს სამართლიანია — მუდმივი ცვლილებაა ერთადერთი ნამდვილი ბოდიში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөз арзан. Сен дәлелге сенесің. Бұл әділ — тұрақты өзгеріс қана нағыз кешірім."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "និយាយគឺងាយ។ អ្នកជឿលើភស្តុតាង។ នេះសមហេតុផល — ការផ្លាស់ប្ដូរជាប់លាប់ គឺជាការសុំទោសពិតតែមួយគត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತು ಸುಲಭ. ನೀವು ಪುರಾವೆಯನ್ನು ನಂಬುತ್ತೀರಿ. ಇದು ನ್ಯಾಯವೇ — ಸ್ಥಿರವಾದ ಬದಲಾವಣೆಯೇ ನಿಜವಾದ ಕ್ಷಮೆಯಾಚನೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말은 쉽죠. 증거를 믿는 타입이에요. 충분히 공정한 기준이에요. 꾸준히 달라지는 것만이 진짜 사과니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotin hêsan e. Tu bi delîlan bawer dikî. Ev adil e — guherîna domdar tenê lêborîna rastîn e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөз арзан. Сен далилге ишенесиң. Бул адилет — туруктуу өзгөрүү гана чыныгы кечирим."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwätze kascht näischt. Du gleefs u Beweiser. Dat ass fair — wann sech eppes duerch an duerch ännert, ass dat déi eenzeg richteg Entschëllegung."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເວົ້າງ່າຍ ເຮັດຍາກ ເຈົ້າເຊື່ອໃນຫຼັກຖານ ເຊິ່ງກໍຍຸດຕິທຳ — ການປ່ຽນແປງຢ່າງສະໝ່ຳສະເໝີຄືຄຳຂໍໂທດທີ່ແທ້ຈິງທີ່ສຸດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žodžiai pigūs. Tu tiki įrodymais. Ir tai teisinga – nuoseklus pokytis yra vienintelis tikras atsiprašymas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runāt var daudz. Tu tici pierādījumiem. Tas ir godīgi – noturīgas pārmaiņas ir vienīgā īstā atvainošanās."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mora ny miteny. Porofo no inoanao. Ara-drariny izany — ny fiovana maharitra no hany fialan-tsiny tena izy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He māmā noa te kōrero. Ka whakapono koe ki te tohu. He tika tēnā — ko te panoni pūmau anake te whakapāha pono."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зборовите се евтини. Ти веруваш во докази. И тоа е фер — постојаната промена е единственото вистинско извинување."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വെറും വാക്കുകൾക്ക് വിലയില്ല. നിങ്ങൾ തെളിവിലാണ് വിശ്വസിക്കുന്നത്. അത് ന്യായമാണ് — സ്ഥിരമായ മാറ്റമാണ് യഥാർഥ ക്ഷമാപണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үг хямд. Чи баталгаанд итгэдэг. Энэ шударга — тогтвортой өөрчлөлт л жинхэнэ уучлалт."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलणे सोपे असते. तुमचा पुराव्यावर विश्वास आहे. आणि ते योग्यच — सातत्याने झालेला बदल हीच खरी माफी."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cakap memang mudah. Anda percaya pada bukti. Itu adil — perubahan yang konsisten ialah satu-satunya permohonan maaf yang sebenar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kliem ma jiswa xejn. Int temmen fil-provi. U dan ġust — bidla konsistenti hija l-unika apoloġija vera."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားက ပြောရလွယ်တယ်။ သင် သက်သေကို ယုံတယ်။ ဒါ မျှတပါတယ် — တသမတ်တည်း ပြောင်းလဲမှုကသာ တကယ့် တောင်းပန်မှုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prat er billig. Du tror på bevis. Det er rimelig – varig endring er den eneste ekte unnskyldningen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भन्न त सजिलो छ। तपाईं प्रमाणमा विश्वास गर्नुहुन्छ। यो जायज हो — निरन्तर परिवर्तन नै एकमात्र साँचो माफी हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praatjes vullen geen gaatjes. Jij gelooft in bewijs. Terecht – blijvende verandering is het enige echte excuus."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulankhula nkosavuta. Mumakhulupirira umboni. Nzoona — kusintha kosalekeza ndiko kupepesa kokha kwenikweni."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbiin salphaa dha. Ragaa ni amanta. Kun haqa — jijjiiramni itti fufaa dhiifama dhugaa qofa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଥା କହିବା ସହଜ। ଆପଣ ପ୍ରମାଣରେ ବିଶ୍ୱାସ କରନ୍ତି। ଏହା ଠିକ୍ — ନିରନ୍ତର ପରିବର୍ତ୍ତନ ହିଁ ଏକମାତ୍ର ସଚ୍ଚା କ୍ଷମାପ୍ରାର୍ଥନା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੱਲਾਂ ਕਰਨੀਆਂ ਸੌਖੀਆਂ ਹਨ। ਤੁਸੀਂ ਸਬੂਤ ਉੱਤੇ ਭਰੋਸਾ ਕਰਦੇ ਹੋ। ਇਹ ਜਾਇਜ਼ ਹੈ — ਲਗਾਤਾਰ ਬਦਲਾਅ ਹੀ ਅਸਲ ਮਾਫ਼ੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowa nic nie kosztują. Wierzysz w dowody. To uczciwe – konsekwentna zmiana to jedyne prawdziwe przeprosiny."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خبرې اسانه دي. تاسو په ثبوت باور لرئ. دا انصاف دی — دوامداره بدلون یوازینۍ رښتینې بښنه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falar é fácil. Você acredita em provas. E é justo — mudança consistente é o único pedido de desculpas de verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palavras leva-as o vento. Acreditas em provas. É justo — uma mudança consistente é o único pedido de desculpas verdadeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbele sunt ieftine. Tu crezi în dovezi. Și e corect — schimbarea constantă e singura scuză adevărată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемены в поведении — покажи"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amagambo ntagura. Wizera ibimenyetso. Birumvikana — impinduka zihoraho ni zo mbabazi nyazo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කතාව ලේසියි. ඔබ විශ්වාස කරන්නේ සාක්ෂිවලට. ඒක සාධාරණයි — නොකඩවා වෙනස් වීම තමයි එකම ඇත්ත සමාව ඉල්ලීම."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slová nič nestoja. Veríš dôkazom. A je to fér – jediné skutočné ospravedlnenie je trvalá zmena."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besede so poceni. Verjameš dokazom. To je pošteno – dosledna sprememba je edino pravo opravičilo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazwi akareruka. Iwe unotenda muuchapupu. Izvi zvakanaka — shanduko inoramba iripo ndiyo chete ruregerero chaihwo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadalku waa jaban yahay. Waxaad rumaysan tahay caddayn. Tani waa caddaalad — isbeddel joogto ah ayaa ah raalli-gelinta dhabta ah ee keliya."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjalët s’kushtojnë asgjë. Ti beson te provat. Dhe ke të drejtë – ndryshimi i qëndrueshëm është e vetmja falje e vërtetë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Јефтино је причати. Ти верујеш доказима. И то је фер — доследна промена је једино право извињење."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omongan mah gampang. Anjeun percaya kana bukti. Ieu adil — robihan anu konsisten téh hiji-hijina hapunten anu sajati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prat är billigt. Du tror på bevis. Och det är rimligt – varaktig förändring är den enda riktiga ursäkten."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maneno ni rahisi. Unaamini ushahidi. Hiyo ni haki — mabadiliko ya kudumu ndiyo msamaha wa kweli pekee."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பேச்சு எளிது. நீங்கள் சான்றை நம்புகிறீர்கள். இது நியாயமானதுதான் — தொடர்ச்சியான மாற்றமே உண்மையான மன்னிப்பு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మాటలు చెప్పడం సులభం. మీరు రుజువును నమ్ముతారు. ఇది న్యాయమే — స్థిరమైన మార్పే అసలైన క్షమాపణ."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гап арзон аст. Ту ба далел бовар мекунӣ. Ин одилона аст — тағйири пайваста ягона узри ҳақиқист."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำพูดใครก็พูดได้ คุณเชื่อในหลักฐาน ซึ่งก็สมเหตุสมผล การเปลี่ยนแปลงอย่างสม่ำเสมอคือคำขอโทษที่แท้จริงเพียงหนึ่งเดียว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዘረባ ቀሊል እዩ። ብመርትዖ ትኣምኑ። እዚ ቅኑዕ እዩ — ቀጻሊ ለውጢ እዩ እቲ ሓቀኛ ይቕሬታ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söz arzan. Sen subutnama ynanýarsyň. Bu adalatly — yzygiderli üýtgeşme ýeke-täk hakyky ötünç."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laf kolay. Sen kanıta inanıyorsun. Bu da haksız değil; tutarlı değişim tek gerçek özürdür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слова нічого не коштують. Ти віриш доказам. І це чесно — послідовні зміни і є єдиним справжнім вибаченням."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باتیں سستی ہیں۔ آپ کے لیے ثبوت اہم ہے۔ یہ بجا ہے — مستقل تبدیلی ہی اصل معافی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gap — arzon. Siz isbotga ishonasiz. Bu adolatli — barqaror oʻzgarish yagona haqiqiy uzr."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói thì dễ. Bạn tin vào bằng chứng. Điều đó công bằng — thay đổi bền bỉ mới là lời xin lỗi thật sự."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazwi alula. Ukholelwa kubungqina. Oku kufanelekile — utshintsho oluqhubekayo kuphela kokuxolisa kokwenyani."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ̀rọ̀ ẹnu kò tó. Ẹ̀rí ni ẹ gbà gbọ́. Èyí tọ́ — ìyípadà tí kò dáwọ́ dúró nìkan ni àforíjìn tòótọ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說就容易。你相信實際證明，這很公平，持續的改變才是真正的道歉。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光说没用，你相信行动。这很公平——持续的改变才是真正的道歉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說的比做的容易。你相信實際證明，這很公平，持續的改變才是真正的道歉。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukhuluma kulula. Wena ukholelwa ebufakazini. Lokhu kunengqondo — ushintsho oluqhubekayo ukuphela kokuxolisa kwangempela."
          }
        }
      }
