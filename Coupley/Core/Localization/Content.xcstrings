        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orekatua. Harrotasun profesionala duzu, horretan zure burua galdu gabe. Ziur asko erraza da zurekin harremanean egotea arlo honetan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متعادل. غرور حرفه‌ای داری بی‌آنکه خودت را در آن گم کنی. احتمالاً در این زمینه بودن در رابطه با تو آسان است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasapainoista. Olet ylpeä työstäsi kadottamatta itseäsi siihen. Kanssasi on luultavasti helppo olla suhteessa tämän asian osalta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse. May pride ka sa propesyon mo nang hindi nawawala ang sarili mo. Malamang madali kang pakisamahan pagdating dito."
          }
