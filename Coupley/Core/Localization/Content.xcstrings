        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مبدئيون. لديكم معايير وتطبقونها حتى على البيتزا. للفاكهة مكان آخر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নীতিনিষ্ঠ। আপোনাৰ মাপকাঠি আছে আৰু আপুনি সেয়া পিজ্জাতো প্ৰয়োগ কৰে। ফলৰ ঠাই আন ক'ৰবাত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prinsipialsan. Standartların var və onları pizzaya da tətbiq edirsən. Meyvənin yeri başqadır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прынцыпова. У цябе ёсць стандарты, і ты прымяняеш іх нават да піцы. Садавіне месца не тут."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принципност. Имаш стандарти и ги прилагаш и към пицата. Плодовете са за другаде."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নীতিবান। তোমার একটা মানদণ্ড আছে, আর তুমি সেটা পিৎজাতেও খাটাও। ফলের জায়গা অন্য কোথাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principijelno. Imaš standarde i primjenjuješ ih i na picu. Voću je mjesto negdje drugdje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens principis. Tens criteris i els apliques a la pizza. La fruita va en un altre lloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zásadové. Máš své standardy a uplatňuješ je i na pizzu. Ovoce patří jinam."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egwyddorol. Mae gen ti safonau, ac rwyt ti'n eu rhoi ar waith ar bitsa. Mae ffrwythau'n perthyn yn rhywle arall."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principfast. Du har standarder, og de gælder også pizza. Frugt hører til et andet sted."
