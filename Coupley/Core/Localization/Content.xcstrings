        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recompensa a una vida de trabajo es ver el mundo. Seguramente estás ahorrando para tu propia versión de la libertad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elämäntyön palkinto on maailman näkeminen. Säästät luultavasti kohti omaa vapauttasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang gantimpala ng buong buhay na pagtatrabaho ay makita ang mundo. Malamang nag-iipon ka para sa sarili mong bersyon ng kalayaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récompense d'une vie de travail, c'est de voir le monde. Tu mets sûrement de côté pour une certaine idée de la liberté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרס על חיים של עבודה הוא לראות את העולם. כנראה שיש לך חיסכון לקראת גרסה מסוימת של חופש."
