          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoda ve velkých věcech – jak chcete žít, co budujete. Záleží na tom, jestli máte stejnou vizi."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cytuno ar y pethau mawr — sut rydych chi eisiau byw, beth rydych chi'n ei adeiladu. Mae rhannu'r un weledigaeth yn bwysig."
