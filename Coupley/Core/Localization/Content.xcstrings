    },
    "Context matters. A weekend city break vs. a honeymoon deserve different budgets. Pragmatic." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السياق مهم. عطلة نهاية أسبوع في مدينة وشهر عسل يستحقان ميزانيتين مختلفتين. نظرة عملية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záleží na kontextu. Víkend ve městě a svatební cesta si zaslouží jiný rozpočet. Pragmatické."
