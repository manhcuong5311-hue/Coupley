    "Connection and legacy. Being present for the people you love in the final chapter means everything to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding en nalatenskap. Om in die laaste hoofstuk daar te wees vir die mense vir wie jy lief is, beteken vir jou alles."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትስስርና ቅርስ። በመጨረሻው ምዕራፍ ለሚወዷቸው ሰዎች መገኘት ለእርስዎ ሁሉም ነገር ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تواصل وإرث. الحضور مع أحبّتك في الفصل الأخير يعني لك كل شيء."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পৰ্ক আৰু উত্তৰাধিকাৰ। জীৱনৰ শেষ অধ্যায়ত ভাল পোৱা মানুহবোৰৰ কাষত থকাটোৱেই আপোনাৰ বাবে সকলো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlılıq və miras. Son fəsildə sevdiyin insanların yanında olmaq sənin üçün hər şeydir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блізкасць і спадчына. Быць побач з тымі, каго любіш, у апошнім раздзеле жыцця — для цябе гэта ўсё."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близост и наследство. Да присъстваш в живота на хората, които обичаш, в последната глава значи всичко за теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পর্ক আর উত্তরাধিকার। জীবনের শেষ অধ্যায়ে প্রিয় মানুষদের পাশে থাকা তোমার কাছে সবকিছু।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliskost i nasljeđe. Biti tu za ljude koje voliš u posljednjem poglavlju života znači ti sve."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexió i llegat. Ser-hi per a la gent que estimes en l'últim capítol ho és tot per a tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blízkost a odkaz. Být v poslední kapitole nablízku lidem, které miluješ, pro tebe znamená všechno."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cysylltiad ac etifeddiaeth. Mae bod yno i'r bobl rwyt ti'n eu caru yn y bennod olaf yn golygu popeth i ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhed og arv. At være til stede for dem, du elsker, i det sidste kapitel betyder alt for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbundenheit und Vermächtnis. Im letzten Kapitel für die Menschen da zu sein, die du liebst, bedeutet dir alles."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύνδεση και παρακαταθήκη. Το να είσαι εκεί για τους ανθρώπους που αγαπάς στο τελευταίο κεφάλαιο σημαίνει τα πάντα για σένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vínculos y legado. Estar presente para la gente que quieres en el último capítulo lo es todo para ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side ja pärand. Viimases peatükis armsate inimeste jaoks olemas olla tähendab sulle kõike."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harremana eta ondarea. Azken kapituluan maite duzun jendearekin egoteak dena esan nahi du zuretzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیوند و میراث. کنار عزیزانت بودن در فصل آخر زندگی برایت همه چیز است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyttä ja perintöä. Sinulle on kaikki kaikessa olla läsnä rakkaillesi elämän viimeisessä luvussa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksyon at pamana. Napakahalaga sa’yo na naroon ka para sa mga mahal mo sa huling kabanata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lien et transmission. Être là pour les gens que tu aimes dans le dernier chapitre compte plus que tout pour toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceangal agus oidhreacht. Is é gach rud duit a bheith i láthair do na daoine a bhfuil grá agat dóibh sa chaibidil dheireanach."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión e legado. Estar presente para a xente que queres no último capítulo significa todo para ti."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંબંધ અને વારસો. જીવનના છેલ્લા પ્રકરણમાં પોતાના પ્રિયજનો માટે હાજર રહેવું તમારા માટે સર્વસ્વ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zumunci da gado. Kasancewa tare da mutanen da kuke so a babi na ƙarshe na nufin komai a gare ku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיבור ומורשת. להיות שם בשביל האנשים שאהובים עליך בפרק האחרון — זה הכול בשבילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुड़ाव और विरासत। ज़िंदगी के आख़िरी अध्याय में अपनों के पास होना आपके लिए सब कुछ है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezanost i nasljeđe. Biti tu za ljude koje voliš u posljednjem poglavlju znači ti sve."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksyon ak eritaj. Lè ou la pou moun ou renmen yo nan dènye chapit la, sa vo tout bagay pou ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolódás és örökség. Neked minden, hogy az utolsó fejezetben ott lehess azoknak, akiket szeretsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կապ և ժառանգություն։ Կյանքի վերջին գլխում սիրելի մարդկանց կողքին լինելը քեզ համար ամեն ինչ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan dan warisan. Hadir untuk orang-orang yang kamu sayangi di babak terakhir hidup sangat berarti buatmu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njikọ na ihe nketa. Ịnọ n'ebe ndị ị hụrụ n'anya nọ n'isi ikpeazụ nke ndụ bụ ihe niile nye gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengsl og arfleifð. Að vera til staðar fyrir fólkið sem þú elskar á lokakaflanum skiptir þig öllu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legami ed eredità. Esserci per le persone che ami nell’ultimo capitolo significa tutto per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つながりと受け継ぐもの。人生の最終章で大切な人のそばにいることが、何より大事な人です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesambungan lan warisan. Ana kanggo wong-wong sing panjenengan tresnani ing bab pungkasan urip iku aji banget kanggo panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიახლოვე და მემკვიდრეობა. ცხოვრების ბოლო თავში საყვარელი ადამიანების გვერდით ყოფნა შენთვის ყველაფერია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Байланыс пен мұра. Соңғы кезеңде жақсы көретін адамдарыңның қасында болу сен үшін бәрінен маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទំនាក់ទំនង និងកេរ្តិ៍ដំណែល។ ការនៅក្បែរមនុស្សដែលអ្នកស្រឡាញ់ក្នុងជំពូកចុងក្រោយ មានន័យខ្លាំងណាស់សម្រាប់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಾಂಧವ್ಯ ಮತ್ತು ಪರಂಪರೆ. ಕೊನೆಯ ಅಧ್ಯಾಯದಲ್ಲಿ ನಿಮ್ಮ ಪ್ರೀತಿಪಾತ್ರರ ಜೊತೆಗಿರುವುದೇ ನಿಮಗೆ ಎಲ್ಲವೂ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유대와 남길 유산을 중요하게 여겨요. 인생의 마지막 장에서 사랑하는 사람들 곁에 있는 게 무엇보다 중요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girêdan û mîras. Di beşa dawî de li kêleka kesên ku tu ji wan hez dikî bûn ji bo te her tişt e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Байланыш жана мурас. Жашоонун акыркы бөлүгүндө жакшы көргөн адамдарыңдын жанында болуу сен үчүн баарынан маанилүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbonnenheet an dat, wat bleift. Am leschte Kapitel fir déi Leit do ze sinn, déi s de gär hues, bedeit dir alles."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມຜູກພັນ ແລະ ມໍລະດົກ ການໄດ້ຢູ່ກັບຄົນທີ່ເຈົ້າຮັກໃນບົດສຸດທ້າຍຂອງຊີວິດ ມີຄວາມໝາຍທີ່ສຸດສຳລັບເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryšys ir palikimas. Būti šalia mylimų žmonių paskutiniame gyvenimo skyriuje tau reiškia viską."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuvība un mantojums. Būt līdzās tiem, ko mīli, pēdējā nodaļā tev nozīmē visu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifandraisana sy lova. Ny fanatrehana ho an'ireo olona tianao amin'ny toko farany no zava-dehibe indrindra aminao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hononga, he taonga tuku iho. Ko te noho tahi me te hunga e aroha ana koe i te wāhanga whakamutunga te mea nui katoa ki a koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поврзаност и наследство. Да бидеш тука за луѓето што ги сакаш во последното поглавје ти значи сè."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അടുപ്പവും പൈതൃകവും. ജീവിതത്തിന്റെ അവസാന അധ്യായത്തിൽ സ്നേഹിക്കുന്നവർക്കൊപ്പം ഉണ്ടാകുന്നതാണ് നിങ്ങൾക്ക് എല്ലാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Холбоо ба өв залгамж. Сүүлчийн бүлэгт хайртай хүмүүсийнхээ дэргэд байх нь чамд бүх юм."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाती आणि वारसा. आयुष्याच्या शेवटच्या अध्यायात प्रिय व्यक्तींसोबत असणे तुमच्यासाठी सर्वस्व आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan dan legasi. Hadir untuk orang tersayang dalam bab terakhir hidup sangat bermakna bagi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konnessjoni u wirt. Li tkun preżenti għan-nies li tħobb fl-aħħar kapitlu tfisser kollox għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်နွယ်မှုနဲ့ အမွေအနှစ်။ ဘဝရဲ့ နောက်ဆုံးအခန်းမှာ ချစ်ရသူတွေအနားမှာ ရှိနေရတာက သင့်အတွက် အရာအားလုံးပါပဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhet og det du gir videre. Å være til stede for dem du elsker i det siste kapittelet betyr alt for deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सम्बन्ध र विरासत। जीवनको अन्तिम अध्यायमा माया गर्ने मान्छेहरूका लागि उपस्थित हुनु तपाईंका लागि सबैथोक हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding en nalatenschap. Er zijn voor de mensen van wie je houdt in het laatste hoofdstuk betekent alles voor je."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulumikizana ndi cholowa. Kukhalapo kwa anthu amene mumawakonda m'mutu womaliza wa moyo kumatanthauza chilichonse kwa inu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walitti dhufeenya fi dhaala. Kutaa jireenyaa isa dhumaa keessatti namoota jaallattuuf argamuun siif waan hundaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣାପଣ ଓ ଉତ୍ତରାଧିକାର। ଶେଷ ଅଧ୍ୟାୟରେ ଭଲପାଉଥିବା ଲୋକଙ୍କ ପାଖରେ ରହିବା ଆପଣଙ୍କ ପାଇଁ ସବୁକିଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੇੜਤਾ ਅਤੇ ਵਿਰਾਸਤ। ਜ਼ਿੰਦਗੀ ਦੇ ਆਖ਼ਰੀ ਅਧਿਆਇ ਵਿੱਚ ਆਪਣੇ ਪਿਆਰਿਆਂ ਕੋਲ ਹੋਣਾ ਤੁਹਾਡੇ ਲਈ ਸਭ ਕੁਝ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więź i dziedzictwo. Bycie przy bliskich w ostatnim rozdziale życia znaczy dla ciebie wszystko."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اړیکه او میراث. په وروستي فصل کې د خپلو عزیزانو تر څنګ اوسېدل ستاسو لپاره هر څه دي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexão e legado. Estar presente para quem você ama no último capítulo significa tudo para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligação e legado. Estar presente para quem amas no último capítulo é tudo para ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiune și moștenire. Să fii alături de oamenii pe care îi iubești în ultimul capitol înseamnă totul pentru tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близость и то, что останется после тебя. Быть рядом с любимыми людьми в последней главе жизни — для тебя важнее всего."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubusabane n'umurage. Kuba hafi y'abo ukunda mu gice cya nyuma cy'ubuzima bisobanura byose kuri wowe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සම්බන්ධතාව සහ උරුමය. ජීවිතයේ අවසාන පරිච්ඡේදයේ ඔබ ආදරය කරන අය ළඟ සිටීම ඔබට සියල්ලමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blízkosť a odkaz. Byť pri ľuďoch, ktorých ľúbiš, aj v poslednej kapitole pre teba znamená všetko."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezanost in zapuščina. Biti ob ljudeh, ki jih ljubiš, v zadnjem poglavju ti pomeni vse."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukama nenhaka. Kuva pedyo nevanhu vaunoda muchitsauko chekupedzisira kunoreva zvose kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriir iyo dhaxal. Inaad u joogto dadka aad jeceshahay cutubka ugu dambeeya waa wax walba adiga kuu ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidhje dhe trashëgimi. Të jesh pranë njerëzve që do në kapitullin e fundit do të thotë gjithçka për ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блискост и наслеђе. Да будеш ту за људе које волиш у последњем поглављу — то ти значи све."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silaturahmi sareng warisan. Hadir pikeun jalma-jalma anu dipikanyaah dina bab pamungkas téh hartosna sadayana pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemenskap och arv. Att finnas där för dem du älskar i livets sista kapitel betyder allt för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaribu na urithi. Kuwepo kwa ajili ya watu unaowapenda katika sura ya mwisho ya maisha kuna maana kubwa kwako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உறவும் மரபும். வாழ்க்கையின் இறுதி அத்தியாயத்தில் நேசிப்பவர்களுடன் இருப்பது உங்களுக்கு எல்லாமே."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనుబంధం, వారసత్వం. జీవితపు చివరి అధ్యాయంలో మీరు ప్రేమించేవారి దగ్గర ఉండటమే మీకు అన్నీ."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пайвастагӣ ва мерос. Дар боби охирин назди наздиконат будан барои ту ҳама чиз аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความผูกพันและสิ่งที่ส่งต่อ การได้อยู่เคียงข้างคนที่รักในบทสุดท้ายของชีวิตมีความหมายกับคุณที่สุด"
