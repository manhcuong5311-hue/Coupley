        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlighet i omgivelsene. Ombygd lagerlokale, båt, hytte uten strøm – du vil at stedet skal si noe om deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको व्यक्तित्व झल्किने वातावरण। पुरानो गोदामबाट बनेको घर, डुङ्गा, बिजुलीको लाइनबाहिरको काठे घर — तपाईं आफ्नो ठाउँले तपाईंबारे केही भनोस् भन्ने चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoonlijkheid in je omgeving. Een verbouwd pakhuis, een boot, een blokhut zonder netstroom – je wilt dat je plek iets over je zegt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umunthu wanu m'malo omwe mumakhala. Nyumba yosinthidwa kuchokera ku nkhokwe, bwato, kanyumba kopanda magetsi a boma — mukufuna malowo anene kanthu za inu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amala kee naannoo kee keessatti. Kuusaa mana ta'e, doonii, mana xiqqaa fageenya irra jiru — bakki sun waa'ee kee akka waa dubbatu barbaadda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ପରିବେଶରେ ଆପଣଙ୍କ ବ୍ୟକ୍ତିତ୍ୱ। ପୁରୁଣା ଗୋଦାମ, ନୌକା, ଗ୍ରିଡ୍ ବାହାରେ କାଠ କୁଟୀର — ଆପଣ ଚାହାନ୍ତି ଘରଟି ଆପଣଙ୍କ ବିଷୟରେ କିଛି କହୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਲੇ-ਦੁਆਲੇ ਵਿੱਚ ਤੁਹਾਡੀ ਸ਼ਖ਼ਸੀਅਤ। ਬਦਲਿਆ ਹੋਇਆ ਗੋਦਾਮ, ਕਿਸ਼ਤੀ, ਸ਼ਹਿਰ ਤੋਂ ਦੂਰ ਕੈਬਿਨ — ਤੁਸੀਂ ਚਾਹੁੰਦੇ ਹੋ ਕਿ ਤੁਹਾਡੀ ਥਾਂ ਤੁਹਾਡੇ ਬਾਰੇ ਕੁਝ ਕਹੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobowość w przestrzeni. Przerobiony magazyn, łódź, chatka z dala od cywilizacji – chcesz, żeby miejsce mówiło coś o tobie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په چاپېریال کې شخصیت. بدل شوی ګودام، کښتۍ، له شبکې لرې کوټه — تاسو غواړئ چې ځای ستاسو په اړه یو څه ووایي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalidade no espaço. Galpão reformado, barco, cabana isolada — você quer que a casa diga algo sobre você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalidade no espaço. Um armazém convertido, um barco, uma cabana isolada — queres que a casa diga algo sobre ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitate în spațiul tău. Un depozit transformat, o barcă, o cabană off-grid — vrei ca spațiul să spună ceva despre tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Характер в пространстве. Перестроенный склад, лодка, домик вдали от цивилизации — тебе хочется, чтобы дом говорил о тебе."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imiterere yawe igaragarira aho uba. Ububiko bwahinduwe inzu, ubwato, akazu kari kure y'umujyi — ushaka ko aho uba hagira icyo hakuvugaho."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබේ පරිසරයේ ඔබේ පෞරුෂය. ප්‍රතිනිර්මාණය කළ ගබඩාවක්, බෝට්ටුවක්, විදුලි ජාලයෙන් ඈත පැල්පතක් — ඔබට ඕනේ ඔබේ අවකාශය ඔබ ගැන යමක් කියන එක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobnosť v prostredí. Prerobený sklad, loď, chatka mimo siete – chceš, aby priestor niečo hovoril o tebe."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osebnost v tvojem okolju. Predelano skladišče, čoln, koča brez priključka na omrežje – želiš si, da prostor nekaj pove o tebi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunhu hwako munzvimbo yako. Dura rakashandurwa kuva imba, chikepe, kaimba kari kure nemagetsi — unoda kuti nzvimbo yako itaure chimwe chinhu nezvako."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shakhsiyaddaada oo ka muuqata deegaankaaga. Bakhaar la beddelay, doon, aqal yar oo ka go'an korontada — waxaad rabtaa in meeshu wax kaa sheegto."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitet në mjedisin tënd. Depo e kthyer në shtëpi, varkë, kasolle jashtë rrjetit – do që hapësira të thotë diçka për ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личност у простору. Преуређено складиште, брод, брвнара ван мреже — желиш да простор нешто каже о теби."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapribadian dina lingkungan anjeun. Gudang anu dirobih, parahu, pondok di luar jaringan listrik: anjeun hoyong rohangan anu nyarioskeun hiji hal ngeunaan anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlighet i din miljö. Ombyggt lager, husbåt, stuga utan el och vatten – du vill att hemmet ska säga något om dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utu wako katika mazingira yako. Ghala lililogeuzwa makazi, mashua, kibanda kisichotegemea umeme wa gridi — unataka mahali panaposema kitu kukuhusu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சூழலில் உங்கள் ஆளுமை. மாற்றியமைத்த கிடங்கு, படகு, தனிமையான மரக்குடில் — இடம் உங்களைப் பற்றி ஏதாவது சொல்ல வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ పరిసరాల్లో మీ వ్యక్తిత్వం. మార్చిన గోదాము, పడవ, గ్రిడ్‌కు దూరంగా ఒక కుటీరం — మీ చోటు మీ గురించి ఏదో చెప్పాలని కోరుకుంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шахсият дар муҳити зиндагӣ. Анбори табдилдодашуда, қаиқ, кулбае дур аз шаҳр — ту мехоҳӣ, ки хона дар бораи ту чизе гӯяд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวตนที่สะท้อนในที่อยู่ โกดังรีโนเวต บ้านเรือ กระท่อมนอกระบบไฟฟ้า คุณอยากให้พื้นที่บอกอะไรบางอย่างเกี่ยวกับตัวคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባህሪኹም ኣብ ከባቢኹም። ዝተቐየረ መኽዘን፣ ጃልባ፣ ካብ ከተማ ርሒቑ ዘሎ ገዛ ዕንጨይቲ — እቲ ቦታ ብዛዕባኹም ገለ ክዛረብ ትደልዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daş-töweregiňde häsiýetiň görünýär. Öwrülen ammar, gaýyk, ulgamdan daşdaky agaç öý — ýaşaýan ýeriňiň seniň hakda bir zat aýtmagyny isleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşadığın yerde kişilik. Dönüştürülmüş bir depo, bir tekne, şebekeden bağımsız bir kulübe; alanın senin hakkında bir şey söylemesini istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Характер у просторі. Переобладнаний склад, човен, автономна хатинка — тобі хочеться, щоб дім щось про тебе розповідав."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماحول میں شخصیت۔ پرانا گودام، کشتی، شہر سے دور کیبن: آپ کی خواہش ہے کہ جگہ خود آپ کے بارے میں کچھ کہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrofingizda shaxsiyatingiz aks etsin. Qayta jihozlangan ombor, qayiq, tarmoqdan uzilgan kulba — joyingiz siz haqingizda nimadir aytishini xohlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian mang cá tính. Nhà kho cải tạo, nhà thuyền, căn chòi tự cung tự cấp — bạn muốn nơi ở nói lên điều gì đó về mình."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuwena kwindawo ohlala kuyo. Indlu yokugcina impahla eguqulweyo, isikhephe, indlwana ekude nezixeko — ufuna indawo ethetha okuthile ngawe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwà yín nínú àyíká yín. Ilé ìkẹ́rùsí tí a yí padà, ọkọ̀ ojú omi, ahéré nínú igbó láìsí iná ìjọba — ẹ fẹ́ kí ibẹ̀ sọ nǹkan kan nípa yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓居所展現個性。改建的貨倉、船屋、離網小木屋——你希望空間能說出你是怎樣的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让空间有个性。改造的仓库、船屋、离网小木屋，你希望住的地方能体现你是谁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓空間展現個性。改建倉庫、船屋、離網小木屋，你希望住的地方能說出你是誰。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuntu bakho endaweni yakho. Indlu yokugcina impahla eguqulwe, isikebhe, indlwana engaxhunyiwe kugesi — ufuna ukuthi indawo isho okuthile ngawe."
          }
        }
      }
    },
    "Pets are a lifestyle choice that affects shared living in big ways." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
