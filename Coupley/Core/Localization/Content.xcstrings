        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار أكثر التزامًا يمسّ كثيرًا من الوجبات المشتركة وقرارات الخروج. التفاهم هنا مهم حقًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অধিক দায়বদ্ধ বাছনি, যিয়ে একেলগে খোৱা বহু আহাৰ আৰু বাহিৰত খোৱাৰ সিদ্ধান্তক প্ৰভাৱিত কৰে। এই বিষয়ত মিল থকাটো সঁচাকৈয়ে গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortaq yeməklərin və restoran seçimlərinin çoxuna təsir edən daha qəti seçimdir. Burada həmfikir olmaq həqiqətən önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больш цвёрды выбар, які ўплывае на многія агульныя прыёмы ежы і выбар месцаў. Тут вельмі важна дамовіцца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-категоричен избор, който засяга много общи хранения и решения къде да ядете. Съгласието тук е наистина важно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও দৃঢ় একটা সিদ্ধান্ত, যা একসাথে খাওয়া আর বাইরে খাওয়ার অনেক সিদ্ধান্তে প্রভাব ফেলে। এখানে মিল থাকা সত্যিই জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posvećeniji izbor koji utiče na mnoge zajedničke obroke i odluke o izlascima. Usklađenost je ovdje zaista važna."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una opció més exigent que afecta molts àpats compartits i decisions sobre on menjar. Estar d'acord en això és molt important."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zásadnější volba, která ovlivňuje spoustu společných jídel i rozhodnutí, kam jít jíst. Shoda je tady opravdu důležitá."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewis mwy ymroddedig sy'n effeithio ar lawer o brydau a phenderfyniadau bwyta allan. Mae cytuno ar hyn yn wirioneddol bwysig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et mere forpligtende valg, der påvirker mange fælles måltider og valg af spisesteder. Her betyder det virkelig noget at være på linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine klare Entscheidung, die viele gemeinsame Mahlzeiten und Restaurantwahlen betrifft. Hier auf einer Linie zu sein, ist wirklich wichtig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πιο δεσμευτική επιλογή που επηρεάζει πολλά κοινά γεύματα και αποφάσεις για έξοδο. Εδώ η συμφωνία μετράει πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una elección más firme que afecta a muchas comidas compartidas y decisiones a la hora de salir. Estar en sintonía aquí importa de verdad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pühendunum valik, mis mõjutab paljusid ühiseid toidukordi ja söögikohtade valikuid. Üksmeel on siin tõeliselt oluline."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konpromiso sendoagoa, otordu partekatu eta jatetxe-erabaki askotan eragina duena. Honetan bat etortzeak benetako garrantzia du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخابی متعهدانه‌تر که روی خیلی از وعده‌های مشترک و تصمیم‌های بیرون غذا خوردن اثر می‌گذارد. هم‌نظری در این مورد واقعاً مهم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitoutuneempi valinta, joka vaikuttaa moniin yhteisiin aterioihin ja ravintolavalintoihin. Yhteinen linja on tässä oikeasti tärkeä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas seryosong desisyon ito na nakaaapekto sa maraming sabay na pagkain at pagpili ng kainan. Talagang mahalaga na magkasundo kayo rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un choix plus engagé, qui touche beaucoup de repas et de sorties à deux. Être sur la même longueur d'onde là-dessus compte vraiment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rogha níos daingne a théann i bhfeidhm ar go leor béilí comhroinnte agus cinntí faoi ithe amuigh. Is fíorthábhachtach go mbeadh sibh ar aon intinn faoi seo."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha opción máis comprometida que afecta a moitas comidas compartidas e decisións ao comer fóra. Estar de acordo nisto é realmente importante."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વધુ દૃઢ પસંદગી, જેની અસર સાથેના ઘણા ભોજન અને બહાર જમવાના નિર્ણયો પર પડે છે. અહીં મત મળવો ખરેખર મહત્ત્વનો છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi mai zurfi da ke shafar abinci da yawa na tare da shawarwarin cin abinci a waje. Fahimtar juna a nan na da muhimmanci da gaske."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירה מחייבת יותר, שמשפיעה על הרבה ארוחות משותפות ועל ההחלטות איפה לאכול. כאן התאמה באמת חשובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ज़्यादा पक्का फ़ैसला, जिसका असर साथ के कई खानों और बाहर खाने के फ़ैसलों पर पड़ता है। इस पर तालमेल सच में अहम है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predaniji izbor koji utječe na mnoge zajedničke obroke i odluke o izlascima. Usklađenost je ovdje stvarno važna."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon chwa ki pi angaje ki afekte anpil repa nou pataje ak desizyon pou sòti manje. Lè nou dakò sou sa, se vrèman enpòtan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elkötelezettebb döntés, ami sok közös étkezést és étteremválasztást érint. Itt tényleg fontos az összhang."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ավելի խիստ ընտրություն, որն ազդում է բազմաթիվ համատեղ ճաշերի ու ռեստորանի ընտրության վրա։ Այստեղ համաձայնությունն իսկապես կարևոր է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan yang lebih teguh dan memengaruhi banyak momen makan bareng. Kesepahaman soal ini benar-benar penting."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhọrọ siri ike karịa nke na-emetụta ọtụtụ nri unu na-eri ọnụ na mkpebi iri nri. Ikwekọ n'ebe a dị mkpa n'ezie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meiri skuldbinding sem hefur áhrif á margar sameiginlegar máltíðir og val á veitingastöðum. Hér skiptir virkilega máli að vera samstíga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scelta più impegnativa che incide su tanti pasti condivisi e sulle uscite al ristorante. Essere in sintonia qui conta davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くの食事や外食の選択に関わる、しっかりとした選択です。ここで足並みがそろっているかは、本当に大切です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan sing luwih temenan lan mangaruhi akeh wayah mangan bareng lan keputusan mangan ing njaba. Padha panemu ing bab iki saestu wigati."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფრო მტკიცე არჩევანია, რომელიც ბევრ საერთო ჭამასა და რესტორნის არჩევანზე მოქმედებს. აქ შეთანხმება მართლაც მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көп ортақ асқа және сыртта тамақтану шешімдеріне әсер ететін байыпты таңдау. Бұл жерде көзқарастың үйлесуі шынымен маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជម្រើសដែលប្ដេជ្ញាខ្លាំងជាង ដែលប៉ះពាល់ដល់អាហាររួម និងការសម្រេចចិត្តពេលញ៉ាំក្រៅជាច្រើន។ ការយល់ស្របគ្នាលើរឿងនេះសំខាន់ពិតៗ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಲವು ಜೊತೆಯ ಊಟ ಮತ್ತು ಹೊರಗೆ ತಿನ್ನುವ ನಿರ್ಧಾರಗಳ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವ ಹೆಚ್ಚು ಬದ್ಧ ಆಯ್ಕೆ. ಇಲ್ಲಿ ಒಮ್ಮತ ನಿಜಕ್ಕೂ ಮುಖ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께하는 식사와 외식 선택에 많은 영향을 주는, 더 확고한 선택이에요. 이 부분에서 서로 맞추는 건 정말 중요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijarteyeke bi biryartir ku bandorê li gelek xwarinên hevpar û biryarên xwaringehê dike. Lihevkirin li vir bi rastî girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бирге тамактанууга жана тамак тандоого көп таасир эткен бекем тандоо. Бул жерде бир пикирде болуу чындап маанилүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eng méi konsequent Entscheedung, déi vill gemeinsam Iessen a Restaurantsbesich beaflosst. Hei eens ze sinn, ass wierklech wichteg."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເປັນທາງເລືອກທີ່ຈິງຈັງກວ່າ ເຊິ່ງມີຜົນຕໍ່ການກິນນຳກັນ ແລະ ການເລືອກຮ້ານຫຼາຍ ການເຫັນກົງກັນໃນເລື່ອງນີ້ສຳຄັນແທ້ໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvirtesnis pasirinkimas, veikiantis daugelį bendrų valgių ir sprendimų, kur pavalgyti. Sutarimas čia tikrai svarbus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stingrāka izvēle, kas ietekmē daudzas kopīgas maltītes un lēmumus par ēšanu ārpus mājas. Vienprātība šeit ir patiesi svarīga."
