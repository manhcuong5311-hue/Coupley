        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពតានតឹងក្នុងការងារជៀសមិនរួចទេ — ការដឹងពីរបៀបគាំទ្រគ្នាពិតជាធ្វើឲ្យមានភាពខុសគ្នា។"
