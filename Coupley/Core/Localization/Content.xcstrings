        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقع‌بین. زندگی واقعی‌ات بیرون از کار جریان دارد. شغل در خدمت تصویری است که از زندگی داری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytännöllistä. Oikea elämäsi tapahtuu töiden ulkopuolella. Työ palvelee visiota."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktikal. Nasa labas ng trabaho ang totoong buhay mo. Ang trabaho ang nagsisilbi sa pangarap mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatique. Ta vraie vie se passe en dehors du travail. Le boulot sert ton projet de vie."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praiticiúil. Is lasmuigh den obair atá do shaol ceart. Freastalaíonn an post ar an bhfís."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatismo. A túa vida de verdade está fóra do traballo. O emprego está ao servizo do teu proxecto de vida."
