          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዙ ጉዞዎች፣ በአንድ ጉዞ ትንሽ ወጪ። የልምድ ብዛት ይፈልጋሉ። ርካሽ ማረፊያዎችና የመንገድ ምግብ አያስፈሩዎትም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رحلات أكثر وإنفاق أقل في كل رحلة. تريدون أكبر قدر من التجارب، ولا تخيفكم النُّزل البسيطة وطعام الشارع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেছি ভ্ৰমণ, প্ৰতিটোত কম খৰচ। আপুনি বহু অভিজ্ঞতা বিচাৰে। হোষ্টেল আৰু পথৰ কাষৰ খাদ্যক আপুনি ভয় নকৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha çox səfər, hər səfərə daha az xərc. Təcrübənin çox olmasını istəyirsən. Hostellər və küçə yeməkləri səni qorxutmur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больш паездак, менш на кожную. Табе важна колькасць уражанняў. Хостэлы і вулічная ежа цябе не палохаюць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повече пътувания, по-малко за всяко. Искаш много преживявания. Хостелите и уличната храна не те плашат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেশি ট্রিপ, প্রতি ট্রিপে কম খরচ। তুমি অনেক অভিজ্ঞতা চাও। হোস্টেল আর রাস্তার খাবারে তোমার ভয় নেই।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više putovanja, manje po putovanju. Želiš što više iskustava. Hosteli i ulična hrana te ne plaše."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més viatges, menys per viatge. Vols acumular experiències. Els albergs i el menjar de carrer no et fan por."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víc cest, míň za každou. Chceš co nejvíc zážitků. Hostely a pouliční jídlo tě nevyděsí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwy o deithiau, llai fesul taith. Rwyt ti eisiau llwyth o brofiadau. Dydy hostelau a bwyd stryd ddim yn dy ddychryn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere rejser, mindre pr. rejse. Du vil have mange oplevelser. Vandrerhjem og streetfood skræmmer dig ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Reisen, weniger pro Reise. Du willst möglichst viel erleben. Hostels und Streetfood schrecken dich nicht ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περισσότερα ταξίδια, λιγότερα έξοδα στο καθένα. Θέλεις πολλές εμπειρίες. Οι ξενώνες και το street food δεν σε τρομάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más viajes, menos gasto por viaje. Quieres vivir muchas experiencias. Los albergues y la comida callejera no te asustan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rohkem reise, vähem raha reisi kohta. Sa tahad elamuste hulka. Hostelid ja tänavatoit sind ei hirmuta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidaia gehiago, bidaia bakoitzeko gutxiago. Esperientzia ugari nahi dituzu. Aterpetxeek eta kaleko janariak ez zaituzte beldurtzen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفرهای بیشتر، خرج کمتر برای هر سفر. حجم تجربه را می‌خواهی. هاستل و غذای خیابانی تو را نمی‌ترسانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enemmän matkoja, vähemmän per matka. Haluat paljon kokemuksia. Hostellit ja katuruoka eivät pelota sinua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas maraming biyahe, mas mura bawat isa. Gusto mo ng dami ng karanasan. Hindi ka natatakot sa hostel at street food."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de voyages, moins cher à chaque fois. Tu veux multiplier les expériences. Les auberges de jeunesse et la street food ne te font pas peur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níos mó turas, níos lú ar gach turas. Teastaíonn neart eispéireas uait. Ní chuireann brúnna óige ná bia sráide eagla ort."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máis viaxes, menos por viaxe. Queres moitas experiencias. Os albergues e a comida de rúa non te asustan."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વધુ ટ્રિપ, દરેક ટ્રિપમાં ઓછો ખર્ચ. તમારે ઘણા અનુભવો જોઈએ છે. હૉસ્ટેલ અને સ્ટ્રીટ ફૂડથી તમે ડરતા નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tafiye-tafiye da yawa, ƙasa da kuɗi kowace tafiya. Kuna son yawan gogewa. Masaukai masu arha da abincin titi ba sa ba ku tsoro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר טיולים, פחות לכל טיול. כמות החוויות היא מה שחשוב לך. הוסטלים ואוכל רחוב לא מפחידים אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा ट्रिप, हर ट्रिप पर कम ख़र्च। आपको ढेर सारे अनुभव चाहिए। हॉस्टल और स्ट्रीट फ़ूड से आपको डर नहीं लगता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više putovanja, manje po putovanju. Želiš puno iskustava. Hosteli i ulična hrana te ne plaše."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plis vwayaj, mwens depans pa vwayaj. Ou vle anpil eksperyans. Otèl jèn ak manje lari pa fè ou pè."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Több utazás, kevesebb pénz egy-egy útra. Az élmények mennyisége számít. A hostelek és az utcai kaja nem riasztanak el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ավելի շատ ճամփորդություններ, ավելի քիչ ծախս ամեն մեկի վրա։ Ուզում ես շատ տպավորություններ։ Հոսթելներն ու փողոցային ուտելիքը քեզ չեն վախեցնում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak perjalanan, lebih hemat per perjalanan. Kamu mengejar banyaknya pengalaman. Hostel dan jajanan kaki lima nggak bikin kamu takut."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njem ka ukwuu, mmefu nta n'otu njem. Ị chọrọ ọtụtụ ahụmahụ. Ụlọ ndị njem dị ọnụ ala na nri n'okporo ụzọ anaghị atụ gị egwu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleiri ferðir, minna í hverja. Þú vilt mikið af upplifunum. Farfuglaheimili og götumatur hræða þig ekki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più viaggi, meno spesa per ciascuno. Vuoi tante esperienze. Ostelli e street food non ti spaventano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回あたりの費用を抑えて、旅の回数を増やしたいタイプです。とにかくたくさん体験したい。ゲストハウスも屋台ごはんもへっちゃらです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luwih kerep lelungan, luwih irit saben lelungan. Panjenengan pengin pengalaman sing akeh. Hostel lan jajanan pinggir dalan ora nggawe panjenengan wedi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მეტი მოგზაურობა, თითოზე ნაკლები ხარჯი. შთაბეჭდილებების რაოდენობა გინდა. ჰოსტელები და ქუჩის საჭმელი არ გაშინებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапар көп, әрқайсысына аз. Әсердің көп болғанын қалайсың. Хостел мен көше тағамы сені қорқытпайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំណើរច្រើន ចំណាយតិចក្នុងមួយដំណើរ។ អ្នកចង់បានបទពិសោធន៍ច្រើន។ ផ្ទះសំណាក់ថោកៗ និងម្ហូបតាមផ្លូវមិនធ្វើឲ្យអ្នកខ្លាចទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೆಚ್ಚು ಪ್ರವಾಸ, ಪ್ರತಿಯೊಂದಕ್ಕೂ ಕಡಿಮೆ ಖರ್ಚು. ನಿಮಗೆ ಹೆಚ್ಚು ಅನುಭವಗಳು ಬೇಕು. ಹಾಸ್ಟೆಲ್ ಮತ್ತು ಬೀದಿ ತಿಂಡಿ ನಿಮ್ಮನ್ನು ಹೆದರಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 적게 쓰고 더 자주 떠나요. 경험의 양이 중요하죠. 게스트하우스나 길거리 음식도 두렵지 않아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerên zêdetir, ji bo her gerê kêmtir. Tu ezmûnên zêde dixwazî. Hostel û xwarinên kolanê te natirsînin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көп саякат, ар бирине аз акча. Сага тажрыйбанын көптүгү керек. Хостел жана көчө тамагы сени коркутпайт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méi Reesen, manner pro Rees. Du wëlls esou vill Erliefnesser wéi méiglech. Hostellen an Iessen op der Strooss maachen dir keng Angscht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ທ່ຽວຫຼາຍຄັ້ງ ໃຊ້ໜ້ອຍຕໍ່ຄັ້ງ ເຈົ້າຢາກໄດ້ປະສົບການຫຼາຍໆ ໂຮສເທວ ແລະ ອາຫານຂ້າງທາງບໍ່ໄດ້ເຮັດໃຫ້ເຈົ້າຢ້ານ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daugiau kelionių, mažiau išlaidų kiekvienai. Tau svarbus patirčių kiekis. Hosteliai ir gatvės maistas tavęs negąsdina."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vairāk braucienu, mazāk izdevumu katrā. Tev gribas daudz piedzīvojumu. Hosteļi un ielu ēdiens tevi nebiedē."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dia maro kokoa, fandaniana kely kokoa isaky ny dia. Traikefa betsaka no tadiavinao. Tsy matahotra trano fandraisam-bahiny mora sy sakafo an-dalambe ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kia maha ake ngā haerenga, kia iti ake te utu mō ia haerenga. E hiahia ana koe ki te maha o ngā wheako. Kāore koe e mataku i ngā whare noho iti me ngā kai tiriti."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повеќе патувања, помалку по патување. Сакаш што повеќе доживувања. Хостелите и уличната храна не те плашат."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കൂടുതൽ യാത്രകൾ, ഓരോന്നിനും കുറഞ്ഞ ചെലവ്. നിങ്ങൾക്ക് അനുഭവങ്ങളുടെ എണ്ണമാണ് വേണ്ടത്. ഹോസ്റ്റലുകളും തെരുവുഭക്ഷണവും നിങ്ങളെ പേടിപ്പിക്കില്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Олон аялал, аялал бүрт бага зардал. Чи олон туршлага хүсдэг. Хостел, гудамжны хоол чамайг айлгадаггүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जास्त सहली, प्रत्येकीवर कमी खर्च. तुम्हाला भरपूर अनुभव हवे असतात. हॉस्टेल आणि रस्त्यावरचे खाणे तुम्हाला घाबरवत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak percutian, kurang belanja setiap kali. Anda mahukan pengalaman yang banyak. Hostel dan makanan tepi jalan tidak menakutkan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar vjaġġi, inqas għal kull vjaġġ. Trid ħafna esperjenzi. Hostels u street food ma jbeżżgħukx."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခရီးများများ၊ တစ်ခရီးချင်း နည်းနည်း သုံး။ အတွေ့အကြုံ များများ လိုချင်တယ်။ ဟော်စတယ်နဲ့ လမ်းဘေးစာက သင့်ကို မကြောက်စေဘူး။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere turer, mindre per tur. Du vil ha mange opplevelser. Hostel og gatemat skremmer deg ikke."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धेरै यात्रा, प्रति यात्रा कम खर्च। तपाईं धेरै अनुभव चाहनुहुन्छ। होस्टेल र सडकको खानाले तपाईंलाई डर लाग्दैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer reizen, minder per reis. Je wilt zo veel mogelijk beleven. Hostels en streetfood schrikken je niet af."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maulendo ambiri, ndalama zochepa pa ulendo uliwonse. Mumafuna zochitika zambiri. Malo ogona otsika mtengo ndi chakudya cha m'misewu sizimakuopsani."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imala baay'ee, imala tokkoof baasii xiqqaa. Muuxannoo baay'ee barbaadda. Hosteelii fi nyaanni daandii si hin sodaachisu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଧିକ ଯାତ୍ରା, ପ୍ରତି ଯାତ୍ରାରେ କମ୍ ଖର୍ଚ୍ଚ। ଆପଣ ଅନେକ ଅନୁଭୂତି ଚାହାଁନ୍ତି। ହଷ୍ଟେଲ୍ ଓ ରାସ୍ତାକଡ଼ ଖାଦ୍ୟ ଆପଣଙ୍କୁ ଡରାଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਧ ਯਾਤਰਾਵਾਂ, ਹਰ ਯਾਤਰਾ ਉੱਤੇ ਘੱਟ ਖ਼ਰਚ। ਤੁਸੀਂ ਵੱਧ ਤੋਂ ਵੱਧ ਤਜਰਬੇ ਚਾਹੁੰਦੇ ਹੋ। ਹੋਸਟਲਾਂ ਅਤੇ ਸਟ੍ਰੀਟ ਫ਼ੂਡ ਤੋਂ ਤੁਹਾਨੂੰ ਡਰ ਨਹੀਂ ਲੱਗਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej wyjazdów, mniej na każdy. Chcesz jak najwięcej przeżyć. Hostele i jedzenie z ulicy cię nie straszą."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ډېر سفرونه، په هر سفر لږ لګښت. تاسو د تجربو شمېر غواړئ. هاسټلونه او د سړک خواړه مو نه ډاروي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais viagens, menos por viagem. Você quer quantidade de experiências. Hostel e comida de rua não assustam você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais viagens, menos por viagem. Queres quantidade de experiências. Hostels e comida de rua não te assustam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai multe călătorii, mai puțini bani pe fiecare. Vrei cât mai multe experiențe. Hostelurile și mâncarea de stradă nu te sperie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше поездок, меньше трат на каждую. Тебе важно количество впечатлений. Хостелы и уличная еда тебя не пугают."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingendo nyinshi, amafaranga make kuri buri rugendo. Ushaka kwibonera byinshi. Amacumbi y'igiciro gito n'ibiryo byo ku muhanda ntibigutera ubwoba."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වැඩි ගමන්, එක ගමනකට අඩුවෙන්. ඔබට ඕනේ ගොඩක් අත්දැකීම්. හොස්ටල් සහ වීදි කෑම ඔබව බය කරන්නේ නැහැ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viac ciest, menej za každú. Chceš čo najviac zážitkov. Hostely a pouličné jedlo ťa nevystrašia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Več potovanj, manj na potovanje. Želiš čim več doživetij. Hostli in ulična hrana te ne plašijo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nzendo dzakawanda, mari shoma parwendo rumwe nerumwe. Unoda zviitiko zvakawanda. Mahositera nechikafu chemumugwagwa hazvikutyisi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safarro badan, kharash yar safar kasta. Waxaad rabtaa waayo-aragnimo badan. Hoyga dhallinyarada iyo cuntada waddadu kuma cabsiiyaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më shumë udhëtime, më pak për secilin. Do sa më shumë përvoja. Hostelet dhe ushqimi i rrugës nuk të trembin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Више путовања, мање по путовању. Желиш што више доживљаја. Хостели и улична храна те не плаше."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkung seueur lalampahan, langkung sakedik biaya per lalampahan. Anjeun hoyong pangalaman anu seueur. Hostel sareng jajanan sisi jalan teu matak sieun pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler resor, mindre per resa. Du vill ha många upplevelser. Vandrarhem och gatumat skrämmer dig inte."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari nyingi zaidi, gharama ndogo kwa kila moja. Unataka uzoefu mwingi. Hosteli na vyakula vya mitaani havikutishi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிகப் பயணங்கள், ஒவ்வொன்றுக்கும் குறைவான செலவு. அனுபவங்களின் எண்ணிக்கையே உங்களுக்கு முக்கியம். விடுதிகளும் தெருவோர உணவும் உங்களைப் பயமுறுத்தாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎక్కువ ట్రిప్‌లు, ఒక్కోదానికి తక్కువ ఖర్చు. మీకు అనుభవాల సంఖ్య ముఖ్యం. హాస్టళ్లు, వీధి ఆహారం మిమ్మల్ని భయపెట్టవు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сафарҳои бештар, харҷи камтар барои ҳар кадом. Ту ҳаҷми таассуротро мехоҳӣ. Хобгоҳҳо ва таоми кӯчагӣ туро наметарсонанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เที่ยวบ่อยขึ้น จ่ายต่อทริปน้อยลง คุณอยากได้ประสบการณ์เยอะๆ โฮสเทลและสตรีทฟู้ดไม่ทำให้คุณหวั่น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዙሕ መገሻ፣ ውሑድ ወጻኢ ኣብ ነፍሲ ወከፍ። ብዙሕ ተሞክሮ ትደልዩ። ሆስተላትን መግቢ ጎደናን ኣየፍርሑኹምን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has köp syýahat, her birine az pul. Saňa köp täsir gerek. Arzan myhmanhanalar we köçe nahary seni gorkuzmaýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha çok gezi, gezi başına daha az harcama. Bol deneyim istiyorsun. Hosteller ve sokak yemekleri seni korkutmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше подорожей, менше витрат на кожну. Тобі важлива кількість вражень. Хостели й вулична їжа тебе не лякають."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیادہ سفر، ہر سفر پر کم خرچ۔ آپ کو زیادہ سے زیادہ تجربات چاہئیں۔ ہاسٹل اور سڑک کنارے کا کھانا آپ کو نہیں ڈراتے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koʻproq sayohat, har biriga kamroq pul. Sizga taassurotlar soni muhim. Xostellar va koʻcha taomlari sizni qoʻrqitmaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi nhiều chuyến, mỗi chuyến chi ít. Bạn muốn thật nhiều trải nghiệm. Hostel và đồ ăn đường phố chẳng làm khó được bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhambo oluninzi, imali encinci kuhambo ngalunye. Ufuna amava amaninzi. Iihostele nokutya kwasesitratweni azikoyikisi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn-àjò púpọ̀, owó díẹ̀ fún ọ̀kọ̀ọ̀kan. Ẹ fẹ́ ọ̀pọ̀ ìrírí. Ilé àlejò olówó pọ́ọ́kú àti oúnjẹ òpópónà kò dẹ́rù bà yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多去幾次，每次少花一點。你追求體驗的數量。青年旅舍和街頭小食都嚇不倒你。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多去几趟，每趟少花点。你追求体验的数量。青旅和路边摊吓不倒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多去幾趟，每趟少花一點。你追求體驗的數量，青年旅館和路邊小吃都嚇不倒你。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhambo oluningi, okuncane ohambweni ngalunye. Ufuna okuhlangenwe nakho okuningi. Amahostela nokudla kwasemgwaqweni akukwesabisi."
          }
        }
      }
