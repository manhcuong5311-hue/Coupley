    "Attentiveness is your love language. You prove you've been listening by acting on small details — that's quietly powerful." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانتباه هو لغة حبكم. تُثبتون أنكم كنتم تُصغون بالتصرف بناءً على التفاصيل الصغيرة، وفي ذلك قوة هادئة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvým jazykem lásky je pozornost. Že posloucháš, dokazuješ tím, že reaguješ na drobnosti – a to má tichou sílu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmærksomhed er dit kærlighedssprog. Du beviser, at du har lyttet, ved at handle på de små detaljer – det er stille, men stærkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufmerksamkeit ist deine Liebessprache. Du beweist, dass du zugehört hast, indem du auf kleine Details eingehst – leise, aber kraftvoll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσοχή είναι η γλώσσα αγάπης σου. Αποδεικνύεις ότι άκουγες κάνοντας πράξη τις μικρές λεπτομέρειες — κι αυτό έχει μια ήσυχη δύναμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La atención al detalle es tu lenguaje del amor. Demuestras que escuchas cuidando los pequeños detalles, y eso tiene una fuerza silenciosa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkkaavaisuus on rakkauden kielesi. Todistat kuunnelleesi toimimalla pienten yksityiskohtien pohjalta – se on hiljaisen voimakasta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagiging maasikaso ang love language mo. Pinapatunayan mong nakikinig ka sa pagkilos batay sa maliliit na detalye — tahimik pero makapangyarihan iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attention aux détails est ton langage de l'amour. Tu prouves que tu as écouté en agissant sur de petites choses : c'est discret, mais puissant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשומת לב היא שפת האהבה שלך. ההוכחה שהקשבת היא הפרטים הקטנים שזכרת ועשית איתם משהו — ויש בזה עוצמה שקטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान देना आपकी प्रेम की भाषा है। छोटी-छोटी बातों पर अमल करके आप साबित करते हैं कि आप सुन रहे थे — यह चुपचाप बहुत असर करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A figyelmesség a szeretetnyelved. Az apró részletekre reagálva bizonyítod, hogy odafigyeltél – ez csendes, de nagy erő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatian pada detail adalah bahasa cintamu. Kamu membuktikan bahwa kamu mendengarkan lewat hal-hal kecil — diam-diam sangat bermakna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attenzione è il tuo linguaggio dell’amore. Dimostri di aver ascoltato attraverso i piccoli dettagli — ed è una forza silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気づかいがあなたの愛の言語です。小さなことを行動に移して、ちゃんと聞いていたことを示す。静かだけれど力強い表現です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세심함이 나의 사랑의 언어예요. 작은 디테일을 행동으로 옮기며 잘 듣고 있었다는 걸 보여 주죠. 조용하지만 강력해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keprihatinan ialah bahasa cinta anda. Anda membuktikan anda mendengar dengan bertindak atas butiran kecil — kesannya halus tetapi mendalam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppmerksomhet er kjærlighetsspråket ditt. Du viser at du har lyttet ved å følge opp små detaljer – det er stille, men kraftfullt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplettendheid is jouw liefdestaal. Je laat zien dat je hebt geluisterd door iets met kleine details te doen – en dat is stilletjes krachtig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uważność to twój język miłości. Udowadniasz, że słuchasz, reagując na drobne szczegóły – to ma cichą moc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenção aos detalhes é sua linguagem do amor. Você prova que estava ouvindo nos pequenos gestos — e isso tem uma força silenciosa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenția la detalii e limbajul tău al iubirii. Dovedești că ai ascultat prin felul în care ții cont de micile detalii — și asta are o putere discretă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимательность — твой язык любви. Ты доказываешь, что слушаешь, через маленькие детали — и это тихо, но сильно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhördhet är ditt kärleksspråk. Du visar att du har lyssnat genom att agera på små detaljer – det är stillsamt kraftfullt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความช่างสังเกตคือภาษารักของคุณ คุณพิสูจน์ว่าตั้งใจฟังด้วยการลงมือทำจากรายละเอียดเล็กๆ ซึ่งทรงพลังอย่างเงียบๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin sevgi dilin dikkat. Küçük ayrıntılara göre davranarak dinlediğini kanıtlıyorsun; bu sessiz ama çok güçlü bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уважність — твоя мова кохання. Ти показуєш, що слухаєш, через увагу до дрібниць — і в цьому тиха сила."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự tinh ý là ngôn ngữ tình yêu của bạn. Bạn chứng minh mình đã lắng nghe bằng cách hành động theo những chi tiết nhỏ — lặng lẽ mà mạnh mẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细心就是你的爱的语言。你用小细节上的行动证明自己一直在听——安静却很有力量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細心就是你的愛之語。你用行動回應小細節，證明你一直有在聽，這份力量安靜卻強大。"
          }
        }
      }
    },
    "Audio learner and story lover. You absorb ideas while doing other things. Probably has great recommendations." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلّم بالاستماع وحب للحكايات. استيعاب للأفكار في أثناء الانشغال بأشياء أخرى، وعلى الأرجح لديك ترشيحات رائعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učíš se poslechem a miluješ příběhy. Myšlenky nasáváš, i když děláš něco jiného. Nejspíš máš skvělé tipy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer gennem ørerne og elsker historier. Du suger idéer til dig, mens du laver andet. Du har sikkert gode anbefalinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst übers Hören und liebst Geschichten. Du nimmst Ideen nebenbei auf. Bestimmt hast du tolle Empfehlungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνεις ακούγοντας και λατρεύεις τις ιστορίες. Απορροφάς ιδέες ενώ κάνεις άλλα πράγματα. Μάλλον έχεις φοβερές προτάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes escuchando y te encantan las historias. Absorbes ideas mientras haces otras cosas. Seguro que tienes recomendaciones geniales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntelemalla oppiva tarinoiden ystävä. Imet ideoita samalla kun teet muuta. Sinulla on varmasti loistavia suosituksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahilig makinig at mahilig sa kuwento. Natututo ka habang gumagawa ng ibang bagay. Malamang marami kang magandang rekomendasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apprends à l'oreille et tu adores les histoires. Tu absorbes des idées en faisant autre chose. Tu as sûrement d'excellentes recommandations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למידה דרך האוזן ואהבה לסיפורים. רעיונות נקלטים אצלך תוך כדי דברים אחרים. כנראה יש לך המלצות מעולות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनकर सीखना और कहानियों से प्यार। दूसरे काम करते हुए भी नए विचार आपके अंदर उतर जाते हैं। आपके पास शायद बढ़िया सुझाव भी होंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllel tanulsz, és imádod a történeteket. Más dolgok közben szívod magadba az ötleteket. Valószínűleg remek ajánlásaid vannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belajar lewat audio dan suka cerita. Kamu menyerap ide sambil melakukan hal lain. Kamu mungkin punya banyak rekomendasi bagus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari ascoltando e ami le storie. Assorbi idee mentre fai altro. Probabilmente hai ottimi consigli da dare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳で学ぶ、物語好きな人です。ほかのことをしながらアイデアを吸収しています。きっとおすすめもたくさん持っているはず。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀로 배우고 이야기를 사랑하는 사람이에요. 다른 일을 하면서도 생각을 흡수하죠. 추천할 만한 것도 아마 많을 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belajar melalui pendengaran dan suka cerita. Anda menyerap idea sambil melakukan perkara lain. Mungkin ada banyak cadangan menarik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer med ørene og elsker historier. Du tar inn ideer mens du gjør andre ting. Du har sikkert gode tips."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je leert via je oren en houdt van verhalen. Je neemt ideeën op terwijl je andere dingen doet. Je hebt vast goede tips."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczysz się przez słuchanie i kochasz historie. Chłoniesz idee, robiąc inne rzeczy. Pewnie masz sporo świetnych rzeczy do polecenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende ouvindo e ama histórias. Você absorve ideias enquanto faz outras coisas. Deve ter ótimas indicações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înveți ascultând și iubești poveștile. Absorbi idei în timp ce faci altceva. Probabil ai recomandări grozave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты воспринимаешь на слух и любишь истории. Впитываешь идеи, пока занимаешься другими делами. Наверняка у тебя есть отличные рекомендации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lär dig genom att lyssna och älskar berättelser. Du tar in idéer medan du gör annat. Du har nog grymma tips."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียนรู้ผ่านการฟังและรักการฟังเรื่องราว คุณซึมซับไอเดียไปพร้อมกับทำอย่างอื่น และน่าจะมีของดีมาแนะนำเพียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinleyerek öğreniyor ve hikâyeleri seviyorsun. Başka şeyler yaparken fikirleri özümsüyorsun. Muhtemelen harika önerilerin vardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сприйняття на слух і любов до історій. Ти вбираєш ідеї, займаючись іншими справами. У тебе, мабуть, чудові рекомендації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học qua tai và mê những câu chuyện. Bạn tiếp thu ý tưởng trong lúc làm việc khác. Chắc bạn có cả kho gợi ý hay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是听觉型学习者，也爱听故事。你能边做别的事边吸收想法，手里大概有不少好推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你喜歡用聽的學習，也熱愛故事。你會一邊做事一邊吸收想法，大概有很多好東西可以推薦。"
          }
        }
      }
    },
