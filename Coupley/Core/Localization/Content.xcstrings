        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy diso na ny iray na ny iray amin'ireo fomba roa tafahoatra — fa ny fahafantarana ny toeranao dia manampy anareo hikarakara amin'ny maha-ekipa."
