        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pèsonalite nan anviwònman ou. Yon ansyen depo, yon bato, yon kabàn lwen tout bagay — ou vle espas la di yon bagay sou ou."
