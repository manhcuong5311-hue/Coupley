        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Աճը՝ գործողության մեջ։ Դու գտել ես այն, ինչ չես ուզում փոխանցել, և աշխատում ես դրա վրա։ Դա շատ կարևոր է։"
