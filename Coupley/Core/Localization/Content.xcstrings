        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঁচাকৈয়ে নমনীয়। আপুনি হয়তো বন্ধত মনোমালিন্যৰ কাৰণ নহয় — আপুনিয়েই সেয়া মসৃণ কৰি দিয়া জন।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həqiqətən çeviksən. Yəqin ki, tətildə gərginlik yaratmazsan — onu yumşaldan elə sən olursan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапраўдная гнуткасць. Ты наўрад ці станеш прычынай спрэчак на адпачынку — хутчэй, ты іх згладжваеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наистина гъвкаво. Едва ли ще създадеш търкания на почивка – по-скоро ти ги изглаждаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সত্যিই নমনীয়। ছুটিতে তুমি হয়তো খিটিমিটি বাধাবে না — বরং তুমিই সেটা মিটিয়ে দাও।"
