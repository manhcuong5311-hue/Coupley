    "No judgment — where you are with this affects your energy, mood, and schedules." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا أحكام، فموقفكم من هذا يؤثر في طاقتكم ومزاجكم ومواعيدكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez souzení – tvůj vztah k tomu ovlivňuje energii, náladu i rozvrh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi dømmer ikke – hvor du står med det her, påvirker din energi, dit humør og jeres planer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Bewertung – wo du hier stehst, beeinflusst deine Energie, Stimmung und euren Zeitplan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς κριτική — το πού βρίσκεσαι επηρεάζει την ενέργεια, τη διάθεση και τα προγράμματά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin juicios: tu relación con esto afecta a tu energía, tu ánimo y tus horarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei arvostelua – tilanteesi tässä vaikuttaa energiaasi, mielialaasi ja aikatauluihisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang husgahan — naaapektuhan ng kalagayan mo rito ang enerhiya, mood, at schedule mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun jugement : ton rapport au sport influe sur ton énergie, ton humeur et vos emplois du temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי שיפוטיות — איפה שזה עומד אצלך משפיע על האנרגיה, על מצב הרוח ועל הלו״ז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
