        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwọ̀ntúnwọ̀nsì. Ẹ kò fẹ́ máa ṣọ́ ọ, ṣùgbọ́n ẹ máa ń kíyè sí i nígbà tí ẹnìkan bá wà níbẹ̀ ní ìdajì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講求平衡。你不想管東管西，但有人心不在焉時你會察覺。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讲究平衡。你不想管着对方，但能察觉到对方心不在焉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講求平衡。你不想管東管西，但有人心不在焉時你會察覺。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukulinganisela. Awufuni ukukuqapha, kodwa uyabona uma othile ekhona ngengxenye nje."
