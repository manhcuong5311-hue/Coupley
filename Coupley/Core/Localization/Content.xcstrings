    "Balanced. You have professional pride without losing yourself in it. You're probably easy to be in a relationship with around this." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توازن. اعتزاز مهني من دون الذوبان فيه، وهذا يجعل العلاقة معك سهلة في هذا الجانب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyváženě. Máš profesní hrdost, ale neztrácíš se v ní. V tomhle s tebou nejspíš bude snadné žít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbalanceret. Du har faglig stolthed uden at miste dig selv i den. Du er nok nem at være i et forhold med på det punkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewogen. Du bist stolz auf deine Arbeit, ohne dich darin zu verlieren. In diesem Punkt ist es mit dir in einer Beziehung wahrscheinlich ganz unkompliziert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισορροπία. Έχεις επαγγελματική περηφάνια χωρίς να χάνεσαι σε αυτή. Σε αυτό το θέμα, μάλλον είναι εύκολο να είναι κανείς σε σχέση μαζί σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio. Tienes orgullo profesional sin perderte en él. Seguramente, en este tema, es fácil tener una relación contigo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
