    "Identity beyond retirement. You won't stop — you'll just redirect. Purpose keeps people young." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteit ná aftrede. Jy sal nie stop nie – jy sal net van koers verander. Doelgerigtheid hou mense jonk."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከጡረታ ባሻገር ያለ ማንነት። አያቆሙም — አቅጣጫ ብቻ ይቀይራሉ። ዓላማ ሰዎችን ወጣት ያደርጋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هوية تتجاوز التقاعد. لا توقف، بل تغيير في الاتجاه. والمعنى يُبقي الناس شبابًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অৱসৰৰ পিছতো নিজৰ পৰিচয়। আপুনি ৰৈ নাযায় — মাথোঁ দিশ সলনি কৰে। উদ্দেশ্যই মানুহক যুৱক কৰি ৰাখে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təqaüddən kənar kimlik. Dayanmayacaqsan — sadəcə istiqamətini dəyişəcəksən. Məqsəd insanı cavan saxlayır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты — больш, чым пенсія. Ты не спынішся — проста зменіш кірунак. Сэнс трымае людзей маладымі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентичност отвъд пенсията. Няма да спреш – просто ще смениш посоката. Смисълът държи хората млади."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবসরের পরেও নিজের পরিচয়। তুমি থামবে না — শুধু দিক বদলাবে। জীবনের উদ্দেশ্য মানুষকে তরুণ রাখে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitet i nakon penzije. Nećeš stati – samo ćeš promijeniti smjer. Smisao drži ljude mladima."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una identitat més enllà de la jubilació. No t'aturaràs — només canviaràs de rumb. Tenir un propòsit manté la gent jove."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identita i po důchodu. Nezastavíš se – jen změníš směr. Smysl udržuje lidi mladé."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunaniaeth y tu hwnt i ymddeol. Fyddi di ddim yn stopio — dim ond newid cyfeiriad. Mae pwrpas yn cadw pobl yn ifanc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En identitet ud over pensionen. Du stopper ikke – du skifter bare retning. Mening holder folk unge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identität über den Ruhestand hinaus. Du hörst nicht auf – du setzt nur neue Schwerpunkte. Ein Sinn hält jung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταυτότητα πέρα από τη σύνταξη. Δεν θα σταματήσεις — απλώς θα αλλάξεις κατεύθυνση. Ο σκοπός κρατάει τους ανθρώπους νέους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una identidad más allá de la jubilación. No vas a parar — solo cambiarás de rumbo. Tener un propósito mantiene joven."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteet ka pärast pensioni. Sa ei peatu — lihtsalt suunad end ümber. Eesmärk hoiab inimesi noorena."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nortasuna erretirotik haratago. Ez zara geldituko: norabidea aldatu besterik ez. Helburu batek gazte mantentzen du jendea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هویتی فراتر از بازنشستگی. دست نمی‌کشی — فقط مسیرت را عوض می‌کنی. هدف داشتن آدم را جوان نگه می‌دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteetti eläkkeen jälkeenkin. Et pysähdy – suuntaat vain uudelleen. Merkityksellinen tekeminen pitää nuorena."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkataong lampas sa retirement. Hindi ka titigil — iibahin mo lang ang direksyon. Pinapanatiling bata ng layunin ang tao."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une identité au-delà de la retraite. Tu ne t'arrêteras pas — tu changeras juste de cap. Avoir un but, ça garde jeune."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Féiniúlacht thar an scor. Ní stopfaidh tú — athróidh tú treo. Coinníonn cuspóir óg daoine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha identidade máis alá da xubilación. Non vas parar, só cambiar de rumbo. Ter un propósito mantén a xente nova."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિવૃત્તિ પછી પણ ઓળખ. તમે અટકશો નહીં — બસ દિશા બદલશો. હેતુ લોકોને યુવાન રાખે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainihi bayan ritaya. Ba za ku tsaya ba — za ku dai sauya hanya. Manufa na sa mutane su zauna matasa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זהות שמעבר לפרישה. אין לך כוונה לעצור — רק לשנות כיוון. תכלית שומרת על אנשים צעירים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिटायरमेंट के बाद भी अपनी पहचान। रुकना नहीं — बस दिशा बदलना। मक़सद लोगों को जवान रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitet i nakon mirovine. Nećeš stati – samo ćeš promijeniti smjer. Svrha održava ljude mladima."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon idantite pi lwen pase retrèt. Ou p ap kanpe — w ap jis chanje direksyon. Lè ou gen yon rezon pou viv, ou rete jèn."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitás a nyugdíjon túl. Nem állsz meg – csak irányt váltasz. A céltudat fiatalon tart."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ինքնություն թոշակից անդին։ Դու կանգ չես առնի, պարզապես ուղղությունը կփոխես։ Նպատակը մարդկանց երիտասարդ է պահում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitasmu nggak berhenti di masa pensiun. Kamu nggak akan berhenti — hanya mengubah arah. Punya tujuan membuat orang tetap muda."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onye ị bụ karịa ezumike nka. Ị gaghị akwụsị — ị ga-agbanwe naanị ụzọ. Ebumnuche na-eme ka ndị mmadụ nọgide na-eto eto."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjálfsmynd sem nær út fyrir starfslok. Þú hættir ekki – þú breytir bara um stefnu. Tilgangur heldur fólki ungu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’identità oltre la pensione. Non ti fermerai — cambierai solo direzione. Avere uno scopo mantiene giovani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引退しても自分らしさは変わりません。止まるのではなく、向きを変えるだけ。生きがいは人を若く保ちます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jati dhiri ngluwihi pensiun. Panjenengan ora bakal mandheg — mung ganti arah. Tujuan urip nggawe wong tetep enom."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი ვინაობა პენსიის მიღმაც. არ გაჩერდები — უბრალოდ, მიმართულებას შეცვლი. მიზანი ადამიანებს ახალგაზრდობას უნარჩუნებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зейнеттен тыс тұлға. Сен тоқтамайсың, тек бағытыңды өзгертесің. Мақсат адамды жас ұстайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អត្តសញ្ញាណលើសពីការចូលនិវត្តន៍។ អ្នកនឹងមិនឈប់ទេ — គ្រាន់តែប្ដូរទិសដៅ។ គោលបំណងធ្វើឲ្យមនុស្សនៅក្មេងជានិច្ច។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿವೃತ್ತಿಯ ಆಚೆಗೂ ನಿಮ್ಮ ಗುರುತು. ನೀವು ನಿಲ್ಲುವುದಿಲ್ಲ — ದಿಕ್ಕು ಬದಲಿಸುತ್ತೀರಿ ಅಷ್ಟೇ. ಉದ್ದೇಶವು ಜನರನ್ನು ಚಿರಯುವಕರನ್ನಾಗಿಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "은퇴 이후에도 이어지는 정체성이에요. 멈추지 않고 방향만 바꿀 거예요. 목적이 있으면 사람은 젊게 살아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasname ji teqawîtiyê wêdetir. Tu ranawestî — tenê rêya xwe diguherînî. Armanc mirovan ciwan dihêle."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пенсиядан тышкаркы инсандык. Токтобойсуң — жөн гана багытыңды өзгөртөсүң. Максат адамды жаш кармайт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitéit iwwer d'Pensioun eraus. Du héiers net op — du setz deng Energie just anescht an. E Sënn hält jonk."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຕົວຕົນທີ່ບໍ່ສິ້ນສຸດພຽງການບຳນານ ເຈົ້າຈະບໍ່ຢຸດ — ພຽງແຕ່ປ່ຽນທິດທາງ ການມີເປົ້າໝາຍໃນຊີວິດເຮັດໃຫ້ຄົນໜຸ່ມສະເໝີ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapatybė ir po pensijos. Nesustosi – tik pakeisi kryptį. Prasmė žmones palaiko jaunus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitāte ārpus pensijas. Tu neapstāsies – tikai mainīsi virzienu. Mērķis uztur cilvēkus jaunus."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maha-izy anao mihoatra ny fisotroan-dronono. Tsy hijanona ianao — hanova lalana fotsiny. Ny tanjona no mitazona ny olona ho tanora."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tuakiri i tua atu i te reti. Kāore koe e mutu — ka huri kē noa koe. Mā te whāinga e taiohi tonu ai te tangata."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентитет и по пензијата. Нема да застанеш — само ќе се пренасочиш. Целта ги одржува луѓето млади."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിരമിക്കലിനപ്പുറവും സ്വന്തം വ്യക്തിത്വം. നിങ്ങൾ നിർത്തില്ല — ദിശ മാറ്റുകയേയുള്ളൂ. ലക്ഷ്യബോധം ആളുകളെ ചെറുപ്പമാക്കി നിർത്തും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэтгэврээс цаашх өөрийн мөн чанар. Чи зогсохгүй — зүгээр чиглэлээ өөрчилнө. Зорилго хүнийг залуу байлгадаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निवृत्तीपलीकडची ओळख. तुम्ही थांबणार नाही — फक्त दिशा बदलाल. ध्येय माणसाला तरुण ठेवते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiti melangkaui persaraan. Anda takkan berhenti — cuma ubah haluan. Tujuan hidup membuatkan orang kekal muda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identità lil hinn mill-irtirar. Mhux se tieqaf — sempliċement tibdel id-direzzjoni. L-iskop iżomm lin-nies żgħażagħ."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အငြိမ်းစားယူပြီးနောက်လည်း ကိုယ်ပိုင်ဝိသေသ ရှိနေမယ်။ သင် ရပ်မှာ မဟုတ်ဘူး — လမ်းကြောင်းပဲ ပြောင်းမှာပါ။ ရည်ရွယ်ချက်က လူကို နုပျိုစေတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitet utover pensjonen. Du stopper ikke – du bare endrer retning. Mening holder folk unge."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अवकाशभन्दा पर पनि पहिचान। तपाईं रोकिनुहुन्न — बस दिशा बदल्नुहुन्छ। उद्देश्यले मान्छेलाई जवान राख्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je identiteit houdt niet op bij je pensioen. Je stopt niet – je verlegt alleen je koers. Een doel houdt mensen jong."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudzidziwa kupitirira kupuma pantchito. Simudzaima — mudzangosintha njira. Cholinga chimasunga anthu kukhala achinyamata."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenyummaa soorama booda. Hin dhaabattu — kallattii qofa jijjiirta. Kaayyoon namoota dargaggeessa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅବସର ପରେ ବି ନିଜର ପରିଚୟ। ଆପଣ ଅଟକିବେ ନାହିଁ — କେବଳ ଦିଗ ବଦଳାଇବେ। ଜୀବନର ଉଦ୍ଦେଶ୍ୟ ଲୋକଙ୍କୁ ଯୁବା ରଖେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰਿਟਾਇਰਮੈਂਟ ਤੋਂ ਪਰੇ ਪਛਾਣ। ਤੁਸੀਂ ਰੁਕੋਗੇ ਨਹੀਂ — ਬੱਸ ਰਾਹ ਬਦਲੋਗੇ। ਮਕਸਦ ਇਨਸਾਨ ਨੂੰ ਜਵਾਨ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tożsamość poza emeryturą. Nie przestaniesz – tylko zmienisz kierunek. Poczucie sensu odmładza."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له تقاعد هاخوا هویت. تاسو نه درېږئ — یوازې لار بدلوئ. موخه خلک ځوان ساتي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identidade além da aposentadoria. Você não vai parar — só mudar de rumo. Ter propósito mantém a gente jovem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identidade para lá da reforma. Não vais parar — vais só mudar de rumo. Ter um propósito mantém as pessoas jovens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitate dincolo de pensie. Nu te vei opri — doar îți vei schimba direcția. Un scop îi ține pe oameni tineri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты остаёшься собой и после пенсии. Ты не остановишься, а просто сменишь направление. Цель в жизни сохраняет молодость."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwo uri we ntarangirana n'izabukuru. Ntuzahagarara — uzahindura icyerekezo gusa. Kugira intego bituma abantu baguma bato."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "විශ්‍රාමයෙන් ඔබ්බට අනන්‍යතාවක්. ඔබ නවතින්නේ නැහැ — දිශාව වෙනස් කරනවා විතරයි. අරමුණක් මිනිසුන්ව තරුණව තියනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identita aj po dôchodku. Nezastavíš sa – len zmeníš smer. Zmysel udržiava ľudí mladých."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteta onkraj upokojitve. Ustavljanje ni zate – le smer spremeniš. Smisel ohranja ljudi mlade."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunhu hunopfuura kurega basa. Haumbomira — unongochinja nzira. Chinangwa chinochengeta vanhu vachiri vadiki."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqoonsi ka baxsan hawlgabka. Ma joogsan doontid — jihada ayaad uun beddeli doontaa. Ujeeddadu dadka way dhallinyarisaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitet edhe pas pensionit. Nuk do të ndalesh – thjesht do të ndryshosh drejtim. Qëllimi i mban njerëzit të rinj."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентитет после пензије. Нећеш стати — само ћеш променити правац. Сврха чува младост."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jati diri saluareun pangsiun. Anjeun moal eureun, ngan ngarobah arah. Tujuan hirup ngajantenkeun jalma tetep ngora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En identitet bortom pensionen. Du kommer inte att sluta – bara byta riktning. Mening håller människor unga."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utambulisho zaidi ya kustaafu. Hutasimama — utabadili tu mwelekeo. Kusudi huwafanya watu kubaki vijana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஓய்வுக்கு அப்பாலும் அடையாளம். நீங்கள் நிற்க மாட்டீர்கள் — திசையை மட்டும் மாற்றுவீர்கள். நோக்கம் மனிதர்களை இளமையாக வைத்திருக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రిటైర్మెంట్ తర్వాతా మీ గుర్తింపు. మీరు ఆగరు — దిశ మార్చుకుంటారు అంతే. ఒక లక్ష్యం మనుషులను యవ్వనంగా ఉంచుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шахсият берун аз нафақа. Ту бас намекунӣ — танҳо самтро иваз мекунӣ. Ҳадаф одамонро ҷавон нигоҳ медорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวตนที่อยู่เหนือการเกษียณ คุณจะไม่หยุด แค่เปลี่ยนทิศทาง การมีเป้าหมายทำให้คนยังหนุ่มสาวเสมอ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መንነት ካብ ጡረታ ንላዕሊ። ደው ኣይክትብሉን — ኣንፈትኩም ጥራይ ክትቕይሩ ኢኹም። ዕላማ ንሰባት መንእሰያት ይገብሮም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensiýadan soň hem öz keşbiň. Durmarsyň — diňe ugruňy üýtgedersiň. Maksat adamlary ýaş saklaýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emeklilikten öte bir kimlik. Durmayacaksın, sadece yön değiştireceksin. Amaç insanı genç tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пенсія не змінить того, хто ти є. Ти не зупинишся — лише зміниш напрямок. Сенс тримає людей молодими."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ریٹائرمنٹ سے آگے کی شناخت۔ آپ کے لیے رکنا نہیں، بس سمت بدلنا ہے۔ مقصد لوگوں کو جوان رکھتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nafaqadan keyin ham oʻzlik. Siz toʻxtamaysiz — shunchaki yoʻnalishni oʻzgartirasiz. Maqsad odamni yosh saqlaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sắc vượt ngoài tuổi hưu. Bạn sẽ không dừng — chỉ đổi hướng. Có mục đích sống giúp con người trẻ mãi."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuwena ngaphaya komhlala-phantsi. Awuyi kuyeka — uya kutshintsha nje icala. Injongo igcina abantu bebatsha."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdánimọ̀ kọjá ìfẹ̀yìntì. Ẹ kò ní dúró — ẹ ó kàn yí ọ̀nà padà. Ète máa ń jẹ́ kí èèyàn ṣì wà ní ọ̀dọ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休以外的身份認同。你不會停下來，只會轉換方向。有目標的人永遠年輕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休之后依然是自己。你不会停下，只会换个方向。有目标的人永远年轻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休後依然保有自我。你不會停下來，只是換個方向。目標感會讓人保持年輕。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuwena ngale komhlalaphansi. Ngeke ume — uzovele ushintshe indlela. Inhloso igcina abantu bebasha."
          }
        }
      }
