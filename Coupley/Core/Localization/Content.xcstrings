    "Mid-range — comfortable but not extravagant" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميزانية متوسطة: راحة دون إسراف"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Středně – pohodlně, ale bez rozhazování"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellemklasse – komfortabelt, men ikke ekstravagant"
          }
        },
        "de" : {
          "stringUnit" : {
