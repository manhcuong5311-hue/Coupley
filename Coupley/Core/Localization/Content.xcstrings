        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಬೆಲೆಯ ವಿಷಯವಲ್ಲ — ನೀವು ಜೊತೆಗಿಲ್ಲದಿದ್ದಾಗಲೂ ಯಾರೋ ನಿಮ್ಮನ್ನು ನೆನೆದರು ಎಂಬುದರ ಪುರಾವೆ ಅದು. ಆ ಕಾಳಜಿಯೇ ಮುಖ್ಯ."
