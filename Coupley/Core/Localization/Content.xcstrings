        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खासगी गोष्टी खासगीच राहायला हव्यात. सगळ्यांसमोर बोल लावणे हा आदराचा मूलभूत भंग वाटतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal peribadi kekal peribadi. Ditegur di depan orang terasa seperti melanggar rasa hormat yang paling asas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-affarijiet privati jibqgħu privati. Kritika fil-pubbliku tidhirlek ksur fundamentali tar-rispett."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ်ရေးကိုယ်တာကိစ္စက ကိုယ်ရေးကိုယ်တာအဖြစ်ပဲ ရှိသင့်တယ်။ လူအများရှေ့မှာ အပြစ်ဖော်ခံရတာက အခြေခံ လေးစားမှုကို ချိုးဖောက်သလို ခံစားရတယ်။"
