        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अच्छे मूड में बने प्लान ज़्यादा टिकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jó hangulatban a tervek könnyebben megvalósulnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mood yang bagus bikin rencana lebih mudah terlaksana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il buon umore è perfetto per fare piani che poi si realizzano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分がいいときに立てた計画は、実現しやすいものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분이 좋을 때 세운 계획은 잘 지켜져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perasaan yang baik membantu rancangan menjadi kenyataan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt humør gjør at planer faktisk blir noe av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een goede bui maak je plannen die blijven hangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobry nastrój sprzyja planom, które naprawdę dochodzą do skutku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bom humor ajuda os planos a saírem do papel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când starea e bună, planurile prind mai ușor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В хорошем настроении планы лучше приживаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gott humör är perfekt för att få planer att bli av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงอารมณ์ดีเหมาะกับการวางแผนที่ทำได้จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İyi bir ruh hali, planların gerçekleşmesi için birebirdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У гарному настрої плани краще приживаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâm trạng tốt là lúc lý tưởng để kế hoạch thành hiện thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情好的时候，订下的计划更容易实现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情好的時候，計畫最容易成真。"
