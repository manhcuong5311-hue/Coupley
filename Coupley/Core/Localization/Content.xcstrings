        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những cử chỉ đẹp nhất luôn mang dấu ấn riêng — câu này cho thấy “riêng” với bạn là gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最打动人的心意总是专属于你的——这能看出“专属”对你意味着什么。"
