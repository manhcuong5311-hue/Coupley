            "value" : "你什么时候觉得自己最有活力？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你什麼時候覺得最有活力？"
          }
        }
      }
    },
    "When energy is gone, relief > reassurance." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين تنفد الطاقة، تخفيف الحمل أنفع من الطمأنة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když dojde energie, úleva > uklidňování."
