        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли руки зайняті, тиха розмова йде сама."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tay bận rộn, những câu chuyện nhẹ nhàng dễ cất lời hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手上有事做的时候，安静的对话更容易打开。"
