        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret schlägt allgemein. „Du bist toll“ verpufft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το συγκεκριμένο νικάει το γενικό. Ένα σκέτο «τα σπας» πέφτει στο κενό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo concreto gana a lo genérico. Un “eres increíble” se queda corto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkreetne > üldine. „Sa oled imeline“ ei jõua kohale."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehatza > orokorra. «Zoragarria zara» esaldiak ez du ezer eragiten."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دقیق بهتر از کلی است. «تو فوق‌العاده‌ای» به دل نمی‌نشیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkka voittaa yleisen. ”Olet mahtava” jää laimeaksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiyak > pangkalahatan. Walang dating ang “ang galing mo.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le précis plutôt que le général. « T'es top », ça tombe à plat."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrach > ginearálta. Ní théann “tá tú iontach” i bhfeidhm."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreto > xenérico. Un «es incrible» queda frouxo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સામાન્ય કરતાં ચોક્કસ સારું. “તમે અદ્ભુત છો” ફિક્કું લાગે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takamaimai > gama-gari. “Kuna da ban mamaki” ba ya tasiri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספציפי > כללי. \"אין כמוך\" לא באמת נוגע."
