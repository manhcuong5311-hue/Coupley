        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, ortaq yeməklərə, bazarlığa və bayırda yeməyə təsir edir — bilmək yaxşıdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ад гэтага залежаць агульныя прыёмы ежы, пакупкі прадуктаў і паходы ў рэстараны — варта ведаць."
          }
