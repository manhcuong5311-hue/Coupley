            "value" : "ឲ្យដៃគូខ្ញុំនាំមុខ — ខ្ញុំអ្វីក៏បាន"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಗಾತಿಯೇ ಮುನ್ನಡೆಸಲಿ — ನನಗೆ ಏನಾದರೂ ಸರಿ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인을 따라갈래요, 저는 다 좋아요"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila hevjînê min rê nîşan bide — ez rehet im"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сүйгөнүм алып барсын — мен баарына макулмун"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mäi Schatz entscheede loossen — ech sinn onkomplizéiert"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໃຫ້ຄູ່ນຳພາ — ຂ້ອຍແນວໃດກໍໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegul vadovauja antroji pusė – man tinka viskas"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauju vadīt otrajai pusei – man der viss"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avelako hitarika ny olon-tiako — mora ahy ny zavatra rehetra"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā tōku hoa aroha e ārahi — he ngāwari au"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нека води половинката — мене ми е сеедно"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പങ്കാളി നയിക്കട്ടെ — എനിക്ക് എന്തും ഓക്കെ"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ханиараа удирдуулъя — би сонголтгүй"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोडीदार ठरवेल — मला काहीही चालेल"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biar pasangan saya yang tentukan — saya ikut sahaja"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inħalli lill-partner tiegħi jmexxi — kollox jgħaddili"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချစ်သူ ဦးဆောင်ပါစေ — ကိုယ်က အဆင်ပြေတယ်"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partneren min får bestemme – jeg er grei"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पार्टनरलाई अगुवाइ गर्न दिन्छु — म सहज छु"
