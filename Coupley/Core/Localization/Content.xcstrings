    "Move your body, side by side. 20 sessions in a month." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّكوا أجسادكم جنبًا إلى جنب. 20 حصة في شهر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hýbejte se bok po boku. 20 tréninků za měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevæg jer side om side. 20 træningspas på en måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt euch Seite an Seite. 20 Einheiten in einem Monat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κινηθείτε δίπλα-δίπλα. 20 προπονήσεις σε έναν μήνα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A moverse, lado a lado. 20 sesiones en un mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikkukaa rinnakkain. 20 treeniä kuukaudessa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igalaw ang katawan nang magkatabi. 20 session sa isang buwan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bougez, côte à côte. 20 séances en un mois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להזיז את הגוף, זה לצד זה. 20 אימונים בחודש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ-साथ पसीना बहाएँ। एक महीने में 20 सेशन।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozogjatok együtt, egymás mellett. 20 edzés egy hónap alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan badan, berdampingan. 20 sesi dalam sebulan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muovetevi fianco a fianco. 20 allenamenti in un mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並んで体を動かそう。1か月で20回。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나란히 몸을 움직여요. 한 달에 20번."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersenam berdua, saling berdampingan. 20 sesi dalam sebulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveg dere, side om side. 20 økter på en måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samen in beweging, zij aan zij. 20 trainingen in een maand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruszajcie się ramię w ramię. 20 treningów w ciągu miesiąca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mexam o corpo lado a lado. 20 treinos em um mês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcare umăr la umăr. 20 de antrenamente într-o lună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигайтесь вместе, бок о бок. 20 тренировок за месяц."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rör på er, sida vid sida. 20 pass på en månad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกกำลังกายเคียงข้างกัน 20 ครั้งในหนึ่งเดือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan yana hareket edin. Bir ayda 20 antrenman."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухайтеся пліч-о-пліч. 20 тренувань за місяць."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng vận động, sát cánh bên nhau. 20 buổi trong một tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并肩动起来，一个月完成20次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並肩動起來，一個月內完成20次。"
