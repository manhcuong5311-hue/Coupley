    "Don't ask what's wrong. Just bring something — water, food, a blanket." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسألوا عمّا به. أحضروا شيئًا فحسب: ماء، طعامًا، غطاءً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neptej se, co se děje. Prostě něco přines – vodu, jídlo, deku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg ikke, hvad der er galt. Kom bare med noget – vand, mad, et tæppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nicht, was los ist. Bring einfach etwas – Wasser, Essen, eine Decke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη ρωτήσεις τι έχει. Απλώς φέρε κάτι — νερό, φαγητό, μια κουβέρτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No preguntes qué pasa. Simplemente llévale algo: agua, comida, una manta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä kysy, mikä on vialla. Tuo vain jotain – vettä, ruokaa, viltin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huwag nang itanong kung ano ang problema. Magdala ka lang ng kahit ano — tubig, pagkain, kumot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne demande pas ce qui ne va pas. Apporte simplement quelque chose : de l'eau, à manger, un plaid."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא לשאול מה קרה. פשוט להביא משהו — מים, אוכל, שמיכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह न पूछें कि क्या हुआ। बस कुछ ले आएँ — पानी, खाना, एक कंबल।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kérdezd, mi a baj. Csak vigyél neki valamit – vizet, ennivalót, egy takarót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan tanya ada apa. Bawakan saja sesuatu — air, makanan, selimut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiedere cosa c’è che non va. Porta qualcosa e basta — acqua, cibo, una coperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「どうしたの？」とは聞かずに、水や食べもの、ブランケットなど何かを持っていきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무슨 일이냐고 묻지 말고, 물이나 먹을 것, 담요 같은 걸 그냥 가져다주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan tanya apa yang tak kena. Bawakan saja sesuatu — air, makanan, selimut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke spør hva som er galt. Bare kom med noe – vann, mat, et pledd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag niet wat er is. Breng gewoon iets – water, eten, een dekentje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pytaj, co się stało. Po prostu coś przynieś – wodę, jedzenie, koc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pergunte o que houve. Só leve algo — água, comida, uma manta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu întreba ce s-a întâmplat. Doar adu ceva — apă, mâncare, o pătură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не спрашивай, что случилось. Просто принеси что-нибудь — воду, еду, плед."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga inte vad som är fel. Kom bara med något – vatten, mat, en filt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องถามว่าเป็นอะไร แค่หยิบอะไรไปให้ เช่น น้ำ ของกิน หรือผ้าห่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin var diye sorma. Sadece bir şey getir: su, yemek, bir battaniye."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не питай, що сталося. Просто принеси щось — воду, їжу, плед."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng hỏi có chuyện gì. Cứ mang đến cho người ấy một thứ gì đó — nước, đồ ăn, một tấm chăn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别问怎么了，直接带点东西过去：一杯水、一点吃的、一条毯子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別問怎麼了，直接帶點東西過去：水、食物、一條毯子。"
          }
        }
      }
    },
