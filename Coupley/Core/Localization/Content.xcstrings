    "Neither extreme is wrong — but knowing where you sit helps you plan as a team." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا خطأ في أيّ من الطرفين، لكن معرفة موقعكم تساعدكما على التخطيط كفريق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani jeden extrém není špatný – ale když víš, kde stojíš, líp plánujete jako tým."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af yderpunkterne er forkerte – men når du ved, hvor du står, er det lettere at planlægge som et team."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Extrem ist falsch – aber wenn du weißt, wo du stehst, könnt ihr besser als Team planen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα άκρο δεν είναι λάθος — αλλά αν ξέρεις πού βρίσκεσαι, μπορείτε να σχεδιάζετε σαν ομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún extremo está mal, pero saber dónde te ubicas ayuda a planificar en equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpikaan ääripää ei ole väärä – mutta kun tiedät, missä kohtaa olet, voitte suunnitella tiiminä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang maling dulo — pero kapag alam mo kung nasaan ka, mas makakapagplano kayo bilang team."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun extrême n'est un problème, mais savoir où tu te situes aide à planifier en équipe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף קצה הוא לא טעות — אבל כשיודעים איפה עומדים, קל יותר לתכנן כצוות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी छोर ग़लत नहीं है — पर यह जानना कि आप कहाँ हैं, एक टीम की तरह प्लान करने में मदद करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyik véglet sem rossz – de ha tudod, hol állsz, csapatként tudtok tervezni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstrem mana pun nggak salah — tapi tahu posisimu membantu kalian merencanakan sebagai tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei due estremi è sbagliato — ma sapere dove ti collochi vi aiuta a pianificare come una squadra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらに偏っていても間違いではありません。自分の立ち位置を知っておくと、チームとして計画を立てやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽도 틀리지 않아요. 내 위치를 알면 한 팀으로 계획을 세우기 쉬워져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua-dua hujung tidak salah — tetapi mengetahui kedudukan anda membantu anda merancang sebagai satu pasukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av ytterpunktene er feil – men når dere vet hvor dere står, er det lettere å planlegge som et lag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen van beide uitersten is fout – maar weten waar je staat helpt jullie als team te plannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna skrajność nie jest zła – ale gdy wiesz, gdzie jesteś na tej skali, łatwiej wam planować jak drużyna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum extremo é errado — mas saber onde você está ajuda vocês a planejar como time."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun extrem nu e greșit — dar dacă știi unde te situezi, puteți plănui ca o echipă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одна крайность не ошибка — но, зная свою позицию, вам проще планировать вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ytterlighet är fel – men att veta var du står hjälper er att planera som ett lag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีขั้วไหนผิด แต่การรู้ว่าคุณอยู่ตรงไหนช่วยให้วางแผนร่วมกันเป็นทีมได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki uç da yanlış değil; ama nerede durduğunu bilmek, ekip olarak plan yapmanıza yardım eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодна крайність не є помилкою — але, знаючи свою позицію, легше планувати як команда."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thái cực nào là sai — nhưng biết mình đứng ở đâu giúp hai bạn lên kế hoạch như một đội."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪种极端都没有错——但知道自己偏向哪一边，能帮你们像队友一样规划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪個極端都沒有錯，但知道自己的位置，能幫你們像團隊一樣規劃。"
          }
        }
      }
    },
