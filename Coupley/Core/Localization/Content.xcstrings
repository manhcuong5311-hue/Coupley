        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την επαφή κλείνεις τον κύκλο της μέρας. Είναι μια όμορφη τελετουργία για τους δυο σας — φρόντισε το ταίρι σου να ξέρει πόσα σημαίνει για σένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión es tu forma de cerrar el día. Es un ritual de pareja precioso: asegúrate de que tu pareja sepa cuánto significa para ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys on tapasi päättää päivä. Tämä on kaunis yhteinen rituaali – varmista, että kumppanisi tietää, kuinka paljon se merkitsee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksyon ang paraan mo para isara ang araw. Napakagandang ritwal ito ng magkapareha — siguraduhing alam ng partner mo kung gaano ito kahalaga sa’yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien, c'est ta façon de boucler la journée. C'est un beau rituel de couple : assure-toi que l'autre sait à quel point il compte pour toi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור הוא הדרך שלך לסגור את היום. זה טקס זוגי יפה — כדאי לוודא שהצד השני יודע כמה הוא חשוב לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुड़ाव से ही आप दिन को पूरा करते हैं। यह एक जोड़े की ख़ूबसूरत रस्म है — पक्का करें कि पार्टनर को पता हो कि यह आपके लिए कितना मायने रखती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad a kapcsolódás zárja le a napot. Ez gyönyörű páros rituálé – gondoskodj róla, hogy a párod tudja, mennyit jelent neked."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan adalah caramu menutup hari. Ini ritual berdua yang indah — pastikan pasanganmu tahu betapa berartinya ini."
