        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انډول او واقعیت. تاسو افراطي نه یاست — له خوړو خوند اخلئ، خو د ځان پاملرنه هم کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio com os pés no chão. Nada de extremos — você gosta de comer, mas também se cuida."
