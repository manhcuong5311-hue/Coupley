        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগৰ জৰিয়তেই আপুনি দিনটো সামৰে। এয়া দুয়োৰে বাবে এক সুন্দৰ অভ্যাস — আপোনাৰ সংগীয়ে জানক যে আপোনাৰ বাবে ইয়াৰ অৰ্থ কিমান।"
