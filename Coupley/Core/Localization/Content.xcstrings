        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציפור לילה שהייתה ישנה טוב יותר עם שעת שינה מוקדמת"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देर रात तक जागने की आदत — जल्दी सोऊँ तो नींद बेहतर हो"
