    "Very close — we talk all the time and see each other often" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قريبون جدًا: نتحدث دائمًا ونلتقي كثيرًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velmi blízko – mluvíme spolu pořád a často se vídáme"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meget tæt – vi snakker hele tiden og ses tit"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr eng – wir reden ständig und sehen uns oft"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ — μιλάμε συνέχεια και βλεπόμαστε συχνά"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucho — hablamos todo el tiempo y nos vemos a menudo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tosi läheinen – juttelemme ja näemme usein"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrang lapit — lagi kaming nag-uusap at madalas magkita"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très proche : on se parle tout le temps et on se voit souvent"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרובים מאוד — מדברים כל הזמן ונפגשים הרבה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत क़रीब — हमेशा बात होती है, अक्सर मिलना होता है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyon közel – folyton beszélünk, és gyakran találkozunk"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat dekat — sering ngobrol dan sering ketemu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strettissimo — ci sentiamo sempre e ci vediamo spesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても仲良し。よく話すし、よく会う"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아주 가까워요, 늘 연락하고 자주 만나요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat rapat — kami selalu berbual dan kerap berjumpa"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldig nært – vi snakkes og ses ofte"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heel close – we spreken en zien elkaar vaak"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo blisko – ciągle rozmawiamy i często się widujemy"
          }
        },
