    "A clear no. Just as valid as a clear yes. Mismatch on this isn't something love usually resolves." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا واضحة، وهي مشروعة تمامًا مثل نعم الواضحة. الاختلاف في هذا الأمر نادرًا ما يحلّه الحب وحده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasné ne. Stejně platné jako jasné ano. Neshodu v tomhle láska obvykle nevyřeší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et klart nej. Lige så gyldigt som et klart ja. Uenighed her er ikke noget, kærlighed plejer at løse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein klares Nein. Genauso berechtigt wie ein klares Ja. Unterschiede in dieser Frage löst Liebe meist nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ξεκάθαρο όχι. Εξίσου θεμιτό με ένα ξεκάθαρο ναι. Μια διαφωνία εδώ δεν είναι κάτι που συνήθως λύνει η αγάπη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un no rotundo. Tan válido como un sí rotundo. Un desacuerdo en esto no suele resolverlo el amor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvä ei. Yhtä oikeutettu kuin selvä kyllä. Erimielisyyttä tästä rakkaus ei yleensä ratkaise."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malinaw na hindi. Kasing-valid ng malinaw na oo. Ang hindi pagkakasundo rito ay hindi karaniwang naaayos ng pagmamahal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un non clair. Tout aussi légitime qu'un oui clair. Un désaccord sur ce point, l'amour ne le résout généralement pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"לא\" חד־משמעי. לגיטימי בדיוק כמו \"כן\" חד־משמעי. על פער בנושא הזה, אהבה בדרך כלל לא מגשרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साफ़ ना। यह भी उतनी ही जायज़ है जितनी साफ़ हाँ। इस पर सोच न मिले, तो प्यार अक्सर इसे सुलझा नहीं पाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyértelmű nem. Ugyanolyan érvényes, mint egy egyértelmű igen. Az ilyen eltérést a szerelem általában nem oldja meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban yang jelas: tidak. Sama sahnya dengan jawaban ya. Perbedaan soal ini biasanya nggak bisa diselesaikan oleh cinta saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un no deciso. Legittimo quanto un sì deciso. Su questo, una divergenza di solito non si risolve con l’amore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はっきりとしたノーです。はっきりとしたイエスと同じくらい尊重されるべき答えです。ここが食い違うと、愛だけで解決するのは難しいことが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분명한 “아니요”예요. 분명한 “예”만큼이나 존중받아야 해요. 이 부분이 어긋나면 사랑만으로 해결되기는 어려워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawapan tidak yang jelas. Sama wajarnya dengan jawapan ya yang jelas. Percanggahan dalam hal ini biasanya bukan sesuatu yang boleh diselesaikan dengan cinta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et klart nei. Like gyldig som et klart ja. Uenighet her er sjelden noe kjærlighet løser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een duidelijk nee. Net zo geldig als een duidelijk ja. Als jullie hier verschillen, lost liefde dat meestal niet op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasne „nie”. Tak samo w porządku jak jasne „tak”. Rozbieżności w tej kwestii miłość zwykle nie rozwiązuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um não claro. Tão válido quanto um sim claro. Divergência nesse ponto não costuma ser algo que o amor resolve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nu clar. La fel de legitim ca un da clar. O nepotrivire aici nu e ceva ce iubirea rezolvă de obicei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твёрдое «нет». Оно так же нормально, как твёрдое «да». Но такое расхождение любовь обычно не исправляет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tydligt nej. Lika legitimt som ett tydligt ja. Att vara oense här är sällan något kärleken löser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชัดเจนว่าไม่ ซึ่งสมเหตุสมผลพอๆ กับการชัดเจนว่าใช่ ถ้าเห็นไม่ตรงกันในเรื่องนี้ ความรักมักแก้ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net bir hayır. Net bir evet kadar geçerli. Bu konudaki uyumsuzluğu aşk genellikle çözmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чітке «ні». Має таке саме право на існування, як і чітке «так». Таку розбіжність кохання зазвичай не долає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một câu “không” rõ ràng. Chính đáng y như một câu “có” rõ ràng. Lệch nhau ở điểm này thường không phải điều tình yêu giải quyết được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很明确的“不要”。和明确的“想要”一样合理。这件事上的分歧，通常不是靠爱就能化解的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很明確的不要，和明確的想要一樣值得尊重。這件事若意見不合，通常不是靠愛就能解決的。"
          }
        }
      }
    },
    "A clear position. Nothing wrong with it — but worth knowing if your partner is deeply attached to the idea." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقف واضح لا عيب فيه، لكن من المفيد معرفة ما إذا كان شريكك متعلقًا بالفكرة بشدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasný postoj. Nic špatného na něm není – ale je dobré vědět, jestli tvůj protějšek na té představě hodně lpí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En klar holdning. Intet galt med den – men godt at vide, hvis din partner er meget knyttet til idéen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine klare Haltung. Daran ist nichts falsch – aber gut zu wissen, falls dein Schatz sehr an dem Gedanken hängt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ξεκάθαρη θέση. Τίποτα κακό σε αυτό — αλλά καλό είναι να ξέρεις αν το ταίρι σου είναι πολύ δεμένο με την ιδέα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una postura clara. No tiene nada de malo — pero conviene saber si a tu pareja le hace mucha ilusión la idea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvä kanta. Siinä ei ole mitään vikaa – mutta hyvä tietää, jos kumppanisi on syvästi kiintynyt ajatukseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malinaw na posisyon. Walang mali roon — pero magandang malaman kung sobrang gusto ito ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une position claire. Rien de mal à ça, mais bon à savoir si l'autre tient beaucoup à l'idée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עמדה ברורה. אין בזה שום פסול — אבל כדאי לדעת אם הצד השני קשור מאוד לרעיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साफ़ राय। इसमें कुछ ग़लत नहीं — पर यह जानना अच्छा है कि कहीं आपके पार्टनर का इस ख़याल से गहरा लगाव तो नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Világos álláspont. Semmi baj vele – de jó tudni, ha a párod nagyon ragaszkodik az ötlethez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikap yang jelas. Nggak ada yang salah — tapi baik diketahui kalau pasanganmu sangat ingin punya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una posizione chiara. Niente di male — ma meglio saperlo se il tuo partner ci tiene molto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はっきりした考えです。何も悪くありません。ただ、パートナーが強く望んでいるなら知っておくといいでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분명한 입장이에요. 잘못된 건 없어요. 다만 연인이 반려동물을 정말 원한다면 알아 두면 좋아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendirian yang jelas. Tiada salahnya — tetapi elok tahu jika pasangan anda sangat menginginkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tydelig standpunkt. Ingenting galt med det – men greit å vite om partneren din er veldig knyttet til tanken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een helder standpunt. Niks mis mee – maar goed om te weten als je partner erg aan het idee gehecht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasne stanowisko. Nie ma w nim nic złego – ale warto wiedzieć, czy twoja druga połówka jest bardzo przywiązana do tego pomysłu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma posição clara. Nada de errado nisso — mas vale saber se seu amor é muito apegado à ideia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O poziție clară. Nu e nimic greșit în ea — dar e bine de știut dacă partenerul tău ține mult la idee."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чёткая позиция. В ней нет ничего плохого — но стоит знать, если партнёр очень мечтает о питомце."
          }
        },
        "sv" : {
