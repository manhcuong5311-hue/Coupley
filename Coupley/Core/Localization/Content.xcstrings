        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्टमार्टमभन्दा शारीरिक निकटताले धेरै भन्छ। तपाईंका लागि स्पर्शले नै कुरा टुङ्ग्याउँछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysiek weer contact maken zegt meer dan een nabespreking. Voor jou maakt aanraking de cirkel rond."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulumikizananso mwa kukhudzana kumanena zambiri kuposa kusanthula zomwe zinachitika. Kwa inu, kukhudzana kumatseka nkhani."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walitti dhufeenyi qaamaa xiinxala booda godhamu caalaa dubbata. Siif tuqaan marsaa sana cufa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପୁଣି ଛୁଇଁ ପାଖ ହେବା ଲମ୍ବା ବିଶ୍ଳେଷଣଠୁ ଅଧିକ କହେ। ଆପଣଙ୍କ ପାଇଁ ସ୍ପର୍ଶ ହିଁ କଥାକୁ ଶେଷ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਰੀਰਕ ਨੇੜਤਾ ਪੂਰੀ ਚੀਰ-ਫਾੜ ਨਾਲੋਂ ਵੱਧ ਕਹਿ ਜਾਂਦੀ ਹੈ। ਤੁਹਾਡੇ ਲਈ ਛੋਹ ਨਾਲ ਹੀ ਗੱਲ ਪੂਰੀ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizyczna bliskość mówi więcej niż analiza kłótni. Dla ciebie to dotyk zamyka sprawę."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جسمي نږدېوالی له اوږدې څېړنې ډېر څه وايي. ستاسو لپاره، لمس خبره پای ته رسوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconectar pelo corpo diz mais do que repassar a briga. Para você, o toque fecha o ciclo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaproximar pelo toque diz mais do que uma autópsia da discussão. Para ti, o toque fecha o ciclo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apropierea fizică spune mai mult decât o analiză la rece. Pentru tine, atingerea închide cercul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернуть близость телом — сильнее любого разбора полётов. Для тебя прикосновение ставит точку."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kongera kwegerana ku mubiri bivuga byinshi kuruta gusesengura ibyabaye. Kuri wowe, gukoranaho ni byo bisoza ikibazo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සිදුවුණු දේ විග්‍රහ කරනවාට වඩා ශාරීරිකව නැවත සමීප වීම වැඩියෙන් කියනවා. ඔබට, ස්පර්ශයෙන් තමයි ඒක අවසන් වෙන්නේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzické zblíženie povie viac než rozbor hádky. Pre teba dotyk všetko uzavrie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telesno zbližanje pove več kot analiza prepira. Zate dotik sklene krog."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubatana zvakare nemuviri kunotaura zvakawanda kupfuura kuongorora zvakaitika. Kwauri, kubatwa ndiko kunopedzisa nyaya."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dib u kulanka jidheed ayaa ka badan falanqayn dheer. Adiga, taabashadu ayaa wareegga xirta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrimi fizik thotë më shumë se një analizë e gjatë e asaj që ndodhi. Për ty, prekja e mbyll rrethin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физичко повезивање каже више од анализе свађе. За тебе додир затвара круг."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyambung deui sacara fisik nyarioskeun langkung seueur tibatan ngabahas panjang lébar. Pikeun anjeun, sentuhan téh anu nutup éta pasea."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk närhet säger mer än en efteranalys. För dig är det beröringen som sluter cirkeln."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuungana tena kimwili husema zaidi kuliko kuuchambua ugomvi. Kwako, mguso hufunga mzunguko."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நடந்ததை அலசுவதை விட, உடல்ரீதியான நெருக்கம் அதிகம் சொல்கிறது. உங்களுக்கு, தொடுதல்தான் முற்றுப்புள்ளி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జరిగినదాన్ని విశ్లేషించడం కంటే మళ్లీ దగ్గరవడమే ఎక్కువ చెబుతుంది. మీకు, స్పర్శతోనే విషయం ముగుస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наздикии ҷисмонӣ аз таҳлили дуру дароз бештар мегӯяд. Барои ту ламс давраро мебандад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกลับมาใกล้ชิดกันทางกายบอกอะไรได้มากกว่าการนั่งวิเคราะห์ย้อนหลัง สำหรับคุณ สัมผัสคือการปิดเรื่องให้จบ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣካላዊ ዳግመ-ርክብ ካብ ነዊሕ ትንተና ዝያዳ ይዛረብ። ንዓኹም ምትንካፍ እዩ ነቲ ዙርያ ዝዓጹ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziki ýakynlaşmak uzyn seljermeden köp zat aýdýar. Seniň üçin degmek dawanyň soňuna nokat goýýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel yakınlık, uzun bir değerlendirmeden daha çok şey anlatıyor. Senin için meseleyi dokunuş kapatıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фізична близькість каже більше, ніж розбір польотів. Для тебе саме дотик ставить крапку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جسمانی قربت لمبے تجزیے سے زیادہ کہہ دیتی ہے۔ آپ کے لیے لمس ہی بات مکمل کرتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jismoniy yaqinlik uzoq tahlildan koʻra koʻproq narsani aytadi. Siz uchun aynan teginish nuqta qoʻyadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối lại bằng cái chạm nói nhiều hơn mọi lời mổ xẻ. Với bạn, cái chạm khép lại mọi chuyện."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukudibana kwakhona ngomzimba kuthetha ngaphezu kohlalutyo emva koko. Kuwe, ukuchukumisa kugqibezela yonke into."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìpadàpọ̀ ara ń sọ ju ìtúpalẹ̀ ohun tó ṣẹlẹ̀ lọ. Fún yín, ìfọwọ́kàn ló ń parí ọ̀rọ̀ náà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身體重新靠近，勝過事後檢討。對你來說，一個觸碰就能讓事情圓滿落幕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体上的重新靠近，胜过事后复盘。对你来说，一个拥抱就能让事情圆满。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身體的重新靠近，勝過事後檢討。對你來說，一個觸碰就能讓事情圓滿落幕。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuxhumana kabusha ngokuthintana kusho okuningi kunokuhlaziya okwenzekile. Kuwe, ukuthintana kuyakuphothula."
          }
        }
      }
    },
