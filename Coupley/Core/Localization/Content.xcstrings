        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल बताने वाले की तरह नहीं, दोस्त की तरह सुनें। उनकी भावनाएँ अपने शब्दों में दोहराएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slušaj prijateljski, a ne da popravljaš. Ponovi ono što voljena osoba osjeća."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koute l tankou yon zanmi, pa tankou yon reparatè. Repete sa l santi a."
