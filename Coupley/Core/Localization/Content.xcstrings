    "You need people but you're not dependent on them. A healthy mix of connection and personal space suits you best." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاجون إلى الناس دون أن تعتمدوا عليهم. يناسبكم مزيج صحي من التواصل والمساحة الشخصية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidi potřebuješ, ale nezávisíš na nich. Nejvíc ti sedí zdravý mix blízkosti a osobního prostoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brug for mennesker, men du er ikke afhængig af dem. En sund blanding af samvær og personlig plads passer dig bedst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst Menschen, bist aber nicht abhängig von ihnen. Ein gesunder Mix aus Nähe und eigenem Freiraum passt am besten zu dir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεσαι τους ανθρώπους, αλλά δεν εξαρτάσαι από αυτούς. Σου ταιριάζει ένα υγιές μείγμα σύνδεσης και προσωπικού χώρου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas a la gente, pero no dependes de ella. Lo que mejor te sienta es una buena mezcla de conexión y espacio propio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitset ihmisiä, mutta et ole heistä riippuvainen. Terve tasapaino yhdessäolon ja oman tilan välillä sopii sinulle parhaiten."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan mo ng tao pero hindi ka umaasa sa kanila. Pinakabagay sa’yo ang malusog na halo ng koneksyon at sariling espasyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as besoin des autres sans en dépendre. Un bon mélange de lien et d'espace personnel te convient le mieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך צורך באנשים, אבל בלי תלות בהם. שילוב בריא של חיבור ומרחב אישי הוא מה שהכי מתאים לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको लोग चाहिए, पर आप उन पर निर्भर नहीं हैं। जुड़ाव और अपनी जगह का सेहतमंद मेल आपके लिए सबसे अच्छा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szükséged van az emberekre, de nem függsz tőlük. A kapcsolódás és a saját tér egészséges keveréke illik hozzád a legjobban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu butuh orang lain, tapi tidak bergantung pada mereka. Campuran yang sehat antara kebersamaan dan ruang pribadi paling cocok untukmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai bisogno delle persone, ma non dipendi da loro. Il tuo equilibrio ideale è un buon mix di legami e spazi personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人は必要だけれど、頼りきりにはならないタイプ。つながりと自分の時間、どちらもほどよくあるのがいちばん合っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사람이 필요하지만 기대지는 않아요. 함께하는 시간과 나만의 공간이 건강하게 섞일 때 가장 편안해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda perlukan orang lain tetapi tidak bergantung kepada mereka. Gabungan hubungan dan ruang peribadi yang seimbang paling sesuai untuk anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger folk, men er ikke avhengig av dem. En sunn miks av nærhet og eget rom passer deg best."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt mensen nodig, maar je bent niet van ze afhankelijk. Een gezonde mix van verbinding en eigen ruimte past het best bij je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebujesz ludzi, ale się od nich nie uzależniasz. Najlepiej służy ci zdrowa mieszanka bliskości i własnej przestrzeni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de gente, mas não depende dela. Uma boa mistura de conexão e espaço pessoal é o que mais combina com você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai nevoie de oameni, dar nu depinzi de ei. Ți se potrivește cel mai bine un amestec sănătos de conexiune și spațiu personal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе нужны люди, но ты от них не зависишь. Тебе лучше всего подходит здоровый баланс общения и личного пространства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver människor men är inte beroende av dem. En sund blandning av gemenskap och eget utrymme passar dig bäst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องการผู้คนแต่ไม่ได้พึ่งพาพวกเขา ความสมดุลระหว่างความใกล้ชิดกับพื้นที่ส่วนตัวเหมาะกับคุณที่สุด"
