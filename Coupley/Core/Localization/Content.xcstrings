        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ जो मुश्किल लगता है — लोगों के सामने बोलना, आत्मविश्वास"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nešto što mi je teško – javni nastup, samopouzdanje"
