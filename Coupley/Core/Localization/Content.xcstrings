        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatiksin. Asıl hayatın iş dışında geçiyor. İş, hayalindeki hayata hizmet ediyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прагматично. Твоє справжнє життя — поза роботою. Робота працює на твої плани."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thực tế. Cuộc sống thật của bạn diễn ra ngoài giờ làm. Công việc phục vụ cho điều bạn hướng tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很务实。你真正的生活在工作之外，工作是为理想服务的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很務實。你真正的生活在工作之外，工作是為了實現心中的藍圖。"
          }
        }
      }
    },
    "Prefer small group or one-on-one settings" : {
