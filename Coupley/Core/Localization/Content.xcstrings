        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univerzálně správná odpověď neexistuje – ale shoda tady předchází vážným třenicím."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does dim un ateb cywir i bawb — ond mae cytuno ar hyn yn atal tensiwn difrifol."
