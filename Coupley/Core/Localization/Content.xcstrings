        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelen verlaagt stress, en naast elkaar praat makkelijker dan tegenover elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spacer obniża kortyzol, a rozmowa ramię w ramię jest łatwiejsza niż twarzą w twarz."
