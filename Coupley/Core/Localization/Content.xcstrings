        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دنبال حل کردنی. رابطه را بزرگ‌تر از اختلاف می‌بینی. این یک نقطهٔ قوت واقعی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratkaisukeskeinen. Näet suhteen isompana kuin erimielisyyden. Se on todellinen vahvuus."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakatuon ka sa pag-aayos. Para sa’yo, mas malaki ang relasyon kaysa sa hindi pagkakasundo. Tunay na lakas iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap sur la solution. Pour toi, votre relation compte plus que le désaccord. C'est une vraie force."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dírithe ar réiteach. Feiceann tú an caidreamh mar rud níos mó ná an t-easaontas. Is fíorláidreacht é sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfoque na solución. Ves a relación como algo máis grande ca discusión. Iso é unha fortaleza de verdade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉકેલ પર ધ્યાન. તમારા માટે સંબંધ મતભેદ કરતાં મોટો છે. એ સાચી તાકાત છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna mai da hankali kan warware matsala. Kuna ganin dangantakarku ta fi saɓanin girma. Wannan ƙarfi ne na gaske."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפוקוס על פתרון. אצלך הזוגיות גדולה יותר מכל ויכוח. זו חוזקה אמיתית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ध्यान हल पर रहता है। आपके लिए रिश्ता किसी भी बहस से बड़ा है। यह सच में एक ताक़त है।"
