        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlichkeit ist deine Basis für Vertrauen. Kleine gebrochene Zusagen summieren sich und untergraben das Vertrauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αξιοπιστία είναι η βάση της εμπιστοσύνης σου. Οι μικρές αθετημένες δεσμεύσεις αθροίζονται και τη διαβρώνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilidad es tu base para confiar. Los pequeños compromisos incumplidos se acumulan y desgastan la confianza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luotettavuus on luottamuksesi perusta. Pienetkin rikotut sitoumukset kasautuvat ja syövät luottamusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagiging maaasahan ang pundasyon ng tiwala mo. Naiipon ang maliliit na napakong pangako at unti-unting sinisira ang kumpiyansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilité est la base de ta confiance. Les petits engagements non tenus s'additionnent et l'érodent."
