    "We often love others the way we want to be loved — not always how they receive it best." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ons het ander dikwels lief soos ons self liefgehê wil word – nie altyd soos hulle dit die beste ontvang nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዙ ጊዜ ሌሎችን የምንወደው ልንወደድ በምንፈልገው መንገድ ነው — እነሱ በተሻለ በሚቀበሉት መንገድ ሁልጊዜ አይደለም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا نحب الآخرين بالطريقة التي نريد أن نُحَب بها، لا بالطريقة التي يتلقون بها الحب على أفضل وجه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি প্ৰায়ে আনক সেইদৰেই ভাল পাওঁ যিদৰে নিজে ভাল পোৱা বিচাৰোঁ — সদায় সিহঁতে আটাইতকৈ ভালকৈ গ্ৰহণ কৰা ধৰণে নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çox vaxt başqalarını özümüz necə sevilmək istəyiriksə elə sevirik — həmişə onların ən yaxşı qəbul etdiyi kimi yox."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часта мы кахаем іншых так, як хочам, каб кахалі нас, — а не так, як ім лепш за ўсё адчуваць каханне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Често обичаме другите така, както искаме да обичат нас – не винаги както те най-добре го приемат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা প্রায়ই অন্যকে সেভাবে ভালোবাসি, যেভাবে নিজে ভালোবাসা পেতে চাই — অন্যজন যেভাবে সবচেয়ে ভালো নেয়, সবসময় সেভাবে নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Često volimo druge onako kako želimo da nas vole – a ne uvijek onako kako oni ljubav najbolje primaju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovint estimem com voldríem que ens estimessin — no sempre com l'altra persona ho rep millor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Často dáváme lásku tak, jak ji chceme dostávat my – ne vždy tak, jak ji druhý přijímá nejlíp."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydyn ni'n aml yn caru eraill yn y ffordd rydyn ni eisiau cael ein caru — nid bob amser yn y ffordd maen nhw'n ei dderbyn orau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi elsker ofte andre, sådan som vi selv vil elskes – ikke altid sådan, de bedst tager imod det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir lieben oft so, wie wir selbst geliebt werden wollen – nicht immer so, wie es beim anderen am besten ankommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συχνά αγαπάμε τους άλλους όπως θέλουμε να μας αγαπούν — όχι πάντα όπως το δέχονται καλύτερα εκείνοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menudo queremos a los demás como nos gustaría que nos quisieran, no siempre como mejor lo reciben."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me armastame teisi sageli nii, nagu ise tahame olla armastatud — mitte alati nii, nagu nemad seda kõige paremini vastu võtavad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Askotan besteak guk maitatuak izan nahi dugun moduan maitatzen ditugu — ez beti haiek ondoen jasotzen duten moduan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما اغلب دیگران را همان‌طور دوست داریم که می‌خواهیم دوستمان داشته باشند — نه همیشه آن‌طور که آن‌ها بهتر دریافت می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakastamme usein muita niin kuin itse haluamme tulla rakastetuiksi – emme aina niin kuin he sen parhaiten ottavat vastaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madalas, minamahal natin ang iba sa paraang gusto nating mahalin — hindi laging sa paraang pinakamadali nilang matanggap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On aime souvent les autres comme on aimerait être aimé, pas toujours comme eux le reçoivent le mieux."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is minic a thugaimid grá do dhaoine eile mar ba mhaith linn féin grá a fháil — ní i gcónaí mar is fearr a ghlacann siadsan leis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moitas veces queremos aos demais como nos gustaría que nos quixesen, non sempre como mellor o reciben."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આપણે ઘણી વાર બીજાને એ રીતે પ્રેમ કરીએ છીએ જે રીતે આપણને પ્રેમ જોઈએ છે — એ રીતે નહીં જે રીતે તેઓ એ સૌથી સારી રીતે અનુભવે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau da yawa muna son wasu yadda muke son a so mu — ba koyaushe yadda suka fi karɓa ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לרוב אוהבים אחרים כמו שרוצים לקבל אהבה — לא תמיד כמו שהם הכי מקבלים אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम अक्सर दूसरों को वैसे प्यार करते हैं जैसे ख़ुद प्यार पाना चाहते हैं — ज़रूरी नहीं कि वैसे जैसे उन्हें सबसे अच्छा लगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Često volimo druge onako kako želimo da nas vole – a ne uvijek onako kako oni to najbolje primaju."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souvan nou renmen lòt moun jan nou ta renmen yo renmen nou — pa toujou jan yo resevwa l pi byen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyakran úgy szeretünk másokat, ahogy mi szeretnénk, hogy szeressenek – nem mindig úgy, ahogy ők a legjobban befogadják."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաճախ մենք սիրում ենք այնպես, ինչպես ինքներս ենք ուզում սիրված լինել — ոչ միշտ այնպես, ինչպես մյուսն է ամենալավը ընդունում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita sering mencintai orang lain dengan cara yang ingin kita terima — belum tentu cara yang paling mereka rasakan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyị na-ahụkarị ndị ọzọ n'anya otú anyị chọrọ ka a hụ anyị n'anya — ọ bụghị mgbe niile ka ha kacha anabata ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við elskum oft aðra eins og við viljum sjálf vera elskuð – ekki endilega eins og þeim hentar best."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso amiamo gli altri come vorremmo essere amati noi — non sempre nel modo in cui loro lo ricevono meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人は、自分が愛されたい形で相手を愛しがち。それが相手にいちばん届く形とは限りません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita kerep nresnani wong liya kanthi cara sing kita pengini — ora mesthi cara sing paling gampang ditampa wong kuwi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხშირად სიყვარულს ისე გამოვხატავთ, როგორც თავად გვინდა მისი მიღება — და არა ყოველთვის ისე, როგორც მეორე იღებს მას ყველაზე კარგად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Біз көбіне басқаларды өзімізді сүйгенін қалағандай сүйеміз — олар оны қалай қабылдайтынындай емес."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "យើងច្រើនតែស្រឡាញ់អ្នកដទៃតាមរបៀបដែលយើងចង់ត្រូវគេស្រឡាញ់ — មិនតែងតែតាមរបៀបដែលគេទទួលបានល្អបំផុតនោះទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಾವು ಪ್ರೀತಿಸಲ್ಪಡಲು ಬಯಸುವ ರೀತಿಯಲ್ಲೇ ಇತರರನ್ನು ಪ್ರೀತಿಸುತ್ತೇವೆ — ಅವರು ಅದನ್ನು ಅತ್ಯುತ್ತಮವಾಗಿ ಸ್ವೀಕರಿಸುವ ರೀತಿಯಲ್ಲಿ ಯಾವಾಗಲೂ ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우리는 흔히 내가 받고 싶은 방식으로 사랑을 줘요. 상대가 가장 잘 받아들이는 방식과는 다를 수 있죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em gelek caran ji kesên din bi wî awayî hez dikin ku em dixwazin bên hezkirin — ne her tim bi awayê ku ew herî baş distînin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Биз көбүнчө башкаларды өзүбүз сүйүлгүбүз келгендей сүйөбүз — алар эң жакшы кабыл алгандай эмес."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mir weisen anere Léift dacks esou, wéi mir se selwer kréie wëllen — net ëmmer esou, wéi se bei hinnen am beschten ukënnt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຮົາມັກຮັກຄົນອື່ນໃນແບບທີ່ເຮົາຢາກຖືກຮັກ — ບໍ່ແມ່ນແບບທີ່ລາວຮັບໄດ້ດີທີ່ສຸດສະເໝີໄປ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dažnai mylime kitus taip, kaip norime būti mylimi patys – nebūtinai taip, kaip jiems geriausia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mēs bieži mīlam tā, kā gribētu, lai mīl mūs, – ne vienmēr tā, kā otrs to vislabāk uztver."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matetika isika tia ny hafa araka ny fomba tiantsika hitiavana antsika — fa tsy araka ny fomba handraisany azy tsara indrindra foana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He maha ngā wā ka aroha tātou ki ētahi atu i te huarahi e hiahia ai tātou kia arohaina — kaua i te huarahi e pai ai ki a rātou."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Често ги сакаме другите онака како што ние сакаме да бидеме сакани — не секогаш како тие најдобро го примаат тоа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മറ്റുള്ളവർക്ക് ഏറ്റവും നന്നായി സ്വീകരിക്കാനാകുന്ന രീതിയിലല്ല, നമുക്ക് സ്നേഹം കിട്ടാൻ ആഗ്രഹിക്കുന്ന രീതിയിലാണ് നമ്മൾ പലപ്പോഴും അവരെ സ്നേഹിക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бид бусдыг өөрсдөө хайрлуулахыг хүсдэг шигээ хайрладаг — тэдний хамгийн сайн хүлээж авдаг байдлаар биш."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपल्याला जसे प्रेम हवे असते, तसेच आपण इतरांवर करतो — पण त्यांच्यापर्यंत ते नेहमी तसेच पोहोचते असे नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita sering menyayangi orang lain dengan cara kita mahu disayangi — tidak semestinya cara mereka paling mudah menerimanya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiss inħobbu lil ħaddieħor kif aħna nixtiequ nkunu maħbuba — mhux dejjem kif l-oħrajn jilqgħuha l-aħjar."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "များသောအားဖြင့် ကိုယ် အချစ်ခံချင်တဲ့ပုံစံနဲ့ တခြားသူကို ချစ်ပြတတ်တယ် — သူတို့ အကောင်းဆုံး လက်ခံတဲ့ ပုံစံ အမြဲ မဟုတ်ဘူး။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi elsker ofte andre slik vi selv vil bli elsket – ikke alltid slik den andre helst tar imot kjærlighet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हामी प्रायः अरूलाई आफूले पाउन चाहेको तरिकाले माया गर्छौँ — उहाँहरूले सबैभन्दा राम्रोसँग बुझ्ने तरिकाले सधैँ होइन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We houden vaak van anderen zoals we zelf graag geliefd worden – niet altijd zoals de ander het best ontvangt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nthawi zambiri timakonda ena mmene ifeyo timafunira kukondedwa — osati nthawi zonse mmene iwo amalandirira bwino."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo baay'ee namoota biroo akkuma nuyi jaallatamuu barbaannutti jaallanna — akkaataa isaan caalaatti fudhatanitti yeroo hundaa miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମେ ପ୍ରାୟତଃ ଅନ୍ୟମାନଙ୍କୁ ସେହିପରି ଭଲପାଉ ଯେପରି ନିଜେ ଭଲପାଇବା ପାଇବାକୁ ଚାହୁଁ — ସେମାନେ ସବୁଠୁ ଭଲ କିପରି ଗ୍ରହଣ କରନ୍ତି ସେପରି ସବୁବେଳେ ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਸੀਂ ਅਕਸਰ ਦੂਜਿਆਂ ਨੂੰ ਉਸ ਤਰ੍ਹਾਂ ਪਿਆਰ ਕਰਦੇ ਹਾਂ ਜਿਵੇਂ ਅਸੀਂ ਖ਼ੁਦ ਪਿਆਰ ਚਾਹੁੰਦੇ ਹਾਂ — ਹਮੇਸ਼ਾ ਉਸ ਤਰ੍ਹਾਂ ਨਹੀਂ ਜਿਵੇਂ ਉਹ ਇਸ ਨੂੰ ਸਭ ਤੋਂ ਵਧੀਆ ਮਹਿਸੂਸ ਕਰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często okazujemy miłość tak, jak chcemy ją otrzymywać – nie zawsze tak, jak druga osoba najlepiej ją odbiera."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موږ اکثره نورو ته هغسې مینه ورکوو لکه څنګه چې غواړو موږ ته مینه وشي — نه تل هغسې چې هغوی یې تر ټولو ښه احساسوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas vezes amamos os outros do jeito que gostaríamos de receber amor — e nem sempre do jeito que a outra pessoa recebe melhor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas vezes damos amor da forma como o queremos receber — nem sempre da forma como a outra pessoa o recebe melhor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adesea îi iubim pe ceilalți așa cum vrem să fim iubiți — nu mereu așa cum primesc ei cel mai bine iubirea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы часто любим других так, как хотим, чтобы любили нас, — а не так, как им легче это принять."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akenshi dukunda abandi uko twe twifuza gukundwa — atari buri gihe uko bo bakira urukundo neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අපි බොහෝ විට අනුන්ට ආදරය කරන්නේ අපිට ආදරය ලැබෙන්න කැමති විදිහට — ඔවුන් හොඳින්ම භාර ගන්න විදිහට හැම වෙලේම නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Často milujeme druhých tak, ako chceme byť milovaní my – nie vždy tak, ako to najlepšie prijmú oni."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogosto ljubimo druge tako, kot bi želeli biti ljubljeni sami – ne vedno tako, kot oni ljubezen najlažje sprejmejo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazhinji tinoda vamwe nenzira yatinoda kudiwa nayo — kwete nguva dzose nenzira yavanonyatsogamuchira nayo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badanaa dadka kale waxaan u jeclaannaa sida aan rabno in naloo jeclaado — ma aha mar walba sida ay iyagu ugu fiican u helaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shpesh i duam të tjerët ashtu si duam të na duan – jo gjithmonë ashtu si e pranojnë ata më mirë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Често волимо друге онако како бисмо волели да нас воле — а не увек онако како они то најлакше примају."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urang sering nyaah ka batur ku cara anu urang hoyong dipikanyaah — teu salawasna cara anu paling saé ditampi ku anjeunna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi älskar ofta andra som vi själva vill bli älskade – inte alltid som de tar emot det bäst."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mara nyingi tunawapenda wengine jinsi tunavyotaka kupendwa — si kila mara jinsi wanavyopokea upendo vizuri zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நாம் அன்பு பெற விரும்பும் விதத்திலேயே பிறரை நேசிக்கிறோம் — அவர்கள் அதைச் சிறப்பாக உணரும் விதத்தில் எப்போதும் அல்ல."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మనం తరచూ మనం ప్రేమించబడాలనుకునే విధంగానే ఇతరులను ప్రేమిస్తాం — వారు బాగా అందుకునే విధంగా ఎప్పుడూ కాదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мо аксар вақт дигаронро ҳамон тавр дӯст медорем, ки худамон мехоҳем — на ҳамеша он тавре, ки онҳо беҳтар қабул мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรามักรักคนอื่นในแบบที่อยากถูกรัก ซึ่งอาจไม่ใช่แบบที่อีกฝ่ายรับได้ดีที่สุดเสมอไป"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዙሕ ግዜ ንካልኦት ከምቲ ክንፍቀር እንደልዮ ኢና እነፍቕሮም — ኩሉ ግዜ ከምቲ ብዝበለጸ ዝቕበልዎ ኣይኮነን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biz köplenç başgalary özümiz söýülmek isleýşimiz ýaly söýýäris — olaryň iň gowy kabul edişi ýaly däl."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu zaman başkalarını, kendimizin sevilmek istediği gibi severiz; her zaman onların en iyi aldığı şekilde değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми часто любимо інших так, як хочемо, щоб любили нас, — і не завжди так, як це найкраще сприймають вони."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم اکثر دوسروں سے اُس طرح محبت کرتے ہیں جیسے ہم خود محبت چاہتے ہیں — ضروری نہیں کہ انہیں بھی وہی طریقہ سب سے اچھا لگے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biz koʻpincha boshqalarni oʻzimiz qanday sevilishni xohlasak, shunday sevamiz — ular buni qanday qabul qilishidan qatʼi nazar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta thường yêu người khác theo cách mình muốn được yêu — chứ không phải lúc nào cũng là cách người ấy đón nhận tốt nhất."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sihlala sithanda abanye ngendlela esifuna ukuthandwa ngayo — hayi soloko ngendlela abawamkela ngayo kakuhle."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sábà máa ń fẹ́ràn àwọn ẹlòmíràn bí àwa fúnra wa ṣe fẹ́ kí a fẹ́ràn wa — kì í ṣe bí wọ́n ṣe ń gbà á jù nígbà gbogbo."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們常用自己想被愛的方式去愛人，而那未必是對方最能接收的方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们常用自己希望被爱的方式去爱别人——但那不一定是对方最能接收的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們常用自己想被愛的方式去愛人，但那不一定是對方最能接收的方式。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivame ukuthanda abanye ngendlela thina esifuna ukuthandwa ngayo — hhayi njalo ngendlela bona abaluthola kahle ngayo."
          }
        }
      }
    },
    "Wedding Savings" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troue-spaargeld"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሠርግ ቁጠባ"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدخرات الزفاف"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিয়াৰ সঞ্চয়"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toy üçün yığım"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберажэнні на вяселле"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спестявания за сватбата"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিয়ের সঞ্চয়"
          }
        },
