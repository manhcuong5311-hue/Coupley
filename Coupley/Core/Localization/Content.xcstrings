        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laging bukas ang pinto. Gumagana ito kapag pareho kayong komportableng magbukas ng usapan nang walang pormal na imbitasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porte ouverte. Ça marche bien quand vous deux êtes à l'aise pour aborder un sujet sans invitation officielle."
