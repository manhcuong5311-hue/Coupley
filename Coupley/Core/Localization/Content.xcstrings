        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בא לך חיבור מלא. המשפחה של הצד השני היא גם המשפחה שלך — ויש לך השקעה אמיתית בקשרים האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको पूरा जुड़ाव चाहिए। पार्टनर का परिवार भी आपका परिवार है — आप उन रिश्तों को दिल से निभाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želiš potpunu povezanost. I obitelj voljene osobe tvoja je obitelj – iskreno ulažeš u te odnose."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou vle yon entegrasyon total. Fanmi patnè ou se fanmi ou tou — ou envesti nan relasyon sa yo toutbon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes beilleszkedést szeretnél. A párod családja a te családod is – őszintén beleteszed magad ezekbe a kapcsolatokba."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ուզում ես լիակատար միաձուլում։ Զուգընկերոջդ հարազատները նաև քո ընտանիքն են — և դու անկեղծորեն ներդրում ես անում այդ հարաբերություններում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu ingin menyatu sepenuhnya. Keluarga pasangan juga keluargamu — kamu sungguh-sungguh merawat hubungan itu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị chọrọ ijikọ ha kpamkpam. Ezinụlọ onye gị bụkwa ezinụlọ gị — ị na-etinye uche na mmekọrịta ndị ahụ n'ezie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú vilt fulla samþættingu. Tengdafjölskyldan er líka þín fjölskylda – þú leggur þig einlæglega fram í þeim samböndum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi un’integrazione completa. Per te la famiglia del partner è anche la tua — e investi davvero in quei rapporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり溶け込みたいタイプです。相手の家族も自分の家族。その関係に心から向き合います。"
