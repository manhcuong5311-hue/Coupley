            "value" : "Hoe breng je het ter sprake als iets je dwarszit?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak poruszasz temat, który cię gryzie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando algo incomoda você, como você toca no assunto?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când te deranjează ceva, cum aduci vorba?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как ты заводишь разговор, когда тебя что-то беспокоит?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur tar du upp något som stör dig?"
