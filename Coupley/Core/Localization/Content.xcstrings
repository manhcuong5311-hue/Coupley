        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisida nii palju kui võimalik — näha kõike"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahalik eta gehien bidaiatu: dena ikusi"
