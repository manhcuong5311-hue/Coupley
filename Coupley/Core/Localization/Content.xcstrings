        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հպումը որպես կապ — պարտադիր չէ՝ սեռական։ Պարզապես իրար մոտ լինել, երբ մարմինն ասում է «Ես այստեղ եմ»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
