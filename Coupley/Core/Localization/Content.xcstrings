          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週、ふたりで何か小さな新しいことに挑戦しようと誘ってみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주에 작고 새로운 걸 함께 해 보자고 해 보세요."
