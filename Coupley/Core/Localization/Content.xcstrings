    "Somewhere quieter — smaller city or rural" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكان أهدأ — مدينة أصغر أو الريف"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Někde v klidu – menší město nebo venkov"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et roligere sted – mindre by eller på landet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irgendwo ruhiger – Kleinstadt oder Land"
