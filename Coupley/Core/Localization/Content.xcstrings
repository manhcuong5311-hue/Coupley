        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tako najlažje sprejemaš ljubezen – tvoj partner mora to vedeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iyi ndiyo nzira yaunonyatsogamuchira nayo rudo — mudiwa wako anofanira kuziva izvi."
