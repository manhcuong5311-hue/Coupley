        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errealista. Familia desberdinek modu desberdinak eskatzen dituzte. Garrantzitsuena da biak bat etortzea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقع‌بینانه. خانواده‌های مختلف رویکردهای مختلف می‌طلبند. مهم این است که هر دوتان هم‌نظر باشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realistista. Eri perheet vaativat erilaista otetta. Tärkeintä on, että olette molemmat samoilla linjoilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makatotohanan. Iba-iba ang paraan para sa iba’t ibang pamilya. Ang mahalaga, pareho kayo ng pananaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réaliste. Chaque famille demande une approche différente. L'essentiel, c'est d'être sur la même longueur d'onde."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réalaíoch. Éilíonn teaghlaigh éagsúla cur chuige éagsúil. Is é an rud is tábhachtaí ná go bhfuil an bheirt agaibh ar aon intinn."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realismo. Familias distintas piden enfoques distintos. O que importa é que os dous esteades na mesma páxina."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાસ્તવિક. જુદા જુદા પરિવાર માટે જુદી જુદી રીત જોઈએ. મહત્ત્વનું એ છે કે તમે બંને એકમત હો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna duba gaskiyar lamari. Iyalai daban-daban na buƙatar hanyoyi daban-daban. Abin da ke da muhimmanci shi ne ku biyu ku kasance da ra'ayi ɗaya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישה מציאותית. משפחות שונות דורשות גישות שונות. מה שחשוב הוא ששניכם תהיו באותו ראש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यावहारिक सोच। अलग-अलग परिवारों के लिए अलग तरीक़े चाहिए। ज़रूरी यह है कि आप दोनों की सोच एक हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realno. Različite obitelji traže različite pristupe. Važno je da ste oboje na istoj valnoj duljini."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reyalis. Chak fanmi mande yon apwòch diferan. Sa ki enpòtan se pou nou tou de dakò."
