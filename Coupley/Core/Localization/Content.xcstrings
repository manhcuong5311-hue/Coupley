    "Career ambition shapes schedules, energy levels, and what you expect from home." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loopbaanambisie vorm skedules, energievlakke en wat jy van die huis verwag."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሙያ ምኞት ፕሮግራምን፣ የኃይል መጠንንና ከቤት የሚጠብቁትን ይቀርጻል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطموح المهني يشكّل المواعيد ومستوى الطاقة والتوقعات من البيت."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেৰিয়াৰৰ উচ্চাকাংক্ষাই সময়সূচী, শক্তি আৰু ঘৰৰ পৰা আপুনি কি আশা কৰে তাক গঢ় দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karyera ambisiyası qrafiki, enerjini və evdən gözləntiləri formalaşdırır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар’ерныя амбіцыі ўплываюць на расклад, энергію і чаканні ад дома."
          }
        },
        "bg" : {
          "stringUnit" : {
