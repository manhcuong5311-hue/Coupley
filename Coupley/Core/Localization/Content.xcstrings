          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ ટીકા નહીં — આ બાબતે તમે ક્યાં છો એની અસર તમારી ઊર્જા, મૂડ અને સમયપત્રક પર પડે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babu hukunci — matsayinku a wannan na shafar kuzarinku, yanayinku da jadawalinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי שיפוטיות — איפה שזה עומד אצלך משפיע על האנרגיה, על מצב הרוח ועל הלו״ז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सही-ग़लत नहीं — इस मामले में आप जहाँ भी हैं, उसका असर आपकी ऊर्जा, मूड और दिनचर्या पर पड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez osuđivanja – tvoj odnos prema tome utječe na energiju, raspoloženje i raspored."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa gen jijman — kote ou ye ak sa afekte enèji ou, imè ou ak orè ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi ítélkezés – az, hogy ebben hol tartasz, hat az energiádra, a hangulatodra és a napirendedre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առանց դատելու — այս հարցում քո վիճակն ազդում է էներգիայիդ, տրամադրությանդ ու ժամանակացույցիդ վրա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa menghakimi — kondisimu soal ini memengaruhi energi, mood, dan jadwalmu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enweghị ikpe — ebe ị nọ na nke a na-emetụta ume gị, ọnọdụ obi gị na usoro oge gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enginn dómur – staða þín í þessu hefur áhrif á orku, skap og dagskrá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun giudizio — il punto in cui ti trovi influisce sulla tua energia, sul tuo umore e sui vostri orari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな答えでも大丈夫。運動との向き合い方は、エネルギーや気分、スケジュールにも影響します。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora ana sing ngadili — kahanan panjenengan ing bab iki mangaruhi tenaga, swasana ati, lan jadwal."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "განკითხვის გარეშე — ამაში სადაც დგახარ, ის გავლენას ახდენს შენს ენერგიაზე, ხასიათსა და განრიგზე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ешкім сынамайды — бұған көзқарасың қуатыңа, көңіл-күйіңе және кестеңе әсер етеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានការវិនិច្ឆ័យទេ — ស្ថានភាពរបស់អ្នកចំពោះរឿងនេះ ប៉ះពាល់ដល់ថាមពល អារម្មណ៍ និងកាលវិភាគរបស់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾವ ತೀರ್ಪೂ ಇಲ್ಲ — ಈ ವಿಷಯದಲ್ಲಿ ನೀವು ಎಲ್ಲಿದ್ದೀರಿ ಎಂಬುದು ನಿಮ್ಮ ಶಕ್ತಿ, ಮೂಡ್ ಮತ್ತು ವೇಳಾಪಟ್ಟಿಯ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "솔직하게 답해도 괜찮아요. 지금 어떤 상태인지가 에너지, 기분, 일정에 영향을 주거든요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bê dadbarî — rewşa te di vê mijarê de bandorê li enerjî, hal û bernameyên te dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эч ким айыптабайт — бул жагынан кайда турганың кубатыңа, маанайыңа жана күн тартибиңе таасир этет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouni Uerteel — wou s du domat stees, beaflosst deng Energie, deng Stëmmung an är Pläng."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບໍ່ມີການຕັດສິນ — ຈຸດທີ່ເຈົ້າຢູ່ໃນເລື່ອງນີ້ມີຜົນຕໍ່ພະລັງ, ອາລົມ ແລະ ຕາຕະລາງເວລາຂອງເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be vertinimo – tai, kur dabar esi, veikia tavo energiją, nuotaiką ir dienotvarkę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez nosodījuma – tas, kur tu šobrīd esi, ietekmē tavu enerģiju, noskaņojumu un dienas ritmu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy misy fitsarana — misy fiantraikany amin'ny herinao, ny toe-ponao ary ny fandaharam-potoanao ny toerana misy anao amin'izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore he whakawā — ka pā tō tūranga ki tō kaha, tō wairua me ō wā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без осудување — каде си со ова влијае на енергијата, расположението и распоредите."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു വിധിയെഴുത്തുമില്ല — ഇക്കാര്യത്തിൽ നിങ്ങൾ എവിടെ നിൽക്കുന്നു എന്നത് നിങ്ങളുടെ ഊർജത്തെയും മൂഡിനെയും സമയക്രമത്തെയും ബാധിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шүүмжлэл байхгүй — энэ талаар чи хаана байгаа нь эрч хүч, сэтгэл санаа, хуваарьт чинь нөлөөлдөг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोणताही न्यायनिवाडा नाही — याबाबत तुम्ही कुठे आहात, याचा तुमच्या ऊर्जेवर, मूडवर आणि वेळापत्रकावर परिणाम होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak perlu segan — keadaan anda dalam hal ini mempengaruhi tenaga, perasaan dan jadual anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda ġudizzju — fejn tinsab f'dan jaffettwa l-enerġija, il-burdata u l-iskedi tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပြစ်မမြင်ပါဘူး — ဒီကိစ္စမှာ သင် ဘယ်နေရာမှာ ရှိလဲဆိုတာ အားအင်၊ စိတ်ခံစားမှုနဲ့ အချိန်ဇယားတွေကို သက်ရောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dømmer ingen – hvor du står her, påvirker energien, humøret og timeplanen din."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुनै आलोचना छैन — यसमा तपाईं कहाँ हुनुहुन्छ भन्ने कुराले तपाईंको ऊर्जा, मुड र तालिकामा असर गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen oordeel – waar je nu staat beïnvloedt je energie, je stemming en jullie planning."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palibe kuweruza — mmene mulili pa izi kumakhudza mphamvu zanu, mmene mukumvera ndi ndandanda yanu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Murtii hin jiru — iddoon ati kana irratti jirtu humna, miira fi sagantaa kee irratti dhiibbaa qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କୌଣସି ବିଚାର ନାହିଁ — ଏଥିରେ ଆପଣ କେଉଁଠି ଅଛନ୍ତି ତାହା ଆପଣଙ୍କ ଶକ୍ତି, ମନୋଭାବ ଓ ସମୟସୂଚୀ ଉପରେ ପ୍ରଭାବ ପକାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਪਰਖ ਨਹੀਂ — ਇਸ ਬਾਰੇ ਤੁਸੀਂ ਕਿੱਥੇ ਹੋ, ਇਹ ਤੁਹਾਡੀ ਊਰਜਾ, ਮੂਡ ਅਤੇ ਸਮਾਂ-ਸਾਰਣੀ ਉੱਤੇ ਅਸਰ ਪਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez oceniania – to, gdzie teraz jesteś, wpływa na twoją energię, nastrój i plan dnia."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هېڅ قضاوت نشته — په دې برخه کې ستاسو حالت ستاسو پر انرژۍ، مزاج او مهالوېش اغېز کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem julgamentos — o ponto em que você está afeta sua energia, seu humor e sua agenda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem julgamentos — o ponto em que estás nisto afeta a tua energia, o teu humor e os vossos horários."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără judecăți — unde te afli acum îți influențează energia, starea și programul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без осуждения — твоё отношение к этому влияет на энергию, настроение и расписание."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nta guca urubanza — aho ugeze muri ibi bigira ingaruka ku mbaraga zawe, ku marangamutima no kuri gahunda zanyu."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කිසිම විනිශ්චයක් නැහැ — මේ ගැන ඔබ ඉන්න තැන ඔබේ ශක්තියට, මනෝභාවයට සහ කාලසටහන්වලට බලපානවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez súdenia – to, kde v tomto si, ovplyvňuje tvoju energiu, náladu aj rozvrh."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brez obsojanja – tvoj odnos do tega vpliva na energijo, razpoloženje in urnike."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasina kutongwa — pamuri pazviri panobata simba renyu, manzwiro, nehurongwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xukun la'aan — halka aad ka taagan tahay tan waxay saameysaa tamartaada, niyaddaada iyo jadwalladiinna."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa gjykime – ku je me këtë ndikon në energjinë, humorin dhe oraret e tua."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без осуђивања — то где си сада утиче на енергију, расположење и распоред."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teu aya anu nangtoskeun — kaayaan anjeun dina hal ieu mangaruhan tanaga, wanda, sareng jadwal anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga pekpinnar – var du står här påverkar din energi, ditt humör och era scheman."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuna hukumu — ulipo katika hili huathiri nguvu zako, hisia na ratiba zenu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எந்த மதிப்பீடும் இல்லை — இதில் நீங்கள் எங்கே இருக்கிறீர்கள் என்பது உங்கள் ஆற்றல், மனநிலை, நேர அட்டவணைகளைப் பாதிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎలాంటి తీర్పు లేదు — ఈ విషయంలో మీరు ఎక్కడ ఉన్నారన్నది మీ శక్తి, మూడ్, సమయాలపై ప్రభావం చూపుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бе доварӣ — вазъияти ту дар ин бора ба қувват, кайфият ва ҷадвали шумо таъсир мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีการตัดสิน จุดที่คุณอยู่ตอนนี้ส่งผลต่อพลัง อารมณ์ และตารางชีวิตของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፍርዲ የለን — ኣብዚ ዘለኹምዎ ኩነታት ኣብ ሓይልኹም፣ ስምዒትኩምን ሰዓታትኩምን ጽልዋ ኣለዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç hili ýazgarma ýok — bu seniň güýjüňe, keýpiňe we gün tertibiňe täsir edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yargı yok; bu konuda nerede olduğun enerjini, ruh halini ve programını etkiliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без засуджень — твоє ставлення до цього впливає на енергію, настрій і розклад."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی فیصلہ نہیں — اس معاملے میں آپ جہاں ہیں، اس کا اثر آپ کی توانائی، موڈ اور معمولات پر پڑتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hech qanday hukm yoʻq — bu borada qayerda turganingiz quvvatingiz, kayfiyatingiz va kun tartibingizga taʼsir qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phán xét — tình trạng của bạn lúc này ảnh hưởng đến năng lượng, tâm trạng và lịch sinh hoạt."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akukho kugweba — apho ukhoyo ngale nto kuchaphazela amandla akho, imo yakho kunye neshedyuli zenu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kò sí ìdájọ́ — ibi tí ẹ wà lórí èyí ń nípa lórí agbára, ìṣesí àti ètò àkókò yín."
          }
        },
        "zh-HK" : {
