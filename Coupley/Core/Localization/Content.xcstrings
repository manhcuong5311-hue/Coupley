        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η ενέργεια έχει τελειώσει, η ανακούφιση μετράει περισσότερο από τα καθησυχαστικά λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando no queda energía, el alivio vale más que las palabras de ánimo."
