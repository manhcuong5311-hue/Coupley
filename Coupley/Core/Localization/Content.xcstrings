        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldaketarako prest, baina kultura ezagunaren barruan. Hasiera berri bat nahi duzu, erabat lekualdatzearen ziurgabetasunik gabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آماده برای تغییر ولی در فرهنگی آشنا. شروعی تازه می‌خواهی، بدون بلاتکلیفیِ یک مهاجرت کامل."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoin muutokselle, mutta tutun kulttuurin sisällä. Haluat uuden alun ilman koko elämän siirtämisen epävarmuutta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukas sa pagbabago pero sa pamilyar na kultura. Gusto mo ng bagong simula nang hindi hinaharap ang lahat ng walang katiyakan ng paglipat sa malayo."
