        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lohn für ein Arbeitsleben ist, die Welt zu sehen. Wahrscheinlich sparst du auf deine Version von Freiheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανταμοιβή για μια ζωή δουλειάς είναι να δεις τον κόσμο. Μάλλον αποταμιεύεις για τη δική σου εκδοχή ελευθερίας."
