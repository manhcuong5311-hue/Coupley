        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획이 있는 일시적인 몰입이에요. 이게 영원한 모습이 아니라 한때라는 걸 알면 연인도 그 희생을 이해하기 쉬워요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tundiya demkî bi planekê. Zanîna ku ev dewrek e, ne nasnameyeke mayînde, alîkariya hevjînê te dike ku fedakariyê fêm bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планы бар убактылуу катуулук. Бул түбөлүк инсандык эмес, бир мезгил экенин билсе, сүйгөнүң курмандыкты түшүнө алат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eng Zäit mat vill Asaz, mat Plang. Ze wëssen, datt et eng Phas ass an net fir ëmmer, hëlleft dengem Schatz, d'Affer ze verstoen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ທຸ່ມເທຊົ່ວຄາວແບບມີແຜນ ການຮູ້ວ່ານີ້ຄືຊ່ວງໜຶ່ງ ບໍ່ແມ່ນຕົວຕົນຖາວອນ ຊ່ວຍໃຫ້ຄູ່ເຂົ້າໃຈການເສຍສະລະ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikinas intensyvumas su planu. Žinant, kad tai etapas, o ne nuolatinė tapatybė, antrajai pusei lengviau suprasti aukas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Īslaicīga intensitāte ar plānu. Zinot, ka tas ir posms, nevis pastāvīga identitāte, otrai pusei ir vieglāk saprast upuri."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiezahana mafy vetivety misy drafitra. Ny fahafantarana fa vanim-potoana izany fa tsy maha-izy anao mandrakizay dia manampy ny olon-tiana hahatakatra ny sorona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He kaha poto me tētahi mahere. Mā te mōhio he wā noa tēnei, ehara i te tuakiri pūmau, ka mārama tētahi hoa aroha ki te whakarērea."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привремен интензитет со план. Кога знае дека ова е фаза, а не траен идентитет, половинката полесно ја разбира жртвата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു പ്ലാനോടുകൂടിയ താൽക്കാലിക തീവ്രത. ഇതൊരു സ്ഥിരം വ്യക്തിത്വമല്ല, ഒരു ഘട്ടം മാത്രമാണെന്ന് അറിയുന്നത് ആ ത്യാഗം മനസ്സിലാക്കാൻ പങ്കാളിയെ സഹായിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төлөвлөгөөтэй түр зуурын эрч. Энэ байнгын мөн чанар биш, нэг үе шат гэдгийг мэдвэл хань чинь золиосыг ойлгоход амар болно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजनेसह तात्पुरती धावपळ. हा कायमचा स्वभाव नसून एक टप्पा आहे, हे कळले की जोडीदाराला तुमचा त्याग समजून घेणे सोपे जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensiti sementara dengan rancangan. Mengetahui ini satu fasa, bukan identiti kekal, membantu pasangan memahami pengorbanannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensità temporanja bi pjan. Li jkun jaf li din hija fażi, mhux identità permanenti, jgħin lil partner jifhem is-sagrifiċċju."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အစီအစဉ်ရှိတဲ့ ယာယီ ပြင်းထန်မှုပါ။ ဒါက ကာလတစ်ခုပဲ၊ အမြဲတမ်း လက္ခဏာ မဟုတ်ဘူးဆိုတာ သိထားရင် ချစ်သူက ပေးဆပ်နေရတာကို နားလည်နိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midlertidig intensitet med en plan. Når en partner vet at dette er en fase og ikke den du er for alltid, er det lettere å forstå offeret."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजनासहितको अस्थायी व्यस्तता। यो स्थायी पहिचान होइन, एउटा चरण हो भन्ने थाहा भए पार्टनरलाई त्याग बुझ्न सजिलो हुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdelijk intens, met een plan. Weten dat dit een fase is en niet wie je altijd bent, helpt je partner het offer te begrijpen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulimbikira kwa kanthawi ndi dongosolo. Kudziwa kuti iyi ndi nthawi yochepa, osati umunthu wanu wokhazikika, kumathandiza wokondedwa kumvetsa kudzipereka kumeneko."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciminna yeroof, karoora wajjin. Kun yeroo darbu malee eenyummaa dhaabbataa akka hin taane beekuun jaalalleen kee aarsaa sana hubachuuf gargaara."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯୋଜନା ସହ ଅସ୍ଥାୟୀ ତୀବ୍ରତା। ଏହା ଏକ ପର୍ଯ୍ୟାୟ, ସ୍ଥାୟୀ ପରିଚୟ ନୁହେଁ — ଏହା ଜାଣିଲେ ସାଥୀ ତ୍ୟାଗକୁ ବୁଝିପାରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਯੋਜਨਾ ਨਾਲ ਕੁਝ ਸਮੇਂ ਦੀ ਸਖ਼ਤ ਮਿਹਨਤ। ਇਹ ਜਾਣਨਾ ਕਿ ਇਹ ਇੱਕ ਦੌਰ ਹੈ, ਪੱਕੀ ਪਛਾਣ ਨਹੀਂ, ਪਾਰਟਨਰ ਨੂੰ ਕੁਰਬਾਨੀ ਸਮਝਣ ਵਿੱਚ ਮਦਦ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwilowa intensywność z planem. Świadomość, że to etap, a nie stała tożsamość, pomaga drugiej połówce zrozumieć to poświęcenie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنډمهاله شدت له پلان سره. دا پوهېدل چې دا یو پړاو دی، نه دایمي هویت، له ملګري سره مرسته کوي چې قرباني درک کړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidade temporária, com plano. Saber que é uma fase, e não quem você é para sempre, ajuda seu amor a entender o sacrifício."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidade temporária com um plano. Saber que isto é uma fase, e não uma identidade permanente, ajuda o teu par a perceber o sacrifício."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensitate temporară, cu un plan. Să știe că e o etapă, nu o identitate permanentă, îl ajută pe partener să înțeleagă sacrificiul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временная интенсивность с планом. Когда партнёр знает, что это этап, а не навсегда, жертвы понять проще."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuhate mwinshi w'igihe gito ufite gahunda. Kumenya ko ari igihe gihita, atari uwo uri we iteka, bifasha umukunzi wawe kumva icyo wigomwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැලැස්මක් එක්ක තාවකාලික තීව්‍රතාවක්. මේක ස්ථිර අනන්‍යතාවක් නෙවෙයි, එක කාලයක් විතරයි කියලා දැනගැනීම සහකරුවෙක්ට ඒ කැපකිරීම තේරුම් ගන්න උදව් වෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dočasné nasadenie s plánom. Keď polovička vie, že ide o obdobie, a nie o trvalú identitu, lepšie pochopí tú obetu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začasna intenzivnost z načrtom. Ko partner ve, da je to faza in ne trajna identiteta, žrtev lažje razume."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushanda zvikuru kwenguva pfupi kune hurongwa. Kuziva kuti iyi inguva, kwete maitiro ako ekusingaperi, kunobatsira mudiwa kunzwisisa kuzvipira ikoko."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoog ku meel gaar ah oo qorshe leh. Ogaanshaha inay tani tahay xilli, ma aha aqoonsi joogto ah, ayaa lammaanaha ka caawisa inuu fahmo hurista."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensitet i përkohshëm me plan. Kur partneri e di që kjo është një fazë, jo një identitet i përhershëm, e kupton më mirë sakrificën."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привремени интензитет са планом. Кад зна да је ово фаза, а не трајно стање, твојој половини је лакше да разуме одрицање."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensitas samentawis kalayan rencana. Terang yén ieu mangsa, sanés jati diri anu permanén, ngabantos pasangan ngartos pangorbananana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillfällig intensitet med en plan. Att veta att det är en fas, inte en permanent identitet, hjälper en partner att förstå uppoffringen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidii ya muda yenye mpango. Kujua kwamba hiki ni kipindi, si utambulisho wa kudumu, kunamsaidia mwenzi kuelewa kujitolea huko."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டத்துடன் கூடிய தற்காலிகத் தீவிரம். இது நிரந்தர அடையாளம் அல்ல, ஒரு கட்டம் மட்டுமே என்று தெரிந்தால், துணை அந்தத் தியாகத்தைப் புரிந்துகொள்வார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక ప్లాన్‌తో కూడిన తాత్కాలిక తీవ్రత. ఇది శాశ్వత స్వభావం కాదు, ఒక దశ అని తెలిస్తే, ఆ త్యాగాన్ని భాగస్వామి అర్థం చేసుకోగలరు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шиддати муваққатӣ бо нақша. Донистани он ки ин давра аст, на ҳувияти доимӣ, ба ёрат кӯмак мекунад, ки қурбониро фаҳмад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนักแค่ชั่วคราวและมีแผน การรู้ว่านี่เป็นแค่ช่วงหนึ่ง ไม่ใช่ตัวตนถาวร ช่วยให้คนรักเข้าใจการเสียสละนี้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስ መደብ ዘሎ ግዜያዊ ብርታዐ። እዚ እዋን ምዃኑ እምበር ቀዋሚ መንነት ከም ዘይኮነ ምፍላጥ መጻምዲ ነቲ ዝግበር መስዋእቲ ክርድኦ ይሕግዞ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meýilnamaly wagtlaýyn dartgynlylyk. Munuň hemişelik häsiýet däl-de, bir döwürdigini bilmek söýgüliňe şol gurbanlyga düşünmäge kömek edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlı, geçici bir yoğunluk. Bunun kalıcı bir kimlik değil, bir dönem olduğunu bilmek partnerinin fedakârlığı anlamasına yardım eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тимчасова інтенсивність із планом. Розуміння, що це етап, а не назавжди, допомагає половинці прийняти жертви."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصوبے کے ساتھ عارضی شدت۔ یہ جاننا کہ یہ ایک دور ہے، مستقل شناخت نہیں، ساتھی کو قربانی سمجھنے میں مدد دیتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejali vaqtinchalik zoʻriqish. Bu doimiy holat emas, bir bosqich ekanini bilish sherigingizga qurbonlikni tushunishga yordam beradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cường độ tạm thời, có kế hoạch. Biết đây là một giai đoạn chứ không phải mãi mãi giúp người ấy hiểu sự hy sinh."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuxakeka okwethutyana okunesicwangciso. Ukwazi ukuba eli lixesha nje, hayi ubuwena obungapheliyo, kunceda iqabane liqonde ukuzincama."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akitiyan ńlá fún ìgbà díẹ̀, pẹ̀lú ètò. Mímọ̀ pé àsìkò kan ni èyí, kì í ṣe ìdánimọ̀ títí láé, ń ran olólùfẹ́ yín lọ́wọ́ láti lóye ìrúbọ náà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有計劃的短暫衝刺。知道這只是一個階段而不是永久的身份，能幫助另一半理解這份犧牲。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有计划的阶段性冲刺。知道这只是一个阶段而不是永远如此，能帮另一半理解你的付出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有計畫的短期衝刺。讓另一半知道這只是一個階段、不是永遠如此，會更容易理解你的付出。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzikhandla kwesikhashana okunohlelo. Ukwazi ukuthi lesi yisikhathi esidlulayo, hhayi ubuwena baphakade, kusiza umlingani aqonde ukuzidela."
          }
        }
      }
    },
    "Tennis or badminton" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
