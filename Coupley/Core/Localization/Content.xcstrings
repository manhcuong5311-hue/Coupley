        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা একসাথে খাওয়া, বাজার করা আর বাইরে খাওয়ায় প্রভাব ফেলে — জেনে রাখা ভালো।"
