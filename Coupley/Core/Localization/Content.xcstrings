        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անկանխատեսելիությունը քո փորձառության մասն էր։ Դրա պատճառով տոների հանդեպ կարող ես բարդ զգացմունքներ ունենալ։"
