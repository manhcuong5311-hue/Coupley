        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você valoriza a independência financeira. Isso funciona bem com acordos claros sobre como lidar com as despesas em comum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețuiești independența financiară. Merge bine cu înțelegeri clare despre cum se împart cheltuielile comune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты ценишь финансовую независимость. Это хорошо работает, если есть ясные договорённости об общих расходах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du värdesätter ekonomisk självständighet. Det funkar bra med tydliga överenskommelser om hur gemensamma utgifter hanteras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณให้คุณค่ากับอิสระทางการเงิน วิธีนี้ได้ผลดีเมื่อมีข้อตกลงชัดเจนว่าจะจัดการค่าใช้จ่ายร่วมอย่างไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maddi bağımsızlığa değer veriyorsun. Ortak masrafların nasıl karşılanacağına dair net anlaşmalarla bu çok iyi işler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти цінуєш фінансову незалежність. Це добре працює, якщо чітко домовитися про спільні витрати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn coi trọng độc lập tài chính. Cách này hiệu quả khi có thỏa thuận rõ ràng về cách chia các khoản chi chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你看重经济独立。只要把共同开销怎么分说清楚，这样就很好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你重視財務獨立。只要對共同開銷怎麼處理有清楚的約定，這樣就很順利。"
          }
        }
      }
    },
    "You want full integration. In-laws are your family too — you invest in those relationships genuinely." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندماج كامل. أهل الشريك عائلتك أيضًا، واستثمارك في هذه العلاقات صادق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš úplné propojení. Rodina tvého protějšku je i tvoje rodina – a do těch vztahů upřímně investuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil have fuld integration. Svigerfamilien er også din familie – du investerer helhjertet i de relationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du willst volle Verbundenheit. Die Familie deines Schatzes ist auch deine – und du investierst ehrlich in diese Beziehungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θες πλήρη ένταξη. Η οικογένεια του ταιριού σου είναι και δική σου — επενδύεις ειλικρινά σε αυτές τις σχέσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quieres una integración total. La familia de tu pareja también es la tuya — y te implicas de verdad en esas relaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluat kuulua täysin joukkoon. Kumppanin perhe on sinunkin perheesi – panostat niihin suhteisiin aidosti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusto mo ng buong pagsasama. Pamilya mo rin ang pamilya ng partner mo — taos-puso kang nag-i-invest sa mga relasyong iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux une intégration totale. La belle-famille, c'est aussi ta famille : tu investis sincèrement dans ces relations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בא לך חיבור מלא. המשפחה של הצד השני היא גם המשפחה שלך — ויש לך השקעה אמיתית בקשרים האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको पूरा जुड़ाव चाहिए। पार्टनर का परिवार भी आपका परिवार है — आप उन रिश्तों को दिल से निभाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes beilleszkedést szeretnél. A párod családja a te családod is – őszintén beleteszed magad ezekbe a kapcsolatokba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu ingin menyatu sepenuhnya. Keluarga pasangan juga keluargamu — kamu sungguh-sungguh merawat hubungan itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi un’integrazione completa. Per te la famiglia del partner è anche la tua — e investi davvero in quei rapporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり溶け込みたいタイプです。相手の家族も自分の家族。その関係に心から向き合います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전히 하나가 되고 싶어 해요. 연인의 가족도 내 가족이고, 그 관계에 진심으로 마음을 쏟아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mahu bersatu sepenuhnya. Keluarga mentua juga keluarga anda — anda ikhlas memupuk hubungan itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil at alt skal henge sammen. Svigerfamilien er din familie også – du legger oppriktig innsats i de relasjonene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt er helemaal bij horen. Schoonfamilie is ook jouw familie – je investeert oprecht in die banden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz pełnej integracji. Teściowie to też twoja rodzina – naprawdę inwestujesz w te relacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você quer integração total. A família do seu amor também é sua — e você investe nessas relações de verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrei integrare completă. Familia partenerului e și familia ta — investești sincer în aceste relații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе важно полное единство. Родные партнёра — и твоя семья тоже, и ты искренне вкладываешься в эти отношения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill att allt flyter ihop. Svärfamiljen är också din familj – du lägger verklig energi på de relationerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากหลอมรวมเป็นหนึ่งเดียว ครอบครัวของคนรักก็คือครอบครัวของคุณ คุณทุ่มเทใจให้ความสัมพันธ์เหล่านั้นอย่างจริงใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir kaynaşma istiyorsun. Partnerinin ailesi senin de ailen; bu ilişkilere içtenlikle emek veriyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі хочеться повної інтеграції. Родина половинки — і твоя родина теж, і ти щиро вкладаєшся в ці стосунки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn muốn hòa nhập trọn vẹn. Gia đình người ấy cũng là gia đình bạn — bạn vun đắp những mối quan hệ đó bằng cả tấm lòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你希望完全融入。对方的家人也是你的家人，你会真心经营这些关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你希望完全融入。對方的家人也是你的家人，你會真心經營這些關係。"
          }
        }
      }
    },
    "You'd rather address it head-on than let it sit. Be mindful — your partner might need space before they can engage productively." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفضّلون المواجهة المباشرة على ترك الأمر معلّقًا. انتبهوا إلى أن شريكك قد يحتاج إلى مساحة قبل أن يتمكن من النقاش بشكل مثمر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raději věci řešíš přímo, než je nechat ležet. Jen pozor – tvůj protějšek může potřebovat prostor, než se dokáže zapojit konstruktivně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tager det hellere op med det samme end at lade det ligge. Vær opmærksom på, at din partner måske har brug for plads, før I kan få en god snak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sprichst Dinge lieber direkt an, statt sie liegen zu lassen. Denk daran: Dein Schatz braucht vielleicht erst etwas Abstand, um konstruktiv reden zu können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτιμάς να το αντιμετωπίσεις κατά μέτωπο παρά να το αφήσεις να σέρνεται. Έχε στο μυαλό σου ότι το ταίρι σου ίσως χρειάζεται χώρο πριν μπορέσει να το συζητήσει εποικοδομητικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefieres afrontarlo de frente antes que dejarlo estar. Tenlo en cuenta: puede que tu pareja necesite espacio antes de poder hablar de forma constructiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartut asiaan mieluummin suoraan kuin annat sen hautua. Muista kuitenkin, että kumppanisi saattaa tarvita tilaa ennen kuin pystyy keskustelemaan rakentavasti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas gusto mong harapin ito agad kaysa patagalin. Tandaan lang — baka kailangan muna ng partner mo ng espasyo bago siya makapag-usap nang maayos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu préfères affronter le problème de face plutôt que le laisser traîner. Attention : l'autre a peut-être besoin d'espace avant de pouvoir en discuter sereinement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיף לך להתמודד עם זה חזיתית מאשר להשאיר את זה באוויר. רק כדאי לשים לב — ייתכן שהצד השני צריך מרחב לפני שאפשר לנהל שיחה טובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात को टालने के बजाय आप उसका सीधे सामना करना पसंद करते हैं। बस ध्यान रखें — हो सकता है कि अच्छे से बात करने से पहले पार्टनर को थोड़ी जगह चाहिए हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább szembenézel vele, mint hogy hagyd ülepedni. Csak figyelj – lehet, hogy a párodnak előbb térre van szüksége, hogy építően tudjon beszélni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lebih suka menghadapinya langsung daripada membiarkannya. Tapi ingat — pasanganmu mungkin butuh ruang dulu sebelum bisa ngobrol dengan baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci affrontare le cose di petto piuttosto che lasciarle in sospeso. Ricorda però che il tuo partner potrebbe aver bisogno di spazio prima di riuscire a confrontarsi in modo costruttivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放っておくより、正面から向き合いたいタイプです。ただ、パートナーは前向きに話せるようになるまで時間が必要かもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "묵혀 두기보다 정면으로 마주하는 편이에요. 다만 연인은 차분하게 대화하기 전에 시간이 필요할 수도 있다는 걸 기억해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda lebih suka menghadapinya terus daripada membiarkannya. Berhati-hati — pasangan anda mungkin perlukan ruang sebelum boleh berbincang dengan baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar det heller opp direkte enn å la det ligge. Vær obs – partneren din kan trenge litt rom før samtalen blir konstruktiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij pakt het liever direct aan dan dat je het laat liggen. Let wel op – je partner heeft misschien eerst ruimte nodig om er constructief over te kunnen praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolisz zmierzyć się z problemem od razu, niż go odkładać. Pamiętaj tylko, że druga połówka może potrzebować chwili, zanim będzie w stanie konstruktywnie rozmawiać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você prefere encarar de frente a deixar para depois. Só tenha cuidado — seu amor pode precisar de um tempo antes de conseguir conversar bem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferi să iei problema în piept decât s-o lași să stagneze. Ai grijă însă — partenerul tău ar putea avea nevoie de spațiu înainte să poată discuta constructiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе проще решить вопрос в лоб, чем откладывать. Но помни: партнёру может понадобиться пауза, прежде чем разговор станет конструктивным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar hellre tag i det direkt än låter det ligga. Tänk på att din partner kanske behöver utrymme innan ni kan prata konstruktivt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากเผชิญหน้ากับปัญหามากกว่าปล่อยค้างไว้ แต่ลองนึกด้วยว่าคนรักอาจต้องการพื้นที่ก่อนจะคุยกันได้อย่างสร้างสรรค์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyi bekletmek yerine doğrudan ele almayı tercih ediyorsun. Dikkat et; partnerinin verimli konuşabilmek için önce alana ihtiyacı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі краще розібратися прямо, ніж відкладати. Але зважай: половинці може знадобитися час, щоб говорити конструктивно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thích đối mặt trực tiếp hơn là để mọi chuyện treo đó. Nhưng hãy lưu ý — người ấy có thể cần chút không gian trước khi trò chuyện một cách xây dựng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起放着不管，你更愿意直面问题。但要留意——另一半可能需要先冷静一下，才能好好沟通。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願正面處理，也不想把事情擱著。不過要留意，另一半可能需要一點空間，才能好好溝通。"
          }
        }
      }
    },
    "You'd rather hear something hard than be managed with comfortable half-truths. Radical honesty is both your standard and your offer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سماع الحقيقة الصعبة أفضل عندك من أنصاف الحقائق المريحة. الصدق التام معيارك وما تقدّمه أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radši slyšíš něco těžkého, než aby tě někdo konejšil pohodlnými polopravdami. Radikální upřímnost je tvůj standard i to, co nabízíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil hellere høre noget svært end blive håndteret med behagelige halve sandheder. Radikal ærlighed er både dit krav og dit tilbud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hörst lieber etwas Schweres, als mit bequemen Halbwahrheiten abgespeist zu werden. Radikale Ehrlichkeit ist dein Anspruch und dein Angebot."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτιμάς να ακούσεις κάτι δύσκολο παρά να σε χειρίζονται με βολικές μισές αλήθειες. Η απόλυτη ειλικρίνεια είναι και το μέτρο σου και αυτό που προσφέρεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefieres oír algo duro a que te manejen con medias verdades cómodas. La sinceridad total es lo que exiges y lo que ofreces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulet mieluummin jotain vaikeaa kuin että sinua hoidellaan mukavilla puolitotuuksilla. Ehdoton rehellisyys on sekä vaatimuksesi että lupauksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas gusto mong marinig ang masakit kaysa aluin ng komportableng kalahating-totoo. Ang buong katapatan ang pamantayan mo at ang iniaalok mo rin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu préfères entendre quelque chose de dur plutôt qu'on te ménage avec des demi-vérités confortables. L'honnêteté totale, c'est à la fois ton exigence et ce que tu offres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיף לך לשמוע משהו קשה מאשר שינהלו אותך בחצאי אמיתות נוחות. כנות רדיקלית היא גם הסטנדרט שלך וגם מה שיש לך להציע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरामदेह आधे-सच से बेहतर आपके लिए कोई कड़वी बात सुनना है। पूरी ईमानदारी आपका पैमाना भी है और आपका वादा भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább hallasz valami nehezet, mint hogy kényelmes féligazságokkal kezeljenek. A teljes őszinteség a mércéd, és ezt is kínálod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lebih memilih mendengar hal pahit daripada dihibur dengan setengah kebenaran yang nyaman. Kejujuran total adalah standarmu sekaligus yang kamu berikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci sentirti dire una cosa dura piuttosto che ricevere comode mezze verità. L’onestà totale è la tua regola e la tua promessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳ざわりのいい中途半端な真実でごまかされるより、つらいことでもはっきり聞きたい人です。とことん正直であることは、相手に求めることであり、自分が差し出すものでもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 좋은 반쪽짜리 진실보다 힘든 말을 듣는 게 나아요. 철저한 정직함은 상대에게 바라는 기준이자 스스로 지키는 약속이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda lebih rela mendengar sesuatu yang pahit daripada dipujuk dengan separuh kebenaran yang menyenangkan. Kejujuran sepenuhnya ialah apa yang anda tuntut dan juga apa yang anda berikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil heller høre noe vondt enn å bli håndtert med behagelige halvsannheter. Full ærlighet er både det du krever og det du gir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoort liever iets moeilijks dan dat je gesust wordt met fijne halve waarheden. Radicale eerlijkheid is zowel wat je verwacht als wat je biedt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolisz usłyszeć coś trudnego niż wygodne półprawdy. Radykalna szczerość to twój standard i to, co dajesz w zamian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você prefere ouvir algo difícil a receber meias-verdades confortáveis. Sinceridade total é o que você exige e o que oferece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferi să auzi ceva greu decât să te menajeze cineva cu jumătăți de adevăr comode. Sinceritatea radicală e atât standardul tău, cât și ce oferi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе лучше услышать что-то тяжёлое, чем утешительную полуправду. Полная честность — и твоё требование, и то, что ты даёшь взамен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill hellre höra något jobbigt än bli hanterad med bekväma halvsanningar. Total ärlighet är både vad du kräver och vad du erbjuder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากได้ยินความจริงที่ฟังยาก มากกว่าถูกปลอบด้วยความจริงครึ่งๆ กลางๆ ความจริงใจแบบสุดทางคือทั้งมาตรฐานและสิ่งที่คุณมอบให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatlatıcı yarım gerçeklerle idare edilmektense zor bir şey duymayı tercih edersin. Sonuna kadar dürüstlük hem beklediğin hem de verdiğin şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі краще почути щось важке, ніж отримувати зручні напівправди. Радикальна чесність — і твій стандарт, і те, що ти пропонуєш натомість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thà nghe điều khó nghe còn hơn được xoa dịu bằng những nửa sự thật dễ chịu. Trung thực tuyệt đối vừa là tiêu chuẩn vừa là điều bạn trao đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你宁愿听到难听的真话，也不想被舒服的半真半假敷衍。彻底的诚实，是你的标准，也是你的承诺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願聽到難聽的真話，也不想被舒服的半真半假安撫。徹底的誠實，是你的標準，也是你給出的承諾。"
          }
        }
      }
    },
    "You're adaptive and mood-driven. That flexibility is a strength as long as you can communicate when you're 'off'." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتكيّفون حسب المزاج. هذه المرونة نقطة قوة، ما دمتم قادرين على التعبير حين لا تكونون في أفضل حالاتكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobuješ se a řídíš se náladou. Ta flexibilita je síla, pokud dokážeš říct, kdy zrovna nejsi ve své kůži."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er omstillingsparat og styret af dit humør. Den fleksibilitet er en styrke, så længe du kan sige til, når du ikke er helt på toppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist anpassungsfähig und stimmungsgesteuert. Diese Flexibilität ist eine Stärke, solange du sagen kannst, wenn du mal „neben der Spur“ bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόζεσαι και σε οδηγεί η διάθεση. Αυτή η ευελιξία είναι δύναμη, αρκεί να μπορείς να λες πότε δεν είσαι στα καλά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te adaptas y te guías por tu estado de ánimo. Esa flexibilidad es una fortaleza, siempre que puedas avisar cuando no estás en tu mejor día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet sopeutuvainen ja mielialan mukaan menevä. Joustavuus on vahvuus, kunhan osaat kertoa, milloin et ole vireessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madali kang umangkop at sumusunod ka sa mood mo. Lakas ang ganyang flexibility basta nasasabi mo kapag “wala ka sa mood”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'adaptes et tu suis ton humeur. Cette souplesse est une force, tant que tu sais dire quand tu n'es « pas dans ton assiette »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך יכולת הסתגלות, והכול לפי מצב הרוח. הגמישות הזאת היא חוזקה, כל עוד יודעים לומר כשהיום פחות טוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ढल जाते हैं और मूड के हिसाब से चलते हैं। यह लचीलापन एक ताक़त है, बशर्ते आप बता सकें कि कब आपका दिन “ठीक नहीं” है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmazkodó vagy, és sokat számít a hangulatod. Ez a rugalmasság erősség, amíg jelezni tudod, ha épp „nem vagy formában”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu adaptif dan mengikuti mood. Fleksibilitas itu kekuatan, asal kamu bisa bilang saat sedang “nggak on”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti adatti e segui l’umore. Questa flessibilità è un punto di forza, purché tu sappia dire quando sei «fuori fase»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分に合わせて順応するタイプです。調子が「イマイチ」なときにそれを伝えられれば、その柔軟さは強みになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분 따라 유연하게 맞추는 타입이에요. 컨디션이 ‘별로’일 때 그걸 말할 수만 있다면 그 유연함은 장점이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mudah menyesuaikan diri dan mengikut perasaan. Kefleksibelan itu satu kekuatan asalkan anda boleh memberitahu apabila anda ‘tidak berapa okey’."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er tilpasningsdyktig og styres av humøret. Den fleksibiliteten er en styrke, så lenge du kan si fra når du har en dårlig dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij past je aan en volgt je gevoel. Die flexibiliteit is een kracht, zolang je kunt laten weten wanneer je ‘off’ bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
