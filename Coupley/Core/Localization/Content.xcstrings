    "Mixed — some family I'm close to, others I'm not" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزيج: قرب من بعضهم وبُعد عن آخرين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
