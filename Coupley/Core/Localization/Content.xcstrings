    "Text a memory of a good day you had together." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلوا ذكرى يوم جميل قضيتماه معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiš protějšku vzpomínku na nějaký váš krásný den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send en besked om et minde fra en god dag, I havde sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick deinem Schatz eine Erinnerung an einen schönen gemeinsamen Tag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλε μια ανάμνηση από μια ωραία μέρα που περάσατε μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíale un mensaje con el recuerdo de un buen día juntos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä muisto hyvästä yhteisestä päivästä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-text ang alaala ng isang masayang araw ninyong dalawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie-lui le souvenir d'une belle journée passée ensemble."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשלוח הודעה עם זיכרון מיום טוב שהיה לכם ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ बिताए किसी अच्छे दिन की याद मैसेज करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írd meg neki egy közös szép nap emlékét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim pesan tentang kenangan hari indah kalian berdua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi un ricordo di una bella giornata passata insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで過ごした楽しい日の思い出をメッセージで送りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 보낸 좋은 날의 추억을 메시지로 보내 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hantar mesej tentang kenangan hari indah yang pernah anda lalui bersama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send et minne fra en fin dag dere hadde sammen."
          }
        },
        "nl" : {
