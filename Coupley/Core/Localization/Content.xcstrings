          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mande uma lembrança de um dia bom que vocês viveram."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimite-i amintirea unei zile bune petrecute împreună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напиши о каком-нибудь хорошем дне, проведённом вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
