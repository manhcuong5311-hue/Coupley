        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanin kai na gaskiya. Kuna sha'awar yin abu kwatsam amma a zahiri kun fi aiki da kyau idan an ba ku lokaci."
