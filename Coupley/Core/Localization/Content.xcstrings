        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በተፈጥሮ ወደፊትን ያስባሉ። ትልቅ መጠባበቂያ ሲኖርዎት ይበልጥ ደህንነት ይሰማዎታል። ይህ ጠቃሚ ነው — በተለይ አጋርዎ ወደ ማውጣት የሚያደሉ ከሆነ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تركيزكم على المستقبل بالفطرة. تشعرون بأمان أكبر مع وسادة مالية أكبر. هذا قيّم، خاصة إن كان شريكك يميل إلى الإنفاق."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বভাৱতে ভৱিষ্যতমুখী। ডাঙৰ আশ্ৰয় থাকিলে আপুনি বেছি নিৰাপদ অনুভৱ কৰে। এয়া মূল্যৱান — বিশেষকৈ যদি আপোনাৰ সংগী খৰচৰ ফালে হালি থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnstinktiv olaraq gələcəyə baxırsan. Böyük ehtiyatla özünü daha təhlükəsiz hiss edirsən. Bu, dəyərlidir — xüsusən partnyorun xərcləməyə meyillidirsə."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інстынктыўна думаеш пра будучыню. Табе спакайней з большай падушкай. Гэта каштоўна — асабліва калі палавінка схільная траціць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстинктивно мислиш за бъдещето. С по-голяма възглавница се чувстваш по-сигурно. Това е ценно – особено ако половинката ти е по-склонна да харчи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বভাবতই ভবিষ্যৎমুখী। বড় একটা সুরক্ষা থাকলে তুমি বেশি নিরাপদ বোধ করো। এটা মূল্যবান — বিশেষ করে তোমার পার্টনার যদি খরচের দিকে একটু ঝুঁকে থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktivno gledaš u budućnost. S većim jastukom se osjećaš sigurnije. To je vrijedno – naročito ako voljena osoba naginje trošenju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mires al futur per instint. Et dona més seguretat tenir un coixí més gran. Això és valuós — sobretot si la teva parella tira més a gastar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktivně myslíš na budoucnost. S větším polštářem se cítíš bezpečněji. To má cenu – zvlášť pokud tvůj protějšek tíhne k utrácení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yn edrych tua'r dyfodol yn reddfol. Rwyt ti'n teimlo'n fwy diogel gyda chlustog fwy. Mae hynny'n werthfawr — yn enwedig os yw dy bartner yn tueddu i wario."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er fremtidsorienteret af instinkt. Du føler dig mere tryg med en større buffer. Det er værdifuldt – især hvis din partner hælder mod at bruge penge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktiv zukunftsorientiert. Mit einem größeren Polster fühlst du dich sicherer. Das ist wertvoll – besonders, wenn dein Schatz eher gern ausgibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιτάς το μέλλον από ένστικτο. Νιώθεις πιο ασφαλώς με ένα μεγαλύτερο μαξιλάρι. Έχει αξία — ειδικά αν το ταίρι σου γέρνει προς τα έξοδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por instinto, miras al futuro. Un buen colchón te da tranquilidad. Eso tiene valor, sobre todo si tu pareja tiende a gastar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktiivselt tulevikku vaatav. Suurema puhvriga tunned end turvalisemalt. See on väärtuslik — eriti kui su partner kaldub kulutama."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berez etorkizunari begira. Seguruago sentitzen zara kuxin handiago batekin. Baliotsua da hori — batez ere zure bikotekidea gastatzera jotzen badu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌طور غریزی به آینده نگاهی. با پشتوانهٔ بزرگ‌تر احساس امنیت بیشتری می‌کنی. این ارزشمند است — مخصوصاً اگر پارتنرت بیشتر اهل خرج کردن باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaistomaisesti tulevaisuuteen suuntautunut. Tunnet olosi turvallisemmaksi isomman puskurin kanssa. Se on arvokasta – etenkin jos kumppanisi käyttää rahaa herkemmin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likas kang nakatingin sa hinaharap. Mas panatag ka kapag mas malaki ang reserba. Mahalaga iyan — lalo na kung mahilig gumastos ang partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinctivement, tu penses à l'avenir. Un bon matelas te rassure. C'est précieux, surtout si l'autre a plutôt tendance à dépenser."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dírithe ar an todhchaí ó nádúr. Mothaíonn tú níos sábháilte le cúltaca níos mó. Is luachmhar é sin — go háirithe má bhíonn claonadh ag do pháirtí chun caiteachais."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensas no futuro por instinto. Un colchón maior dáche tranquilidade. Iso é valioso, sobre todo se a túa parella tira máis ao gasto."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્વભાવથી જ ભવિષ્ય પર ધ્યાન. મોટો ટેકો હોય તો તમને વધુ સલામતી લાગે છે. એ કીમતી છે — ખાસ કરીને જો તમારા પાર્ટનરનો ઝુકાવ ખર્ચ તરફ હોય."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna duban gaba ta ɗabi'a. Kuna jin tsaro da babbar ajiya. Wannan na da amfani — musamman idan abokin zamanku ya fi karkata ga kashewa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מבט לעתיד מתוך אינסטינקט. כרית גדולה יותר נותנת לך ביטחון. זה יקר ערך — במיוחד אם הצד השני נוטה להוציא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वभाव से भविष्य पर नज़र। बड़ा सहारा होने पर आप ज़्यादा सुरक्षित महसूस करते हैं। यह क़ीमती है — ख़ासकर अगर पार्टनर का झुकाव ख़र्च की तरफ़ हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktivno misliš na budućnost. Uz veći jastuk osjećaš se sigurnije. To je vrijedno – osobito ako voljena osoba naginje trošenju."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou gade lavni pa ensten. Ou santi ou pi an sekirite ak yon pi gwo kousen. Sa gen valè — sitou si patnè ou gen tandans depanse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ösztönösen a jövőre koncentrálsz. Nagyobb tartalékkal biztonságban érzed magad. Ez értékes – főleg, ha a párod inkább a költés felé hajlik."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բնազդով ապագային ես նայում։ Ավելի մեծ պաշարով քեզ ավելի ապահով ես զգում։ Սա արժեքավոր է — հատկապես, եթե զուգընկերդ հակված է ծախսելու։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara naluri kamu fokus ke masa depan. Kamu merasa lebih aman dengan bantalan yang lebih besar. Itu berharga — apalagi kalau pasanganmu cenderung suka belanja."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ele ọdịnihu anya n'onwe gị. Ọ na-adị gị mma karịa mgbe e nwere ego nchekwa ka ukwuu. Nke ahụ bara uru — karịsịa ma ọ bụrụ na onye gị na-ahọrọ imefu ego."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Með augun á framtíðinni að eðlisfari. Þér líður betur með stærri varasjóð. Það er dýrmætt – sérstaklega ef makinn þinn hallast frekar að eyðslu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per istinto guardi al futuro. Ti senti più al sicuro con un cuscinetto più grande. È prezioso — soprattutto se il tuo partner tende a spendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本能的に未来を見ているタイプです。蓄えが多いほど安心できます。特にパートナーが使う派なら、とても心強い存在です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanthi naluri mikir adoh ngarep. Panjenengan rumangsa luwih aman karo cadhangan sing luwih gedhe. Kuwi aji — luwih-luwih yen pasangan luwih seneng mbuwang dhuwit."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ინსტინქტურად მომავალზე ხარ ორიენტირებული. დიდ მარაგთან ერთად თავს უფრო დაცულად გრძნობ. ეს ღირებულია — განსაკუთრებით, თუ პარტნიორი ხარჯვისკენ იხრება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түйсігің болашаққа бағытталған. Жастығың қалыңырақ болса, өзіңді қауіпсіз сезінесің. Бұл құнды — әсіресе серігің жұмсауға бейім болса."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ដោតលើអនាគតតាមសភាវគតិ។ អ្នកមានអារម្មណ៍សុវត្ថិភាពជាង ពេលមានលុយបម្រុងច្រើន។ នោះមានតម្លៃ — ជាពិសេសបើដៃគូរបស់អ្នកចូលចិត្តចាយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಹಜವಾಗಿಯೇ ಭವಿಷ್ಯದ ಮೇಲೆ ಗಮನ. ದೊಡ್ಡ ಆಸರೆ ಇದ್ದಾಗ ನಿಮಗೆ ಹೆಚ್ಚು ಸುರಕ್ಷಿತ ಅನಿಸುತ್ತದೆ. ಅದು ಅಮೂಲ್ಯ — ವಿಶೇಷವಾಗಿ ನಿಮ್ಮ ಸಂಗಾತಿ ಖರ್ಚಿನತ್ತ ವಾಲಿದ್ದರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본능적으로 미래를 바라봐요. 여유 자금이 넉넉할수록 마음이 놓이죠. 특히 연인이 쓰는 걸 좋아하는 편이라면 소중한 성향이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi xwezayî li pêşerojê hûr. Bi balîfeke mezintir tu xwe ewletir hîs dikî. Ev bi qîmet e — bi taybetî heke hevjînê te ber bi xerckirinê ve diçe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстинктиң келечекке багытталган. Запасың чоң болгондо өзүңдү коопсуз сезесиң. Бул баалуу — айрыкча сүйгөнүң акча коротууга жакын болсо."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktiv op d'Zukunft ausgeriicht. Mat engem méi décke Polster fills du dech méi sécher. Dat ass vill wäert — besonnesch wann däi Schatz éischter gär ausgëtt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເບິ່ງໄກໂດຍສັນຊາດຕະຍານ ເຈົ້າຮູ້ສຶກປອດໄພກວ່າເມື່ອມີເງິນສຳຮອງຫຼາຍຂຶ້ນ ນັ້ນມີຄຸນຄ່າ — ໂດຍສະເພາະຖ້າຄູ່ຂອງເຈົ້າມັກໃຊ້ຈ່າຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktyviai žvelgi į ateitį. Su didesne pagalve jautiesi saugiau. Tai vertinga – ypač jei antroji pusė linkusi išlaidauti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu instinktīvi domā par nākotni. Ar lielāku drošības spilvenu tu jūties drošāk. Tas ir vērtīgi – īpaši, ja otrā puse vairāk tiecas tērēt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijery ny ho avy ho azy ianao. Mahatsapa ho voaaro kokoa ianao raha lehibe kokoa ny tahiry. Sarobidy izany — indrindra raha mora mandany ny olon-tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka aro koe ki te anamata mā te parapara. Ka haumaru ake koe me te urunga nui ake. He mea nui tēnā — ina koa he hoa aroha tōu e tītaha ana ki te whakapau."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстинктивно гледаш кон иднината. Со поголема резерва се чувствуваш посигурно. Тоа е вредно — особено ако половинката е склона кон трошење."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സഹജമായിത്തന്നെ ഭാവിയിലാണ് നിങ്ങളുടെ ശ്രദ്ധ. വലിയൊരു കരുതൽ ഉള്ളപ്പോൾ നിങ്ങൾക്ക് കൂടുതൽ സുരക്ഷിതത്വം തോന്നും. അത് വിലപ്പെട്ടതാണ് — പ്രത്യേകിച്ച് പങ്കാളിക്ക് ചെലവാക്കാനുള്ള ചായ്‌വുണ്ടെങ്കിൽ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зөн совингоороо ирээдүйд чиглэсэн. Илүү том нөөцтэй байхад чи өөрийгөө аюулгүй мэдэрдэг. Энэ үнэ цэнэтэй — ялангуяа хань чинь зарцуулах тал руугаа бол."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वभावतः भविष्याचा विचार. मोठा आधार असला की तुम्हाला सुरक्षित वाटते. हे मोलाचे आहे — विशेषतः जोडीदाराचा कल खर्चाकडे असेल तर."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara naluri anda memikirkan masa depan. Anda rasa lebih selamat dengan simpanan yang lebih besar. Itu berharga — terutamanya jika pasangan anda cenderung berbelanja."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tħares lejn il-futur bl-istint. Kuxin akbar jagħtik aktar serħan. Dan għandu valur — speċjalment jekk il-partner tiegħek għandu tendenza jonfoq."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သဘာဝအတိုင်း အနာဂတ်ကို အာရုံစိုက်တယ်။ အရံငွေ များလေ စိတ်ချရလေပါ။ ဒါ တန်ဖိုးရှိတယ် — အထူးသဖြင့် ချစ်သူက သုံးစွဲဘက် ယိမ်းနေရင်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framtidsrettet av instinkt. Du føler deg tryggere med en større buffer. Det er verdifullt – særlig hvis partneren din heller mot å bruke penger."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वभावैले भविष्यमा केन्द्रित। बचत धेरै हुँदा तपाईं सुरक्षित महसुस गर्नुहुन्छ। यो मूल्यवान् छ — खासगरी तपाईंको पार्टनर खर्चतिर ढल्किनुहुन्छ भने।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bent instinctief op de toekomst gericht. Met een grotere buffer voel je je veiliger. Dat is waardevol – zeker als je partner meer neigt naar uitgeven."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwachibadwa mumaganizira za mtsogolo. Mumamva otetezeka mukakhala ndi zosunga zambiri. Nchamtengo wapatali — makamaka ngati wokondedwa wanu amakonda kugula."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uumamaan egeree ilaalta. Kuusaan guddaan nageenya siif kenna. Kun gatii qaba — keessumaa jaalallee baasii jaallataa wajjin."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ୱଭାବତଃ ଭବିଷ୍ୟତମୁଖୀ। ବଡ଼ ସଞ୍ଚୟ ଥିଲେ ଆପଣ ଅଧିକ ସୁରକ୍ଷିତ ଅନୁଭବ କରନ୍ତି। ଏହା ମୂଲ୍ୟବାନ — ବିଶେଷକରି ଆପଣଙ୍କ ସାଥୀ ଖର୍ଚ୍ଚ ଆଡ଼କୁ ଝୁଙ୍କୁଥିଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੁਭਾਅ ਤੋਂ ਹੀ ਭਵਿੱਖ ਉੱਤੇ ਨਜ਼ਰ। ਵੱਡੇ ਸਹਾਰੇ ਨਾਲ ਤੁਸੀਂ ਵੱਧ ਸੁਰੱਖਿਅਤ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ। ਇਹ ਕੀਮਤੀ ਹੈ — ਖ਼ਾਸ ਕਰਕੇ ਜੇ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਦਾ ਝੁਕਾਅ ਖ਼ਰਚ ਵੱਲ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instynktownie myślisz o przyszłości. Większa poduszka daje ci poczucie bezpieczeństwa. To cenne – zwłaszcza jeśli druga połówka lubi wydawać."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په فطرت د راتلونکي پر لور. له لویې زېرمې سره د ډېر خوندیتوب احساس کوئ. دا ارزښتناک دی — په ځانګړې توګه که ستاسو ملګری لګښت ته لېوال وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco no futuro por instinto. Uma boa reserva traz mais segurança para você. Isso tem valor — principalmente se seu amor tende a gastar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focas-te no futuro por instinto. Sentes mais segurança com uma almofada maior. Isso tem valor — sobretudo se o teu par tende a gastar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din instinct, te uiți spre viitor. Te simți mai în siguranță cu o rezervă mai mare. E un lucru valoros — mai ales dacă partenerul tău înclină spre cheltuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты инстинктивно думаешь о будущем. С подушкой побольше тебе спокойнее. Это ценно — особенно если партнёр склонен тратить."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ureba ejo hazaza ku bwa kamere. Wumva utekanye iyo ufite ubwizigame bunini. Ibyo bifite agaciro — cyane cyane niba umukunzi wawe akunda gukoresha."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සහජයෙන්ම අනාගතය ගැන හිතනවා. ලොකු ඉතිරියක් තියෙනකොට ඔබට වඩා ආරක්ෂිත බවක් දැනෙනවා. ඒක වටිනවා — විශේෂයෙන් ඔබේ සහකරු වියදම් කරන්න නැඹුරු නම්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inštinktívne myslíš na budúcnosť. S väčším vankúšom sa cítiš bezpečnejšie. To je cenné – najmä ak tvoja polovička inklinuje k míňaniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagonsko gledaš v prihodnost. Z večjo blazino se počutiš varneje. To je dragoceno – sploh če je tvoj partner bolj nagnjen k zapravljanju."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotarisa ramangwana nemasikirwo. Unonzwa wakachengeteka kana mari yakachengetwa yakawanda. Izvi zvinokosha — kunyanya kana mudiwa wako achida kushandisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabeecad ahaan mustaqbalka ayaad eegtaa. Waxaad dareentaa ammaan marka kaydku weyn yahay. Taasi waa qiimo leh — gaar ahaan haddii lammaanahaagu u janjeero kharash-bixinta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinkti yt shikon nga e ardhmja. Një jastëk më i madh të jep më shumë siguri. Kjo ka vlerë – sidomos nëse partneri yt anon nga shpenzimi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстинктивно гледаш у будућност. Осећаш се сигурније уз већи јастук. То је драгоцено — нарочито ако твоја половина нагиње трошењу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naluri anjeun museur ka hareup. Anjeun ngaraos langkung aman sareng cadangan anu langkung ageung. Éta aji — utamina upami pasangan anjeun condong resep ngaluarkeun artos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framtidsfokuserad av instinkt. Du känner dig tryggare med en större buffert. Det är värdefullt – särskilt om din partner lutar åt att spendera."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwa silika unaangalia mbele. Unajisikia salama zaidi ukiwa na akiba kubwa. Hilo lina thamani — hasa kama mwenzi wako huelekea kutumia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இயல்பாகவே எதிர்காலத்தை நோக்குபவர். பெரிய கையிருப்பு இருக்கும்போது பாதுகாப்பாக உணர்கிறீர்கள். அது மதிப்புமிக்கது — குறிப்பாக உங்கள் துணை செலவு செய்யும் பக்கம் சாய்ந்தால்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సహజంగానే భవిష్యత్తు మీద దృష్టి. ఎక్కువ నిల్వ ఉంటే మీకు భద్రంగా అనిపిస్తుంది. అది విలువైనది — ముఖ్యంగా మీ భాగస్వామి ఖర్చు వైపు మొగ్గితే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба таври ғаризӣ ба оянда нигаронида. Бо захираи калонтар ту худро бехатартар ҳис мекунӣ. Ин арзишманд аст — махсусан агар ёрат ба харҷ кардан майл дошта бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมองไปข้างหน้าโดยสัญชาตญาณ และรู้สึกปลอดภัยขึ้นเมื่อมีเงินกันชนมากขึ้น ซึ่งมีค่ามาก โดยเฉพาะถ้าคนรักเป็นสายใช้จ่าย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብባህሪኹም ናብ መጻኢ ትጥምቱ። ዝዓበየ መዕቖቢ ምስ ዝህልወኩም ዝያዳ ውሕስነት ይስምዓኩም። እዚ ክቡር እዩ — ብፍላይ መጻምድኹም ናብ ምጥቃም ዘድህቡ እንተኾይኖም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebigatyňdan geljegi pikir edýärsiň. Ätiýaçlygyň uly bolsa, özüňi has howpsuz duýýarsyň. Bu gymmatly — esasan hem söýgüliň harçlamaga ýykgyn edýän bolsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçgüdüsel olarak geleceğe odaklısın. Daha büyük bir yastıkla kendini daha güvende hissediyorsun. Bu değerli, özellikle partnerin harcamaya yatkınsa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти інстинктивно дивишся в майбутнє. З більшою подушкою тобі спокійніше. Це цінно — особливо якщо твоя половинка схильна витрачати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فطرتاً مستقبل پر نظر۔ بڑا سہارا ہو تو آپ کو زیادہ تحفظ محسوس ہوتا ہے۔ یہ قیمتی ہے — خاص طور پر اگر آپ کا ساتھی خرچ کرنے کی طرف مائل ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabiatan kelajakni oʻylaysiz. Zaxirangiz kattaroq boʻlsa, oʻzingizni xavfsizroq his qilasiz. Bu qimmatli — ayniqsa, sherigingiz sarflashga moyil boʻlsa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản năng hướng về tương lai. Bạn thấy an toàn hơn với một khoản đệm lớn hơn. Điều đó rất quý — nhất là khi người ấy thiên về chi tiêu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujolise kwikamva ngokwemvelo. Uziva ukhuselekile ngakumbi xa unemali egciniweyo eninzi. Oko kuxabisekile — ingakumbi ukuba iqabane lakho lithanda ukuchitha."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń wo ọjọ́ iwájú láti inú ẹ̀mí. Ọkàn yín balẹ̀ jù pẹ̀lú owó ìpamọ́ tó pọ̀. Ìyẹn wúlò — pàápàá bí olólùfẹ́ yín bá fẹ́ràn ìnáwó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你天生著眼將來，積蓄越多越有安全感。這很可貴，尤其如果另一半比較愛花錢的話。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你本能地着眼未来。积蓄越多，你越安心。这很可贵——尤其当另一半偏爱花钱时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你天生著眼未來，存款越多越有安全感。這很可貴，尤其如果另一半比較愛花錢的話。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngokwemvelo ugxile ekusasa. Uzizwa uphephile kakhudlwana uma unesiqiwu esikhulu. Lokho kubalulekile — ikakhulukazi uma umlingani wakho ethambekele ekusebenziseni imali."
          }
        }
      }
    },
    "Games as a general love. You probably appreciate any kind of play — which is a good instinct in a relationship too." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy is lief vir speletjies in die algemeen. Jy waardeer waarskynlik enige soort spel – en dis ook in ’n verhouding ’n goeie instink."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጨዋታን በአጠቃላይ ይወዳሉ። ምናልባት ማንኛውንም ዓይነት ጨዋታ ያደንቃሉ — ይህ በግንኙነትም ውስጥ ጥሩ ባሕርይ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حب للعب بكل أشكاله. على الأرجح يمتعك أي نوع من اللعب، وهذه غريزة جميلة في العلاقة أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলৰ প্ৰতি সাধাৰণ প্ৰেম। আপুনি হয়তো যিকোনো ধৰণৰ খেল উপভোগ কৰে — যিটো সম্পৰ্কতো এটা ভাল স্বভাৱ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunları ümumiyyətlə sevirsən. Yəqin ki, hər cür oyunu qiymətləndirirsən — bu, münasibətdə də yaxşı instinktdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любоў да гульняў увогуле. Ты, мусіць, цэніш любую гульню — і гэта добры інстынкт і ў адносінах."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обичаш игрите изобщо. Вероятно цениш всякакъв вид игра – а това е добър инстинкт и във връзката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলা সবরকমেই ভালোবাসো। সম্ভবত যেকোনো ধরনের মজার খেলাই তোমার ভালো লাগে — সম্পর্কেও এটা ভালো একটা প্রবৃত্তি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubav prema igri općenito. Vjerovatno cijeniš svaki oblik igre – a to je dobar instinkt i u vezi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els jocs t'encanten en general. Segurament gaudeixes de qualsevol mena de joc — i això també és un bon instint en una relació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hry miluješ obecně. Nejspíš oceníš jakoukoli hravost – a to je dobrý instinkt i ve vztahu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cariad at gemau o bob math. Mae'n debyg dy fod yn gwerthfawrogi unrhyw fath o chwarae — sy'n reddf dda mewn perthynas hefyd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du elsker spil generelt. Du sætter nok pris på al slags leg – og det er også et godt instinkt i et forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du liebst Spiele ganz allgemein. Wahrscheinlich magst du jede Form von Spiel – ein guter Instinkt, auch in einer Beziehung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγαπάς γενικά το παιχνίδι. Μάλλον εκτιμάς κάθε είδους παιχνίδι — και αυτό είναι καλό ένστικτο και σε μια σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te encanta jugar en general. Seguramente disfrutas de cualquier tipo de juego — y eso también es un buen instinto en una relación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mängud on sulle üldiselt armsad. Hindad ilmselt igasugust mängulisust — mis on hea instinkt ka suhtes."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokoak, oro har, maite dituzu. Ziurrenik edozein jolas mota estimatzen duzu, eta hori sen ona da harreman batean ere."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشق به بازی در کل. احتمالاً از هر نوع بازی و شیطنتی لذت می‌بری — که در رابطه هم غریزهٔ خوبی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakastat pelejä yleensä. Arvostat luultavasti kaikenlaista leikkiä – mikä on hyvä vaisto parisuhteessakin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahilig ka sa laro, kahit anong klase. Malamang pinahahalagahan mo ang anumang uri ng paglalaro — magandang ugali rin ’yan sa relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'amour du jeu en général. Tu apprécies sûrement toute forme de jeu — et c'est aussi un bon réflexe en couple."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grá do chluichí i gcoitinne. Is dócha go dtaitníonn spraoi de chineál ar bith leat — agus is nós maith é sin i gcaidreamh freisin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encántanche os xogos en xeral. Seguramente valoras calquera forma de xogo, e iso tamén é un bo instinto nunha relación."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રમત માટે સામાન્ય પ્રેમ. તમને કદાચ કોઈ પણ પ્રકારની રમત ગમે છે — જે સંબંધમાં પણ સારી વૃત્તિ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna son wasa gaba ɗaya. Wataƙila kuna jin daɗin kowane irin wasa — kuma wannan ɗabi'a ce mai kyau a soyayya ma."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אהבה כללית למשחק. כנראה שכל סוג של משחקיות מדבר אליך — וזה אינסטינקט טוב גם בזוגיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेल से प्यार, हर रूप में। हर तरह का खेल शायद आपको भाता है — और रिश्ते में भी यह अच्छी आदत है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubav prema igri općenito. Vjerojatno cijeniš svaku vrstu igre – što je dobar instinkt i u vezi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou renmen jwe an jeneral. Ou gendwa apresye tout kalite jwèt — e se yon bon reflèks nan yon relasyon tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy általában szereted a játékot. Valószínűleg mindenféle játékosságot értékelsz – ami egy kapcsolatban is jó ösztön."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խաղերի հանդեպ ընդհանուր սեր։ Հավանաբար գնահատում ես ցանկացած տեսակի խաղ, և դա լավ բնազդ է նաև հարաբերություններում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu cinta segala jenis permainan. Kamu mungkin menghargai semua bentuk bermain — dan itu naluri yang baik dalam hubungan juga."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị hụrụ egwuregwu n'anya n'ozuzu. O nwere ike ịbụ na ụdị egwu ọ bụla na-atọ gị ụtọ — nke ahụ bụkwa ezigbo agwa na mmekọrịta."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikir í víðum skilningi. Þú kannt líklega að meta hvers kyns leik – sem er góð eðlisávísun í sambandi líka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami il gioco in tutte le sue forme. Probabilmente apprezzi ogni tipo di divertimento — un ottimo istinto anche in una relazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊ぶこと全般が好きな人です。どんな遊びも楽しめるはず。その感覚は恋愛でも大切な強みです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneng dolanan apa wae. Mbokmenawa panjenengan ngajeni samubarang dolanan — lan iku naluri sing apik uga ing sesambungan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თამაში ზოგადად გიყვარს. ალბათ, ნებისმიერ თამაშს აფასებ — და ეს ურთიერთობაშიც კარგი ინსტინქტია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойынды жалпы жақсы көресің. Ойынның кез келген түрін бағалайтын шығарсың, ал бұл қарым-қатынаста да жақсы қасиет."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្រឡាញ់ការលេងជាទូទៅ។ អ្នកប្រហែលជាចូលចិត្តការលេងគ្រប់ប្រភេទ — ដែលជាសភាវគតិល្អនៅក្នុងទំនាក់ទំនងផងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಟಗಳೆಂದರೆ ಒಟ್ಟಾರೆ ಪ್ರೀತಿ. ನಿಮಗೆ ಯಾವುದೇ ರೀತಿಯ ಆಟ ಇಷ್ಟವಾಗುತ್ತದೆ — ಸಂಬಂಧದಲ್ಲೂ ಇದು ಒಳ್ಳೆಯ ಗುಣ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 자체를 사랑해요. 아마 어떤 놀이든 즐길 줄 알 텐데, 그건 연애에서도 좋은 본능이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hezkirineke giştî ji lîstikan. Belkî tu qedrê her cure lîstikê digirî — û ev di têkiliyê de jî hestekî baş e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оюнду жалпы эле жакшы көрөсүң. Ар кандай ойноону баалайсың окшойт — бул мамиледе да жакшы сапат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiller allgemeng gär. Du schätz wahrscheinlech all Form vu Spill — an dat ass och an enger Bezéiung e gudden Instinkt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮັກການຫຼິ້ນທຸກຮູບແບບ ເຈົ້າຄົງເຫັນຄຸນຄ່າຂອງການຫຼິ້ນທຸກປະເພດ — ເຊິ່ງເປັນສັນຊາດຕະຍານທີ່ດີໃນຄວາມສຳພັນເຊັ່ນກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilė žaidimams apskritai. Tikriausiai vertini bet kokį žaidimą – o tai geras instinktas ir santykiuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mīlestība pret spēlēm kopumā. Tu droši vien novērtē jebkādu rotaļu – un tas ir labs instinkts arī attiecībās."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tia lalao amin'ny ankapobeny. Azo inoana fa ankafizinao ny karazana lalao rehetra — toetra tsara koa izany ao amin'ny fifandraisana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He aroha whānui ki ngā kēmu. Ka pai pea ki a koe ngā momo tākaro katoa — he āhua pai anō tēnā i roto i te hononga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Љубов кон игрите воопшто. Веројатно уживаш во секаков вид игра — што е добар инстинкт и во врска."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കളികളോട് പൊതുവെ ഇഷ്ടം. ഏതുതരം കളിയും നിങ്ങൾ ആസ്വദിക്കുന്നുണ്ടാകും — ഒരു ബന്ധത്തിലും അത് നല്ലൊരു സ്വഭാവമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ерөөсөө тоглоомд дуртай. Чи ямар ч төрлийн тоглоомыг үнэлдэг байх — энэ нь харилцаанд ч сайн зөн совин."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेळांवर सर्वसाधारण प्रेम. तुम्हाला बहुधा कोणताही खेळ आवडतो — आणि नात्यातही ही चांगली वृत्ती आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memang suka bermain. Anda mungkin menghargai apa jua bentuk permainan — naluri yang bagus dalam hubungan juga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imħabba għal-logħob b'mod ġenerali. Probabbilment tapprezza kull tip ta' logħob — instint tajjeb f'relazzjoni wkoll."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂိမ်းမှန်သမျှကို ချစ်တယ်။ ဘယ်လို ကစားခြင်းမျိုးကိုမဆို တန်ဖိုးထားလောက်တယ် — ဒါက ဆက်ဆံရေးမှာလည်း ကောင်းတဲ့ ပင်ကိုစိတ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du elsker spill generelt. Du setter nok pris på all slags lek – og det er et godt instinkt i et forhold også."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेलप्रति सामान्य माया। सायद तपाईंलाई जुनसुकै खेल मन पर्छ — जुन सम्बन्धमा पनि राम्रो बानी हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt van spelen in het algemeen. Je waardeert vast elke vorm van spel – en dat is in een relatie ook een goed instinct."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakonda masewera onse. Mwina mumayamikira mtundu uliwonse wa kusewera — chomwe ndi chibadwa chabwino m'chibwenzi nachonso."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taphoota walumaan jaallatta. Tarii tapha gosa kamiyyuu ni dinqisiifatta — kunis hariiroo keessattis amala gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଖେଳ ପ୍ରତି ସାଧାରଣ ଭଲପାଇବା। ଆପଣ ସମ୍ଭବତଃ ଯେକୌଣସି ପ୍ରକାର ଖେଳକୁ ଆଦର କରନ୍ତି — ଯାହା ସମ୍ପର୍କରେ ବି ଏକ ଭଲ ସ୍ୱଭାବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਖੇਡਾਂ ਨਾਲ ਆਮ ਪਿਆਰ। ਤੁਹਾਨੂੰ ਸ਼ਾਇਦ ਹਰ ਤਰ੍ਹਾਂ ਦਾ ਖੇਡਣਾ ਪਸੰਦ ਹੈ — ਜੋ ਰਿਸ਼ਤੇ ਵਿੱਚ ਵੀ ਇੱਕ ਚੰਗੀ ਆਦਤ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miłość do gier w ogóle. Pewnie doceniasz każdą formę zabawy – a to dobry instynkt także w związku."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په ټوله کې له لوبو سره مینه. شاید هر ډول لوبه خوښوئ — چې په اړیکه کې هم ښه خصلت دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amor pelos jogos em geral. Você provavelmente curte qualquer tipo de brincadeira — um ótimo instinto numa relação também."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um amor por jogos em geral. Deves gostar de qualquer forma de brincar — o que é um bom instinto numa relação também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iubești jocul în general. Probabil apreciezi orice fel de joacă — iar ăsta e un instinct bun și într-o relație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любовь к играм в целом. Ты, наверное, ценишь любую игру — и в отношениях это тоже хороший инстинкт."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunda imikino muri rusange. Birashoboka ko wishimira uburyo bwose bwo gukina — kandi ibyo ni byiza no mu rukundo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සෙල්ලමට පොදු ආදරයක්. ඔබ ඕනෑම විදිහක සෙල්ලමක් අගය කරනවා ඇති — ඒක සබඳතාවකටත් හොඳ ස්වභාවයක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hry ako celková láska. Asi oceníš akúkoľvek hru – a to je dobrý inštinkt aj vo vzťahu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubezen do iger na splošno. Verjetno ceniš vsako obliko igre – kar je dober nagon tudi v odnosu."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda mitambo yose. Zvimwe unofarira mhando ipi neipi yekutamba — chinovawo chimiro chakanaka murudo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciyaaraha guud ahaan waad jeceshahay. Malaha waad qiimeysaa nooc kasta oo ciyaar ah — taasina waa dabeecad wanaagsan xitaa xiriirka dhexdiisa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dashuri për lojën në përgjithësi. Ndoshta të pëlqen çdo lloj loje – instinkt i mirë edhe në një marrëdhënie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игре волиш уопште. Вероватно цениш сваку врсту игре — а то је добар инстинкт и у вези."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resep kana kaulinan sacara umum. Anjeun meureun ngahargaan sagala rupi ulin, sareng éta naluri anu saé dina hubungan ogé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du älskar spel i allmänhet. Du uppskattar nog all slags lek – och det är en bra instinkt i en relation också."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unapenda michezo kwa ujumla. Huenda unathamini aina yoyote ya kucheza — na hiyo ni silika nzuri katika uhusiano pia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விளையாட்டின் மீது பொதுவான நேசம். எந்த வகை விளையாட்டையும் நீங்கள் ரசிப்பீர்கள் — இது உறவிலும் நல்ல இயல்பு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆటలంటే మొత్తంగా ఇష్టం. ఏ రకమైన ఆటనైనా మీరు ఆస్వాదిస్తారు — బంధంలోనూ ఇది మంచి లక్షణమే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бозӣ ҳамчун муҳаббати умумӣ. Эҳтимол ту ҳар гуна бозиро қадр мекунӣ — ва ин дар муносибат ҳам ғаризаи хуб аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรักเกมในภาพรวม น่าจะชอบการเล่นทุกรูปแบบ ซึ่งเป็นสัญชาตญาณที่ดีในความสัมพันธ์ด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጸወታ ብሓፈሻ ትፈትዉ። ምናልባት ዝኾነ ዓይነት ጸወታ ተድንቑ — እዚ ድማ ኣብ ርክብ'ውን ጽቡቕ ባህሪ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oýunlara umumy söýgi. Megerem, oýnuň islendik görnüşini gowy görýänsiň — bu gatnaşykda hem gowy häsiýet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunu genel olarak seviyorsun. Muhtemelen her türlü oyunun kıymetini biliyorsun; bu bir ilişkide de iyi bir içgüdü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любов до ігор загалом. Тобі, мабуть, до душі будь-яка гра — і в стосунках це теж добрий інстинкт."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھیل سے عمومی محبت۔ آپ کو شاید ہر طرح کا کھیل اچھا لگتا ہے، اور رشتے میں بھی یہ ایک اچھی جبلت ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻyinlarga umumiy muhabbat. Ehtimol, har qanday oʻyinni qadrlaysiz — bu munosabatlarda ham yaxshi xislat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn yêu trò chơi nói chung. Có lẽ bạn trân trọng mọi kiểu vui chơi — và đó cũng là một bản năng tốt trong tình yêu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda imidlalo ngokubanzi. Mhlawumbi uyakuxabisa nakuphi na ukudlala — nto leyo ilungileyo nasebudlelwaneni."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ràn eré lápapọ̀. Ó ṣeé ṣe kí ẹ mọyì irú eré èyíkéyìí — ìwà tó dára nínú ìbáṣepọ̀ pẹ̀lú ni."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你就是愛玩。你大概欣賞任何形式的玩樂——這在感情中也是很好的本能。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你就是爱玩。你大概欣赏各种形式的玩乐，这在感情里也是很好的本能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你單純熱愛遊戲。你大概喜歡各種玩樂，這在感情裡也是很好的本能。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda imidlalo yonke. Kungenzeka ukwazisa noma yiluphi uhlobo lokudlala — futhi lokho kuwumqondo omuhle nasebudlelwaneni."
          }
        }
      }
    },
