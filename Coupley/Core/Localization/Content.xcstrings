        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आम बात से बेहतर ख़ास बात। “आप कमाल हैं” का असर फीका रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A konkrét jobb az általánosnál. A „csodálatos vagy” üresen cseng."
