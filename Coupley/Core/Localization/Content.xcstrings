          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাছের মানুষের সাথে কথা বলেই তুমি দিনটা শেষ করো। এটা দুজনের সুন্দর একটা অভ্যাস — তোমার পার্টনার যেন জানে এটা তোমার কাছে কতটা মূল্যবান।"
