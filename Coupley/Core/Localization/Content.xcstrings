    "Knowing this helps them support you the right way — not just how they'd want to be supported." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة ذلك تساعد شريكك على دعمك بالطريقة الصحيحة، لا بالطريقة التي يفضّلها لنفسه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díky tomu tě tvůj protějšek může podpořit tak, jak to potřebuješ ty – ne tak, jak by to chtěl sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjælper din partner med at støtte dig på den rigtige måde – ikke bare på den måde, vedkommende selv gerne vil støttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So weiß dein Schatz, welche Unterstützung du wirklich brauchst – und nicht nur die, die man sich selbst wünschen würde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το ξέρει, μπορεί να σε στηρίξει όπως χρειάζεσαι εσύ — όχι όπως θα ήθελε να στηριχτεί το ίδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saberlo le ayuda a apoyarte como tú lo necesitas, no como le gustaría que la apoyaran a ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kumppanisi tietää tämän, hän osaa tukea sinua oikealla tavalla – eikä vain niin kuin itse haluaisi tulla tuetuksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag alam niya ito, masusuportahan ka niya sa tamang paraan — hindi lang sa paraang gusto niya para sa sarili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le savoir aide l'autre à te soutenir comme toi tu en as besoin, et pas selon ses propres besoins."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהצד השני יודע את זה, קל יותר לתמוך בך בדרך שנכונה לך — ולא רק בדרך שנכונה למי שתומך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जानकर पार्टनर आपको उसी तरह सहारा दे पाएँगे जैसा आपको चाहिए — न कि जैसा उन्हें ख़ुद के लिए चाहिए होता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ezt tudja, úgy tud támogatni, ahogy neked jó – nem csak úgy, ahogy ő szeretné, hogy őt támogassák."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan tahu ini, dia bisa mendukungmu dengan cara yang tepat — bukan sekadar cara yang dia sendiri suka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saperlo aiuta il tuo partner a sostenerti nel modo giusto — non solo come vorrebbe essere sostenuto a sua volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを知っておくと、パートナーは自分がされたい支え方ではなく、本当に合った形で支えてくれるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이걸 알면 연인이 자기 방식이 아니라 내게 맞는 방식으로 힘이 되어 줄 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengetahui hal ini membantu pasangan anda menyokong anda dengan cara yang betul — bukan sekadar cara yang mereka sendiri mahukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når partneren din vet dette, kan du få støtte på din måte – ikke bare slik den andre selv ville ønsket det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je partner dit weet, kan die je steunen zoals jij dat nodig hebt – niet zoals die zelf gesteund zou willen worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki temu druga połówka wesprze cię tak, jak tego potrzebujesz – a nie tak, jak sama by chciała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber disso ajuda seu amor a apoiar você do jeito certo — e não só do jeito que gostaria de receber apoio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă știe asta, partenerul tău te poate sprijini cum ai tu nevoie — nu doar cum și-ar dori el să fie sprijinit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так партнёр поймёт, как поддержать именно тебя, а не так, как хотелось бы самому партнёру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Då kan din partner stötta dig på det sätt du behöver – inte bara på sitt eget sätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรู้เรื่องนี้ช่วยให้คนรักดูแลคุณได้ถูกทาง ไม่ใช่แค่ในแบบที่ตัวเองอยากได้รับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu bilmek, partnerinin sana kendi istediği gibi değil, senin ihtiyacın olan şekilde destek olmasını sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так половинка зможе підтримати тебе так, як потрібно саме тобі, а не так, як хотілося б їй."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết điều này giúp người ấy nâng đỡ bạn đúng cách — chứ không chỉ theo cách người ấy muốn được nâng đỡ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道这一点，另一半才能用你需要的方式支持你，而不是用对方自己想要的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道這點，對方才能用你需要的方式支持你，而不只是用自己想被支持的方式。"
          }
        }
      }
    },
    "Knowing when you're at your best matters for planning shared time — and giving each other space." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة الوقت الذي تكونون فيه في أفضل حالاتكم تساعد على تنظيم الوقت المشترك، وعلى منح كل منكما مساحته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když víte, kdy je kdo v nejlepší formě, líp plánujete společný čas – a víte, kdy si dát prostor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når I ved, hvornår I er bedst, er det lettere at planlægge tid sammen – og give hinanden plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu wissen, wann du in Bestform bist, hilft beim Planen gemeinsamer Zeit – und dabei, euch gegenseitig Raum zu lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να ξέρεις πότε είσαι στα καλύτερά σου βοηθά στον σχεδιασμό του κοινού σας χρόνου — και στο να δίνετε χώρο ο ένας στον άλλον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber cuándo das lo mejor de ti ayuda a planear el tiempo juntos y a darse espacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tiedätte, milloin olette parhaimmillanne, on helpompi suunnitella yhteistä aikaa – ja antaa toisilleen tilaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahalagang alam mo kung kailan ka nasa pinakamaayos mong kondisyon para sa pagpaplano ng oras na magkasama — at sa pagbibigay ng espasyo sa isa’t isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savoir quand tu es au top aide à organiser vos moments à deux, et à vous laisser de l'espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשיודעים מתי כל אחד מכם בשיא, קל יותר לתכנן זמן משותף — וגם לתת זה לזה מרחב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप कब अपने सबसे अच्छे रूप में होते हैं, यह जानना साथ का वक़्त प्लान करने में — और एक-दूसरे को जगह देने में मदद करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha tudjátok, mikor vagytok a legjobb formában, könnyebb megtervezni a közös időt – és teret adni egymásnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu kapan kamu dalam kondisi terbaik itu penting untuk merencanakan waktu bersama — dan memberi ruang satu sama lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapere quando dai il meglio aiuta a organizzare il tempo insieme — e a lasciarvi i vostri spazi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん調子がいい時間帯を知っておくと、ふたりの時間もお互いのひとりの時間も計画しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 가장 빛나는 때를 알면, 함께할 시간을 계획하고 서로에게 여유를 주기도 쉬워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengetahui bila anda berada pada tahap terbaik penting untuk merancang masa bersama — dan memberi ruang kepada satu sama lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å vite når du er på ditt beste, hjelper dere å planlegge tid sammen – og gi hverandre rom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weten wanneer je op je best bent helpt bij het plannen van tijd samen – en bij elkaar ruimte geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedza o tym, kiedy jesteś w najlepszej formie, pomaga planować wspólny czas – i dawać sobie nawzajem przestrzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber quando você está no seu melhor ajuda a planejar o tempo a dois — e a dar espaço um ao outro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să știi când dai ce e mai bun din tine contează când plănuiți timpul împreună — și spațiul fiecăruia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда знаешь, в какое время ты в лучшей форме, проще планировать время вместе — и давать друг другу пространство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att veta när ni är som bäst hjälper er att planera tid tillsammans – och att ge varandra utrymme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรู้ว่าช่วงไหนคุณอยู่ในฟอร์มที่ดีที่สุด ช่วยในการวางแผนเวลาร่วมกัน และให้พื้นที่กันและกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi halinde olduğun zamanı bilmek, ortak zamanı planlamak ve birbirinize alan tanımak için önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли знаєш, у які години ти на піку, легше планувати спільне дозвілля — і давати одне одному простір."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết lúc nào mình ở trạng thái tốt nhất giúp hai bạn sắp xếp thời gian bên nhau — và cho nhau khoảng riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道自己什么时候状态最好，有助于安排共处的时间，也能给彼此留出空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道自己什麼時候狀態最好，對安排兩人時光、給彼此空間都很重要。"
          }
        }
      }
    },
    "Knowing your triggers means they're less likely to catch you off guard." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة ما يستفزكم تعني أنه أقل قدرة على مفاجأتكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když znáš svoje spouštěče, tak snadno tě nezaskočí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du kender dine triggere, er der mindre risiko for, at de overrumpler dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du deine Trigger kennst, erwischen sie dich seltener kalt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ξέρεις τι σε πυροδοτεί, είναι λιγότερο πιθανό να σε αιφνιδιάσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si conoces tus puntos sensibles, será más difícil que te tomen por sorpresa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tunnet laukaisijasi, ne eivät yllätä sinua yhtä helposti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag alam mo ang mga trigger mo, mas maliit ang tsansang mabigla ka nila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connaître tes points sensibles, c'est leur laisser moins de chances de te prendre au dépourvu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמכירים את הטריגרים שלך, הם פחות מפתיעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी दुखती रगें पता हों, तो वे आपको कम ही अचानक चौंका पाती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha tudod, mi húz fel, kevésbé ér váratlanul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau tahu pemicumu, kamu nggak akan mudah terkejut olehnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conoscere i tuoi punti sensibili ti aiuta a non farti cogliere di sorpresa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の地雷を知っておけば、不意を突かれにくくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 예민한 부분을 알면 갑자기 휘둘릴 일이 줄어들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda kenal pencetus emosi anda, ia tidak mudah mengejutkan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du kjenner dine ømme punkter, blir du sjeldnere tatt på senga."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je triggers kent, overvallen ze je minder snel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy znasz swoje czułe punkty, trudniej im cię zaskoczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conhecer seus gatilhos faz com que eles peguem você menos de surpresa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când îți știi punctele sensibile, e mai greu să te ia prin surprindere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда знаешь свои триггеры, они реже застают врасплох."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du känner till dina triggrar är det mindre risk att de tar dig på sängen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรู้จักจุดอ่อนไหวของตัวเองทำให้ไม่ถูกมันเล่นงานแบบไม่ทันตั้งตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni neyin tetiklediğini bilmek, hazırlıksız yakalanma ihtimalini azaltır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли знаєш свої тригери, вони рідше заскочують зненацька."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết những điều dễ khiến bạn phật lòng, bạn sẽ ít bị bất ngờ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "了解自己的雷区，就不容易被它打个措手不及。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "了解自己的地雷，就不容易被突然踩到。"
          }
        }
      }
    },
    "Late night — I come alive after dark" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر الليل: أنتعش بعد الغروب"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozdě v noci – ožívám po setmění"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent om aftenen – der lever jeg op"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spätabends – nachts lebe ich auf"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αργά το βράδυ — ζωντανεύω μετά τη δύση"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche: cobro vida al oscurecer"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myöhään illalla – herään eloon pimeän tultua"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatinggabi — gising na gising ako pagdilim"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tard le soir : je revis la nuit"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאוחר בלילה — החיים מתחילים אחרי החשכה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देर रात — अँधेरा होते ही मुझमें जान आती है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Késő éjjel – sötétedés után éledek fel"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larut malam — aku makin hidup saat gelap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tarda notte — mi accendo col buio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深夜。夜になると元気になる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "늦은 밤, 해가 지면 살아나요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewat malam — saya bertenaga selepas gelap"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent på kvelden – jeg våkner når det blir mørkt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat op de avond – ik kom tot leven als het donker is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Późny wieczór – ożywam po zmroku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarde da noite — ganho vida quando escurece"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noaptea târziu — prind viață după lăsarea întunericului"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поздняя ночь — оживаю в темноте"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent på kvällen – jag vaknar till liv när det blir mörkt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดึกๆ ยิ่งมืดยิ่งมีพลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece geç saatler, karanlıkta canlanırım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пізно ввечері — оживаю з темрявою"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đêm khuya — trời tối mình mới tỉnh"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深夜——天黑才来劲"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深夜，天黑後我才活過來"
          }
        }
      }
    },
