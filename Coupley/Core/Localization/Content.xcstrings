    "Your stress response reveals how your nervous system works — and how your partner can help." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طريقة تعاملك مع التوتر تكشف كيف يعمل جهازك العصبي، وكيف يمكن لشريكك أن يساعد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje reakce na stres ukazuje, jak funguje tvůj nervový systém – a jak ti může protějšek pomoct."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din reaktion på stress viser, hvordan dit nervesystem fungerer – og hvordan din partner kan hjælpe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Stressreaktion zeigt, wie dein Nervensystem tickt – und wie dein Schatz dir helfen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τρόπος που αντιδράς στο άγχος δείχνει πώς λειτουργεί το νευρικό σου σύστημα — και πώς μπορεί να βοηθήσει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reacción al estrés revela cómo funciona tu sistema nervioso — y cómo puede ayudarte tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapasi reagoida stressiin kertoo, miten hermostosi toimii – ja miten kumppanisi voi auttaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapakita ng reaksyon mo sa stress kung paano gumagana ang nervous system mo — at kung paano makakatulong ang partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta réaction au stress révèle comment fonctionne ton système nerveux — et comment l'autre peut t'aider."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התגובה שלך ללחץ מגלה איך מערכת העצבים שלך עובדת — ואיך הצד השני יכול לעזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तनाव पर आपकी प्रतिक्रिया बताती है कि आपका मन और शरीर कैसे काम करते हैं — और पार्टनर आपकी मदद कैसे कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stresszre adott válaszod megmutatja, hogyan működik az idegrendszered – és hogyan segíthet a párod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responsmu terhadap stres menunjukkan cara kerja sistem sarafmu — dan bagaimana pasanganmu bisa membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modo in cui reagisci allo stress rivela come funziona il tuo sistema nervoso — e come il tuo partner può aiutarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレスへの反応から、心と体の仕組みと、パートナーにできる助け方が見えてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트레스 반응을 보면 마음이 어떻게 움직이는지, 그리고 연인이 어떻게 도울 수 있는지 알 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara anda bertindak balas terhadap tekanan menunjukkan cara sistem saraf anda berfungsi — dan bagaimana pasangan anda boleh membantu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du reagerer på stress, viser hvordan nervesystemet ditt fungerer – og hvordan partneren din kan hjelpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe je op stress reageert, laat zien hoe je zenuwstelsel werkt – en hoe je partner kan helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja reakcja na stres pokazuje, jak działa twój układ nerwowy – i jak druga połówka może pomóc."
