    "Sometimes the best date is the one where no one has to put on shoes. Comfort and ease over ambiance." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soms is die beste afspraak die een waar niemand skoene hoef aan te trek nie. Gemak bo atmosfeer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አንዳንዴ ምርጡ ቀጠሮ ማንም ጫማ ማድረግ የማያስፈልገው ነው። ከድባብ ይልቅ ምቾትና ቅለት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحيانًا يكون أجمل موعد هو الذي لا يضطر فيه أحد إلى لبس حذائه. الراحة والبساطة عندك أهم من الأجواء."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেতিয়াবা শ্ৰেষ্ঠ ডেটটো সেইটোৱেই য'ত কাকো জোতা পিন্ধিব নালাগে। পৰিৱেশতকৈ আৰাম আৰু সহজতা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bəzən ən gözəl görüş heç kimin ayaqqabı geyinməli olmadığı görüşdür. Ab-havadan çox rahatlıq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часам найлепшае спатканне — тое, дзе нікому не трэба абувацца. Утульнасць і лёгкасць важнейшыя за атмасферу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понякога най-хубавата среща е тази, за която никой не трябва да си обува обувките. Уют и лекота пред атмосфера."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কখনো কখনো সেরা ডেট সেটাই, যেখানে কাউকে জুতো পরতে হয় না। জাঁকজমকের চেয়ে আরাম আর স্বস্তি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponekad je najbolji izlazak onaj za koji niko ne mora obuti cipele. Udobnost i lakoća prije ambijenta."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vegades la millor cita és aquella en què ningú s'ha de calçar. Comoditat i tranquil·litat per sobre de l'ambient."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Někdy je nejlepší rande to, na které se nikdo nemusí obouvat. Pohodlí a klid mají přednost před atmosférou."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weithiau'r dêt gorau yw'r un lle does neb yn gorfod gwisgo sgidiau. Cysur a hwylustod yn hytrach nag awyrgylch."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle gange er den bedste date den, hvor ingen behøver at tage sko på. Komfort og ro frem for stemning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal ist das beste Date das, für das niemand Schuhe anziehen muss. Gemütlichkeit schlägt Ambiente."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μερικές φορές το καλύτερο ραντεβού είναι αυτό όπου κανείς δεν χρειάζεται να φορέσει παπούτσια. Η άνεση μετράει πιο πολύ από την ατμόσφαιρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veces la mejor cita es aquella en la que nadie tiene que ponerse zapatos. Comodidad y sencillez antes que ambiente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahel on parim kohting see, kus kellelgi pole vaja kingi jalga panna. Mugavus ja lihtsus enne õhkkonda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batzuetan hitzordurik onena inork oinetakoak jantzi behar ez dituena da. Erosotasuna eta lasaitasuna, giroa baino gehiago."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گاهی بهترین قرار همانی است که هیچ‌کس لازم نیست کفش بپوشد. راحتی و آسودگی مهم‌تر از فضاسازی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joskus parhaat treffit ovat ne, joilla kenenkään ei tarvitse laittaa kenkiä jalkaan. Mukavuus ja helppous voittavat tunnelman."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minsan, ang pinakamagandang date ay ’yung walang kailangang magsapatos. Mas mahalaga sa’yo ang ginhawa kaysa sa ambiance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parfois, le meilleur rendez-vous, c'est celui où personne n'a besoin de mettre des chaussures. Le confort et la simplicité avant l'ambiance."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaireanta is í an oíche is fearr an ceann nach gcaithfidh aon duine bróga a chur air. Compord agus suaimhneas thar atmaisféar."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ás veces a mellor cita é aquela na que ninguén ten que calzarse. Comodidade e facilidade mellor ca ambiente."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ક્યારેક સૌથી સરસ ડેટ એ જ હોય છે જેમાં કોઈએ જૂતાં પણ પહેરવાં ન પડે. માહોલ કરતાં આરામ અને સહજતા."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wani lokaci mafi kyawun fita ita ce wadda babu wanda zai saka takalmi. Jin daɗi da sauƙi sun fi kyan wuri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפעמים הדייט הכי טוב הוא זה שבו אף אחד לא צריך לנעול נעליים. נוחות וקלילות לפני אווירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी-कभी सबसे अच्छी डेट वही होती है जिसमें किसी को जूते तक नहीं पहनने पड़ते। माहौल से ज़्यादा आराम और सुकून।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponekad je najbolji spoj onaj za koji nitko ne mora obuti cipele. Udobnost i lakoća ispred atmosfere."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pafwa pi bon sòti a se sa kote pèsonn pa bezwen mete soulye. Konfò ak fasilite pase dekò."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néha az a legjobb randi, amihez senkinek sem kell cipőt húznia. Nálad a kényelem fontosabb a hangulatnál."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբեմն լավագույն ժամադրությունն այն է, երբ ոչ ոք կոշիկ հագնելու կարիք չունի։ Հարմարավետությունն ու թեթևությունը՝ մթնոլորտից առաջ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadang kencan terbaik adalah yang nggak perlu pakai sepatu. Kamu pilih nyaman dan santai daripada suasana."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgbe ụfọdụ, ịpụ ọnụ kacha mma bụ nke onweghị onye ga-eyi akpụkpọ ụkwụ. Iru ala na ịdị mfe karịa ọdịdị ebe ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stundum er besta stefnumótið það þar sem enginn þarf að fara í skó. Þægindi og ró fram yfir stemningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A volte l’appuntamento migliore è quello in cui nessuno deve mettersi le scarpe. Comodità e relax prima dell’atmosfera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も靴を履かなくていいデートこそ、最高のデートだったりします。雰囲気よりも、くつろぎと気軽さを大切にしています。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadhang kencan sing paling apik iku sing ora ana sing kudu nganggo sepatu. Kepenak lan gampang luwih saka swasana."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზოგჯერ საუკეთესო პაემანი ისაა, როცა ფეხსაცმლის ჩაცმაც კი არ გიწევს. კომფორტი და სიმსუბუქე ატმოსფეროზე მეტია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кейде ең жақсы кездесу — ешкімге аяқ киім киюдің қажеті жоқ кездесу. Атмосферадан гөрі жайлылық пен еркіндік."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពេលខ្លះ ការណាត់ជួបល្អបំផុតគឺពេលដែលគ្មាននរណាត្រូវពាក់ស្បែកជើង។ ភាពស្រួល និងងាយ លើសបរិយាកាសប្រណីត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೆಲವೊಮ್ಮೆ ಯಾರೂ ಚಪ್ಪಲಿ ಹಾಕಬೇಕಿಲ್ಲದ ಡೇಟ್‌ಗಳೇ ಅತ್ಯುತ್ತಮ. ವಾತಾವರಣಕ್ಕಿಂತ ಆರಾಮ ಮತ್ತು ನಿರಾಳತೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "때로는 아무도 신발을 신지 않아도 되는 데이트가 최고예요. 분위기보다 편안함과 여유가 우선이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carinan şeva herî xweş ew e ku kes ne mecbûr e solên xwe li xwe bike. Rehetî û hêsanî ji atmosferê girîngtir in."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кээде эң сонун жолугушуу — эч ким бут кийим кийбеген жолугушуу. Маанайдан көрө жайлуулук жана жеңилдик."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiansdo ass dee beschten Date deen, fir deen keen d'Schong undoe muss. Gemittlechkeet a Rou virun Ambiance."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບາງເທື່ອເດດທີ່ດີທີ່ສຸດຄືເດດທີ່ບໍ່ມີໃຜຕ້ອງໃສ່ເກີບ ຄວາມສະບາຍ ແລະ ງ່າຍໆສຳຄັນກວ່າບັນຍາກາດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartais geriausias pasimatymas – kai niekam nereikia apsiauti batų. Jaukumas ir paprastumas svarbiau už atmosferą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dažreiz labākais randiņš ir tas, kurā nevienam nav jāuzvelk kurpes. Komforts un vieglums pār atmosfēru."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indraindray ny fotoana iarahana tsara indrindra dia ilay tsy ilain'iza na iza hanaovana kiraro. Fahazotoana sy fahamorana toy izay tontolo manodidina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ētahi wā, ko te pō whaiāipo pai rawa ko tērā kāore he tangata e kuhu hū. Ko te māhorahora me te ngāwari i mua i te wairua ātaahua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понекогаш најдобрата средба е онаа кога никој не мора да се обува. Удобност и леснотија пред амбиент."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചിലപ്പോൾ ഏറ്റവും നല്ല ഡേറ്റ്, ആർക്കും ചെരിപ്പിടേണ്ടാത്തതാണ്. അന്തരീക്ഷത്തെക്കാൾ സുഖവും ലാഘവവും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заримдаа хамгийн сайхан болзоо бол хэн ч гутлаа өмсөх шаардлагагүй нь. Уур амьсгалаас илүү тав тух, амар байдал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कधी कधी सर्वात छान डेट तीच, जिथे कोणालाच चपला घालाव्या लागत नाहीत. वातावरणापेक्षा आराम आणि सहजता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadangkala janji temu terbaik ialah yang tak perlu pakai kasut pun. Selesa dan mudah lebih penting daripada suasana."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xi drabi l-aqwa serata hija dik fejn ħadd m'għandu għalfejn jilbes iż-żraben. Kumdità u faċilità qabel l-atmosfera."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "တစ်ခါတလေ အကောင်းဆုံး ချိန်းတွေ့ပွဲက ဘယ်သူမှ ဖိနပ်စီးစရာ မလိုတဲ့ပွဲပါ။ ပတ်ဝန်းကျင် လှပမှုထက် သက်တောင့်သက်သာနဲ့ လွယ်ကူမှု။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen ganger er den beste daten den der ingen trenger å ta på seg sko. Du velger komfort og ro framfor stemning."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहिलेकाहीँ सबैभन्दा राम्रो डेट त्यही हो, जसमा कसैले जुत्ता लगाउनै पर्दैन। माहोलभन्दा सहजता र आराम।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soms is de beste date er een waarvoor niemand schoenen aan hoeft. Comfort en gemak boven sfeer."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nthawi zina tsiku labwino kwambiri lochezera ndi lomwe palibe amene akufunika kuvala nsapato. Kumasuka kuposa malo okongola."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo tokko tokko galgalli jaalalaa inni gaariin kan namni tokkollee kophee kaa'uu hin barbaachifne dha. Bareedina caalaa mijataa fi salphina."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବେଳେବେଳେ ସବୁଠୁ ଭଲ ଡେଟ୍ ସେଇଟା ଯେଉଁଥିରେ କାହାକୁ ଜୋତା ପିନ୍ଧିବାକୁ ପଡ଼େ ନାହିଁ। ପରିବେଶଠୁ ଆରାମ ଓ ସହଜତା ବଡ଼।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਈ ਵਾਰ ਸਭ ਤੋਂ ਵਧੀਆ ਡੇਟ ਉਹ ਹੁੰਦੀ ਹੈ ਜਿਸ ਵਿੱਚ ਕਿਸੇ ਨੂੰ ਜੁੱਤੀ ਵੀ ਨਾ ਪਾਉਣੀ ਪਵੇ। ਮਾਹੌਲ ਨਾਲੋਂ ਸੁਖ ਅਤੇ ਸੌਖ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czasem najlepsza randka to taka, na którą nikt nie musi wkładać butów. Wygoda i luz zamiast klimatu."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ځینې وخت غوره ملاقات هغه وي چې هېڅوک بوټونه پښو ته نه کوي. آرامي او اسانتیا له فضا غوره."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às vezes o melhor encontro é aquele em que ninguém precisa calçar sapato. Conforto e praticidade valem mais que o ambiente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às vezes, o melhor encontro é aquele em que ninguém tem de se calçar. Conforto e facilidade acima do ambiente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uneori cea mai bună întâlnire e cea în care nimeni nu trebuie să se încalțe. Confortul și comoditatea înaintea atmosferei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иногда лучшее свидание — то, на которое даже не нужно обуваться. Уют и простота важнее антуража."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimwe na rimwe gusohokana kwiza kurusha ukundi ni aho nta n'umwe ukeneye kwambara inkweto. Ihumure n'ubwisanzure biruta umwuka w'ahantu."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සමහර වෙලාවට හොඳම හමුව කවුරුවත් සපත්තු දාන්න ඕනේ නැති එකයි. පරිසරයට වඩා පහසුව සහ නිදහස."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niekedy je najlepšie rande to, na ktoré si nikto nemusí obuť topánky. Pohodlie a ľahkosť pred atmosférou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Včasih je najboljši zmenek tisti, za katerega se nihče ne obuje. Udobje in sproščenost pred vzdušjem."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzimwe nguva kubuda kwakanakisa ndiko kusingadi kuti mumwe apfeke shangu. Kusununguka nekureruka pane kunaka kwenzvimbo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mararka qaarkood shukaansiga ugu fiican waa kan aan qofna kabo u gashan. Raaxo iyo fududaan, ma aha jawi qurux badan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndonjëherë takimi më i mirë është ai ku askush s’ka nevojë të vërë këpucë. Rehati dhe lehtësi mbi atmosferën."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понекад је најбољи излазак онај за који нико не мора да обује ципеле. Удобност и лакоћа пре атмосфере."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakapeung kencan pangsaéna téh anu teu aya anu kedah nganggo sapatu. Kanyamanan sareng santai langkung ti suasana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibland är den bästa dejten den där ingen behöver ta på sig skor. Mys och enkelhet går före miljön."
