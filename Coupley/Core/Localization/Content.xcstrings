        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овако најлакше примаш љубав — твоја половина треба то да зна."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieu cara anjeun paling saé nampi kanyaah — pasangan anjeun kedah terang ieu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så tar du bäst emot kärlek – det här behöver din partner veta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hivi ndivyo unavyopokea upendo vizuri zaidi — mwenzi wako anahitaji kujua hili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இப்படித்தான் நீங்கள் அன்பைச் சிறப்பாக உணர்கிறீர்கள் — இது உங்கள் துணைக்குத் தெரிய வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ప్రేమను ఇలా బాగా స్వీకరిస్తారు — ఇది మీ భాగస్వామికి తెలియాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту муҳаббатро маҳз ҳамин тавр беҳтар қабул мекунӣ — ёрат бояд инро донад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือวิธีที่คุณรับรักได้ดีที่สุด และคนรักของคุณควรรู้ไว้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እዚ ፍቕሪ ብዝበለጸ እትቕበሉሉ መንገዲ እዩ — መጻምድኹም ክፈልጥዎ ይግባእ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen söýgini iň gowy şeýle kabul edýärsiň — muny söýgüliň bilmeli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevgiyi en iyi böyle alıyorsun; partnerinin bunu bilmesi gerek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так ти найкраще відчуваєш любов — твоя половинка має це знати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو محبت سب سے اچھی طرح اسی طرح محسوس ہوتی ہے — آپ کے ساتھی کو یہ معلوم ہونا چاہیے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevgini aynan shunday qabul qilasiz — sherigingiz buni bilishi kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là cách bạn đón nhận tình yêu trọn vẹn nhất — người ấy cần biết điều này."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yile ndlela owamkela ngayo uthando kakuhle — iqabane lakho kufuneka liyazi le nto."
