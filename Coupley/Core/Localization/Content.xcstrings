        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವರ್ತಮಾನದ ಮೇಲೆ ಗಮನ. ದೀರ್ಘಾವಧಿಯ ಯೋಜನೆ ನಿಮ್ಮ ಸ್ವಭಾವವಲ್ಲ — ಅಥವಾ ಇದು ಕಲ್ಪನೆಯಂತೆ ಅನಿಸುವಷ್ಟು ನೀವು ಇನ್ನೂ ಚಿಕ್ಕವರು."
