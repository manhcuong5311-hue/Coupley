        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაბალანსებული. პროფესიული სიამაყე გაქვს, მაგრამ მასში თავს არ კარგავ. ამ მხრივ, ალბათ, შენთან ურთიერთობა ადვილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теңгерімдісің. Кәсіби намысың бар, бірақ онда өзіңді жоғалтпайсың. Бұл тұрғыда сенімен қарым-қатынаста болу оңай шығар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានតុល្យភាព។ អ្នកមានមោទនភាពវិជ្ជាជីវៈ ដោយមិនបាត់បង់ខ្លួនឯង។ អ្នកប្រហែលជាងាយស្រួលរស់នៅជាមួយលើរឿងនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಮತೋಲಿತ. ಕೆಲಸದ ಬಗ್ಗೆ ನಿಮಗೆ ಹೆಮ್ಮೆ ಇದೆ, ಆದರೆ ಅದರಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕಳೆದುಕೊಳ್ಳುವುದಿಲ್ಲ. ಈ ವಿಷಯದಲ್ಲಿ ನಿಮ್ಮೊಂದಿಗಿನ ಸಂಬಂಧ ಸುಲಭ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "균형 잡혀 있어요. 일에 자부심은 있지만 거기에 매몰되지 않아요. 이 부분에선 아마 함께하기 편한 사람일 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hevseng. Serbilindiya te ya pîşeyî heye bêyî ku tu xwe tê de winda bikî. Belkî di vê mijarê de têkilîbûna bi te re hêsan e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тең салмактуу. Кесиптик сыймыгың бар, бирок анда өзүңдү жоготпойсуң. Бул жагынан сени менен мамиледе болуу жеңил болсо керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeglach. Du bass houfreg op deng Aarbecht, ouni dech dra ze verléieren. Op deem Plang ass et wuel einfach, mat dir zesummen ze sinn."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສົມດຸນ ເຈົ້າພູມໃຈໃນວຽກໂດຍບໍ່ສູນເສຍຕົວເອງ ໃນເລື່ອງນີ້ ການເປັນຄູ່ກັບເຈົ້າຄົງບໍ່ຍາກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusiausvyra. Didžiuojiesi savo darbu, bet jame nepasimeti. Šiuo klausimu su tavimi tikriausiai lengva kurti santykius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Līdzsvaroti. Tev ir profesionāls lepnums, bet tu sevi tajā nepazaudē. Šajā ziņā ar tevi droši vien ir viegli būt attiecībās."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voalanjalanja. Manana fireharehana ara-asa ianao nefa tsy very ao. Azo inoana fa mora ny miaraka aminao amin'izany lafiny izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He taurite. He whakahīhī ā-mahi tōu me te kore e ngaro koe i roto. Tērā pea he māmā te noho tahi me koe mō tēnei take."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избалансирано. Имаш професионална гордост без да се изгубиш во неа. Со тебе веројатно е лесно да се биде во врска во поглед на ова."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സന്തുലിതം. സ്വയം നഷ്ടപ്പെടാതെ തന്നെ നിങ്ങൾക്ക് ജോലിയിൽ അഭിമാനമുണ്ട്. ഇക്കാര്യത്തിൽ നിങ്ങളോടൊപ്പമുള്ള ബന്ധം എളുപ്പമായിരിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэнцвэртэй. Мэргэжлийн бахархалтай ч түүндээ өөрийгөө алддаггүй. Энэ талаар чамтай харилцаатай байх амархан байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संतुलित. स्वतःला हरवून न बसता तुम्हाला कामाचा अभिमान आहे. या बाबतीत तुमच्यासोबत नाते निभावणे बहुधा सोपे असेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang. Anda bangga dengan kerja tanpa hilang diri di dalamnya. Dalam hal ini, anda mungkin pasangan yang mudah untuk bersama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilanċ. Għandek kburija professjonali mingħajr ma titlef lilek innifsek fiha. Probabbli faċli li tkun f'relazzjoni miegħek f'dan ir-rigward."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မျှတတယ်။ အလုပ်ကို ဂုဏ်ယူပေမဲ့ အဲဒီထဲမှာ ကိုယ့်ကိုယ်ကို မပျောက်ဆုံးစေဘူး။ ဒီကိစ္စမှာ သင်နဲ့ ဆက်ဆံရေးထူထောင်ရတာ လွယ်ကူမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balansert. Du har faglig stolthet uten å miste deg selv i den. Du er nok lett å leve med på dette området."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सन्तुलित। तपाईंमा आफूलाई नहराई पेसागत गर्व छ। यस मामिलामा तपाईंसँग सम्बन्धमा रहन सजिलो हुन्छ होला।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenwichtig. Je bent trots op je werk zonder jezelf erin te verliezen. Op dit vlak ben je vast een makkelijke partner."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolinganiza. Mumanyadira ntchito yanu popanda kudzitaya. Mwina nkosavuta kukhala pa ubale ndi inu pa nkhani imeneyi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madaalawaa. Hojii keetti ni boonta, garuu isa keessatti of hin dhabdu. Dhimma kana irratti hariiroo keessatti si wajjin jiraachuun salphaa ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସନ୍ତୁଳିତ। ନିଜକୁ ନ ହରାଇ ଆପଣଙ୍କ ପେସାଦାର ଗର୍ବ ଅଛି। ଏ ବିଷୟରେ ଆପଣଙ୍କ ସହ ସମ୍ପର୍କ ରଖିବା ବୋଧହୁଏ ସହଜ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੰਤੁਲਿਤ। ਤੁਹਾਨੂੰ ਆਪਣੇ ਕੰਮ ਉੱਤੇ ਮਾਣ ਹੈ, ਪਰ ਤੁਸੀਂ ਇਸ ਵਿੱਚ ਗੁਆਚਦੇ ਨਹੀਂ। ਇਸ ਮਾਮਲੇ ਵਿੱਚ ਸ਼ਾਇਦ ਤੁਹਾਡੇ ਨਾਲ ਰਿਸ਼ਤਾ ਨਿਭਾਉਣਾ ਸੌਖਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga. Czujesz dumę z pracy, ale się w niej nie zatracasz. Pod tym względem pewnie łatwo z tobą być w związku."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انډول. تاسو په خپل مسلک ویاړ لرئ پرته له دې چې ځان پکې ورک کړئ. ښايي په دې برخه کې له تاسو سره اړیکه ساتل اسانه وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio. Você tem orgulho profissional sem se perder nele. Nesse ponto, a convivência com você deve ser bem tranquila."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio. Tens orgulho profissional sem te perderes nele. Neste ponto, deve ser fácil estar numa relação contigo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echilibru. Ai mândrie profesională fără să te pierzi în ea. Probabil e ușor să fii în relație cu tine din acest punct de vedere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс. Ты гордишься своей работой, но не растворяешься в ней. В этом вопросе с тобой, скорее всего, легко ужиться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uringaniza. Wishimira akazi kawe utiyibagiwe. Birashoboka ko kubana nawe byoroshye kuri iyi ngingo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සමබරයි. ඔබට වෘත්තීය ආඩම්බරයක් තියෙනවා, ඒත් ඒකේ ඔබව නැති කරගන්නේ නැහැ. මේ ගැන ඔබ එක්ක සබඳතාවක ඉන්න එක ලේසි ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvážene. Máš profesionálnu hrdosť, no nestrácaš sa v nej. V tomto smere sa s tebou vo vzťahu asi žije ľahko."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uravnoteženo. Imaš poklicni ponos, a se v njem ne izgubiš. Glede tega je s tabo verjetno lahko biti v odnosu."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakaenzana. Unodada nebasa rako usingazvirasi mariri. Pamwe zviri nyore kuva muukama newe pane izvi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dheelitiran. Waxaad leedahay sharaf xirfadeed adigoon ku lumin. Waxay u badan tahay inay fududahay in xiriir laguula yeesho arrintan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekuilibër. Ke krenari profesionale pa e humbur veten në të. Ndoshta për këtë aspekt është e lehtë të jesh në marrëdhënie me ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уравнотежено. Имаш професионални понос, а не губиш себе у њему. С тобом је у том погледу вероватно лако бити у вези."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saimbang. Anjeun reueus kana pagawéan tanpa kaleungitan diri. Dina hal ieu, anjeun sigana gampil diajak babarengan dina hubungan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanserat. Du är stolt över ditt jobb utan att gå upp i det. Du är nog lätt att ha en relation med på den här punkten."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwiano. Una fahari ya kikazi bila kujipoteza ndani yake. Huenda ni rahisi kuwa nawe katika uhusiano kuhusu jambo hili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமநிலையானவர். அதில் உங்களை இழக்காமல் தொழில்முறைப் பெருமை கொள்கிறீர்கள். இந்த விஷயத்தில் உங்களுடன் உறவில் இருப்பது எளிதாகவே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమతుల్యత. వృత్తిపరమైన గర్వం ఉంది, కానీ అందులో మిమ్మల్ని మీరు కోల్పోరు. ఈ విషయంలో మీతో బంధంలో ఉండటం బహుశా సులభం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мувозин. Ту ифтихори касбӣ дорӣ, бе он ки худро дар он гум кунӣ. Эҳтимол дар ин масъала бо ту дар муносибат будан осон аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมดุล คุณภูมิใจในงานโดยไม่จมหายไปกับมัน ในเรื่องนี้คุณน่าจะเป็นคนที่คบด้วยง่าย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሚዛናዊ። ብዘይ ምጥፋእ ሞያዊ ኩርዓት ኣለኩም። ኣብዚ ጉዳይ ምሳኹም ርክብ ቀሊል ይኸውን ትኾኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deňagramly. Sen özüňi ýitirmän, hünäriňe buýsanýarsyň. Bu babatda seniň bilen gatnaşykda bolmak aňsat bolsa gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengeli. İşinle gurur duyuyorsun ama içinde kaybolmuyorsun. Bu konuda muhtemelen birlikte olması kolay birisin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансовано. Професійна гордість є, але ти в ній не розчиняєшся. У цьому з тобою, мабуть, легко ладнати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوازن۔ پیشہ ورانہ فخر ہے مگر خود کو اس میں کھوئے بغیر۔ اس معاملے میں شاید آپ کے ساتھ رشتہ نبھانا آسان ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muvozanatli. Kasbiy gʻururingiz bor, lekin unda oʻzingizni yoʻqotmaysiz. Bu borada siz bilan munosabat qurish oson boʻlsa kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng. Bạn tự hào về nghề mà không đánh mất mình. Ở chuyện này, có lẽ ai yêu bạn cũng thấy nhẹ nhàng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulungelelene. Unebhongo emsebenzini ngaphandle kokuzilahla kuwo. Mhlawumbi kulula ukuba kubudlelwane nawe kule nto."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwọ̀ntúnwọ̀nsì. Ẹ ní ìgbéraga iṣẹ́ láìsọ ara yín nù nínú rẹ̀. Ó ṣeé ṣe kí ó rọrùn láti wà nínú ìbáṣepọ̀ pẹ̀lú yín lórí ọ̀rọ̀ yìí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很平衡。你對工作有自豪感，卻不會迷失其中。在這方面，你大概是很容易相處的伴侶。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很平衡。你有职业自豪感，又不会在其中迷失。在这方面，和你在一起大概会很轻松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很平衡。你有職業上的自豪，但不會迷失其中。在這方面，和你在一起應該很輕鬆。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulinganisela. Uyaziqhenya ngomsebenzi wakho ngaphandle kokuzilahla kuwo. Kungenzeka kulula ukuba sebudlelwaneni nawe mayelana nalokhu."
          }
        }
      }
    },
    "Baseline healthy. You probably take it for granted, which is fine — until you're sharing a bed with someone with very different habits." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basies gesond. Jy neem dit waarskynlik as vanselfsprekend aan, en dis oukei – totdat jy ’n bed deel met iemand met heel ander gewoontes."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በመሠረቱ ጤናማ። ምናልባት እንደ ቀላል ነገር ይወስዱታል፣ ይህም ችግር የለውም — በጣም የተለየ ልማድ ካላቸው ሰው ጋር አልጋ እስኪጋሩ ድረስ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أساس صحي. ربما يبدو لك أمرًا مسلّمًا به، ولا بأس، إلى أن يأتي تقاسم السرير مع شخص بعادات مختلفة جدًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মূলতঃ সুস্থ। হয়তো আপুনি ইয়াক স্বাভাৱিক বুলিয়েই ধৰি লয়, সেয়া ঠিকেই — যেতিয়ালৈকে একেবাৰে বেলেগ অভ্যাসৰ কাৰোবাৰ লগত বিচনা ভাগ নকৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlam baza. Yəqin ki, bunu adi qəbul edirsən və bu normaldır — ta ki tamamilə fərqli vərdişləri olan biri ilə eyni yatağı bölüşənə qədər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здаровая норма. Ты, мусіць, успрымаеш гэта як належнае, і гэта нармальна — пакуль не давядзецца дзяліць ложак з кімсьці з зусім іншымі звычкамі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравословна база. Вероятно го приемаш за даденост, което е нормално – докато не започнеш да делиш леглото с някого с много различни навици."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মোটামুটি সুস্থ। সম্ভবত এটাকে তুমি স্বাভাবিক ধরে নাও, তাতে ক্ষতি নেই — যতক্ষণ না খুব আলাদা অভ্যাসের কারও সাথে বিছানা ভাগ করছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrava osnova. Vjerovatno to uzimaš zdravo za gotovo, što je u redu – dok ne počneš dijeliti krevet s nekim ko ima sasvim drugačije navike."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saludable de base. Segurament ho dones per fet, i està bé — fins que comparteixes llit amb algú amb hàbits molt diferents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravý základ. Nejspíš to bereš jako samozřejmost, což je v pořádku – dokud nesdílíš postel s někým, kdo má úplně jiné návyky."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iach yn y bôn. Mae'n debyg dy fod yn ei gymryd yn ganiataol, sy'n iawn — nes i ti rannu gwely â rhywun sydd ag arferion gwahanol iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundlæggende sundt. Du tager det nok for givet, og det er fint – indtil du deler seng med en, der har helt andre vaner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundsätzlich gesund. Du nimmst es wahrscheinlich als selbstverständlich hin, und das ist okay – bis du das Bett mit jemandem teilst, der ganz andere Gewohnheiten hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υγιής βάση. Μάλλον τον θεωρείς δεδομένο, και δεν πειράζει — μέχρι να μοιραστείς κρεβάτι με κάποιον που έχει πολύ διαφορετικές συνήθειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una base sana. Seguramente lo das por hecho, y está bien — hasta que compartes cama con alguien de hábitos muy distintos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põhimõtteliselt terve. Ilmselt pead seda iseenesestmõistetavaks, mis on okei — kuni jagad voodit kellegagi, kelle harjumused on hoopis teised."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oinarri osasungarria. Ziurrenik ez diozu garrantzirik ematen, eta ondo dago, ohitura oso desberdinak dituen norbaitekin ohea partekatu arte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حد سالم. احتمالاً قدرش را نمی‌دانی، که اشکالی ندارد — تا وقتی که تخت‌خوابت را با کسی با عادت‌های خیلی متفاوت شریک شوی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perusterve. Pidät sitä luultavasti itsestäänselvyytenä, mikä on ok – kunnes jaat sängyn jonkun kanssa, jolla on hyvin erilaiset tavat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malusog sa pangkalahatan. Malamang hindi mo ito masyadong iniisip, at ayos lang — hanggang may katabi ka nang ibang-iba ang gawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne base. Tu n'y penses sûrement pas, et c'est très bien — jusqu'au jour où tu partages ton lit avec quelqu'un aux habitudes très différentes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sláintiúil go bunúsach. Is dócha go nglacann tú leis mar rud cinnte, rud atá ceart go leor — go dtí go mbíonn leaba á roinnt agat le duine a bhfuil nósanna an-difriúil aige."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha base saudable. Seguramente o dás por feito, e está ben, ata que compartes cama con alguén de hábitos moi distintos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મૂળભૂત રીતે સ્વસ્થ. કદાચ તમે એને હળવાશથી લો છો, જે ઠીક છે — જ્યાં સુધી બહુ જુદી આદતો ધરાવતી વ્યક્તિ સાથે પલંગ શેર ન કરવો પડે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lafiya lau a asali. Wataƙila ba ku ɗauke shi da muhimmanci ba, wanda babu laifi — sai lokacin da kuka fara kwana gado ɗaya da mai halayen barci daban sosai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בסיס בריא. כנראה שזה מובן מאליו בשבילך, וזה בסדר — עד שחולקים מיטה עם מישהו עם הרגלים שונים מאוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुनियादी तौर पर सेहतमंद। शायद आपके लिए यह कोई बड़ी बात ही नहीं, और यह ठीक है — जब तक बिस्तर किसी बिल्कुल अलग आदतों वाले के साथ साझा न हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrava osnova. Vjerojatno to uzimaš zdravo za gotovo, što je u redu – dok ne počneš dijeliti krevet s nekim tko ima posve drukčije navike."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon baz an sante. Ou gendwa pa menm panse ak sa, sa pa gen pwoblèm — jiskaske w ap pataje kabann ak yon moun ki gen abitid byen diferan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapvetően egészséges. Valószínűleg magától értetődőnek veszed, ami rendben is van – amíg nem osztod meg az ágyat valakivel, akinek egészen mások a szokásai."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առողջ հիմք։ Հավանաբար դա ինքնին հասկանալի ես համարում, և դա լավ է, մինչև որ անկողինը կիսես քնի շատ տարբեր սովորություններով մեկի հետ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada dasarnya sehat. Kamu mungkin menganggapnya biasa, dan itu wajar — sampai kamu berbagi ranjang dengan orang yang kebiasaannya sangat berbeda."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahụike dị mma. O nwere ike ịbụ na ị naghị eche ya echiche, nke ahụ dị mma — ruo mgbe ị ga-ekere àkwà onye nwere omume dị nnọọ iche."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heilbrigður grunnur. Þú tekur honum líklega sem sjálfsögðum hlut, sem er í lagi – þangað til þú deilir rúmi með einhverjum með allt aðrar venjur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una base sana. Probabilmente lo dai per scontato, e va bene — finché non dividi il letto con qualcuno dalle abitudini molto diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本的には健康です。当たり前だと思っているかもしれませんが、それで大丈夫。習慣がまったく違う人と同じベッドで寝るまでは。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehat. Mbokmenawa panjenengan nganggep iku lumrah, lan ora apa-apa — nganti panjenengan turu sakasur karo wong sing kabiasaane beda banget."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საბაზისოდ ჯანსაღი. ალბათ, ამას თავისთავად აღიქვამ, და ეს კარგია — სანამ საწოლს ძალიან განსხვავებული ჩვევების მქონე ადამიანს არ გაუყოფ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Негізінен сау. Мұны қалыпты нәрсе деп қабылдайтын шығарсың, бұл дұрыс, әдеттері мүлде басқа біреумен бір төсекте ұйықтағанға дейін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានសុខភាពល្អជាមូលដ្ឋាន។ អ្នកប្រហែលជាមិនសូវគិតពីវា ដែលមិនអីទេ — រហូតដល់អ្នកគេងរួមគ្រែជាមួយនរណាម្នាក់ដែលមានទម្លាប់ខុសគ្នាខ្លាំង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೂಲತಃ ಆರೋಗ್ಯಕರ. ನೀವು ಬಹುಶಃ ಅದನ್ನು ಸಹಜವೆಂದು ಭಾವಿಸುತ್ತೀರಿ, ಅದು ಪರವಾಗಿಲ್ಲ — ತೀರಾ ಬೇರೆ ಅಭ್ಯಾಸಗಳಿರುವವರ ಜೊತೆ ಹಾಸಿಗೆ ಹಂಚಿಕೊಳ್ಳುವವರೆಗೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 건강해요. 아마 당연하게 여기고 있을 텐데 괜찮아요. 습관이 아주 다른 사람과 한 침대를 쓰기 전까지는요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bingeheke saxlem. Belkî tu wê wekî tiştekî asayî dibînî, ev jî baş e — heta ku tu nivînekê bi kesekî xwedî adetên pir cuda re parve bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Негизинен баары жакшы. Балким, муну кадимки нерсе катары кабыл аласың, жана бул туура — уйку адаты таптакыр башка адам менен бир төшөктө жата баштаганга чейин."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grondsätzlech gesond. Du hëls et wahrscheinlech als selbstverständlech, an dat ass an der Rei — bis s de e Bett mat engem deels, deen ganz aner Gewunnechten huet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ພື້ນຖານແຂງແຮງດີ ເຈົ້າອາດບໍ່ໄດ້ຄິດຫຍັງຫຼາຍ ເຊິ່ງກໍບໍ່ເປັນຫຍັງ — ຈົນກວ່າເຈົ້າຈະນອນຕຽງດຽວກັບຄົນທີ່ມີນິໄສຕ່າງກັນຫຼາຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveikas pagrindas. Tikriausiai to net nepastebi, ir tai normalu – kol nepradedi dalytis lova su žmogumi, kurio įpročiai visai kitokie."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veselīga norma. Tu to droši vien uztver kā pašsaprotamu, un tas ir labi – līdz brīdim, kad gultu dali ar kādu, kam paradumi ļoti atšķiras."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salama tsara amin'ny ankapobeny. Azo inoana fa tsy mieritreritra loatra an'izany ianao, ary tsy maninona — mandra-pizaranao fandriana amin'olona manana fahazarana tena hafa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hauora noa. Kāore pea koe e whakaaro nui ki tēnei, ā, kei te pai — kia tae rā anō ki te wā ka moe tahi koe me tētahi he tino rerekē ōna tikanga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здрава основа. Веројатно го земаш здраво за готово, што е во ред — додека не почнеш да делиш кревет со некој со многу поинакви навики."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അടിസ്ഥാനപരമായി ആരോഗ്യകരം. നിങ്ങൾ അതിനെ നിസ്സാരമായി കാണുന്നുണ്ടാകാം, അതിൽ കുഴപ്പമില്ല — തികച്ചും വ്യത്യസ്ത ശീലങ്ങളുള്ള ഒരാളുമായി കിടക്ക പങ്കിടുന്നതുവരെ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үндсэндээ эрүүл. Чи үүнийг энгийн зүйл гэж хүлээж авдаг байх, энэ ч зүгээр — огт өөр дадалтай хүнтэй нэг орон дээр унтах хүртэл."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुळात निरोगी. तुम्ही बहुधा हे गृहीत धरता, आणि ते ठीक आहे — अगदी वेगळ्या सवयी असलेल्या कुणासोबत बेड शेअर करेपर्यंत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asasnya sihat. Anda mungkin tak terfikir pun tentangnya, dan itu tak mengapa — sehinggalah anda berkongsi katil dengan orang yang tabiatnya sangat berbeza."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bażi b'saħħitha. Probabbilment tqisu bħala ħaġa normali, u dan tajjeb — sakemm ma tibdiex taqsam is-sodda ma' xi ħadd b'drawwiet differenti ħafna."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အခြေခံအားဖြင့် ကျန်းမာတယ်။ ဒါကို ပုံမှန်လို့ပဲ သဘောထားလောက်တယ်၊ ဒါလည်း ရပါတယ် — အိပ်စက်ပုံ လုံးဝမတူတဲ့သူနဲ့ ကုတင်အတူ မျှအိပ်ရတဲ့အထိပေါ့။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sunt utgangspunkt. Du tar det nok for gitt, og det er greit – helt til du deler seng med noen med helt andre vaner."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आधारभूत रूपमा स्वस्थ। सायद तपाईं यसलाई सामान्य ठान्नुहुन्छ, जुन ठिकै हो — एकदमै फरक बानी भएको कोहीसँग ओछ्यान बाँड्नुपर्ने बेलासम्म।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezond in de basis. Je neemt het waarschijnlijk voor lief, en dat is prima – tot je een bed deelt met iemand met heel andere gewoonten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muli bwino. Mwina simuziganizira kwambiri, ndipo palibe vuto — mpaka mutayamba kugona bedi limodzi ndi munthu wa zizolowezi zosiyana kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu'uuraan fayyaa dha. Tarii akka waan salphaatti ilaalta, kunis rakkoo miti — hanga nama amala hirribaa baay'ee adda ta'e qabu wajjin siree qooddattutti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୂଳତଃ ସୁସ୍ଥ। ଆପଣ ହୁଏତ ଏହାକୁ ସ୍ୱାଭାବିକ ବୋଲି ଧରିନିଅନ୍ତି, ଯାହା ଠିକ୍ ଅଛି — ଯେପର୍ଯ୍ୟନ୍ତ ବହୁତ ଅଲଗା ଅଭ୍ୟାସ ଥିବା କାହା ସହ ଶେଯ ବାଣ୍ଟିନାହାଁନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬੁਨਿਆਦੀ ਤੌਰ ਉੱਤੇ ਸਿਹਤਮੰਦ। ਸ਼ਾਇਦ ਤੁਸੀਂ ਇਸ ਨੂੰ ਆਮ ਗੱਲ ਸਮਝਦੇ ਹੋ, ਜੋ ਠੀਕ ਹੈ — ਜਦ ਤੱਕ ਤੁਸੀਂ ਬਿਲਕੁਲ ਵੱਖਰੀਆਂ ਆਦਤਾਂ ਵਾਲੇ ਕਿਸੇ ਇਨਸਾਨ ਨਾਲ ਬਿਸਤਰਾ ਸਾਂਝਾ ਨਹੀਂ ਕਰਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowa podstawa. Pewnie traktujesz to jako oczywistość, i dobrze – dopóki nie dzielisz łóżka z kimś o zupełnie innych nawykach."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په اساس کې روغ. شاید پرې پام نه کوئ، چې سمه ده — تر هغه چې له داسې چا سره بستر شریک کړئ چې ډېر بېل عادتونه لري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saudável no geral. Você provavelmente nem pensa nisso, e tudo bem — até dividir a cama com alguém de hábitos bem diferentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saudável à partida. Provavelmente nem pensas nisso, o que está bem — até partilhares a cama com alguém de hábitos muito diferentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un somn sănătos, în general. Probabil îl iei ca pe ceva de la sine înțeles, ceea ce e în regulă — până când împarți patul cu cineva cu obiceiuri foarte diferite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здоровая база. Наверное, ты воспринимаешь это как должное — и это нормально, пока не начнёшь делить кровать с человеком с совсем другими привычками."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuzima bwiza busanzwe. Birashoboka ko utabiha agaciro, kandi ni byiza — kugeza igihe uzasangira uburiri n'umuntu ufite imisinzirire itandukanye cyane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මූලිකව සෞඛ්‍ය සම්පන්නයි. ඔබ ඒක ගණන් නොගන්නවා ඇති, ඒකත් හරි — හුඟක් වෙනස් පුරුදු තියෙන කෙනෙක් එක්ක ඇඳ බෙදාගන්නකම්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravý základ. Asi to berieš ako samozrejmosť, čo je v poriadku – kým nezačneš zdieľať posteľ s niekým, kto má úplne iné návyky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrava osnova. Verjetno ga jemlješ za samoumevnega, kar je v redu – dokler ne deliš postelje z nekom z zelo drugačnimi navadami."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hutano hwakajairika. Zvimwe haufungi nezvazvo, izvo zvakanaka — kusvikira wavata pamubhedha mumwe chete nemunhu ane maitiro akasiyana zvikuru."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caafimaad aasaasi ah. Malaha kama fikirtid, taasina waa caadi — ilaa aad sariir la wadaagto qof caadooyin aad u kala duwan leh."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Në rregull në bazë. Ndoshta e merr si të mirëqenë, gjë që është mirë – derisa të ndash shtratin me dikë që ka zakone shumë të ndryshme."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здрава основа. Вероватно то узимаш здраво за готово, што је у реду — док не почнеш да делиш кревет с неким ко има сасвим другачије навике."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séhat dasarna. Anjeun meureun teu pati merhatoskeun, éta teu nanaon, dugi ka anjeun saranjang sareng jalma anu kabiasaanana béda pisan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sund grund. Du tar det nog för givet, och det är okej – tills du delar säng med någon som har helt andra vanor."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afya ya msingi. Huenda unauchukulia kuwa jambo la kawaida, na hilo ni sawa — hadi utakaposhiriki kitanda na mtu mwenye mazoea tofauti sana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அடிப்படையில் ஆரோக்கியம். இதை நீங்கள் பெரிதாக நினைக்காமல் இருக்கலாம், அது பரவாயில்லை — முற்றிலும் வேறுபட்ட பழக்கம் கொண்ட ஒருவருடன் படுக்கையைப் பகிரும் வரை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రాథమికంగా ఆరోగ్యకరం. బహుశా మీరు దాన్ని పెద్దగా పట్టించుకోరు, అది ఫర్వాలేదు — చాలా భిన్నమైన అలవాట్లు ఉన్నవారితో మంచం పంచుకునే వరకు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳолати солим. Эҳтимол ту инро чизи оддӣ медонӣ, ки хуб аст — то он даме ки бо касе бо одатҳои тамоман дигар як кат тақсим кунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุขภาพการนอนพื้นฐานดี คุณอาจมองว่าเป็นเรื่องธรรมดา ซึ่งก็ไม่เป็นไร จนกว่าจะต้องนอนเตียงเดียวกับคนที่นิสัยการนอนต่างกันมาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መሰረታዊ ጥዕና። ምናልባት ከም ንቡር ትርእይዎ፣ እዚ ድማ ጸገም የብሉን — ምስ ኣዝዩ ዝተፈልየ ልምዲ ዘለዎ ሰብ ዓራት ክሳብ እትካፈሉ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esasan sagdyn. Megerem, muny adaty zat hasaplaýansyň, bu kadaly — endikleri düýpgöter başga biri bilen bir düşegi paýlaşýançaň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temelde sağlıklı. Muhtemelen bunu kanıksıyorsun ve bu normal; ta ki alışkanlıkları çok farklı biriyle aynı yatağı paylaşana kadar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здорова база. Ти, мабуть, сприймаєш це як належне, і це нормально — доки не ділиш ліжко з кимось із зовсім іншими звичками."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بنیادی طور پر صحت مند۔ شاید آپ کے لیے یہ معمول کی بات ہے، اور یہ ٹھیک ہے، جب تک کسی بہت مختلف عادتوں والے کے ساتھ بستر بانٹنا نہ پڑے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asosan sogʻlom. Ehtimol, buni odatiy hol deb bilasiz va bu yaxshi — toʻshakni odatlari butunlay boshqacha odam bilan baham koʻrmaguningizcha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khỏe mạnh ở mức cơ bản. Có lẽ bạn coi đó là điều hiển nhiên, cũng chẳng sao — cho đến khi ngủ chung với người có thói quen rất khác."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isiseko esisempilweni. Mhlawumbi akunanto kuwe, kwaye kulungile — de wabelane ngebhedi nomntu onemikhwa eyahluke kakhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìlera tó péye. Ó ṣeé ṣe kí ẹ máa fojú kéré rẹ̀, kò burú — títí ẹ ó fi máa pín ibùsùn pẹ̀lú ẹni tí àṣà rẹ̀ yàtọ̀ pátápátá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本健康。你大概覺得理所當然，這也沒問題——直至你跟作息很不同的人同床共枕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本健康。你大概习以为常，这没关系，直到和作息很不一样的人同床共枕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本上很健康。你大概覺得理所當然，這也沒關係，直到你和作息差很多的人同床共枕。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unempilo enhle eyisisekelo. Kungenzeka ukuthatha kalula, futhi kulungile — kuze kube yilapho wabelana ngombhede nomuntu onemikhuba ehluke kakhulu."
          }
        }
      }
    },
    "Be close to family and watch them grow" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
