            "value" : "Laat op de avond – ik kom tot leven als het donker is"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiku kwambiri — ndimadzuka mdima ukagwa"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halkan booda — dukkana booda nan dammaqa"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଳମ୍ବିତ ରାତି — ଅନ୍ଧାର ପରେ ମୁଁ ଜାଗିଉଠେ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੇਰ ਰਾਤ — ਹਨੇਰਾ ਹੋਣ ਤੋਂ ਬਾਅਦ ਮੇਰੇ ਵਿੱਚ ਜਾਨ ਆਉਂਦੀ ਹੈ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Późny wieczór – ożywam po zmroku"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د شپې ناوخته — له تیارې وروسته مې انرژي راځي"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarde da noite — ganho vida quando escurece"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noite dentro — ganho vida quando escurece"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noaptea târziu — prind viață după lăsarea întunericului"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поздняя ночь — оживаю в темноте"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijoro — ngira imbaraga bumaze kwira"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "රෑ වෙලා — අඳුර වැටුණම තමයි මට පණ එන්නේ"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neskoro v noci – po zotmení ožívam"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozno ponoči – oživim, ko se stemni"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiku — ndinomuka kana kwasviba"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habeen dambe — mugdiga kadib ayaan soo nooladaa"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natën vonë – gjallërohem pas errësirës"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касно ноћу — оживим кад падне мрак"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peuting jero — abdi hirup saparantos poék"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent på kvällen – jag vaknar till liv när det blir mörkt"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiku wa manane — napata uhai giza linapoingia"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நள்ளிரவு — இருட்டியதும்தான் உயிர்ப்பு"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అర్ధరాత్రి — చీకటి పడ్డాకే నాకు జోష్"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаби дер — пас аз торикӣ зинда мешавам"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดึกๆ ยิ่งมืดยิ่งมีพลัง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምሸት ደንጕዩ — ምስ መሸ እነቓቓሕ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gije giç — garaňky düşende janlanýaryn"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece geç saatler, karanlıkta canlanırım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пізно ввечері — оживаю з темрявою"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رات گئے — اندھیرا ہوتے ہی جان آ جاتی ہے"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kech tun — qorongʻi tushgach jonlanaman"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đêm khuya — trời tối mình mới tỉnh"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebusuku — ndiphila xa kumnyama"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Òru — alẹ́ ni ara mi máa ń jí"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深夜，天黑後我才活過來"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深夜——天黑才来劲"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
