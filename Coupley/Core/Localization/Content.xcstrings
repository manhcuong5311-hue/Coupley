        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zati bat dohaintzan eman"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بخشی از آن را می‌بخشم"
          }
        },
