        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muganhu wakasimba. Kana mudiwa wako ane mhuka kana achida imwe, iyi ihurukuro yechokwadi yekuwirirana."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xaddidaad adag. Haddii lammaanahaagu leeyahay ama rabo xayawaan guri, tani waa wada-hadal is-waafaq oo dhab ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një kufizim i prerë. Nëse partneri yt ka ose do një kafshë, kjo është një bisedë e vërtetë për përputhshmërinë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чврсто ограничење. Ако твоја половина има или жели љубимца, ово је прави разговор о усклађености."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wates anu teu tiasa ditawar. Upami pasangan anjeun gaduh atanapi hoyong ingon-ingon, ieu obrolan kacocogan anu saleresna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verklig begränsning. Om din partner har eller vill ha ett husdjur är det här ett viktigt samtal om hur ni passar ihop."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kizuizi kisichobadilika. Ikiwa mwenzi wako ana au anataka mnyama kipenzi, haya ni mazungumzo ya kweli kuhusu kuendana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தவிர்க்க முடியாத வரம்பு. உங்கள் துணையிடம் செல்லப்பிராணி இருந்தாலோ வேண்டுமென்றாலோ, இது பொருத்தம் பற்றிய உண்மையான உரையாடல்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తప్పనిసరి పరిమితి. మీ భాగస్వామికి పెంపుడు జంతువు ఉన్నా, కావాలనుకున్నా, ఇది నిజంగా మాట్లాడుకోవాల్సిన విషయం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маҳдудияти сахт. Агар ёрат ҳайвони хонагӣ дошта бошад ё хоҳад, ин сӯҳбати ҷиддӣ дар бораи мувофиқат аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นข้อจำกัดที่ชัดเจน ถ้าคนรักมีหรืออยากมีสัตว์เลี้ยง นี่คือเรื่องความเข้ากันได้ที่ต้องคุยกันจริงจัง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጽኑዕ ገደብ። መጻምድኹም ዘቤታዊ እንስሳ እንተ ኣለዎም ወይ እንተ ደልዮም፣ እዚ ሓቀኛ ዕላል ምስምማዕ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berk çäklendirme. Söýgüliňiň öý haýwany bar bolsa ýa-da isleýän bolsa, bu gabat gelmek barada hakyky söhbet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesin bir sınır. Partnerinin evcil hayvanı varsa ya da istiyorsa bu gerçek bir uyum konuşması demek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жорстке обмеження. Якщо половинка має улюбленця чи хоче його, це справжня розмова про сумісність."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک پکی رکاوٹ۔ اگر آپ کے ساتھی کے پاس پالتو جانور ہے یا رکھنے کی خواہش ہے، تو یہ ہم آہنگی کی ایک سنجیدہ بات چیت ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qatʼiy cheklov. Agar sherigingizning uy hayvoni boʻlsa yoki xohlasa, bu moslik haqida jiddiy suhbat mavzusi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một giới hạn cứng. Nếu người ấy đang nuôi hoặc muốn nuôi, đây là chuyện hợp nhau thật sự cần bàn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umda oqinileyo. Ukuba iqabane lakho linaso okanye lifuna isilwanyana, le yincoko yokwenene yokuvumelana."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ààlà tí kò ṣeé yí padà. Bí olólùfẹ́ yín bá ní ẹranko ọ̀sìn tàbí bá fẹ́ ní in, èyí jẹ́ ìjíròrò gidi nípa bíbá ara mu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
