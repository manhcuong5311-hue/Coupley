    "Sleep affects mood, patience, and how available you are as a partner." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوم يؤثر في المزاج والصبر ومدى حضورك كشريك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek ovlivňuje náladu, trpělivost i to, nakolik můžeš být protějšku k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvn påvirker humør, tålmodighed og hvor nærværende du kan være som partner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf beeinflusst Stimmung, Geduld und wie präsent du in der Beziehung bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος επηρεάζει τη διάθεση, την υπομονή και το πόση ενέργεια έχεις για το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño afecta al ánimo, a la paciencia y a cuánto puedes estar para tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni vaikuttaa mielialaan, kärsivällisyyteen ja siihen, kuinka läsnä olet kumppanina."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apektado ng tulog ang mood, pasensya, at kung gaano ka kahanda para sa partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil influence l'humeur, la patience et ta disponibilité dans le couple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינה משפיעה על מצב הרוח, על הסבלנות ועל כמה יש לך פניות לזוגיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद का असर मूड, सब्र और पार्टनर के तौर पर आपकी मौजूदगी पर पड़ता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alvás hat a hangulatra, a türelemre és arra, mennyire tudsz jelen lenni a kapcsolatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur memengaruhi mood, kesabaran, dan seberapa hadir kamu untuk pasanganmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno influisce sull’umore, sulla pazienza e su quanto riesci a esserci per il tuo partner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は、気分や忍耐力、パートナーとしてどれだけ向き合えるかにも影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠은 기분, 인내심, 그리고 연인에게 얼마나 마음을 쓸 수 있는지에 영향을 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur mempengaruhi perasaan, kesabaran dan sejauh mana anda boleh hadir sebagai pasangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvn påvirker humøret, tålmodigheten og hvor mye du har å gi som partner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap beïnvloedt je stemming, je geduld en hoeveel je er als partner kunt zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen wpływa na nastrój, cierpliwość i na to, ile możesz dać w związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono afeta o humor, a paciência e o quanto você está disponível para seu amor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somnul îți influențează starea, răbdarea și cât de mult poți fi acolo pentru partenerul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон влияет на настроение, терпение и на то, сколько тебя остаётся для партнёра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömnen påverkar humör, tålamod och hur närvarande du kan vara som partner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนอนส่งผลต่ออารมณ์ ความอดทน และความพร้อมในการอยู่เคียงข้างคนรัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku; ruh halini, sabrını ve partner olarak ne kadar orada olabildiğini etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон впливає на настрій, терпіння й те, скільки тебе вистачає на стосунки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấc ngủ ảnh hưởng đến tâm trạng, sự kiên nhẫn và việc bạn có thể ở bên người ấy trọn vẹn đến đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠会影响心情、耐心，以及你能给另一半多少陪伴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠會影響心情、耐心，還有你能給另一半多少陪伴。"
          }
        }
      }
    },
    "Sleep is sacred for you. A partner who keeps you up, or has different sleep habits, will affect your functioning — and your mood." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوم مقدّس عندك. شريك يُبقيك مستيقظًا أو له عادات نوم مختلفة سيؤثر في أدائك ومزاجك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek je pro tebe posvátný. Protějšek, který tě nenechá spát nebo má jiné spací návyky, ovlivní, jak funguješ – i tvou náladu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvn er helligt for dig. En partner, der holder dig vågen eller har andre sovevaner, påvirker, hvordan du fungerer – og dit humør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf ist dir heilig. Wer dich wach hält oder ganz andere Schlafgewohnheiten hat, beeinflusst, wie gut du funktionierst – und deine Laune."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος είναι ιερός για σένα. Ένα ταίρι που δεν σε αφήνει να κοιμηθείς ή έχει άλλες συνήθειες ύπνου θα επηρεάσει τη λειτουργικότητά σου — και τη διάθεσή σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ti el sueño es sagrado. Una pareja que te quite horas de sueño, o tenga otros hábitos, afectará a tu rendimiento — y a tu ánimo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni on sinulle pyhää. Kumppani, joka valvottaa sinua tai jolla on eri unirytmi, vaikuttaa jaksamiseesi – ja mielialaasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagrado sa’yo ang tulog. Ang partner na nagpupuyat sa’yo o may ibang gawi sa pagtulog ay makakaapekto sa pagkilos mo — at sa mood mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil, c'est sacré pour toi. Quelqu'un qui t'empêche de dormir, ou qui a d'autres habitudes, aura un impact sur ta forme — et ton humeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השינה קדושה בשבילך. מי שמונע ממך לישון, או מישהו עם הרגלי שינה שונים, ישפיע על התפקוד שלך — ועל מצב הרוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए नींद सबसे ऊपर है। जो पार्टनर आपको जगाए रखे या जिसकी नींद की आदतें अलग हों, उसका असर आपके दिन पर — और आपके मूड पर — पड़ेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked szent az alvás. Ha a párod ébren tart, vagy mások az alvási szokásai, az kihat a működésedre – és a hangulatodra is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur itu sakral buatmu. Pasangan yang membuatmu begadang, atau punya kebiasaan tidur berbeda, akan memengaruhi kondisimu — dan mood-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per te il sonno è sacro. Un partner che ti toglie il sonno, o con abitudini diverse, inciderà su come stai — e sul tuo umore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は何より大切なものです。夜更かしに付き合わせるパートナーや睡眠習慣が違う相手だと、調子にも気分にも影響が出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠만큼은 양보할 수 없어요. 잠을 못 자게 하거나 수면 습관이 다른 연인이라면 컨디션과 기분에 영향을 줄 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur sangat penting bagi anda. Pasangan yang membuatkan anda berjaga, atau tabiat tidurnya berbeza, akan mempengaruhi fungsi diri — dan perasaan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnen er hellig for deg. En partner som holder deg våken eller har andre søvnvaner, vil påvirke hvordan du fungerer – og humøret ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap is heilig voor je. Een partner die je wakker houdt of andere slaapgewoonten heeft, beïnvloedt hoe je functioneert – en je humeur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen jest dla ciebie święty. Ktoś, kto nie daje ci spać albo ma inne nawyki, wpłynie na twoje funkcjonowanie – i nastrój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para você, o sono é sagrado. Alguém que não te deixe dormir, ou tenha outros hábitos na hora de dormir, vai afetar seu rendimento — e seu humor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somnul e sacru pentru tine. Un partener care nu te lasă să dormi sau are alte obiceiuri de somn îți va da peste cap ritmul — și starea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон для тебя священен. Партнёр, который не даёт спать или живёт в другом режиме, повлияет и на твою продуктивность, и на настроение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömnen är helig för dig. En partner som håller dig vaken eller har andra sovvanor påverkar hur du fungerar – och ditt humör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนอนคือสิ่งศักดิ์สิทธิ์สำหรับคุณ คนรักที่ทำให้คุณนอนดึกหรือมีนิสัยการนอนต่างกันจะส่งผลต่อการใช้ชีวิตและอารมณ์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku senin için kutsal. Seni uyutmayan ya da farklı uyku alışkanlıkları olan bir partner hem verimini hem ruh halini etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон для тебе — святе. Половинка, яка не дає спати чи має інший режим, вплине на твоє самопочуття — і настрій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấc ngủ là thiêng liêng với bạn. Người khiến bạn thức khuya, hay có thói quen ngủ khác, sẽ ảnh hưởng đến sức làm việc — và tâm trạng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠对你来说神圣不可侵犯。如果另一半让你睡不好，或作息很不一样，就会影响你的状态和心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠對你來說很神聖。如果另一半害你熬夜，或作息不同，會影響你的狀態和心情。"
          }
        }
      }
    },
