            "value" : "په نرمۍ اختلاف وکړئ. ژر جوړ جاړی وکړئ. یوځای پاتې شئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discordar com mais calma. Fazer as pazes mais rápido. Seguir juntos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discordar com mais calma. Fazer as pazes mais depressa. Continuar juntos nisto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraziceți-vă mai blând. Împăcați-vă mai repede. Rămâneți uniți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спорьте мягче. Мирьтесь быстрее. Оставайтесь вместе."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutumvikane mu bwitonzi. Mwiyunge vuba. Mukomeze kuba hamwe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෘදුවෙන් එකඟ නොවන්න. ඉක්මනින් යළි සමගි වෙන්න. එකට රැඳී ඉන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesúhlaste jemnejšie. Zmierte sa rýchlejšie. Držte spolu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehkejša nesoglasja. Hitrejša sprava. Ostanita v tem skupaj."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesanai zvinyoro. Yananai nekukurumidza. Rambai muri pamwe chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si jilicsan isugu khilaafa. Si dhakhso ah u heshiiya. Wadajir ku sii jira."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mospajtohuni më butë. Pajtohuni më shpejt. Qëndroni bashkë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расправљајте блаже. Мирите се брже. Останите у томе заједно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teu sapuk kalayan langkung lemes. Akur deui langkung gancang. Tetep babarengan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var oense med mjukare ton. Hitta tillbaka snabbare. Håll ihop."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofautianeni kwa upole. Pataneni haraka. Bakini pamoja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மென்மையாக முரண்படுங்கள். விரைவாக மீளுங்கள். சேர்ந்தே இருங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మృదువుగా విభేదించండి. త్వరగా సర్దుకోండి. కలిసే ఉండండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нармтар баҳс кунед. Зудтар оштӣ шавед. Якҷоя бимонед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นต่างอย่างนุ่มนวล คืนดีให้เร็ว และไม่ทิ้งกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብልስሉስ ተሰሓሓቡ። ቀልጢፍኩም ተዓረቑ። ብሓባር ጽንዑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has ýumşak jedelleşiň. Has çalt ýaraşyň. Bile galyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yumuşak tartışın. Daha hızlı toparlanın. Birlikte kalın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сперечайтеся м’якше. Миріться швидше. Залишайтеся разом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرمی سے اختلاف کریں۔ جلدی صلح کریں۔ ہر حال میں ایک دوسرے کا ساتھ دیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yumshoqroq bahslashing. Tezroq yarashing. Birga qoling."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất đồng nhẹ nhàng hơn. Làm lành nhanh hơn. Cùng nhau vượt qua."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningavumelani ngobunono. Buyelanani ngokukhawuleza. Hlalani kunye kuyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ṣàìfohùnṣọ̀kan jẹ́ẹ́jẹ́ẹ́. Ẹ tètè làjà. Ẹ dúró nínú rẹ̀ papọ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意見不合時溫柔一點，和好得快一點，一起走下去。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有分歧也温柔一点，和好快一点，一直站在一起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意見不同時溫柔一點，和好快一點，一起走下去。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningavumelani ngobumnene. Buyisanani ngokushesha. Hlalani kukho ndawonye."
          }
        }
      }
    },
    "Distance by choice or circumstance. Worth understanding whether that's peaceful or painful — it affects how you approach 'family' as a couple." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand deur keuse of omstandighede. Die moeite werd om te verstaan of dit vreedsaam of pynlik is – dit raak hoe julle as paartjie “familie” benader."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በምርጫ ወይም በሁኔታ የመጣ ርቀት። ሰላማዊ ነው ወይስ የሚያም መሆኑን መረዳት ይጠቅማል — እንደ ጥንዶች «ቤተሰብን» እንዴት እንደምትቀርቡ ይነካልና።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بُعد عن اختيار أو بحكم الظروف. من المفيد فهم ما إذا كان هذا البعد مريحًا أم مؤلمًا، فهو يؤثر في نظرتكما إلى «العائلة» كثنائي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিজৰ বাছনি বা পৰিস্থিতিৰ বাবে দূৰত্ব। সেয়া শান্তিপূৰ্ণ নে বেদনাদায়ক বুজি লোৱা ভাল — যুগল হিচাপে আপুনি “পৰিয়াল”ক কেনেকৈ চায় তাত ইয়াৰ প্ৰভাৱ পৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimlə və ya şəraitlə yaranan məsafə. Bunun sakit, yoxsa ağrılı olduğunu anlamağa dəyər — bu, cütlük olaraq “ailə”yə necə yanaşdığınıza təsir edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыстанцыя па выбары ці па абставінах. Варта зразумець, спакойная яна ці балючая, — ад гэтага залежыць, як вы як пара ставіцеся да «сям’і»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дистанция по избор или по стечение на обстоятелствата. Струва си да разбереш дали е спокойна или болезнена – това влияе на подхода ви към „семейството“ като двойка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দূরত্ব, ইচ্ছেয় বা পরিস্থিতিতে। বুঝে নেওয়া ভালো সেটা শান্তির নাকি কষ্টের — জুটি হিসেবে তোমরা “পরিবার” ব্যাপারটাকে কীভাবে দেখবে, তাতে এর প্রভাব পড়ে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udaljenost po izboru ili zbog okolnosti. Vrijedi razumjeti je li to mirno ili bolno – utiče na to kako kao par pristupate „porodici”."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distància per elecció o per circumstàncies. Val la pena entendre si és en pau o fa mal — influeix en com encareu la «família» com a parella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstup z volby nebo z okolností. Stojí za to pochopit, jestli je klidný, nebo bolestný – ovlivňuje to, jak jako pár přistupujete k „rodině“."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellter drwy ddewis neu amgylchiadau. Mae'n werth deall a yw hynny'n heddychlon neu'n boenus — mae'n effeithio ar sut rydych chi'n ymdrin â ‘theulu’ fel cwpl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand af valg eller omstændigheder. Værd at forstå, om det er fredeligt eller smertefuldt – det påvirker, hvordan I griber »familie« an som par."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand, gewählt oder durch die Umstände. Gut zu verstehen, ob das friedlich oder schmerzhaft ist – es beeinflusst, wie ihr als Paar mit „Familie“ umgeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόσταση από επιλογή ή από συνθήκες. Αξίζει να καταλάβεις αν σε ηρεμεί ή σε πονάει — επηρεάζει το πώς βλέπετε την «οικογένεια» ως ζευγάρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia por elección o por las circunstancias. Vale la pena entender si te da paz o te duele — influye en cómo viven la “familia” como pareja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaugus valikust või olude sunnil. Tasub mõista, kas see on rahulik või valus — see mõjutab, kuidas te paarina „perele“ lähenete."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urruntasuna, aukeraz edo egoeragatik. Merezi du ulertzea bakean ala minez bizi duzun — horrek eragiten du bikote gisa «familiari» nola heltzen diozuen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاصله، به انتخاب یا به حکم شرایط. ارزش دارد بفهمی این فاصله آرام است یا دردناک — روی نگاهتان به «خانواده» به‌عنوان زوج اثر می‌گذارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etäisyys valinnan tai olosuhteiden vuoksi. Kannattaa miettiä, onko se rauhallista vai kipeää – se vaikuttaa siihen, miten suhtaudutte ”perheeseen” parina."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malayo dahil sa pinili o dahil sa sitwasyon. Magandang alamin kung payapa ba ito o masakit — apektado nito kung paano ninyo haharapin ang “pamilya” bilang mag-partner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une distance choisie ou subie. Mieux vaut savoir si elle est apaisée ou douloureuse : ça influence votre façon de voir la « famille » en couple."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achar de bharr rogha nó cúinsí. Is fiú a thuiscint an bhfuil sé sin síochánta nó pianmhar — téann sé i bhfeidhm ar an gcaoi a ndéileálann sibh le “teaghlach” mar lánúin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia por elección ou polas circunstancias. Paga a pena entender se é algo tranquilo ou doloroso: afecta a como entendedes a «familia» como parella."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પસંદગીથી કે સંજોગોથી આવેલું અંતર. એ શાંતિભર્યું છે કે દુઃખદ, એ સમજવા જેવું — કપલ તરીકે તમે “પરિવાર”ને કેવી રીતે જુઓ છો, એના પર એની અસર પડે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nisa ta zaɓi ko ta yanayi. Ya dace a fahimci ko hakan na da natsuwa ko na da zafi — yana shafar yadda kuke kallon “iyali” a matsayin masoya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחק מבחירה או בגלל הנסיבות. כדאי להבין אם זה מקום שליו או כואב — זה משפיע על הדרך שבה שניכם תגשו ל\"משפחה\" כזוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूरी अपनी मर्ज़ी से या हालात से। यह समझना अच्छा है कि यह दूरी सुकून भरी है या दर्द भरी — इसी से तय होगा कि एक कपल के तौर पर “परिवार” को लेकर आपका नज़रिया कैसा होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udaljenost po izboru ili zbog okolnosti. Vrijedi razumjeti je li to mirno ili bolno – utječe na to kako kao par pristupate „obitelji”."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distans pa chwa oswa pa sikonstans. Li bon pou konprann si sa pezib oswa si sa fè mal — sa afekte jan nou de a abòde “fanmi”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Választott vagy kényszerű távolság. Érdemes tisztázni, hogy ez békés vagy fájdalmas – mert ez hat arra, hogyan álltok párként a „család” fogalmához."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հեռավորություն՝ ընտրությամբ կամ հանգամանքների բերումով։ Արժե հասկանալ՝ դա խաղաղ է, թե ցավոտ — դա ազդում է, թե ինչպես եք որպես զույգ մոտենում «ընտանիքին»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjarak karena pilihan atau keadaan. Penting untuk memahami apakah itu terasa damai atau menyakitkan — karena ini memengaruhi cara kalian memaknai “keluarga” sebagai pasangan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịnọ anya site na nhọrọ ma ọ bụ ọnọdụ. Ọ bara uru ịghọta ma nke ahụ dị jụụ ma ọ bụ na-ewute — ọ na-emetụta otú unu abụọ si ele “ezinụlọ” anya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjarlægð af vali eða vegna aðstæðna. Gott að átta sig á hvort hún er friðsæl eða sársaukafull – hún hefur áhrif á hvernig þið nálgist „fjölskyldu“ sem par."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una distanza per scelta o per circostanza. Vale la pena capire se è serena o dolorosa — influisce su come vivete la «famiglia» come coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で選んだのか、事情があるのか。その距離が穏やかなものかつらいものかを理解しておくと、ふたりで「家族」とどう向き合うかが見えてきます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adoh amarga pilihan utawa kahanan. Pantes dimangerteni apa kuwi tentrem utawa nglarani — iki mangaruhi cara panjenengan sakloron nganggep “kulawarga”."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დისტანცია არჩევანით ან გარემოებით. ღირს, გაიაზრო, მშვიდია ეს თუ მტკივნეული — ეს განსაზღვრავს, როგორ უდგებით „ოჯახს“ წყვილად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таңдау не жағдай салдарынан алыстық. Бұл тыныш па, әлде ауыр ма — соны түсінген жөн. Бұл жұп ретінде «отбасыға» қалай қарайтындарыңа әсер етеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការនៅឆ្ងាយដោយជម្រើស ឬដោយកាលៈទេសៈ។ គួរយល់ថាវាស្ងប់ស្ងាត់ ឬឈឺចាប់ — វាប៉ះពាល់ដល់របៀបដែលអ្នកទាំងពីរមើល “គ្រួសារ” ជាគូ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಯ್ಕೆಯಿಂದಲೋ ಸಂದರ್ಭದಿಂದಲೋ ದೂರ. ಅದು ನೆಮ್ಮದಿಯದೇ ನೋವಿನದೇ ಎಂದು ಅರಿಯುವುದು ಒಳ್ಳೆಯದು — ಜೋಡಿಯಾಗಿ ನೀವು “ಕುಟುಂಬ”ವನ್ನು ಹೇಗೆ ನೋಡುತ್ತೀರಿ ಎಂಬುದರ ಮೇಲೆ ಅದು ಪರಿಣಾಮ ಬೀರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택이든 상황 때문이든 거리가 있어요. 그게 편안한 거리인지 아픈 거리인지 이해해 두면 좋아요. 커플로서 ‘가족’을 대하는 방식에 영향을 주니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dûrî bi bijartin an ji ber rewşê. Hêja ye ku fêm bikî ka ew aram e an bi êş e — ev bandorê li nêzîkatiya we ya “malbatê” wekî cot dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тандоо же жагдай менен келген алыстык. Бул тынчтыкпы же ооругу барбы, түшүнүү маанилүү — бул жуп катары «үй-бүлөгө» кандай мамиле кыларыңа таасир этет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanz, gewielt oder duerch d'Ëmstänn. Et lount sech ze verstoen, ob dat friddlech oder schmerzhaft ass — et beaflosst, wéi dir als Koppel mat „Famill“ ëmgitt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຫ່າງເຫີນດ້ວຍການເລືອກ ຫຼື ສະຖານະການ ຄວນເຂົ້າໃຈວ່າມັນສະຫງົບ ຫຼື ເຈັບປວດ — ມັນມີຜົນຕໍ່ວິທີທີ່ເຈົ້າທັງສອງເບິ່ງ ‘ຄອບຄົວ’"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atstumas dėl pasirinkimo ar aplinkybių. Verta suprasti, ar tai ramu, ar skaudu – tai veikia, kaip jūs kaip pora žiūrite į „šeimą“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attālums pēc izvēles vai apstākļu dēļ. Vērts saprast, vai tas ir mierīgs vai sāpīgs, – tas ietekmē, kā jūs kā pāris uztverat „ģimeni”."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanalavirana nofidina na noho ny toe-javatra. Mendrika ho takarina raha milamina na mampanaintaina izany — misy fiantraikany amin'ny fomba fijerinareo roa ny hoe “fianakaviana” izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mamao nā te kōwhiringa, nā ngā āhuatanga rānei. He pai kia mārama mēnā he mārie, he mamae rānei — ka pā ki tō tirohanga ki te “whānau” hei tokorua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растојание по избор или поради околности. Вреди да се разбере дали тоа е мирно или болно — тоа влијае на тоа како пристапувате кон „семејството“ како двојка."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്വന്തം തിരഞ്ഞെടുപ്പുകൊണ്ടോ സാഹചര്യംകൊണ്ടോ ഉള്ള അകലം. അത് സമാധാനപരമാണോ വേദനാജനകമാണോ എന്ന് മനസ്സിലാക്കുന്നത് നല്ലതാണ് — ജോഡിയായി “കുടുംബത്തെ” നിങ്ങൾ എങ്ങനെ സമീപിക്കുന്നു എന്നതിനെ അത് ബാധിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сонголтоор эсвэл нөхцөл байдлаас үүдсэн зай. Энэ тайван уу, өвдөлттэй юу гэдгийг ойлгох нь зүйтэй — хосоороо «гэр бүл»-д хэрхэн хандахад чинь нөлөөлнө."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वतःच्या निवडीने किंवा परिस्थितीमुळे आलेले अंतर. ते शांततेचे आहे की वेदनेचे, हे समजून घेणे महत्त्वाचे — जोडपे म्हणून “कुटुंब” या गोष्टीकडे तुम्ही कसे पाहता, यावर त्याचा परिणाम होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarak kerana pilihan atau keadaan. Elok fahami sama ada ia membawa ketenangan atau kesakitan — ia mempengaruhi cara anda berdua melihat “keluarga”."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanza b'għażla jew b'ċirkostanza. Ta' min tifhem jekk hijiex paċifika jew tweġġa' — taffettwa kif tħarsu lejn il-“familja” bħala koppja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရွေးချယ်မှုကြောင့်ဖြစ်ဖြစ်၊ အခြေအနေကြောင့်ဖြစ်ဖြစ် ဝေးကွာနေတာပါ။ ဒါက ငြိမ်းချမ်းလား၊ နာကျင်လား နားလည်ထားသင့်တယ် — စုံတွဲအနေနဲ့ “မိသားစု” ကို ဘယ်လို ချဉ်းကပ်မလဲဆိုတာကို သက်ရောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstand, enten valgt eller ikke. Verdt å forstå om den føles fredelig eller sår – det påvirker hvordan dere tenker på «familie» som par."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोजाइले वा परिस्थितिले बनेको दूरी। त्यो शान्तिपूर्ण हो कि पीडादायी, बुझ्नु राम्रो — यसले जोडीका रूपमा तपाईं ‘परिवार’ लाई कसरी हेर्नुहुन्छ भन्नेमा असर गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand door keuze of omstandigheden. Goed om te weten of dat rust geeft of pijn doet – het bepaalt hoe jullie als stel met ‘familie’ omgaan."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutalikirana mwakufuna kapena chifukwa cha mmene zinthu zilili. Ndi bwino kumvetsa ngati izi nzamtendere kapena zopweteka — zimakhudza mmene inu awiri mumaonera “banja”."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fagaachuu filannoon ykn haalaan. Kun nagaa ykn dhukkubbii akka ta'e hubachuun gaarii dha — akka jaalallee lamaaniitti “maatii” akkamitti akka ilaaltan irratti dhiibbaa qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଇଚ୍ଛାରେ ବା ପରିସ୍ଥିତିରେ ଦୂରତା। ତାହା ଶାନ୍ତିପୂର୍ଣ୍ଣ ନା ବେଦନାଦାୟକ, ବୁଝିବା ଭଲ — ଯୁଗଳ ଭାବେ ଆପଣ ‘ପରିବାର’କୁ କିପରି ଦେଖିବେ, ଏହା ତାହା ଉପରେ ପ୍ରଭାବ ପକାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੂਰੀ ਆਪਣੀ ਮਰਜ਼ੀ ਨਾਲ ਜਾਂ ਹਾਲਾਤ ਕਰਕੇ। ਇਹ ਸਮਝਣਾ ਚੰਗਾ ਹੈ ਕਿ ਇਹ ਸਕੂਨ ਵਾਲੀ ਹੈ ਜਾਂ ਦੁਖਦਾਈ — ਇਸ ਦਾ ਅਸਰ ਇਸ ਗੱਲ ਉੱਤੇ ਪੈਂਦਾ ਹੈ ਕਿ ਜੋੜੇ ਵਜੋਂ ਤੁਸੀਂ “ਪਰਿਵਾਰ” ਨੂੰ ਕਿਵੇਂ ਦੇਖਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dystans z wyboru albo z okoliczności. Warto zrozumieć, czy to spokój, czy ból – bo to wpływa na to, jak podchodzicie do „rodziny” jako para."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لرې‌والی د انتخاب یا حالاتو له امله. ښه به وي پوه شئ چې دا آرامه ده که دردناکه — دا اغېز کوي چې د جوړې په توګه «کورنۍ» ته څنګه ګورئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância por escolha ou por circunstância. Vale entender se isso traz paz ou dor — afeta como vocês vão encarar a “família” como casal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância por escolha ou por circunstância. Vale a pena perceber se isso traz paz ou dor — afeta a forma como encaram a «família» enquanto casal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanță aleasă sau impusă de împrejurări. Merită să înțelegi dacă e una liniștită sau dureroasă — influențează cum vă raportați la „familie” în cuplu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дистанция — по выбору или по обстоятельствам. Стоит понять, спокойная она или болезненная: от этого зависит, что для вас как пары значит «семья»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuba kure ku bushake cyangwa kubera ibihe. Ni byiza gusobanukirwa niba ibyo bituje cyangwa bibabaza — bigira ingaruka ku buryo mufata “umuryango” nk'abakundana."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කැමැත්තෙන් හෝ තත්ත්වය නිසා ඇති වූ දුරස්ථභාවය. ඒක සාමකාමීද රිදවන එකක්ද කියලා තේරුම් ගන්න වටිනවා — යුවළක් විදිහට ඔබ “පවුල” දකින විදිහට ඒක බලපානවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstup z vlastnej voľby alebo okolností. Oplatí sa pochopiť, či je pokojný alebo bolestivý – ovplyvňuje to, ako vy dvaja pristupujete k „rodine“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razdalja po izbiri ali zaradi okoliščin. Vredno je razumeti, ali je to mirno ali boleče – vpliva na to, kako kot par pristopata k „družini“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva kure nekusarudza kana nemamiriro. Zvakakodzera kunzwisisa kana izvozvo zvine rugare kana zvichirwadza — zvinobata maonero enyu “mhuri” muri vaviri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fogaansho doorasho ama xaalad ku yimid. Waa mudan tahay in la fahmo inay nabad tahay ama xanuun — waxay saameysaa sida aad lammaane ahaan ula dhaqantaan “qoyska”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largësi nga zgjedhja ose nga rrethanat. Vlen të kuptosh nëse kjo është paqësore apo e dhimbshme – ndikon në mënyrën si e shihni „familjen“ si çift."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаљеност по избору или по околностима. Вреди разумети да ли је то мирно или болно — то утиче на то како као пар приступате „породици“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebih ku pilihan atanapi ku kaayaan. Patut dipikaharti naha éta tengtrem atanapi nyeri — éta mangaruhan kumaha aranjeun nyanghareupan “kulawarga” salaku pasangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstånd av val eller omständigheter. Värt att förstå om det känns fridfullt eller smärtsamt – det påverkar hur ni ser på ”familj” som par."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbali kwa chaguo au kwa hali. Ni vyema kuelewa kama hilo lina amani au maumivu — linaathiri jinsi mnavyoichukulia “familia” mkiwa wenzi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்வாலோ சூழ்நிலையாலோ ஏற்பட்ட தொலைவு. அது அமைதியானதா, வலி தருவதா என்பதைப் புரிந்துகொள்வது நல்லது — ஜோடியாக “குடும்பத்தை” நீங்கள் அணுகும் விதத்தை அது பாதிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంపికతోనో, పరిస్థితులతోనో వచ్చిన దూరం. అది ప్రశాంతమైనదా, బాధాకరమైనదా అని అర్థం చేసుకోవడం మంచిది — జంటగా “కుటుంబం” విషయాన్ని మీరు ఎలా చూస్తారో దానిపై ప్రభావం ఉంటుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дурӣ бо интихоб ё бо шароит. Арзиш дорад бифаҳмӣ, ки ин ором аст ё дардовар — ин ба он таъсир мекунад, ки шумо ҳамчун ҷуфт ба «оила» чӣ гуна менигаред."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ห่างเพราะเลือกเองหรือเพราะสถานการณ์ ควรเข้าใจว่าความห่างนั้นสงบหรือเจ็บปวด เพราะมันส่งผลต่อการมอง “ครอบครัว” ในฐานะคู่รัก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብምርጫ ወይ ብኩነታት ዝመጸ ርሕቀት። ሰላማዊ ድዩ ወይስ ዘሕምም ምርዳእ ይጠቅም — ከም ጽምዲ ንዛዕባ «ስድራ» ብኸመይ ከም እትቐርብዎ ይጸልው።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saýlaw ýa-da ýagdaý sebäpli aralyk. Munuň rahatlyk ýa-da agyry berýändigine düşünmäge degýär — bu jübüt hökmünde “maşgala” garaýşyňyza täsir edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteyerek ya da koşullar gereği oluşmuş bir mesafe. Bunun huzurlu mu acı verici mi olduğunu anlamaya değer; çift olarak “aile” kavramına yaklaşımınızı etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстань — з вибору чи через обставини. Варто зрозуміти, спокійна вона чи болюча: від цього залежить, як ви підходите до «родини» як пара."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاصلہ اپنی مرضی سے یا حالات کی وجہ سے۔ یہ سمجھنا اچھا ہے کہ یہ پُرسکون ہے یا تکلیف دہ — اس سے طے ہوتا ہے کہ بطور جوڑا “خاندان” کے بارے میں آپ کا رویہ کیا ہوگا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanlov yoki sharoit tufayli masofa. Bu tinch masofami yoki ogʻriqlimi, tushunishga arziydi — bu ikkalangiz «oila»ga qanday yondashishingizga taʼsir qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xa cách do lựa chọn hay hoàn cảnh. Nên hiểu đó là sự bình yên hay nỗi đau — nó ảnh hưởng đến cách hai bạn nhìn chuyện “gia đình”."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgama ngokuzikhethela okanye ngenxa yeemeko. Kufanelekile ukuqonda ukuba oko kunoxolo okanye kubuhlungu — kuchaphazela indlela enijonga ngayo ‘usapho’ njengesibini."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jíjìnnà nípa àṣàyàn tàbí nípa ipò. Ó yẹ kí ẹ lóye bóyá ó ní àlàáfíà tàbí ó ń dunni — ó ń nípa lórí bí ẹ̀yin méjèèjì ṣe ń wo “ẹbí”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疏遠可能是選擇，也可能是環境使然。值得了解這是平靜還是痛苦，這會影響你們作為情侶怎樣看待「家庭」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离可能是主动选择，也可能是环境所致。值得弄清楚这让你平静还是难过，因为它会影响你们俩如何看待“家人”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份距離可能是選擇，也可能是環境使然。值得弄清楚它讓你平靜還是難受，這會影響你們兩人怎麼看待「家」。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibanga ngokuzikhethela noma ngenxa yesimo. Kufanele kuqondwe ukuthi kunokuthula noma kubuhlungu — kuthinta indlela enibheka ngayo “umndeni” njengombhangqwana."
          }
        }
      }
    },
    "Distance helps you regulate before you respond. Let your partner know you're not shutting them out — you're coming back." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand help jou om tot rus te kom voordat jy reageer. Laat jou maat weet jy sluit nie uit nie – jy kom terug."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መራራቅ ምላሽ ከመስጠትዎ በፊት ራስዎን እንዲያረጋጉ ይረዳዎታል። አጋርዎን እያገለሉ እንዳልሆነ ይንገሯቸው — እየተመለሱ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الابتعاد يساعدكم على ضبط مشاعركم قبل الرد. أخبروا شريكك أنكم لا تغلقون الباب في وجهه، بل ستعودون."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঁহাৰি দিয়াৰ আগতে দূৰত্বই আপোনাক নিজকে সামলাবলৈ সহায় কৰে। সংগীক জনাই দিয়ক যে আপুনি দুৱাৰ বন্ধ কৰা নাই — আপুনি উভতি আহিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Məsafə sənə cavab verməzdən əvvəl özünü toplamağa kömək edir. Partnyoruna onu kənarlaşdırmadığını, geri qayıdacağını bildir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыстанцыя дапамагае табе ўзяць сябе ў рукі, перш чым адказаць. Дай палавінцы зразумець, што ты не адгароджваешся — ты вернешся."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дистанцията ти помага да се овладееш, преди да отговориш. Кажи на половинката си, че не я отблъскваш – а че ще се върнеш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাড়া দেওয়ার আগে দূরত্ব তোমাকে নিজেকে সামলাতে সাহায্য করে। পার্টনারকে জানিয়ে দিয়ো, তুমি ওকে দূরে ঠেলছ না — তুমি ফিরে আসছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udaljenost ti pomaže da se smiriš prije nego odgovoriš. Reci voljenoj osobi da je ne isključuješ – nego da se vraćaš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distància t'ajuda a regular-te abans de respondre. Fes saber a la teva parella que no la deixes fora — que tornaràs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstup ti pomáhá zklidnit se, než odpovíš. Dej protějšku vědět, že ho neodstrkuješ – že se vrátíš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae pellter yn dy helpu i dawelu cyn ymateb. Rho wybod i dy bartner nad wyt ti'n cau'r drws — rwyt ti'n dod nôl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand hjælper dig med at finde roen, før du svarer. Lad din partner vide, at du ikke lukker vedkommende ude – du kommer tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand hilft dir, dich zu sortieren, bevor du reagierst. Sag deinem Schatz, dass du dich nicht abschottest – sondern zurückkommst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόσταση σε βοηθά να ηρεμήσεις πριν απαντήσεις. Πες στο ταίρι σου ότι δεν το αποκλείεις — ότι θα επιστρέψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distancia te ayuda a serenarte antes de responder. Hazle saber a tu pareja que no le estás cerrando la puerta: vas a volver."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distants aitab sul end enne vastamist tasakaalustada. Anna partnerile teada, et sa ei tõrju teda — sa tuled tagasi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distantziak laguntzen dizu erantzun aurretik zure burua baretzen. Jakinarazi zure bikotekideari ez duzula kanpoan uzten — itzuli egingo zarela."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاصله کمکت می‌کند قبل از جواب دادن آرام شوی. به پارتنرت بگو که او را کنار نمی‌گذاری — داری برمی‌گردی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etäisyys auttaa sinua tasaantumaan ennen kuin vastaat. Kerro kumppanillesi, ettet sulje häntä ulos – palaat kyllä takaisin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakatulong ang distansya para kumalma ka bago tumugon. Ipaalam sa partner mo na hindi mo siya pinagsasarhan — babalik ka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre du recul t'aide à te réguler avant de répondre. Dis à l'autre que tu ne lui fermes pas la porte : tu vas revenir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabhraíonn achar leat socrú sula bhfreagraíonn tú. Cuir in iúl do do pháirtí nach bhfuil tú ag dúnadh an dorais — go bhfuil tú ag teacht ar ais."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A distancia axúdache a regularte antes de responder. Fai saber á túa parella que non a estás a deixar fóra: vas volver."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "થોડું અંતર તમને જવાબ આપતાં પહેલાં સંતુલિત થવામાં મદદ કરે છે. તમારા પાર્ટનરને જણાવો કે તમે તેમને દૂર નથી કરી રહ્યા — તમે પાછા આવવાના છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nisa na taimaka muku ku natsu kafin ku amsa. Ku sanar da abokin zamanku cewa ba ƙauracewa kuke yi ba — za ku dawo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחק עוזר לך להירגע לפני שמגיבים. כדאי להבהיר לצד השני שזו לא סגירת דלת — אלא הפסקה לפני שחוזרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब देने से पहले दूरी आपको सँभलने में मदद करती है। पार्टनर को बता दें कि आप उन्हें दूर नहीं कर रहे — आप लौटकर आएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmak ti pomaže da se smiriš prije nego odgovoriš. Daj voljenoj osobi do znanja da je ne isključuješ – nego da se vraćaš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distans ede ou kontwole tèt ou anvan ou reponn. Fè patnè ou konnen ou pa fèmen pòt la ba li — w ap tounen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távolság segít lecsillapodni, mielőtt reagálsz. Jelezd a párodnak, hogy nem zárod ki – vissza fogsz jönni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հեռավորությունն օգնում է քեզ ինքնատիրապետում վերագտնել նախքան արձագանքելը։ Թող զուգընկերդ իմանա, որ դու իրենից չես փակվում — դու վերադառնալու ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarak membantumu menenangkan diri sebelum merespons. Beri tahu pasanganmu bahwa kamu nggak menutup diri — kamu akan kembali."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịnọ iche na-enyere gị aka idozi onwe gị tupu ị zaa. Mee ka onye gị mara na ị naghị emechibido ya ụzọ — ị na-alọghachi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjarlægð hjálpar þér að ná stjórn á þér áður en þú svarar. Láttu makann þinn vita að þú sért ekki að skella í lás – þú kemur aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distanza ti aiuta a ritrovare l’equilibrio prima di rispondere. Fai sapere al tuo partner che non stai chiudendo la porta — poi tornerai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離を置くことで、気持ちを整えてから向き合えるタイプです。締め出しているのではなく、ちゃんと戻ってくることをパートナーに伝えておきましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adoh sedhela mbantu panjenengan tenang sadurunge nanggepi. Kandhakna marang pasangan yen panjenengan ora nutup lawang — panjenengan bakal bali."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დისტანცია გეხმარება, დამშვიდდე, სანამ უპასუხებ. უთხარი პარტნიორს, რომ არ გაურბიხარ — დაბრუნდები."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауап берер алдында арақашықтық сабаңа түсуге көмектеседі. Серігіңе одан бой тартып жатпағаныңды, қайта оралатыныңды айт."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការឃ្លាតមួយភ្លែតជួយឲ្យអ្នកស្ងប់ចិត្ត មុននឹងឆ្លើយតប។ ប្រាប់ដៃគូរបស់អ្នកថា អ្នកមិនមែនបិទទ្វារដាក់គាត់ទេ — អ្នកនឹងត្រឡប់មកវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉತ್ತರಿಸುವ ಮೊದಲು ಸ್ವಲ್ಪ ದೂರ ನಿಮ್ಮನ್ನು ಸಮತೋಲನಕ್ಕೆ ತರುತ್ತದೆ. ನೀವು ಅವರನ್ನು ದೂರ ತಳ್ಳುತ್ತಿಲ್ಲ — ಮರಳಿ ಬರುತ್ತೀರಿ ಎಂದು ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ತಿಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거리를 두면 마음을 가다듬고 대답할 수 있어요. 연인을 밀어내는 게 아니라 다시 돌아올 거라는 걸 꼭 알려 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dûrî alîkariya te dike ku berî bersivdanê xwe aram bikî. Bihêle hevjînê te bizane ku tu derî lê nagirî — tu vedigerî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алыстык сага жооп берүүдөн мурун өзүңдү кармоого жардам берет. Сүйгөнүңдү түртүп жатпаганыңды — кайра келерин айтып кой."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanz hëlleft dir, dech ze sammelen, éier s du äntwers. Looss däi Schatz wëssen, datt s du d'Dier net zoumaachs — du kënns erëm."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໄລຍະຫ່າງຊ່ວຍໃຫ້ເຈົ້າຄວບຄຸມອາລົມກ່ອນຕອບ ບອກຄູ່ຂອງເຈົ້າໃຫ້ຮູ້ວ່າເຈົ້າບໍ່ໄດ້ປິດໃຈໃສ່ — ເຈົ້າຈະກັບມາ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atstumas padeda nusiraminti prieš atsakant. Leisk antrajai pusei žinoti, kad neužsidarai nuo jos – tu sugrįši."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attālums palīdz tev nomierināties, pirms atbildi. Pasaki otrajai pusei, ka tu viņu neatstumj – tu atgriezīsies."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fanalavirana kely no manampy anao hifehy ny tenanao alohan'ny hamaliana. Ampahafantaro ny olon-tianao fa tsy manidy ny varavarana aminy ianao — fa hiverina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te wehe iti koe e whakatau ai i mua i te urupare. Whakamōhiotia tō hoa aroha kāore koe e kati ana i a ia — ka hoki mai koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растојанието ти помага да се смириш пред да одговориш. Кажи ѝ на половинката дека не ја исклучуваш — дека ќе се вратиш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രതികരിക്കും മുമ്പ് സ്വയം ശാന്തരാകാൻ അകലം നിങ്ങളെ സഹായിക്കുന്നു. നിങ്ങൾ പങ്കാളിയെ അകറ്റുകയല്ല, തിരിച്ചുവരികയാണെന്ന് അവരെ അറിയിക്കൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хариулахаасаа өмнө зай авах нь чамайг тайвшруулдаг. Ханиасаа хаалгаа хаагаагүй, эргэж ирнэ гэдгээ мэдэгдээрэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिसाद देण्याआधी थोडे अंतर तुम्हाला सावरायला मदत करते. जोडीदाराला सांगून ठेवा की तुम्ही दार बंद करत नाही — तुम्ही परत येणार आहात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarak membantu anda mengawal diri sebelum bertindak balas. Beritahu pasangan anda bahawa anda bukan menolaknya — anda akan kembali."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-distanza tgħinek tikkalma qabel ma twieġeb. Għarraf lill-partner tiegħek li m'intix qed tagħlaq il-bieb — qed terġa' lura."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခဏခွာနေတာက သင် မတုံ့ပြန်ခင် စိတ်ကို ထိန်းနိုင်စေတယ်။ ချစ်သူကို ပိတ်ပယ်နေတာ မဟုတ်ဘဲ ပြန်လာမှာပါလို့ ပြောပြထားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstand hjelper deg å finne roen før du svarer. Si til partneren din at du ikke trekker deg unna – du kommer tilbake."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिक्रिया दिनुअघि अलि टाढा बस्दा तपाईं सन्तुलित हुनुहुन्छ। तपाईं उहाँलाई टाढा राख्दै हुनुहुन्न, फर्केर आउँदै हुनुहुन्छ भनेर पार्टनरलाई भनिदिनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand helpt je tot rust te komen voordat je reageert. Laat je partner weten dat je je niet afsluit – je komt terug."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutalikirana pang'ono kumakuthandizani kukhazikika musanayankhe. Dziwitsani wokondedwa wanu kuti simukuwatsekera kunja — mubwerera."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fagaachuun deebii kennuu kee dura of to'achuuf si gargaara. Akka ati jaalallee kee hin cufne, garuu akka deebitu itti himi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଉତ୍ତର ଦେବା ଆଗରୁ ଟିକେ ଦୂରତା ଆପଣଙ୍କୁ ସମ୍ଭାଳିବାରେ ସାହାଯ୍ୟ କରେ। ଆପଣଙ୍କ ସାଥୀଙ୍କୁ ଜଣାନ୍ତୁ ଯେ ଆପଣ ସେମାନଙ୍କୁ ଦୂରେଇ ଦେଉନାହାଁନ୍ତି — ଆପଣ ଫେରି ଆସିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਥੋੜ੍ਹੀ ਦੂਰੀ ਜਵਾਬ ਦੇਣ ਤੋਂ ਪਹਿਲਾਂ ਤੁਹਾਨੂੰ ਸੰਭਲਣ ਵਿੱਚ ਮਦਦ ਕਰਦੀ ਹੈ। ਪਾਰਟਨਰ ਨੂੰ ਦੱਸ ਦਿਓ ਕਿ ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਤੋਂ ਮੂੰਹ ਨਹੀਂ ਮੋੜ ਰਹੇ — ਤੁਸੀਂ ਮੁੜ ਆ ਰਹੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dystans pomaga ci odzyskać równowagę, zanim zareagujesz. Daj drugiej połówce znać, że jej nie odtrącasz – po prostu za chwilę wrócisz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لرې‌والی درسره مرسته کوي چې له ځواب مخکې ځان آرام کړئ. خپل ملګري ته ووایئ چې دروازه پرې نه تړئ — بېرته راځئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A distância ajuda você a se regular antes de responder. Avise seu amor que você não está se fechando — você vai voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A distância ajuda-te a acalmar antes de responder. Diz ao teu par que não estás a fechar a porta — vais voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanța te ajută să te liniștești înainte să răspunzi. Spune-i partenerului tău că nu te închizi în fața lui — o să revii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дистанция помогает тебе успокоиться, прежде чем ответить. Дай партнёру понять, что ты не закрываешься, а обязательно вернёшься."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwitarura gato bigufasha gutuza mbere yo gusubiza. Menyesha umukunzi wawe ko utamuhunze — ko uzagaruka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ප්‍රතිචාර දක්වන්න කලින් දුරස්ථ වීම ඔබට සමබර වෙන්න උදව් වෙනවා. ඔබ ඔවුන්ව පිටමං කරන්නේ නැහැ, ආපසු එනවා කියලා ඔබේ සහකරුට කියන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstup ti pomáha upokojiť sa, než zareaguješ. Daj tvojej polovičke vedieť, že ju neodstrkuješ – že sa vrátiš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razdalja ti pomaga, da se umiriš, preden se odzoveš. Povej partnerju, da ga ne izključuješ – da se vrneš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva kure kunokubatsira kudzikama usati wapindura. Udza mudiwa wako kuti hausi kumuvharira kunze — uri kudzoka."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fogaanshuhu wuxuu kaa caawiyaa inaad degto ka hor intaadan jawaabin. U sheeg lammaanahaaga inaadan albaabka ku xirayn — inaad soo noqonayso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanca të ndihmon ta rregullosh veten para se të reagosh. Tregoji partnerit tënd që nuk po e përjashton – po kthehesh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаљеност ти помаже да се смириш пре одговора. Реци својој половини да је не искључујеш — да ћеш се вратити."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarak ngabantos anjeun nenangkeun diri sateuacan ngaréspon. Wartosan pasangan yén anjeun sanés nutup diri — anjeun bakal mulang deui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstånd hjälper dig att hitta balansen innan du svarar. Låt din partner veta att det inte handlar om att stänga ute – du kommer tillbaka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbali hukusaidia kujituliza kabla ya kujibu. Mjulishe mwenzi wako kwamba humfungii nje — utarudi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதில் சொல்வதற்கு முன் நிதானமடைய இடைவெளி உங்களுக்கு உதவுகிறது. நீங்கள் அவரை ஒதுக்கவில்லை, திரும்பி வருவீர்கள் என்பதை உங்கள் துணைக்குத் தெரியப்படுத்துங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్పందించే ముందు దూరం మిమ్మల్ని కుదుటపరుస్తుంది. మీరు వారిని దూరం పెట్టడం లేదని, తిరిగి వస్తారని మీ భాగస్వామికి చెప్పండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дурӣ ба ту кӯмак мекунад, ки пеш аз ҷавоб худро ором кунӣ. Ба ёрат бигӯ, ки ту ӯро дур намекунӣ — ту бармегардӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การถอยออกมาช่วยให้คุณตั้งหลักก่อนตอบโต้ บอกคนรักให้รู้ว่าคุณไม่ได้ปิดกั้น แต่จะกลับมาคุยกันแน่นอน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ርሕቀት ቅድሚ ምምላስኩም ክትረግኡ ይሕግዘኩም። ከም ዘይዓጸውኩምዎም — ከም እትምለሱ — ንመጻምድኹም ኣፍልጥዎም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aralyk saňa jogap bermezden öň özüňi dolandyrmaga kömek edýär. Söýgüliňe ondan ýüz öwürmeýändigiňi — gaýdyp geljekdigiňi duýdur."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesafe, cevap vermeden önce kendini dengelemene yardım ediyor. Partnerine onu dışlamadığını, geri döneceğini söyle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дистанція допомагає тобі опанувати себе, перш ніж відповісти. Дай половинці знати, що ти не відгороджуєшся — ти повернешся."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جواب دینے سے پہلے فاصلہ آپ کو سنبھلنے میں مدد دیتا ہے۔ اپنے ساتھی کو بتا دیں کہ یہ انہیں دور کرنا نہیں، بلکہ لوٹ آنے کی تیاری ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masofa javob berishdan oldin oʻzingizni bosib olishga yordam beradi. Sherigingizga uni chetlatmayotganingizni — qaytib kelishingizni bildirib qoʻying."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng cách giúp bạn điều hòa cảm xúc trước khi đáp lại. Hãy cho người ấy biết bạn không gạt người ấy ra — bạn sẽ quay lại."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgama ukunceda uzilawule phambi kokuba uphendule. Lixelele iqabane lakho ukuba awulivaleli ngaphandle — uyabuya."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jíjìnnà díẹ̀ ń ràn yín lọ́wọ́ láti farabalẹ̀ kí ẹ tó fèsì. Ẹ jẹ́ kí olólùfẹ́ yín mọ̀ pé ẹ kò tì í mọ́ ìta — ẹ ń padà bọ̀ ni."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持距離能幫你先穩住情緒再回應。讓另一半知道你不是把對方拒之門外，而是會回來的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉开一点距离，能帮你在回应前稳住情绪。让另一半知道你不是在把对方关在门外，你会回来的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持距離能幫你先穩住情緒再回應。讓另一半知道你不是在把對方拒於門外，而是會回來的。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibanga likusiza uzinze ngaphambi kokuthi uphendule. Yazisa umlingani wakho ukuthi awumvaleli ngaphandle — uyabuya."
          }
        }
      }
    },
    "Distract me with something fun or light" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lei my aandag af met iets lekkers of ligs"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሚያዝናና ወይም ቀለል ባለ ነገር ሀሳቤን ማስቀየር"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلهائي بشيء ممتع أو خفيف"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিবা আমোদজনক বা পাতল কথাৰে মন আঁতৰাই দিয়ক"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikrimi əyləncəli, yüngül bir şeylə yayındır"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адцягні мяне чымсьці вясёлым ці лёгкім"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разсей ме с нещо забавно или леко"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মজার বা হালকা কিছু দিয়ে মন ঘুরিয়ে দাও"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odvuci mi pažnju nečim zabavnim ili laganim"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distreu-me amb alguna cosa divertida o lleugera"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozptýlit mě něčím zábavným nebo lehkým"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tynna fy sylw gyda rhywbeth hwyliog neu ysgafn"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distraher mig med noget sjovt eller let"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenk mich ab – mit etwas Leichtem"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόσπασέ μου την προσοχή με κάτι ευχάριστο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que me distraiga con algo divertido o ligero"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vii mu mõtted millelegi lõbusale või kergele"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burua aldatu: zerbait dibertigarri edo arina"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با یک چیز سرگرم‌کننده یا سبک حواسم را پرت کن"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vie ajatukset muualle jollain kivalla"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libangin ako ng kahit anong masaya o magaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me changer les idées avec un truc léger ou drôle"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bain m’aird de le rud éigin spraíúil nó éadrom"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que me distraia con algo divertido ou lixeiro"
          }
        },
        "gu" : {
