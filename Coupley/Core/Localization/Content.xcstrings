        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ijtimoiy va strategik. Stol oʻyinlari oʻyin haqida boʻlgani kabi odamlar haqida hamdir. Birgalikdagi ajoyib hobbi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vừa giao lưu vừa chiến thuật. Board game là chuyện con người không kém gì trò chơi. Một sở thích chung tuyệt vời."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda abantu nobuchule. Imidlalo yebhodi imalunga nabantu kanye njengomdlalo ngokwawo. Yinto entle yokuzonwabisa kunye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbákẹ́gbẹ́ àti ọgbọ́n. Eré orí pátákó jẹ́ nípa àwọn èèyàn bí ó ti jẹ́ nípa eré náà. Eré ìnàjú tó dára láti jọ ṣe."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重社交又講策略。桌遊重點是人，也是遊戲本身。是很好的共同興趣。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既社交又讲策略。桌游的乐趣一半在人，一半在游戏。很适合当作共同爱好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重社交也重策略。桌遊玩的是人，也是遊戲本身。很適合當兩人的共同嗜好。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda abantu namasu. Imidlalo yebhodi imayelana nabantu njengoba nje imayelana nomdlalo. Kuyinto enhle kakhulu yokuzijabulisa ndawonye."
          }
        }
      }
    },
    "Social connection is restorative for you. People give you energy, not drain it. Sunday is for the people you love." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosiale kontak laai jou op. Mense gee jou energie eerder as om dit te tap. Sondag is vir die mense vir wie jy lief is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማኅበራዊ ግንኙነት ያድስዎታል። ሰዎች ኃይል ይሰጡዎታል እንጂ አይወስዱብዎትም። እሑድ ለሚወዷቸው ሰዎች ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواصل الاجتماعي يجدّد طاقتكم. الناس يمنحونكم الطاقة ولا يستنزفونها. الأحد لمن تحبون."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সামাজিক সংযোগে আপোনাক সতেজ কৰে। মানুহে আপোনাক শক্তি দিয়ে, শুহি নিনিয়ে। দেওবাৰ আপুনি ভাল পোৱা মানুহবোৰৰ বাবে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosial əlaqə səni bərpa edir. İnsanlar enerjini almır, əksinə verir. Bazar günü sevdiyin insanlar üçündür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зносіны цябе аднаўляюць. Людзі даюць табе энергію, а не забіраюць яе. Нядзеля — для тых, каго ты любіш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общуването те възстановява. Хората ти дават енергия, а не я изцеждат. Неделята е за хората, които обичаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানুষের সঙ্গ তোমাকে আবার তাজা করে। মানুষ তোমার শক্তি কেড়ে নেয় না, বরং দেয়। রবিবার তোমার প্রিয় মানুষদের জন্য।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Društvo te obnavlja. Ljudi ti daju energiju, ne troše je. Nedjelja je za ljude koje voliš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacte social et recarrega. La gent et dona energia, no te la treu. El diumenge és per a la gent que estimes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Společnost tě obnovuje. Lidé ti energii dodávají, ne berou. Neděle patří lidem, na kterých ti záleží."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae cysylltu â phobl yn dy adfer. Mae pobl yn rhoi egni i ti, nid yn ei sugno. Mae dydd Sul ar gyfer y bobl rwyt ti'n eu caru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Socialt samvær lader dig op. Mennesker giver dig energi i stedet for at dræne dig. Søndag er til dem, du holder af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menschen um dich tun dir gut. Sie geben dir Energie, statt sie zu rauben. Der Sonntag gehört den Menschen, die du liebst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαφή με τους άλλους σε αναζωογονεί. Οι άνθρωποι σού δίνουν ενέργεια, δεν σου την παίρνουν. Η Κυριακή είναι για όσους αγαπάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar con la gente te restaura. Las personas te dan energía, no te la quitan. El domingo es para quienes quieres."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suhtlemine taastab sind. Inimesed annavad sulle energiat, mitte ei võta seda. Pühapäev on inimeste jaoks, keda armastad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besteekiko loturek indarra berritzen dizute. Jendeak energia ematen dizu, ez kendu. Igandea maite duzun jendearentzat da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتباط با آدم‌ها حالت را جا می‌آورد. آدم‌ها به تو انرژی می‌دهند، نه اینکه انرژی‌ات را بگیرند. یکشنبه مال آدم‌هایی است که دوستشان داری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosiaalinen yhteys elvyttää sinua. Ihmiset antavat sinulle energiaa eivätkä vie sitä. Sunnuntai on rakkaita ihmisiä varten."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakapagpapanumbalik sa’yo ang pakikisalamuha. Binibigyan ka ng tao ng enerhiya, hindi inuubos. Ang Linggo ay para sa mga mahal mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien social te ressource. Les gens te donnent de l'énergie au lieu de t'en prendre. Le dimanche, c'est pour ceux que tu aimes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is athnuachan duit an ceangal sóisialta. Tugann daoine fuinneamh duit, ní bhaineann siad uait é. Is don dream a bhfuil grá agat dóibh an Domhnach."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vida social recárgate. A xente dáche enerxía, non cha quita. O domingo é para a xente que queres."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "લોકોને મળવાથી તમે ફરી તાજા થાઓ છો. લોકો તમારી ઊર્જા ખેંચતા નથી, આપે છે. રવિવાર તમારા વહાલાઓ માટે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zumunci na dawo muku da kuzari. Mutane na ba ku ƙarfi, ba sa gajiyar da ku. Lahadi don mutanen da kuke ƙauna ce."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קשר חברתי מטעין אותך. אנשים נותנים לך אנרגיה, לא מרוקנים אותה. יום החופש שמור לאנשים היקרים לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोगों से मिलना आपको तरोताज़ा करता है। लोग आपकी ऊर्जा छीनते नहीं, बढ़ाते हैं। रविवार अपनों के लिए है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Društvo te obnavlja. Ljudi ti daju energiju, ne crpe je. Nedjelja je za ljude koje voliš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontak ak moun rechaje ou. Moun ba ou enèji, yo pa fatige ou. Dimanch se pou moun ou renmen yo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A társasági élet feltölt. Az emberek energiát adnak, nem elvesznek. A vasárnap azoké, akiket szeretsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շփումը քեզ վերականգնում է։ Մարդիկ քեզ էներգիա են տալիս, ոչ թե խլում։ Կիրակին սիրելի մարդկանց համար է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan sosial memulihkanmu. Orang lain memberimu energi, bukan menguras. Hari Minggu untuk orang-orang yang kamu sayangi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njikọ na mmadụ na-ewetaghachi gị ike. Ndị mmadụ na-enye gị ume, ha anaghị ewepụ ya. Ụbọchị Ụka bụ maka ndị ị hụrụ n'anya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Félagsleg tengsl endurnæra þig. Fólk gefur þér orku frekar en að draga úr henni. Sunnudagar eru fyrir fólkið sem þú elskar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stare con gli altri ti rigenera. Le persone ti danno energia, non te la tolgono. La domenica è per le persone che ami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人とのつながりで回復するタイプです。人と会うと疲れるどころか元気になります。日曜日は大好きな人たちのための日です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesambungan karo wong liya ngisi tenaga panjenengan. Wong-wong menehi semangat, ora nyedot tenaga. Minggu iku kanggo wong-wong sing panjenengan tresnani."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ადამიანებთან ურთიერთობა ძალას გიბრუნებს. ხალხი ენერგიას გმატებს და არ გართმევს. კვირა საყვარელი ადამიანებისთვისაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адамдармен араласу сені қалпына келтіреді. Адамдар қуатыңды алмайды, қайта береді. Жексенбі — жақсы көретін адамдарыңа арналған."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការជួបជុំសង្គមស្ដារកម្លាំងអ្នកឡើងវិញ។ មនុស្សផ្ដល់ថាមពលដល់អ្នក មិនមែនស្រូបយកវាទេ។ ថ្ងៃអាទិត្យគឺសម្រាប់មនុស្សដែលអ្នកស្រឡាញ់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಜನರ ಒಡನಾಟ ನಿಮಗೆ ಚೈತನ್ಯ ನೀಡುತ್ತದೆ. ಜನರು ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನು ಹೀರುವುದಿಲ್ಲ, ತುಂಬುತ್ತಾರೆ. ಭಾನುವಾರ ನೀವು ಪ್ರೀತಿಸುವವರಿಗಾಗಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사람들과의 연결이 나를 회복시켜 줘요. 사람에게서 에너지를 얻는 타입이죠. 일요일은 사랑하는 사람들을 위한 날이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girêdana civakî te nû dike. Mirov enerjiyê didin te, ne ku jê dibin. Yekşem ji bo kesên ku tu jê hez dikî ye."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адамдар менен байланыш сени калыбына келтирет. Адамдар күчүңдү албайт, тескерисинче берет. Жекшемби — сүйгөн адамдарың үчүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat anere Leit zesummen ze sinn, lued deng Batterien op. Leit ginn dir Energie, amplaz der ze zéien. Sonndes ass fir déi Mënschen, déi s du gär hues."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການພົບປະຜູ້ຄົນຊ່ວຍຟື້ນຟູເຈົ້າ ຜູ້ຄົນເຕີມພະລັງໃຫ້ເຈົ້າ ບໍ່ແມ່ນດູດມັນໄປ ວັນອາທິດມີໄວ້ສຳລັບຄົນທີ່ເຈົ້າຮັກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendravimas tave atgaivina. Žmonės tau suteikia energijos, o ne ją atima. Sekmadienis – mylimiems žmonėms."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saskarsme ar cilvēkiem tevi atjauno. Cilvēki tev dod enerģiju, nevis to atņem. Svētdiena ir tiem, ko tu mīli."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamerina hery anao ny fifandraisana amin'ny olona. Manome hery anao ny olona fa tsy mandany izany. Ho an'ny olona tianao ny alahady."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te hono ki te tangata he whakaora mōu. Ka hoatu te tangata i te kaha, kaua e tango. Ko te Rātapu mō te hunga e aroha ana koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дружењето те обновува. Луѓето ти даваат енергија, не ти ја цицаат. Неделата е за луѓето што ги сакаш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആളുകളുമായുള്ള അടുപ്പം നിങ്ങൾക്ക് ഉന്മേഷം നൽകുന്നു. ആളുകൾ നിങ്ങളുടെ ഊർജം ചോർത്തുകയല്ല, നിറയ്ക്കുകയാണ്. ഞായറാഴ്ച നിങ്ങൾ സ്നേഹിക്കുന്നവർക്കുള്ളതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хүмүүстэй холбогдох нь чамайг сэргээдэг. Хүмүүс чамаас эрч хүч авдаггүй, харин өгдөг. Ням гараг бол хайртай хүмүүстээ зориулсан өдөр."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माणसांशी जोडलेले राहणे तुम्हाला ताजेतवाने करते. माणसे तुमची ऊर्जा घेत नाहीत, तर देतात. रविवार आहे प्रिय माणसांसाठी."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan sosial memulihkan anda. Orang lain memberi anda tenaga, bukan menghabiskannya. Hari Ahad untuk insan yang anda sayangi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kuntatt man-nies jirrestawrak. In-nies jagħtuk l-enerġija, mhux jeħdulhielek. Il-Ħadd huwa għan-nies li tħobb."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လူမှုဆက်ဆံရေးက သင့်ကို ပြန်လည်လန်းဆန်းစေတယ်။ လူတွေက သင့်အား ကုန်စေတာ မဟုတ်ဘဲ အားပေးတယ်။ တနင်္ဂနွေက သင်ချစ်တဲ့သူတွေအတွက်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosial kontakt gjør deg godt. Folk gir deg energi i stedet for å tappe deg. Søndagen er for dem du er glad i."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मान्छेसँगको सम्बन्धले तपाईंलाई ताजा बनाउँछ। मान्छेले तपाईंको ऊर्जा खाँदैनन्, बरु दिन्छन्। आइतबार मन पर्ने मान्छेहरूका लागि हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sociaal contact laadt je op. Mensen geven je energie in plaats van dat ze die kosten. Zondag is voor de mensen van wie je houdt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kucheza ndi anthu kumakubwezeretsani mphamvu. Anthu amakupatsani mphamvu, osati kukutopetsani. Lamulungu ndi la anthu omwe mumawakonda."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walitti dhufeenyi hawaasaa humna siif deebisa. Namoonni humna siif kennu malee si hin dadhabsiisan. Dilbanni namoota ati jaallattuuf."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଲୋକଙ୍କ ସହ ମିଶିବା ଆପଣଙ୍କୁ ସତେଜ କରେ। ଲୋକେ ଆପଣଙ୍କୁ ଶକ୍ତି ଦିଅନ୍ତି, ନିଅନ୍ତି ନାହିଁ। ରବିବାର ଆପଣ ଭଲପାଉଥିବା ଲୋକଙ୍କ ପାଇଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਲੋਕਾਂ ਨਾਲ ਮੇਲ-ਜੋਲ ਤੁਹਾਨੂੰ ਤਾਜ਼ਾ ਕਰਦਾ ਹੈ। ਲੋਕ ਤੁਹਾਡੀ ਊਰਜਾ ਖੋਂਹਦੇ ਨਹੀਂ, ਵਧਾਉਂਦੇ ਹਨ। ਐਤਵਾਰ ਉਨ੍ਹਾਂ ਲਈ ਹੈ ਜਿਨ੍ਹਾਂ ਨੂੰ ਤੁਸੀਂ ਪਿਆਰ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt z ludźmi cię regeneruje. Ludzie dają ci energię, a nie ją zabierają. Niedziela jest dla bliskich."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ټولنیزې اړیکې تاسو ته تازه‌ګي درکوي. خلک تاسو ته انرژي درکوي، نه دا چې انرژي مو واخلي. د رخصتۍ ورځ د هغو خلکو لپاره ده چې مینه ورسره لرئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar com pessoas restaura você. Gente dá energia, não cansa. Domingo é para quem você ama."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar com pessoas recarrega-te. As pessoas dão-te energia em vez de a tirarem. O domingo é para quem amas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oamenii te reîncarcă, nu te secătuiesc. Pentru tine, duminica e pentru cei dragi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общение тебя восстанавливает. Люди дают тебе энергию, а не забирают. Воскресенье — для тех, кого ты любишь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubana n'abandi biragusubiza imbaraga. Abantu baguha imbaraga, ntibazigutwara. Ku cyumweru ni icy'abantu ukunda."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සමාජ සම්බන්ධතා ඔබට සුවයක්. මිනිස්සු ඔබේ ශක්තිය උරා ගන්නේ නැහැ, ශක්තිය දෙනවා. ඉරිදා ඔබ ආදරය කරන අය වෙනුවෙන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt s ľuďmi ťa obnovuje. Ľudia ti energiu dávajú, nie berú. Nedeľa patrí tým, ktorých ľúbiš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Družabnost te obnavlja. Ljudje ti energijo dajejo, ne jemljejo. Nedelja je za tvoje najdražje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuwirirana nevanhu kunokuzorodza. Vanhu vanokupa simba, havakupedzi simba. Svondo nderevanhu vaunoda."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriirka bulshadu wuu ku dhisaa. Dadku tamar bay ku siiyaan, kaama qaadaan. Axaddu waa dadka aad jeceshahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidhja me njerëzit të çlodh. Njerëzit të japin energji, nuk ta marrin. E diela është për njerëzit që do."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друштво те обнавља. Људи ти дају енергију, а не црпе је. Недеља је за људе које волиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan sosial nyegerkeun deui anjeun. Jalma-jalma masihan anjeun tanaga, sanés nyedotna. Dinten Minggu téh kanggo jalma-jalma anu anjeun pikanyaah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Social samvaro är återhämtning för dig. Människor ger dig energi i stället för att ta den. Söndagen är till för dem du älskar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuwa na watu hukurejeshea nguvu. Watu hukupa nguvu, hawakuchoshi. Jumapili ni ya watu unaowapenda."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமூகத் தொடர்பு உங்களைப் புதுப்பிக்கிறது. மனிதர்கள் உங்கள் ஆற்றலை உறிஞ்சுவதில்லை, ஆற்றல் தருகிறார்கள். ஞாயிறு நீங்கள் நேசிப்பவர்களுக்கானது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మనుషులతో కలవడం మీకు సేదతీర్పు. మనుషులు మీ శక్తిని తగ్గించరు, పెంచుతారు. ఆదివారం మీరు ప్రేమించేవారి కోసమే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муоширати иҷтимоӣ туро барқарор мекунад. Одамон ба ту қувват медиҳанд, на мегиранд. Якшанбе барои наздиконат аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การได้อยู่กับผู้คนช่วยฟื้นฟูคุณ คนรอบตัวเติมพลังให้ ไม่ได้ดูดพลังไป วันอาทิตย์มีไว้สำหรับคนที่คุณรัก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማሕበራዊ ርክብ ንዓኹም ሓይሊ ይመልስ። ሰባት ሓይሊ ይህቡኹም እምበር ኣየድክሙኹምን። ሰንበት ነቶም እትፈትውዎም ሰባት እያ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adamlar bilen aragatnaşyk saňa güýç berýär. Adamlar seni ýadatmaýar, güýçlendirýär. Ýekşenbe söýýän adamlaryň üçin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosyal bağ seni yeniliyor. İnsanlar enerjini tüketmiyor, sana enerji veriyor. Pazar, sevdiğin insanların günü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спілкування тебе відновлює. Люди дають тобі енергію, а не забирають. Неділя — для тих, кого ти любиш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوگوں سے میل جول آپ کو تازگی دیتا ہے۔ لوگ آپ کی توانائی بڑھاتے ہیں، گھٹاتے نہیں۔ اتوار اپنے پیاروں کے لیے ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odamlar bilan muloqot sizni tiklaydi. Odamlar sizni charchatmaydi, aksincha quvvat beradi. Yakshanba — sevgan insonlaringiz uchun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối với mọi người giúp bạn hồi phục. Con người tiếp thêm năng lượng cho bạn, không làm bạn kiệt sức. Chủ nhật là dành cho những người bạn thương."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unxibelelwano nabantu luyakuhlaziya. Abantu bakunika amandla, abawatyi. ICawa yeyabantu obathandayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbáṣepọ̀ pẹ̀lú ènìyàn ń mú yín sọjí. Àwọn ènìyàn ń fún yín lágbára, wọn kì í gbà á. Ọjọ́ Àìkú wà fún àwọn tí ẹ fẹ́ràn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和人相處能讓你恢復元氣。人會帶給你能量，而不是消耗你。星期日就是留給你愛的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和人相处让你恢复元气。人会给你能量，而不是消耗你。周日属于你爱的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和人相處能讓你恢復元氣。人會帶給你能量，而不是消耗你。星期天就是留給你愛的人。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuxhumana nabantu kuyakuvuselela. Abantu bayakunika amandla, abawaqedi. ISonto ngelabantu obathandayo."
          }
        }
      }
    },
    "Social processing. Saying it out loud helps you understand how you feel. Your partner is probably your first call." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy verwerk saam met ander. Om dit hardop te sê, help jou verstaan hoe jy voel. Jou maat is waarskynlik die eerste een wat jy bel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በማውራት ያስተናግዳሉ። ጮክ ብሎ መናገር ስሜትዎን እንዲረዱ ይረዳዎታል። ምናልባት መጀመሪያ የሚደውሉት ለአጋርዎ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معالجة بالحديث. قول الأمر بصوت عالٍ يساعدك على فهم مشاعرك، وشريكك على الأرجح أول اتصال لك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথা পাতি বুজা। মুখেৰে কৈ দিলে আপোনাৰ অনুভৱ আপুনি নিজেই বুজি পায়। আপোনাৰ সংগীয়েই হয়তো আপুনি প্ৰথমে ফোন কৰা মানুহজন।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danışaraq həzm edirsən. Hiss etdiklərini ucadan demək onları anlamağa kömək edir. Yəqin ki, ilk zəng etdiyin insan partnyorundur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты разбіраешся праз размову. Калі прамаўляеш уголас, лягчэй зразумець, што адчуваеш. Хутчэй за ўсё, палавінка — першая, каму ты тэлефануеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осмисляш чрез разговор. Когато го кажеш на глас, разбираш какво чувстваш. Половинката ти вероятно е първият човек, на когото звъниш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথা বলেই বোঝো। জোরে বললে তুমি বুঝতে পারো আসলে কেমন লাগছে। তোমার পার্টনারই সম্ভবত তোমার প্রথম ফোনকল।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovorom do jasnoće. Kad nešto izgovoriš naglas, lakše shvatiš kako se osjećaš. Tvoja voljena osoba je vjerovatno prva koju nazoveš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processes parlant. Dir-ho en veu alta t'ajuda a entendre què sents. Segurament la teva parella és la primera persona a qui truques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpracováváš věci s ostatními. Když to vyslovíš nahlas, lépe pochopíš, co cítíš. Tvůj protějšek je nejspíš první, komu voláš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosesu drwy siarad. Mae dweud y peth yn uchel yn dy helpu i ddeall sut rwyt ti'n teimlo. Mae'n debyg mai dy bartner yw'r cyntaf rwyt ti'n ei ffonio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bearbejder socialt. At sige det højt hjælper dig med at forstå, hvordan du har det. Din partner er nok den første, du ringer til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verarbeitest im Austausch. Wenn du es aussprichst, verstehst du, wie es dir geht. Wahrscheinlich rufst du als Erstes deinen Schatz an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργάζεσαι μέσα από την κουβέντα. Όταν το λες δυνατά, καταλαβαίνεις τι νιώθεις. Το ταίρι σου είναι μάλλον το πρώτο σου τηλέφωνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesas en compañía. Decirlo en voz alta te ayuda a entender lo que sientes. Seguramente tu pareja es la primera persona a la que llamas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töötled asju suheldes. Valjult välja ütlemine aitab mõista, mida tunned. Partner on ilmselt esimene, kellele helistad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besteekin prozesatzen duzu. Ozen esateak laguntzen dizu nola sentitzen zaren ulertzen. Zure bikotekidea izango da ziurrenik deitzen duzun lehena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هضم کردن در جمع. بلند گفتنش کمک می‌کند بفهمی چه حسی داری. احتمالاً پارتنرت اولین کسی است که به او زنگ می‌زنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsittelet asioita yhdessä muiden kanssa. Ääneen sanominen auttaa ymmärtämään, miltä sinusta tuntuu. Kumppanisi on luultavasti ensimmäinen, jolle soitat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagpoproseso ka kasama ang iba. Nakakatulong sa’yo ang pagsasabi nito para maintindihan ang nararamdaman mo. Malamang ang partner mo ang una mong tinatawagan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu digères en parlant. Le dire à voix haute t'aide à comprendre ce que tu ressens. L'autre est sûrement la première personne que tu appelles."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próiseáil shóisialta. Cabhraíonn sé leat do mhothúcháin a thuiscint é a rá os ard. Is dócha gurb é do pháirtí an chéad duine a nglaonn tú air."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesas en compañía. Dicilo en voz alta axúdache a entender como te sentes. Seguramente a túa parella é a primeira á que chamas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાત કરીને સમજવું. મોટેથી બોલવાથી તમને સમજાય છે કે તમે શું અનુભવો છો. તમારા પાર્ટનર કદાચ તમારો પહેલો ફોન હોય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna fahimtar abu ta hira. Faɗar abu da baki na taimaka muku fahimtar yadda kuke ji. Wataƙila abokin zamanku ne na farko da kuke kira."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיבוד דרך אנשים. לומר את זה בקול עוזר לך להבין מה עובר עליך. הצד השני כנראה הראשון שמקבל ממך טלפון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात करके सुलझाना। बोलकर कहने से आपको अपनी भावनाएँ समझ आती हैं। शायद सबसे पहला फ़ोन आपके पार्टनर को ही जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prorađivanje kroz razgovor. Kad to izgovoriš naglas, lakše shvatiš što osjećaš. Voljena osoba vjerojatno je prva koju nazoveš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou dijere nan pale. Lè ou di l fò, sa ede ou konprann sa ou santi. Patnè ou gendwa premye moun ou rele."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beszélgetve dolgozod fel a dolgokat. Ha kimondod, jobban érted, mit érzel. Valószínűleg a párodat hívod elsőként."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Զրույցով մարսելու ձև։ Բարձրաձայն ասելն օգնում է հասկանալ, թե ինչ ես զգում։ Զուգընկերդ հավանաբար առաջինն է, ում զանգում ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memproses lewat obrolan. Mengucapkannya langsung membantumu memahami perasaanmu. Pasanganmu mungkin orang pertama yang kamu hubungi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-aghọta ihe site n'ikwu okwu. Ikwu ya n'olu dara ụda na-enyere gị aka ịghọta ihe ị na-eche. Onye gị nwere ike ịbụ onye mbụ ị ga-akpọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú vinnur úr hlutunum með öðrum. Að segja það upphátt hjálpar þér að skilja hvernig þér líður. Makinn þinn er líklega fyrsta símtalið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elabori parlando. Dirlo ad alta voce ti aiuta a capire cosa provi. Il tuo partner è probabilmente la prima persona che chiami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人と話して整理するタイプです。口に出すことで、自分の気持ちがわかります。きっと最初に連絡する相手はパートナーです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngolah rasa bareng wong liya. Ngucapake kanthi banter mbantu panjenengan ngerti apa sing dirasakake. Pasangan panjenengan mbokmenawa wong pisanan sing ditelpon."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საუბრით ალაგებ ფიქრებს. როცა ხმამაღლა ამბობ, უკეთ გესმის, რას გრძნობ. შენი პარტნიორი, ალბათ, პირველია, ვისაც ურეკავ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әңгіме арқылы реттейсің. Дауыстап айтқанда не сезетініңді жақсырақ түсінесің. Бірінші қоңырауың серігіңе болатын шығар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រំលាយអារម្មណ៍តាមរយៈការនិយាយ។ ការនិយាយចេញមក ជួយឲ្យអ្នកយល់ពីអារម្មណ៍ខ្លួនឯង។ ដៃគូរបស់អ្នកប្រហែលជាមនុស្សទីមួយដែលអ្នកហៅទៅរក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತಿನ ಮೂಲಕ ಅರಗಿಸಿಕೊಳ್ಳುವವರು. ಜೋರಾಗಿ ಹೇಳಿದಾಗಲೇ ನಿಮಗೆ ಹೇಗನಿಸುತ್ತಿದೆ ಎಂದು ಅರ್ಥವಾಗುತ್ತದೆ. ನೀವು ಮೊದಲು ಕರೆ ಮಾಡುವುದು ಬಹುಶಃ ನಿಮ್ಮ ಸಂಗಾತಿಗೇ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하면서 정리하는 타입이에요. 소리 내어 말하면 내 감정을 이해하게 돼요. 아마 연인에게 가장 먼저 연락할 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hûrkirina civakî. Gotina bi dengê bilind alîkariya te dike ku tu fêm bikî çi hîs dikî. Belkî hevjînê te kesê yekem e ku tu lê digerî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сүйлөшүү аркылуу түшүнөсүң. Үн чыгарып айтканда эмне сезип жатканыңды жакшыраак түшүнөсүң. Биринчи чалганың, балким, сүйгөнүң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verschaffs am Gespréich. Et laut auszeschwätzen hëlleft dir ze verstoen, wéi s de dech fills. Wahrscheinlech rufs du als éischt däi Schatz un."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຈັດການຄວາມຮູ້ສຶກຜ່ານການລົມ ການໄດ້ເວົ້າອອກມາຊ່ວຍໃຫ້ເຈົ້າເຂົ້າໃຈຄວາມຮູ້ສຶກຂອງຕົນເອງ ຄູ່ຂອງເຈົ້າຄົງເປັນຄົນທຳອິດທີ່ເຈົ້າໂທຫາ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apdorojimas bendraujant. Garsiai ištarti žodžiai padeda suprasti, ką jauti. Tavo antroji pusė tikriausiai yra pirmoji, kam skambini."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu domas sakārto sarunā. Pateikt skaļi palīdz saprast, ko jūti. Tava otrā puse, visticamāk, ir pirmā, kam zvani."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandinika amin'ny resaka. Ny filazana azy mafy no manampy anao hahatakatra izay tsapanao. Azo inoana fa ny olon-tianao no antsoinao voalohany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka whakaaro koe mā te kōrero. Mā te kī ā-waha ka mārama koe ki ō kare ā-roto. Ko tō hoa aroha pea te tuatahi ka waea atu koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средување преку разговор. Кога ќе го кажеш на глас, полесно разбираш што чувствуваш. Половинката веројатно е првата на која ѝ се јавуваш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സംസാരിച്ച് ഉൾക്കൊള്ളുന്ന രീതി. ഉറക്കെ പറയുമ്പോഴാണ് നിങ്ങൾക്ക് എന്ത് തോന്നുന്നുവെന്ന് മനസ്സിലാകുന്നത്. നിങ്ങൾ ആദ്യം വിളിക്കുന്നത് ഒരുപക്ഷേ പങ്കാളിയെയാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ярьж байж боловсруулдаг. Чангаар хэлэх нь юу мэдэрч байгаагаа ойлгоход тусалдаг. Хань чинь хамгийн түрүүнд залгах хүн чинь байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलून उमगणे. मोठ्याने बोलल्यावर तुम्हाला स्वतःच्या भावना कळतात. बहुधा तुम्ही सर्वात आधी जोडीदारालाच फोन करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menghadam perasaan bersama orang lain. Meluahkannya membantu anda faham apa yang dirasa. Pasangan anda mungkin orang pertama yang anda hubungi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipproċessa mal-oħrajn. Meta tgħidha b'leħen għoli tgħinek tifhem kif tħossok. Il-partner tiegħek probabbilment hu l-ewwel persuna li ċċempel."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားပြောရင်း စဉ်းစားတတ်သူပါ။ အသံထွက်ပြောလိုက်မှ ကိုယ့်ခံစားချက်ကို ပိုနားလည်တယ်။ သင့်ချစ်သူက ပထမဆုံး ဖုန်းဆက်မယ့်သူ ဖြစ်လောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bearbeider sammen med andre. Å si det høyt hjelper deg å forstå hva du føler. Partneren din er nok den første du ringer."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुरा गरेर सुल्झाउने। बोलेर भन्दा तपाईंलाई आफ्नो भावना बुझ्न सजिलो हुन्छ। सायद तपाईंले सबैभन्दा पहिले पार्टनरलाई नै फोन गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verwerkt dingen samen met anderen. Hardop zeggen helpt je begrijpen wat je voelt. Je partner is vast de eerste die je belt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumamvetsa zinthu pocheza. Kunena mokweza kumakuthandizani kumvetsa mmene mukumvera. Wokondedwa wanu mwina ndi munthu woyamba amene mumamuimbira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namoota wajjin hubatta. Sagaleedhaan dubbachuun miira kee akka hubattu si gargaara. Bilbilli kee inni jalqabaa gara jaalallee keetti ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଥା ହୋଇ ବୁଝିବା। ଜୋରରେ କହିଲେ ଆପଣ କ’ଣ ଅନୁଭବ କରୁଛନ୍ତି ତାହା ବୁଝିବାରେ ସାହାଯ୍ୟ ହୁଏ। ଆପଣଙ୍କ ସାଥୀ ସମ୍ଭବତଃ ପ୍ରଥମ ଜଣ, ଯାହାଙ୍କୁ ଆପଣ ଫୋନ୍ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੱਲਾਂ ਰਾਹੀਂ ਸਮਝਣਾ। ਬੋਲ ਕੇ ਕਹਿਣ ਨਾਲ ਤੁਹਾਨੂੰ ਆਪਣੇ ਜਜ਼ਬਾਤ ਸਮਝ ਆਉਂਦੇ ਹਨ। ਸ਼ਾਇਦ ਸਭ ਤੋਂ ਪਹਿਲਾਂ ਫ਼ੋਨ ਤੁਸੀਂ ਪਾਰਟਨਰ ਨੂੰ ਹੀ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetwarzanie w rozmowie. Mówienie na głos pomaga ci zrozumieć, co czujesz. Pewnie najpierw dzwonisz do drugiej połówki."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په خبرو هضمول. په لوړ غږ یې ویل درسره مرسته کوي چې پوه شئ څه احساس لرئ. ستاسو ملګری شاید لومړنی کس وي چې ورته زنګ وهئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você processa conversando. Falar em voz alta ajuda a entender o que sente. Seu amor provavelmente é a primeira ligação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processas em conversa. Dizer em voz alta ajuda-te a perceber o que sentes. O teu par é provavelmente a primeira pessoa a quem ligas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesezi alături de alții. Când spui lucrurile cu voce tare, înțelegi ce simți. Partenerul tău e probabil primul pe care îl suni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты разбираешься через общение. Когда произносишь вслух, понимаешь, что чувствуешь. Партнёр, наверное, первый, кому ты звонишь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utekereza uganira. Kubivuga mu ijwi riranguruye bigufasha gusobanukirwa uko wiyumva. Birashoboka ko umukunzi wawe ari we uhamagara mbere."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කතා කරමින් තේරුම් ගැනීම. ශබ්ද නඟා කියද්දී ඔබට දැනෙන දේ ඔබටම තේරෙනවා. ඔබ මුලින්ම කෝල් කරන්නේ බොහෝ විට ඔබේ සහකරුට."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracovanie cez rozhovor. Keď to povieš nahlas, lepšie pochopíš, čo cítiš. Tvoja polovička je asi prvá, komu zavoláš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predelovanje v družbi. Ko stvar izrečeš na glas, bolje razumeš, kako se počutiš. Tvoj partner je verjetno prvi, ki ga pokličeš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unonzwisisa nekutaura. Kuzvitaura zvinonzwika kunokubatsira kunzwisisa manzwiro ako. Mudiwa wako angangova munhu wekutanga waunofonera."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad arrimaha ku dhuuxdaa wada hadal. Inaad cod ku sheegto ayaa kaa caawisa inaad fahanto sida aad dareemayso. Malaha lammaanahaaga ayaad ugu horrayn wacdaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përpunim përmes bisedës. Kur e thua me zë, kupton më mirë si ndihesh. Partneri yt ndoshta është i pari që telefonon."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ствари обрађујеш с другима. Кад нешто изговориш наглас, лакше разумеш шта осећаш. Твоја половина је вероватно прва коју зовеш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngolah ku cara ngobrol. Nyarioskeun sacara lisan ngabantosan anjeun ngartos naon anu karaos. Pasangan anjeun meureun jalma kahiji anu ditelepon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bearbetar socialt. Att säga det högt hjälper dig förstå vad du känner. Din partner är nog den första du ringer."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuchakata pamoja na wengine. Kulisema kwa sauti hukusaidia kuelewa unavyohisi. Huenda mwenzi wako ndiye mtu wa kwanza unayemgeukia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பேசித் தெளிபவர். சத்தமாகச் சொல்லும்போதுதான் உங்கள் உணர்வு உங்களுக்கே புரிகிறது. நீங்கள் முதலில் அழைப்பது உங்கள் துணையாகத்தான் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మాట్లాడుతూనే అర్థం చేసుకుంటారు. పైకి చెబితేనే మీ భావాలు మీకు అర్థమవుతాయి. మీరు మొదట కాల్ చేసేది బహుశా మీ భాగస్వామికే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳазм дар сӯҳбат. Бо овоз гуфтан ба ту кӯмак мекунад, ки ҳиссиётатро фаҳмӣ. Эҳтимол аввалин касе, ки ба ӯ занг мезанӣ, ёрат аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคิดผ่านการพูดคุย การพูดออกมาช่วยให้เข้าใจความรู้สึกตัวเอง คนรักน่าจะเป็นคนแรกที่คุณโทรหา"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዘረባ ምርዳእ። ብድምጺ ምዝራብ ዝስምዓኩም ክትርድኡ ይሕግዘኩም። ምናልባት ቀዳማይ ደዋልኩም ናብ መጻምድኹም እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gürleşip ýerbe-ýer edýärsiň. Ony sesli aýtmak duýgularyňa düşünmäge kömek edýär. Ilki jaň edýän adamyň, megerem, söýgüliňdir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşarak sindiriyorsun. Sesli söylemek ne hissettiğini anlamana yardım ediyor. İlk aradığın kişi muhtemelen partnerin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осмислення через розмову. Коли кажеш уголос, легше зрозуміти, що відчуваєш. Мабуть, половинка — перша, кому ти телефонуєш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بات کر کے سلجھانا۔ بول کر کہنے سے آپ کو اپنے احساسات سمجھ آتے ہیں۔ شاید سب سے پہلا فون آپ کے ساتھی کو ہی جاتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaplashib hazm qilish. Ovoz chiqarib aytish his-tuygʻularingizni tushunishga yordam beradi. Ehtimol, birinchi qoʻngʻirogʻingiz sherigingizga boʻladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gỡ rối qua trò chuyện. Nói thành lời giúp bạn hiểu mình đang cảm thấy gì. Người ấy chắc là người đầu tiên bạn tìm đến."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uqwalasela ngokuthetha nabanye. Ukuyithetha ngokuvakalayo kukunceda uqonde indlela oziva ngayo. Iqabane lakho mhlawumbi lelokuqala olifowunelayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń lóye nǹkan nípa sísọ̀rọ̀. Sísọ ọ́ jáde ń ràn yín lọ́wọ́ láti mọ bí ọkàn yín ṣe rí. Ó ṣeé ṣe kí olólùfẹ́ yín jẹ́ ẹni àkọ́kọ́ tí ẹ ó pè."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過交流來消化。把話說出口，能幫你理解自己的感受。你的另一半大概是你第一個找的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "社交型消化。把话说出来能帮你看清自己的感受。另一半大概是你第一个想找的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你靠聊天來消化。說出口能幫你理解自己的感受。另一半大概是你第一個想找的人。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucubungula ngokuxoxa. Ukukusho ngokuzwakalayo kukusiza uqonde ukuthi uzizwa kanjani. Umlingani wakho kungenzeka ungumuntu wokuqala omshayelayo."
          }
        }
      }
    },
