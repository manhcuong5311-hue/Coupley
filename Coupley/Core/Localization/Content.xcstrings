    "Closeness in all its forms. When physical and emotional connection is missing, everything else feels hollow." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرب بكل أشكاله. حين يغيب التواصل الجسدي والعاطفي، يبدو كل شيء آخر فارغًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blízkost ve všech podobách. Když chybí fyzické a citové spojení, všechno ostatní působí prázdně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhed i alle dens former. Når den fysiske og følelsesmæssige forbindelse mangler, føles alt andet hult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nähe in all ihren Formen. Wenn die körperliche und emotionale Verbindung fehlt, fühlt sich alles andere leer an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγγύτητα σε όλες τις μορφές της. Όταν λείπει η σωματική και η συναισθηματική σύνδεση, όλα τα άλλα μοιάζουν κούφια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cercanía en todas sus formas. Cuando falta la conexión física y emocional, todo lo demás se siente vacío."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läheisyys kaikissa muodoissaan. Kun fyysinen ja tunnetason yhteys puuttuu, kaikki muu tuntuu ontolta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagiging malapit sa lahat ng anyo. Kapag nawawala ang pisikal at emotional na koneksyon, parang hungkag ang lahat ng iba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proximité sous toutes ses formes. Quand le lien physique et émotionnel manque, tout le reste sonne creux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרבה על כל צורותיה. כשחסר חיבור פיזי ורגשי, כל השאר מרגיש ריק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर रूप में नज़दीकी। जब शारीरिक और भावनात्मक जुड़ाव न हो, तो बाक़ी सब खोखला लगता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közelség minden formája. Ha hiányzik a testi és lelki kapcsolódás, minden más üresnek tűnik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan dalam segala bentuknya. Saat kedekatan fisik dan emosional hilang, semuanya terasa hampa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vicinanza in tutte le sue forme. Quando manca il legame fisico ed emotivo, tutto il resto sembra vuoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆる形の近さ。体と心のつながりが欠けると、ほかのすべてが空っぽに感じてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 형태의 가까움이에요. 몸과 마음의 연결이 없으면 다른 모든 게 공허하게 느껴져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan dalam semua bentuknya. Bila hubungan fizikal dan emosi tiada, semua yang lain terasa kosong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhet i alle former. Når den fysiske og følelsesmessige kontakten mangler, føles alt annet tomt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabijheid in al haar vormen. Als fysieke en emotionele verbinding ontbreekt, voelt al het andere leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliskość we wszystkich formach. Gdy brakuje więzi fizycznej i emocjonalnej, wszystko inne wydaje się puste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proximidade em todas as formas. Quando falta conexão física e emocional, todo o resto parece vazio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apropiere sub toate formele. Când lipsește conexiunea fizică și emoțională, totul pare gol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близость во всех её формах. Когда нет физической и эмоциональной связи, всё остальное кажется пустым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Närhet i alla former. När den fysiska och känslomässiga kontakten saknas känns allt annat ihåligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความใกล้ชิดในทุกรูปแบบ เมื่อขาดความเชื่อมโยงทั้งกายและใจ ทุกอย่างก็รู้สึกว่างเปล่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her biçimiyle yakınlık. Fiziksel ve duygusal bağ eksik olduğunda geri kalan her şey boş gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близькість у всіх формах. Коли бракує фізичного й емоційного зв’язку, усе інше здається порожнім."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự gần gũi ở mọi dạng. Khi thiếu kết nối thể xác và cảm xúc, mọi thứ khác đều trở nên trống rỗng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各种形式的亲近。一旦缺少身体和情感的联结，其他一切都显得空洞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各種形式的親近。少了身體和情感的連結，其他一切都會變得空洞。"
          }
        }
      }
    },
    "Closeness isn't just physical — it's created in different ways for different people." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرب ليس جسديًا فقط، بل يتشكّل بطرق مختلفة لدى كل شخص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blízkost není jen fyzická – každý ji prožívá jinak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhed er ikke kun fysisk – den skabes på forskellige måder for forskellige mennesker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nähe ist nicht nur körperlich – sie entsteht bei allen auf ganz eigene Weise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγύτητα δεν είναι μόνο σωματική — ο καθένας τη νιώθει με διαφορετικό τρόπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cercanía no es solo física: cada persona la construye a su manera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läheisyys ei ole vain fyysistä – se syntyy eri ihmisille eri tavoin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi lang pisikal ang pagiging malapit — iba-iba ang paraan ng pagbuo nito para sa bawat tao."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proximité n'est pas que physique : elle naît de façons différentes selon les personnes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרבה היא לא רק פיזית — כל אחד יוצר אותה בדרך אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नज़दीकी सिर्फ़ शारीरिक नहीं होती — अलग-अलग लोगों के लिए यह अलग-अलग तरह से बनती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közelség nem csak testi – mindenkinél másképp születik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan bukan cuma soal fisik — setiap orang merasakannya dengan cara berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vicinanza non è solo fisica — ognuno la crea a modo suo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近さは体の距離だけではありません。人によって、近さの生まれ方はさまざまです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까움은 몸으로만 느끼는 게 아니에요. 사람마다 다른 방식으로 만들어져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keakraban bukan sekadar fizikal — ia terbina dengan cara yang berbeza bagi setiap orang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhet er ikke bare fysisk – den skapes på ulike måter for ulike mennesker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabijheid is niet alleen fysiek – voor iedereen ontstaat die op een andere manier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliskość to nie tylko fizyczność – każdy tworzy ją na swój sposób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proximidade não é só física — ela nasce de jeitos diferentes para cada pessoa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apropierea nu e doar fizică — fiecare om o simte în alt fel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близость — это не только про тело. Каждый чувствует её по-своему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Närhet är inte bara fysisk – den skapas på olika sätt för olika människor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความใกล้ชิดไม่ได้มีแค่ทางกาย แต่ละคนสร้างมันขึ้นมาในแบบที่ต่างกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınlık sadece fiziksel değil; farklı insanlar için farklı şekillerde oluşur."
