        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මේක ඔබ යළි ශක්තිය ගන්න හැටියට, අනිත් අය එක්ක ගැවසෙන හැටියට, සබඳතාවක ඔබට ඕනේ ඉඩට බලපානවා."
