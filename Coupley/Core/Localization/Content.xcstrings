        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅኑዕ። መብዛሕትኦም ሰባት ከምኡ እዮም። ንምምርማሩ ፍቓደኛ ምዃን እቲ ዝበለጸ ኣገዳሲ ክፋል እዩ።"
