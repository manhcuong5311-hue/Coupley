          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৰু সৰু ব্যক্তিগত যত্নই আপোনাৰ প্ৰেমৰ ভাষাৰ বাস্তৱ ৰূপ। আপোনাৰ প্ৰিয় বস্তুবোৰ জনাৰ সৰু কথাটোৱেই গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiçik, şəxsi qayğı jestləri sevgi dilinin canlı ifadəsidir. Sevdiklərini bilmək kimi xırdalıqlar önəmlidir."
