            "value" : "Otázky do budúcnosti prehlbujú blízkosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vprašanja o prihodnosti poglabljajo povezanost."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mibvunzo inotarisa mberi inodzamisa hukama."
