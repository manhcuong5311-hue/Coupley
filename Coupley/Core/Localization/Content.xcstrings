        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macera ve yeniden başlamak. Bu hayatında büyük bir adım; partnerinin de bu açıklığı paylaşıp paylaşmadığını bilmeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригоди й нове життя. Це великий крок — варто знати, чи поділяє половинка таку відкритість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiêu lưu và làm mới bản thân. Đây là bước ngoặt lớn — nên biết liệu người ấy có cùng sự cởi mở đó không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒险与重塑自我。这是人生中的大变动，值得了解另一半是否也有这份开放的心态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
