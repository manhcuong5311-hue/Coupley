        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এভাবেই তুমি সবচেয়ে ভালোভাবে ভালোবাসা অনুভব করো — তোমার পার্টনারের এটা জানা দরকার।"
