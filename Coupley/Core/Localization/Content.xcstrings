    "A gentle ping beats a long silence when you're not sure." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين لا تكونون متأكدين، نبضة لطيفة أفضل من صمت طويل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když nevíš, jak na tom je, jemné ťuknutí je lepší než dlouhé ticho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er i tvivl, er et blidt ping bedre end lang tavshed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du unsicher bist, ist ein sanfter Ping besser als langes Schweigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν έχεις αμφιβολίες, ένα απαλό σινιάλο είναι καλύτερο από μια μεγάλη σιωπή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando no sabes qué hacer, un toque suave es mejor que un largo silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun et ole varma, lempeä ping on parempi kuin pitkä hiljaisuus."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag hindi ka sigurado, mas mabuti ang banayad na kalabit kaysa sa mahabang katahimikan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le doute, un petit signe vaut mieux qu'un long silence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשלא בטוחים, פינג עדין עדיף על שתיקה ארוכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब समझ न आए, तो लंबी ख़ामोशी से हल्का-सा पिंग बेहतर है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bizonytalan vagy, egy szelíd ping jobb, mint a hosszú csend."
          }
        },
        "id" : {
