        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અનુભવો માટે ઉદાર — પૈસા જીવવા માટે છે"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai kashewa kan abubuwan more rayuwa — kuɗi don rayuwa ne"
