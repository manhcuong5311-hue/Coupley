          "stringUnit" : {
            "state" : "translated",
            "value" : "ළඟින් වාඩි වෙන්න. අඩුවෙන් කතා කරන්න. ඕනේ නම් ඔවුන්ට ඔබට හේත්තු වෙන්න ඉඩ දෙන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadni si blízko. Hovor menej. Nech sa môže oprieť, ak chce."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedi blizu. Govori manj. Naj se partner nasloni nate, če želi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gara pedyo. Taura zvishoma. Rega akuzendamire kana achida."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U dhow fadhiiso. Wax yar dheh. Haddii lagu tiirsado, garab u noqo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulu afër. Fol më pak. Lëre të mbështetet te ti nëse do."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Седни близу. Говори мање. Пусти да се твоја половина наслони ако жели."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calik caket. Saeutik nyarios. Antepkeun anjeunna nyarandé upami hoyong."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitt nära. Säg mindre. Låt din partner luta sig mot dig om det känns rätt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keti karibu. Ongea kidogo. Mwache akuegemee akitaka."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அருகில் உட்காருங்கள். குறைவாகப் பேசுங்கள். விரும்பினால் அவர் உங்கள் மேல் சாயட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దగ్గరగా కూర్చోండి. తక్కువ మాట్లాడండి. కావాలంటే వారిని మీ మీద ఆనుకోనివ్వండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наздик нишин. Камтар гап зан. Агар хоҳад, бигзор ба ту такя кунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นั่งใกล้ๆ พูดให้น้อย ปล่อยให้คนรักพิงถ้าอยากพิง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀረባ ኮፍ በሉ። ውሑድ ተዛረቡ። እንተደልዮም ክጽግዑ ግደፍዎም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýakyn otur. Az gürle. Islese, saňa söýensin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınına otur. Az konuş. İsterse sana yaslansın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь ближче. Говори менше. Дай прихилитися, якщо захочеться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قریب بیٹھیں۔ کم بولیں۔ اگر وہ چاہیں تو انہیں ٹیک لگانے دیں۔"
