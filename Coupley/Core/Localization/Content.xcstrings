          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাঙৰ কথাবোৰত মিল — কেনেকৈ জীয়াই থাকিব বিচাৰে, কি গঢ়ি তুলিছে। সপোনৰ মিল গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyük məsələlərdə həmfikirlik — necə yaşamaq istədiyiniz, nə qurduğunuz. Baxışların uyğunluğu önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згода ў галоўным — як вы хочаце жыць, што будуеце. Важна, каб бачанне супадала."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съгласие за големите неща – как искате да живеете, какво градите. Съвпадението във визията е важно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বড় বিষয়গুলোতে মিল — কীভাবে বাঁচতে চাও, কী গড়ছ। ভাবনার মিল জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaganje oko velikih stvari – kako želite živjeti, šta gradite. Važno je da imate istu viziju."
