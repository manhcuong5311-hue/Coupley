        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver avslut genom ord. Bråket är inte över förrän båda sidor har blivit bekräftade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องการปิดเรื่องด้วยคำพูด การทะเลาะจะยังไม่จบจนกว่าความรู้สึกของทั้งสองฝ่ายจะได้รับการรับฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meseleyi kapatmak için konuşmaya ihtiyacın var. İki tarafın da duyulduğunu hissetmeden kavga bitmiş sayılmaz."
