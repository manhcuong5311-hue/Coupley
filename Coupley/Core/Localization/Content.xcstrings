        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlam önemli. Hafta sonu şehir kaçamağı ile balayı farklı bütçeleri hak eder. Pratik bir yaklaşım."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст важливий. Міський вікенд і медовий місяць заслуговують на різний бюджет. Прагматично."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالات اہم ہیں۔ ویک اینڈ کی شہری سیر اور ہنی مون کا بجٹ الگ ہونا چاہیے۔ عملی سوچ۔"
