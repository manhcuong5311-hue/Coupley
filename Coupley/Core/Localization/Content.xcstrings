        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଲମ୍ବା ଖେଳ ଖେଳୁଛନ୍ତି। ଭବିଷ୍ୟତର ଆପଣ ଦୁହେଁ ଏଥିପାଇଁ ଧନ୍ୟବାଦ ଦେବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਲੰਮੀ ਖੇਡ ਖੇਡ ਰਹੇ ਹੋ। ਆਉਣ ਵਾਲੇ ਸਮੇਂ ਵਿੱਚ ਤੁਸੀਂ ਦੋਵੇਂ ਆਪਣੇ ਆਪ ਦਾ ਧੰਨਵਾਦ ਕਰੋਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grasz na dłuższą metę. Wasze przyszłe ja będą wam wdzięczne."
