        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹھوس سہارا۔ جب کوئی مشکل میں ہو تو آپ کی محبت صرف لفظوں سے نہیں، عمل سے ظاہر ہوتی ہے۔"
