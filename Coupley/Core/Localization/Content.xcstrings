        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reális. Más család más hozzáállást kíván. Az a lényeg, hogy mindketten egy oldalon álljatok."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Իրատեսական։ Տարբեր ընտանիքներ տարբեր մոտեցում են պահանջում։ Կարևորն այն է, որ երկուսդ էլ նույն կարծիքին լինեք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realistis. Tiap keluarga butuh pendekatan berbeda. Yang penting, kalian berdua sepaham."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eziokwu. Ezinụlọ dị iche iche chọrọ ụzọ dị iche iche. Ihe dị mkpa bụ na unu abụọ kwekọrọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raunsætt. Ólíkar fjölskyldur kalla á ólíkar nálganir. Það sem skiptir máli er að þið séuð samstíga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realismo. Famiglie diverse richiedono approcci diversi. Quello che conta è che siate sulla stessa lunghezza d’onda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現実的です。家族が違えば、向き合い方も違って当然。大切なのはふたりの考えがそろっていることです。"
