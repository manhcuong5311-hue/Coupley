    "Lucky and grateful. You carry patterns worth repeating into your own relationships." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظ وامتنان. تحملون إلى علاقاتكم أنماطًا تستحق التكرار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štěstí a vděčnost. Do svých vztahů si neseš vzorce, které stojí za to opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heldig og taknemmelig. Du tager mønstre med ind i dine egne forhold, som er værd at gentage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hattest Glück und bist dankbar dafür. Du nimmst Muster in deine Beziehungen mit, die es wert sind, weitergegeben zu werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τύχη και ευγνωμοσύνη. Μεταφέρεις στις δικές σου σχέσεις μοτίβα που αξίζει να επαναληφθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suerte y gratitud. Llevas a tus relaciones patrones que vale la pena repetir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onnekas ja kiitollinen. Viet omiin suhteisiisi malleja, jotka kannattaa toistaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suwerte at nagpapasalamat. Dala mo sa sarili mong mga relasyon ang mga nakagawiang sulit ulitin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la chance et de la gratitude. Tu emportes dans tes relations des modèles qui valent la peine d'être reproduits."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מזל והכרת תודה. יש לך דפוסים ששווה להעביר הלאה, אל הקשרים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ुशक़िस्मत और शुक्रगुज़ार। आपके पास ऐसी आदतें हैं जिन्हें अपने रिश्तों में दोहराना अच्छा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerencsés és hálás vagy. Továbbadásra érdemes mintákat viszel a saját kapcsolataidba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beruntung dan bersyukur. Kamu membawa pola yang layak diulang ke dalam hubunganmu sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortuna e gratitudine. Porti nelle tue relazioni modelli che vale la pena ripetere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恵まれていて、そのことに感謝している人。受け継ぎたい良いものを、自分の関係にも持ち込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운이 좋았고 감사한 마음이에요. 내 관계에서도 이어 갈 만한 좋은 모습을 품고 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertuah dan bersyukur. Anda membawa corak yang wajar diulang ke dalam hubungan anda sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heldig og takknemlig. Du tar med deg gode mønstre inn i dine egne forhold – mønstre det er verdt å gjenta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geluk gehad en bent dankbaar. Je neemt patronen mee die het herhalen waard zijn in je eigen relaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczęście i wdzięczność. Wnosisz do swoich związków wzorce warte powtarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorte e gratidão. Você leva para as suas relações padrões que valem a pena repetir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noroc și recunoștință. Duci mai departe în relațiile tale tipare care merită repetate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повезло, и ты это ценишь. Ты переносишь в свои отношения то, что стоит повторять."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyckligt lottad och tacksam. Du bär med dig mönster som är värda att upprepa i dina egna relationer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โชคดีและรู้สึกขอบคุณ คุณพกแบบอย่างที่ควรสานต่อไปสู่ความสัมพันธ์ของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şanslı ve minnettar. Kendi ilişkilerine tekrarlanmaya değer kalıplar taşıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі пощастило, і ти це цінуєш. Ти переносиш у свої стосунки моделі, які варто повторювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May mắn và biết ơn. Bạn mang theo những điều đáng lặp lại vào các mối quan hệ của chính mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多是正面的，底子打得好"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幸運又感恩。你把值得延續的模式，帶進了自己的關係裡。"
          }
        }
      }
    },
    "Make tea or food they love. Leave it within reach." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حضّروا شايًا أو طعامًا يحبه شريكك، وضعوه في متناول يده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvař čaj nebo jídlo, které miluje. Nech ho na dosah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav te eller mad, din partner elsker, og stil det inden for rækkevidde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen Tee oder ein Lieblingsessen. Stell es in Reichweite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε στο ταίρι σου ένα τσάι ή ένα φαγητό που λατρεύει. Άφησέ το κοντά του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárale un té o algo de comer que le encante. Déjalo a su alcance."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee teetä tai ruokaa, josta hän pitää. Jätä se ulottuville."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipagtimpla siya ng tsaa o ipagluto ng paborito niya. Ilapit sa kanya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
