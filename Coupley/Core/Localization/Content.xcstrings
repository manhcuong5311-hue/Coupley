    "Shared purpose builds closeness. Cooking, building, creating — doing something that matters to you both." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدف المشترك يبني القرب. الطبخ أو البناء أو الإبداع، أي فعل شيء يهمكما معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Společný cíl sbližuje. Vařit, stavět, tvořit – dělat něco, na čem vám oběma záleží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et fælles formål skaber nærhed. At lave mad, bygge, skabe – noget, der betyder noget for jer begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gemeinsamer Sinn schafft Nähe. Kochen, bauen, gestalten – etwas tun, das euch beiden wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κοινός σκοπός φέρνει εγγύτητα. Μαγείρεμα, φτιάξιμο, δημιουργία — κάτι που μετράει και για τους δυο σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un propósito compartido crea cercanía. Cocinar, construir, crear: hacer algo que les importe a los dos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteinen tarkoitus rakentaa läheisyyttä. Kokkaaminen, rakentaminen, luominen – jotain, millä on merkitystä teille molemmille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinalalapit kayo ng iisang layunin. Pagluluto, pagbubuo, paglikha — paggawa ng bagay na mahalaga sa inyong dalawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un but commun rapproche. Cuisiner, construire, créer : faire quelque chose qui compte pour vous deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מטרה משותפת בונה קרבה. לבשל, לבנות, ליצור — לעשות משהו ששניכם רואים בו ערך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा मक़सद से नज़दीकी बनती है। खाना बनाना, कुछ बनाना, कुछ रचना — ऐसा कुछ करना जो आप दोनों के लिए मायने रखे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közös cél közelséget teremt. Főzni, építeni, alkotni – valami olyat csinálni, ami mindkettőtöknek számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuan bersama membangun kedekatan. Memasak, membangun, berkarya — melakukan sesuatu yang penting bagi kalian berdua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno scopo comune crea vicinanza. Cucinare, costruire, creare — fare qualcosa che conta per voi due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ目的が近さを育てるタイプです。料理、ものづくり、創作など、ふたりにとって大切なことを一緒にするのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 목적이 가까움을 만들어요. 요리하고, 만들고, 창작하며 두 사람 모두에게 의미 있는 일을 함께하는 것."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuan bersama membina keakraban. Memasak, membina, mencipta — melakukan sesuatu yang penting bagi anda berdua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et felles mål skaper nærhet. Lage mat, bygge, skape – gjøre noe som betyr noe for dere begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gedeeld doel brengt je dichter bij elkaar. Koken, bouwen, maken – iets doen wat jullie allebei belangrijk vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólny cel buduje bliskość. Gotowanie, budowanie, tworzenie – robienie razem czegoś, co ma dla was znaczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um propósito em comum aproxima. Cozinhar, construir, criar — fazer algo que importa para os dois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un scop comun creează apropiere. Să gătiți, să construiți, să creați — să faceți ceva important pentru amândoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общая цель сближает. Готовить, строить, творить — делать то, что важно вам обоим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett gemensamt syfte skapar närhet. Laga mat, bygga, skapa – göra något som betyder något för er båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายร่วมกันสร้างความใกล้ชิด ไม่ว่าจะทำอาหาร ลงมือสร้าง หรือสร้างสรรค์อะไรสักอย่าง ขอแค่ได้ทำสิ่งที่สำคัญกับคุณทั้งสอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak bir amaç yakınlık kurar. Yemek yapmak, bir şey inşa etmek, üretmek; ikiniz için de önemli olan bir şey yapmak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільна мета зближує. Готувати, будувати, творити — робити щось важливе для вас обох."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục đích chung xây nên sự gần gũi. Nấu ăn, xây dựng, sáng tạo — cùng làm điều quan trọng với cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的目标让人亲近。做饭、动手做东西、一起创作——做一件对你们俩都重要的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的目標讓人更親近。一起煮飯、動手做、創作，做一件對你們兩人都重要的事。"
          }
        }
      }
    },
