        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun ngajaga pasangan tetep aya dina kahirupan sapopoé. Kabiasaan sareng hal-hal anu ngingetkeun téh bermakna pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du håller din partner nära i vardagen. Gemensamma ritualer och associationer betyder mycket för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unamweka karibu katika maisha yako ya kila siku. Mazoea na vitu mnavyovihusisha pamoja vina maana kwako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் அன்றாட வாழ்க்கையில் அவரை எப்போதும் உடன் வைத்திருக்கிறீர்கள். பகிர்ந்த பழக்கங்களும் நினைவூட்டும் தொடர்புகளும் உங்களுக்கு அர்த்தமுள்ளவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ రోజువారీ జీవితంలో వారిని దగ్గరగా ఉంచుకుంటారు. కలిసి పంచుకునే అలవాట్లు, గుర్తులు మీకు ఎంతో విలువైనవి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ёратро дар зиндагии ҳаррӯзаат ҳозир нигоҳ медорӣ. Анъанаҳо ва пайвандҳои муштарак барои ту пурмаъноянд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณทำให้คนรักอยู่ในชีวิตประจำวันของคุณเสมอ กิจวัตรและสิ่งที่เชื่อมโยงถึงกันมีความหมายกับคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ዕለታዊ ህይወትኩም ህልዋት ትገብርዎም። ናይ ሓባር ልምድታትን መዘኻኸርታትን ንዓኹም ትርጉም ኣለዎም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen ony gündelik durmuşyňda ýanyňda saklaýarsyň. Umumy däpler we ýatladýan zatlar seniň üçin möhüm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partnerini gündelik hayatında hep yanında tutuyorsun. Ortak ritüeller ve çağrışımlar senin için anlamlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти тримаєш половинку поруч у своїх буднях. Спільні ритуали й асоціації багато для тебе означають."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی روزمرہ زندگی میں ان کی موجودگی رہتی ہے۔ مشترکہ معمول اور ان سے جڑی چیزیں آپ کے لیے بہت معنی رکھتی ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz sherigingizni kundalik hayotingizda doim yoningizda his qilasiz. Umumiy odatlar va bogʻliq xotiralar siz uchun qadrli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn giữ người ấy hiện diện trong từng ngày thường. Những thói quen chung và điều gợi nhớ đều rất ý nghĩa với bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugcina iqabane lakho likhona kubomi bakho bemihla ngemihla. Amasiko nezinto enizabelana ngazo zinentsingiselo kuwe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń jẹ́ kí olólùfẹ́ yín wà nínú ayé yín ojoojúmọ́. Àwọn àṣà àti nǹkan tí ẹ jọ ní ní ìtumọ̀ fún yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你讓對方留在你的日常生活裡。兩人共有的小習慣和聯想，對你很有意義。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会让另一半一直融在你的日常里。共同的小习惯和联想，对你很有意义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你讓對方存在於日常生活裡。兩人共有的小習慣和連結，對你很有意義。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgcina ekhona empilweni yakho yansuku zonke. Imikhuba nezinto enabelana ngazo zinomqondo kuwe."
          }
        }
      }
    },
    "You know the solution but you don't do it. An earlier-to-bed partner might actually help — or drive you crazy." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy ken die oplossing, maar jy doen dit nie. ’n Maat wat vroeg gaan slaap, kan dalk help – of jou mal maak."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መፍትሄውን ያውቃሉ፣ ግን አያደርጉትም። ቀደም ብለው የሚተኙ አጋር በእርግጥ ሊረዱዎት ይችላሉ — ወይም ሊያበሳጩዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحل معروف لديك لكنه لا يُطبَّق. شريك ينام مبكرًا قد يساعدك فعلًا، أو قد يثير جنونك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমাধান আপুনি জানে, কিন্তু কৰি নুঠে। সোনকালে শুই পৰা সংগী এজনে হয়তো সহায় কৰিব — নহ'লে আপোনাক বলীয়া কৰি তুলিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həll yolunu bilirsən, amma etmirsən. Tez yatan partnyor bəlkə kömək edər — ya da səni dəli edər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты ведаеш рашэнне, але не карыстаешся ім. Палавінка-«жаваранак» можа дапамагчы — або давесці да шаленства."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаеш решението, но не го прилагаш. Половинка, която си ляга по-рано, може и да помогне – или да те подлуди."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমাধান জানো, কিন্তু করো না। তাড়াতাড়ি ঘুমাতে যাওয়া পার্টনার হয়তো সত্যিই সাহায্য করবে — নয়তো তোমাকে পাগল করে দেবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaš rješenje, ali ga ne primjenjuješ. Voljena osoba koja ranije liježe mogla bi zaista pomoći – ili te izluditi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saps la solució, però no l'apliques. Una parella que se'n vagi a dormir abans potser t'ajudaria — o et faria perdre el cap."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řešení znáš, jen ho nedodržuješ. Protějšek, který chodí spát dřív, ti možná pomůže – nebo tě dožene k šílenství."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n gwybod yr ateb ond ddim yn ei wneud. Gallai partner sy'n mynd i'r gwely'n gynnar helpu — neu dy yrru'n wallgof."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kender løsningen, men gør det ikke. En partner, der går tidligt i seng, kan faktisk hjælpe – eller drive dig til vanvid."
