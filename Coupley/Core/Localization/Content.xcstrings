        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est honnête, et c'est le cas de la plupart des gens. Le plus important, c'est d'accepter de s'y pencher."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ionraic. Tá formhór na ndaoine amhlaidh. Is í an toil é a scrúdú an chuid is tábhachtaí."
