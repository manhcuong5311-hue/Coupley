            "value" : "Rủ người ấy làm gì đó ngẫu hứng tối nay — lái xe dạo, đi bộ, đi mua món tráng miệng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提议今晚来点说走就走的：兜风、散步、去买份甜点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提議今晚來點臨時起意的：兜風、散步、去買甜點。"
          }
        }
      }
    },
    "Suggest trying something small and new together this week." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
