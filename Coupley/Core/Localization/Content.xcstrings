        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրիր այն ամենը, ինչ հոգեհարազատ է — ընդհանուր փլեյլիստները զույգին միավորող թերագնահատված բան են։"
