        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো বিচাৰ নাই — এই বিষয়ত আপুনি ক'ত আছে তাৰ প্ৰভাৱ আপোনাৰ শক্তি, মন আৰু সময়সূচীত পৰে।"
