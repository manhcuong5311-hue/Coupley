        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ jókòó nítòsí. Ẹ dín ọ̀rọ̀ kù. Ẹ jẹ́ kí ó gbára lé yín tí ó bá fẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靠近一點坐，少說一點。對方想靠過來就讓對方靠。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
