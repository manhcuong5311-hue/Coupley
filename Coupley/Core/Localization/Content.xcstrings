        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su'aalaha mustaqbalka eegaa waxay qoto dheereeyaan xiriirka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyetjet për të ardhmen e thellojnë lidhjen."
