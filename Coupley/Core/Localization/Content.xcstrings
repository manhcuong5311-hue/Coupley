        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure nortasuna zure inguruan. Biltegi egokitua, itsasontzia, sare elektrikotik kanpoko txabola: espazioak zutaz zerbait esatea nahi duzu."
