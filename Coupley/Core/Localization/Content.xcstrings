        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vắng nhau mới thấy trân trọng. Bạn cần khoảng cách để nhớ người ấy — và nỗi nhớ đó giữ mọi thứ luôn tươi mới."
          }
