    "Handle dinner or a chore they'd usually do. No announcement." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تولّوا العشاء أو مهمة يقوم بها شريكك عادةً، دون إعلان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postarej se o večeři nebo práci, kterou má obvykle na starosti. Bez ohlašování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag aftensmaden eller en opgave, din partner plejer at klare. Uden at gøre et nummer ud af det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimm das Abendessen oder eine Aufgabe, die sonst dein Schatz erledigt. Ohne Ankündigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανέλαβε το βραδινό ή μια δουλειά που συνήθως κάνει το ταίρι σου. Χωρίς ανακοινώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encárgate de la cena o de una tarea que normalmente hace tu pareja. Sin anunciarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoida illallinen tai kotityö, jonka hän yleensä tekee. Ilman ilmoitusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikaw na ang bahala sa hapunan o sa gawaing karaniwang siya ang gumagawa. Walang anunsyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occupe-toi du dîner ou d'une tâche dont l'autre s'occupe d'habitude. Sans l'annoncer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקחת על עצמך את ארוחת הערב או מטלה שבדרך כלל הצד השני עושה. בלי הכרזות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिनर या कोई ऐसा काम संभाल लें जो आमतौर पर उनके ज़िम्मे होता है। बिना बताए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intézd el a vacsorát vagy egy házimunkát, amit általában ő csinál. Bejelentés nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urus makan malam atau tugas rumah yang biasa dia kerjakan. Tanpa pengumuman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occupati tu della cena o di una faccenda che di solito fa il tuo partner. Senza annunciarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもパートナーがしている夕食作りや家事を、何も言わずに引き受けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인이 평소 하던 저녁 준비나 집안일을 생색내지 말고 해 두세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruskan makan malam atau kerja rumah yang biasanya dia buat. Tanpa perlu umumkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta middagen eller en oppgave partneren din pleier å gjøre. Uten å si fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regel het eten of een klusje dat je partner meestal doet. Zonder het aan te kondigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajmij się kolacją albo obowiązkiem, który zwykle robi druga połówka. Bez ogłaszania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assuma o jantar ou uma tarefa que seu amor costuma fazer. Sem anunciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupă-te de cină sau de o treabă pe care o face de obicei partenerul tău. Fără anunțuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьми на себя ужин или дело, которым обычно занимается партнёр. Без объявлений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa middagen eller en syssla din partner brukar göra. Utan att säga något."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดการมื้อเย็นหรืองานบ้านที่ปกติคนรักทำ โดยไม่ต้องประกาศ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam yemeğini ya da genelde onun yaptığı bir işi üstlen. Duyurmadan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Візьми на себе вечерю чи справу, яку зазвичай робить половинка. Без оголошень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo bữa tối hoặc một việc nhà người ấy hay làm. Không cần thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把另一半平时负责的晚饭或家务做了，不用声张。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包辦晚餐，或做一件對方平常負責的家事，不必說出來。"
          }
        }
      }
    },
