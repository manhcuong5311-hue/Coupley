        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשומת לב היא שפת האהבה שלך. ההוכחה שהקשבת היא הפרטים הקטנים שזכרת ועשית איתם משהו — ויש בזה עוצמה שקטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान देना आपकी प्रेम की भाषा है। छोटी-छोटी बातों पर अमल करके आप साबित करते हैं कि आप सुन रहे थे — यह चुपचाप बहुत असर करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažljivost je tvoj jezik ljubavi. Dokazuješ da slušaš tako što pamtiš sitnice i djeluješ – to ima tihu snagu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atansyon se langaj lanmou ou. Ou pwouve ou t ap koute lè ou aji sou ti detay yo — sa gen yon fòs dous."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A figyelmesség a szeretetnyelved. Az apró részletekre reagálva bizonyítod, hogy odafigyeltél – ez csendes, de nagy erő."
