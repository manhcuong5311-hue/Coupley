        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dėmesingumas – tavo meilės kalba. Kad klausaisi, įrodai veiksmais pagal smulkias detales – tai tyliai, bet galingai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vērība ir tava mīlestības valoda. Tu pierādi, ka tiešām klausies, rīkojoties pēc sīkām detaļām, – tas ir klusi spēcīgi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fitandremana no fitenin'ny fitiavanao. Manaporofo ianao fa nihaino tamin'ny fihetsika amin'ny antsipiriany kely — mangina nefa mahery izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te aro nui tō reo aroha. Ka whakaatu koe i whakarongo koe mā te mahi i ngā mea iti — he kaha puku tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимателноста е твојот јазик на љубовта. Докажуваш дека слушаш така што делуваш според ситните детали — тоа е тивко моќно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ശ്രദ്ധയാണ് നിങ്ങളുടെ സ്നേഹഭാഷ. ചെറിയ കാര്യങ്ങൾ ഓർത്തുവെച്ച് പ്രവർത്തിച്ചാണ് നിങ്ങൾ കേട്ടിരുന്നുവെന്ന് തെളിയിക്കുന്നത് — നിശ്ശബ്ദമെങ്കിലും ശക്തമാണത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анхаарал бол чиний хайрын хэл. Жижиг нарийн зүйлсийг хэрэгжүүлж, сонсож байснаа батлах — энэ чимээгүй ч хүчтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष देणे ही तुमची प्रेमाची भाषा. छोट्या तपशिलांवर कृती करून तुम्ही ऐकत होतात हे सिद्ध करता — हे शांतपणे खूप प्रभावी असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keprihatinan ialah bahasa cinta anda. Anda membuktikan anda mendengar dengan bertindak atas butiran kecil — kesannya halus tetapi mendalam."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-attenzjoni hija l-lingwa tal-imħabba tiegħek. Turi li kont qed tisma' billi taġixxi fuq dettalji żgħar — u dan għandu saħħa kwieta."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂရုတစိုက် သတိထားမှုက သင့်အချစ်ဘာသာစကားပါ။ အသေးစိတ်လေးတွေကို လုပ်ဆောင်ချက်နဲ့ ပြန်ပြခြင်းအားဖြင့် နားထောင်ခဲ့ကြောင်း သက်သေပြတယ် — တိတ်တဆိတ် အစွမ်းထက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppmerksomhet er kjærlighetsspråket ditt. Du viser at du har lyttet ved å følge opp små detaljer – det er stille, men kraftfullt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान दिनु नै तपाईंको मायाको भाषा हो। साना कुरामा काम गरेर तपाईं सुनिरहनुभएको थियो भन्ने प्रमाणित गर्नुहुन्छ — यो चुपचाप तर शक्तिशाली हुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplettendheid is jouw liefdestaal. Je laat zien dat je hebt geluisterd door iets met kleine details te doen – en dat is stilletjes krachtig."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusamala tinthu ting'onoting'ono ndi chilankhulo chanu cha chikondi. Mumatsimikizira kuti mwakhala mukumvetsera pochita zinthu zing'onozing'ono — zimenezo zili ndi mphamvu mwakachetechete."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiyyeeffannoon afaan jaalalaa keeti. Bal'inaan akka dhaggeeffatte waan xixiqqoo irratti hojjechuudhaan mirkaneessita — kun callisaan humna guddaa qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମନୋଯୋଗ ହିଁ ଆପଣଙ୍କ ପ୍ରେମର ଭାଷା। ଛୋଟ ଛୋଟ କଥା ଉପରେ କାମ କରି ଆପଣ ପ୍ରମାଣ କରନ୍ତି ଯେ ଆପଣ ଶୁଣୁଥିଲେ — ଏହା ଚୁପଚାପ୍ ଶକ୍ତିଶାଳୀ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਧਿਆਨ ਰੱਖਣਾ ਤੁਹਾਡੀ ਪਿਆਰ ਦੀ ਭਾਸ਼ਾ ਹੈ। ਛੋਟੀਆਂ-ਛੋਟੀਆਂ ਗੱਲਾਂ ਉੱਤੇ ਅਮਲ ਕਰ ਕੇ ਤੁਸੀਂ ਸਾਬਤ ਕਰਦੇ ਹੋ ਕਿ ਤੁਸੀਂ ਧਿਆਨ ਨਾਲ ਸੁਣ ਰਹੇ ਸੀ — ਇਸ ਵਿੱਚ ਚੁੱਪ-ਚਾਪ ਵੱਡੀ ਤਾਕਤ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uważność to twój język miłości. Udowadniasz, że słuchasz, reagując na drobne szczegóły – to ma cichą moc."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پاملرنه ستاسو د مینې ژبه ده. تاسو د وړو جزئیاتو پر بنسټ عمل کوئ او ثابتوئ چې غوږ مو نیولی و — دا په چوپه ډېره ځواکمنه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenção aos detalhes é sua linguagem do amor. Você prova que estava ouvindo nos pequenos gestos — e isso tem uma força silenciosa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atenção ao pormenor é a tua linguagem do amor. Provas que estiveste a ouvir ao agir sobre pequenos detalhes — é discretamente poderoso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenția la detalii e limbajul tău al iubirii. Dovedești că ai ascultat prin felul în care ții cont de micile detalii — și asta are o putere discretă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимательность — твой язык любви. Ты доказываешь, что слушаешь, через маленькие детали — и это тихо, но сильно."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwita ku tuntu duto ni ururimi rwawe rw'urukundo. Ugaragaza ko wumvaga ukurikiza utuntu duto — ibyo bifite imbaraga zicecetse."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවධානය තමයි ඔබේ ආදර භාෂාව. පුංචි විස්තර අනුව ක්‍රියා කරලා ඔබ ඇහුම්කන් දුන්නා කියලා ඔප්පු කරනවා — ඒක නිහඬවම බලවත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvojím jazykom lásky je všímavosť. Že počúvaš, dokazuješ tým, že reaguješ na drobnosti – a to má tichú silu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozornost je tvoj jezik ljubezni. Da poslušaš, dokažeš tako, da ukrepaš ob drobnih podrobnostih – to je tiho, a močno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kucherechedza ndiwo mutauro wako werudo. Unoratidza kuti wanga uchiteerera nekuita zvinhu zvidiki zvawakanzwa — izvi zvine simba chinyararire."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feejignaantu waa luqaddaada jacaylka. Waxaad caddaysaa inaad dhegaysanaysay adigoo wax ka qabanaya faahfaahinta yaryar — taasi waa awood aamusan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vëmendja ndaj detajeve është gjuha jote e dashurisë. Tregon që ke dëgjuar duke vepruar sipas detajeve të vogla – kjo ka një fuqi të qetë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пажљивост је твој језик љубави. Доказујеш да слушаш тако што делаш по малим детаљима — то је тихо моћно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatosan téh basa cinta anjeun. Anjeun ngabuktikeun yén anjeun parantos ngadangukeun ku ngalakukeun detil-detil leutik — éta kuat sanajan teu ramé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhördhet är ditt kärleksspråk. Du visar att du har lyssnat genom att agera på små detaljer – det är stillsamt kraftfullt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usikivu ndio lugha yako ya upendo. Unathibitisha kwamba umekuwa ukisikiliza kwa kutenda juu ya mambo madogo — hilo lina nguvu kimyakimya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கவனிப்பே உங்கள் அன்பு மொழி. சிறிய விவரங்களைச் செயல்படுத்துவதன் மூலம் நீங்கள் கேட்டுக்கொண்டிருந்தீர்கள் என்பதை நிரூபிக்கிறீர்கள் — அது அமைதியான, ஆனால் வலிமையான அன்பு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "శ్రద్ధగా గమనించడమే మీ ప్రేమ భాష. చిన్న వివరాలపై స్పందించడం ద్వారా మీరు వింటున్నారని నిరూపిస్తారు — అది నిశ్శబ్దంగా శక్తివంతమైనది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диққат забони муҳаббати туст. Ту бо амал кардан аз рӯи ҷузъиёти хурд исбот мекунӣ, ки гӯш карда будӣ — ин оромона пурқувват аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความช่างสังเกตคือภาษารักของคุณ คุณพิสูจน์ว่าตั้งใจฟังด้วยการลงมือทำจากรายละเอียดเล็กๆ ซึ่งทรงพลังอย่างเงียบๆ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣቓልቦ ቋንቋ ፍቕርኹም እዩ። ንኣሽቱ ዝርዝራት ብተግባር ብምውዓል ከም ዝሰማዕኩም ተረጋግጹ — እዚ ብስቕታ ሓያል እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ünsli bolmak seniň söýgi diliň. Sen kiçi jikme-jikliklere görä hereket edip, diňleýändigiňi subut edýärsiň — bu ýuwaşja, ýöne güýçli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin sevgi dilin dikkat. Küçük ayrıntılara göre davranarak dinlediğini kanıtlıyorsun; bu sessiz ama çok güçlü bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уважність — твоя мова кохання. Ти показуєш, що слухаєш, через увагу до дрібниць — і в цьому тиха сила."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجہ آپ کی محبت کی زبان ہے۔ چھوٹی تفصیلات پر عمل اس بات کا ثبوت ہے کہ بات توجہ سے سنی گئی — یہ خاموشی سے بہت اثر رکھتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eʼtiborlilik — sizning sevgi tilingiz. Mayda tafsilotlarga amal qilib, tinglaganingizni isbotlaysiz — bu jimgina, lekin kuchli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự tinh ý là ngôn ngữ tình yêu của bạn. Bạn chứng minh mình đã lắng nghe bằng cách hành động theo những chi tiết nhỏ — lặng lẽ mà mạnh mẽ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuqaphela lulwimi lwakho lothando. Ubonisa ukuba ubumamele ngokwenza okuthile ngeenkcukacha ezincinci — kunamandla athe cwaka oko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àfiyèsí ni èdè ìfẹ́ yín. Ẹ ń fi hàn pé ẹ ti ń gbọ́ nípa ṣíṣe nǹkan lórí àwọn kékeré — agbára jẹ́ẹ́jẹ́ẹ́ nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細心就是你的愛之語。你用行動回應小細節，證明你一直有在聽，這份力量很安靜，卻很強大。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细心就是你的爱的语言。你用小细节上的行动证明自己一直在听——安静却很有力量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細心就是你的愛之語。你用行動回應小細節，證明你一直有在聽，這份力量安靜卻強大。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunaka kuwulimi lwakho lothando. Ufakazela ukuthi ubulalele ngokwenza okuthile ngemininingwane emincane — lokho kunamandla buthule."
          }
        }
      }
    },
    "Audio learner and story lover. You absorb ideas while doing other things. Probably has great recommendations." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy leer deur te luister en hou van stories. Jy neem idees in terwyl jy ander dinge doen. Het waarskynlik puik aanbevelings."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በማዳመጥ የሚማሩና ታሪክ የሚወዱ። ሌላ ነገር እየሠሩ ሀሳቦችን ይቀስማሉ። ምናልባት ግሩም ጥቆማዎች አሉዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلّم بالاستماع وحب للحكايات. استيعاب للأفكار في أثناء الانشغال بأشياء أخرى، وعلى الأرجح لديك ترشيحات رائعة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুনি শিকা আৰু কাহিনী ভাল পোৱা মানুহ। আন কাম কৰি থাকোঁতেই আপুনি ধাৰণাবোৰ আহৰণ কৰে। হয়তো আপোনাৰ ওচৰত বহুত ভাল পৰামৰ্শ আছে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinləyərək öyrənən, hekayə sevən birisən. Başqa işlər görərkən ideyaları mənimsəyirsən. Yəqin ki, əla tövsiyələrin var."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты ўспрымаеш на слых і любіш гісторыі. Ідэі засвойваюцца ў цябе паміж іншымі справамі. Напэўна, у цябе выдатныя рэкамендацыі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учиш чрез слушане и обичаш историите. Попиваш идеи, докато правиш друго. Сигурно имаш страхотни препоръки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুনে শেখো, গল্প ভালোবাসো। অন্য কাজ করতে করতে নতুন ভাবনা নিয়ে নাও। সম্ভবত তোমার কাছে দারুণ সব সাজেশন আছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učiš slušanjem i voliš priče. Upijaš ideje dok radiš druge stvari. Vjerovatno imaš sjajne preporuke."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprens escoltant i t'encanten les històries. Absorbeixes idees mentre fas altres coses. Segur que tens recomanacions boníssimes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učíš se poslechem a miluješ příběhy. Myšlenky nasáváš, i když děláš něco jiného. Nejspíš máš skvělé tipy."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n dysgu drwy wrando ac yn caru straeon. Rwyt ti'n amsugno syniadau wrth wneud pethau eraill. Mae'n siŵr bod gen ti argymhellion gwych."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer gennem ørerne og elsker historier. Du suger idéer til dig, mens du laver andet. Du har sikkert gode anbefalinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst übers Hören und liebst Geschichten. Du nimmst Ideen nebenbei auf. Bestimmt hast du tolle Empfehlungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνεις ακούγοντας και λατρεύεις τις ιστορίες. Απορροφάς ιδέες ενώ κάνεις άλλα πράγματα. Μάλλον έχεις φοβερές προτάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes escuchando y te encantan las historias. Absorbes ideas mientras haces otras cosas. Seguro que tienes recomendaciones geniales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulaja ja lugude armastaja. Võtad ideid vastu teiste asjade tegemise kõrvalt. Sul on ilmselt head soovitused."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entzunez ikasten duzu eta istorioak maite dituzu. Ideiak xurgatzen dituzu beste gauza batzuk egin bitartean. Seguru gomendio bikainak dituzula."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با شنیدن یاد می‌گیری و عاشق داستانی. ایده‌ها را وقتی مشغول کارهای دیگری هستی جذب می‌کنی. احتمالاً پیشنهادهای عالی‌ای داری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntelemalla oppiva tarinoiden ystävä. Imet ideoita samalla kun teet muuta. Sinulla on varmasti loistavia suosituksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahilig makinig at mahilig sa kuwento. Natututo ka habang gumagawa ng ibang bagay. Malamang marami kang magandang rekomendasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apprends à l'oreille et tu adores les histoires. Tu absorbes des idées en faisant autre chose. Tu as sûrement d'excellentes recommandations."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foghlaimeoir cluasa agus grá agat do scéalta. Glacann tú smaointe isteach agus tú i mbun rudaí eile. Is dócha go bhfuil moltaí iontacha agat."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes escoitando e encántanche as historias. Absorbes ideas mentres fas outras cousas. Seguro que tes recomendacións xeniais."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કાનથી શીખનારા અને વાર્તાના શોખીન. બીજાં કામ કરતાં કરતાં તમે વિચારો ઝીલી લો છો. તમારી પાસે કદાચ સરસ ભલામણો હશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu koyo ta sauraro kuma masu son labari. Kuna ɗaukar ra'ayoyi yayin da kuke yin wasu abubuwa. Wataƙila kuna da shawarwari masu kyau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למידה דרך האוזן ואהבה לסיפורים. רעיונות נקלטים אצלך תוך כדי דברים אחרים. כנראה יש לך המלצות מעולות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनकर सीखना और कहानियों से प्यार। दूसरे काम करते हुए भी नए विचार आपके अंदर उतर जाते हैं। आपके पास शायद बढ़िया सुझाव भी होंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učiš slušanjem i voliš priče. Upijaš ideje dok radiš druge stvari. Vjerojatno imaš sjajne preporuke."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou aprann nan zòrèy e ou renmen istwa. Ou absòbe lide pandan w ap fè lòt bagay. Ou gendwa gen bon rekòmandasyon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllel tanulsz, és imádod a történeteket. Más dolgok közben szívod magadba az ötleteket. Valószínűleg remek ajánlásaid vannak."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լսելով սովորող և պատմություններ սիրող մարդ։ Գաղափարները կլանում ես՝ այլ գործեր անելիս։ Հավանաբար հիանալի խորհուրդներ ունես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belajar lewat audio dan suka cerita. Kamu menyerap ide sambil melakukan hal lain. Kamu mungkin punya banyak rekomendasi bagus."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onye na-amụta site n'ige ntị ma hụ akụkọ n'anya. Ị na-anabata echiche mgbe ị na-eme ihe ndị ọzọ. Ị nwere ike ịnwe ezigbo aro."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú lærir með eyranu og elskar sögur. Þú drekkur í þig hugmyndir á meðan þú gerir annað. Örugglega með frábær meðmæli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari ascoltando e ami le storie. Assorbi idee mentre fai altro. Probabilmente hai ottimi consigli da dare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳で学ぶ、物語好きな人です。ほかのことをしながらアイデアを吸収しています。きっとおすすめもたくさん持っているはず。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneng sinau liwat kuping lan seneng crita. Panjenengan nyerep gagasan karo nindakake liyane. Mbokmenawa duwe rekomendasi sing apik."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სმენით სწავლობ და ისტორიები გიყვარს. იდეებს სხვა საქმის კეთებისას ითვისებ. ალბათ, შესანიშნავი რეკომენდაციები გაქვს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құлақпен үйренетін, оқиғаны жақсы көретін жансың. Басқа істермен айналысып жүріп-ақ идеяларды сіңіресің. Ұсынатын керемет подкасттарың бар шығар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នករៀនតាមការស្ដាប់ និងស្រឡាញ់រឿងរ៉ាវ។ អ្នកស្រូបយកគំនិតថ្មីៗ ខណៈពេលកំពុងធ្វើរឿងផ្សេង។ ប្រហែលជាមានរឿងល្អៗជាច្រើនសម្រាប់ណែនាំ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೇಳುತ್ತಾ ಕಲಿಯುವವರು, ಕಥೆಗಳ ಪ್ರೇಮಿ. ಬೇರೆ ಕೆಲಸ ಮಾಡುತ್ತಲೇ ನೀವು ವಿಚಾರಗಳನ್ನು ಗ್ರಹಿಸುತ್ತೀರಿ. ನಿಮ್ಮ ಬಳಿ ಬಹುಶಃ ಒಳ್ಳೆಯ ಶಿಫಾರಸುಗಳಿರುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀로 배우고 이야기를 사랑하는 사람이에요. 다른 일을 하면서도 생각을 흡수하죠. 추천할 만한 것도 아마 많을 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bi guhdarîkirinê fêr dibî û ji çîrokan hez dikî. Dema karên din dikî jî tu ramanan werdigirî. Belkî pêşniyarên te yên pir baş hene."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Угуп үйрөнөсүң жана окуяларды жакшы көрөсүң. Башка иш кылып жатып идеяларды сиңиресиң. Сонун сунуштарың бар болсо керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du léiers mam Ouer an hues Geschichte gär. Du hëls Iddien op, wärend s de soss eppes méchs. Wahrscheinlech hues de super Tipps."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮຽນຮູ້ຜ່ານການຟັງ ແລະ ຮັກເລື່ອງເລົ່າ ເຈົ້າຊຶມຊັບແນວຄິດໃນຂະນະທີ່ເຮັດຢ່າງອື່ນໄປນຳ ຄົງມີລາຍການດີໆ ມາແນະນຳຫຼາຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokaisi per klausą ir myli istorijas. Idėjos tave pasiekia net tada, kai užsiimi kitais darbais. Tikriausiai turi puikių rekomendacijų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mācies klausoties un mīli stāstus. Tu uzsūc idejas, darot citas lietas. Tev noteikti ir lieliski ieteikumi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mianatra amin'ny fihainoana sy tia tantara. Mandray hevitra ianao eo am-panaovana zavatra hafa. Azo inoana fa manana torohevitra tsara ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka ako koe mā te whakarongo, ka aroha hoki ki ngā kōrero. Ka mau i a koe ngā whakaaro i a koe e mahi ana i ētahi atu mea. He tūtohu pai pea āu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учиш преку слушање и ги сакаш приказните. Ги впиваш идеите додека правиш други работи. Веројатно имаш одлични препораки."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കേട്ട് പഠിക്കുന്ന, കഥകളെ സ്നേഹിക്കുന്ന ആൾ. മറ്റ് കാര്യങ്ങൾ ചെയ്യുമ്പോഴും നിങ്ങൾ ആശയങ്ങൾ ഉൾക്കൊള്ളുന്നു. നിങ്ങളുടെ കൈയിൽ നല്ല നിർദേശങ്ങൾ ഉണ്ടാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сонсож суралцдаг, түүхэнд дуртай. Өөр юм хийж байхдаа санаа шингээдэг. Гоё зөвлөмж ихтэй байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐकून शिकणारे आणि कथांवर प्रेम करणारे. इतर कामे करताना तुम्ही कल्पना आत्मसात करता. तुमच्याकडे बहुधा भन्नाट शिफारसी असतील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belajar melalui pendengaran dan suka cerita. Anda menyerap idea sambil melakukan perkara lain. Mungkin ada banyak cadangan menarik."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titgħallem bis-smigħ u tħobb l-istejjer. Tassorbi l-ideat waqt li tagħmel affarijiet oħra. Probabbilment għandek rakkomandazzjonijiet tajbin ħafna."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နားထောင်ရင်း လေ့လာသူ၊ ဇာတ်လမ်းချစ်သူပါ။ တခြားအလုပ်လုပ်ရင်း အတွေးအခေါ်တွေ စုပ်ယူတယ်။ အကြံပြုစရာ ကောင်းကောင်းတွေ ရှိလောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer med ørene og elsker historier. Du tar inn ideer mens du gjør andre ting. Du har sikkert gode tips."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनेर सिक्ने र कथा मन पराउने। अरू काम गर्दागर्दै तपाईं विचार ग्रहण गर्नुहुन्छ। सायद तपाईंसँग राम्रा सुझाव पनि छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je leert via je oren en houdt van verhalen. Je neemt ideeën op terwijl je andere dingen doet. Je hebt vast goede tips."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumaphunzira pomvetsera ndipo mumakonda nkhani. Mumalandira malingaliro mukuchita zinthu zina. Mwina muli ndi malangizo abwino kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhaggeeffachuun barattee seenaa jaallatta. Waan biraa hojjechaa yaadota ni fudhatta. Tarii gorsa bareedaa qabda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶୁଣି ଶିଖନ୍ତି ଓ କାହାଣୀ ଭଲପାଆନ୍ତି। ଅନ୍ୟ କାମ କରୁଥିବାବେଳେ ଆପଣ ନୂଆ ଧାରଣା ଗ୍ରହଣ କରନ୍ତି। ଆପଣଙ୍କ ପାଖରେ ସମ୍ଭବତଃ ବହୁତ ଭଲ ପରାମର୍ଶ ଅଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੁਣ ਕੇ ਸਿੱਖਣਾ ਅਤੇ ਕਹਾਣੀਆਂ ਦਾ ਸ਼ੌਕ। ਤੁਸੀਂ ਹੋਰ ਕੰਮ ਕਰਦਿਆਂ ਵੀ ਨਵੇਂ ਵਿਚਾਰ ਜਜ਼ਬ ਕਰ ਲੈਂਦੇ ਹੋ। ਤੁਹਾਡੇ ਕੋਲ ਸ਼ਾਇਦ ਵਧੀਆ ਸਿਫ਼ਾਰਸ਼ਾਂ ਹੋਣਗੀਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczysz się przez słuchanie i kochasz historie. Chłoniesz idee, robiąc inne rzeczy. Pewnie masz sporo świetnych rzeczy do polecenia."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په اورېدو زده کوئ او کیسې مو خوښېږي. د نورو کارونو په وخت کې مفکورې جذبوئ. شاید ډېر ښه وړاندیزونه ولرئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende ouvindo e ama histórias. Você absorve ideias enquanto faz outras coisas. Deve ter ótimas indicações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes a ouvir e adoras histórias. Absorves ideias enquanto fazes outras coisas. Deves ter ótimas recomendações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înveți ascultând și iubești poveștile. Absorbi idei în timp ce faci altceva. Probabil ai recomandări grozave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты воспринимаешь на слух и любишь истории. Впитываешь идеи, пока занимаешься другими делами. Наверняка у тебя есть отличные рекомендации."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiga wumva kandi ukunda inkuru. Wakira ibitekerezo urimo gukora ibindi. Birashoboka ko ufite inama nziza z'ibyo kumva."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඇහීමෙන් ඉගෙනගන්න, කතාවලට ආදරය කරන කෙනෙක්. වෙනත් දේවල් කරමින්ම ඔබ අදහස් උකහා ගන්නවා. ඔබ ළඟ නියම නිර්දේශ ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učíš sa ušami a miluješ príbehy. Myšlienky vstrebávaš popri iných veciach. Určite máš skvelé tipy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učiš se s poslušanjem in obožuješ zgodbe. Ideje vsrkavaš, medtem ko počneš druge stvari. Verjetno imaš odlična priporočila."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unodzidza nekuteerera uye unoda nyaya. Unonzwisisa pfungwa uchiita zvimwe zvinhu. Zvimwe une zvakawanda zvakanaka zvekukurudzira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhegaysi ayaad wax ku barataa, sheekooyinkana waad jeceshahay. Fikradaha ayaad qaadataa adigoo wax kale qabanaya. Malaha talooyin cajiib ah ayaad haysaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mëson duke dëgjuar dhe i do historitë. I thith idetë ndërsa bën gjëra të tjera. Ndoshta ke rekomandime të shkëlqyera."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учиш слушањем и волиш приче. Идеје упијаш док радиш друге ствари. Вероватно имаш одличне препоруке."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resep diajar ku ngadangukeun sareng resep carita. Anjeun nyerep ideu bari ngalakukeun hal séjén. Meureun gaduh seueur rékoméndasi anu saé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lär dig genom att lyssna och älskar berättelser. Du tar in idéer medan du gör annat. Du har nog grymma tips."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unajifunza kwa kusikiliza na unapenda hadithi. Unapokea mawazo huku ukifanya mambo mengine. Huenda una mapendekezo mazuri sana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேட்டுக் கற்பவர், கதைகளை நேசிப்பவர். வேறு வேலை செய்துகொண்டே யோசனைகளை உள்வாங்குகிறீர்கள். உங்களிடம் நல்ல பரிந்துரைகள் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వింటూ నేర్చుకునే, కథలను ఇష్టపడే మనిషి. ఇతర పనులు చేస్తూనే మీరు ఆలోచనలను గ్రహిస్తారు. మీ దగ్గర బహుశా గొప్ప సిఫార్సులు ఉంటాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту бо гӯш меомӯзӣ ва қиссаҳоро дӯст медорӣ. Ҳангоми корҳои дигар ғояҳоро ҷаббида мегирӣ. Эҳтимол тавсияҳои олӣ дорӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียนรู้ผ่านการฟังและรักการฟังเรื่องราว คุณซึมซับไอเดียไปพร้อมกับทำอย่างอื่น และน่าจะมีของดีมาแนะนำเพียบ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብምስማዕ ትመሃሩ፣ ዛንታታት ድማ ትፈትዉ። ካልእ ነገር እናገበርኩም ሓሳባት ትቕበሉ። ምናልባት ጽቡቕ ምኽርታት ኣለኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diňläp öwrenýärsiň we hekaýalary söýýärsiň. Başga işler bilen meşgul bolup, pikirleri özleşdirýärsiň. Megerem, ajaýyp maslahatlaryň bardyr."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinleyerek öğreniyor ve hikâyeleri seviyorsun. Başka şeyler yaparken fikirleri özümsüyorsun. Muhtemelen harika önerilerin vardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сприйняття на слух і любов до історій. Ти вбираєш ідеї, займаючись іншими справами. У тебе, мабуть, чудові рекомендації."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سن کر سیکھنا اور کہانیوں سے محبت۔ دوسرے کام کرتے ہوئے بھی خیالات آپ کے ذہن میں اترتے رہتے ہیں۔ آپ کے پاس شاید زبردست سفارشات ہوں گی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eshitib oʻrganuvchi va hikoyalar ishqibozi. Boshqa ishlar bilan band boʻlib turib gʻoyalarni oʻzlashtirasiz. Ehtimol, ajoyib tavsiyalaringiz bor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học qua tai và mê những câu chuyện. Bạn tiếp thu ý tưởng trong lúc làm việc khác. Chắc bạn có cả kho gợi ý hay."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufunda ngokumamela kwaye uthanda amabali. Ufunxa izimvo ngelixa usenza ezinye izinto. Mhlawumbi uneengcebiso ezintle."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń kẹ́kọ̀ọ́ nípa gbígbọ́, ẹ sì fẹ́ràn ìtàn. Ẹ ń gba èrò sínú nígbà tí ẹ ń ṣe nǹkan mìíràn. Ó dájú pé ẹ ní àbá tó dára."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用耳朵學習、熱愛故事。你能一邊做事一邊吸收想法，手上大概有不少好推介。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是听觉型学习者，也爱听故事。你能边做别的事边吸收想法，手里大概有不少好推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你喜歡用聽的學習，也熱愛故事。你會一邊做事一邊吸收想法，大概有很多好東西可以推薦。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufunda ngokulalela futhi uthanda izindaba. Uthatha imibono ngenkathi wenza ezinye izinto. Kungenzeka unezincomo ezinhle kakhulu."
          }
        }
      }
