        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խորությունը՝ զբոսաշրջությունից առաջ։ Ուզում ես հասկանալ վայրը, ոչ թե պարզապես լուսանկարել։"
