        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ উত্তৰ। বেছিভাগ মানুহেই এনে। ইয়াক পৰীক্ষা কৰি চোৱাৰ ইচ্ছাটোৱেই আটাইতকৈ গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səmimi cavab. Çoxları elədir. Ən önəmlisi bunu araşdırmağa hazır olmaqdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шчыра. У большасці людзей так. Гатоўнасць у гэтым разбірацца — самае важнае."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честно. Повечето хора са така. Готовността да го изследваш е най-важната част."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
