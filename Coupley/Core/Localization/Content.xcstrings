          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Api cinta nggak harus padam — tapi cara menjaganya berbeda bagi setiap orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scintilla non deve per forza spegnersi — ma ciò che la mantiene accesa è diverso per ognuno."
