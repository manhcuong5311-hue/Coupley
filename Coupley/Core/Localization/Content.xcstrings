    "In shared-life relationships, this ends up mattering a lot." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين تتشاركان الحياة، يصبح لهذا الأمر وزن كبير."
          }
        },
        "cs" : {
          "stringUnit" : {
