        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiðarleg óvissa. Það er allt í lagi – sérstaklega ef þú ert á tímamótum. Makinn þinn getur verið akkeri sem styður þig."
