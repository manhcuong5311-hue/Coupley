        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมที่ได้ใช้มือ ช่วยให้คุยกันเบาๆ ได้ง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
