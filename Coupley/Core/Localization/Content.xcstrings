    "Work from home is real life now. Having a proper space matters for your productivity and your sanity." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل من المنزل صار واقع الحياة. وجود مساحة مناسبة مهم لإنتاجيتك ولراحة بالك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práce z domova je dnes běžnou součástí života. Pořádné místo je důležité pro tvou produktivitu i duševní pohodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmearbejde er hverdag nu. Et ordentligt sted at arbejde betyder noget for din produktivitet og din forstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homeoffice ist heute Alltag. Ein richtiger Arbeitsplatz ist wichtig für deine Produktivität und deine Nerven."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δουλειά από το σπίτι είναι πια πραγματικότητα. Ένας κανονικός χώρος μετράει για την παραγωγικότητά σου και την ψυχική σου ισορροπία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajar desde casa ya es la vida real. Tener un espacio en condiciones importa para tu productividad y tu cordura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etätyö on nykyään arkea. Kunnollinen työtila on tärkeä tuottavuudellesi ja jaksamisellesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totoong buhay na ngayon ang work from home. Mahalaga ang maayos na espasyo para sa productivity mo at sa katinuan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le télétravail fait partie de la vie aujourd'hui. Avoir un vrai espace compte pour ta productivité et ton équilibre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבודה מהבית היא כבר חלק מהחיים. מקום מסודר חשוב לפרודוקטיביות ולשפיות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्क फ़्रॉम होम अब असली ज़िंदगी है। एक ढंग की जगह आपके काम और आपके मन के सुकून, दोनों के लिए ज़रूरी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az otthoni munka ma már a valóság. Egy rendes munkasarok számít a hatékonyságod és a lelki békéd szempontjából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja dari rumah sudah jadi kenyataan. Punya ruang yang layak penting untuk produktivitas dan kewarasanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavorare da casa ormai è la normalità. Avere uno spazio adatto conta per la tua produttività e la tua serenità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在宅勤務は今や日常です。ちゃんとした仕事場があることは、生産性にも心の安定にも大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 재택근무는 현실이에요. 제대로 된 공간은 업무 효율에도, 마음의 평화에도 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekerja dari rumah kini realiti hidup. Ruang yang sesuai penting untuk produktiviti dan kewarasan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmekontor er hverdagen nå. Et ordentlig sted å jobbe betyr mye for både produktiviteten og hodet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuiswerken hoort er nu gewoon bij. Een goede werkplek is belangrijk voor je productiviteit en je gemoedsrust."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca z domu to dziś codzienność. Porządne miejsce do pracy ma znaczenie dla twojej produktywności i zdrowia psychicznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar de casa virou a vida real. Ter um espaço de verdade importa para sua produtividade e sua sanidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munca de acasă e acum realitatea de zi cu zi. Un spațiu potrivit contează pentru productivitatea și liniștea ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённая работа — теперь обычная жизнь. Нормальное рабочее место важно и для продуктивности, и для душевного равновесия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att jobba hemifrån är vardag nu. Ett ordentligt utrymme spelar roll för både din produktivitet och ditt psyke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทำงานที่บ้านคือชีวิตจริงในตอนนี้ การมีมุมทำงานที่เหมาะสมสำคัญทั้งต่อประสิทธิภาพและสุขภาพใจของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evden çalışmak artık hayatın bir parçası. Düzgün bir alan, hem verimliliğin hem akıl sağlığın için önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота з дому — тепер звична реальність. Повноцінне робоче місце важливе і для продуктивності, і для душевного спокою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm việc tại nhà giờ đã là đời thực. Có một góc làm việc đàng hoàng rất quan trọng cho năng suất và sự tỉnh táo của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居家办公已经是日常。有一个像样的空间，关系到你的效率和心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家工作已經是日常。擁有一個像樣的空間，對你的效率和身心平衡都很重要。"
          }
        }
      }
    },
    "Work hard, play hard — I give it everything" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجتهاد واستمتاع: أعطيه كل ما لديّ"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makat naplno – dávám tomu všechno"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knokle hårdt, feste hårdt – jeg giver alt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viel arbeiten, viel feiern – ich gebe alles"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκληρή δουλειά, έντονη ζωή — τα δίνω όλα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajar duro y disfrutar a lo grande — lo doy todo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysillä töissä, täysillä vapaalla"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo trabaho, todo saya — ibinibigay ko lahat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bosse dur, je profite à fond : je donne tout"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עובדים קשה, נהנים חזק — הכול על מלא"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जमकर काम, जमकर मस्ती — पूरा दम लगाना"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokat dolgozom, sokat bulizom – mindent beleadok"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja keras, main pun total — semua kuberikan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavoro sodo e mi godo la vita — do il massimo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく働き、よく遊ぶ。全力投球"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열심히 일하고 열심히 놀아요, 다 쏟아부어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja kuat, berseronok pun kuat — saya beri segalanya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full gass på jobb og fritid – jeg gir alt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard werken, hard genieten – ik geef alles"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciężko pracuję, ostro się bawię – daję z siebie wszystko"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho duro, curto muito — dou tudo de mim"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muncesc din greu, mă distrez din plin — dau totul"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работаю и отдыхаю на полную — выкладываюсь целиком"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobba hårt, festa hårt – jag ger allt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานเต็มที่ เที่ยวเต็มที่ ทุ่มสุดตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok çalışır, dolu dolu yaşarım, her şeyimi veririm"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працюю на повну, відпочиваю на повну"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm hết sức, chơi hết mình — mình dốc toàn lực"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼命工作，尽情玩乐，全力以赴"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拚命工作也盡情玩，全力以赴"
          }
        }
      }
    },
    "Work is a means, not the point. You protect your evenings and weekends. That's a mature, healthy boundary." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل وسيلة لا غاية. أمسياتك وعطلاتك محميّة، وهذه حدود ناضجة وصحية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práce je prostředek, ne cíl. Chráníš si večery a víkendy. To je zralá a zdravá hranice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejde er et middel, ikke målet. Du værner om dine aftener og weekender. Det er en moden og sund grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit ist Mittel zum Zweck, nicht der Sinn. Du schützt deine Abende und Wochenenden. Eine reife, gesunde Grenze."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δουλειά είναι μέσο, όχι σκοπός. Προστατεύεις τα βράδια και τα Σαββατοκύριακά σου. Αυτό είναι ώριμο και υγιές όριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo es un medio, no el fin. Proteges tus tardes y tus fines de semana. Es un límite maduro y sano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työ on keino, ei päämäärä. Suojelet iltojasi ja viikonloppujasi. Se on kypsä ja terve raja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paraan lang ang trabaho, hindi ang punto. Pinoprotektahan mo ang mga gabi at weekend mo. Mature at malusog na hangganan ’yan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail est un moyen, pas une fin. Tu protèges tes soirées et tes week-ends. C'est une limite mûre et saine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבודה היא אמצעי, לא העיקר. הערבים וסופי השבוע שלך מוגנים. זה גבול בוגר ובריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम एक ज़रिया है, मंज़िल नहीं। आपकी शामें और वीकेंड सिर्फ़ आपके हैं। यह एक परिपक्व, सेहतमंद सीमा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munka eszköz, nem cél. Véded az estéidet és a hétvégéidet. Ez érett, egészséges határ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan adalah sarana, bukan tujuan. Kamu menjaga malam dan akhir pekanmu. Itu batasan yang dewasa dan sehat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro è un mezzo, non il fine. Difendi le tue serate e i tuoi weekend. È un confine maturo e sano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事は手段であって、目的ではありません。夜と週末をしっかり守る、大人で健全な線引きです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일은 수단이지 목적이 아니에요. 저녁과 주말을 지켜요. 성숙하고 건강한 선 긋기예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja ialah alat, bukan matlamat. Anda menjaga waktu petang dan hujung minggu. Itu batasan yang matang dan sihat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobben er et middel, ikke målet. Du verner om kvelder og helger. Det er en moden og sunn grense."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk is een middel, geen doel. Je beschermt je avonden en weekenden. Dat is een volwassen, gezonde grens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca to środek, nie cel. Chronisz swoje wieczory i weekendy. To dojrzała, zdrowa granica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho é um meio, não o objetivo. Você protege suas noites e fins de semana. Um limite maduro e saudável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munca e un mijloc, nu scopul. Îți protejezi serile și weekendurile. E o limită matură și sănătoasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа — средство, а не цель. Ты бережёшь вечера и выходные. Это зрелая и здоровая граница."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbet är ett medel, inte målet. Du skyddar dina kvällar och helger. Det är en mogen och sund gräns."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานคือเครื่องมือ ไม่ใช่เป้าหมาย คุณปกป้องเวลาเย็นและวันหยุดของตัวเอง นั่นคือขอบเขตที่เป็นผู้ใหญ่และดีต่อใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş bir araç, amaç değil. Akşamlarını ve hafta sonlarını koruyorsun. Bu olgun ve sağlıklı bir sınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота — засіб, а не мета. Ти бережеш вечори й вихідні. Це зріла, здорова межа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc là phương tiện, không phải đích đến. Bạn giữ gìn buổi tối và cuối tuần. Đó là ranh giới trưởng thành, lành mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，不是目的。你会守护自己的晚上和周末。这是成熟又健康的边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，不是目的。你會守住晚上和週末，這是成熟又健康的界線。"
          }
        }
      }
    },
    "Work stress is inevitable — knowing how to support each other makes a real difference." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغط العمل لا مفر منه، ومعرفة كيف يدعم كل منكما الآخر تصنع فرقًا حقيقيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracovnímu stresu se nevyhnete – když víte, jak se podpořit, je to obrovský rozdíl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress på arbejdet er uundgåeligt – at vide, hvordan I støtter hinanden, gør en reel forskel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress im Job ist unvermeidlich – zu wissen, wie ihr euch gegenseitig helft, macht einen echten Unterschied."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγχος της δουλειάς είναι αναπόφευκτο — το να ξέρετε πώς να στηρίζετε ο ένας τον άλλον κάνει πραγματική διαφορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estrés laboral es inevitable — saber cómo apoyarse marca una gran diferencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työstressiä tulee väistämättä – kun tiedätte, miten tukea toisianne, sillä on iso merkitys."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maiiwasan ang stress sa trabaho — malaking tulong kung alam ninyo kung paano susuportahan ang isa’t isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stress au travail est inévitable — savoir comment se soutenir change vraiment la donne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ בעבודה הוא בלתי נמנע — לדעת איך לתמוך זה בזה עושה הבדל אמיתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम का तनाव तो आएगा ही — एक-दूसरे का साथ देने का तरीक़ा जानना असली फ़र्क़ लाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkahelyi stressz elkerülhetetlen – sokat számít, ha tudjátok, hogyan támogassátok egymást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stres kerja pasti datang — tahu cara saling mendukung benar-benar membuat perbedaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stress da lavoro è inevitabile — sapere come sostenersi a vicenda fa davvero la differenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事のストレスは避けられないもの。支え合い方を知っておくだけで、ずいぶん違います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일 스트레스는 피할 수 없어요. 서로를 어떻게 도울지 알면 정말 큰 차이가 생겨요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
