        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ස්ථාවරත්වය සහ මුල් බැසගැනීම. මේක දිගුකාලීන සංඥාවක් — ඔබ හිතන්නේ දැන් ගැන විතරක් නෙවෙයි, පොදු අනාගතයක් ගැනයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilita a korene. Je to dlhodobý signál – myslíš na spoločnú budúcnosť, nielen na teraz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilnost in korenine. To je dolgoročen znak – razmišljaš o skupni prihodnosti, ne le o tem trenutku."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugadzikana nemidzi. Ichi chiratidzo chenguva refu — uri kufunga nezveramangwana ramuchagovana, kwete izvozvi chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xasillooni iyo xidid. Tani waa calaamad muddo dheer — waxaad ka fekeraysaa mustaqbal la wadaago, ma aha hadda oo keliya."
