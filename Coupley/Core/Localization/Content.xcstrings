    "Healthy engagement. You show up, you care, but you also protect the couple's space. That's sustainable." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشاركة صحية. حضور واهتمام، مع حماية مساحة الثنائي. توازن يدوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravá angažovanost. Přijdeš, záleží ti na nich, ale zároveň chráníš prostor vás dvou. To je udržitelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sundt engagement. Du dukker op og viser omsorg, men du værner også om jeres rum som par. Det holder i længden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundes Engagement. Du bist da, es ist dir wichtig, aber du schützt auch euren Raum als Paar. Das hält auf Dauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υγιής συμμετοχή. Δίνεις το παρών, νοιάζεσαι, αλλά προστατεύεις και τον χώρο του ζευγαριού. Αυτό κρατάει στον χρόνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una implicación sana. Estás presente, te importa, pero también proteges el espacio de la pareja. Eso es sostenible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tervettä osallistumista. Olet läsnä ja välität, mutta suojelet myös parisuhteenne omaa tilaa. Se kestää pitkään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malusog na pakikitungo. Dumarating ka, may malasakit ka, pero pinoprotektahan mo rin ang espasyo ninyong dalawa. Kaya itong panatilihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un engagement sain. Tu es là, tu t'impliques, mais tu protèges aussi l'espace du couple. C'est tenable sur la durée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעורבות בריאה. יש לך נוכחות ואכפתיות, אבל גם שמירה על המרחב הזוגי. ככה זה מחזיק לאורך זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेहतमंद जुड़ाव। मौजूदगी भी, परवाह भी — पर कपल की अपनी जगह की हिफ़ाज़त भी। यह लंबे समय तक निभ सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egészséges részvétel. Ott vagy, törődsz, de a kettőtök terét is véded. Ez hosszú távon is működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterlibatan yang sehat. Kamu hadir, kamu peduli, tapi juga menjaga ruang kalian berdua. Itu bisa bertahan lama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coinvolgimento sano. Ci sei, ci tieni, ma proteggi anche lo spazio della coppia. È un equilibrio che dura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健全な関わり方です。顔を出し、気にかけながらも、ふたりの時間は守る。長く続けられるバランスです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강한 관계 맺기예요. 함께하고 마음을 쓰면서도 두 사람만의 공간을 지켜요. 오래 지속할 수 있는 방식이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penglibatan yang sihat. Anda hadir dan mengambil berat, tetapi juga melindungi ruang anda berdua. Itu boleh bertahan lama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sunt engasjement. Du stiller opp og bryr deg, men beskytter også parets eget rom. Det er bærekraftig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezonde betrokkenheid. Je bent er, je geeft om ze, maar je beschermt ook de ruimte van jullie als stel. Dat houd je lang vol."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowe zaangażowanie. Pojawiasz się, zależy ci, ale chronisz też przestrzeń pary. Tak da się żyć długo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolvimento saudável. Você aparece, se importa, mas também protege o espaço do casal. Isso se sustenta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implicare sănătoasă. Ești acolo, îți pasă, dar protejezi și spațiul cuplului. Asta se poate susține pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здоровое участие. Ты приходишь, заботишься, но бережёшь и пространство пары. Так можно долго."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt engagemang. Du ställer upp, du bryr dig, men du skyddar också parets eget utrymme. Det håller i längden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีส่วนร่วมอย่างพอดี คุณไปหา คุณใส่ใจ แต่ก็ปกป้องพื้นที่ของคู่รักไว้ด้วย แบบนี้ยั่งยืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlıklı bir ilgi. Oradasın, önemsiyorsun ama çiftin alanını da koruyorsun. Bu sürdürülebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здорова участь. Ти приходиш, дбаєш, але й бережеш простір вашої пари. Так можна довго."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gắn kết lành mạnh. Bạn có mặt, bạn quan tâm, nhưng cũng giữ gìn không gian riêng của hai người. Như vậy mới bền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的相处方式。你会常去走动、真心关心，也会守护你们俩的空间。这样能长久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的參與。你會出現、會關心，也會守護兩人的空間。這樣的方式能長久。"
          }
        }
      }
    },
    "High effort, high reward. You probably have big goals and you're willing to sacrifice for them. A partner needs to be okay with that." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهد كبير وعائد كبير. لديك على الأرجح أهداف كبيرة واستعداد للتضحية من أجلها، والشريك يحتاج إلى تقبّل ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velké úsilí, velká odměna. Nejspíš máš velké cíle a leccos pro ně obětuješ. Protějšek s tím musí být v pohodě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor indsats, stor gevinst. Du har nok store mål og er villig til at ofre noget for dem. En partner skal være okay med det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoher Einsatz, hoher Lohn. Du hast wahrscheinlich große Ziele und bist bereit, dafür zu verzichten. Die andere Person muss damit klarkommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλη προσπάθεια, μεγάλη ανταμοιβή. Μάλλον έχεις μεγάλους στόχους και θυσιάζεις πράγματα γι' αυτούς. Το ταίρι σου πρέπει να είναι εντάξει με αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucho esfuerzo, mucha recompensa. Seguramente tienes grandes metas y aceptas sacrificarte por ellas. Tu pareja tiene que estar de acuerdo con eso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso panos, iso palkinto. Sinulla on luultavasti suuria tavoitteita, ja olet valmis uhrautumaan niiden eteen. Kumppanin täytyy hyväksyä se."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malaking effort, malaking gantimpala. Malamang malalaki ang pangarap mo at handa kang magsakripisyo para dito. Kailangang ayos lang ito sa partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gros efforts, grosses récompenses. Tu as sûrement de grands objectifs et tu acceptes de faire des sacrifices pour eux. L'autre doit être d'accord avec ça."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השקעה גבוהה, תמורה גבוהה. כנראה שיש לך מטרות גדולות ונכונות להקריב בשבילן. הצד השני צריך להיות בסדר עם זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा मेहनत, ज़्यादा इनाम। शायद आपके लक्ष्य बड़े हैं और उनके लिए त्याग करने को आप तैयार हैं। पार्टनर को इससे सहज होना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagy erőfeszítés, nagy jutalom. Valószínűleg nagy céljaid vannak, és áldozatot is hozol értük. A párodnak ezzel rendben kell lennie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha besar, hasil besar. Kamu mungkin punya target besar dan rela berkorban untuknya. Pasanganmu perlu bisa menerima itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande impegno, grandi risultati. Probabilmente hai obiettivi ambiziosi e accetti di fare sacrifici per raggiungerli. Il tuo partner deve sentirsi a suo agio con questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力で頑張り、大きな成果を得るタイプです。きっと大きな目標があって、そのために犠牲も払えるのでしょう。パートナーにはそれを受け入れてもらう必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많이 쏟는 만큼 크게 얻어요. 아마 큰 목표가 있고 그걸 위해 희생할 각오도 되어 있을 거예요. 연인도 그걸 받아들일 수 있어야 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha tinggi, ganjaran tinggi. Anda mungkin ada matlamat besar dan sanggup berkorban untuknya. Pasangan perlu boleh terima hal itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy innsats, høy gevinst. Du har nok store mål og er villig til å ofre for dem. En partner må være komfortabel med det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel inzet, veel beloning. Je hebt vast grote doelen en bent bereid er iets voor op te offeren. Je partner moet daar vrede mee hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duży wysiłek, duża nagroda. Pewnie masz wielkie cele i chcesz się dla nich poświęcać. Druga połówka musi to akceptować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito esforço, muita recompensa. Você provavelmente tem grandes metas e topa abrir mão de coisas por elas. Seu amor precisa estar de boa com isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efort mare, recompense mari. Probabil ai obiective mari și accepți să faci sacrificii pentru ele. Un partener trebuie să fie de acord cu asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие усилия — большая отдача. Скорее всего, у тебя крупные цели, и ради них ты идёшь на жертвы. Партнёру важно быть к этому готовым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor insats, stor belöning. Du har nog stora mål och är beredd att offra för dem. En partner behöver vara okej med det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงแรงมาก ได้ผลมาก คุณน่าจะมีเป้าหมายใหญ่และยอมเสียสละเพื่อมัน คนรักต้องรับเรื่องนี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük emek, büyük ödül. Muhtemelen büyük hedeflerin var ve onlar için fedakârlığa hazırsın. Partnerinin de bununla barışık olması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великі зусилля — велика віддача. Схоже, у тебе масштабні цілі, і заради них тобі не шкода жертвувати. Половинці треба бути з цим згодною."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nỗ lực lớn, thành quả lớn. Chắc bạn có mục tiêu lớn và sẵn sàng hy sinh vì nó. Người ấy cần chấp nhận được điều đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高投入，高回报。你大概有远大的目标，也愿意为之付出。另一半需要能接受这一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高投入、高回報。你大概有遠大的目標，也願意為此犧牲。另一半需要能接受這點。"
          }
        }
      }
    },
    "High-energy + happy is when spontaneity actually happens." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطاقة العالية مع السعادة هي اللحظة التي تتحقق فيها العفوية فعلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodně energie a radosti – právě tehdy se spontánnost opravdu děje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er med høj energi og godt humør, at spontaniteten faktisk opstår."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viel Energie und gute Laune – genau dann passiert Spontanes wirklich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υψηλή ενέργεια και χαρά: τότε ο αυθορμητισμός γίνεται πραγματικότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con mucha energía y alegría es cuando la espontaneidad de verdad ocurre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun energiaa on paljon ja mieli iloinen, spontaanius oikeasti toteutuu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag masigla at masaya, doon talaga nangyayari ang biglaang lakad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énergie au top et bonne humeur : c'est là que la spontanéité prend vie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנרגיה גבוהה ושמחה — זה הזמן שבו ספונטניות באמת קורית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भरपूर ऊर्जा और ख़ुशी — तभी असल में अचानक वाले प्लान बनते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha sok az energia és jó a kedv, akkor születik igazi spontaneitás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi tinggi + bahagia adalah saat spontanitas benar-benar terjadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanta energia e felicità: è il momento in cui la spontaneità succede davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元気でハッピーなときこそ、思いつきが本当に実現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지 넘치고 행복할 때야말로 즉흥적인 일이 실제로 일어나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat bertenaga dan gembira itulah masa sikap spontan benar-benar menjadi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når energien er høy og humøret godt, skjer spontaniteten faktisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vol energie en blij: juist dan word je echt spontaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dużo energii i radości – to wtedy spontaniczność naprawdę się zdarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia alta e felicidade: é aí que a espontaneidade acontece de verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când energia e mare și starea e bună, spontaneitatea chiar se întâmplă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда много энергии и радости, спонтанность действительно случается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hög energi + glad är när spontanitet faktiskt blir av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนมีพลังและมีความสุข คือจังหวะที่การทำอะไรแบบไม่ได้วางแผนเกิดขึ้นได้จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji yüksek ve keyif yerindeyse spontanelik gerçekten yaşanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багато енергії + щастя — саме тоді спонтанність і стається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui vẻ và tràn năng lượng là lúc sự ngẫu hứng thật sự diễn ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力充沛又开心的时候，才是真正说走就走的时刻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精神好又開心的時候，最容易說走就走。"
          }
        }
      }
    },
