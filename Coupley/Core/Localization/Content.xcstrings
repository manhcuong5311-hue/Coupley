        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብርግጽ። ገና ዛንታታትን ሓሳባትን ትፈትዉ — ምስ ህይወትኩም ብዝሓሸ ኣብ ዝሰማማዕ ቅርጺ ጥራይ።"
