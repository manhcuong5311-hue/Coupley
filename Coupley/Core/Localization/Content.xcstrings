        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikkeen ja mahdollisuuksien aikaa. Kumppanisi on hyvä tietää, mitä on tulossa – tulojen, ajan ja tunnejaksamisen osalta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panahon ito ng pagbabago at posibilidad. Kailangang malaman ito ng partner mo — pagdating sa kita, oras, at emotional na lakas."
