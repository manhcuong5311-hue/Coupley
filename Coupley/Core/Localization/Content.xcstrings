    "Neither extreme is wrong — but knowing where you sit helps you plan as a team." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen uiterste is verkeerd nie – maar as jy weet waar jy staan, kan julle as span beplan."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የትኛውም ጽንፍ ስህተት አይደለም — ግን የት እንደሚቆሙ ማወቅ እንደ ቡድን ለማቀድ ይረዳል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا خطأ في أيّ من الطرفين، لكن معرفة موقعكم تساعدكما على التخطيط كفريق."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো চৰম দিশেই ভুল নহয় — কিন্তু আপুনি ক'ত আছে জানিলে দল হিচাপে পৰিকল্পনা কৰাত সুবিধা হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heç bir ifrat səhv deyil — amma harada dayandığını bilmək bir komanda kimi plan qurmağa kömək edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніводная крайнасць не памылковая — але калі ведаеш, дзе ты, прасцей планаваць як каманда."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нито една от крайностите не е грешна – но да знаеш къде си, ви помага да планирате като екип."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো চরমই ভুল নয় — কিন্তু তুমি কোথায় আছ জানলে একটা দল হিসেবে পরিকল্পনা করা সহজ হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna krajnost nije pogrešna – ali kad znate gdje ko stoji, lakše planirate kao tim."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap extrem és dolent — però saber on et situes us ajuda a planificar en equip."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani jeden extrém není špatný – ale když víš, kde stojíš, líp plánujete jako tým."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dydy'r naill begwn na'r llall yn anghywir — ond mae gwybod ble rwyt ti'n sefyll yn eich helpu i gynllunio fel tîm."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af yderpunkterne er forkerte – men når du ved, hvor du står, er det lettere at planlægge som et team."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Extrem ist falsch – aber wenn du weißt, wo du stehst, könnt ihr besser als Team planen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα άκρο δεν είναι λάθος — αλλά αν ξέρεις πού βρίσκεσαι, μπορείτε να σχεδιάζετε σαν ομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún extremo está mal, pero saber dónde te ubicas ayuda a planificar en equipo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumbki äärmus pole vale — aga kui tead, kus sa seisad, on meeskonnana lihtsam planeerida."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muturretako bat ere ez dago oker — baina non zauden jakiteak talde gisa planifikatzen laguntzen dizue."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ‌کدام از دو سر طیف غلط نیست — ولی دانستن جایگاهت کمک می‌کند مثل یک تیم برنامه بریزید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpikaan ääripää ei ole väärä – mutta kun tiedät, missä kohtaa olet, voitte suunnitella tiiminä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang maling dulo — pero kapag alam mo kung nasaan ka, mas makakapagplano kayo bilang team."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun extrême n'est un problème, mais savoir où tu te situes aide à planifier en équipe."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl ceachtar foircinn mícheart — ach má tá a fhios agat cá seasann tú, is fusa pleanáil mar fhoireann."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún extremo é malo, pero saber onde estás axuda a planificar en equipo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ છેડો ખોટો નથી — પણ તમે ક્યાં છો એ જાણવાથી તમે ટીમ તરીકે પ્લાન કરી શકો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babu ɓangaren da ba daidai ba — amma sanin inda kuke na taimaka muku ku tsara a matsayin ƙungiya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף קצה הוא לא טעות — אבל כשיודעים איפה עומדים, קל יותר לתכנן כצוות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी छोर ग़लत नहीं है — पर यह जानना कि आप कहाँ हैं, एक टीम की तरह प्लान करने में मदद करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna krajnost nije pogrešna – ali kad znaš gdje se nalaziš, lakše planirate kao tim."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni youn ni lòt ekstrèm pa mal — men lè ou konnen kote ou chita, sa ede nou planifye antanke ekip."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyik véglet sem rossz – de ha tudod, hol állsz, csapatként tudtok tervezni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ոչ մի ծայրահեղություն սխալ չէ — բայց իմանալը, թե որտեղ ես դու, օգնում է պլանավորել որպես թիմ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstrem mana pun nggak salah — tapi tahu posisimu membantu kalian merencanakan sebagai tim."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ dịghị nsọtụ ezighi ezi — mana ịma ebe ị nọ na-enyere unu aka ime atụmatụ dịka otu ndị otu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvorugar öfgarnar eru rangar – en ef þú veist hvar þú stendur er auðveldara að skipuleggja sem lið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei due estremi è sbagliato — ma sapere dove ti collochi vi aiuta a pianificare come una squadra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらに偏っていても間違いではありません。自分の立ち位置を知っておくと、チームとして計画を立てやすくなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora ana sing salah saka loro-lorone — nanging ngerti ing ngendi panjenengan ngadeg mbantu nata bareng minangka tim."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არც ერთი უკიდურესობა არაა არასწორი — მაგრამ იმის ცოდნა, სად დგახარ, გუნდურად დაგეგმვაში გეხმარება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екі шеттің ешқайсысы қате емес — бірақ қай жерде тұрғаныңды білу бір команда ретінде жоспарлауға көмектеседі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានភាពជ្រុលណាមួយខុសទេ — ប៉ុន្តែការដឹងថាអ្នកនៅត្រង់ណា ជួយឲ្យអ្នកទាំងពីររៀបផែនការជាក្រុម។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾವ ಅತಿರೇಕವೂ ತಪ್ಪಲ್ಲ — ಆದರೆ ನೀವು ಎಲ್ಲಿದ್ದೀರಿ ಎಂದು ತಿಳಿದರೆ ಒಂದು ತಂಡವಾಗಿ ಯೋಜಿಸಲು ಸಹಾಯವಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽도 틀리지 않아요. 내 위치를 알면 한 팀으로 계획을 세우기 쉬워져요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti aliyê tund ne xelet e — lê zanîna cihê te alîkariya we dike ku hûn wekî tîmekê plan bikin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эки учтун бири да ката эмес — бирок кайда турганыңды билсең, команда катары пландоо оңой."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keen Extrem ass falsch — mee wann s du weess, wou s du stees, kënnt dir als Team besser plangen."
