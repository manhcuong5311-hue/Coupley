          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menehi wektu kanggo ambegan"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სივრცეს ვაძლევ, რომ სული მოითქვას"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тыныс алуға уақыт беремін"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទុកពេលឲ្យគាត់ដកដង្ហើម"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಸಿರಾಡಲು ಅವರಿಗೆ ಅವಕಾಶ ಕೊಡುತ್ತೇನೆ"
          }
        },
        "ko" : {
          "stringUnit" : {
