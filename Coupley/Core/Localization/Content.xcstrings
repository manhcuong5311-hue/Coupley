        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודעות עצמית כנה. ספונטניות מעוררת אצלך הערכה, אבל בפועל עדיף לך זמן היערכות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ुद को ईमानदारी से जानना। आपको स्पॉन्टेनियस होना पसंद है, पर असल में पहले से बता दिया जाए, तो आपके लिए सब बेहतर चलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskrena samosvijest. Diviš se spontanosti, ali u praksi bolje funkcioniraš kad imaš vremena unaprijed."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou konnen tèt ou onètman. Ou admire moun ki spontane men nan pratik ou fonksyone pi byen lè ou gen tan davans."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őszinte önismeret. Csodálod a spontaneitást, de a gyakorlatban jobban működsz, ha van időd felkészülni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անկեղծ ինքնաճանաչում։ Հիանում ես ինքնաբխությամբ, բայց գործնականում ավելի լավ ես գործում, երբ ժամանակ ունես պատրաստվելու։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesadaran diri yang jujur. Kamu kagum pada spontanitas, tapi dalam praktiknya lebih nyaman kalau dikabari jauh-jauh hari."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịmata onwe gị n'eziokwu. Ị na-enwe mmasị n'ime ihe na mberede mana ị na-arụ ọrụ nke ọma karịa mgbe a gwara gị n'oge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiðarleg sjálfsþekking. Þú dáist að hvatvísi en virkar í reynd betur með fyrirvara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sincera consapevolezza di te. Ammiri la spontaneità, ma in pratica funzioni meglio con un po’ di anticipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直な自己分析。思いつきで動ける人に憧れつつ、実際は準備の時間があるほうがうまくいくタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngerti dhiri kanthi jujur. Panjenengan kagum karo sing dadakan nanging nyatane luwih lancar yen ana wektu kanggo nyiapake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საკუთარი თავის გულწრფელი ცოდნა. სპონტანურობით აღფრთოვანებული ხარ, მაგრამ პრაქტიკაში უკეთ მოქმედებ, როცა წინასწარ იცი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзіңді шынайы тани білесің. Кенеттен шешімді ұнатасың, бірақ іс жүзінде алдын ала білгенде жақсырақ жұмыс істейсің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការយល់ដឹងពីខ្លួនឯងដោយស្មោះត្រង់។ អ្នកកោតសរសើរភាពធ្វើភ្លាមៗ ប៉ុន្តែតាមពិតអ្នកដំណើរការបានល្អជាង ពេលមានពេលត្រៀមខ្លួន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಾಮಾಣಿಕ ಸ್ವ-ಅರಿವು. ಹಠಾತ್ ಸಾಹಸಗಳನ್ನು ನೀವು ಮೆಚ್ಚುತ್ತೀರಿ, ಆದರೆ ಮೊದಲೇ ತಿಳಿದಿದ್ದರೆ ನೀವು ಹೆಚ್ಚು ಚೆನ್ನಾಗಿ ನಿಭಾಯಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자신을 솔직하게 알고 있어요. 즉흥적인 모습이 멋져 보여도, 실제로는 미리 준비할 시간이 있을 때 더 잘해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xwenasîneke rastgo. Tu ji bêplaniyê hez dikî, lê di pratîkê de bi wextê amadekariyê çêtir dixebitî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзүңдү чынчыл түшүнөсүң. Күтүүсүздүккө суктанасың, бирок иш жүзүндө алдын ала эскертишсе жакшыраак болот."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éierlech Selbstkenntnis. Du bewonners Spontanitéit, mee am Alldag funktionéiers du besser mat e bëssen Zäit am Viraus."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮູ້ຈັກຕົນເອງຢ່າງຈິງໃຈ ເຈົ້າຊື່ນຊົມຄວາມບໍ່ມີແຜນ ແຕ່ໃນຄວາມເປັນຈິງເຮັດໄດ້ດີກວ່າເມື່ອມີເວລາກຽມຕົວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuoširdus savęs pažinimas. Žaviesi spontaniškumu, bet praktiškai tau geriau, kai turi laiko pasiruošti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godīga sevis izpratne. Tu apbrīno spontanitāti, bet praksē labāk funkcionē, ja ir laiks sagatavoties."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahafantarana tena marina. Tianao ny tampoka nefa miasa tsara kokoa ianao raha misy fotoana fiomanana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mōhio pono ki a koe anō. Ka mīharo koe ki te ohorere, engari ka pai ake tō mahi ina whai wā koe i mua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искрена самосвест. Ти се допаѓа спонтаноста, но во пракса функционираш подобро кога знаеш однапред."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സത്യസന്ധമായ സ്വയം തിരിച്ചറിവ്. പെട്ടെന്നുള്ള പരിപാടികൾ നിങ്ങൾക്ക് ഇഷ്ടമാണ്, പക്ഷേ പ്രായോഗികമായി മുൻകൂട്ടി സമയം കിട്ടുമ്പോഴാണ് നിങ്ങൾ നന്നായി പ്രവർത്തിക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шударга өөрийгөө таних. Гэнэтийн байдлыг биширдэг ч бодит амьдрал дээр урьдчилсан хугацаатай үед илүү сайн ажилладаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वतःची प्रामाणिक जाण. तुम्हाला उत्स्फूर्तपणाचे कौतुक वाटते, पण प्रत्यक्षात थोडी आगाऊ सूचना मिळाली की तुम्ही अधिक चांगले वावरता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesedaran diri yang jujur. Anda mengagumi sikap spontan, tetapi hakikatnya anda lebih selesa jika diberi masa bersedia."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għarfien onest ta' lilek innifsek. Tammira l-ispontanjetà imma fil-prattika tiffunzjona aħjar meta jkollok żmien biex tipprepara."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ့်ကိုယ်ကို ရိုးရိုးသားသား သိတယ်။ ချက်ချင်းလက်ငင်း လုပ်တတ်တာကို အားကျပေမဲ့ လက်တွေ့မှာ ကြိုသိထားရရင် ပိုအဆင်ပြေတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærlig selvinnsikt. Du beundrer spontanitet, men fungerer bedre i praksis når du får tid til å forberede deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इमानदार आत्मबोध। तपाईंलाई अचानकपन मन पर्छ, तर व्यवहारमा पहिले नै थाहा पाउँदा राम्रोसँग काम गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlijk zelfinzicht. Je bewondert spontaniteit, maar in de praktijk werk je beter als je het van tevoren weet."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudzidziwa moona mtima. Mumasirira kuchita zinthu mwadzidzidzi koma kwenikweni mumachita bwino mukadziwitsidwa msanga."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of beekuu dhugaa. Waan tasaa ni dinqisiifatta, garuu qabatamaan yeroo qophaa'uu yoo qabaatte caalaatti hojjetta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଚ୍ଚୋଟ ଆତ୍ମସଚେତନତା। ଆପଣ ହଠାତ୍ ପଣକୁ ପ୍ରଶଂସା କରନ୍ତି, କିନ୍ତୁ ବାସ୍ତବରେ ଆଗରୁ ସମୟ ପାଇଲେ ଭଲ କାମ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੇ ਬਾਰੇ ਇਮਾਨਦਾਰ ਸਮਝ। ਤੁਹਾਨੂੰ ਝੱਟ-ਪੱਟ ਵਾਲੀ ਮੌਜ ਪਸੰਦ ਹੈ, ਪਰ ਅਮਲ ਵਿੱਚ ਪਹਿਲਾਂ ਤੋਂ ਪਤਾ ਹੋਵੇ ਤਾਂ ਤੁਸੀਂ ਬਿਹਤਰ ਕੰਮ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczera samoświadomość. Podziwiasz spontaniczność, ale w praktyce lepiej funkcjonujesz, gdy masz czas się przygotować."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادقه ځان‌پېژندنه. ناڅاپي‌توب مو خوښېږي، خو په عمل کې له مخکې وخت سره ښه کار کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoconhecimento sincero. Você admira a espontaneidade, mas na prática funciona melhor com antecedência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoconhecimento honesto. Admiras a espontaneidade, mas na prática funcionas melhor com antecedência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O autocunoaștere sinceră. Admiri spontaneitatea, dar în practică funcționezi mai bine când știi din timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честный взгляд на себя. Спонтанность тебя восхищает, но на практике тебе лучше, когда есть время подготовиться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwimenya by'ukuri. Ukunda ibitunguranye ariko mu bikorwa ukora neza iyo wamenyeshejwe kare."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවංක ස්වයං අවබෝධයක්. ස්වයංසිද්ධභාවයට ඔබ ආදරෙයි, ඒත් ප්‍රායෝගිකව ඔබ හොඳින් වැඩ කරන්නේ කලින් දැනුම් දුන්නාම."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úprimné sebapoznanie. Spontánnosť obdivuješ, ale prakticky ti lepšie funguje mať čas vopred."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskreno samozavedanje. Spontanost občuduješ, v praksi pa ti gre bolje, ko imaš čas za pripravo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unonyatsozviziva. Unoyemura kuita zvinhu pasina kuronga asi unoshanda zvirinani kana wapiwa nguva yekugadzirira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-garasho daacad ah. Waad la dhacsan tahay wax-aan-la-qorsheyn, balse dhab ahaan waad ka shaqeysaa si fiican marka waqti hore lagu siiyo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetënjohje e sinqertë. E admiron spontanitetin, por në praktikë funksionon më mirë kur ke kohë të përgatitesh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искрена самосвест. Дивиш се спонтаности, али у пракси боље функционишеш кад знаш унапред."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadar diri anu jujur. Anjeun kagum kana spontanitas, tapi dina prakna langkung saé upami aya waktos tatahar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ärlig självinsikt. Du beundrar spontanitet, men i praktiken fungerar du bättre med lite framförhållning."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujitambua kwa uwazi. Unavutiwa na mambo ya papo hapo lakini kiutendaji unafanya vizuri zaidi ukipewa muda wa kujiandaa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேர்மையான சுய புரிதல். திடீர்த் திட்டங்களை ரசிக்கிறீர்கள், ஆனால் நடைமுறையில் முன்கூட்டிய அவகாசம் இருந்தால்தான் சிறப்பாகச் செயல்படுகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిజాయితీతో కూడిన స్వీయ అవగాహన. అప్పటికప్పుడు చేసే పనులంటే మీకు ఇష్టమే, కానీ ఆచరణలో కాస్త ముందుగా తెలిస్తేనే మీరు బాగా పనిచేస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Худшиносии ростқавлона. Ту ногаҳониро меписандӣ, вале амалан бо вақти пешакӣ беҳтар кор мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้จักตัวเองอย่างซื่อตรง คุณชื่นชอบการทำอะไรแบบไม่วางแผน แต่ในทางปฏิบัติจะทำได้ดีกว่าเมื่อมีเวลาเตรียมตัว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅኑዕ ርእሰ-ፍልጠት። ድንገታውነት ተድንቑ፣ ግን ብተግባር ቅድሚኡ ግዜ ምስ ዝህልወኩም ይሓይሸኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özüňi dogruçyl tanaýarsyň. Duýdansyzlygy halaýarsyň, ýöne iş ýüzünde öňünden bilseň, has gowy işleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dürüst bir öz farkındalık. Spontaneliğe hayransın ama pratikte önceden haberin olunca daha rahat ediyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чесне самоусвідомлення. Спонтанність тебе захоплює, але на практиці тобі краще, коли є час підготуватися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سچی خود آگاہی۔ بے ساختگی آپ کو پسند ہے، مگر عملی طور پر پہلے سے اطلاع ہو تو سب بہتر چلتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻzingizni samimiy anglash. Spontanlikni qadrlaysiz, lekin amalda oldindan xabardor boʻlsangiz, oʻzingizni yaxshiroq his qilasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiểu mình thật thà. Bạn ngưỡng mộ sự ngẫu hứng nhưng trên thực tế lại làm tốt hơn khi có thời gian chuẩn bị."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzazi okunyanisekileyo. Uyakuthanda ukwenza izinto ngequbuliso, kodwa ngokwenene usebenza ngcono xa unexesha lokulungiselela."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mímọ ara ẹni tòótọ́. Ẹ ń mọyì ṣíṣe nǹkan lójijì, ṣùgbọ́n ẹ ń ṣe dáadáa jù tí ẹ bá ní àkókò láti múra."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坦白的自知之明。你欣賞隨性，但實際上有預備時間會表現得更好。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对自己很诚实。你欣赏随性，但实际上有点准备时间，你会状态更好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很誠實的自我覺察。你欣賞隨興，但實際上有時間準備，你會表現得更好。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzazi okuqotho. Uyakuthanda ukwenza izinto ngokuzumayo kodwa empeleni usebenza kangcono uma unesikhathi sokulungiselela."
          }
        }
      }
    },
    "Honest uncertainty. That's okay — especially if you're in a transition phase. A supportive partner can be an anchor." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlike onsekerheid. Dis heeltemal oukei – veral as jy in ’n oorgangsfase is. ’n Ondersteunende maat kan ’n anker wees."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅን የሆነ እርግጠኛ አለመሆን። ይህ ምንም ችግር የለውም — በተለይ በሽግግር ወቅት ላይ ከሆኑ። የሚደግፍ አጋር መልሕቅ ሊሆንዎ ይችላል።"
