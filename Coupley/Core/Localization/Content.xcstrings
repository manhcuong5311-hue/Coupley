        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gatnaşykda nädip güýç toplaýandygyňa, adamlar bilen aragatnaşygyňa we näçe giňişlik gerekdigine täsir edýär."
