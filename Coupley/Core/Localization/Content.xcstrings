        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기는 스트레스 호르몬을 낮춰 주고, 마주 앉는 것보다 나란히 걷는 게 편해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjalan menurunkan hormon stres, dan bersebelahan lebih selesa daripada bertentang mata."
