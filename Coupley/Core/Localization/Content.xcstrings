        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Զիջող ու պատրաստակամ։ Պարզապես համոզվիր, որ իսկապես այդպես ես մտածում — ընտանի կենդանին երկարաժամկետ պատասխանատվություն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akomodatif dan bersedia. Pastikan saja kamu sungguh-sungguh — hewan peliharaan itu komitmen jangka panjang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-anabata ma dị njikere. Naanị hụ na i kwuru ya n'ezie — anụ ụlọ bụ nkwa ogologo oge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillitssemi og vilji. Passaðu bara að þér sé alvara – gæludýr eru löng skuldbinding."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibilità e accoglienza. Assicurati solo di pensarlo davvero — un animale è un impegno lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手に合わせる気持ちがある人です。ただ、本心かどうかは確かめて。ペットとの暮らしは長い約束です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gampang nampa lan gelem. Mung priksa panjenengan saestu tulus — kewan ingon-ingon iku tanggung jawab sing suwe."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დამთმობი და მზად ხარ. უბრალოდ, დარწმუნდი, რომ მართლა გინდა — შინაური ცხოველი ხანგრძლივი ვალდებულებაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ыңғайлы әрі дайынсың. Тек шын ниетпен айтып тұрғаныңа көз жеткіз — үй жануары ұзақ жауапкершілік."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចេះសម្រួល និងសុខចិត្ត។ គ្រាន់តែប្រាកដថាអ្នកពិតជាចង់មែន — សត្វចិញ្ចឹមគឺជាការប្ដេជ្ញាចិត្តរយៈពេលវែង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೊಂದಿಕೊಳ್ಳುವ, ಸಿದ್ಧ ಮನಸ್ಸು. ನೀವು ಅದನ್ನು ನಿಜವಾಗಿ ಅರ್ಥೈಸುತ್ತೀರಿ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ — ಸಾಕುಪ್ರಾಣಿ ದೀರ್ಘಕಾಲದ ಬದ್ಧತೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배려심 있고 마음이 열려 있어요. 다만 진심인지 꼭 확인해 보세요. 반려동물은 오랜 약속이니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guncav û amade. Tenê bawer be ku tu bi rastî wisa difikirî — heywanên malê berpirsiyariyeke dirêj in."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түшүнүүчү жана даяр. Болгону муну чын дилден айтып жатканыңды текшер — үй жаныбары узак милдеттенме."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entgéintkommend a bereet. Sief just sécher, datt s du et wierklech mengs — en Hausdéier ass eng laang Verflichtung."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໃຈກວ້າງ ແລະ ເຕັມໃຈ ພຽງແຕ່ໃຫ້ແນ່ໃຈວ່າເຈົ້າໝາຍຄວາມແທ້ — ສັດລ້ຽງຄືຄຳໝັ້ນສັນຍາໄລຍະຍາວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuolaidžiai ir geranoriškai. Tik įsitikink, kad iš tiesų taip manai – augintinis yra ilgas įsipareigojimas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretimnākoši un ar gatavību. Tikai pārliecinies, ka tiešām to domā, – mājdzīvnieks ir ilgstoša apņemšanās."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahay mandray sy vonona ianao. Ataovy fotsiny izay hahatenanao tokoa izany — fanoloran-tena maharitra ny biby fiompy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He manaaki, he hiahia. Kia tino pono noa tāu — he here roa ngā mōkai."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предусретливо и со волја. Само погрижи се навистина да го мислиш тоа — милениците се долга обврска."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇണങ്ങാനും സമ്മതിക്കാനുമുള്ള മനസ്സ്. നിങ്ങൾ അത് ശരിക്കും ഉദ്ദേശിക്കുന്നുണ്ടെന്ന് മാത്രം ഉറപ്പാക്കൂ — വളർത്തുമൃഗങ്ങൾ ഒരു നീണ്ട ഉത്തരവാദിത്തമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дасан зохицдог, бэлэн. Үнэхээр чин сэтгэлээсээ гэдгээ шалгаарай — тэжээвэр амьтан бол урт хугацааны хариуцлага."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामावून घेणारे आणि तयार. फक्त तुम्ही हे खरोखर मनापासून म्हणताय ना, याची खात्री करा — पाळीव प्राणी ही दीर्घकाळची जबाबदारी आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertolak ansur dan sanggup. Cuma pastikan anda benar-benar maksudkannya — haiwan peliharaan ialah komitmen jangka panjang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibbiltà u rieda tajba. Biss kun żgur li verament tfissirha — l-annimali huma impenn twil."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လိုက်လျောပြီး ဆန္ဒရှိတယ်။ တကယ် စိတ်ရင်းနဲ့ ပြောတာလား သေချာပါစေ — အိမ်မွေးတိရစ္ဆာန်က ရေရှည် တာဝန်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imøtekommende og villig. Bare sørg for at du virkelig mener det – kjæledyr er en lang forpliktelse."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलाउने र इच्छुक। बस, तपाईं साँच्चै मनैदेखि भन्दै हुनुहुन्छ भन्ने पक्का गर्नुहोस् — घरपालुवा जनावर लामो प्रतिबद्धता हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inschikkelijk en bereidwillig. Zorg wel dat je het echt meent – een huisdier is een lange verbintenis."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wololera ndi wofunitsitsa. Ingotsimikizirani kuti mukutanthauzadi — ziweto ndi udindo wa nthawi yaitali."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simataa fi fedhii qabu. Garuu dhugumaan akka jettu mirkaneeffadhu — bineensonni manaa dirqama yeroo dheeraa ti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସହଯୋଗୀ ଓ ଇଚ୍ଛୁକ। କେବଳ ନିଶ୍ଚିତ କରନ୍ତୁ ଆପଣ ସତରେ ମନରୁ କହୁଛନ୍ତି — ପୋଷା ଜୀବଜନ୍ତୁ ଏକ ଲମ୍ବା ପ୍ରତିବଦ୍ଧତା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਖੁੱਲ੍ਹੇ ਦਿਲ ਵਾਲੇ ਅਤੇ ਤਿਆਰ। ਬੱਸ ਪੱਕਾ ਕਰੋ ਕਿ ਤੁਸੀਂ ਸੱਚਮੁੱਚ ਦਿਲੋਂ ਕਹਿ ਰਹੇ ਹੋ — ਪਾਲਤੂ ਜਾਨਵਰ ਲੰਮੀ ਜ਼ਿੰਮੇਵਾਰੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugodowo i z chęcią. Upewnij się tylko, że naprawdę tak myślisz – zwierzak to zobowiązanie na długie lata."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زړه پراخي او چمتووالی. یوازې ډاډ ترلاسه کړئ چې په رښتیا یې وایئ — کورني څاروي اوږده ژمنه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposição e flexibilidade. Só garanta que é de coração — pet é um compromisso longo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibilidade e boa vontade. Só garante que é mesmo a sério — um animal é um compromisso longo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate și bunăvoință. Doar asigură-te că o spui din inimă — un animal e un angajament pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уступчивость и готовность. Только убедись, что ты действительно этого хочешь: питомец — это надолго."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urakira kandi urabishaka. Gusa reba ko ubivuga ubikuye ku mutima — amatungo ni inshingano z'igihe kirekire."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉඩ දෙනවා, කැමැත්තෙන් ඉන්නවා. ඔබ ඒක ඇත්තටම අදහස් කරනවාද කියලා විතරක් බලන්න — සුරතල් සතුන් දිගු වගකීමක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ústretovo a ochotne. Len sa uisti, že to myslíš vážne – zviera je dlhý záväzok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustrežljivo in pripravljeno. Le poskrbi, da to res misliš – ljubljenček je dolga zaveza."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unogamuchira uye unoda. Ingova nechokwadi chekuti unozvireva chaizvo — mhuka chisungo chenguva refu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qabsasho iyo diyaar-garow. Kaliya hubi inaad si dhab ah ula jeeddo — xayawaanka guriga waa ballan-qaad dheer."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirëkuptim dhe gatishmëri. Thjesht sigurohu që e ke vërtet seriozisht – kafshët janë angazhim i gjatë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предусретљивост и добра воља. Само провери да ли то стварно мислиш — љубимци су дуга обавеза."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daék nyaluyukeun sareng ihlas. Pastikeun waé anjeun leres-leres sungguh-sungguh — ingon-ingon téh komitmen anu panjang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillmötesgående och villig. Se bara till att du verkligen menar det – husdjur är ett långt åtagande."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwenye kuridhia na kuwa tayari. Hakikisha tu unamaanisha kweli — wanyama vipenzi ni ahadi ya muda mrefu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விட்டுக்கொடுப்பவர், தயாரானவர். நீங்கள் அதை உண்மையாகவே சொல்கிறீர்களா என்று மட்டும் உறுதிசெய்யுங்கள் — செல்லப்பிராணி என்பது நீண்ட காலப் பொறுப்பு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సర్దుకుపోయే, ఇష్టంగా ఒప్పుకునే స్వభావం. మీరు నిజంగా అలా అనుకుంటున్నారని నిర్ధారించుకోండి — పెంపుడు జంతువులు దీర్ఘకాల బాధ్యత."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гузашткунанда ва омода. Танҳо бубин, ки инро воқеан аз дил мегӯӣ — ҳайвони хонагӣ ӯҳдадории дарозмуддат аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นและเต็มใจ แค่ให้แน่ใจว่าคุณตั้งใจจริง เพราะสัตว์เลี้ยงคือความผูกพันระยะยาว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተቐባልን ፍቓደኛን። ጥራይ ብሓቂ ከም እትኣምንሉ ኣረጋግጹ — ዘቤታዊ እንስሳ ነዊሕ ሓላፍነት እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylalaşýan we taýýar. Diňe muny hakykatdan ýürekden aýdýandygyňa göz ýetir — öý haýwany uzak möhletli jogapkärçilik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu ve istekli. Sadece bunu gerçekten istediğinden emin ol; evcil hayvan uzun soluklu bir sorumluluk."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поступливо й охоче. Просто переконайся, що ти справді цього хочеш, — улюбленець — це надовго."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لچک دار اور آمادہ۔ بس یقینی بنائیں کہ یہ دل سے ہو — پالتو جانور ایک لمبی ذمہ داری ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moslashuvchan va tayyor. Faqat buni chin dildan aytayotganingizga ishonch hosil qiling — uy hayvoni uzoq muddatli masʼuliyat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều lòng và sẵn sàng. Chỉ cần chắc rằng bạn thật lòng — thú cưng là cam kết lâu dài."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyavumelana kwaye uzimisele. Qiniseka nje ukuba ukuthetha ngokwenene — izilwanyana luxanduva lwexesha elide."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń gbani mọ́ra, ẹ sì ṣetán. Ṣáà rí i dájú pé lóòótọ́ lẹ fẹ́ bẹ́ẹ̀ — ẹranko ọ̀sìn jẹ́ ojúṣe ọjọ́ pípẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包容又願意配合。只要確定你是真心的，養寵物是長久的承諾。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
