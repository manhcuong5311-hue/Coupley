        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι δέχεσαι καλύτερα την αγάπη — το ταίρι σου πρέπει να το ξέρει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así es como mejor recibes el amor, y tu pareja necesita saberlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nii võtad sa armastust kõige paremini vastu — sinu partner peaks seda teadma."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horrela jasotzen duzu maitasuna ondoen — zure bikotekideak jakin behar du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این همان راهی است که عشق را بهتر از همه دریافت می‌کنی — پارتنرت باید این را بداند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näin otat rakkauden parhaiten vastaan – kumppanisi kannattaa tietää tämä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganito mo pinakamadaling natatanggap ang pagmamahal — dapat itong malaman ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est ta façon de recevoir l'amour : l'autre a besoin de le savoir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seo mar is fearr a ghlacann tú le grá — ba chóir go mbeadh a fhios sin ag do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así é como mellor recibes o amor: a túa parella necesita sabelo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે પ્રેમ સૌથી સારી રીતે આ રીતે અનુભવો છો — તમારા પાર્ટનરે આ જાણવું જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta haka ne kuka fi karɓar soyayya — ya kamata abokin zamanku ya san wannan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ככה הכי קל לך לקבל אהבה — וחשוב שהצד השני יידע את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको प्यार इसी तरह सबसे अच्छी तरह महसूस होता है — आपके पार्टनर को यह पता होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovako najbolje primaš ljubav – voljena osoba to treba znati."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se konsa ou resevwa lanmou pi byen — patnè ou bezwen konnen sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Így tudod a legjobban befogadni a szeretetet – ezt a párodnak is tudnia kell."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այսպես ես դու ամենալավը ընդունում սերը — զուգընկերդ պետք է դա իմանա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begini caramu paling baik menerima cinta — pasanganmu perlu tahu ini."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otu a ka ị na-anabata ịhụnanya nke ọma — onye gị kwesịrị ịma nke a."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svona tekur þú best á móti ást – makinn þinn þarf að vita þetta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il modo in cui ricevi meglio l’amore — il tuo partner deve saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛をいちばん受け取りやすい形です。パートナーにぜひ知っておいてほしいこと。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iki cara panjenengan paling gampang nampa tresna — pasangan panjenengan perlu ngerti iki."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ასე იღებ სიყვარულს ყველაზე კარგად — შენმა პარტნიორმა ეს უნდა იცოდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Махаббатты дәл осылай қабылдайсың — серігің мұны білуі керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នេះជារបៀបដែលអ្នកទទួលក្ដីស្រឡាញ់បានល្អបំផុត — ដៃគូរបស់អ្នកគួរតែដឹងរឿងនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಪ್ರೀತಿಯನ್ನು ಅತ್ಯುತ್ತಮವಾಗಿ ಸ್ವೀಕರಿಸುವುದು ಹೀಗೆ — ಇದು ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ತಿಳಿದಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사랑을 가장 잘 느끼는 방식이에요. 연인이 꼭 알아야 할 부분이죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu evînê herî baş bi vî awayî distînî — divê hevjînê te vê zanibe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен сүйүүнү эң жакшы ушинтип сезесиң — сүйгөнүң муну билиши керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou kënnt Léift am beschte bei dir un — däi Schatz sollt dat wëssen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ນີ້ຄືວິທີທີ່ເຈົ້າຮັບຮູ້ຄວາມຮັກໄດ້ດີທີ່ສຸດ — ຄູ່ຂອງເຈົ້າຄວນຮູ້ເລື່ອງນີ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip tu geriausiai priimi meilę – tavo antroji pusė turi tai žinoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tā tu vislabāk pieņem mīlestību – tavai otrajai pusei tas jāzina."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izao no fomba handraisanao tsara indrindra ny fitiavana — tokony ho fantatry ny olon-tianao izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koinei te huarahi e tino tae mai ai te aroha ki a koe — me mōhio tō hoa aroha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вака најдобро примаш љубов — твојата половинка треба да го знае ова."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ സ്നേഹം ഏറ്റവും നന്നായി സ്വീകരിക്കുന്നത് ഇങ്ങനെയാണ് — നിങ്ങളുടെ പങ്കാളി ഇത് അറിഞ്ഞിരിക്കണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи хайрыг ингэж хамгийн сайн хүлээж авдаг — хань чинь үүнийг мэдэх хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्यापर्यंत प्रेम सर्वात छान असे पोहोचते — हे तुमच्या जोडीदाराला माहीत असायला हवे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginilah cara anda paling mudah menerima kasih sayang — pasangan anda perlu tahu tentang ini."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hekk tilqa' l-imħabba l-aħjar — ta' min tgħarraf lill-partner tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒါက သင် အချစ်ကို အကောင်းဆုံး လက်ခံခံစားတဲ့ပုံစံပါ — သင့်ချစ်သူ ဒါကို သိထားဖို့ လိုပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slik tar du best imot kjærlighet – dette bør partneren din vite."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं माया यसरी नै सबैभन्दा राम्रोसँग पाउनुहुन्छ — तपाईंको पार्टनरले यो थाहा पाउनैपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo ontvang jij liefde het best – en dat moet je partner weten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umu ndi mmene mumalandirira chikondi bwino — wokondedwa wanu ayenera kudziwa izi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun karaa ati jaalala itti caalaatti fudhattuudha — jaalalleen kee kana beekuun barbaachisaadha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଏହିପରି ଭଲପାଇବା ସବୁଠୁ ଭଲ ଗ୍ରହଣ କରନ୍ତି — ଆପଣଙ୍କ ସାଥୀଙ୍କୁ ଏହା ଜାଣିବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਪਿਆਰ ਨੂੰ ਇਸੇ ਤਰ੍ਹਾਂ ਸਭ ਤੋਂ ਵੱਧ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ — ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਨੂੰ ਇਹ ਪਤਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak najlepiej przyjmujesz miłość – twoja druga połówka powinna o tym wiedzieć."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو مینه په همدې ډول تر ټولو ښه احساسوئ — ستاسو ملګری باید پرې خبر وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É assim que você recebe amor — seu amor precisa saber disso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É assim que recebes melhor o amor — o teu par precisa de saber isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așa primești tu iubirea cel mai bine — partenerul tău trebuie să știe asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так тебе легче всего принимать любовь — и твоему партнёру важно это знать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubu ni bwo buryo wakira urukundo neza — umukunzi wawe akwiye kubimenya."
