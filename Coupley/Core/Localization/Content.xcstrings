        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ رشتے میں آپ کے تازہ دم ہونے، میل جول اور ذاتی جگہ کی ضرورت پر اثر ڈالتا ہے۔"
