    "Reliability is everything. Knowing they'll be there without needing to ask is the most grounding thing in the world." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betroubaarheid is alles. Om te weet jou maat sal daar wees sonder dat jy hoef te vra, is die gerusstellendste ding ter wêreld."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እምነት የሚጣልበት መሆን ሁሉም ነገር ነው። ሳይጠይቁ እንደሚገኙ ማወቅ በዓለም ላይ ከሁሉ የሚያረጋጋ ነገር ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاعتمادية هي كل شيء. معرفة أن شريكك سيكون هناك دون أن تطلبوا هي أكثر ما يمنحكم الطمأنينة في العالم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিৰ্ভৰযোগ্যতাই সকলো। নোসোধাকৈয়ে সংগী কাষত থাকিব বুলি জনাটো পৃথিৱীৰ আটাইতকৈ আশ্বস্তিদায়ক কথা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etibarlılıq hər şeydir. Xahiş etmədən onun yanında olacağını bilmək dünyada ən arxayın edən şeydir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надзейнасць — гэта ўсё. Ведаць, што палавінка будзе побач і нават прасіць не давядзецца, — самае супакойлівае на свеце."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надеждността е всичко. Да знаеш, че половинката ти ще е до теб, без да молиш, е най-голямата опора на света."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভরসাই সব। চাইতে না হলেও ও পাশে থাকবে — এটা জানার চেয়ে স্বস্তির কিছু পৃথিবীতে নেই।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost je sve. Kad znaš da će voljena osoba biti tu, a da ne moraš tražiti, to je najveći oslonac na svijetu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilitat ho és tot. Saber que hi serà sense haver de demanar-ho és el que més seguretat et dona del món."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolehlivost je pro tebe všechno. Vědět, že tvůj protějšek bude při tobě i bez prošení, je to nejjistější na světě."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibynadwyedd yw popeth. Gwybod y bydd dy bartner yno heb i ti orfod gofyn yw'r peth sy'n dy sadio fwyaf yn y byd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålidelighed er alt. At vide, at din partner er der, uden at du behøver at spørge, er det mest trygge i verden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlichkeit ist alles. Zu wissen, dass jemand da ist, ohne dass du fragen musst, gibt dir mehr Halt als alles andere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αξιοπιστία είναι τα πάντα. Το να ξέρεις ότι θα είναι εκεί χωρίς να χρειαστεί να το ζητήσεις είναι ό,τι πιο σταθερό υπάρχει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ti, poder contar con tu pareja lo es todo. Saber que estará ahí sin tener que pedirlo es lo que más paz te da en el mundo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaldusväärsus on kõik. Teadmine, et ta on olemas ka palumata, annab sulle maailmas kõige rohkem kindlustunnet."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fidagarritasuna da dena. Eskatu beharrik gabe hor egongo dela jakitea da munduan lasaitasunik handiena ematen dizuna."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابل اعتماد بودن برایت همه چیز است. اینکه بدانی بی‌آنکه بخواهی کنارت خواهد بود، آرام‌بخش‌ترین چیز دنیاست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luotettavuus on kaikki kaikessa. Tieto siitä, että toinen on tukenasi pyytämättä, on maailman rauhoittavin asia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagiging maaasahan ang lahat. Wala nang mas nakapagpapanatag kaysa malamang nandiyan siya nang hindi mo na kailangang hilingin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilité, c'est essentiel pour toi. Savoir que l'autre sera là sans avoir à demander, rien ne te rassure davantage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iontaofacht thar gach rud. Fios a bheith agat go mbeidh do pháirtí ann gan iarraidh — níl aon rud is mó a chuireann ar do bhonnaí thú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiabilidade éo todo. Saber que estará aí sen ter que pedilo é o que máis seguridade che dá no mundo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ભરોસો જ સર્વસ્વ છે. પૂછ્યા વગર પણ તેઓ ત્યાં હશે, એ જાણવું દુનિયામાં સૌથી વધુ સ્થિરતા આપે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dogaro shi ne komai. Sanin cewa za a kasance tare da ku ba tare da kun nema ba shi ne abu mafi kwantar da hankali a duniya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמינות היא הכול. לדעת שמישהו יהיה שם בלי שצריך לבקש — אין דבר שמקרקע יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भरोसेमंद होना ही सब कुछ है। यह जानना कि बिना माँगे पार्टनर साथ होंगे, दुनिया का सबसे बड़ा सुकून है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost je sve. Znati da će netko biti tu i bez pitanja – ništa te ne prizemljuje više od toga."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfyans nan prezans se tout bagay. Lè ou konnen y ap la san ou pa bezwen mande, sa ba ou yon estabilite san parèy."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megbízhatóság mindent visz. Tudni, hogy a párod kérés nélkül is ott lesz – ennél nagyobb biztonság nincs a világon."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Վստահելիությունն ամեն ինչ է։ Իմանալը, որ զուգընկերդ կողքիդ կլինի առանց խնդրելու, աշխարհում ամենահանգստացնող բանն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa diandalkan itu segalanya. Tahu dia akan ada tanpa perlu diminta adalah hal paling menenangkan di dunia."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntụkwasị obi bụ ihe niile. Ịma na ọ ga-anọ ya n'arịọghị ya bụ ihe kacha eme ka obi gị dị jụụ n'ụwa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áreiðanleiki er allt. Að vita að makinn þinn verður til staðar án þess að þú þurfir að biðja um það veitir mesta öryggi í heimi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’affidabilità è tutto. Sapere che l’altra persona ci sarà, senza doverlo chiedere, è la cosa più rassicurante del mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できることがすべて。頼まなくてもそばにいてくれるとわかっていることが、何より心を安定させてくれます。"
