        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yn byw yn y presennol. Dwyt ti ddim wedi dy weirio i gynllunio'n bell — neu rwyt ti'n ddigon ifanc i hyn deimlo'n ddamcaniaethol."
