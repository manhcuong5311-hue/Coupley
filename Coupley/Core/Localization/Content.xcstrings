    "Don't ask what's wrong. Just bring something — water, food, a blanket." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moenie vra wat fout is nie. Bring net iets – water, kos, ’n kombers."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምን እንደሆኑ አይጠይቁ። ዝም ብለው የሆነ ነገር ያምጡ — ውሃ፣ ምግብ፣ ብርድ ልብስ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسألوا عمّا به. أحضروا شيئًا فحسب: ماء، طعامًا، غطاءً."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কি হৈছে বুলি নুসুধিব। মাথোঁ কিবা এটা আনি দিয়ক — পানী, খাবলৈ কিবা, এখন কম্বল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nə olduğunu soruşma. Sadəcə nəsə gətir — su, yemək, yorğan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не пытайся, што здарылася. Проста прынясі нешта — ваду, ежу, плед."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не питай какво не е наред. Просто донеси нещо – вода, храна, одеяло."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কী হয়েছে জিজ্ঞেস কোরো না। শুধু কিছু একটা নিয়ে এসো — পানি, খাবার, একটা কম্বল।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pitaj šta nije u redu. Samo donesi nešto – vodu, hranu, ćebe."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No preguntis què passa. Porta-li alguna cosa — aigua, menjar, una manta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neptej se, co se děje. Prostě něco přines – vodu, jídlo, deku."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paid â gofyn beth sy'n bod. Tyrd â rhywbeth — dŵr, bwyd, blanced."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg ikke, hvad der er galt. Kom bare med noget – vand, mad, et tæppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nicht, was los ist. Bring einfach etwas – Wasser, Essen, eine Decke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη ρωτήσεις τι έχει. Απλώς φέρε κάτι — νερό, φαγητό, μια κουβέρτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No preguntes qué pasa. Simplemente llévale algo: agua, comida, una manta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ära küsi, mis lahti on. Lihtsalt too midagi — vett, süüa või tekk."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez galdetu zer gertatzen den. Ekarri zerbait besterik ez: ura, janaria, manta bat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نپرس چه شده. فقط چیزی بیاور — آب، غذا، یک پتو."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä kysy, mikä on vialla. Tuo vain jotain – vettä, ruokaa, viltin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huwag nang itanong kung ano ang problema. Magdala ka lang ng kahit ano — tubig, pagkain, kumot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne demande pas ce qui ne va pas. Apporte simplement quelque chose : de l'eau, à manger, un plaid."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ná fiafraigh cad atá cearr. Tabhair rud éigin leat — uisce, bia, blaincéad."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non preguntes que pasa. Simplemente leva algo: auga, comida, unha manta."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શું થયું એ ન પૂછો. બસ કંઈક લઈ આવો — પાણી, ખાવાનું, ધાબળો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada ku tambayi me ke faruwa. Kawai ku kawo wani abu — ruwa, abinci, bargo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא לשאול מה קרה. פשוט להביא משהו — מים, אוכל, שמיכה."
