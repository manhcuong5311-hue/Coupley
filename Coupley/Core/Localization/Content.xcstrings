    "Paint a picture — the life you'd both be living if things went well." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسموا صورة للحياة التي ستعيشانها معًا لو جرت الأمور على ما يرام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresli to – život, jaký byste spolu vedli, kdyby se všechno dařilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal et billede af det liv, I to ville leve, hvis alt gik godt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Male es dir aus – das Leben, das ihr beide führen würdet, wenn alles gut läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζωγράφισε την εικόνα: τη ζωή που θα ζούσατε οι δυο σας αν όλα πήγαιναν καλά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibújala con palabras: la vida que los dos tendrían si todo saliera bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maalaa kuva siitä elämästä, jota eläisitte, jos kaikki menisi hyvin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilarawan mo — ang buhay na pareho ninyong tatamasahin kung magiging maayos ang lahat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décris la vie que vous mèneriez tous les deux si tout se passait bien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תציירו תמונה — החיים ששניכם הייתם חיים אם הכול היה מסתדר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों में एक तस्वीर खींचें — अगर सब ठीक रहा, तो आप दोनों की ज़िंदगी कैसी होगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fesd le az életet, amit akkor élnétek, ha minden jól alakulna."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangkan — hidup seperti apa yang kalian jalani kalau semuanya berjalan baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a descriverla — la vita che fareste voi due se tutto andasse bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物事がうまくいったとき、ふたりが送っている暮らしを思い描いてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 게 잘 풀렸을 때 두 사람이 함께 살고 있을 모습을 그려 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukiskan gambarannya — kehidupan yang anda berdua jalani jika semuanya berjalan lancar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal et bilde av livet dere to ville levd om alt gikk bra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schets het eens: het leven dat jullie samen zouden leiden als alles goed uitpakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namaluj ten obraz – wasze wspólne życie, gdyby wszystko się ułożyło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
