            "value" : "Kwuo ihe ị hụrụ: ‘O yiri ka taa dị arọ.’"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segðu hvað þú sérð: „Mér sýnist dagurinn hafa verið þungur.“"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ ciò che vedi: «Sembra che oggi sia stata una giornata pesante»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今日はしんどい一日だったみたいだね」と、見えたままを言葉にしましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapna apa sing panjenengan deleng: “Kayane dina iki abot ya.”"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვი, რასაც ხედავ: „როგორც ჩანს, დღეს მძიმე დღე იყო“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көргеніңді айт: «Бүгін ауыр күн болған сияқты»."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "និយាយពីអ្វីដែលអ្នកឃើញ៖ “មើលទៅថ្ងៃនេះធ្ងន់ធ្ងរណាស់។”"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಕಾಣುತ್ತಿರುವುದನ್ನು ಹೇಳಿ: “ಇವತ್ತು ತುಂಬಾ ಭಾರದ ದಿನ ಆಗಿದೆ ಅನಿಸುತ್ತೆ.”"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보이는 대로 말해 주세요. “오늘 많이 무거운 하루였나 봐요.”"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiştê ku dibînî bi nav bike: “wisa xuya ye ku îro roj giran bû.”"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көргөнүңдү айт: «бүгүн оор күн болгон окшойт»."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, wat s de gesäis: „Et gesäit aus, wéi wann haut e schwéieren Dag gewiescht wier.“"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບອກສິ່ງທີ່ເຈົ້າເຫັນ: “ເບິ່ງຄືມື້ນີ້ໜັກແທ້ເນາະ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvardyk, ką matai: „atrodo, šiandien buvo sunki diena“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosauc to, ko redzi: ‚izskatās, ka šodien bija smaga diena’."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lazao izay hitanao: “toa navesatra ny andro anio.”"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whakahuatia tāu e kite ana: “te āhua nei he rā taumaha tēnei.”"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажи што гледаш: „Изгледа денес ти беше тежок ден“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കാണുന്നത് പറയൂ: “ഇന്ന് ഭാരമുള്ള ഒരു ദിവസമായിരുന്നെന്ന് തോന്നുന്നു.”"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Харж буйгаа хэлээрэй: «өнөөдөр хүнд өдөр байсан бололтой»."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला जे दिसते ते शब्दांत मांडा: “आजचा दिवस जड गेलेला दिसतोय.”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebut apa yang anda nampak: “nampaknya hari ini berat untuk anda.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi dak li qed tara: “jidher li llum kienet ġurnata tqila.”"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မြင်တာကို ပြောပါ: “ဒီနေ့ လေးလံခဲ့ပုံရတယ်နော်။”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hva du ser: «Det ser ut som i dag har vært tungt.»"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखेको कुरा भन्नुहोस्: ‘आजको दिन भारी रहेछ जस्तो छ।’"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benoem wat je ziet: “Zo te zien was het een zware dag.”"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tchulani zomwe mukuona: “zikuoneka kuti lero lakhala lolemera.”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan argitu himi: “har'a guyyaan ulfaataa ture fakkaata.”"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାହା ଦେଖୁଛନ୍ତି ତାହା କୁହନ୍ତୁ: “ଲାଗୁଛି ଆଜି ଦିନଟା ଭାରି ଥିଲା।”"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੋ ਦਿਸਦਾ ਹੈ, ਉਹ ਕਹੋ: “ਲੱਗਦਾ ਹੈ ਅੱਜ ਦਾ ਦਿਨ ਭਾਰੀ ਰਿਹਾ।”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij to, co widzisz: „Wygląda na to, że dzisiaj był ciężki dzień”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هغه څه ووایئ چې ګورئ یې: «داسې ښکاري چې نن ورځ درنه وه.»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga o que você percebe: “parece que hoje foi um dia pesado”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz o que vês: «parece que hoje foi um dia pesado.»"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune ce vezi: „pare că azi a fost o zi grea”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назови то, что видишь: «Похоже, день сегодня тяжёлый»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuga ibyo ubona: “bisa n'aho uyu munsi wagukomereye.”"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ දකින දේ කියන්න: “අද දවස ටිකක් බරයි වගේ.”"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomenuj, čo vidíš: „Vyzerá to, že dnešok bol ťažký.“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poimenuj, kar vidiš: „Videti je, da je današnji dan težak.“"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taura zvaunoona: ‘zvinoita sekuti nhasi kwanga kwakaremera.’"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheeg waxa aad aragto: “waxay u egtahay in maanta ay culus ahayd”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuaj atë që sheh: „Duket se dita sot ka qenë e rëndë.“"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Именуј оно што видиш: „изгледа да је данас био тежак дан“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebatkeun naon anu katingali: “katingalina dinten ieu beurat nya.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg vad du ser: ”Det verkar ha varit en tung dag.”"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taja unachokiona: “inaonekana leo imekuwa siku nzito.”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் பார்ப்பதைச் சொல்லுங்கள்: “இன்று கொஞ்சம் கனமான நாளாக இருந்தது போலிருக்கிறதே.”"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు కనిపించేది చెప్పండి: “ఈరోజు చాలా భారంగా గడిచినట్లుంది.”"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он чиро, ки мебинӣ, бигӯ: «Мисле ки имрӯз вазнин гузашт»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดสิ่งที่คุณเห็น: “ดูเหมือนวันนี้จะหนักนะ”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝረኣኹምዎ ግለጹ፦ «ሎሚ ከቢድ መዓልቲ ዝነበረ ይመስል።»"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görýän zadyňy aýt: “Şu gün agyr geçen ýaly.”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gördüğünü söyle: “Bugün ağır bir gün olmuş gibi.”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назви те, що бачиш: «Схоже, сьогодні був важкий день»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو دکھ رہا ہے، کہہ دیں: “لگتا ہے آج کا دن بھاری تھا۔”"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koʻrganingizni ayting: «bugun ogʻir kun boʻlganga oʻxshaydi»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói ra điều bạn thấy: “hình như hôm nay nặng nề quá nhỉ.”"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yithi oko ukubonayo: “Kubonakala ngathi namhlanje bekunzima.”"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ sọ ohun tí ẹ rí: “ó dà bí pé òní ti wúwo.”"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出你看到的：「今日好像很沉重。」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出你看到的：“看起来今天挺沉重的。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出你看到的：「今天好像過得很沉重。」"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sho lokho okubonayo: “kubukeka sengathi namuhla bekunzima.”"
          }
        }
      }
    },
