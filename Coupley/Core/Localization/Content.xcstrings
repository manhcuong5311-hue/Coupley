        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýoldaky wagty täze zat öwrenmek ýa-da hekaýa diňlemek üçin ulanýarsyň. Bu netijeli we bilesigelijili garaýyş."
