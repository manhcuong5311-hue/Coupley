    "Match their energy. Send something playful — a voice note, a silly pic." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas by jou maat se energie. Stuur iets speels – ’n stemnota, ’n verspotte foto."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከጉልበታቸው ጋር ይጣጣሙ። ተጫዋች ነገር ይላኩ — የድምፅ መልዕክት፣ አስቂኝ ፎቶ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاروا طاقة شريكك. أرسلوا شيئًا مرحًا: رسالة صوتية أو صورة طريفة."
