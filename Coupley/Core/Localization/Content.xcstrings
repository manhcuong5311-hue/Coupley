    "Communication unlocks worlds. There's probably somewhere you want to go — or someone you want to understand." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواصل يفتح عوالم. على الأرجح هناك مكان تحلم بزيارته، أو شخص يشغلك فهمه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk otevírá celé světy. Nejspíš je někde místo, kam chceš jet – nebo někdo, komu chceš rozumět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprog åbner verdener. Der er nok et sted, du gerne vil hen – eller nogen, du gerne vil forstå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache öffnet Welten. Wahrscheinlich gibt es einen Ort, an den du willst – oder jemanden, den du verstehen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επικοινωνία ανοίγει κόσμους. Μάλλον υπάρχει κάπου που θες να πας — ή κάποιος που θες να καταλάβεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicarte te abre mundos. Seguramente hay un lugar al que quieres ir — o alguien a quien quieres entender."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kieli avaa maailmoja. Luultavasti on jokin paikka, jonne haluat mennä – tai joku, jota haluat ymmärtää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbubukas ng mundo ang komunikasyon. Malamang may lugar kang gustong puntahan — o may taong gusto mong maintindihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communiquer ouvre des mondes. Il y a sûrement un endroit où tu veux aller — ou quelqu'un que tu veux comprendre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקשורת פותחת עולמות. כנראה שיש מקום שבא לך להגיע אליו — או מישהו שחשוב לך להבין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बातचीत नई दुनिया के दरवाज़े खोलती है। शायद कोई जगह है जहाँ आपको जाना है — या कोई इंसान, जिसे आपको समझना है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kommunikáció világokat nyit meg. Valószínűleg van egy hely, ahová el akarsz jutni – vagy valaki, akit meg akarsz érteni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi membuka banyak dunia. Mungkin ada tempat yang ingin kamu kunjungi — atau seseorang yang ingin kamu pahami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicare apre mondi. Probabilmente c’è un posto dove vuoi andare — o qualcuno che vuoi capire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉は世界を広げてくれます。きっと行きたい場所か、理解したい誰かがいるのでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소통은 새로운 세상을 열어 줘요. 아마 가 보고 싶은 곳이나 더 이해하고 싶은 누군가가 있을 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi membuka pintu dunia. Mungkin ada tempat yang anda mahu kunjungi — atau seseorang yang anda mahu fahami."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk åpner verdener. Det finnes nok et sted du vil reise til – eller noen du vil forstå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communicatie opent werelden. Er is vast een plek waar je heen wilt – of iemand die je wilt begrijpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język otwiera światy. Pewnie jest miejsce, do którego chcesz pojechać – albo ktoś, kogo chcesz zrozumieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comunicação abre mundos. Deve ter algum lugar aonde você quer ir — ou alguém que você quer entender."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicarea deschide lumi. Probabil există un loc unde vrei să ajungi — sau cineva pe care vrei să-l înțelegi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык открывает целые миры. Наверняка есть место, куда тебе хочется поехать, — или человек, которого хочется понять."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk öppnar världar. Det finns nog ett ställe du vill åka till – eller någon du vill förstå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสื่อสารเปิดประตูสู่โลกใหม่ คุณน่าจะมีที่ไหนสักแห่งที่อยากไป หรือใครสักคนที่อยากเข้าใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İletişim yeni dünyaların kapısını açar. Muhtemelen gitmek istediğin bir yer ya da anlamak istediğin biri var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спілкування відкриває світи. Мабуть, є місце, куди тобі хочеться поїхати, — або людина, яку хочеться зрозуміти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao tiếp mở ra cả thế giới. Chắc có nơi nào đó bạn muốn đến — hoặc ai đó bạn muốn hiểu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沟通能打开新世界。也许有个你想去的地方，或者有个你想读懂的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溝通能打開新世界。你大概有個想去的地方，或想更了解的人。"
          }
        }
      }
    },
