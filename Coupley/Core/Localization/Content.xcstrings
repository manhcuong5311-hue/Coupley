        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu butuh penyelesaian lewat kata-kata. Pertengkaran belum selesai sampai kedua pihak sama-sama diakui."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị chọrọ ka okwu mechie ya. Esemokwu ahụ agwụbeghị ruo mgbe a nabatara akụkụ abụọ ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú þarft að ljúka málinu með orðum. Rifrildinu er ekki lokið fyrr en báðar hliðar hafa fengið viðurkenningu."
