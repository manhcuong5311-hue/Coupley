          "stringUnit" : {
            "state" : "translated",
            "value" : "रोमांच और ख़ुद को नए सिरे से गढ़ना। यह ज़िंदगी का बड़ा क़दम है — यह जानना अच्छा है कि क्या आपके पार्टनर का मन भी उतना ही खुला है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avantura i novi početak. To je velik životni korak – dobro je znati dijeli li voljena osoba tu otvorenost."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanti ak rekòmanse lavi. Se yon gwo chanjman lavi — li bon pou konnen si patnè ou ouvè konsa tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaland és újrakezdés. Ez komoly életváltás – jó tudni, hogy a párod is ennyire nyitott-e rá."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արկած և վերագտնում։ Սա կյանքի մեծ քայլ է, արժե իմանալ՝ զուգընկերդ կիսո՞ւմ է այդ բացությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan dan memulai dari nol. Ini langkah hidup yang besar — ada baiknya cari tahu apakah pasanganmu juga seterbuka itu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njem na ịmalite ọhụrụ. Nke a bụ mgbanwe ndụ buru ibu — ọ bara uru ịmata ma onye gị nwekwara obi ahụ dị njikere."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ævintýri og endursköpun. Þetta er stórt skref í lífinu – gott að vita hvort makinn þinn deilir þessari opnun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avventura e reinvenzione. È una scelta di vita importante — meglio sapere se il tuo partner condivide la stessa apertura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒険と生まれ変わり。人生の大きな決断です。パートナーも同じくらい前向きか、知っておくといいでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan lan miwiti urip anyar. Iki langkah gedhe ing urip — becik dimangerteni apa pasangan panjenengan uga mbukak kaya ngono."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თავგადასავალი და თავიდან დაწყება. ეს ცხოვრების დიდი ნაბიჯია — კარგია იცოდე, იზიარებს თუ არა შენი პარტნიორი ამ ღიაობას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шытырман оқиға мен жаңару. Бұл өмірдегі үлкен қадам, серігің де осыған ашық па, соны білген жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការផ្សងព្រេង និងការចាប់ផ្ដើមខ្លួនឯងសាជាថ្មី។ នេះជាការផ្លាស់ប្ដូរជីវិតដ៏ធំ — គួរដឹងថាដៃគូរបស់អ្នកមានចិត្តបើកចំហដូចគ្នាឬអត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಾಹಸ ಮತ್ತು ಹೊಸ ಬದುಕು. ಇದು ಬದುಕಿನ ದೊಡ್ಡ ನಿರ್ಧಾರ — ನಿಮ್ಮ ಸಂಗಾತಿಗೂ ಅಂಥ ಮುಕ್ತ ಮನಸ್ಸಿದೆಯೇ ಎಂದು ತಿಳಿದಿರುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모험과 새로운 나를 찾는 여정이에요. 인생의 큰 결정이니 연인도 같은 마음인지 알아 두면 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serpêhatî û xwe ji nû ve afirandin. Ev gaveke mezin a jiyanê ye — hêja ye ku tu zanibî eger hevjînê te jî ewqas vekirî ye."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укмуштуу окуя жана өзүңдү кайра ачуу. Бул жашоодогу чоң кадам — сүйгөнүң да ошондой ачык экенин билип алган жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abenteuer an Neiufank. Dat ass e grousse Schrëtt am Liewen — gutt ze wëssen, ob däi Schatz déi Oppenheet deelt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຜະຈົນໄພ ແລະ ການເລີ່ມຕົ້ນຊີວິດໃໝ່ ນີ້ແມ່ນການຕັດສິນໃຈຄັ້ງໃຫຍ່ — ຄວນຮູ້ວ່າຄູ່ຂອງເຈົ້າເປີດໃຈແບບດຽວກັນບໍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuotykiai ir naujas savęs atradimas. Tai didelis gyvenimo žingsnis – verta žinoti, ar tavo antroji pusė irgi tam atvira."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piedzīvojums un jauns sākums. Tas ir liels dzīves solis – vērts zināt, vai tava otrā puse ir tikpat atvērta."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traikefa sy fanavaozana ny tena. Fifindrana lehibe amin'ny fiainana izany — tsara ho fantatra raha manana io fisokafana io koa ny olon-tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mōrearea, he whakahou i a koe anō. He nekenga nui tēnei — he pai kia mōhio mēnā e ōrite ana tō hoa aroha ki tēnei ngākau tuwhera."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авантура и нов почеток. Ова е голем животен чекор — добро е да знаеш дали половинката ја дели таа отвореност."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സാഹസികതയും പുതുജീവിതവും. ഇതൊരു വലിയ ജീവിതമാറ്റമാണ് — പങ്കാളിക്കും ഈ തുറന്ന മനസ്സുണ്ടോ എന്ന് അറിയുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адал явдал, өөрийгөө шинээр бүтээх. Энэ бол амьдралын том алхам — хань чинь ийм нээлттэй эсэхийг мэдэх нь зүйтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साहस आणि नव्याने घडणे. हा आयुष्यातला मोठा निर्णय आहे — जोडीदारालाही असाच मोकळेपणा आहे का, हे जाणून घेण्यासारखे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengembaraan dan membina diri semula. Ini perubahan hidup yang besar — elok tahu jika pasangan anda juga terbuka begitu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avventura u bidu ġdid. Din hija mossa kbira fil-ħajja — ta' min tkun taf jekk intom it-tnejn taqsmux l-istess ftuħ."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စွန့်စားမှုနဲ့ ကိုယ့်ကိုယ်ကို အသစ်ပြန်တည်ဆောက်ခြင်း။ ဒါဟာ ဘဝရဲ့ ကြီးမားတဲ့ ပြောင်းလဲမှုပါ — ချစ်သူမှာလည်း အဲဒီလို ပွင့်လင်းမှု ရှိလားဆိုတာ သိထားသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventyr og nye begynnelser. Det er et stort steg i livet – verdt å vite om partneren din deler den åpenheten."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साहस र नयाँ पहिचान। यो जीवनको ठुलो कदम हो — तपाईंको पार्टनर पनि यत्तिकै खुला हुनुहुन्छ कि भनेर जान्नु राम्रो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avontuur en jezelf opnieuw uitvinden. Dit is een grote stap – goed om te weten of je partner daar net zo open in staat."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulendo ndi kudzipanga mwatsopano. Uku ndi kusintha kwakukulu m'moyo — ndi bwino kudziwa ngati wokondedwa wanu ali wokonzeka monga inu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imala fi of haaromsuu. Kun tarkaanfii jireenyaa guddaa dha — banaa ta'uun kun jaalallee kee keessas yoo jiraate beekuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦୁଃସାହସ ଓ ନିଜକୁ ନୂଆ କରି ଗଢ଼ିବା। ଏହା ଜୀବନର ଏକ ବଡ଼ ପଦକ୍ଷେପ — ଆପଣଙ୍କ ସାଥୀ ବି ସେହି ଖୋଲା ମନ ରଖନ୍ତି କି, ଜାଣିବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਾਹਸ ਅਤੇ ਨਵੀਂ ਪਛਾਣ। ਇਹ ਜ਼ਿੰਦਗੀ ਦਾ ਵੱਡਾ ਕਦਮ ਹੈ — ਜਾਣਨਾ ਚੰਗਾ ਹੈ ਕਿ ਕੀ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਵੀ ਇਸ ਲਈ ਓਨੇ ਹੀ ਤਿਆਰ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przygoda i nowy początek. To poważna życiowa zmiana – warto wiedzieć, czy twoja druga połówka podziela tę otwartość."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماجرا او د ځان بیا جوړول. دا د ژوند لوی ګام دی — ښه ده پوه شئ چې ملګری مو هم دا پرانیستی ذهن لري که نه."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura e reinvenção. É uma grande mudança de vida — vale saber se seu amor tem a mesma abertura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura e reinvenção. É uma grande mudança de vida — vale a pena saber se o teu par partilha essa abertura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventură și reinventare. E o mutare majoră în viață — merită să știi dacă partenerul tău are aceeași deschidere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приключение и новая жизнь. Это большой шаг — стоит узнать, разделяет ли партнёр такую открытость."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibitangaza no kwiyubaka bushya. Iki ni icyemezo gikomeye mu buzima — ni byiza kumenya niba umukunzi wawe yiteguye nkawe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වික්‍රමය සහ අලුතින් පටන් ගැනීම. මේක ජීවිතයේ ලොකු පියවරක් — ඔබේ සහකරුත් ඒ විවෘතභාවය බෙදාගන්නවාද කියලා දැනගන්න වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrodružstvo a nový začiatok. Je to veľký životný krok – oplatí sa vedieť, či tvoja polovička zdieľa túto otvorenosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustolovščina in nov začetek. To je velik življenjski korak – dobro je vedeti, ali tvoj partner deli to odprtost."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushinga nekuzvigadzira patsva. Iri idanho guru rehupenyu — zvakakodzera kuziva kana mudiwa wako akavhurika saiwe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tacabur iyo is-cusboonaysiin. Tani waa tallaabo nololeed oo weyn — waa mudan tahay in la ogaado haddii lammaanahaagu la wadaago furfurnaantaas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventurë dhe rinisje. Ky është një hap i madh në jetë – ia vlen ta dish nëse partneri yt e ndan këtë hapje."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авантура и нови почетак. Ово је велики животни корак — вреди знати да ли твоја половина дели ту отвореност."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan sareng ngamimitian deui ti enol. Ieu léngkah hirup anu ageung; saé terang naha pasangan anjeun ogé kabuka kana éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äventyr och nystart. Det är ett stort livsbeslut – bra att veta om din partner delar den öppenheten."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matukio na kujianzisha upya. Huu ni uamuzi mkubwa wa maisha — inafaa kujua kama mwenzi wako ana uwazi huo pia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாகசமும் புதிய அவதாரமும். இது வாழ்க்கையின் பெரிய நகர்வு — உங்கள் துணைக்கும் அதே திறந்த மனம் இருக்கிறதா என்று தெரிந்துகொள்வது நல்லது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సాహసం, కొత్తగా మలచుకోవడం. ఇది జీవితంలో పెద్ద అడుగు — మీ భాగస్వామికీ అదే ఆసక్తి ఉందో లేదో తెలుసుకోవడం మంచిది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моҷаро ва аз нав сохтани худ. Ин қадами бузурги зиндагист — хуб аст донӣ, ки оё ёрат ҳам ба ин кушода аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การผจญภัยและการเริ่มต้นตัวตนใหม่ นี่คือการเปลี่ยนชีวิตครั้งใหญ่ ควรรู้ว่าคนรักเปิดใจแบบเดียวกันหรือเปล่า"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጀብዱን ርእሰ-ምሕዳስን። እዚ ዓቢ ስጉምቲ ህይወት እዩ — መጻምድኹም ነዚ ክፉትነት እንተተኻፈለ ምፍላጥ ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başdan geçirme we özüňi täzeden açmak. Bu durmuşda uly ädim — söýgüliňiň şol açyklygy paýlaşýandygyny bilmek gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macera ve yeniden başlamak. Bu hayatında büyük bir adım; partnerinin de bu açıklığı paylaşıp paylaşmadığını bilmeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригоди й нове життя. Це великий крок — варто знати, чи поділяє половинка таку відкритість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مہم جوئی اور خود کو نئے سرے سے بنانا۔ یہ زندگی کا بڑا قدم ہے، یہ جاننا اچھا ہے کہ کیا آپ کے ساتھی میں بھی یہی کھلا پن ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarguzasht va oʻzini qayta kashf etish. Bu hayotdagi katta qadam — sherigingiz ham bunga ochiqmi, bilib olishga arziydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiêu lưu và làm mới bản thân. Đây là bước ngoặt lớn — nên biết liệu người ấy có cùng sự cởi mở đó không."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhambo nokuziqalisa ngokutsha. Eli linyathelo elikhulu ebomini — kufanelekile ukwazi ukuba iqabane lakho nalo livulekile ngolo hlobo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn akíkanjú àti àtúnbẹ̀rẹ̀. Ìgbésẹ̀ ńlá nínú ayé ni èyí — ó dára láti mọ̀ bóyá olólùfẹ́ yín ní ọkàn ṣíṣí bẹ́ẹ̀ náà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒險與重塑自己。這是人生的重大決定，值得了解另一半是否同樣開放。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒险与重塑自我。这是人生中的大变动，值得了解另一半是否也有这份开放的心态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒險與重新出發。這是人生的重大轉變，值得確認另一半是否一樣願意。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzidela nokuziqamba kabusha. Lokhu kuwushintsho olukhulu empilweni — kuhle ukwazi uma umlingani wakho enalokho kuvuleka."
          }
        }
      }
    },
    "Adventure over agenda. You trust that it'll work out — and it usually does. A planner partner might need some reassurance." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avontuur bo agenda. Jy vertrou dit sal uitwerk – en gewoonlik doen dit. ’n Maat wat graag beplan, het dalk ’n bietjie gerusstelling nodig."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከፕሮግራም ጀብዱ። እንደሚሳካ ያምናሉ — ብዙ ጊዜም ይሳካል። የሚያቅዱ አጋር ትንሽ ማረጋገጫ ሊያስፈልጋቸው ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المغامرة قبل الجدول. تثقون بأن الأمور ستسير على ما يرام، وهي كذلك عادةً. قد يحتاج شريك يحب التخطيط إلى بعض الطمأنة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সূচীতকৈ অভিযান। সকলো ঠিক হৈ যাব বুলি আপুনি বিশ্বাস কৰে — আৰু সাধাৰণতে হয়ো। পৰিকল্পনা কৰা সংগীক অলপ আশ্বাস লাগিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plandan çox macəra. Hər şeyin yoluna düşəcəyinə inanırsan — adətən də düşür. Planlamağı sevən partnyor bir az arxayınlaşdırılmağa ehtiyac duya bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прыгода важнейшая за праграму. Ты верыш, што ўсё складзецца, — і звычайна так і ёсць. Палавінцы-планавальніку можа спатрэбіцца крыху суцяшэння."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приключение пред програма. Вярваш, че всичко ще се нареди – и обикновено се нарежда. Половинка, която обича да планира, може да има нужда от малко успокоение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সূচির চেয়ে অ্যাডভেঞ্চার। তুমি ভরসা রাখো সব ঠিক হয়ে যাবে — আর সাধারণত হয়ও। পরিকল্পনা করতে ভালোবাসে এমন পার্টনারের হয়তো একটু আশ্বাস দরকার।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avantura prije rasporeda. Vjeruješ da će se sve posložiti – i obično se posloži. Voljenoj osobi koja voli planove možda treba malo umirivanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura per sobre d'agenda. Confies que tot sortirà bé — i normalment surt. Una parella planificadora pot necessitar que la tranquil·litzis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrodružství před programem. Věříš, že to nějak dopadne – a obvykle to tak je. Protějšek, který rád plánuje, může potřebovat trochu ujištění."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antur yn hytrach nag amserlen. Rwyt ti'n ymddiried y bydd pethau'n gweithio allan — ac fel arfer maen nhw. Efallai y bydd angen ychydig o sicrwydd ar bartner sy'n hoffi cynllunio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventyr frem for dagsorden. Du stoler på, at det nok skal gå – og det gør det som regel. En partner, der elsker planer, kan have brug for lidt beroligelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abenteuer statt Ablaufplan. Du vertraust darauf, dass es klappt – und meistens tut es das. Wer gern plant, braucht vielleicht etwas Rückversicherung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιπέτεια αντί για πρόγραμμα. Εμπιστεύεσαι ότι όλα θα πάνε καλά — και συνήθως πάνε. Ένα ταίρι που θέλει σχέδιο ίσως χρειαστεί λίγη διαβεβαίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura antes que agenda. Confías en que todo saldrá bien, y casi siempre sale. Una pareja más planificadora puede necesitar que le des algo de seguridad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiklus enne päevakava. Sa usaldad, et kõik laabub — ja tavaliselt laabubki. Planeerijast partner võib vajada pisut kinnitust."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abentura, egitaraua baino gehiago. Ondo aterako dela uste duzu — eta normalean hala da. Planifikatzaile den bikotekide batek lasaitasun pixka bat behar izan dezake."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماجراجویی مهم‌تر از برنامه. اعتماد داری که درست می‌شود — و معمولاً هم می‌شود. پارتنری که اهل برنامه است شاید کمی اطمینان‌خاطر لازم داشته باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seikkailu ennen aikataulua. Luotat siihen, että kaikki järjestyy – ja yleensä niin käykin. Suunnitelmallinen kumppani saattaa kaivata vähän rauhoittelua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adventure kaysa agenda. Tiwala kang magiging maayos ang lahat — at kadalasan, oo. Baka kailangan ng kaunting kapanatagan ng partner na mahilig magplano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aventure plutôt que le programme. Tu pars du principe que ça va s'arranger, et c'est souvent le cas. Une personne qui aime tout planifier aura peut-être besoin d'être un peu rassurée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eachtra thar chlár oibre. Tá muinín agat go n-oibreoidh sé amach — agus is gnách go n-oibríonn. B'fhéidir go mbeadh roinnt suaimhnis ag teastáil ó pháirtí a phleanálann."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura mellor ca axenda. Confías en que todo sairá ben, e normalmente sae. Unha parella planificadora pode precisar algo de tranquilidade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કાર્યક્રમ કરતાં સાહસ. તમને ભરોસો છે કે બધું ગોઠવાઈ જશે — અને સામાન્ય રીતે ગોઠવાઈ પણ જાય છે. પ્લાનિંગ કરતા પાર્ટનરને થોડી હૈયાધારણની જરૂર પડી શકે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasada ta fi jadawali. Kun yarda cewa komai zai daidaita — kuma yawanci haka ne. Abokin zama mai son tsari zai iya buƙatar ɗan kwantar da hankali."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרפתקה על פני לו״ז. יש לך אמון שהכול יסתדר — ובדרך כלל זה באמת מסתדר. מי שאוהב לתכנן אולי יצטרך קצת הרגעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंडे से बढ़कर रोमांच। आपको भरोसा है कि सब ठीक हो जाएगा — और अक्सर होता भी है। प्लान करने वाले पार्टनर को थोड़ा भरोसा दिलाना पड़ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avantura ispred plana. Vjeruješ da će se sve posložiti – i obično se posloži. Voljenoj osobi koja voli planirati možda će trebati malo umirivanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanti pase pwogram. Ou gen konfyans tout bagay ap regle — e souvan se sa ki rive. Yon patnè ki renmen planifye ka bezwen ou rasire l."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaland a napirend helyett. Bízol benne, hogy minden megoldódik – és általában meg is. Ha a párod szeret tervezni, neki kellhet némi megnyugtatás."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արկածը՝ ծրագրից առաջ։ Վստահ ես, որ ամեն ինչ լավ կլինի — և սովորաբար այդպես էլ լինում է։ Պլանավորող զուգընկերոջը գուցե մի քիչ հանգստացնել պետք լինի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan di atas agenda. Kamu yakin semuanya akan beres — dan biasanya memang begitu. Pasangan yang suka merencanakan mungkin butuh sedikit diyakinkan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe egwu karịa usoro. I kwenyere na ọ ga-adị mma — ọ na-adịkwa mma. Onye gị nke na-ahazi ihe nwere ike ịchọ nkasi obi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ævintýri fram yfir dagskrá. Þú treystir því að þetta reddist – og það gerir það yfirleitt. Skipulagður maki gæti þurft smá fullvissu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avventura prima del programma. Ti fidi che andrà tutto bene — e di solito è così. Un partner che ama pianificare potrebbe aver bisogno di qualche rassicurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定より冒険。なんとかなると信じていて、実際たいていなんとかなります。計画派のパートナーには、少し安心させてあげる必要があるかもしれません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan luwih saka jadwal. Panjenengan percaya kabeh bakal lancar — lan biasane pancen lancar. Pasangan sing seneng nata rencana bisa uga butuh diayem-ayemi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თავგადასავალი განრიგზე მეტია. გჯერა, რომ ყველაფერი აეწყობა — და ხშირად ასეც ხდება. პარტნიორს, რომელსაც დაგეგმვა უყვარს, შეიძლება დამშვიდება სჭირდებოდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кестеден гөрі шытырман оқиға. Бәрі реттеледі деп сенесің — әдетте солай болады да. Жоспарлағыш серігіңді аздап жұбату керек болар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្សងព្រេងលើសកម្មវិធី។ អ្នកជឿថាអ្វីៗនឹងល្អ — ហើយជាធម្មតាវាល្អមែន។ ដៃគូដែលចូលចិត្តរៀបគម្រោង អាចត្រូវការការធានាខ្លះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಾರ್ಯಸೂಚಿಗಿಂತ ಸಾಹಸ. ಎಲ್ಲವೂ ಸರಿಹೋಗುತ್ತದೆ ಎಂದು ನೀವು ನಂಬುತ್ತೀರಿ — ಸಾಮಾನ್ಯವಾಗಿ ಹಾಗೆಯೇ ಆಗುತ್ತದೆ. ಯೋಜಿಸುವ ಸಂಗಾತಿಗೆ ಸ್ವಲ್ಪ ಭರವಸೆ ಬೇಕಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정보다 모험이에요. 어떻게든 잘 풀릴 거라 믿고, 실제로 대개 그렇죠. 계획형 연인에게는 안심시켜 주는 말이 필요할 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serpêhatî ji bernameyê girîngtir e. Tu bawer dikî ku dê baş biçe — û bi gelemperî diçe. Dibe ku hevjînek ku hez dike plan bike hewceyî hinek piştrastkirinê be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пландан көрө укмуштуу окуя. Баары жайына келет деп ишенесиң — жана көбүнчө ошондой болот. Пландоону жакшы көргөн сүйгөнүңдү бир аз тынчтандыруу керек болушу мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abenteuer virun Agenda. Du vertraus drop, datt et klappt — an dat mécht et meeschtens och. E Schatz, deen alles plangt, brauch vläicht e bësse Berouegung."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຜະຈົນໄພສຳຄັນກວ່າຕາຕະລາງ ເຈົ້າເຊື່ອວ່າມັນຈະອອກມາດີ — ແລະ ມັນກໍມັກອອກມາດີແທ້ ຄູ່ທີ່ມັກວາງແຜນອາດຕ້ອງການຄວາມອຸ່ນໃຈແດ່"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuotykis svarbiau už planą. Tiki, kad viskas susitvarkys – ir paprastai taip būna. Planuoti mėgstančiai antrajai pusei gali prireikti šiek tiek nuraminimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piedzīvojums pār plānu. Tu tici, ka viss sanāks, – un parasti sanāk. Otrajai pusei, kas mīl plānot, var vajadzēt nedaudz nomierinājuma."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traikefa toy izay fandaharana. Matoky ianao fa hilamina ny zavatra — ary matetika dia milamina tokoa. Mety mila fanomezan-toky kely ny olon-tiana tia mandamina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te mōrearea i mua i te rārangi take. Ka whakawhirinaki koe ka pai ngā mea katoa — ā, he pai tonu te nuinga o te wā. Tērā pea me whakamārie tētahi hoa aroha kaiwhakamahere."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авантура пред агенда. Веруваш дека сè ќе се среди — и обично се среди. На половинка што сака да планира можеби ќе ѝ треба малку уверување."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അജണ്ടയെക്കാൾ സാഹസികത. എല്ലാം ശരിയാകുമെന്ന് നിങ്ങൾ വിശ്വസിക്കുന്നു — മിക്കപ്പോഴും അങ്ങനെതന്നെ സംഭവിക്കും. പ്ലാൻ ചെയ്യുന്ന ഒരു പങ്കാളിക്ക് അൽപം ഉറപ്പ് നൽകേണ്ടിവന്നേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөтөлбөрөөс илүү адал явдал. Чи бүх юм бүтнэ гэдэгт итгэдэг — ихэвчлэн ч бүтдэг. Төлөвлөх дуртай хань жаахан тайвшруулга хэрэгтэй байж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रमापेक्षा साहस. सगळे जुळून येईल यावर तुमचा विश्वास असतो — आणि बहुतेक वेळा येतेही. नियोजन करणाऱ्या जोडीदाराला थोडा धीर द्यावा लागेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengembaraan mengatasi agenda. Anda yakin semuanya akan beres — dan biasanya memang begitu. Pasangan yang suka merancang mungkin perlukan sedikit jaminan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-avventura qabel l-aġenda. Tafda li kollox se jirranġa — u normalment hekk jiġri. Partner li jħobb jippjana jista' jkollu bżonn ftit serħan il-moħħ."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အစီအစဉ်ထက် စွန့်စားမှု။ အဆင်ပြေသွားမှာပါလို့ ယုံတယ် — များသောအားဖြင့်လည်း အဆင်ပြေတယ်။ စီစဉ်တတ်တဲ့ ချစ်သူကတော့ စိတ်ချအောင် ပြောပေးဖို့ လိုနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventyr framfor agenda. Du stoler på at det ordner seg – og det gjør det som regel. En partner som liker å planlegge, kan trenge litt beroligelse."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रमभन्दा साहस। सबै मिलिहाल्छ भन्ने तपाईंलाई विश्वास छ — र प्रायः मिल्छ पनि। योजना बनाउने पार्टनरलाई अलि ढाडस चाहिन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avontuur boven schema. Je vertrouwt erop dat het goedkomt – en meestal is dat ook zo. Een partner die graag plant, heeft misschien wat geruststelling nodig."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zosangalatsa kuposa ndandanda. Mumakhulupirira kuti zonse zidzayenda bwino — ndipo nthawi zambiri zimatero. Wokondedwa wokonda kukonzekera angafunike kutsimikiziridwa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagantaa caalaa jabeenya. Akka milkaa'u amanta — yeroo baay'ees ni milkaa'a. Jaalallee karoorsuu jaallatuuf mirkaneessi xiqqaan barbaachisuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କାର୍ଯ୍ୟସୂଚୀଠୁ ଦୁଃସାହସ ବଡ଼। ଆପଣ ବିଶ୍ୱାସ କରନ୍ତି ସବୁ ଠିକ୍ ହୋଇଯିବ — ଆଉ ସାଧାରଣତଃ ହୁଏ ବି। ଯୋଜନା କରୁଥିବା ସାଥୀଙ୍କୁ ଟିକେ ଆଶ୍ୱାସନା ଦରକାର ହୋଇପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਏਜੰਡੇ ਨਾਲੋਂ ਸਾਹਸ। ਤੁਹਾਨੂੰ ਭਰੋਸਾ ਹੈ ਕਿ ਸਭ ਠੀਕ ਹੋ ਜਾਵੇਗਾ — ਅਤੇ ਅਕਸਰ ਹੋ ਵੀ ਜਾਂਦਾ ਹੈ। ਯੋਜਨਾ ਬਣਾਉਣ ਵਾਲੇ ਪਾਰਟਨਰ ਨੂੰ ਥੋੜ੍ਹਾ ਭਰੋਸਾ ਦਿਵਾਉਣਾ ਪੈ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przygoda ponad grafik. Ufasz, że wszystko się ułoży – i zwykle tak jest. Druga połówka, która lubi planować, może potrzebować trochę otuchy."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماجرا له مهالوېش غوره. تاسو باور لرئ چې کار به جوړ شي — او معمولاً جوړېږي. یو پلان‌خوښه ملګری ښايي یو څه ډاډ ته اړتیا ولري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura mais que roteiro. Você confia que vai dar certo — e geralmente dá. Um amor que gosta de planejar pode precisar de um pouco de segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura acima de agenda. Confias que vai correr bem — e normalmente corre. Um par mais organizado pode precisar de alguma tranquilidade da tua parte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventură, nu program. Ai încredere că totul se va rezolva — și de obicei așa e. Un partener care planifică ar putea avea nevoie să fie liniștit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приключение важнее программы. Ты веришь, что всё сложится, — и обычно так и выходит. Партнёра-планировщика, возможно, придётся немного успокоить."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibitangaza biruta gahunda. Wizera ko bizagenda neza — kandi akenshi biragenda neza. Umukunzi ukunda gutegura ashobora gukenera guhumurizwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැලැස්මට වඩා වික්‍රමය. හැමදේම හරියයි කියලා ඔබ විශ්වාස කරනවා — සාමාන්‍යයෙන් හරියනවාත්. සැලසුම් කරන සහකරුවෙක්ට ටිකක් සහතිකයක් ඕනේ වෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrodružstvo pred programom. Veríš, že to nejako dopadne – a väčšinou to tak aj je. Polovička, ktorá rada plánuje, možno bude potrebovať trochu uistenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustolovščina pred urnikom. Zaupaš, da se bo izšlo – in se običajno tudi. Partner, ki rad načrtuje, bo morda potreboval malo pomiritve."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufamba-famba pane hurongwa. Unovimba kuti zvichafamba zvakanaka — uye kazhinji zvinodaro. Mudiwa anoda kuronga angada kuvimbiswa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tacabbur, ma aha ajande. Waxaad aaminsan tahay inay hagaagi doonto — badanaana way hagaagtaa. Lammaane qorshe jecel ayaa laga yaabaa inuu u baahdo xoogaa kalsooni ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aventura mbi programin. Beson se gjithçka do të rregullohet – dhe zakonisht rregullohet. Një partner që do t’i planifikojë gjërat mund të ketë nevojë për pak siguri."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авантура пре распореда. Верујеш да ће се све средити — и обично се среди. Половини која воли планове можда треба мало умиривања."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petualangan langkung ti agénda. Anjeun percanten sadayana bakal lancar — sareng biasana kitu. Pasangan anu resep ngarencanakeun panginten peryogi sakedik ditenangkeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äventyr före schema. Du litar på att det löser sig – och det gör det oftast. En partner som gillar att planera kan behöva lite extra trygghet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matukio kuliko ratiba. Unaamini mambo yatakwenda sawa — na kwa kawaida huenda sawa. Mwenzi anayependa kupanga anaweza kuhitaji kutulizwa kidogo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டத்தை விட சாகசம். எல்லாம் சரியாக நடக்கும் என்று நம்புகிறீர்கள் — பெரும்பாலும் அப்படியே நடக்கும். திட்டமிடும் துணைக்குச் சிறிது நம்பிக்கை அளிக்க வேண்டியிருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రణాళిక కంటే సాహసం. అంతా సర్దుకుంటుందని మీరు నమ్ముతారు — సాధారణంగా అలాగే జరుగుతుంది. ప్లాన్ చేసే భాగస్వామికి కాస్త భరోసా కావాలేమో."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моҷаро аз барнома болотар. Ту бовар дорӣ, ки ҳама чиз ҳал мешавад — ва одатан мешавад. Ёри нақшакаш шояд каме итминон лозим дошта бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การผจญภัยสำคัญกว่ากำหนดการ คุณเชื่อว่าทุกอย่างจะลงตัว และส่วนใหญ่ก็เป็นอย่างนั้น คนรักสายวางแผนอาจต้องการความมั่นใจบ้าง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ መደብ ጀብዱ። ከም ዝሰርሕ ትኣምኑ — መብዛሕትኡ ግዜ ድማ ይሰርሕ። መዋጠኒ መጻምዲ ገለ ምርግጋጽ የድልዮ ይኸውን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meýilnamadan başdan geçirme öňde. Sen hemme zadyň ýola düşjekdigine ynanýarsyň — köplenç şeýle hem bolýar. Meýilleşdirmegi halaýan söýgüliň birneme ynandyrylmaga mätäç bolmagy mümkin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programdan çok macera. Her şeyin yoluna gireceğine güveniyorsun ve genelde de giriyor. Planlamacı bir partnerin biraz içinin rahatlatılması gerekebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригоди важливіші за програму. Ти віриш, що все складеться, — і зазвичай так і буває. Половинці, яка любить усе планувати, може знадобитися трохи заспокоєння."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروگرام سے زیادہ مہم جوئی۔ آپ کو بھروسا ہے کہ سب ٹھیک ہو جائے گا — اور عموماً ہو بھی جاتا ہے۔ منصوبہ بندی پسند ساتھی کو شاید کچھ تسلی کی ضرورت ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadvaldan koʻra sarguzasht. Hammasi joyida boʻlishiga ishonasiz — va odatda shunday boʻladi. Rejalashni yoqtiradigan sherikni biroz xotirjam qilish kerak boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiêu lưu hơn lịch trình. Bạn tin mọi chuyện sẽ ổn — và thường là vậy. Nếu người ấy thích lên kế hoạch, có thể người ấy cần được trấn an chút."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhambo ngaphezu kocwangciso. Uyathemba ukuba konke kuya kulunga — kwaye kuhlala kulunga. Iqabane elithanda ukucwangcisa linokufuna ukuqinisekiswa."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrírí ju ètò lọ. Ẹ gbà gbọ́ pé yóò dára — ó sì sábà máa ń dára. Olólùfẹ́ tó fẹ́ràn ètò lè nílò ìfọkànbalẹ̀ díẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒險勝過行程表。你相信一切會順利，而通常也的確如此。愛計劃的另一半可能需要你讓對方安心一點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒险胜过行程。你相信总会有办法——通常也确实如此。爱做计划的另一半可能需要你给点安心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冒險勝過行程表。你相信一切都會順利，通常也真的會。愛規劃的另一半可能需要你多給點安心感。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okwesabekayo kunohlelo. Uyathemba ukuthi kuzolunga — futhi kuvamise ukulunga. Umlingani ohlelayo angadinga ukuqinisekiswa."
          }
        }
      }
    },
    "After I've thought it through" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat ek daaroor gedink het"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በደንብ ካሰብኩበት በኋላ"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد أن أفكر فيه جيدًا"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভালদৰে ভাবি-চিন্তি লোৱাৰ পিছত"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaxşıca düşündükdən sonra"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ўсё абдумаю"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След като го обмисля"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভালো করে ভেবে নেওয়ার পর"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad sve dobro razmislim"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després de pensar-m'ho bé"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až si to promyslím"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar ôl i fi feddwl am y peth"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når jeg har tænkt det igennem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem ich nachgedacht habe"
          }
        },
        "el" : {
          "stringUnit" : {
