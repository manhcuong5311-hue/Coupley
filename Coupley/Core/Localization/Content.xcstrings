        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שגרת ערב חשובה מאוד כשחולקים מיטה ובית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब बिस्तर और घर साझा हो, तो शाम की दिनचर्या बहुत मायने रखती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha közös az ágy és az otthon, sokat számítanak az esti szokások."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutinitas malam sangat penting saat kalian berbagi tempat tidur dan rumah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le abitudini serali contano molto quando si condividono un letto e una casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じベッドと家を共有するなら、夜の過ごし方はとても大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 침대, 한 집을 함께 쓴다면 저녁 루틴이 정말 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutin malam sangat penting apabila anda berkongsi katil dan rumah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kveldsrutiner betyr mye når dere deler seng og hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avondroutines doen er veel toe als je een bed en een huis deelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczorne rytuały mają duże znaczenie, gdy dzielicie łóżko i dom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotinas noturnas importam muito quando se divide a cama e a casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutinele de seară contează mult când împărțiți un pat și o casă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечерние привычки очень важны, когда у вас общие кровать и дом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvällsrutiner betyder mycket när man delar säng och hem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจวัตรยามค่ำสำคัญมากเมื่อใช้เตียงและบ้านร่วมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı yatağı ve evi paylaşırken akşam rutinleri çok önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечірні ритуали дуже важливі, коли у вас спільні ліжко й дім."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thói quen buổi tối rất quan trọng khi hai bạn chung giường, chung nhà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同床共枕、同住一个屋檐下时，晚间习惯很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡同一張床、住同一個家時，睡前習慣很重要。"
          }
        }
      }
    },
    "Every day planned in detail — I research everything" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم مخطط بالتفصيل، أبحث في كل شيء"
          }
        },
        "cs" : {
