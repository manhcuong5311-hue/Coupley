        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សញ្ញាដែលមិនទាមទារអ្វី មិនធ្វើឲ្យថ្មដែលជិតអស់ កាន់តែអស់ទេ។"
