          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកអាចចូលរួមកម្មវិធីសង្គមបាន ប៉ុន្តែត្រូវចំណាយកម្លាំង។ ពេលសម្រាកបន្ទាប់ពីជួបជុំ គឺជារឿងពិតសម្រាប់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಬೆರೆಯಬಲ್ಲಿರಿ, ಆದರೆ ಅದಕ್ಕೆ ಬೆಲೆ ತೆರುತ್ತೀರಿ. ಸಮಾರಂಭಗಳ ನಂತರ ಚೇತರಿಸಿಕೊಳ್ಳಲು ನಿಮಗೆ ನಿಜವಾಗಿಯೂ ಸಮಯ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사람들과 잘 어울릴 수는 있지만 그만큼 에너지가 들어요. 모임이 끝나면 회복할 시간이 정말 필요하죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dikarî tiştên civakî bikî, lê bedelê wê didî. Wextê vehesînê piştî civînên civakî ji bo te rastîn e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адамдар менен аралаша аласың, бирок ал сага кымбатка турат. Жыйындардан кийин эс алуу сага чындап керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kanns sozial sinn, mee et kascht dech eppes. No Feieren a Sortien brauchs du wierklech Zäit, fir dech z'erhuelen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເຂົ້າສັງຄົມໄດ້ ແຕ່ຕ້ອງເສຍພະລັງ ເວລາພັກຟື້ນຫຼັງງານສັງສັນເປັນສິ່ງຈຳເປັນແທ້ໆ ສຳລັບເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gali bendrauti, bet tai kainuoja. Po susibūrimų tau tikrai reikia laiko atsigauti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vari piedalīties sabiedriskajā dzīvē, bet tas tev maksā. Laiks atgūties pēc pasākumiem tev ir īsta vajadzība."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afaka manao ny zavatra sosialy ianao nefa misy vidiny izany aminao. Tena ilainao ny fotoana fanarenana aorian'ny fihaonana amin'olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka taea e koe ngā mahi pāpori, engari he utu. He mea tūturu ki a koe te wā whakaora i muri i ngā huihuinga pāpori."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можеш да се дружиш, но тоа те чини. Времето за опоравок по дружење за тебе е вистинско."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സാമൂഹിക കാര്യങ്ങൾ നിങ്ങൾക്ക് ചെയ്യാനാകും, പക്ഷേ അതിനൊരു വിലയുണ്ട്. ആളുകൾ കൂടുന്ന പരിപാടികൾക്ക് ശേഷം വീണ്ടെടുക്കാനുള്ള സമയം നിങ്ങൾക്ക് ശരിക്കും വേണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нийгмийн юм хийж чадна, гэхдээ үнэ төлдөг. Арга хэмжээний дараа сэргэх цаг чамд үнэхээр хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही लोकांत मिसळू शकता, पण त्याची किंमत मोजावी लागते. कार्यक्रमांनंतर सावरायला वेळ लागतो, हे तुमच्यासाठी अगदी खरे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh bersosial, tetapi ada harganya. Anda memang perlukan masa untuk pulih selepas acara sosial."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tista' tagħmel l-affarijiet soċjali imma tħallas prezz. Il-ħin biex tirkupra wara l-attivitajiet soċjali huwa reali għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လူမှုရေးတွေ လုပ်နိုင်ပေမဲ့ အဖိုးအခ ပေးရတယ်။ လူစုလူဝေးတွေ ပြီးရင် အနားယူချိန် လိုတာ သင့်အတွက် တကယ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du klarer det sosiale, men det koster. Du trenger virkelig tid til å hente deg inn etter sosiale ting."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं सामाजिक काम गर्न सक्नुहुन्छ, तर त्यसको मूल्य चुकाउनुहुन्छ। भेटघाटपछि थकान मेटाउने समय तपाईंलाई साँच्चै चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt prima sociaal doen, maar het kost je wat. Na een feestje of afspraak heb je echt hersteltijd nodig."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumatha kucheza koma zimakuwonongerani mphamvu. Mumafunikadi nthawi yopuma mukatha kucheza ndi anthu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan hawaasummaa gochuu dandeessa, garuu gatii ni kaffalta. Walga'ii booda yeroon humna deebifachuu siif dhugaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ସାମାଜିକ କାମ କରିପାରନ୍ତି, କିନ୍ତୁ ସେଥିପାଇଁ ମୂଲ୍ୟ ଦିଅନ୍ତି। ସାମାଜିକ କାର୍ଯ୍ୟକ୍ରମ ପରେ ଆପଣଙ୍କୁ ସତରେ ଆରାମ ସମୟ ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਮਿਲਣਾ-ਜੁਲਣਾ ਕਰ ਲੈਂਦੇ ਹੋ, ਪਰ ਉਸ ਦੀ ਕੀਮਤ ਚੁਕਾਉਂਦੇ ਹੋ। ਮਹਿਫ਼ਲਾਂ ਤੋਂ ਬਾਅਦ ਤੁਹਾਨੂੰ ਸੱਚਮੁੱਚ ਸੰਭਲਣ ਲਈ ਸਮਾਂ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajesz radę w towarzystwie, ale to cię kosztuje. Po spotkaniach naprawdę potrzebujesz czasu na regenerację."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ټولنیز کارونه کولای شئ، خو بیه یې ورکوئ. د ټولنیزو پېښو وروسته د آرام وخت ستاسو لپاره رښتینی دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você dá conta da vida social, mas isso tem um custo. O tempo para se recuperar depois de um evento é real para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consegues fazer a parte social, mas tem um custo. Para ti, o tempo de recuperação depois de eventos sociais é real."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți face față momentelor sociale, dar te costă. Ai cu adevărat nevoie de timp de refacere după ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общаться ты умеешь, но это стоит тебе сил. После встреч тебе правда нужно время, чтобы восстановиться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushobora gusabana ariko bigutwara imbaraga. Igihe cyo kuruhuka nyuma y'ibirori ni ngombwa kuri wowe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සමාජ දේවල් කරන්න ඔබට පුළුවන්, ඒත් ඒකට මිලක් ගෙවනවා. සමාජ අවස්ථාවලින් පස්සේ යළි ප්‍රකෘති වෙන්න කාලයක් ඕනේ වීම ඔබට ඇත්ත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoločenské veci zvládneš, ale niečo ťa to stojí. Čas na zotavenie po spoločenských akciách potrebuješ naozaj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Družabne stvari zmoreš, a te stanejo. Po druženju res potrebuješ čas za okrevanje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unogona kuita zvekushamwaridzana asi zvinokudhura. Nguva yekuzorora mushure memisangano yevanhu inokosha chaizvo kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxyaabaha bulshada waad samayn kartaa, balse qiimo ayaad ka bixisaa. Waqtiga aad ku soo kabato kadib kulammada bulshada ayaa kuu ah wax dhab ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mund t’i bësh gjërat shoqërore, por ke një çmim për to. Koha për t’u rikuperuar pas eventeve është reale për ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можеш да се дружиш, али то има цену. Време за опоравак после друштвених догађаја ти је заиста потребно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun tiasa gaul, tapi aya hargana. Pikeun anjeun, peryogi waktos pikeun pulih saparantos acara sosial."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du klarar det sociala, men det kostar. Att du behöver återhämta dig efter sociala tillställningar är helt på riktigt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaweza kujumuika lakini unalipa gharama. Kwako, muda wa kupumzika baada ya shughuli za kijamii ni hitaji halisi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமூக நிகழ்வுகளில் கலந்துகொள்ள முடியும், ஆனால் அதற்கு விலை கொடுக்கிறீர்கள். நிகழ்வுகளுக்குப் பிறகு மீண்டு வர உங்களுக்கு உண்மையில் நேரம் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు నలుగురిలో కలవగలరు, కానీ దానికి మూల్యం చెల్లిస్తారు. ఏదైనా కార్యక్రమం తర్వాత తేరుకునే సమయం మీకు నిజంగా అవసరం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту метавонӣ дар маҳфилҳо бошӣ, вале барояш нарх медиҳӣ. Пас аз базмҳо вақти барқароршавӣ барои ту воқеан лозим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเข้าสังคมได้ แต่ต้องแลกด้วยพลังงาน เวลาพักฟื้นหลังงานสังสรรค์เป็นเรื่องจริงสำหรับคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማሕበራዊ ነገራት ክትገብሩ ትኽእሉ ኢኹም፣ ግን ዋጋ ትኸፍሉ። ድሕሪ ማሕበራዊ ኣጋጣሚታት ናይ ዕረፍቲ ግዜ ንዓኹም ናይ ሓቂ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adamlar bilen bolup bilýärsiň, ýöne munuň bahasy bar. Ýygnanyşyklardan soň dynç almak seniň üçin hakyky zerurlyk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosyal şeyleri yapabiliyorsun ama bunun bir bedeli var. Etkinliklerden sonra toparlanma süresi senin için gerçek bir ihtiyaç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти можеш бути в компанії, але це має свою ціну. Після тусовок тобі справді потрібен час на відновлення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میل جول ممکن تو ہے، مگر اس کی قیمت چکانی پڑتی ہے۔ محفلوں کے بعد سنبھلنے کا وقت آپ کے لیے حقیقی ضرورت ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ijtimoiy tadbirlarda qatnasha olasiz, lekin buning bahosini toʻlaysiz. Tadbirlardan keyin tiklanish vaqti siz uchun haqiqiy ehtiyoj."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn làm được những việc xã giao nhưng phải trả giá. Sau mỗi buổi gặp gỡ, bạn thật sự cần thời gian hồi sức."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakwazi ukwenza izinto zentlalo kodwa kuyakudla. Ixesha lokuchacha emva kwemisitho yentlalo liyinyani kuwe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ lè ṣe àwọn nǹkan àjọṣe, ṣùgbọ́n ó ń ná yín ní nǹkan. Àkókò ìsinmi lẹ́yìn àpèjọ jẹ́ ohun gidi fún yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "社交你做得到，但要付出代價。社交活動後，你真的需要時間回復。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "社交你做得到，但要付出代价。社交活动后，你确实需要时间恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "社交的事你做得到，但需要付出代價。社交活動後，你真的需要時間恢復。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakwazi ukwenza izinto zokuhlalisana kodwa kukudla amandla. Isikhathi sokululama emva kwemicimbi singokoqobo kuwe."
          }
        }
      }
    },
    "You communicate indirectly, hoping they'll pick up on it. Worth asking: would you prefer they just asked you directly?" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy kommunikeer indirek en hoop jou maat tel dit op. Die moeite werd om te vra: sou jy verkies dat jou maat jou eerder reguit vra?"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በተዘዋዋሪ ይገልጻሉ፣ አጋርዎ ይረዱታል ብለው ተስፋ በማድረግ። መጠየቅ ያለበት ጥያቄ፦ በቀጥታ ቢጠይቁዎት ይመርጡ ይሆን?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتواصلون بشكل غير مباشر على أمل أن يلتقط شريكك الإشارة. سؤال يستحق التفكير: هل تفضّلون أن يسألكم مباشرة؟"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি পোনপটীয়াকৈ নকৈ ইংগিতেৰে কয়, আশা কৰে সংগীয়ে ধৰিব। নিজকে সুধি চাওক: সংগীয়ে পোনপটীয়াকৈ সুধিলেই আপুনি বেছি ভাল পাব নেকি?"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolayısı ilə danışırsan və onun başa düşəcəyinə ümid edirsən. Özünə sual ver: bəlkə onun sadəcə birbaşa soruşmasını istərdin?"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты гаворыш намёкамі і спадзяешся, што палавінка зразумее. Варта спытаць сябе: можа, лепш, каб яна проста спытала прама?"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общуваш непряко и се надяваш половинката ти да схване. Струва си да се запиташ: не би ли било по-добре просто да те попита директно?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি ঘুরিয়ে বোঝাও, আশা করো ও ধরে ফেলবে। একবার ভেবে দেখো: ও সরাসরি জিজ্ঞেস করলে কি তোমার বেশি ভালো লাগত?"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komuniciraš indirektno i nadaš se da će voljena osoba shvatiti. Vrijedi se zapitati: da li bi radije da te jednostavno direktno pita?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et comuniques de manera indirecta, esperant que la teva parella ho capti. Val la pena preguntar-te: preferiries que t'ho preguntés directament?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikuješ nepřímo a doufáš, že to druhá strana pochytí. Stojí za otázku: nebylo by ti milejší, kdyby se tě prostě zeptala přímo?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n cyfathrebu'n anuniongyrchol, gan obeithio y bydd dy bartner yn sylwi. Mae'n werth gofyn: fyddai'n well gen ti petai dy bartner yn gofyn i ti'n uniongyrchol?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunikerer indirekte og håber, at din partner fanger det. Spørg dig selv: Ville du hellere have, at vedkommende bare spurgte dig direkte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunizierst indirekt und hoffst, dass es ankommt. Frag dich mal: Wäre es dir lieber, direkt gefragt zu werden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικοινωνείς έμμεσα, ελπίζοντας ότι θα το καταλάβει. Αξίζει να αναρωτηθείς: θα προτιμούσες να σε ρωτούσε ευθέως;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te comunicas de forma indirecta, con la esperanza de que tu pareja lo capte. Vale la pena preguntarte: ¿preferirías que simplemente te lo preguntara?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa suhtled kaudselt ja loodad, et ta saab aru. Tasub endalt küsida: kas eelistaksid, et ta lihtsalt küsiks sinult otse?"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeharka komunikatzen zara, konturatuko delakoan. Galdetzeko modukoa da: nahiago zenuke zuzenean galdetzea?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غیرمستقیم حرفت را می‌زنی، به این امید که بگیرد. ارزش دارد از خودت بپرسی: ترجیح نمی‌دهی خیلی ساده مستقیم از تو بپرسد؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestit epäsuorasti ja toivot, että toinen tajuaa. Kannattaa miettiä: haluaisitko, että hän vain kysyisi suoraan?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ka diretsong nagsasabi at umaasang mahahalata niya. Tanungin mo ang sarili: mas gusto mo bang diretsahan ka na lang niyang tanungin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu communiques de façon indirecte en espérant que l'autre comprenne. Bonne question à te poser : préférerais-tu qu'on te le demande franchement ?"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déanann tú cumarsáid go hindíreach, ag súil go dtuigfidh do pháirtí. Is fiú fiafraí díot féin: arbh fhearr leat dá gcuirfí an cheist ort go díreach?"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunícaste de forma indirecta, coa esperanza de que o capte. Paga a pena preguntarse: preferirías que cho preguntase directamente?"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે આડકતરી રીતે વાત કરો છો, આશા રાખીને કે તેઓ સમજી જશે. પોતાને પૂછવા જેવું છે: શું તમને ગમશે કે તેઓ સીધું જ તમને પૂછી લે?"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna magana a fakaice, kuna fatan za a fahimta. Ya dace ku tambayi kanku: shin za ku fi so a tambaye ku kai tsaye?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התקשורת שלך עקיפה, מתוך תקווה שהרמז ייקלט. שווה לשאול: אולי עדיף לך שפשוט ישאלו אותך ישירות?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप घुमा-फिराकर बात कहते हैं, इस उम्मीद में कि पार्टनर समझ जाएँ। ख़ुद से पूछकर देखिए: क्या आप चाहेंगे कि वे सीधे आपसे पूछ लें?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komuniciraš neizravno i nadaš se da će to netko uhvatiti. Vrijedi se zapitati: bi li ti bilo draže da te jednostavno izravno pitaju?"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou kominike endirèkteman, ou espere l ap konprann. Kesyon pou poze tèt ou: èske ou ta pito li jis mande ou dirèkteman?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Közvetetten kommunikálsz, abban bízva, hogy a párod veszi a lapot. Érdemes megkérdezni magadtól: nem lenne jobb, ha egyszerűen rákérdezne?"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու խոսում ես անուղղակի՝ հուսալով, որ զուգընկերդ կնկատի։ Արժե ինքդ քեզ հարցնել՝ չէի՞ր նախընտրի, որ նա պարզապես ուղիղ հարցներ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu berkomunikasi secara tidak langsung, berharap dia menangkapnya. Coba tanya diri sendiri: apa kamu lebih suka dia langsung bertanya saja?"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ekwu okwu n'ụzọ na-apụtaghị ìhè, na-atụ anya na ọ ga-aghọta. Ọ bara uru ịjụ: ọ ga-aka mma gị ma ọ jụọ gị ozugbo?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú tjáir þig óbeint og vonar að makinn þinn nemi það. Spurðu þig: myndir þú frekar vilja að makinn spyrði þig bara beint?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunichi in modo indiretto, sperando che l’altra persona colga il segnale. Vale la pena chiederti: preferiresti che te lo chiedesse direttamente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠回しに伝えて、察してほしいタイプです。一度考えてみてください。本当は、はっきり聞いてもらうほうがうれしくありませんか？"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ngomong kanthi ora langsung, ngarep-arep pasangan bisa nangkep. Pantes ditakokake: apa panjenengan luwih seneng yen pasangan langsung takon wae?"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ირიბად ურთიერთობ და იმედოვნებ, რომ მიხვდებიან. ღირს, საკუთარ თავს ჰკითხო: ხომ არ გირჩევნია, პირდაპირ გკითხონ?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен жанама жеткізесің, серігің түсінер деп үміттенесің. Өзіңнен сұрап көр: тікелей сұрағанын қалар ма едің?"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកនិយាយដោយប្រយោល ដោយសង្ឃឹមថាគាត់នឹងយល់។ គួរសួរខ្លួនឯង៖ តើអ្នកចង់ឲ្យគាត់សួរអ្នកត្រង់ៗតែម្ដងឬទេ?"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅವರು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ ಎಂಬ ಆಸೆಯಿಂದ ನೀವು ಪರೋಕ್ಷವಾಗಿ ಹೇಳುತ್ತೀರಿ. ಒಮ್ಮೆ ಯೋಚಿಸಿ: ಅವರು ನೇರವಾಗಿ ಕೇಳಿದರೆ ನಿಮಗೆ ಇಷ್ಟವಾಗುತ್ತದೆಯೇ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌려서 표현하고 연인이 알아채 주길 바라는 편이에요. 한번 생각해 보세요. 사실은 연인이 직접 물어봐 주길 바라는 건 아닌가요?"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nerasterast diaxivî, bi hêviya ku ew ê fêm bike. Hêjayî pirsînê ye: Ma tu tercîh dikî ku ew tenê rasterast ji te bipirse?"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен кыйыр айтасың, ал байкап калар деп үмүттөнөсүң. Өзүңдөн сурап көр: ал жөн эле түз сураса жакшы болмок эмеспи?"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunizéiers indirekt an hoffs, datt däi Schatz et mierkt. Fro dech mol: Wier et dir léiwer, wann däi Schatz dech einfach direkt géif froen?"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າສື່ສານທາງອ້ອມ ຫວັງວ່າຄູ່ຈະຮູ້ເອງ ລອງຖາມຕົວເອງເບິ່ງ: ເຈົ້າຢາກໃຫ້ຄູ່ຖາມເຈົ້າກົງໆບໍ?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendrauji netiesiogiai ir tikiesi, kad užuominą pagaus. Verta savęs paklausti: gal mieliau norėtum, kad tavęs tiesiog paklaustų tiesiai?"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu runā netieši, cerot, ka otrā puse to uztvers. Vērts sev pajautāt: varbūt tev labāk patiktu, ja otrā puse vienkārši pajautātu tieši?"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miresaka ankolaka ianao, manantena fa ho azony. Mendrika hanontaniana: tianao ve raha manontany anao mivantana fotsiny izy?"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka kōrero huna koe, me te tūmanako ka mau i a ia. He pātai pai: he pai ake rānei ki a koe mēnā ka pātai hāngai noa mai ia?"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комуницираш индиректно, со надеж дека половинката ќе сфати. Вреди да се запрашаш: не би било ли подобро таа едноставно директно да те праша?"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പങ്കാളി തിരിച്ചറിയുമെന്ന പ്രതീക്ഷയിൽ നിങ്ങൾ പരോക്ഷമായാണ് കാര്യങ്ങൾ അറിയിക്കുന്നത്. സ്വയം ചോദിച്ചുനോക്കൂ: പങ്കാളി നേരിട്ട് ചോദിക്കുന്നതല്ലേ നിങ്ങൾക്ക് കൂടുതൽ ഇഷ്ടം?"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи шууд бусаар илэрхийлж, хань чинь ойлгоосой гэж найддаг. Өөрөөсөө асуугаад үз: шууд асуувал илүү дээр биш үү?"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोडीदाराच्या लक्षात येईल या आशेने तुम्ही आडवळणाने सांगता. एकदा स्वतःला विचारून पाहा: जोडीदाराने थेट विचारलेले तुम्हाला जास्त आवडेल का?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda berkomunikasi secara tidak langsung, berharap pasangan anda dapat menangkapnya. Cuba tanya diri: adakah anda lebih suka dia terus bertanya?"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikkomunika b'mod indirett, bit-tama li l-messaġġ jasal. Ta' min tistaqsi: tippreferi li l-partner tiegħek sempliċiment jistaqsik b'mod dirett?"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် သွယ်ဝိုက်ပြီး ပြောတတ်တယ်၊ ချစ်သူ ရိပ်မိမယ်လို့ မျှော်လင့်တယ်။ ကိုယ့်ကိုယ်ကို မေးကြည့်သင့်တာက — ချစ်သူက တိုက်ရိုက် မေးပေးတာကို ပိုကြိုက်မလား?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommuniserer indirekte og håper partneren din fanger det opp. Verdt å spørre deg selv: Ville du heller blitt spurt rett ut?"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं घुमाउरो तरिकाले कुरा राख्नुहुन्छ, उहाँले बुझिदिनुहोला भन्ने आशामा। सोच्न लायक प्रश्न: उहाँले सिधै सोधिदिनुभए तपाईंलाई बढी मन पर्थ्यो कि?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je communiceert indirect en hoopt dat je partner het oppikt. Vraag jezelf eens af: zou je liever hebben dat die het je gewoon vroeg?"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumalankhula mosalunjika, kuyembekezera kuti azindikira. Ndi bwino kufunsa: kodi mungakonde kuti angokufunsani mwachindunji?"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kallattiin osoo hin taane mallattoon dubbatta, akka hubatamu abdattee. Of gaafachuun gaarii dha: kallattiin gaafatamuu hin filattuu?"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେମାନେ ବୁଝିନେବେ ଭାବି ଆପଣ ଘୁରାଇ କହନ୍ତି। ନିଜକୁ ପଚାରିବା ଭଲ: ସେମାନେ ସିଧାସଳଖ ପଚାରିଲେ କ'ଣ ଆପଣଙ୍କୁ ଭଲ ଲାଗନ୍ତା?"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਗੱਲ ਘੁਮਾ-ਫਿਰਾ ਕੇ ਕਹਿੰਦੇ ਹੋ, ਇਸ ਉਮੀਦ ਵਿੱਚ ਕਿ ਉਹ ਸਮਝ ਲੈਣਗੇ। ਆਪਣੇ ਆਪ ਤੋਂ ਪੁੱਛਣ ਵਾਲੀ ਗੱਲ: ਕੀ ਤੁਸੀਂ ਚਾਹੋਗੇ ਕਿ ਉਹ ਤੁਹਾਨੂੰ ਸਿੱਧਾ ਹੀ ਪੁੱਛ ਲੈਣ?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikujesz się nie wprost, licząc, że druga połówka się domyśli. Warto się zastanowić: może wolisz, żeby po prostu zapytała wprost?"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په غیر مستقیم ډول خبرې کوئ او هیله لرئ چې ستاسو ملګری به پرې پوه شي. د پوښتنې وړ ده: آیا خوښوئ چې ستاسو ملګری مستقیم له تاسو وپوښتي؟"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se comunica de forma indireta, torcendo para a outra pessoa captar. Vale se perguntar: você não preferiria que seu amor perguntasse direto?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicas de forma indireta, à espera que o teu par perceba. Vale a pena perguntar: preferias que te perguntasse diretamente?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunici indirect, sperând că partenerul tău va prinde ideea. Merită să te întrebi: n-ai prefera să te întrebe direct?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты говоришь намёками и надеешься, что партнёр поймёт. Стоит спросить себя: может, тебе хотелось бы, чтобы тебя просто спросили напрямую?"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvuga mu marenga, wizeye ko azabyumva. Ni byiza kwibaza: ese ntiwahitamo ko yakubaza mu buryo butaziguye?"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ වක්‍රව කතා කරනවා, ඔබේ සහකරු ඒක තේරුම් ගනීවි කියලා බලාපොරොත්තුවෙන්. අහලා බලන්න වටිනවා: ඔවුන් කෙළින්ම ඔබෙන් ඇහුවොත් ඔබ වඩා කැමතිද?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikuješ nepriamo a dúfaš, že to tvoja polovička zachytí. Oplatí sa zamyslieť: nebolo by lepšie, keby sa ťa jednoducho priamo spýtala?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporočaš posredno in upaš, da bo druga stran ujela namig. Vredno se je vprašati: bi ti bilo ljubše, da te kar neposredno vpraša?"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotaura zvisina kunanga, uchitarisira kuti achazviona. Zvakakodzera kuzvibvunza: ungada here kuti angokubvunza zvakananga?"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si dadban ayaad u gudbisaa, adigoo rajaynaya in la dareemo. Isweydii: miyaad door bidi lahayd in si toos ah lagu weydiiyo?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikon tërthorazi, me shpresën se partneri yt do ta kapë. Vlen ta pyesësh veten: a do të preferoje që të të pyeste drejtpërdrejt?"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говориш заобилазно и надаш се да ће твоја половина то прочитати. Вреди се запитати: да ли би ти више одговарало да те само директно пита?"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun nyarios sacara henteu langsung, ngarep-ngarep pasangan nangkep maksadna. Patut ditaroskeun: naha anjeun langkung resep upami anjeunna naros langsung waé?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunicerar indirekt och hoppas att din partner fattar. Värt att fundera på: skulle du hellre vilja få en rak fråga?"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unawasiliana kwa njia isiyo ya moja kwa moja, ukitumaini atang’amua. Jiulize: je, ungependa akuulize moja kwa moja tu?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மறைமுகமாகத் தெரிவித்து, அவர் புரிந்துகொள்வார் என்று நம்புகிறீர்கள். ஒரு கேள்வி: அவர் நேரடியாகவே உங்களிடம் கேட்டால் உங்களுக்குப் பிடிக்குமா?"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వారు అర్థం చేసుకుంటారని ఆశిస్తూ మీరు పరోక్షంగా చెబుతారు. ఒకసారి ఆలోచించండి: వారు నేరుగా అడిగితేనే మీకు బాగుంటుందా?"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ғайримустақим гап мезанӣ ва умед дорӣ, ки ёрат мефаҳмад. Арзиши пурсидан дорад: шояд беҳтар мебуд, ки ёрат рост аз ту пурсад?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสื่อสารทางอ้อมโดยหวังว่าคนรักจะเข้าใจเอง ลองถามตัวเองดู คุณอยากให้คนรักถามตรงๆ มากกว่าไหม"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከስተውዕሉ ተስፋ ጌርኩም ብተዘዋዋሪ ትገልጹ። ክትሓትዎ ዝግባእ — ብቐጥታ እንተ ዝሓቱኹም ምመረጽኩምዶ?"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen gytaklaýyn aýdýarsyň we onuň düşünmegine umyt edýärsiň. Özüňden sora: ol saňa gönüden-göni soran bolsa, gowy bolmazmydy?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolaylı yoldan anlatıyor, partnerinin anlamasını umuyorsun. Kendine sormaya değer: Sana doğrudan sormasını mı tercih ederdin?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти говориш непрямо, сподіваючись, що половинка зрозуміє. Варто спитати себе: може, тобі хотілося б, щоб тебе просто запитали прямо?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انداز بالواسطہ ہے، اس امید پر کہ وہ سمجھ جائیں۔ خود سے پوچھ کر دیکھیں: کیا آپ کو یہ زیادہ اچھا لگے گا کہ وہ سیدھا آپ سے پوچھ لیں؟"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz bilvosita gapirasiz va sherigingiz sezib qolishiga umid qilasiz. Oʻzingizdan soʻrab koʻring: sherigingiz shunchaki toʻgʻridan-toʻgʻri soʻraganini afzal koʻrmaysizmi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn giao tiếp gián tiếp, mong người ấy tự nhận ra. Đáng để tự hỏi: bạn có muốn người ấy cứ hỏi thẳng bạn không?"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthetha ngokungathanga ngqo, unethemba lokuba iqabane lakho liza kuqonda. Kufanelekile ukuzibuza: ngaba ungakhetha ukuba likubuze ngqo?"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń sọ̀rọ̀ lọ́nà àìtààrà, ní ìrètí pé olólùfẹ́ yín yóò mọ̀. Ó yẹ kí ẹ bi ara yín pé: ṣé ẹ ò ní fẹ́ kí ó kàn béèrè lọ́wọ́ yín ní tààrà?"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你習慣間接表達，希望對方能察覺。值得問問自己：你會不會其實更希望對方直接問你？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你习惯含蓄地表达，希望对方能领会。不妨问问自己：你是不是更希望对方直接问你？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你習慣間接表達，希望對方能察覺。值得問問自己：你會不會其實更希望對方直接問你？"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhuluma ngendlela engaqondile, uthemba ukuthi uzokubona. Kufanele uzibuze: ungathanda yini ukuthi akubuze ngqo?"
          }
        }
      }
    },
    "You communicate through action more than words. Just make sure your partner feels secure — not everyone reads actions the same way." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy kommunikeer meer deur dade as deur woorde. Maak net seker jou maat voel veilig – nie almal lees dade op dieselfde manier nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከቃላት ይልቅ በተግባር ይገልጻሉ። ብቻ አጋርዎ ደህንነት እንዲሰማቸው ያረጋግጡ — ሁሉም ሰው ተግባርን በአንድ ዓይነት መንገድ አያነብም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعبّرون بالأفعال أكثر من الكلمات. فقط تأكدوا أن شريكك يشعر بالأمان، فليس الجميع يقرأ الأفعال بالطريقة نفسها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি শব্দতকৈ কামেৰে বেছি প্ৰকাশ কৰে। কেৱল নিশ্চিত কৰক যে আপোনাৰ সংগীয়ে নিৰাপদ অনুভৱ কৰে — সকলোৱে কামক একেদৰে নুবুজে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözdən çox əməllə ünsiyyət qurursan. Sadəcə partnyorunun özünü arxayın hiss etdiyinə əmin ol — hər kəs əməlləri eyni cür oxumur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты выказваеш пачуцці больш справамі, чым словамі. Толькі пераканайся, што палавінка адчувае сябе ўпэўнена — не ўсе чытаюць учынкі аднолькава."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общуваш повече с действия, отколкото с думи. Само се увери, че половинката ти се чувства спокойно – не всеки разчита действията по един и същ начин."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি কথার চেয়ে কাজে বেশি বোঝাও। শুধু খেয়াল রেখো তোমার পার্টনার যেন নিশ্চিন্ত বোধ করে — সবাই কাজের ভাষা একইভাবে পড়ে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više komuniciraš djelima nego riječima. Samo pazi da se voljena osoba osjeća sigurno – ne čitaju svi djela na isti način."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et comuniques més amb fets que amb paraules. Només assegura't que la teva parella se senti segura — no tothom llegeix els fets de la mateixa manera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikuješ víc činy než slovy. Jen dbej, aby se tvůj protějšek cítil jistě – ne každý čte činy stejně."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n cyfathrebu drwy weithredoedd yn fwy na geiriau. Gwna'n siŵr bod dy bartner yn teimlo'n saff — dydy pawb ddim yn darllen gweithredoedd yr un ffordd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunikerer mere gennem handling end ord. Sørg bare for, at din partner føler sig tryg – ikke alle læser handlinger på samme måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunizierst mehr über Taten als über Worte. Achte nur darauf, dass sich dein Schatz sicher fühlt – nicht alle lesen Taten gleich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικοινωνείς πιο πολύ με πράξεις παρά με λόγια. Απλώς φρόντισε το ταίρι σου να νιώθει ασφάλεια — δεν διαβάζουν όλοι τις πράξεις με τον ίδιο τρόπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te comunicas más con hechos que con palabras. Solo asegúrate de que tu pareja se sienta segura: no todo el mundo interpreta los gestos igual."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa suhtled pigem tegude kui sõnadega. Jälgi vaid, et partner tunneks end turvaliselt — kõik ei loe tegusid ühtmoodi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitzekin baino gehiago ekintzekin komunikatzen zara. Ziurtatu zure bikotekidea seguru sentitzen dela — denek ez dituzte ekintzak modu berean irakurtzen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیشتر با عمل حرف می‌زنی تا کلمات. فقط مطمئن شو پارتنرت احساس امنیت می‌کند — همه عمل‌ها را یک‌جور نمی‌خوانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestit enemmän teoilla kuin sanoilla. Varmista vain, että kumppanisi tuntee olonsa turvalliseksi – kaikki eivät tulkitse tekoja samalla tavalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas sa gawa ka nakikipag-usap kaysa sa salita. Siguraduhin lang na panatag ang partner mo — hindi pare-pareho ang pagbasa ng lahat sa gawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'exprimes plus par les actes que par les mots. Assure-toi juste que l'autre se sent en confiance : tout le monde ne lit pas les gestes de la même façon."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déanann tú cumarsáid trí ghníomh níos mó ná trí fhocail. Bí cinnte go mothaíonn do pháirtí slán — ní léann gach duine gníomhartha ar an mbealach céanna."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunícaste máis con feitos ca con palabras. Só procura que a túa parella se sinta segura: non todo o mundo le os feitos da mesma maneira."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે શબ્દો કરતાં કામથી વધુ વાત કરો છો. બસ ધ્યાન રાખો કે તમારા પાર્ટનર સલામતી અનુભવે — દરેક જણ કામને એક જ રીતે સમજતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun fi magana da aiki fiye da kalmomi. Ku dai tabbatar abokin zamanku na jin kwanciyar hankali — ba kowa ne ke fahimtar ayyuka iri ɗaya ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המעשים מדברים אצלך יותר מהמילים. רק כדאי לוודא שהצד השני מרגיש בטוח — לא כולם קוראים מעשים באותה דרך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप शब्दों से ज़्यादा काम से बात करते हैं। बस ध्यान रखें कि आपके पार्टनर ख़ुद को सुरक्षित महसूस करें — हर कोई काम को एक ही तरह नहीं समझता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više komuniciraš djelima nego riječima. Samo pazi da se voljena osoba osjeća sigurno – ne čitaju svi djela na isti način."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou kominike plis ak aksyon pase ak pawòl. Jis asire ou patnè ou santi l an sekirite — se pa tout moun ki li aksyon menm jan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább tettekkel kommunikálsz, mint szavakkal. Csak figyelj, hogy a párod biztonságban érezze magát – nem mindenki olvassa ugyanúgy a tetteket."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու արտահայտվում ես ավելի շատ արարքներով, քան խոսքերով։ Պարզապես հետևիր, որ զուգընկերդ իրեն ապահով զգա — ոչ բոլորն են արարքները նույն կերպ կարդում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu berkomunikasi lebih lewat tindakan daripada kata-kata. Pastikan saja pasanganmu merasa aman — nggak semua orang membaca tindakan dengan cara yang sama."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-egosi ihe site n'omume karịa okwu. Naanị hụ na obi dị onye gị jụụ — ọ bụghị onye ọ bụla na-aghọta omume n'otu ụzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú tjáir þig meira með verkum en orðum. Gakktu bara úr skugga um að makinn þinn finni til öryggis – ekki lesa allir í verk á sama hátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunichi più con le azioni che con le parole. Assicurati solo che il tuo partner si senta al sicuro — non tutti leggono le azioni allo stesso modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉より行動で伝えるタイプです。ただ、行動の受け取り方は人それぞれ。パートナーが安心できているか、気にかけておきましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ngandharake liwat tumindak luwih saka tembung. Mung priksa pasangan rumangsa ayem — ora kabeh wong maca tumindak kanthi cara sing padha."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფრო საქმით ურთიერთობ, ვიდრე სიტყვით. უბრალოდ, დარწმუნდი, რომ პარტნიორი თავს დაცულად გრძნობს — ყველა ერთნაირად ვერ კითხულობს ქმედებებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен сөзден гөрі іспен көбірек жеткізесің. Тек серігің өзін сенімді сезінсін — әркім істі бірдей оқи бермейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកបង្ហាញចិត្តតាមសកម្មភាពច្រើនជាងពាក្យសម្ដី។ គ្រាន់តែប្រាកដថាដៃគូរបស់អ្នកមានអារម្មណ៍សុវត្ថិភាព — មិនមែនគ្រប់គ្នាយល់សកម្មភាពដូចគ្នាទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತಿಗಿಂತ ಕೃತಿಯ ಮೂಲಕ ನೀವು ಹೆಚ್ಚು ವ್ಯಕ್ತಪಡಿಸುತ್ತೀರಿ. ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ಭದ್ರತೆಯ ಭಾವ ಇದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ — ಎಲ್ಲರೂ ಕೃತಿಗಳನ್ನು ಒಂದೇ ರೀತಿ ಓದುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말보다 행동으로 마음을 전하는 타입이에요. 다만 연인이 안정감을 느끼는지 살펴 주세요. 모두가 행동을 똑같이 읽지는 않으니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ji gotinan bêtir bi kirinê diaxivî. Tenê bawer be ku hevjînê te xwe ewle hîs dike — her kes kirinan bi heman awayî naxwîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен сөздөн көрө иш менен көбүрөөк билдиресиң. Болгону сүйгөнүң өзүн коопсуз сезсин — ар ким иш-аракетти бирдей түшүнө бербейт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weis méi mat dem, wat s du méchs, wéi mat Wierder. Pass just op, datt däi Schatz sech sécher fillt — net jiddereen versteet Gesten op déi selwecht Aart."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າສື່ສານດ້ວຍການກະທຳຫຼາຍກວ່າຄຳເວົ້າ ພຽງແຕ່ໃຫ້ແນ່ໃຈວ່າຄູ່ຂອງເຈົ້າຮູ້ສຶກໝັ້ນຄົງ — ບໍ່ແມ່ນທຸກຄົນຈະອ່ານການກະທຳອອກແບບດຽວກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bendrauji labiau veiksmais nei žodžiais. Tik pasirūpink, kad antroji pusė jaustųsi saugiai – ne visi veiksmus supranta vienodai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vairāk runā darbiem nekā vārdiem. Tikai pārliecinies, ka otrā puse jūtas droši – ne visi darbus nolasa vienādi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amin'ny asa no ifandraisanao kokoa noho ny teny. Ataovy fotsiny izay hahatsapan'ny olon-tianao ho azo antoka — tsy mitovy ny fomba handraisan'ny olona ny asa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te mahi kē koe e kōrero ai, kaua mā te kupu. Kia mōhio noa tō hoa aroha kei te haumaru ia — kāore te katoa e pānui ōrite ana i ngā mahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комуницираш повеќе со дела отколку со зборови. Само погрижи се половинката да се чувствува сигурно — не секој ги чита делата на ист начин."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാക്കുകളെക്കാൾ പ്രവൃത്തിയിലൂടെയാണ് നിങ്ങൾ മനസ്സ് അറിയിക്കുന്നത്. പങ്കാളിക്ക് സുരക്ഷിതത്വം തോന്നുന്നുണ്ടെന്ന് മാത്രം ഉറപ്പാക്കൂ — എല്ലാവരും പ്രവൃത്തികളെ ഒരുപോലെയല്ല മനസ്സിലാക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи үгээс илүү үйлдлээр харилцдаг. Хань чинь өөрийгөө аюулгүй мэдэрч байгаа эсэхийг анхаараарай — хүн бүр үйлдлийг адилхан уншдаггүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही शब्दांपेक्षा कृतीतून जास्त व्यक्त होता. फक्त जोडीदाराला सुरक्षित वाटते ना, याची खात्री करा — प्रत्येकजण कृती एकाच प्रकारे समजत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda berkomunikasi lebih melalui tindakan berbanding kata-kata. Cuma pastikan pasangan anda rasa selamat — tidak semua orang membaca tindakan dengan cara yang sama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikkomunika aktar bl-azzjoni milli bil-kliem. Biss kun żgur li l-partner tiegħek iħoss is-sigurtà — mhux kulħadd jaqra l-azzjonijiet bl-istess mod."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် စကားထက် လုပ်ဆောင်ချက်နဲ့ ဆက်သွယ်တယ်။ ချစ်သူ လုံခြုံမှု ခံစားရအောင်တော့ သေချာပါစေ — လူတိုင်း လုပ်ဆောင်ချက်ကို တစ်ပုံစံတည်း နားမလည်ကြပါဘူး။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommuniserer mer gjennom handling enn ord. Bare sørg for at partneren din føler seg trygg – ikke alle leser handlinger på samme måte."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं शब्दभन्दा बढी कामबाट कुरा व्यक्त गर्नुहुन्छ। बस, तपाईंको पार्टनर सुरक्षित महसुस गर्नुहुन्छ भन्ने पक्का गर्नुहोस् — सबैले कामलाई एकै तरिकाले बुझ्दैनन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij communiceert meer met daden dan met woorden. Zorg er wel voor dat je partner zich veilig voelt – niet iedereen leest daden op dezelfde manier."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumalankhula kudzera mu zochita kuposa mawu. Ingotsimikizirani kuti wokondedwa wanu akumva kukhala wotetezeka — si aliyense amene amamvetsa zochita mofanana."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jecha caalaa gochaan dubbatta. Garuu jaalalleen kee nageenya akka itti dhaga'amu mirkaneeffadhu — namni hundi gocha akkuma tokkootti hin hubatu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଶବ୍ଦଠୁ ଅଧିକ କାମରେ ଭାବ ଜଣାନ୍ତି। କେବଳ ନିଶ୍ଚିତ କରନ୍ତୁ ଆପଣଙ୍କ ସାଥୀ ସୁରକ୍ଷିତ ଅନୁଭବ କରୁଛନ୍ତି — ସମସ୍ତେ କାମକୁ ସମାନ ଭାବେ ବୁଝନ୍ତି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਸ਼ਬਦਾਂ ਨਾਲੋਂ ਵੱਧ ਅਮਲ ਰਾਹੀਂ ਗੱਲ ਕਹਿੰਦੇ ਹੋ। ਬੱਸ ਧਿਆਨ ਰੱਖੋ ਕਿ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਸੁਰੱਖਿਅਤ ਮਹਿਸੂਸ ਕਰਨ — ਹਰ ਕੋਈ ਅਮਲਾਂ ਨੂੰ ਇੱਕੋ ਤਰ੍ਹਾਂ ਨਹੀਂ ਸਮਝਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikujesz się bardziej czynami niż słowami. Zadbaj tylko, by twoja druga połówka czuła się bezpiecznie – nie każdy tak samo odczytuje gesty."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو تر خبرو ډېر په عمل خپل احساس ښیئ. یوازې ډاډ ترلاسه کړئ چې ستاسو ملګری د ډاډ احساس کوي — هر څوک عمل یو ډول نه لولي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se comunica mais com atitudes do que com palavras. Só garanta que seu amor sinta segurança — nem todo mundo lê atitudes do mesmo jeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicas mais por ações do que por palavras. Só garante que o teu par sente segurança — nem toda a gente lê as ações da mesma forma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunici mai mult prin fapte decât prin cuvinte. Ai grijă doar ca partenerul tău să se simtă în siguranță — nu toată lumea citește faptele la fel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты выражаешь чувства скорее делами, чем словами. Просто убедись, что партнёр чувствует себя уверенно — не все читают поступки одинаково."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvuga cyane ukoresheje ibikorwa kuruta amagambo. Gusa reba ko umukunzi wawe yumva atekanye — si bose basobanukirwa ibikorwa kimwe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ වචනවලට වඩා ක්‍රියාවෙන් කතා කරනවා. ඔබේ සහකරුට ආරක්ෂිත බවක් දැනෙනවාද කියලා විතරක් බලන්න — හැමෝම ක්‍රියා එකම විදිහට කියවන්නේ නැහැ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikuješ viac činmi než slovami. Len dbaj, aby sa tvoja polovička cítila isto – nie každý číta činy rovnako."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bolj kot z besedami sporočaš z dejanji. Le poskrbi, da se tvoj partner počuti varno – dejanj ne bere vsak enako."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotaura nezviito kupfuura mazwi. Ingova nechokwadi chekuti mudiwa wako anonzwa akachengeteka — havasi vese vanonzwisisa zviito nenzira imwe chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficil ayaad wax ku gudbisaa in ka badan erayo. Kaliya hubi in lammaanahaagu dareemo ammaan — qof walba si isku mid ah uma akhriyo ficillada."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikon më shumë me veprime sesa me fjalë. Thjesht sigurohu që partneri yt të ndihet i sigurt – jo të gjithë i lexojnë veprimet njësoj."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Више говориш делима него речима. Само пази да се твоја половина осећа сигурно — не читају сви дела на исти начин."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun nyarios ngaliwatan laku langkung ti kecap. Pastikeun waé pasangan anjeun ngaraos aman — teu sadayana jalma maca laku kalayan cara anu sami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommunicerar mer genom handling än ord. Se bara till att din partner känner sig trygg – alla läser inte handlingar på samma sätt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unawasiliana kwa vitendo kuliko maneno. Hakikisha tu mwenzi wako anajisikia salama — si kila mtu husoma vitendo kwa njia moja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வார்த்தைகளை விட செயல்கள் மூலம் தெரிவிக்கிறீர்கள். உங்கள் துணை பாதுகாப்பாக உணர்கிறாரா என்று மட்டும் உறுதிசெய்யுங்கள் — எல்லோரும் செயல்களை ஒரே மாதிரிப் புரிந்துகொள்வதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు మాటల కంటే చేతలతో ఎక్కువ చెబుతారు. మీ భాగస్వామికి భద్రంగా అనిపిస్తోందో లేదో చూసుకోండి — అందరూ చేతలను ఒకేలా అర్థం చేసుకోరు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту бештар бо амал гап мезанӣ, на бо сухан. Танҳо бубин, ки ёрат худро бехатар ҳис кунад — на ҳама амалро як хел мефаҳманд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสื่อสารผ่านการกระทำมากกว่าคำพูด แค่ดูให้แน่ใจว่าคนรักรู้สึกมั่นคง เพราะไม่ใช่ทุกคนจะอ่านการกระทำได้เหมือนกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ቃላት ብዝያዳ ብተግባር ትገልጹ። ጥራይ መጻምድኹም ውሕስነት ከም ዝስምዖም ኣረጋግጹ — ኩሉ ሰብ ተግባራት ብሓደ ዓይነት ኣየንብቦን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen söz bilen däl-de, köplenç hereket bilen duýgularyňy bildirýärsiň. Diňe söýgüliň özüni ynamly duýsun — hereketleri hemmeler birmeňzeş okamaýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözden çok davranışla iletişim kuruyorsun. Yalnızca partnerinin kendini güvende hissettiğinden emin ol; herkes davranışları aynı şekilde okumaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти говориш діями більше, ніж словами. Лише подбай, щоб половинка почувалася впевнено, — не всі однаково читають дії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا اظہار الفاظ سے زیادہ عمل سے ہوتا ہے۔ بس یقینی بنائیں کہ آپ کا ساتھی محفوظ محسوس کرے — ہر کوئی عمل کو ایک ہی طرح نہیں سمجھتا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz soʻzdan koʻra amal bilan gapirasiz. Faqat sherigingiz oʻzini xotirjam his qilsin — hamma ham amallarni bir xil tushunavermaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn giao tiếp bằng hành động nhiều hơn lời nói. Chỉ cần đảm bảo người ấy thấy an tâm — không phải ai cũng hiểu hành động theo cùng một cách."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthetha ngezenzo ngaphezu kwamazwi. Qinisekisa nje ukuba iqabane lakho liziva likhuselekile — ayingabo bonke abazifunda izenzo ngendlela efanayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń fi ìṣe sọ̀rọ̀ ju ọ̀rọ̀ lọ. Ṣáà rí i dájú pé ọkàn olólùfẹ́ yín balẹ̀ — kì í ṣe gbogbo ènìyàn ló ń ka ìṣe lọ́nà kan náà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起言語，你更常用行動表達。只是要確保另一半有安全感，不是每個人都讀得懂行動。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起语言，你更多用行动表达。只是要确保另一半有安全感——不是每个人都能读懂行动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起言語，你更常用行動表達。只是要確保另一半有安全感，不是每個人都能讀懂行動。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhuluma ngezenzo kunamazwi. Qiniseka nje ukuthi umlingani wakho uzizwa evikelekile — akuwona wonke umuntu ofunda izenzo ngendlela efanayo."
          }
        }
      }
    },
    "You disarm people by going first. It's a confidence thing, not a low self-esteem thing — when done right." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy ontwapen mense deur eerste te gaan. Dis ’n teken van selfvertroue, nie van lae selfbeeld nie – as dit reg gedoen word."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀድመው ራስዎ ላይ በመቀለድ ሰዎችን ያቀልላሉ። በትክክል ሲደረግ ይህ የመተማመን ምልክት ነው እንጂ ራስን ዝቅ አድርጎ ማየት አይደለም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكسبون الآخرين بأن تبدؤوا بأنفسكم. حين يُتقَن ذلك فهو علامة ثقة، لا ضعف في تقدير الذات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি প্ৰথমে নিজকে লৈ হাঁহি মানুহৰ মন জয় কৰে। ঠিকমতে কৰিলে এয়া আত্মবিশ্বাসৰ কথা, আত্মসন্মানৰ অভাৱৰ নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnsanları ilk özünə gülərək rahatladırsan. Düzgün edildikdə bu, aşağı özünəhörmət yox, özünəinam əlamətidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты абяззбройваеш людзей, пачынаючы з сябе. Калі рабіць гэта правільна, гэта пра ўпэўненасць, а не пра нізкую самаацэнку."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обезоръжаваш хората, като започнеш от себе си. Това е въпрос на увереност, а не на ниско самочувствие – когато е направено добре."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিজেকে দিয়ে শুরু করে তুমি মানুষকে সহজ করে দাও। ঠিকভাবে করলে এটা আত্মবিশ্বাসের ব্যাপার, নিজেকে ছোট ভাবার নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razoružavaš ljude tako što kreneš od sebe. Kad se radi kako treba, to je stvar samopouzdanja, a ne niskog samopoštovanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarmes la gent rient-te primer de tu. És una qüestió de confiança, no de baixa autoestima — si es fa bé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odzbrojuješ lidi tím, že jdeš první. Když se to dělá dobře, je to otázka sebevědomí, ne nízkého sebehodnocení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n diarfogi pobl drwy fynd gyntaf. Mae'n arwydd o hyder, nid o hunan-barch isel — o'i wneud yn iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du afvæbner folk ved selv at gå først. Når det gøres rigtigt, handler det om selvtillid, ikke dårligt selvværd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entwaffnest andere, indem du den ersten Witz auf deine Kosten machst. Richtig gemacht ist das Selbstbewusstsein, kein mangelndes Selbstwertgefühl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφοπλίζεις τους άλλους βάζοντας πρώτα τον εαυτό σου στο στόχαστρο. Όταν γίνεται σωστά, είναι θέμα αυτοπεποίθησης, όχι χαμηλής αυτοεκτίμησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarmas a la gente adelantándote. Bien hecho, es cuestión de confianza, no de baja autoestima."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võtad inimestel relvad maha, minnes ise esimesena. See on enesekindluse, mitte madala enesehinnangu asi — kui seda õigesti teha."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehenengoa zu izanda desarmatzen duzu jendea. Ondo eginez gero, konfiantzaren kontua da, ez autoestimu baxuarena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با پیش‌دستی کردن، آدم‌ها را خلع سلاح می‌کنی. اگر درست انجام شود، نشانهٔ اعتمادبه‌نفس است، نه عزت‌نفس پایین."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riisut muut aseista nauramalla ensin itsellesi. Oikein tehtynä se kertoo itsevarmuudesta, ei huonosta itsetunnosta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napapalagay mo ang loob ng mga tao kapag sarili mo ang inuuna mong biruin. Tungkol ito sa kumpiyansa, hindi sa mababang tingin sa sarili — kapag tama ang pagkakagawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu désarmes les gens en riant de toi en premier. Bien dosé, c'est une marque d'assurance, pas de manque d'estime de soi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díarmálann tú daoine trí dhul ar dtús. Muinín atá ann, ní féinmheas íseal — nuair a dhéantar i gceart é."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarmas á xente rindo de ti primeiro. Ben feito, é cousa de seguridade, non de baixa autoestima."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે પહેલાં પોતાના પર હસીને લોકોને સહજ કરી દો છો. સાચી રીતે થાય તો એ આત્મવિશ્વાસની નિશાની છે, ઓછા આત્મસન્માનની નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna kwantar da hankalin mutane ta hanyar farawa da kanku. Batun ƙwarin gwiwa ne, ba na raunin kima ba — idan an yi shi daidai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצחוק על עצמך קודם מפרק את האנשים מנשקם. כשעושים את זה נכון, זה עניין של ביטחון, לא של דימוי עצמי נמוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले ख़ुद पर हँसकर लोगों को सहज कर देना आपका तरीक़ा है। सही ढंग से हो तो यह आत्मविश्वास की निशानी है, कम आत्मसम्मान की नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razoružaš ljude tako što kreneš od sebe. Kad se radi kako treba, to je stvar samopouzdanja, a ne niskog samopoštovanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou dezame moun lè ou pase anvan. Se yon zafè konfyans, pa yon zafè ou pa estime tèt ou — lè li fèt byen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lefegyverzed az embereket azzal, hogy magaddal kezded. Ha jól csinálod, ez magabiztosság, nem alacsony önbecsülés."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու զինաթափում ես մարդկանց՝ ինքդ քեզնից սկսելով։ Ճիշտ արված՝ դա ինքնավստահության, ոչ թե ցածր ինքնագնահատականի նշան է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu meluluhkan orang dengan menertawakan diri duluan. Kalau dilakukan dengan tepat, itu soal percaya diri, bukan rendah diri."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eme ka obi dajụọ ndị mmadụ site n'ibu ụzọ. Ọ bụ ihe obi ike, ọ bụghị ileda onwe gị anya — mgbe e mere ya nke ọma."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú afvopnar fólk með því að ríða á vaðið. Það sprettur af sjálfsöryggi, ekki lélegu sjálfsmati – þegar það er gert rétt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disarmi le persone partendo da te. Se fatto bene, è segno di sicurezza, non di scarsa autostima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分から先に笑いをとって、場を和ませるタイプ。上手にやれば、それは自信のなさではなく自信の表れです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan nggawe wong luluh kanthi miwiti saka dhiri dhewe. Iku tandha percaya dhiri, dudu minder — yen ditindakake kanthi pas."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხალხს განაიარაღებ იმით, რომ პირველი საკუთარ თავს დასცინი. როცა სწორად გამოგდის, ეს თავდაჯერებულობის ნიშანია და არა დაბალი თვითშეფასების."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алдымен өзіңді күлкіге айналдырып, адамдарды жібітесің. Дұрыс жасалса, бұл өзіңді төмен бағалау емес, сенімділік белгісі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកធ្វើឲ្យមនុស្សធូរចិត្តដោយសើចដាក់ខ្លួនឯងមុន។ វាជារឿងទំនុកចិត្ត មិនមែនការមើលងាយខ្លួនឯងទេ — បើធ្វើបានត្រឹមត្រូវ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೊದಲು ನಿಮ್ಮನ್ನೇ ಗೇಲಿ ಮಾಡಿಕೊಂಡು ಇತರರನ್ನು ಹಗುರಾಗಿಸುತ್ತೀರಿ. ಸರಿಯಾಗಿ ಮಾಡಿದರೆ, ಅದು ಆತ್ಮವಿಶ್ವಾಸದ ಲಕ್ಷಣ, ಕೀಳರಿಮೆಯದ್ದಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 나서서 상대의 경계를 풀어요. 잘만 하면 자존감이 낮아서가 아니라 자신감이 있어서 나오는 유머예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bi destpêkirina ji xwe mirovan nerm dikî. Dema baş tê kirin, ev ji xwebaweriyê tê, ne ji kêmbûna rûmeta xwe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Биринчи өзүңдөн баштап, адамдарды жеңилдетесиң. Туура колдонсоң, бул өзүңө ишенбөөчүлүк эмес — ишенимдүүлүк."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entwaffens Leit, andeems de als éischt iwwer dech selwer laachs. Dat kënnt vu Selbstvertrauen, net vun engem schwaache Selbstwäert — wann et richteg gemaach ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເຮັດໃຫ້ຄົນອື່ນສະບາຍໃຈດ້ວຍການລໍ້ຕົວເອງກ່ອນ ຖ້າເຮັດຖືກວິທີ ນີ້ແມ່ນເລື່ອງຄວາມໝັ້ນໃຈ ບໍ່ແມ່ນການເບິ່ງຖືກຕົນເອງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žmones nuginkluoja tai, kad pirmiausia pasijuoki iš savęs. Jei tai daroma teisingai, tai pasitikėjimo, o ne žemos savivertės ženklas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu atbruņo cilvēkus, apsteidzot viņus un pasmejoties par sevi. Ja to dara pareizi, tā ir pārliecība, nevis zems pašvērtējums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manalefaka ny olona ianao amin'ny fanombohana amin'ny tenanao. Fahatokisan-tena izany, fa tsy fanambaniana tena — raha atao tsara."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka whakangāwari koe i te tangata mā te tīmata i a koe anō. He tohu māia tēnā, ehara i te iti o te whakaaro ki a koe anō — ina tika te mahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ги разоружуваш луѓето кога прво ќе се пошегуваш со себе. Тоа е знак на самодоверба, а не на ниска самопочит — кога се прави како што треба."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആദ്യം സ്വയം കളിയാക്കി നിങ്ങൾ മറ്റുള്ളവരുടെ പിരിമുറുക്കം കുറയ്ക്കുന്നു. ശരിയായി ചെയ്യുമ്പോൾ, അത് ആത്മവിശ്വാസത്തിന്റെ ലക്ഷണമാണ്, ആത്മാഭിമാനക്കുറവിന്റേതല്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түрүүлж өөрийгөө шоолж хүмүүсийг зөөллөдөг. Зөв хийвэл энэ нь өөртөө итгэлтэй байдлын шинж, өөрийгөө дорд үзсэнийх биш."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वतःपासून सुरुवात करून तुम्ही लोकांना सहज करता. योग्य प्रकारे केले तर हे आत्मविश्वासाचे लक्षण आहे, कमी आत्मसन्मानाचे नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda melunakkan orang lain dengan mentertawakan diri sendiri dahulu. Ia tanda keyakinan, bukan rendah diri — jika dilakukan dengan betul."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iżżarma lin-nies billi tmur l-ewwel. Hija kwistjoni ta' kunfidenza, mhux ta' stima baxxa — meta jsir sew."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ့်ကိုယ်ကို အရင်စလိုက်ပြီး လူတွေရဲ့ ခံစစ်ကို ဖြုတ်ချတယ်။ မှန်မှန်ကန်ကန် လုပ်ရင် ဒါ ကိုယ့်ကိုယ်ကို အထင်သေးတာ မဟုတ်ဘဲ ယုံကြည်မှုကြောင့်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du avvæpner folk ved å gå først. Det handler om selvtillit, ikke dårlig selvfølelse – når det gjøres riktig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफैँ पहिले हाँसेर तपाईं अरूको मन जित्नुहुन्छ। सही तरिकाले गर्दा यो आत्मविश्वासको कुरा हो, कम आत्मसम्मानको होइन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ontwapent mensen door jezelf als eerste op de hak te nemen. Als je het goed doet, is dat een teken van zelfvertrouwen, niet van een laag zelfbeeld."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumachepetsa ena pokhala oyamba. Ndi chizindikiro cha chidaliro, osati cha kudzipeputsa — zikachitika bwino."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dursitee of irratti qoosuun namoota laaffifta. Yoo sirriitti hojjetame, kun of amanuu malee of tuffachuu miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଗ ନିଜ ଉପରେ ହସି ଆପଣ ଲୋକଙ୍କୁ ସହଜ କରିଦିଅନ୍ତି। ଠିକ୍ ଭାବେ କଲେ ଏହା ଆତ୍ମବିଶ୍ୱାସର କଥା, ଆତ୍ମସମ୍ମାନ କମ୍ ଥିବାର ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਪਹਿਲਾਂ ਆਪਣੇ ਉੱਤੇ ਹੱਸ ਕੇ ਲੋਕਾਂ ਨੂੰ ਸਹਿਜ ਕਰ ਦਿੰਦੇ ਹੋ। ਜੇ ਸਹੀ ਢੰਗ ਨਾਲ ਹੋਵੇ, ਤਾਂ ਇਹ ਆਤਮ-ਵਿਸ਼ਵਾਸ ਦੀ ਨਿਸ਼ਾਨੀ ਹੈ, ਆਪਣੇ ਆਪ ਨੂੰ ਘੱਟ ਸਮਝਣ ਦੀ ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozbrajasz ludzi, zaczynając od siebie. Dobrze robiona autoironia to kwestia pewności siebie, a nie niskiej samooceny."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو لومړی پر ځان ټوکې کوئ او خلک ارامه کوئ. که سمه وشي، دا د باور نښه ده، نه د ټیټ ځان‌باور."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desarma as pessoas rindo de si primeiro. Quando bem feito, é sinal de confiança, não de autoestima baixa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarmas as pessoas avançando primeiro. É uma questão de confiança, não de autoestima baixa — quando bem feito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezarmezi oamenii râzând tu întâi de tine. E o chestiune de încredere, nu de stimă de sine scăzută — dacă e făcut cum trebuie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты обезоруживаешь людей, начиная с шутки над собой. Если делать это правильно, это про уверенность, а не про низкую самооценку."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utuza abantu ubanza kwisetsa. Ni ikimenyetso cy'icyizere, si icyo kwisuzugura — iyo bikozwe neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මුලින්ම ඔබම ඉදිරිපත් වෙලා ඔබ අනිත් අයව සැහැල්ලු කරනවා. හරියට කළොත් ඒක ආත්ම විශ්වාසයේ ලකුණක් මිසක් අඩු ආත්ම අභිමානයක් නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ľudí odzbrojuješ tým, že sa zasmeješ najprv na sebe. Keď sa to robí dobre, ide o sebavedomie, nie o nízku sebaúctu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljudi razorožiš tako, da začneš pri sebi. Ko je narejeno prav, gre za samozavest, ne za nizko samopodobo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unonyaradza vanhu nekutanga kuzviseka. Ichi chiratidzo chekuzvivimba, kwete chekuzvidzikisira — kana zvaitwa nemazvo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adigoo hore u dhaqaaqa ayaad dadka hubka ka dhigtaa. Waa kalsooni, ma aha is-qiimayn hoose — marka si sax ah loo sameeyo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I çarmatos njerëzit duke qeshur i pari me veten. Kur bëhet si duhet, kjo vjen nga vetëbesimi, jo nga vetëvlerësimi i ulët."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Људе разоружаваш тако што кренеш први. Ствар је у самопоуздању, а не у ниском самопоштовању — кад се ради како треба."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun ngajantenkeun jalma santé ku cara ngaheureuyan diri heula. Upami dilakukeun kalayan leres, éta tanda kapercayaan diri, sanés kurang ngahargaan diri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du avväpnar folk genom att gå först. Rätt gjort handlar det om självförtroende, inte dålig självkänsla."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unawapokonya watu silaha kwa kutangulia wewe. Ni suala la kujiamini, si la kujidharau — likifanywa vizuri."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முதலில் உங்களையே கேலி செய்து மற்றவர்களை இயல்பாக்குகிறீர்கள். சரியாகச் செய்தால், அது தன்னம்பிக்கையின் அடையாளம், தாழ்வு மனப்பான்மை அல்ல."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరే ముందు నవ్వుకోవడం ద్వారా ఇతరులను తేలికపరుస్తారు. సరిగ్గా చేస్తే, అది ఆత్మవిశ్వాసానికి సంకేతం, ఆత్మన్యూనతకు కాదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту бо аввал худат хандидан одамонро ором мекунӣ. Агар дуруст бошад, ин аз худбоварӣ аст, на аз худбоварии паст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณทำให้คนผ่อนคลายด้วยการเริ่มที่ตัวเองก่อน ถ้าทำอย่างพอดี นี่คือความมั่นใจ ไม่ใช่การดูถูกตัวเอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀዲምኩም ብምስሓቕ ንሰባት ተዘሓሕሉ። ብቕኑዕ ምስ ዝግበር፣ እዚ ናይ ርእሰ-ምትእምማን እምበር ናይ ትሑት ርእሰ-ግምት ኣይኮነን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilki özüňe gülüp, adamlary rahatlandyrýarsyň. Dogry edilende, bu özüňe ynamsyzlyk däl, ynam alamaty."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk hamleyi yaparak insanları yumuşatıyorsun. Doğru yapıldığında bu düşük özgüven değil, özgüven işareti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти обеззброюєш людей, сміючись першим із себе. Якщо робити це правильно, це про впевненість, а не про низьку самооцінку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خود پر پہلے ہنس کر لوگوں کو بے تکلف کر دینا آپ کا ہنر ہے۔ صحیح انداز میں ہو تو یہ خود اعتمادی کی نشانی ہے، احساسِ کمتری کی نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birinchi boʻlib oʻzingizga kulib, odamlarni yumshatasiz. Toʻgʻri qilinganda, bu oʻziga past baho berish emas, ishonch belgisi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn khiến người khác thả lỏng bằng cách tự giễu trước. Khi làm đúng cách, đó là sự tự tin chứ không phải tự ti."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyabazolisa abantu ngokuqala ngawe. Kumalunga nokuzithemba, hayi ukuzijongela phantsi — xa kwenziwa kakuhle."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń mú ọkàn àwọn èèyàn rọ̀ nípa bíbẹ̀rẹ̀ pẹ̀lú ara yín. Ìgboyà ni, kì í ṣe àìnígbẹ̀kẹ̀lé ara ẹni — tí a bá ṣe é dáadáa."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你先拿自己開刀來讓人放下戒心。做得好的話，這是自信的表現，不是自卑。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你先拿自己开玩笑，让别人放下戒备。用得好的话，这是自信，而不是自卑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你先拿自己開刀，讓別人卸下心防。做得好的話，這是自信，不是自卑。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhulula abantu ngokuqala ngawe. Kuwukuzethemba, hhayi ukuzibukela phansi — uma kwenziwa kahle."
          }
        }
      }
    },
    "You don't dwell. Acknowledge it, adjust, and move forward — dwelling makes it worse for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy bly nie daarby stilstaan nie. Erken dit, pas aan en beweeg vorentoe – om daaroor te bly maal maak dit vir jou erger."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነገሮችን አያንከባልሉም። ይቀበሉት፣ ያስተካክሉት፣ ወደፊት ይቀጥሉ — ማንከባለል ለእርስዎ ነገሩን ያባብሰዋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تطيلون الوقوف عند الأمور. الاعتراف والتعديل ثم المضي قدمًا، فالإطالة تزيد الأمر سوءًا عندكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি কথা টানি নিনিয়ে। স্বীকাৰ কৰক, সলনি কৰক আৰু আগবাঢ়ক — বেছি ভাবি থাকিলে আপোনাৰ বাবে কথাটো আৰু বেয়া হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstündə çox dayanmırsan. Etiraf et, düzəlt və irəli get — uzatmaq sənin üçün vəziyyəti pisləşdirir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не затрымліваешся на гэтым. Прызнаць, выправіць і ісці далей — бо калі доўга мусоліць, табе толькі горш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не се задържаш на това. Признай го, промени се и продължете напред – умуването само влошава нещата за теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি ব্যাপারটা নিয়ে পড়ে থাকো না। স্বীকার করো, শুধরে নাও, এগিয়ে যাও — বারবার টেনে আনলে তোমার জন্য সেটা আরও খারাপ হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne zadržavaš se na tome. Priznaj, prilagodi se i idi dalje – razvlačenje ti samo pogoršava stvar."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No t'hi encalles. Reconèixer-ho, ajustar i tirar endavant — donar-hi voltes ho empitjora per a tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerozebíráš to donekonečna. Uznat, napravit, jít dál – rozpitvávání to pro tebe jen zhorší."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwyt ti ddim yn hel meddyliau. Cydnabod y peth, addasu, a symud ymlaen — mae pendroni'n gwneud pethau'n waeth i ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du dvæler ikke. Anerkend det, justér og kom videre – at dvæle gør det kun værre for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hältst dich nicht lange auf. Anerkennen, anpassen, weitergehen – langes Grübeln macht es für dich nur schlimmer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν το κουράζεις. Παραδοχή, διόρθωση και συνέχεια — το να το σκαλίζεις σε κάνει να νιώθεις χειρότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No le das vueltas. Reconocerlo, ajustar y seguir: darle más vueltas solo lo empeora para ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei jää asja juurde vaagima. Tunnista, kohanda ja liigu edasi — pikk vaagimine teeb sinu jaoks asja hullemaks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez zara gauzetan luzaroan geratzen. Aitortu, egokitu eta aurrera — buruari bueltaka emateak okerrera eramaten zaitu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی چیزی نمی‌مانی. بپذیرش، اصلاحش کن و جلو برو — کش دادنش حالت را بدتر می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et jää vatvomaan. Myönnä, korjaa ja jatka eteenpäin – vatvominen vain pahentaa asiaa sinulle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ka nagtatagal sa isyu. Aminin, mag-adjust, at magpatuloy — lalo lang lumalala para sa’yo kapag pinapatagal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne t'attardes pas. On le reconnaît, on ajuste, on avance : ressasser ne fait qu'empirer les choses pour toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní maith leat fanacht air. Aithin é, coigeartaigh, agus ar aghaidh — dar leat, is measa an scéal má fhantar ag tochras air."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non te recreas. Recoñécese, axústase e séguese adiante: darlle voltas fai que sexa peor para ti."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે એક જ વાત પર અટકી રહેતા નથી. સ્વીકારો, સુધારો અને આગળ વધો — એની એ વાત પકડી રાખવાથી તમારા માટે સ્થિતિ વધુ બગડે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba kwa daɗewa a kai. A amince, a gyara, a ci gaba — tsayawa a kai na ƙara muku muni."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצלך לא נתקעים על זה. להכיר בזה, לתקן ולהמשיך — להתבוסס בזה רק מחמיר את המצב בשבילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बातों में उलझे नहीं रहना चाहते। मान लेना, सुधार करना और आगे बढ़ना — बार-बार कुरेदने से आपके लिए बात और बिगड़ती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne zadržavaš se na tome. Priznaj, prilagodi se i nastavi – razvlačenje ti sve samo pogorša."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pa rete sou sa. Rekonèt li, ajiste, epi avanse — rete sou sa fè l vin pi mal pou ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem rágódsz. Elismerni, változtatni, továbblépni – a rágódás nálad csak ront a helyzeten."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու երկար չես կանգ առնում։ Ընդունիր, ուղղիր ու գնա առաջ — երկար անդրադառնալը քեզ համար միայն վատացնում է իրավիճակը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu nggak suka berlarut-larut. Akui, perbaiki, lalu jalan terus — terus membahasnya justru bikin kamu makin nggak nyaman."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị naghị anọgide na ya. Kweta ya, gbanwee, gaa n'ihu — ịnọgide na ya na-eme ka ọ ka njọ nye gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú dvelur ekki við hlutina. Viðurkenna, aðlaga og halda áfram – að velta sér upp úr því gerir það bara verra fyrir þig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti piace rimuginare. Riconoscere, aggiustare il tiro e andare avanti — insistere, per te, peggiora le cose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引きずらないタイプです。認めて、改めて、前に進む。長引くほど、かえってつらくなるのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ora seneng mbaleni. Akoni, benakake, banjur maju — yen dibaleni terus malah nggawe tambah ora kepenak kanggo panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დიდხანს არ ჩერდები. აღიარე, გამოასწორე და წინ წადი — ერთზე ტრიალი შენთვის მხოლოდ აუარესებს საქმეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен бір нәрсеге тұрып қалмайсың. Мойында, түзет, алға жүр — ұзақ қазбалау саған тек жаман."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមិនជាប់គាំងយូរទេ។ ទទួលស្គាល់ កែតម្រូវ ហើយបន្តទៅមុខ — ការគិតច្រំដែលធ្វើឲ្យកាន់តែអាក្រក់សម្រាប់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಅದರಲ್ಲೇ ಮುಳುಗುವುದಿಲ್ಲ. ಒಪ್ಪಿಕೊಳ್ಳಿ, ಸರಿಪಡಿಸಿಕೊಳ್ಳಿ, ಮುಂದೆ ಸಾಗಿ — ಅದನ್ನೇ ಮೆಲುಕು ಹಾಕುವುದು ನಿಮಗೆ ಇನ್ನಷ್ಟು ಕಷ್ಟ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래 곱씹지 않아요. 인정하고, 고치고, 앞으로 나아가면 돼요. 계속 붙잡고 있으면 오히려 더 힘들어지거든요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu li ser namînî. Bipejirîne, rast bike û pêş de here — mayîna li ser wê ji te re rewşê xerabtir dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен бир нерсеге илинип калбайсың. Мойнуна ал, оңдо, ары жыл — кайра-кайра казып отуруу сага жаман тиет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hänks net laang drun. Zouginn, upassen a weidermaachen — laang driwwer gréiwele mécht et fir dech nëmme méi schlëmm."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າບໍ່ຈົມຢູ່ກັບມັນ ຍອມຮັບ, ປັບປຸງ, ແລ້ວກ້າວຕໍ່ໄປ — ການຄິດວົນວຽນມີແຕ່ເຮັດໃຫ້ເຈົ້າຮູ້ສຶກແຍ່ລົງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu neužsibūni. Pripažinti, pasitaisyti ir judėti pirmyn – ilgas nagrinėjimas tau tik viską pablogina."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu neiestrēgsti pie tā. Atzīt, pielāgoties un iet uz priekšu – ilga kavēšanās pie tā tev visu tikai pasliktina."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy mijanona ela amin'izany ianao. Ekeo, ahitsio, ary mandrosoa — ny fijanonana amin'izany no mampiharatsy kokoa azy ho anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore koe e noho roa ki runga. Whakaaetia, whakatikaina, haere whakamua — ko te noho roa ka kino ake mōu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не се задржуваш долго. Признај, прилагоди се и продолжи — задржувањето само влошува за тебе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ അതിൽ കുടുങ്ങിനിൽക്കില്ല. സമ്മതിക്കുക, തിരുത്തുക, മുന്നോട്ട് പോകുക — അതിൽത്തന്നെ ചുറ്റിത്തിരിയുന്നത് നിങ്ങൾക്ക് കാര്യം വഷളാക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи удаан тээдэггүй. Хүлээн зөвшөөр, засч, цааш яв — удаан ярих нь чамд улам дордуулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही त्यात अडकून राहत नाही. मान्य करा, बदल करा आणि पुढे चला — त्यावरच घोळत बसले तर तुम्हाला ते जास्त जड जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak suka berlarutan. Akui, perbaiki dan teruskan — berlarutan hanya memburukkan keadaan bagi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma toqgħodx tfettaq. Irrikonoxxiha, irranġa, u imxi 'l quddiem — li tibqa' ddur fuqha tagħmilha agħar għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် အကြာကြီး တွေးမနေတတ်ဘူး။ ဝန်ခံ၊ ပြင်ဆင်၊ ရှေ့ဆက် — ဆက်တွေးနေတာက သင့်အတွက် ပိုဆိုးစေတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du dveler ikke. Erkjenn det, juster og gå videre – å henge seg opp i det gjør det bare verre for deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं कुरा तन्काउनुहुन्न। स्वीकार गर्ने, सुधार्ने र अघि बढ्ने — कुरा तन्काउँदा तपाईंलाई झन् गाह्रो हुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij blijft er niet in hangen. Erkennen, bijsturen en verder – blijven malen maakt het voor jou alleen maar erger."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simukakamira. Vomerezani, sinthani, ndipo pitani patsogolo — kukakamira kumaipitsa zinthu kwa inu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itti hin turtu. Amanuu, sirreessuu, fuulduratti tarkaanfachuu — itti turuun siif caalaa hammeessa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଗୋଟିଏ କଥାରେ ଅଟକି ରହନ୍ତି ନାହିଁ। ସ୍ୱୀକାର କରନ୍ତୁ, ସୁଧାରନ୍ତୁ, ଆଗକୁ ବଢ଼ନ୍ତୁ — ବାରମ୍ବାର ଘାଣ୍ଟିଲେ ଆପଣଙ୍କ ପାଇଁ ଆହୁରି ଖରାପ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਗੱਲਾਂ ਨੂੰ ਖਿੱਚਦੇ ਨਹੀਂ। ਗ਼ਲਤੀ ਮੰਨੋ, ਸੁਧਾਰੋ, ਅਤੇ ਅੱਗੇ ਵਧੋ — ਗੱਲ ਨੂੰ ਲਮਕਾਉਣ ਨਾਲ ਤੁਹਾਡੇ ਲਈ ਹਾਲਤ ਹੋਰ ਵਿਗੜਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie rozpamiętujesz. Przyznać się, poprawić i ruszyć dalej – rozpamiętywanie tylko ci szkodzi."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په یوه خبره نه نښلئ. ومنئ، سمه یې کړئ او مخکې لاړ شئ — پرې ډېر ګرځېدل یې ستاسو لپاره بدتره کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não fica remoendo. Reconhecer, ajustar e seguir em frente — ficar remoendo só piora para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não ficas a remoer. Reconhecer, ajustar e seguir em frente — remoer só piora as coisas para ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu-ți place să tot revii asupra lucrurilor. O recunoaștere, o schimbare și mergeți mai departe — dacă se tot discută, pentru tine e și mai rău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не зацикливаешься. Признать, исправиться и двигаться дальше — а долгие разборы тебе только вредят."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntutinda ku bintu. Kubyemera, guhinduka, no gukomeza imbere — gutinda kuri byo birushaho kukubabaza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ දේවල් ගැන දිගටම හිත හිත ඉන්නේ නැහැ. පිළිගන්න, හදාගන්න, ඉදිරියට යන්න — දිගටම ඒ ගැනම හිතන එක ඔබට තත්ත්වය තවත් නරක් කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezotrvávaš pri tom. Uznať, upraviť a pokračovať – rozoberanie to pre teba len zhoršuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne premlevaš. Priznaj, prilagodi se in pojdi naprej – premlevanje ti stvari le poslabša."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haugari pazviri. Zvibvume, zvigadzirise, mopfuurira mberi — kugara pazviri kunozviwedzera kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuma sii daahdid. Qir, wax ka beddel, oo hore u soco — ku sii fekeridda ayaa kaaga sii dara."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk të pëlqen të ngecësh aty. Pranoje, ndrequ dhe ec përpara – po ta zgjasësh, për ty bëhet edhe më keq."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не задржаваш се на томе. Признај, прилагоди се и иди даље — задржавање ти само погоршава ствар."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun henteu ngalelewe. Akuan, benerkeun, teras teraskeun — ngalelewe ngan ngajantenkeun langkung awon pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ältar inte. Erkänn det, justera och gå vidare – att älta gör det bara värre för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukwami katika jambo. Likiri, rekebisha, na songa mbele — kulirudia rudia kunalifanya kuwa baya zaidi kwako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் அதிலேயே உழல்வதில்லை. ஒப்புக்கொண்டு, மாற்றிக்கொண்டு, முன்னே செல்வதே உங்கள் வழி — அதையே நினைத்துக்கொண்டிருப்பது உங்களுக்கு நிலைமையை மோசமாக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు దాని మీదే ఆగిపోరు. ఒప్పుకోండి, సరిదిద్దుకోండి, ముందుకు సాగండి — దాని గురించే ఆలోచిస్తూ ఉంటే మీకు ఇంకా కష్టం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар як ҷо намемонӣ. Эътироф кун, ислоҳ кун ва пеш рав — дароз кашидан барои ту ҳолро бадтар мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่จมอยู่กับเรื่องเดิม ยอมรับ ปรับตัว แล้วก้าวต่อ การวนอยู่กับมันมีแต่ทำให้คุณรู้สึกแย่ลง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣይትጸንሑሉን። ተቐቢልኩም፣ ኣስተኻኺልኩም፣ ንቕድሚት ትኸዱ — ምድጋሙ ንዓኹም የክፍኦ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen bir zatda köp eglenmeýärsiň. Ykrar et, düzet we öňe git — köp oýlanmak saňa ýagdaýy has agyrlaşdyrýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takılıp kalmıyorsun. Kabul et, düzelt, devam et; meseleyi uzatmak senin için durumu daha da kötüleştiriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти не зациклюєшся. Визнати, виправити й іти далі — бо пережовування тобі лише шкодить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے لیے بات کو کھینچنا ٹھیک نہیں۔ مان لیں، سدھار لیں اور آگے بڑھیں — بار بار دہرانے سے آپ کے لیے معاملہ اور بگڑتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz bir joyda qotib qolmaysiz. Tan oling, toʻgʻrilang va oldinga yuring — uzoq muhokama siz uchun vaziyatni yomonlashtiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không để bụng lâu. Nhận lỗi, điều chỉnh, rồi bước tiếp — cứ day dứt mãi chỉ khiến bạn thấy tệ hơn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awuhlali kuyo. Yivume, ulungise, uqhubeke — ukuhlala kuyo kwenza kube kubi ngakumbi kuwe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kì í pẹ́ lórí nǹkan. Ẹ jẹ́wọ́ rẹ̀, ẹ ṣàtúnṣe, ẹ tẹ̀síwájú — pípẹ́ lórí rẹ̀ máa ń mú un burú sí i fún yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不喜歡一直糾結。承認、調整、向前走，反覆提起只會令你更難受。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不爱纠结。承认、调整、往前走——反复纠缠只会让你更难受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不喜歡一直糾結。承認、調整、往前走，反覆提起只會讓你更難受。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awuhlali kukho. Kuvume, kulungise, uqhubekele phambili — ukuhlala kukho kwenza kube kubi kakhulu kuwe."
          }
        }
      }
    },
    "You don't force it. Time does the work, and you let the relationship find its own equilibrium again." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy forseer dit nie. Tyd doen die werk, en jy laat die verhouding self weer sy ewewig vind."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አያስገድዱትም። ጊዜ ሥራውን ይሠራል፤ ግንኙነቱም እንደገና ሚዛኑን እንዲያገኝ ይተዋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تفرضون الأمور. الوقت يقوم بعمله، وتتركون العلاقة تستعيد توازنها بنفسها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি জোৰ নকৰে। সময়ে কাম কৰে, আৰু আপুনি সম্পৰ্কটোক নিজাকৈ পুনৰ ভাৰসাম্য বিচাৰি পাবলৈ দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlamırsan. Vaxt öz işini görür və münasibətin yenidən öz tarazlığını tapmasına imkan verirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не прымушаеш. Час робіць сваю справу, і ты дазваляеш адносінам самім знайсці раўнавагу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не насилваш нещата. Времето си върши работата и оставяш връзката сама да намери равновесието си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি জোর করো না। সময় তার কাজ করে, আর তুমি সম্পর্কটাকে নিজের মতো করে আবার ভারসাম্য খুঁজে নিতে দাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forsiraš. Vrijeme radi svoje, a ti puštaš da veza sama ponovo nađe ravnotežu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ho forces. El temps fa la feina, i deixes que la relació torni a trobar el seu equilibri."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nelámeš přes koleno. Čas udělá své a ty necháš vztah, ať si znovu najde rovnováhu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwyt ti ddim yn gorfodi pethau. Amser sy'n gwneud y gwaith, ac rwyt ti'n gadael i'r berthynas ddod o hyd i'w chydbwysedd eto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du presser ikke på. Tiden gør arbejdet, og du lader forholdet finde sin egen balance igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erzwingst nichts. Die Zeit erledigt den Rest, und du lässt eure Beziehung ihr Gleichgewicht von selbst wiederfinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν το πιέζεις. Ο χρόνος κάνει τη δουλειά, κι εσύ αφήνεις τη σχέση να ξαναβρεί μόνη της την ισορροπία της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo fuerzas. El tiempo hace su trabajo y dejas que la relación vuelva a encontrar su equilibrio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei sunni. Aeg teeb oma töö ja sa lased suhtel ise uuesti tasakaalu leida."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez duzu behartzen. Denborak egiten du lana, eta harremanari bere oreka berriro aurkitzen uzten diozu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به زور جلو نمی‌بری. زمان کارش را می‌کند و می‌گذاری رابطه دوباره تعادلش را پیدا کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et pakota. Aika tekee tehtävänsä, ja annat suhteen löytää tasapainonsa uudelleen omalla painollaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo ito pinipilit. Ang panahon ang gumagawa, at hinahayaan mong kusang bumalik sa balanse ang relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne forces rien. Le temps fait son œuvre, et tu laisses votre relation retrouver son équilibre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní bhrúnn tú é. Déanann an t-am an obair, agus ligeann tú don chaidreamh a chothromaíocht féin a aimsiú arís."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non o forzas. O tempo fai o seu traballo, e deixas que a relación atope de novo o seu equilibrio."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે જબરદસ્તી નથી કરતા. સમય પોતાનું કામ કરે છે, અને તમે સંબંધને ફરી પોતાનું સંતુલન શોધવા દો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba kwa tilastawa. Lokaci na yin aikinsa, kuma kuna barin dangantakar ta sake samun daidaitonta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצלך לא מכריחים. הזמן עושה את שלו, והזוגיות מוצאת שוב את האיזון שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ज़बरदस्ती नहीं करते। वक़्त अपना काम करता है, और आप रिश्ते को फिर से अपना संतुलन ढूँढ़ने देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forsiraš. Vrijeme odradi svoje, a ti pustiš da veza sama ponovno nađe ravnotežu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pa fòse bagay yo. Tan an fè travay li, e ou kite relasyon an jwenn ekilib li ankò."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem erőlteted. Az idő elvégzi a dolgát, és hagyod, hogy a kapcsolat megtalálja újra az egyensúlyát."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու չես շտապեցնում։ Ժամանակն անում է իր գործը, և դու թույլ ես տալիս, որ հարաբերությունները նորից գտնեն իրենց հավասարակշռությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu nggak memaksakan. Waktu yang bekerja, dan kamu membiarkan hubungan menemukan keseimbangannya lagi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị naghị amanye ya. Oge na-arụ ọrụ ahụ, ị na-ahapụkwa mmekọrịta ahụ ka ọ chọta nguzozi ya ọzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú þvingar ekkert fram. Tíminn vinnur verkið og þú leyfir sambandinu að finna jafnvægið sitt á ný."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non forzi le cose. Il tempo fa il suo lavoro, e lasci che la relazione ritrovi da sola il suo equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無理に解決しようとしないタイプです。時間に任せて、ふたりの関係が自然にバランスを取り戻すのを待ちます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ora meksa. Wektu sing nyambut gawe, lan panjenengan menehi kalodhangan sesambungan nemokake imbange maneh."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არ აჩქარებ. დრო თავის საქმეს აკეთებს და ურთიერთობას საშუალებას აძლევ, ისევ თავისით იპოვოს წონასწორობა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен асықтырмайсың. Уақыт өз ісін істейді, ал сен қарым-қатынасқа тепе-теңдігін қайта табуға мүмкіндік бересің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមិនបង្ខំទេ។ ពេលវេលាធ្វើការងាររបស់វា ហើយអ្នកទុកឲ្យទំនាក់ទំនងរកតុល្យភាពរបស់វាឡើងវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಒತ್ತಾಯ ಮಾಡುವುದಿಲ್ಲ. ಸಮಯವೇ ಕೆಲಸ ಮಾಡುತ್ತದೆ, ಮತ್ತು ಸಂಬಂಧ ತನ್ನ ಸಮತೋಲನವನ್ನು ತಾನೇ ಮತ್ತೆ ಕಂಡುಕೊಳ್ಳಲು ಬಿಡುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "억지로 풀려고 하지 않아요. 시간이 해결해 주고, 관계가 스스로 다시 균형을 찾도록 기다려요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu zorê lê nakî. Dem kar dike, û tu dihêlî têkilî dîsa hevsengiya xwe bibîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен зордобойсуң. Убакыт өз ишин кылат, мамиле кайра өз тең салмагын табат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forcéiers näischt. D'Zäit mécht hir Aarbecht, an du léiss är Bezéiung hiert Gläichgewiicht erëmfannen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າບໍ່ຝືນ ເວລາຈະຊ່ວຍເອງ ແລະ ເຈົ້າປ່ອຍໃຫ້ຄວາມສຳພັນຫາຈຸດສົມດຸນຂອງມັນອີກຄັ້ງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu neskubini. Laikas atlieka savo darbą, o tu leidi santykiams vėl rasti pusiausvyrą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nespied. Laiks paveic savu, un tu ļauj attiecībām pašām atgūt līdzsvaru."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy manery ianao. Ny fotoana no miasa, ary avelanao hahita ny fandanjalanjany indray ny fifandraisana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore koe e akiaki. Mā te wā e mahi, ā, ka waiho e koe te hononga kia kitea anō tōna taurite."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не туркаш на сила. Времето ја врши работата, а ти ѝ дозволуваш на врската сама повторно да ја најде рамнотежата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ നിർബന്ധിക്കില്ല. സമയം അതിന്റെ ജോലി ചെയ്യും, ബന്ധം സ്വയം അതിന്റെ താളം വീണ്ടെടുക്കാൻ നിങ്ങൾ അനുവദിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи албаддаггүй. Цаг хугацаа ажлаа хийж, харилцаа тань тэнцвэрээ дахин олохыг чи хүлээдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही जबरदस्ती करत नाही. वेळ आपले काम करतो, आणि नाते पुन्हा आपला तोल शोधते, तुम्ही तसे होऊ देता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak memaksa. Masa yang memulihkan, dan anda biarkan hubungan menemui keseimbangannya semula."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma tisforzax l-affarijiet. Il-ħin jagħmel ix-xogħol, u tħalli r-relazzjoni terġa' ssib il-bilanċ tagħha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် အတင်းမလုပ်ဘူး။ အချိန်က အလုပ်လုပ်ပေးပြီး ဆက်ဆံရေးကို သူ့ဘာသာ ပြန်ညီမျှလာအောင် သင် ခွင့်ပြုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tvinger det ikke fram. Tiden gjør jobben, og du lar forholdet finne balansen igjen på egen hånd."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं जबरजस्ती गर्नुहुन्न। समयले आफ्नो काम गर्छ, र तपाईं सम्बन्धलाई फेरि आफ्नै सन्तुलन खोज्न दिनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij forceert niets. De tijd doet het werk, en je laat de relatie vanzelf haar evenwicht terugvinden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simukakamiza. Nthawi imagwira ntchito, ndipo mumalola ubale wanu kupezanso bata lake."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirqisiisuu hin barbaaddu. Yeroon hojii isaa hojjeta, hariiroonis madaala isaa akka deebifatu ni dhiifta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଜବରଦସ୍ତି କରନ୍ତି ନାହିଁ। ସମୟ କାମ କରେ, ଆଉ ଆପଣ ସମ୍ପର୍କକୁ ନିଜେ ପୁଣି ସନ୍ତୁଳନ ଖୋଜିବାକୁ ଦିଅନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਜ਼ਬਰਦਸਤੀ ਨਹੀਂ ਕਰਦੇ। ਸਮਾਂ ਆਪਣਾ ਕੰਮ ਕਰਦਾ ਹੈ, ਅਤੇ ਤੁਸੀਂ ਰਿਸ਼ਤੇ ਨੂੰ ਮੁੜ ਆਪਣਾ ਸੰਤੁਲਨ ਲੱਭਣ ਦਿੰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wymuszasz. Czas robi swoje, a ty pozwalasz waszej relacji samej odnaleźć równowagę."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو زور نه اچوئ. وخت خپل کار کوي، او پرېږدئ چې اړیکه بیا خپل انډول ومومي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não força. O tempo faz o trabalho, e você deixa a relação encontrar o equilíbrio de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não forças nada. O tempo faz o trabalho, e deixas a relação reencontrar o seu equilíbrio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu forțezi. Timpul își face treaba, iar tu lași relația să-și regăsească singură echilibrul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не торопишь события. Время делает своё, и отношения сами возвращаются к равновесию."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntuhatiriza. Igihe kirakora akazi kacyo, ukareka umubano ukongera kwibonera uburinganire bwawo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ බලෙන් කරන්නේ නැහැ. කාලය වැඩේ කරනවා, සබඳතාවට ආයෙත් එහි සමබරතාව හොයාගන්න ඔබ ඉඩ දෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netlačíš na to. Čas urobí svoje a necháš vzťah, aby si znova našiel rovnováhu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ničesar ne siliš. Čas opravi svoje, ti pa pustiš odnosu, da znova najde ravnovesje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haumanikidzi. Nguva inoita basa racho, uye unorega ukama hwenyu huchiwana kuenzana kwahwo zvakare."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma qasabtid. Waqtiga ayaa shaqada qabta, waxaadna u oggolaataa xiriirka inuu mar kale helo dheelitirkiisa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk e detyron. Koha bën punën e vet dhe ti e lë marrëdhënien ta gjejë sërish ekuilibrin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не форсираш. Време ради своје, а ти пушташ да веза сама поново нађе равнотежу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun henteu maksa. Waktos anu ngadamel, sareng anjeun ngantep hubungan mendakan kasaimbanganana deui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forcerar inget. Tiden gör jobbet, och du låter relationen hitta tillbaka till sin balans."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hulazimishi. Muda hufanya kazi yake, na unauacha uhusiano upate uwiano wake tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் கட்டாயப்படுத்துவதில்லை. காலம் தன் வேலையைச் செய்யும்; உறவு மீண்டும் தன் சமநிலையைக் கண்டடைய விடுகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు బలవంతం చేయరు. సమయమే పని చేస్తుంది, బంధం మళ్లీ తన సమతుల్యతను కనుక్కునేలా మీరు వదిలేస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту маҷбур намекунӣ. Вақт кори худро мекунад ва ту мегузорӣ, ки муносибат боз мувозинати худро ёбад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ฝืน ปล่อยให้เวลาทำหน้าที่ และให้ความสัมพันธ์กลับมาสมดุลด้วยตัวเอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣይተገድድዎን። ግዜ ስራሑ ይሰርሕ፣ ርክብኩም ድማ ሚዛኑ ባዕሉ ክረክብ ትገድፍዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen zorlamaýarsyň. Wagt öz işini edýär, sen hem gatnaşygyň öz deňagramlylygyny gaýtadan tapmagyna ýol berýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlamıyorsun. İşi zaman görüyor ve ilişkinin dengesini kendiliğinden yeniden bulmasına izin veriyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти не квапиш події. Час робить свою справу, і ти даєш стосункам самим знайти рівновагу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبردستی آپ کا طریقہ نہیں۔ وقت اپنا کام کرتا ہے، اور رشتہ خود ہی دوبارہ اپنا توازن پا لیتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz shoshiltirmaysiz. Vaqt oʻz ishini qiladi, munosabatlaringiz esa yana oʻz muvozanatini topadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không ép buộc. Thời gian sẽ làm phần việc của nó, và bạn để mối quan hệ tự tìm lại sự cân bằng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awunyanzeli. Ixesha liyawenza umsebenzi, kwaye uyabuvumela ubudlelwane bufumane ulungelelwano lwabo kwakhona."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kì í fipá mú un. Àkókò ń ṣe iṣẹ́ rẹ̀, ẹ sì ń jẹ́ kí ìbáṣepọ̀ yín wá ìwọ̀ntúnwọ̀nsì rẹ̀ padà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不勉強。讓時間發揮作用，讓這段關係自己重新找回平衡。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不强求。时间会起作用，你让感情慢慢找回自己的平衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不勉強。讓時間發揮作用，讓這段關係自己重新找回平衡。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awuphoqi. Isikhathi senza umsebenzi, futhi uvumela ubudlelwano buthole ukulingana kwabo futhi."
          }
        }
      }
    },
    "You don't have strong emotional ties to holidays — which can be freeing or leave you feeling like something's missing." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy het nie sterk emosionele bande met vakansiedae nie – dit kan bevrydend wees of jou laat voel asof iets ontbreek."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከበዓላት ጋር ጠንካራ ስሜታዊ ትስስር የለዎትም — ይህ ነፃ ሊያወጣዎ ወይም የሆነ ነገር እንደጎደለ እንዲሰማዎ ሊያደርግ ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديكم ارتباط عاطفي قوي بالأعياد، وقد يكون هذا محرِّرًا، أو يترك شعورًا بأن شيئًا ما ينقص."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধৰ দিনৰ লগত আপোনাৰ গভীৰ আৱেগিক সম্পৰ্ক নাই — যিটো মুক্তিদায়ক হ'ব পাৰে, বা কিবা এটাৰ অভাৱ অনুভৱ কৰাব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayramlara güclü emosional bağlılığın yoxdur — bu, həm azadlıq verə, həm də nəyinsə çatışmadığı hissini yarada bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да святаў у цябе няма моцнай эмацыйнай прывязанасці — гэта можа вызваляць або пакідаць адчуванне, што чагосьці не хапае."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нямаш силна емоционална връзка с празниците – което може да е освобождаващо или да те кара да чувстваш, че нещо липсва."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছুটির দিনের সাথে তোমার তেমন আবেগের টান নেই — এটা মুক্তির মতো লাগতে পারে, আবার কিছু একটা নেই বলেও মনে হতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemaš jaku emotivnu vezu s praznicima – što može biti oslobađajuće ili ostaviti osjećaj da nešto nedostaje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tens vincles emocionals forts amb les festes — cosa que pot ser alliberadora o fer-te sentir que et falta alguna cosa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke svátkům nemáš silné citové pouto – což může osvobozovat, nebo v tobě nechávat pocit, že něco chybí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does gen ti ddim cysylltiad emosiynol cryf â gwyliau — a gall hynny fod yn rhyddhad, neu wneud i ti deimlo bod rhywbeth ar goll."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke stærke følelsesmæssige bånd til højtider – det kan føles befriende, eller som om der mangler noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast keine starke emotionale Bindung an Feiertage – das kann befreiend sein oder sich anfühlen, als würde etwas fehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχεις έντονους συναισθηματικούς δεσμούς με τις γιορτές — κάτι που μπορεί να είναι απελευθερωτικό ή να σου αφήνει την αίσθηση ότι κάτι λείπει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes un fuerte vínculo emocional con las fiestas, lo cual puede ser liberador o hacerte sentir que falta algo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul pole pühadega tugevat emotsionaalset sidet — mis võib olla vabastav või jätta tunde, et midagi on puudu."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez duzu lotura emozional handirik jaiekin. Horrek askatasuna eman diezazuke, edo zerbait falta dela sentiarazi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیوند عاطفی محکمی با تعطیلات نداری — که می‌تواند حس آزادی بدهد یا این حس را که چیزی کم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole vahvoja tunnesiteitä juhlapyhiin – se voi olla vapauttavaa tai jättää tunteen, että jotain puuttuu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala kang matinding emosyonal na koneksyon sa mga holiday — puwedeng nakakapagpalaya ito o nag-iiwan ng pakiramdam na may kulang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'as pas de lien émotionnel fort avec les fêtes, ce qui peut être libérateur ou te laisser l'impression qu'il manque quelque chose."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl ceangal mothúchánach láidir agat le laethanta saoire — rud a d’fhéadfadh a bheith saor nó mothú a fhágáil ort go bhfuil rud éigin in easnamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tes un vínculo emocional forte coas festas, o que pode ser liberador ou deixarche a sensación de que falta algo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તહેવારો સાથે તમારો કોઈ મજબૂત લાગણીનો નાતો નથી — જે મુક્તિ જેવું લાગી શકે, કે કંઈક ખૂટતું હોય એવું પણ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba ku da ƙaƙƙarfar alaƙar zuci da bukukuwa — wanda zai iya ba ku 'yanci ko ya sa ku ji kamar akwai abin da ya rasa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לך קשר רגשי חזק לחגים — וזה יכול לשחרר, או להשאיר תחושה שמשהו חסר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्योहारों से आपका कोई गहरा भावनात्मक जुड़ाव नहीं है — यह आज़ादी जैसा भी लग सकता है, या कुछ कमी जैसा भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemaš jaku emocionalnu vezu s blagdanima – što može biti oslobađajuće ili ostaviti osjećaj da nešto nedostaje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pa gen gwo lyen emosyonèl ak fèt yo — sa ka ba ou libète oswa fè ou santi yon bagay manke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs erős érzelmi kötődésed az ünnepekhez – ez lehet felszabadító, de az is lehet, hogy úgy érzed, hiányzik valami."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տոների հետ ուժեղ հուզական կապ չունես։ Դա կարող է ազատություն տալ, կամ էլ թողնել զգացում, որ ինչ-որ բան պակասում է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak punya ikatan emosional yang kuat dengan hari raya — itu bisa membebaskan, atau membuatmu merasa ada yang kurang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezumike anaghị emetụta obi gị nke ukwuu — nke ahụ nwere ike inye nnwere onwe ma ọ bụ mee ka ọ dị gị ka ihe na-efu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú hefur ekki sterk tilfinningatengsl við hátíðir – sem getur verið frelsandi eða skilið eftir tilfinningu um að eitthvað vanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai un forte legame emotivo con le feste — può essere liberatorio, o lasciarti la sensazione che manchi qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祝日に強い思い入れがないタイプ。それは身軽さにもなれば、何か物足りなさを感じることにもなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ora duwe iketan ati sing kuwat karo dina riyaya — sing bisa krasa bebas utawa nggawe rumangsa ana sing kurang."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დღესასწაულებთან ძლიერი ემოციური კავშირი არ გაქვს — ეს შეიძლება გათავისუფლებდეს ან რაღაცის ნაკლებობის განცდას გიტოვებდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мерекелерге қатты эмоциялық байланысың жоқ, бұл еркіндік сыйлауы да, бір нәрсе жетіспейтіндей сезім қалдыруы да мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមិនសូវមានចំណងអារម្មណ៍ខ្លាំងជាមួយថ្ងៃបុណ្យទេ — ដែលអាចធ្វើឲ្យអ្នកមានសេរីភាព ឬមានអារម្មណ៍ថាខ្វះអ្វីមួយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಬ್ಬಗಳ ಜೊತೆ ನಿಮಗೆ ಗಾಢವಾದ ಭಾವನಾತ್ಮಕ ನಂಟಿಲ್ಲ — ಅದು ಬಿಡುಗಡೆಯಂತೆಯೂ ಅನಿಸಬಹುದು, ಏನೋ ಕೊರತೆಯಂತೆಯೂ ಅನಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명절에 큰 감정적 애착이 없어요. 그게 홀가분할 수도 있고, 뭔가 빠진 느낌이 들 수도 있죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girêdanên te yên hestyarî yên xurt bi cejnan re tune ne — ev dikare te azad bike an jî bihêle ku tu hîs bikî tiştek kêm e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Майрамдар менен күчтүү эмоционалдык байланышың жок — бул эркиндик бериши же бир нерсе жетишпегендей сезим калтырышы мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hues keng staark emotional Bindung u Feierdeeg — dat kann befreiend sinn oder d'Gefill hannerloossen, dass eppes feelt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າບໍ່ມີຄວາມຜູກພັນທາງໃຈກັບວັນບຸນຫຼາຍ — ເຊິ່ງອາດເຮັດໃຫ້ຮູ້ສຶກອິດສະລະ ຫຼື ຮູ້ສຶກວ່າຂາດບາງຢ່າງໄປ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neturi stipraus emocinio ryšio su šventėmis – tai gali išlaisvinti arba palikti jausmą, kad kažko trūksta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev nav spēcīgas emocionālas saiknes ar svētkiem – tas var atbrīvot vai radīt sajūtu, ka kaut kā pietrūkst."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy dia mifamatotra mafy amin'ny fety ianao ara-pihetseham-po — mety hanafaka anao izany na hahatonga anao hahatsapa fa misy zavatra tsy ampy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore ōu hononga ā-ngākau kaha ki ngā hararei — ka taea pea te whakawātea, te waiho rānei i a koe me te āhua o tētahi mea e ngaro ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немаш силна емоционална врска со празниците — што може да ослободува или да те остави со чувство дека нешто недостасува."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിശേഷദിവസങ്ങളോട് നിങ്ങൾക്ക് വലിയ വൈകാരിക ബന്ധമില്ല — അത് സ്വാതന്ത്ര്യമായി തോന്നാം, അല്ലെങ്കിൽ എന്തോ നഷ്ടപ്പെട്ടതുപോലെ തോന്നാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи баяр ёслолтой сэтгэлийн хүчтэй холбоогүй — энэ нь чөлөөтэй ч байж болно, ямар нэг юм дутуу мэт санагдуулж ч болно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सणांशी तुमचे भावनिक नाते फारसे घट्ट नाही — यामुळे मोकळे वाटू शकते, किंवा काहीतरी कमी असल्यासारखे वाटू शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak terikat secara emosi dengan perayaan — ini boleh terasa membebaskan atau membuat anda rasa ada sesuatu yang kurang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'għandekx rabtiet emozzjonali qawwija mal-festi — dan jista' jagħtik libertà jew iħallik tħoss li xi ħaġa nieqsa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပိတ်ရက်တွေနဲ့ စိတ်ပိုင်း သိပ်မနှောင်ဖွဲ့ထားဘူး — ဒါက လွတ်လပ်စေနိုင်သလို တစ်ခုခု လိုနေသလို ခံစားရစေနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke sterke følelsesbånd til høytider – det kan være befriende, eller gi en følelse av at noe mangler."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चाडपर्वसँग तपाईंको गहिरो भावनात्मक नाता छैन — जसले स्वतन्त्र पनि बनाउन सक्छ, वा केही कमी भएजस्तो पनि लगाउन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geen sterke emotionele band met feestdagen – dat kan bevrijdend zijn, of het gevoel geven dat er iets ontbreekt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuli omangika kwambiri ndi maholide — zomwe zingakhale ufulu kapena zingakusiyeni mukumva ngati china chake chikusowa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayyaanota wajjin hidhata miiraa cimaa hin qabdu — kun bilisa si gochuu ykn waan tokko akka hir'ate sitti dhaga'amsiisuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଛୁଟି ସହ ଆପଣଙ୍କ ଗଭୀର ଭାବନାତ୍ମକ ବନ୍ଧନ ନାହିଁ — ଯାହା ମୁକ୍ତି ଦେଇପାରେ, କିମ୍ବା କିଛି ଅଭାବ ଥିବା ଭଳି ଲାଗିପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤਿਉਹਾਰਾਂ ਨਾਲ ਤੁਹਾਡਾ ਕੋਈ ਡੂੰਘਾ ਜਜ਼ਬਾਤੀ ਰਿਸ਼ਤਾ ਨਹੀਂ — ਇਹ ਆਜ਼ਾਦੀ ਵੀ ਦੇ ਸਕਦਾ ਹੈ ਜਾਂ ਕਿਸੇ ਕਮੀ ਦਾ ਅਹਿਸਾਸ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz silnych emocjonalnych więzi ze świętami – to może dawać wolność albo zostawiać poczucie, że czegoś brakuje."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له رخصتیو سره مو قوي احساسي تړاو نشته — چې کېدای شي ازادي درکړي یا دا احساس چې یو څه کم دي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não tem um grande vínculo emocional com datas comemorativas — o que pode ser libertador ou deixar a sensação de que falta algo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tens grandes laços emocionais com as festas — o que pode ser libertador ou deixar-te a sentir que falta algo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ai legături emoționale puternice cu sărbătorile — ceea ce poate fi eliberator sau îți poate lăsa senzația că lipsește ceva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя нет сильной эмоциональной привязки к праздникам — это может освобождать, а может оставлять ощущение, что чего-то не хватает."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntufite isano ikomeye y'amarangamutima n'iminsi mikuru — ibyo bishobora kukubohora cyangwa bigatuma wumva hari ikibura."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නිවාඩු දවස් එක්ක ඔබට ප්‍රබල හැඟීම්බර බැඳීමක් නැහැ — ඒක නිදහසක් වෙන්නත් පුළුවන්, නැත්නම් මොකක්හරි අඩුවක් දැනෙන්නත් පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sviatkami ťa neviažu silné emócie – čo môže byť oslobodzujúce, alebo ti môže niečo chýbať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazniki ti čustveno ne pomenijo veliko – kar je lahko osvobajajoče ali pa pušča občutek, da nekaj manjka."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauna hukama hwakasimba hwemanzwiro nemazororo — izvo zvingakusunungura kana kukusiya uchinzwa sekuti pane chiri kushaikwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasaxyada xiriir dareen oo xooggan lama lihid — taasi waxay noqon kartaa xorriyad ama waxay kaa dhigi kartaa qof dareema in wax maqan yihiin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk ke lidhje të forta emocionale me festat – gjë që mund të të çlirojë ose të të lërë me ndjesinë se diçka mungon."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немаш јаку емотивну везу с празницима — што може да ослобађа или да остави осећај да нешто недостаје."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun teu gaduh beungkeutan émosional anu kuat kana dinten raya; éta tiasa ngabébaskeun, atanapi ngajantenkeun anjeun ngaraos aya anu kirang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inga starka känslomässiga band till högtider – vilket kan kännas befriande eller som att något saknas."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huna mafungamano makubwa ya kihisia na sikukuu — jambo linaloweza kukuweka huru au kukuacha ukihisi kuna kitu kinakosekana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பண்டிகைகளுடன் உங்களுக்கு வலுவான உணர்வுப் பிணைப்பு இல்லை — அது விடுதலையாகவும் இருக்கலாம், ஏதோ குறைவது போலவும் தோன்றலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పండుగలతో మీకు బలమైన భావోద్వేగ అనుబంధం లేదు — అది స్వేచ్ఛనివ్వొచ్చు, లేదా ఏదో లోటుగా అనిపించవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ба идҳо пайванди эҳсосии қавӣ надорӣ — ин метавонад озодкунанда бошад ё ҳисси камбудӣ орад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ได้ผูกพันทางใจกับวันหยุดมากนัก ซึ่งอาจรู้สึกเป็นอิสระ หรือรู้สึกเหมือนขาดอะไรไป"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስ በዓላት ሓያል ስምዒታዊ ርክብ የብልኩምን — እዚ ናጻ ክገብረኩም ወይ ገለ ነገር ከም ዝጎደለ ክስምዓኩም ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baýramlar bilen güýçli duýgy baglanyşygyň ýok — bu seni azat edip biler ýa-da bir zat ýetmeýän ýaly duýdurup biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel günlere güçlü duygusal bağın yok. Bu özgürleştirici olabilir ya da bir şeylerin eksik olduğunu hissettirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свята не мають для тебе сильного емоційного значення — це може звільняти, а може залишати відчуття, що чогось бракує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تہواروں سے آپ کا گہرا جذباتی لگاؤ نہیں، جو آزادی کا احساس بھی دے سکتا ہے، یا کسی کمی کا بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayramlarga kuchli hissiy bogʻliqligingiz yoʻq — bu erkinlik berishi yoki nimadir yetishmayotgandek his qildirishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không gắn bó nhiều về cảm xúc với các dịp lễ — điều này có thể khiến bạn thấy tự do, hoặc thấy như thiếu một điều gì đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awunabo ubudlelwane obunamandla beemvakalelo neeholide — nto leyo inokukukhulula okanye ikushiye uziva ngathi kukho into engekhoyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kò so mọ́ ọjọ́ ìsinmi ní ọkàn gidigidi — èyí lè fún yín ní òmìnira tàbí kí ó jẹ́ kí ẹ rò pé nǹkan kan ń bẹ tó kù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你對節日沒有強烈的情感連繫——這可以是一種自由，也可能讓你覺得少了些甚麼。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对节日没有很深的情感联结，这可能让你很自在，也可能让你觉得少了点什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你對節日沒有強烈的情感連結。這可能讓你很自在，也可能讓你覺得少了點什麼。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awunabo ubudlelwano obuqinile bemizwa namaholide — lokho kungakukhulula noma kukushiye uzizwa sengathi kukhona okushodayo."
          }
        }
      }
    },
    "You don't need solutions — you need to feel held. Sometimes the most comforting thing is just being there without words." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy het nie oplossings nodig nie – jy wil vasgehou voel. Soms is die troostendste ding net om daar te wees, sonder woorde."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መፍትሔ አያስፈልግዎትም — እንደታቀፉ መሰማት ያስፈልግዎታል። አንዳንዴ በጣም የሚያጽናናው ያለቃላት አብሮ መሆን ብቻ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتاجون إلى حلول، بل إلى الشعور بالاحتواء. أحيانًا يكون مجرد الوجود بلا كلام هو أكثر ما يواسي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাক সমাধান নালাগে — আপুনি সাৱটি ধৰা যেন অনুভৱ কৰিব বিচাৰে। কেতিয়াবা কোনো কথা নোকোৱাকৈ কাষত থকাটোৱেই আটাইতকৈ সান্ত্বনাদায়ক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sənə həll yolu yox, isti bir qucaq lazımdır. Bəzən ən təsəlliverici şey sözsüz yanında olmaqdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе не патрэбныя рашэнні — табе трэба адчуць, што цябе трымаюць у абдымках. Часам найлепшая суцеха — проста быць побач без слоў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нямаш нужда от решения – нужно ти е да усетиш, че някой те държи. Понякога най-утешителното е просто да си до някого без думи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার সমাধান লাগে না — লাগে কেউ আগলে রাখছে, এই অনুভূতি। কখনো কখনো কথা ছাড়া শুধু পাশে থাকাটাই সবচেয়ে বড় সান্ত্বনা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne trebaju ti rješenja – treba ti osjećaj da te neko drži. Ponekad najviše utješi samo prisustvo, bez riječi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necessites solucions — necessites sentir que algú et sosté. De vegades el que més reconforta és simplement ser-hi, sense paraules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepotřebuješ řešení – potřebuješ cítit, že tě někdo drží. Nejvíc utěší někdy prostě být spolu beze slov."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does dim angen atebion arnat ti — mae angen i ti deimlo dy fod yn cael dy ddal. Weithiau'r peth mwyaf cysurus yw bod yno heb eiriau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke brug for løsninger – du har brug for at blive holdt om. Nogle gange er det mest trøstende bare at være der uden ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst keine Lösungen – du willst dich gehalten fühlen. Manchmal tröstet es am meisten, einfach wortlos da zu sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεσαι λύσεις — χρειάζεσαι να σε κρατήσουν. Μερικές φορές το πιο παρηγορητικό είναι απλώς να είναι κάποιος εκεί, χωρίς λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas soluciones: necesitas sentir que te sostienen. A veces lo que más reconforta es simplemente estar ahí, sin palabras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei vaja lahendusi — sa tahad tunda, et sind hoitakse. Vahel on kõige lohutavam lihtsalt kohal olla, ilma sõnadeta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez duzu konponbiderik behar — babestua sentitu behar duzu. Batzuetan, gauzarik goxagarriena hor egotea da, hitzik gabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راه‌حل نمی‌خواهی — می‌خواهی در آغوش گرفته شوی. گاهی آرام‌بخش‌ترین کار فقط بودن است، بی هیچ حرفی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kaipaa ratkaisuja – haluat tuntea, että sinua pidetään sylissä. Joskus lohdullisinta on vain olla läsnä ilman sanoja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo kailangan ng solusyon — kailangan mong maramdamang niyayakap ka. Minsan, ang pinakanakaaaliw ay ang basta nandiyan nang walang salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'as pas besoin de solutions, tu as besoin qu'on te prenne dans ses bras. Parfois, le plus réconfortant, c'est simplement d'être là, sans rien dire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní réitigh atá uait — ach mothú go bhfuil greim ort. Uaireanta is é an rud is mó sólás ná a bheith ann gan focal."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non precisas solucións: precisas sentir que te abrazan. Ás veces o que máis reconforta é simplemente estar aí, sen palabras."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારે ઉકેલ નથી જોઈતા — તમારે અનુભવવું છે કે કોઈ તમને સંભાળી રહ્યું છે. ક્યારેક સૌથી મોટી રાહત બસ શબ્દો વગર સાથે હોવામાં હોય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba mafita kuke buƙata ba — kuna buƙatar jin an riƙe ku. Wani lokaci abin da ya fi kwantar da hankali shi ne kasancewa a wurin kawai ba tare da magana ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתרונות זה לא מה שחסר לך — מה שחסר זה להרגיש שמחזיקים אותך. לפעמים הדבר הכי מנחם הוא פשוט להיות שם, בלי מילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको हल नहीं, अपनापन चाहिए। कभी-कभी सबसे बड़ी तसल्ली बस बिना कुछ कहे पास होना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne trebaju ti rješenja – trebaš osjetiti da te netko drži. Ponekad najviše utješi samo to da je netko uz tebe, bez riječi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pa bezwen solisyon — ou bezwen santi yo kenbe ou. Pafwa, pi bon rekonfò a se jis la san di anyen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem megoldásra van szükséged, hanem arra, hogy átöleljenek. Néha az a legnagyobb vigasz, ha valaki szavak nélkül melletted van."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քեզ լուծումներ պետք չեն — պետք է զգալ, որ քեզ գրկել են։ Երբեմն ամենամխիթարողը պարզապես առանց բառերի կողքին լինելն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu nggak butuh solusi — kamu butuh merasa didekap. Kadang hal paling menenangkan cuma hadir tanpa kata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị chọghị ngwọta — ị chọrọ ka a jide gị. Mgbe ụfọdụ, ihe kacha akasị obi bụ naanị ịnọ ya n'ekwughị okwu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú þarft ekki lausnir – þú þarft að finna að einhver heldur utan um þig. Stundum er mesta huggunin bara að vera til staðar án orða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti servono soluzioni — ti serve un abbraccio che ti contenga. A volte la cosa più confortante è semplicemente esserci, senza parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決策ではなく、包まれている安心感がほしいタイプです。言葉なしにただそばにいてくれることが、いちばんの慰めになることもあります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ora butuh solusi — panjenengan butuh rumangsa dirangkul. Kadhang sing paling nentremake mung ana ing sandhinge tanpa tembung."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოსავალი არ გჭირდება — გჭირდება, იგრძნო, რომ გეხუტებიან. ზოგჯერ ყველაზე დიდი ნუგეში უბრალოდ უსიტყვოდ გვერდით ყოფნაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саған шешім керек емес — құшақта болғаныңды сезгің келеді. Кейде ең үлкен жұбаныш — сөзсіз қасыңда болу."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមិនត្រូវការដំណោះស្រាយទេ — អ្នកត្រូវការអារម្មណ៍ថាមាននរណាម្នាក់ឱបក្រសោប។ ពេលខ្លះ អ្វីដែលលួងលោមចិត្តបំផុតគឺគ្រាន់តែនៅក្បែរគ្នាដោយមិនបាច់និយាយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ಪರಿಹಾರಗಳು ಬೇಕಿಲ್ಲ — ಯಾರೋ ಆಸರೆಯಾಗಿದ್ದಾರೆ ಎಂಬ ಭಾವ ಬೇಕು. ಕೆಲವೊಮ್ಮೆ ಮಾತಿಲ್ಲದೆ ಜೊತೆಗಿರುವುದೇ ಅತಿ ದೊಡ್ಡ ಸಮಾಧಾನ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해결책보다 따뜻하게 안기는 느낌이 필요해요. 때로는 말없이 곁에 있어 주는 게 가장 큰 위로예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne li çareseriyan digerî — tu dixwazî xwe di nav hembêzekê de hîs bikî. Carinan tiştê herî rehetker tenê li wir bûn e, bê gotin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сага чечим керек эмес — бирөөнүн кучагында экениңди сезүү керек. Кээде эң чоң сооротуу — сөзсүз эле жанында болуу."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchs keng Léisungen — du wëlls dech gehale fillen. Heiansdo ass dat Tréischtendst, einfach do ze sinn, ouni Wierder."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າບໍ່ຕ້ອງການທາງອອກ — ເຈົ້າຕ້ອງການຮູ້ສຶກວ່າມີຄົນໂອບກອດ ບາງເທື່ອສິ່ງທີ່ອົບອຸ່ນທີ່ສຸດກໍຄືການຢູ່ຂ້າງກັນໂດຍບໍ່ຕ້ອງເວົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau nereikia sprendimų – tau reikia šilto glėbio. Kartais labiausiai paguodžia paprasčiausias buvimas šalia be žodžių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev nevajag risinājumus – tev vajag sajust, ka tevi tur rokās. Dažreiz vislielākais mierinājums ir vienkārši būt blakus bez vārdiem."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy vahaolana no ilainao — fa ny hahatsapa ho voafihina. Indraindray, ny fanatrehana tsy misy teny no tena mampionona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore koe e hiahia ana ki ngā rongoā — ko tāu he rongo kua puritia koe. I ētahi wā, ko te mea tino whakamārie ko te noho tahi noa me te kore kupu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не ти требаат решенија — ти треба да се чувствуваш прегрнато. Понекогаш најутешно е само да бидеш тука, без зборови."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾക്ക് പരിഹാരങ്ങളല്ല വേണ്ടത് — ചേർത്തുപിടിക്കപ്പെടുന്നു എന്ന തോന്നലാണ്. ചിലപ്പോൾ വാക്കുകളില്ലാതെ കൂടെയിരിക്കുന്നതാണ് ഏറ്റവും വലിയ ആശ്വാസം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чамд шийдэл биш — тэвэрч байгааг мэдрэх хэрэгтэй. Заримдаа хамгийн их тайвшруулдаг зүйл бол үг хэлэлгүй дэргэд байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला उपाय नकोत — कोणीतरी जवळ घेतल्याची भावना हवी. कधी कधी शब्दांशिवाय फक्त सोबत असणे हेच सर्वात मोठे सांत्वन असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak perlukan penyelesaian — anda perlu rasa didakap. Kadangkala perkara paling menenangkan ialah hadir di sisi tanpa kata-kata."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'għandekx bżonn soluzzjonijiet — għandek bżonn tħossok f'idejn sħan. Xi drabi l-akbar faraġ huwa sempliċiment li tkun hemm, mingħajr kliem."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် ဖြေရှင်းနည်းတွေ မလိုပါဘူး — ပွေ့ဖက်ထားခံရတယ်လို့ ခံစားဖို့ လိုတာပါ။ တစ်ခါတလေ အနှစ်သိမ့်ရဆုံးက စကားမပြောဘဲ အနားမှာ ရှိနေပေးတာပါပဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke løsninger – du trenger å bli holdt. Noen ganger er det mest trøstende å bare være der, uten ord."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंलाई समाधान चाहिँदैन — कसैले समातिदिएको महसुस चाहिन्छ। कहिलेकाहीँ शब्दबिनै साथमा हुनु सबैभन्दा ठूलो सान्त्वना हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft geen oplossingen – je wilt je vastgehouden voelen. Soms is er gewoon zijn, zonder woorden, het meest troostend."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simufuna mayankho — mumafuna kumva kuti mwagwiridwa. Nthawi zina chotonthoza kwambiri ndi kungokhalapo popanda mawu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furmaata hin barbaaddu — akka hammatamte sitti dhaga'amuu barbaadda. Yeroo tokko tokko waan caalaatti nama jajjabeessu jecha malee bira jiraachuu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କୁ ସମାଧାନ ଦରକାର ନାହିଁ — ଆପଣଙ୍କୁ କେହି ଧରି ରଖିବା ଦରକାର। ବେଳେବେଳେ ଶବ୍ଦ ବିନା କେବଳ ପାଖରେ ରହିବା ହିଁ ସବୁଠୁ ବଡ଼ ସାନ୍ତ୍ୱନା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਨੂੰ ਹੱਲ ਨਹੀਂ ਚਾਹੀਦੇ — ਤੁਹਾਨੂੰ ਇਹ ਅਹਿਸਾਸ ਚਾਹੀਦਾ ਹੈ ਕਿ ਕਿਸੇ ਨੇ ਤੁਹਾਨੂੰ ਸੰਭਾਲਿਆ ਹੋਇਆ ਹੈ। ਕਈ ਵਾਰ ਸਭ ਤੋਂ ਵੱਡੀ ਤਸੱਲੀ ਬਿਨਾਂ ਕੁਝ ਕਹੇ ਬੱਸ ਕੋਲ ਹੋਣਾ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie potrzebujesz rozwiązań – potrzebujesz czułości i bliskości. Czasem najbardziej koi sama obecność, bez słów."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو حل ته اړتیا نه لرئ — تاسو د یوې غېږې ګرمي غواړئ. ځینې وخت تر ټولو ډاډ ورکوونکی کار همدا دی چې یو څوک بې له خبرو درسره وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não precisa de soluções — precisa de colo. Às vezes, o maior conforto é só estar junto, sem palavras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisas de soluções — precisas de colo. Às vezes, o mais reconfortante é simplesmente estar lá, sem palavras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ai nevoie de soluții — ai nevoie să te țină cineva în brațe. Uneori, cel mai mult te alină o prezență fără cuvinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе не нужны решения — тебе нужно, чтобы тебя обняли. Иногда лучшее утешение — просто быть рядом без слов."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntukeneye ibisubizo — ukeneye kumva wakiriwe. Rimwe na rimwe ikintu gihumuriza kurusha ibindi ni ukuba uhari gusa nta magambo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබට ඕනේ විසඳුම් නෙවෙයි — කවුරුහරි ඔබව තුරුලු කරගෙන ඉන්නවා කියලා දැනෙන්න. සමහර වෙලාවට වැඩියෙන්ම සනසන්නේ වචන නැතුව ළඟින් ඉන්න එකයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepotrebuješ riešenia – potrebuješ cítiť oporu. Niekedy najviac uteší obyčajná prítomnosť bez slov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne potrebuješ rešitev – potrebuješ občutek, da te nekdo drži. Včasih je najbolj tolažilno preprosto biti tu, brez besed."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haudi mhinduro — unoda kunzwa wakambundirwa. Dzimwe nguva chinonyaradza kupfuura zvose kungovapo pasina mazwi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xalal uma baahnid — waxaad u baahan tahay inaad dareento in lagu haysto. Mararka qaarkood waxa ugu raaxada badan waa joogitaan aan erayo lahayn."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk të duhen zgjidhje – të duhet të ndiesh se dikush të mban pranë. Ndonjëherë gjëja më ngushëlluese është thjesht të jesh aty pa fjalë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не требају ти решења — треба ти да осетиш да те неко држи. Понекад највише теши само присуство, без речи."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun henteu peryogi solusi — anjeun peryogi ngarasa dirangkul. Sakapeung anu paling ngalipur téh ngan saukur aya, tanpa kecap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inga lösningar – du behöver känna dig omhållen. Ibland är det mest tröstande att bara finnas där, utan ord."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huhitaji suluhisho — unahitaji kujisikia umekumbatiwa. Wakati mwingine faraja kubwa ni kuwepo tu bila maneno."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுக்குத் தீர்வுகள் தேவையில்லை — அரவணைக்கப்பட்டதாக உணர வேண்டும். சில நேரங்களில் வார்த்தைகள் இல்லாமல் அருகில் இருப்பதே மிகப் பெரிய ஆறுதல்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు పరిష్కారాలు అక్కర్లేదు — ఎవరో పట్టుకుని ఉన్నారని అనిపించాలి. కొన్నిసార్లు మాటలు లేకుండా పక్కన ఉండటమే గొప్ప ఓదార్పు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба ту ҳал лозим нест — ту бояд ҳис кунӣ, ки туро нигоҳ медоранд. Баъзан аз ҳама тасаллибахш танҳо бе сухан дар паҳлӯ будан аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ได้ต้องการทางแก้ แต่อยากรู้สึกว่ามีคนโอบไว้ บางครั้งสิ่งที่ปลอบใจที่สุดก็คือการอยู่ข้างกันโดยไม่ต้องพูดอะไร"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፍታሕ ኣየድልየኩምን — ከም እተሓቘፍኩም ክስምዓኩም እዩ ዘድልየኩም። ገለ ግዜ እቲ ዝበለጸ ምጸናንዕ ብዘይ ቃላት ኣብ ጎንኹም ምህላው እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saňa çözgüt gerek däl — gujaklanmak duýgusy gerek. Käwagt iň köp teselli berýän zat — sözsüz ýanyňda bolmak."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çözüme değil, sarmalanmış hissetmeye ihtiyacın var. Bazen en teselli edici şey, söze gerek duymadan orada olmak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі не потрібні рішення — тобі треба відчути, що тебе пригортають. Іноді найбільша втіха — просто бути поруч без слів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو حل کی ضرورت نہیں — آپ کو تھامے جانے کا احساس چاہیے۔ کبھی کبھی سب سے بڑی تسلی بس بغیر الفاظ کے پاس ہونا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizga yechim kerak emas — bagʻriga bosilganingizni his qilishingiz kerak. Baʼzan eng katta taskin — soʻzsiz yoningizda boʻlish."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không cần giải pháp — bạn cần được ôm ấp. Đôi khi điều an ủi nhất chỉ là ở bên nhau, không cần lời nào."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awudingi zisombululo — udinga ukuziva ugonwe. Ngamanye amaxesha eyona nto ithuthuzelayo kukuba khona nje ngaphandle kwamazwi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kò nílò ojútùú — ẹ nílò láti mọ̀ pé ẹnìkan dì yín mú. Nígbà mìíràn, ohun tó ń tuni nínú jù ni wíwà níbẹ̀ láìsọ̀rọ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要的不是解決方法，而是被好好抱住。有時最安慰人的，就是不說話地陪在身邊。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不需要解决办法，你需要被抱着。有时最好的安慰，就是什么都不说地陪在身边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要的不是解決辦法，而是被好好抱著。有時最安慰人的，就是不說話地陪在身邊。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awudingi izixazululo — udinga ukuzizwa wangiwe. Kwesinye isikhathi into eduduza kakhulu ukuba khona nje ngaphandle kwamazwi."
          }
        }
      }
    },
    "You feel safer with a plan. That's not a character flaw — it's how you manage anxiety and perform at your best." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy voel veiliger met ’n plan. Dis nie ’n karakterfout nie – dis hoe jy angs hanteer en op jou beste presteer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዕቅድ ሲኖር የበለጠ ደኅንነት ይሰማዎታል። ይህ የባሕርይ ጉድለት አይደለም — ጭንቀትዎን የሚቆጣጠሩበትና ምርጥ አቅምዎን የሚያወጡበት መንገድ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشعرون بأمان أكبر مع وجود خطة. هذا ليس عيبًا في الشخصية، بل طريقتكم في إدارة القلق وتقديم أفضل ما لديكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিকল্পনা থাকিলে আপুনি সুৰক্ষিত অনুভৱ কৰে। এয়া চৰিত্ৰৰ দোষ নহয় — এয়াই আপুনি উদ্বেগ চম্ভালি নিজৰ সৰ্বোত্তমটো দিয়াৰ উপায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan olanda özünü daha təhlükəsiz hiss edirsən. Bu, xarakter qüsuru deyil — narahatlığı idarə etmə və ən yaxşı halında olma üsulundur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З планам табе спакайней. Гэта не недахоп характару — так ты спраўляешся з трывогай і паказваеш найлепшы вынік."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С план се чувстваш по-сигурно. Това не е недостатък – а начинът, по който овладяваш тревогата и даваш най-доброто от себе си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ল্যান থাকলে তুমি বেশি নিশ্চিন্ত বোধ করো। এটা চরিত্রের দোষ নয় — এভাবেই তুমি উদ্বেগ সামলাও আর নিজের সেরাটা দাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S planom se osjećaš sigurnije. To nije mana karaktera – tako se nosiš s anksioznošću i daješ najbolje od sebe."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pla et dona seguretat. No és cap defecte — és com gestiones l'ansietat i com dones el millor de tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S plánem se cítíš bezpečněji. Není to chyba povahy – takhle zvládáš úzkost a podáváš nejlepší výkon."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n teimlo'n fwy diogel gyda chynllun. Nid gwendid cymeriad yw hynny — dyna sut rwyt ti'n rheoli pryder ac yn gwneud dy orau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du føler dig mere tryg med en plan. Det er ikke en karakterbrist – det er sådan, du håndterer uro og er bedst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Plan fühlst du dich sicherer. Das ist keine Charakterschwäche – so gehst du mit Unruhe um und bist in Bestform."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ένα πλάνο νιώθεις πιο ασφάλεια. Δεν είναι ελάττωμα — είναι ο τρόπος σου να διαχειρίζεσαι το άγχος και να δίνεις τον καλύτερό σου εαυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un plan sientes más seguridad. No es un defecto: es tu forma de gestionar la ansiedad y dar lo mejor de ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaaniga tunned end turvalisemalt. See pole iseloomuviga — nii maandad ärevust ja annad endast parima."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguruago sentitzen zara plan batekin. Ez da akatsa: horrela kudeatzen duzu antsietatea eta ematen duzu onena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با برنامه احساس امنیت بیشتری می‌کنی. این عیب شخصیتی نیست — راهی است که با آن اضطرابت را مدیریت می‌کنی و بهترین خودت هستی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnitelma tuo sinulle turvaa. Se ei ole luonteenvika – se on tapasi hallita jännitystä ja olla parhaimmillasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas panatag ka kapag may plano. Hindi iyan kapintasan — ganyan mo hinaharap ang pagkabalisa at naibibigay ang pinakamagaling mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan te rassure. Ce n'est pas un défaut : c'est ta façon de gérer l'anxiété et de donner le meilleur de toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mothaíonn tú níos sábháilte le plean. Ní locht pearsanta é sin — is é an chaoi a láimhseálann tú imní agus a n-éiríonn leat ar do dhícheall."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan dáche seguridade. Non é un defecto de carácter: é como xestionas a ansiedade e como dás o mellor de ti."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્લાન હોય તો તમે વધુ સલામત અનુભવો છો. એ સ્વભાવની ખામી નથી — એ રીતે તમે ચિંતા સંભાળો છો અને સૌથી સારું કામ કરો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna jin aminci idan akwai shiri. Wannan ba aibi ba ne — hanya ce ta sarrafa fargaba da yin iyakar ƙoƙarinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עם תוכנית יש לך יותר ביטחון. זה לא פגם באופי — זו הדרך שלך להתמודד עם חרדה ולהגיע למיטב שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लान हो, तो आपको ज़्यादा सुरक्षित लगता है। यह कोई कमी नहीं — यह बेचैनी संभालने और अपना सबसे अच्छा देने का आपका तरीक़ा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S planom se osjećaš sigurnije. To nije mana karaktera – tako se nosiš s tjeskobom i daješ najbolje od sebe."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou santi ou pi an sekirite ak yon plan. Se pa yon defo karaktè — se konsa ou jere enkyetid ou e ou bay pi bon ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy tervvel nagyobb biztonságban érzed magad. Ez nem jellemhiba – így kezeled a szorongást, és így hozod ki magadból a legjobbat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պլանի հետ քեզ ավելի ապահով ես զգում։ Դա բնավորության թերություն չէ, այլ անհանգստությունը կառավարելու և լավագույնս դրսևորվելու ձևդ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu merasa lebih aman dengan rencana. Itu bukan kekurangan — itu caramu mengelola cemas dan tampil sebaik mungkin."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obi na-adị gị jụụ karịa mgbe atụmatụ dị. Nke ahụ abụghị ntụpọ — ọ bụ otu i si achịkwa nchegbu ma rụọ ọrụ nke ọma."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú finnur fyrir meira öryggi með áætlun. Það er ekki galli – það er leiðin þín til að halda kvíðanum í skefjum og gera þitt besta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un piano ti senti più al sicuro. Non è un difetto — è il tuo modo di gestire l’ansia e dare il meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画があると安心できるタイプ。それは欠点ではなく、不安と上手につきあい、力を発揮するための方法です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan krasa luwih aman yen ana rencana. Iku dudu cacat watak — iku cara panjenengan ngatur rasa kuwatir lan tampil paling apik."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გეგმასთან ერთად თავს უფრო უსაფრთხოდ გრძნობ. ეს ხასიათის ნაკლი არ არის — ასე უმკლავდები შფოთვას და საუკეთესოდ მოქმედებ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоспар болса, өзіңді қауіпсіз сезінесің. Бұл мінездің кемшілігі емес, мазасыздықты басқарып, барыңды беру тәсілің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមានអារម្មណ៍សុវត្ថិភាពជាងពេលមានផែនការ។ នោះមិនមែនជាចំណុចខ្សោយនៃចរិតទេ — វាជារបៀបដែលអ្នកគ្រប់គ្រងការព្រួយបារម្ភ ហើយធ្វើបានល្អបំផុត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯೋಜನೆಯಿದ್ದಾಗ ನಿಮಗೆ ಸುರಕ್ಷಿತ ಅನಿಸುತ್ತದೆ. ಅದು ಸ್ವಭಾವದ ದೋಷವಲ್ಲ — ಆತಂಕವನ್ನು ನಿಭಾಯಿಸಿ, ನಿಮ್ಮ ಅತ್ಯುತ್ತಮವನ್ನು ಕೊಡುವ ನಿಮ್ಮ ರೀತಿ ಅದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획이 있을 때 마음이 편해요. 성격의 결점이 아니라 불안을 다스리고 최고의 모습을 보여 주는 방법이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi planekê tu xwe ewletir hîs dikî. Ev ne kêmasiyeke karakterê ye — ev awayê te ye ku tu fikarê birêve dibî û herî baş dixebitî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План болгондо өзүңдү коопсуз сезесиң. Бул мүнөздүн кемчилиги эмес — тынчсызданууну башкарып, эң жакшы абалда болуунун жолу."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat engem Plang fills du dech méi sécher. Dat ass kee Charakterfeeler — esou gees du mat Angscht ëm a bass op dengem Bescht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຮູ້ສຶກປອດໄພກວ່າເມື່ອມີແຜນ ນັ້ນບໍ່ແມ່ນຂໍ້ເສຍ — ມັນຄືວິທີທີ່ເຈົ້າຈັດການຄວາມກັງວົນ ແລະ ເຮັດໄດ້ດີທີ່ສຸດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su planu jautiesi saugiau. Tai ne charakterio yda – taip valdai nerimą ir atsiskleidi geriausiai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar plānu tu jūties drošāk. Tas nav rakstura trūkums – tā tu tiec galā ar trauksmi un vari dot savu labāko."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahatsiaro ho azo antoka kokoa ianao rehefa misy drafitra. Tsy kilema izany — fa fomba fifehezanao ny ahiahy sy fanaovanao tsara indrindra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka haumaru ake koe me tētahi mahere. Ehara tēnā i te hē o tō āhua — koinā tō whakahaere i te āwangawanga, me tō mahi i tōu pai rawa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со план се чувствуваш посигурно. Тоа не е маана — така се справуваш со вознемиреноста и даваш најдобро од себе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു പ്ലാൻ ഉള്ളപ്പോഴാണ് നിങ്ങൾക്ക് സുരക്ഷിതത്വം. അതൊരു സ്വഭാവദോഷമല്ല — ഉത്കണ്ഠ നിയന്ത്രിക്കാനും ഏറ്റവും നന്നായി പ്രവർത്തിക്കാനുമുള്ള നിങ്ങളുടെ രീതിയാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төлөвлөгөөтэй үед илүү аюулгүй мэдэрдэг. Энэ зан чанарын дутагдал биш — түгшүүрээ зохицуулж, хамгийн сайнаараа байх арга чинь."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजना असली की तुम्हाला सुरक्षित वाटते. हा स्वभावदोष नाही — अशा प्रकारे तुम्ही चिंता सांभाळता आणि सर्वोत्तम कामगिरी करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda rasa lebih selamat dengan rancangan. Itu bukan kelemahan diri — itu cara anda mengurus kebimbangan dan memberikan yang terbaik."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pjan jagħtik aktar sigurtà. Dan mhux difett fil-karattru — huwa l-mod kif timmaniġġja l-ansjetà u tagħti l-aħjar tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အစီအစဉ်ရှိရင် ပိုလုံခြုံတယ်လို့ ခံစားရတယ်။ ဒါ စရိုက်ချို့ယွင်းချက် မဟုတ်ဘူး — စိုးရိမ်စိတ်ကို ထိန်းပြီး အကောင်းဆုံး လုပ်ဆောင်နိုင်တဲ့ နည်းလမ်းပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du føler deg tryggere med en plan. Det er ingen karakterbrist – det er slik du håndterer uro og er på ditt beste."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजना हुँदा तपाईं सुरक्षित महसुस गर्नुहुन्छ। यो स्वभावको कमजोरी होइन — चिन्ता सम्हाल्ने र आफ्नो उत्कृष्ट दिने तपाईंको तरिका हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een plan voel je je veiliger. Dat is geen karakterfout – zo ga je om met spanning en presteer je op je best."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumamva otetezeka mukakhala ndi dongosolo. Si cholakwika cha khalidwe — ndi mmene mumalamulirira nkhawa ndi kuchita bwino kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karoora yoo qabaatte caalaatti nageenyi sitti dhaga'ama. Kun hir'ina amalaa miti — karaa ati itti yaaddoo to'attu fi akkaataa gaarii keetiin hojjettu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯୋଜନା ଥିଲେ ଆପଣ ଅଧିକ ସୁରକ୍ଷିତ ଅନୁଭବ କରନ୍ତି। ଏହା ଚରିତ୍ରର ଦୋଷ ନୁହେଁ — ଏହା ଆପଣ କିପରି ଚିନ୍ତା ସମ୍ଭାଳନ୍ତି ଓ ନିଜର ସର୍ବୋତ୍ତମ ଦିଅନ୍ତି, ତାହାର ଉପାୟ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਯੋਜਨਾ ਨਾਲ ਤੁਸੀਂ ਵੱਧ ਸੁਰੱਖਿਅਤ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ। ਇਹ ਕੋਈ ਕਮੀ ਨਹੀਂ — ਇਹ ਘਬਰਾਹਟ ਸੰਭਾਲਣ ਅਤੇ ਆਪਣਾ ਸਭ ਤੋਂ ਵਧੀਆ ਦੇਣ ਦਾ ਤੁਹਾਡਾ ਤਰੀਕਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z planem czujesz się bezpieczniej. To nie wada charakteru – tak radzisz sobie z niepokojem i działasz najlepiej."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له پلان سره ډېر ډاډ احساسوئ. دا د شخصیت نیمګړتیا نه ده — دا ستاسو د اندېښنې د ادارې او د خپل غوره کار لاره ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um plano, você sente mais segurança. Isso não é defeito — é como você lida com a ansiedade e rende melhor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um plano dá-te segurança. Não é um defeito de carácter — é como geres a ansiedade e dás o teu melhor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan îți dă siguranță. Nu e un defect de caracter — e felul în care îți gestionezi anxietatea și dai ce ai mai bun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С планом тебе спокойнее. Это не недостаток характера — так ты справляешься с тревогой и выкладываешься по максимуму."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wumva utekanye iyo ufite gahunda. Ibyo si inenge — ni uburyo bwawe bwo kugenzura impungenge no gukora neza kurushaho."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැලැස්මක් තියෙනකොට ඔබට වඩා ආරක්ෂිත බවක් දැනෙනවා. ඒක චරිතයේ අඩුපාඩුවක් නෙවෙයි — ඔබ කනස්සල්ල පාලනය කරලා හොඳින්ම වැඩ කරන හැටි ඒක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S plánom sa cítiš bezpečnejšie. To nie je chyba charakteru – takto zvládaš úzkosť a podávaš najlepší výkon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z načrtom se počutiš varneje. To ni značajska napaka – tako obvladuješ tesnobo in daješ najboljše od sebe."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unonzwa wakachengeteka kana pane hurongwa. Hakusi kukanganisa kwehunhu — ndiyo nzira yaunodzora nayo kunetseka uye kuita zvakanakisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qorshe ayaad ku dareentaa nabadgelyo. Taasi ma aha cillad dabeecadeed — waa sida aad u maareyso walwalka oo aad ugu shaqeyso sida ugu fiican."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një plan të jep siguri. Kjo nuk është e metë karakteri – është mënyra si e menaxhon ankthin dhe jep më të mirën."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С планом се осећаш сигурније. То није мана карактера — тако излазиш на крај с анксиозношћу и дајеш најбоље од себе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun ngaraos langkung aman upami aya rencana. Éta sanés kakirangan watek; éta cara anjeun ngatur kahariwang sareng nembongkeun anu pangsaéna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du känner dig tryggare med en plan. Det är inget karaktärsfel – det är så du hanterar oro och presterar som bäst."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unajisikia salama zaidi ukiwa na mpango. Hilo si kasoro ya tabia — ndivyo unavyodhibiti wasiwasi na kufanya vizuri zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டம் இருந்தால் பாதுகாப்பாக உணர்கிறீர்கள். அது குணக் குறைபாடு அல்ல — பதற்றத்தைக் கையாண்டு சிறப்பாகச் செயல்பட அது உங்கள் வழி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్లాన్ ఉంటే మీకు భద్రంగా అనిపిస్తుంది. అది లోపం కాదు — ఆందోళనను అదుపు చేసుకుని, మీ ఉత్తమ పనితీరు చూపే మీ తీరు అది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо нақша худро бехатартар ҳис мекунӣ. Ин айби хислат нест — ин роҳи идора кардани изтироб ва дар беҳтарин ҳолат будани туст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรู้สึกปลอดภัยเมื่อมีแผน นั่นไม่ใช่ข้อเสีย แต่เป็นวิธีจัดการความกังวลและช่วยให้คุณทำได้ดีที่สุด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስ መደብ ዝያዳ ውሑሳት ኮይኑ ይስምዓኩም። እዚ ጉድለት ባህሪ ኣይኮነን — ጭንቀትኩም እትቆጻጸሩሉን ዝበለጸ ዓቕምኹም እተርእዩሉን መንገዲ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meýilnama bilen özüňi has howpsuz duýýarsyň. Bu häsiýet kemçiligi däl — aladaňy dolandyrmagyň we iň gowy netije görkezmegiň ýoly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planla kendini daha güvende hissediyorsun. Bu bir kusur değil; kaygını yönetme ve en iyi halini ortaya koyma biçimin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З планом тобі спокійніше. Це не вада характеру — так ти справляєшся з тривогою і показуєш себе з найкращого боку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصوبہ ہو تو آپ کو زیادہ تحفظ محسوس ہوتا ہے۔ یہ کردار کی کمزوری نہیں، یہ آپ کا بے چینی سنبھالنے اور اپنا بہترین دینے کا طریقہ ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reja bilan oʻzingizni xavfsizroq his qilasiz. Bu xarakter kamchiligi emas — xavotirni boshqarish va eng yaxshi natija koʻrsatish usulingiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có kế hoạch giúp bạn thấy an tâm hơn. Đó không phải khuyết điểm — đó là cách bạn kiểm soát lo âu và làm tốt nhất."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uziva ukhuselekile ngakumbi xa unesicwangciso. Asibobuthathaka — yindlela olawula ngayo ixhala kwaye wenze kakuhle kakhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọkàn yín balẹ̀ jù pẹ̀lú ètò. Kì í ṣe àbùkù ìwà — bí ẹ ṣe ń ṣàkóso ìdààmú àti bí ẹ ṣe ń ṣe dáadáa jù ni."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有計劃讓你更有安全感。這不是性格缺陷，而是你管理焦慮、發揮最佳狀態的方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有计划才让你安心。这不是性格缺陷，而是你管理焦虑、发挥最好状态的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有計畫會讓你比較安心。這不是性格缺陷，而是你管理焦慮、發揮最好狀態的方式。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzizwa uphephile kakhulu uma kunohlelo. Lokho akusona isici esibi — kuyindlela ophatha ngayo ukukhathazeka futhi wenze konke ngokusemandleni akho."
          }
        }
      }
    },
    "You find funny in difficult places — but you punch toward the world, not toward vulnerable people. That distinction matters." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy vind die snaakse in moeilike plekke – maar jy mik na die wêreld, nie na kwesbare mense nie. Daardie onderskeid maak saak."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በከባድ ቦታዎች ውስጥ ቀልድ ያገኛሉ — ግን የሚቀልዱት በዓለም ላይ እንጂ በተጋላጭ ሰዎች ላይ አይደለም። ያ ልዩነት ወሳኝ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجدون الطرافة في الأماكن الصعبة، لكن سهامكم موجّهة إلى العالم لا إلى الضعفاء، وهذا الفرق مهم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কঠিন ঠাইতো আপুনি হাস্যৰস বিচাৰি পায় — কিন্তু আপুনি জগতখনক লৈ ঠাট্টা কৰে, দুৰ্বল মানুহক লৈ নহয়। এই পাৰ্থক্য গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çətin yerlərdə də gülməli tərəf tapırsan — amma zərbəni həssas insanlara yox, dünyaya yönəldirsən. Bu fərq önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты знаходзіш смешнае ў цяжкім — але жартуеш пра свет, а не пра ўразлівых людзей. Гэтая розніца важная."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намираш смешното на трудни места – но се шегуваш със света, а не с уязвимите. Тази разлика е важна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কঠিন জায়গাতেও তুমি মজা খুঁজে পাও — কিন্তু তোমার খোঁচা যায় দুনিয়ার দিকে, দুর্বল মানুষের দিকে নয়। এই তফাতটা জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smiješno pronalaziš na teškim mjestima – ali ciljaš na svijet, ne na ranjive ljude. Ta razlika je važna."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trobes l'humor en llocs difícils — però apuntes al món, no a les persones vulnerables. Aquesta diferència importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najdeš legraci i v těžkých chvílích – ale míříš na svět, ne na zranitelné. Na tom rozdílu záleží."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n dod o hyd i hiwmor mewn lleoedd anodd — ond rwyt ti'n anelu at y byd, nid at bobl fregus. Mae'r gwahaniaeth hwnnw'n bwysig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du finder det sjove de svære steder – men du sparker opad mod verden, ikke nedad mod de sårbare. Den forskel betyder noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du findest auch im Schweren etwas Komisches – aber du teilst gegen die Welt aus, nicht gegen Verletzliche. Dieser Unterschied zählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκεις το αστείο ακόμα και στα δύσκολα — αλλά τα βάζεις με τον κόσμο, όχι με τους ευάλωτους. Αυτή η διάκριση μετράει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentras la gracia en lugares difíciles, pero apuntas al mundo, no a las personas vulnerables. Esa diferencia importa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiad nalja keerulistes kohtades — aga su nooled lähevad maailma, mitte haavatavate inimeste suunas. See vahe on oluline."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leku zailetan aurkitzen duzu umorea, baina munduari egiten diozu barre, ez pertsona ahulei. Bereizketa horrek garrantzia du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در جاهای سخت هم چیز خنده‌دار پیدا می‌کنی — ولی شوخی‌ات رو به دنیاست، نه رو به آدم‌های آسیب‌پذیر. این تفاوت مهم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydät huumoria vaikeistakin paikoista – mutta suuntaat piikit maailmaan, et haavoittuvia ihmisiä kohti. Sillä erolla on merkitystä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakahanap ka ng katatawanan sa mabibigat na sitwasyon — pero ang mundo ang tinatamaan mo, hindi ang mga mahihina. Mahalaga ang pagkakaibang iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu trouves de quoi rire dans les moments difficiles, mais tu vises le monde, jamais les plus fragiles. Cette nuance compte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aimsíonn tú greann in áiteanna deacra — ach is ag an saol a dhíríonn tú é, ní ag daoine leochaileacha. Tá an t-idirdhealú sin tábhachtach."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atopas a graza en sitios difíciles, pero apuntas ao mundo, non ás persoas vulnerables. Esa diferenza importa."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે અઘરી જગ્યાઓમાં પણ રમૂજ શોધો છો — પણ નિશાન દુનિયા પર તાકો છો, નબળા લોકો પર નહીં. એ ફરક મહત્વનો છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna samun abin dariya a wurare masu wuya — amma kuna nufar duniya, ba masu rauni ba. Wannan bambanci na da muhimmanci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך יכולת למצוא הומור במקומות קשים — אבל החץ מכוון אל העולם, לא אל החלשים. ההבדל הזה חשוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुश्किल हालात में भी आपको हँसी मिल जाती है — पर आपका निशाना दुनिया पर होता है, कमज़ोर लोगों पर नहीं। यह फ़र्क़ मायने रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smiješno nalaziš na teškim mjestima – ali udaraš prema svijetu, ne prema ranjivima. Ta razlika je važna."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou jwenn sa ki komik nan kote ki difisil — men ou vize lemonn, pa moun ki fèb. Diferans sa a enpòtan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehéz helyzetekben is megtalálod a viccest – de a világot veszed célba, nem a kiszolgáltatott embereket. Ez a különbség számít."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու զավեշտալին գտնում ես դժվար տեղերում, բայց ծաղրում ես աշխարհը, ոչ թե խոցելի մարդկանց։ Այդ տարբերությունը կարևոր է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menemukan kelucuan di tempat-tempat sulit — tapi sasaranmu dunia, bukan orang yang rentan. Perbedaan itu penting."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ahụ ihe ọchị n'ebe siri ike — mana ị na-akwa ụwa emo, ọ bụghị ndị na-adịghị ike. Ọdịiche ahụ dị mkpa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú finnur grínið á erfiðum stöðum – en beinir því að heiminum, ekki að þeim sem standa höllum fæti. Sá munur skiptir máli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovi da ridere nei momenti difficili, ma prendi di mira il mondo, non chi è fragile. È una differenza che conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難しい状況にも笑いを見つけられる人。でも笑いの矛先は世の中に向けて、弱い立場の人には向けません。その線引きが大切です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan nemokake sing lucu ing papan sing angel — nanging sing diguyokake donya, dudu wong sing ringkih. Bedane iku penting."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სასაცილოს რთულ ადგილებშიც პოულობ — მაგრამ სამყაროს დასცინი და არა დაუცველ ადამიანებს. ეს განსხვავება მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қиын жерлерден де күлкі табасың, бірақ әзілің осал адамдарға емес, өмірдің өзіне бағытталған. Бұл айырмашылық маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នករកឃើញភាពកំប្លែងនៅក្នុងកន្លែងលំបាក — ប៉ុន្តែអ្នកចំអកដាក់ពិភពលោក មិនមែនដាក់មនុស្សងាយរងគ្រោះទេ។ ភាពខុសគ្នានោះសំខាន់ណាស់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಷ್ಟದ ಸನ್ನಿವೇಶಗಳಲ್ಲೂ ನೀವು ತಮಾಷೆ ಕಾಣುತ್ತೀರಿ — ಆದರೆ ನಿಮ್ಮ ಹಾಸ್ಯ ದುರ್ಬಲರ ಮೇಲಲ್ಲ, ಜಗತ್ತಿನ ಮೇಲೆ. ಆ ವ್ಯತ್ಯಾಸ ಮುಖ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힘든 상황에서도 웃음을 찾아내지만, 약한 사람이 아니라 세상을 향해 농담해요. 그 차이가 중요하죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu henekê di cihên zehmet de dibînî — lê tu li dinyayê dixî, ne li kesên lawaz. Ev cudahî girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оор нерселерден да күлкүлүүнү табасың — бирок осал адамдарды эмес, дүйнөнү шылдыңдайсың. Ошол айырма маанилүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fënns Witz op schwierege Plazen — mee du laachs iwwer d'Welt, net iwwer verletzlech Leit. Deen Ënnerscheed zielt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເຫັນຄວາມຕະຫຼົກໃນເລື່ອງທີ່ຍາກ — ແຕ່ເຈົ້າແຊວໂລກ ບໍ່ແມ່ນແຊວຄົນທີ່ອ່ອນແອ ຄວາມແຕກຕ່າງນີ້ສຳຄັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randi juokingų dalykų sunkiose vietose – bet taikaisi į pasaulį, o ne į pažeidžiamus žmones. Šis skirtumas svarbus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu atrodi smieklīgo grūtās vietās – bet tavi joki vēršas pret pasauli, nevis pret neaizsargātiem cilvēkiem. Šī atšķirība ir svarīga."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahita zavatra mampihomehy amin'ny toerana sarotra ianao — nefa izao tontolo izao no hikendrenao, fa tsy ny olona marefo. Zava-dehibe izany fanavahana izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka kitea e koe te kata i ngā wāhi uaua — engari ka whiu koe ki te ao, kaua ki te hunga whakaraerae. He mea nui taua rerekētanga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наоѓаш смешно и на тешки места — но шегата ја насочуваш кон светот, не кон ранливите луѓе. Таа разлика е важна."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രയാസമുള്ള ഇടങ്ങളിലും നിങ്ങൾ തമാശ കണ്ടെത്തുന്നു — പക്ഷേ നിങ്ങളുടെ കുത്ത് ലോകത്തിന് നേരെയാണ്, ദുർബലരായ ആളുകൾക്ക് നേരെയല്ല. ആ വ്യത്യാസം പ്രധാനമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэцүү зүйлсээс инээдтэйг нь олдог — гэхдээ эмзэг хүмүүсийг биш, ертөнцийг шоолдог. Энэ ялгаа чухал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कठीण प्रसंगांतही तुम्हाला विनोद सापडतो — पण तुमचा निशाणा जगावर असतो, दुर्बल लोकांवर नाही. हा फरक महत्त्वाचा आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda nampak kelucuan dalam situasi yang sukar — tetapi sasaran anda ialah dunia, bukan orang yang lemah. Perbezaan itu penting."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issib id-daħk f'postijiet diffiċli — imma tolqot lid-dinja, mhux lin-nies vulnerabbli. Dik id-distinzjoni tgħodd."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခက်ခဲတဲ့နေရာတွေမှာ ရယ်စရာကို ရှာတွေ့တယ် — ဒါပေမဲ့ အားနည်းသူတွေကို မဟုတ်ဘဲ ကမ္ဘာကြီးကိုသာ ပစ်မှတ်ထားတယ်။ အဲဒီ ကွာခြားချက်က အရေးကြီးတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du finner det morsomme på vanskelige steder – men du sikter mot verden, ikke mot sårbare folk. Den forskjellen betyr noe."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं कठिन ठाउँमा पनि हाँसो भेट्टाउनुहुन्छ — तर निसाना संसारतिर हुन्छ, कमजोर मान्छेतिर होइन। त्यो भिन्नता महत्त्वपूर्ण छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vindt humor op moeilijke plekken – maar je richt je pijlen op de wereld, niet op kwetsbare mensen. Dat verschil doet ertoe."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumapeza zoseketsa m'malo ovuta — koma mumaseka dziko, osati anthu ofooka. Kusiyana kumeneko ndi kofunika."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakka ulfaataa keessatti illee kolfa argatta — garuu namoota laafoo osoo hin taane addunyaatti qoosta. Garaagarummaan sun barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଠିନ ପରିସ୍ଥିତିରେ ବି ଆପଣ ମଜା ଖୋଜିପାଆନ୍ତି — କିନ୍ତୁ ଦୁର୍ବଳ ଲୋକଙ୍କୁ ନୁହେଁ, ଦୁନିଆକୁ ନିଶାଣ କରନ୍ତି। ସେହି ଫରକ ଗୁରୁତ୍ୱପୂର୍ଣ୍ଣ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਔਖੀਆਂ ਥਾਵਾਂ ਵਿੱਚ ਵੀ ਹਾਸਾ ਲੱਭ ਲੈਂਦੇ ਹੋ — ਪਰ ਤੁਹਾਡਾ ਨਿਸ਼ਾਨਾ ਦੁਨੀਆ ਹੁੰਦੀ ਹੈ, ਕਮਜ਼ੋਰ ਲੋਕ ਨਹੀਂ। ਇਹ ਫ਼ਰਕ ਮਾਇਨੇ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostrzegasz to, co zabawne, w trudnych sytuacjach – ale celujesz w świat, nie w słabszych. Ta różnica ma znaczenie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په سختو ځایونو کې هم خندا پیدا کوئ — خو ټوکې مو د نړۍ په لور وي، نه د کمزورو خلکو. دا توپیر مهم دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você acha graça em lugares difíceis — mas mira no mundo, não em quem está vulnerável. Essa diferença importa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontras graça em sítios difíceis — mas apontas ao mundo, não a quem é vulnerável. Essa diferença importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Găsești haz în situațiile grele — dar ținta e lumea, nu oamenii vulnerabili. Diferența asta contează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты находишь смешное в трудном, но шутишь над миром, а не над уязвимыми людьми. Эта разница важна."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubona ibisekeje ahantu hagoye — ariko useka isi, si abantu bafite intege nke. Iryo tandukaniro ni ingenzi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අමාරු තැන් වලත් ඔබ හාස්‍යය හොයාගන්නවා — ඒත් ඔබ ඉලක්ක කරන්නේ ලෝකය මිසක් අසරණ අයව නෙවෙයි. ඒ වෙනස වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smiešne nachádzaš aj na ťažkých miestach – ale strieľaš do sveta, nie do zraniteľných ľudí. Ten rozdiel je dôležitý."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smešno najdeš na težkih mestih – a tvoje puščice letijo v svet, ne v ranljive ljudi. Ta razlika je pomembna."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unowana zvinosetsa munzvimbo dzakaoma — asi unoseka nyika, kwete vanhu vasina simba. Mutsauko iwoyo unokosha."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meelaha adag ayaad kaftan ka heshaa — balse waxaad ku dhacdaa adduunka, ma aha dadka nugul. Kala duwanaanshahaasi waa muhiim."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E gjen të qeshurën në vende të vështira – por godet botën, jo njerëzit e brishtë. Ky dallim ka rëndësi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смешно налазиш на тешким местима — али шале усмераваш ка свету, а не ка рањивима. Та разлика је важна."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun mendak lucu dina tempat anu hésé, tapi anu diheureuyan téh dunya, sanés jalma anu lemah. Bédana éta penting."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hittar det roliga på svåra ställen – men du sparkar uppåt mot världen, inte nedåt mot de sårbara. Den skillnaden spelar roll."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unapata kichekesho katika sehemu ngumu — lakini unaelekeza mzaha kwa ulimwengu, si kwa watu walio hatarini. Tofauti hiyo ni muhimu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடினமான இடங்களிலும் சிரிப்பைக் காண்கிறீர்கள் — ஆனால் உங்கள் கேலி உலகை நோக்கியது, பலவீனமானவர்களை நோக்கியது அல்ல. அந்த வேறுபாடு முக்கியம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కష్టమైన సందర్భాల్లోనూ మీకు నవ్వు దొరుకుతుంది — కానీ మీ జోకులు బలహీనుల మీద కాదు, లోకం మీద. ఆ తేడా ముఖ్యం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар ҷойҳои душвор хандаро меёбӣ — вале ба дунё механдӣ, на ба одамони осебпазир. Ин фарқ муҳим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณหาความขำได้ในเรื่องยากๆ แต่มุกของคุณจิกกัดโลก ไม่ใช่ซ้ำเติมคนที่เปราะบาง ความต่างนี้สำคัญมาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ከቢድ ቦታታት ዘስሕቕ ትረኽቡ — ግን ናብ ዓለም እምበር ናብ ተቓላዕቲ ሰባት ኣይተቕንዑን። እቲ ፍልልይ ኣገዳሲ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyn ýerlerde hem gülkünçlik tapýarsyň — ýöne gülkiň ejiz adamlara däl, dünýä gönükdirilen. Bu tapawut möhüm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zor yerlerde bile komikliği buluyorsun ama oku kırılgan insanlara değil, dünyaya çeviriyorsun. Bu ayrım önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти знаходиш смішне у складному, але жартуєш над світом, а не над вразливими людьми. І ця різниця важлива."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشکل جگہوں میں بھی آپ کو مزاح مل جاتا ہے، مگر آپ کا نشانہ دنیا ہوتی ہے، کمزور لوگ نہیں۔ یہ فرق اہم ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qiyin vaziyatlarda ham kulgili narsa topasiz — lekin hazilingiz zaif odamlarga emas, dunyoga qaratilgan. Bu farq muhim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tìm thấy tiếng cười ở những chỗ khó khăn — nhưng bạn nhắm vào cuộc đời, không nhắm vào người yếu thế. Sự khác biệt đó rất quan trọng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufumana into ehlekisayo kwiindawo ezinzima — kodwa uhlekisa ngehlabathi, hayi ngabantu abasesichengeni. Lo mahluko ubalulekile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń rí ẹ̀rín níbi tó ṣòro — ṣùgbọ́n ayé lẹ ń fi ṣe yẹ̀yẹ́, kì í ṣe àwọn tí kò lágbára. Ìyàtọ̀ yẹn ṣe pàtàkì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你能在艱難的地方找到笑點，但你笑的是世界，不是弱勢的人。這個分別很重要。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你能在艰难处找到好笑的地方，但矛头对准的是世界，而不是弱势的人。这个分寸很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你能在艱難處找到好笑的地方，但你調侃的是這個世界，而不是弱勢的人。這個分寸很重要。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthola amahlaya ezindaweni ezinzima — kodwa uhlaba umhlaba, hhayi abantu ababuthakathaka. Lowo mehluko ubalulekile."
          }
        }
      }
    },
    "You find the absurdity in everyday things. Your humour is a byproduct of how closely you pay attention." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy vind die absurde in alledaagse dinge. Jou humor spruit uit hoe noukeurig jy oplet."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዕለት ተዕለት ነገሮች ውስጥ ያለውን አስቂኝነት ያገኛሉ። ቀልድዎ ምን ያህል በቅርበት እንደሚያስተውሉ የሚያሳይ ውጤት ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترون العبث في الأشياء اليومية. فكاهتكم نتاج دقة انتباهكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দৈনন্দিন কথাৰ মাজত আপুনি অদ্ভুততা বিচাৰি পায়। আপুনি কিমান মন দি চায়, আপোনাৰ হাস্যৰস তাৰে ফল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gündəlik şeylərdə absurdluq tapırsan. Yumorun nə qədər diqqətli olduğunun nəticəsidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты бачыш абсурд у звычайных рэчах. Твой гумар — пабочны эфект тваёй уважлівасці."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откриваш абсурдното в ежедневието. Хуморът ти е страничен продукт от това колко внимателно наблюдаваш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রোজকার জিনিসে তুমি অদ্ভুত মজা খুঁজে পাও। তোমার রসবোধ আসে তুমি কতটা খুঁটিয়ে খেয়াল করো, সেখান থেকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronalaziš apsurd u svakodnevnim stvarima. Tvoj humor je posljedica toga koliko pažljivo posmatraš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trobes l'absurd en les coses quotidianes. El teu humor és fruit de l'atenció que hi poses."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacházíš absurditu ve všedních věcech. Tvůj humor je vedlejší produkt toho, jak pozorně vnímáš svět."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n gweld yr abswrd mewn pethau bob dydd. Mae dy hiwmor yn deillio o ba mor fanwl rwyt ti'n talu sylw."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du finder det absurde i hverdagen. Din humor kommer af, hvor nøje du lægger mærke til tingene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entdeckst das Absurde im Alltag. Dein Humor entsteht daraus, wie genau du hinschaust."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκεις το παράλογο στα καθημερινά. Το χιούμορ σου βγαίνει από το πόσο προσεκτικά παρατηρείς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentras lo absurdo en lo cotidiano. Tu humor nace de lo atentamente que miras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiad absurdsust igapäevastest asjadest. Sinu huumor sünnib sellest, kui hoolikalt sa tähele paned."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eguneroko gauzetan aurkitzen duzu absurdoa. Zure umorea arreta handiz begiratzeko duzun moduaren ondorioa da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طنز را در چیزهای روزمره پیدا می‌کنی. شوخ‌طبعی‌ات حاصل دقتی است که به اطرافت داری."
          }
