            "value" : "คุณภาพสำคัญกว่าปริมาณ ทริปสุดพิเศษปีละครั้งดีกว่าทริปธรรมดาสี่ครั้ง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ብዝሒ ጽሬት። ሓደ ፍሉይ መገሻ ኣብ ዓመት ካብ ኣርባዕተ ማእከላይ መገሻታት ይበልጽ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukdardan hil öňde. Ýylda bir ajaýyp syýahat dört ortaça syýahatdan gowy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicelik değil nitelik. Yılda bir olağanüstü gezi, dört vasat geziden iyidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якість замість кількості. Одна незабутня подорож на рік краща за чотири посередні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعداد سے زیادہ معیار۔ سال میں ایک شاندار سفر چار معمولی سفروں سے بہتر ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miqdordan koʻra sifat. Yiliga bitta ajoyib sayohat toʻrtta oʻrtachasidan yaxshiroq."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chất lượng hơn số lượng. Một chuyến đi tuyệt vời mỗi năm hơn bốn chuyến tầm thường."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgangatho ngaphezu kobuninzi. Uhambo olunye olukhethekileyo ngonyaka lungcono kunohambo olune oluphakathi."
