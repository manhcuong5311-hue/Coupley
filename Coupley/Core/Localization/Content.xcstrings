        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beaucoup : en bien comme en mal, tout vient de là"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המון — לטוב ולרע, זה מה שבנה אותי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत — अच्छे-बुरे दोनों तरह से, इसी ने मुझे बनाया"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyon – jóban-rosszban ez tett azzá, aki vagyok"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besar — baik buruknya, itu yang membentukku"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molto — nel bene e nel male, ha fatto di me chi sono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても大きい。良くも悪くも今の自分をつくった"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많이요, 좋든 나쁘든 지금의 나를 만들었어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banyak — baik atau buruk, itulah yang membentuk saya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mye – på godt og vondt har den formet meg"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel – in goede en slechte zin, het heeft me gevormd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo – na dobre i na złe, to mnie ukształtowało"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito — para o bem e para o mal, me formou"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mult — la bine și la rău, m-a format"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильно — и в хорошем, и в плохом"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mycket – på gott och ont har den format mig"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาก ทั้งดีและไม่ดี หล่อหลอมให้เป็นตัวเองทุกวันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok: iyisiyle kötüsüyle beni o yaptı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дуже — на краще й на гірше, воно мене сформувало"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rất nhiều — dù tốt hay xấu, nó tạo nên mình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很大，好的坏的，都成就了我"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很大，好的壞的都塑造了我"
