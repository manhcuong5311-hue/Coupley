    "Food as craft. You want the skill, not just the result. Great for someone who loves feeding people." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kos as vakmanskap. Jy wil die vaardigheid hê, nie net die resultaat nie. Perfek vir iemand wat graag mense voer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምግብ እንደ ጥበብ። ውጤቱን ብቻ ሳይሆን ክህሎቱን ይፈልጋሉ። ሰዎችን ማብላት ለሚወዱ ግሩም ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطعام حرفة. المهارة نفسها تهمك، لا النتيجة فقط. رائع لمن يحب إطعام الآخرين."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ৰন্ধন এক শিল্প হিচাপে। আপুনি কেৱল ফলাফল নহয়, দক্ষতাটো বিচাৰে। মানুহক খুৱাই ভাল পোৱা কাৰোবাৰ বাবে চমৎকাৰ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sənət kimi yemək. Sadəcə nəticəni yox, bacarığın özünü istəyirsən. İnsanları yedirtməyi sevən biri üçün əladır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежа як рамяство. Табе важны сам навык, а не толькі вынік. Выдатна для таго, хто любіць частаваць іншых."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храната като занаят. Искаш умението, не само резултата. Чудесно за човек, който обича да храни другите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খাবার যেন শিল্প। তুমি শুধু ফল নয়, দক্ষতাটা চাও। যারা মানুষকে খাওয়াতে ভালোবাসে, তাদের জন্য দারুণ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana kao zanat. Želiš vještinu, ne samo rezultat. Savršeno za nekoga ko voli hraniti druge."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuina com a ofici. Vols l'habilitat, no només el resultat. Ideal per a qui gaudeix donant de menjar a la gent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jídlo jako řemeslo. Chceš tu dovednost, ne jen výsledek. Skvělé pro někoho, kdo rád krmí ostatní."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bwyd fel crefft. Rwyt ti eisiau'r sgil, nid dim ond y canlyniad. Gwych i rywun sy'n dwlu bwydo pobl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mad som håndværk. Du vil have færdigheden, ikke bare resultatet. Perfekt for en, der elsker at lave mad til andre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen als Handwerk. Dir geht es ums Können, nicht nur ums Ergebnis. Perfekt für alle, die gern andere bekochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το φαγητό ως τέχνη. Θες τη δεξιότητα, όχι μόνο το αποτέλεσμα. Ιδανικό για όποιον λατρεύει να ταΐζει τους άλλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cocina como oficio. Quieres la habilidad, no solo el resultado. Ideal para quien disfruta dando de comer a los demás."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toit kui käsitöö. Tahad oskust, mitte ainult tulemust. Suurepärane kellelegi, kes armastab teisi toita."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janaria ofizio gisa. Trebetasuna nahi duzu, ez emaitza soilik. Primerakoa besteei jaten ematea maite duenarentzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غذا به‌عنوان هنر. خود مهارت را می‌خواهی، نه فقط نتیجه را. عالی برای کسی که عاشق غذا دادن به دیگران است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruoka käsityönä. Haluat taidon, et pelkkää lopputulosta. Sopii täydellisesti sille, joka rakastaa laittaa ruokaa muille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkain bilang sining. Gusto mo ang skill, hindi lang ang resulta. Bagay sa taong mahilig magpakain ng iba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuisine comme artisanat. Tu veux le savoir-faire, pas seulement le résultat. Idéal quand on adore régaler les autres."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bia mar cheird. Is í an scil atá uait, ní an toradh amháin. Iontach do dhuine ar breá leis daoine a bheathú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cociña como oficio. Queres dominar a técnica, non só o resultado. Ideal para quen adora dar de comer aos demais."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રસોઈ એક કળા. તમને ફક્ત પરિણામ નહીં, આવડત જોઈએ છે. લોકોને જમાડવાનું ગમતું હોય એમના માટે સરસ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abinci a matsayin sana'a. Kuna son ƙwarewar, ba sakamakon kawai ba. Ya dace da mai son ciyar da mutane."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אוכל כאומנות. בא לך את המיומנות, לא רק את התוצאה. מושלם למי שאוהב להאכיל אנשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना एक कला के रूप में। आपको सिर्फ़ नतीजा नहीं, हुनर चाहिए। लोगों को खिलाने के शौक़ीनों के लिए बढ़िया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana kao zanat. Želiš vještinu, a ne samo rezultat. Savršeno za nekoga tko voli hraniti druge."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje kòm yon atizana. Ou vle konpetans lan, pa sèlman rezilta a. Pafè pou yon moun ki renmen bay moun manje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A főzés mint mesterség. A tudás érdekel, nem csak az eredmény. Tökéletes annak, aki szeret másokat megvendégelni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խոհարարությունը՝ որպես արհեստ։ Քեզ պետք է հմտությունը, ոչ միայն արդյունքը։ Հիանալի է նրա համար, ով սիրում է ուրիշներին կերակրել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan sebagai keahlian. Kamu ingin keterampilannya, bukan cuma hasilnya. Cocok untuk yang suka memasak untuk orang lain."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nri dịka nka. Ị chọrọ nka ahụ, ọ bụghị naanị ihe ọ ga-arụpụta. Ọ dị mma maka onye hụrụ inye ndị mmadụ nri n'anya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matargerð sem handverk. Þú vilt kunnáttuna, ekki bara útkomuna. Frábært fyrir þau sem elska að gefa fólki að borða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cibo come arte. Vuoi l’abilità, non solo il risultato. Perfetto per chi ama dare da mangiare agli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料理を技として極めたい人です。結果だけでなく、腕を磨きたい。人に食べさせるのが好きな人にぴったりです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masak minangka kaprigelan. Panjenengan pengin kaprigelane, ora mung asile. Cocog kanggo wong sing seneng masakake wong liya."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საჭმელი, როგორც ხელობა. უნარი გინდა და არა მხოლოდ შედეგი. იდეალურია მისთვის, ვისაც სხვების გამასპინძლება უყვარს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тағам — шеберлік. Саған тек нәтиже емес, дағдының өзі керек. Адамдарды тамақтандыруды жақсы көретін адамға тамаша."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ម្ហូបជាសិល្បៈ។ អ្នកចង់បានជំនាញ មិនមែនត្រឹមតែលទ្ធផលទេ។ ល្អណាស់សម្រាប់អ្នកដែលចូលចិត្តធ្វើម្ហូបឲ្យអ្នកដទៃញ៉ាំ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಡುಗೆಯೇ ಒಂದು ಕಲೆ. ನಿಮಗೆ ಫಲಿತಾಂಶ ಮಾತ್ರವಲ್ಲ, ಕೌಶಲವೂ ಬೇಕು. ಇತರರಿಗೆ ಉಣಬಡಿಸಲು ಇಷ್ಟಪಡುವವರಿಗೆ ಹೇಳಿಮಾಡಿಸಿದ್ದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식을 하나의 기술로 봐요. 결과만이 아니라 실력을 원하죠. 다른 사람에게 음식 해 주는 걸 좋아하는 사람에게 딱이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xwarin wekî huner. Tu jêhatîbûnê dixwazî, ne tenê encamê. Ji bo kesekî ku hez dike xwarinê bide mirovan pir baş e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тамак — бул өнөр. Жыйынтыгын эле эмес, чеберчиликти каалайсың. Адамдарды тамактандырганды жакшы көргөн адамга сонун."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iessen als Handwierk. Du wëlls d'Kënnen, net just d'Resultat. Ideal fir een, deen anerer gär bekacht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ອາຫານຄືງານຝີມື ເຈົ້າຢາກໄດ້ທັກສະ ບໍ່ແມ່ນແຄ່ຜົນລັບ ເໝາະກັບຄົນທີ່ມັກເຮັດອາຫານໃຫ້ຄົນອື່ນກິນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maistas kaip amatas. Tau rūpi įgūdis, o ne tik rezultatas. Puiku tam, kas mėgsta vaišinti kitus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ēdiens kā amats. Tev svarīga prasme, ne tikai rezultāts. Lieliski tam, kurš mīl pabarot citus."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny sakafo ho asa tanana. Ny fahaizana no tadiavinao, fa tsy ny vokatra fotsiny. Tsara ho an'izay tia mamahana olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te kai he toi. Ko te pūkenga tāu e hiahia ana, kaua ko te hua anake. He pai mō te tangata e aroha ana ki te whāngai i te iwi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храната како занает. Ја сакаш вештината, не само резултатот. Одлично за некој што сака да храни луѓе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പാചകം ഒരു കലയായി. ഫലം മാത്രമല്ല, ആ കഴിവാണ് നിങ്ങൾക്ക് വേണ്ടത്. ആളുകളെ ഊട്ടാൻ ഇഷ്ടമുള്ളവർക്ക് ഉത്തമം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоол бол урлаг. Чи зөвхөн үр дүн биш, ур чадварыг хүсдэг. Хүмүүсийг хооллох дуртай хүнд яг тохирно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वयंपाक एक कला म्हणून. तुम्हाला फक्त परिणाम नाही, तर कौशल्य हवे आहे. लोकांना खाऊ घालायला आवडणाऱ्यांसाठी उत्तम."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan sebagai seni. Anda mahukan kemahirannya, bukan sekadar hasilnya. Sesuai untuk orang yang suka menjamu orang lain."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ikel bħala sengħa. Trid il-ħila, mhux biss ir-riżultat. Perfett għal min iħobb jitma' lin-nies."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချက်ပြုတ်ခြင်းကို အတတ်ပညာအဖြစ် မြင်တယ်။ ရလဒ်တင် မဟုတ်ဘဲ ကျွမ်းကျင်မှုကို လိုချင်တယ်။ လူတွေကို ကျွေးမွေးရတာ ကြိုက်သူအတွက် အကောင်းဆုံးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat som håndverk. Du vil ha ferdigheten, ikke bare resultatet. Perfekt for noen som elsker å lage mat til andre."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना एउटा कला। तपाईंलाई नतिजा मात्र होइन, सीप चाहिएको छ। अरूलाई खुवाउन मन पराउनेका लागि उत्तम।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eten als ambacht. Je wilt de vaardigheid, niet alleen het resultaat. Perfect als je graag voor anderen kookt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chakudya ngati luso. Mukufuna lusolo, osati zotsatira zokha. Ndi zabwino kwa munthu wokonda kudyetsa anthu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyaata akka ogummaatti. Bu'aa qofa osoo hin taane ogummaa barbaadda. Nama namoota nyaachisuu jaallatuuf baay'ee gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ରୋଷେଇ ଏକ କଳା। ଆପଣ କେବଳ ଫଳାଫଳ ନୁହେଁ, ଦକ୍ଷତା ଚାହାନ୍ତି। ଲୋକଙ୍କୁ ଖୁଆଇବାକୁ ଭଲପାଉଥିବା କାହା ପାଇଁ ଚମତ୍କାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਖਾਣਾ ਇੱਕ ਕਲਾ ਵਜੋਂ। ਤੁਹਾਨੂੰ ਸਿਰਫ਼ ਨਤੀਜਾ ਨਹੀਂ, ਹੁਨਰ ਚਾਹੀਦਾ ਹੈ। ਦੂਜਿਆਂ ਨੂੰ ਖੁਆਉਣ ਦੇ ਸ਼ੌਕੀਨਾਂ ਲਈ ਬਹੁਤ ਵਧੀਆ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedzenie jako rzemiosło. Chcesz umiejętności, nie tylko efektu. Idealne dla kogoś, kto kocha karmić innych."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خواړه د هنر په توګه. تاسو مهارت غواړئ، نه یوازې پایله. د هغه چا لپاره عالي دی چې خلکو ته خواړه ورکول خوښوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comida como arte. Você quer a habilidade, não só o resultado. Perfeito para quem ama alimentar as pessoas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comida como ofício. Queres a técnica, não só o resultado. Ótimo para quem adora alimentar os outros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncarea ca meșteșug. Vrei abilitatea, nu doar rezultatul. Grozav pentru cineva căruia îi place să-i hrănească pe alții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еда как ремесло. Тебе важен сам навык, а не только результат. Идеально для того, кто любит кормить других."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guteka nk'ubuhanga. Ushaka ubumenyi, si umusaruro gusa. Ni byiza ku muntu ukunda kugaburira abandi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කෑම කලාවක් විදිහට. ඔබට ඕනේ ප්‍රතිඵලය විතරක් නෙවෙයි, හැකියාවමයි. අනිත් අයට කන්න දෙන්න ආස කෙනෙකුට නියමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedlo ako remeslo. Chceš zručnosť, nielen výsledok. Skvelé, ak ťa baví kŕmiť druhých."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana kot obrt. Želiš si veščine, ne le rezultata. Odlično za vse, ki radi hranijo druge."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubika sehunyanzvi. Unoda hunyanzvi, kwete mhedzisiro chete. Zvakanaka kune munhu anoda kupa vanhu chikafu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuntadu waa farshaxan kuu ah. Waxaad rabtaa xirfadda, ma aha natiijada oo kaliya. Ku habboon qof jecel inuu dadka wax u kariyo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushqimi si zanat. Do aftësinë, jo vetëm rezultatin. E shkëlqyer për dikë që i pëlqen t’u gatuajë të tjerëve."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храна као занат. Желиш вештину, а не само резултат. Савршено за некога ко воли да храни друге."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadaharan salaku karya. Anjeun hoyong kaparigelanana, sanés ngan hasilna. Cocog pikeun jalma anu resep nyuguhan batur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat som hantverk. Du vill ha kunskapen, inte bara resultatet. Perfekt för någon som älskar att bjuda på mat."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chakula kama ufundi. Unataka ujuzi, si matokeo tu. Bora kwa mtu anayependa kuwalisha watu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உணவு ஒரு கலை. உங்களுக்கு விளைவு மட்டுமல்ல, திறமையும் வேண்டும். பிறருக்குச் சமைத்துப் பரிமாற விரும்புபவருக்கு அருமையானது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వంట ఒక కళ. మీకు కేవలం ఫలితం కాదు, నైపుణ్యం కావాలి. ఇతరులకు వండి పెట్టడం ఇష్టమైనవారికి ఇది చక్కగా సరిపోతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хӯрок ҳамчун ҳунар. Ба ту маҳорат лозим аст, на танҳо натиҷа. Барои касе, ки хӯрондани одамонро дӯст медорад, олӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาหารคืองานฝีมือ คุณอยากได้ทักษะ ไม่ใช่แค่ผลลัพธ์ เหมาะมากกับคนที่ชอบทำอาหารให้คนอื่นกิน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምግቢ ከም ጥበብ። ነቲ ውጽኢት ጥራይ ዘይኮነ ነቲ ክእለት ትደልዩ። ንሰባት ምምጋብ ንዝፈቱ ሰብ ጽቡቕ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahar — hünär. Diňe netije däl, başarnyk gerek. Adamlary doýurmagy gowy görýän biri üçin ajaýyp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanaat olarak yemek. Sadece sonucu değil, beceriyi istiyorsun. İnsanları doyurmayı seven biri için harika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Їжа як ремесло. Тобі потрібна навичка, а не лише результат. Чудово для того, хто любить годувати інших."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھانا بطور فن۔ آپ کو صرف نتیجہ نہیں، ہنر چاہیے۔ لوگوں کو کھلانے کے شوقین کے لیے بہترین۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazandalik — hunar sifatida. Sizga shunchaki natija emas, mahorat kerak. Yaqinlarini mazali taomlar bilan siylashni yaxshi koʻradigan odam uchun ajoyib tanlov."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nấu ăn như một nghề thủ công. Bạn muốn có tay nghề, không chỉ có thành phẩm. Rất hợp với người thích nấu cho người khác ăn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukutya njengobugcisa. Ufuna isakhono, hayi nje isiphumo. Kuhle kumntu othanda ukutyisa abantu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oúnjẹ bí iṣẹ́ ọnà. Ẹ fẹ́ ọgbọ́n náà, kì í ṣe àbájáde nìkan. Ó dára fún ẹni tó fẹ́ràn láti bọ́ àwọn èèyàn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把烹飪當成手藝。你想要的是技巧，而不只是成果。很適合愛餵飽別人的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把做饭当手艺。你想要的是本事，而不只是结果。很适合爱给别人做饭的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把料理當成手藝。你想要的是技能，不只是成品。很適合喜歡煮東西給別人吃的人。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukudla njengobuciko. Ufuna ikhono, hhayi nje umphumela. Kuhle kakhulu kumuntu othanda ukuphakela abantu."
          }
        }
      }
    },
    "Food is one of the easiest ways to show care — knowing what your partner loves matters." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kos is een van die maklikste maniere om omgee te wys – om te weet waarvan jou maat hou, maak saak."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምግብ እንክብካቤን ለማሳየት በጣም ቀላል ከሆኑ መንገዶች አንዱ ነው — አጋርዎ የሚወዱትን ማወቅ አስፈላጊ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطعام من أسهل الطرق للتعبير عن الاهتمام، ومعرفة ما يحبه شريكك أمر مهم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খাদ্য যত্ন দেখুওৱাৰ আটাইতকৈ সহজ উপায়বোৰৰ এটা — আপোনাৰ সংগীয়ে কি ভাল পায় জনাটো গুৰুত্বপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemək qayğı göstərməyin ən asan yollarından biridir — partnyorunun nəyi sevdiyini bilmək önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежа — адзін з самых простых спосабаў паказаць клопат, і важна ведаць, што любіць палавінка."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храната е един от най-лесните начини да покажеш грижа – важно е да знаеш какво обича половинката ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যত্ন দেখানোর সবচেয়ে সহজ উপায়গুলোর একটা খাবার — পার্টনার কী ভালোবাসে, তা জানা জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana je jedan od najlakših načina da pokažeš brigu – važno je znati šta voljena osoba voli."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menjar és una de les maneres més fàcils de demostrar afecte — saber què li encanta a la teva parella importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jídlo je jeden z nejsnazších způsobů, jak projevit péči – vědět, co tvůj protějšek miluje, je důležité."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bwyd yw un o'r ffyrdd hawsaf o ddangos gofal — mae gwybod beth mae dy bartner yn dwlu arno yn bwysig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mad er en af de nemmeste måder at vise omsorg på – det betyder noget at vide, hvad din partner elsker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essen ist eine der einfachsten Arten, Fürsorge zu zeigen – zu wissen, was dein Schatz liebt, zählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το φαγητό είναι από τους πιο εύκολους τρόπους να δείξεις φροντίδα — μετράει να ξέρεις τι λατρεύει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comida es una de las formas más sencillas de demostrar cariño; saber qué le encanta a tu pareja importa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toit on üks lihtsamaid viise hoolivust näidata — on oluline teada, mida su partner armastab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janaria da maitasuna erakusteko modurik errazenetako bat — zure bikotekideak zer maite duen jakiteak garrantzia du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غذا یکی از ساده‌ترین راه‌های نشان دادن محبت است — دانستن اینکه پارتنرت عاشق چیست مهم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruoka on yksi helpoimmista tavoista osoittaa välittämistä – on tärkeää tietää, mitä kumppanisi rakastaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isa ang pagkain sa pinakamadaling paraan para ipakita ang malasakit — mahalagang alam mo kung ano ang gusto ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nourriture est l'une des façons les plus simples de montrer qu'on tient à quelqu'un : savoir ce que l'autre adore, ça compte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá bia ar cheann de na bealaí is éasca chun cúram a léiriú — is tábhachtach a fhios a bheith agat cad is breá le do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comida é unha das formas máis doadas de amosar cariño: saber que lle encanta á túa parella importa."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ભોજન કાળજી બતાવવાની સૌથી સહેલી રીતોમાંની એક છે — તમારા પાર્ટનરને શું ભાવે છે એ જાણવું મહત્ત્વનું છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abinci na ɗaya daga cikin hanyoyi mafi sauƙi na nuna kulawa — sanin abin da abokin zamanku ke so na da muhimmanci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אוכל הוא אחת הדרכים הכי פשוטות להראות אכפתיות — חשוב לדעת מה הצד השני הכי אוהב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना परवाह जताने के सबसे आसान तरीक़ों में से एक है — यह जानना ज़रूरी है कि आपके पार्टनर को क्या पसंद है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrana je jedan od najlakših načina da pokažeš brigu – važno je znati što voljena osoba obožava."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje se youn nan fason ki pi fasil pou montre swen — konnen sa patnè ou renmen enpòtan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az étel az egyik legkönnyebb módja a törődés kimutatásának – fontos tudni, mit szeret a párod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ուտելիքը հոգատարություն ցույց տալու ամենահեշտ ձևերից է — կարևոր է իմանալ, թե ինչ է սիրում զուգընկերդ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan adalah salah satu cara termudah menunjukkan perhatian — tahu apa yang disukai pasanganmu itu penting."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nri bụ otu n'ime ụzọ kacha dị mfe isi gosi nlekọta — ịma ihe onye gị hụrụ n'anya dị mkpa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matur er ein auðveldasta leiðin til að sýna umhyggju – það skiptir máli að vita hvað makinn þinn elskar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cibo è uno dei modi più semplici per dimostrare cura — sapere cosa ama il tuo partner conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食べものは思いやりを伝えるいちばん簡単な方法のひとつ。パートナーの好物を知っておくことが大切です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panganan iku salah siji cara paling gampang nuduhake rasa peduli — ngerti apa sing disenengi pasangan iku wigati."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საჭმელი ზრუნვის გამოხატვის ერთ-ერთი უმარტივესი გზაა — მნიშვნელოვანია, იცოდე, რა უყვარს შენს პარტნიორს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тағам — қамқорлық көрсетудің ең оңай жолдарының бірі. Серігің не жақсы көретінін білу маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ម្ហូបគឺជាវិធីងាយបំផុតមួយក្នុងការបង្ហាញការយកចិត្តទុកដាក់ — ការដឹងថាដៃគូរបស់អ្នកចូលចិត្តអ្វី គឺសំខាន់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಾಳಜಿ ತೋರಿಸಲು ಆಹಾರ ಅತಿ ಸುಲಭ ದಾರಿಗಳಲ್ಲಿ ಒಂದು — ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ಏನು ಇಷ್ಟ ಎಂದು ತಿಳಿದಿರುವುದು ಮುಖ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식은 마음을 전하는 가장 쉬운 방법 중 하나예요. 연인이 좋아하는 걸 아는 게 중요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xwarin yek ji rêyên herî hêsan e ku tu xema xwe nîşan bidî — zanîna ku hevjînê te ji çi hez dike girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тамак — камкордукту көрсөтүүнүн эң жеңил жолдорунун бири. Сүйгөнүң эмнени жакшы көрөрүн билүү маанилүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iessen ass ee vun den einfachste Weeër, fir ze weisen, datt een sech këmmert — ze wëssen, wat däi Schatz gär ësst, zielt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ອາຫານຄືໜຶ່ງໃນວິທີທີ່ງ່າຍທີ່ສຸດໃນການສະແດງຄວາມຫ່ວງໃຍ — ການຮູ້ວ່າຄູ່ຂອງເຈົ້າມັກຫຍັງນັ້ນສຳຄັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maistas – vienas lengviausių būdų parodyti rūpestį. Svarbu žinoti, ką mėgsta antroji pusė."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ēdiens ir viens no vienkāršākajiem veidiem, kā parādīt rūpes, – svarīgi zināt, ko mīl tava otrā puse."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny sakafo dia iray amin'ireo fomba mora indrindra hanehoana fiahiana — zava-dehibe ny mahafantatra izay tian'ny olon-tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te kai tētahi o ngā huarahi māmā rawa hei whakaatu manaaki — he mea nui te mōhio ki ngā kai e pai ana ki tō hoa aroha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храната е еден од најлесните начини да покажеш грижа — важно е да знаеш што сака половинката."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കരുതൽ കാണിക്കാനുള്ള ഏറ്റവും എളുപ്പവഴികളിൽ ഒന്നാണ് ഭക്ഷണം — പങ്കാളിക്ക് എന്താണ് ഇഷ്ടമെന്ന് അറിയുന്നത് പ്രധാനമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоол бол санаа тавьж буйгаа харуулах хамгийн хялбар арга — ханийнхаа юунд дуртайг мэдэх нь чухал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काळजी दाखवण्याचा सर्वात सोपा मार्ग म्हणजे खाणे — जोडीदाराला काय आवडते हे माहीत असणे महत्त्वाचे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan ialah salah satu cara paling mudah untuk menunjukkan rasa sayang — mengetahui kegemaran pasangan anda sangat penting."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ikel huwa wieħed mill-eħfef modi kif turi li jimpurtak — li tkun taf x'iħobb il-partner tiegħek jgħodd."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အစားအစာက ဂရုစိုက်မှုကို ပြဖို့ အလွယ်ဆုံး နည်းတွေထဲက တစ်ခုပါ — ချစ်သူ ဘာကြိုက်လဲ သိထားတာ အရေးကြီးတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat er en av de enkleste måtene å vise omsorg på – det er verdifullt å vite hva partneren din elsker."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना हेरचाह देखाउने सबैभन्दा सजिलो तरिकामध्ये एक हो — पार्टनरलाई के मनपर्छ थाहा हुनु महत्त्वपूर्ण छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eten is een van de makkelijkste manieren om zorg te tonen – weten waar je partner van houdt, doet ertoe."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chakudya ndi imodzi mwa njira zosavuta kwambiri zosonyezera chisamaliro — kudziwa zomwe wokondedwa wanu amakonda nkofunika."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyaanni karaa kunuunsa agarsiisuu salphaa keessaa tokko — waan jaalallee keetti tolu beekuun barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଖାଦ୍ୟ ଯତ୍ନ ଦେଖାଇବାର ସବୁଠୁ ସହଜ ଉପାୟ ମଧ୍ୟରୁ ଗୋଟିଏ — ଆପଣଙ୍କ ସାଥୀ କ'ଣ ଭଲପାଆନ୍ତି ଜାଣିବା ଜରୁରି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਖਾਣਾ ਪਰਵਾਹ ਦਿਖਾਉਣ ਦੇ ਸਭ ਤੋਂ ਸੌਖੇ ਤਰੀਕਿਆਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ — ਇਹ ਜਾਣਨਾ ਅਹਿਮ ਹੈ ਕਿ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਨੂੰ ਕੀ ਪਸੰਦ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedzenie to jeden z najprostszych sposobów okazania troski – warto wiedzieć, co uwielbia twoja druga połówka."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خواړه د پاملرنې ښودلو یوه تر ټولو اسانه لاره ده — دا پوهېدل چې ستاسو ملګری څه خوښوي، مهم دي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comida é um dos jeitos mais fáceis de demonstrar carinho — saber o que seu amor adora faz diferença."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comida é uma das formas mais fáceis de mostrar carinho — saber o que o teu par adora conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncarea e unul dintre cele mai simple moduri de a arăta grijă — contează să știi ce îi place partenerului tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еда — один из самых простых способов проявить заботу. Важно знать, что любит партнёр."
