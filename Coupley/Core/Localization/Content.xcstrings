    "Missing each other — time apart makes the heart grow" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاشتياق: البُعد يزيد القلب تعلّقًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesk – odloučení lásku posiluje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At savne hinanden – afstand gør hjertet større"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sich vermissen – Abstand lässt die Liebe wachsen"
