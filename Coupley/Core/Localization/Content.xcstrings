        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ცვლილებისთვის ღია ხარ, მაგრამ ნაცნობ კულტურაში. ახალი დასაწყისი გინდა სრული გადასახლების გაურკვევლობის გარეშე."
