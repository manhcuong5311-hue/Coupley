        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วยกันปลดหนี้แล้วเริ่มต้นใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borçları birlikte kapatıp sıfırdan başlamak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разом закрити борги й почати з нуля"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng trả hết nợ và bắt đầu lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起还清债务，重新开始"
