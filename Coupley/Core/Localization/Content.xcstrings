        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyok neki egy kis teret"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տալիս եմ նրան շունչ քաշելու ժամանակ"
          }
        },
        "id" : {
          "stringUnit" : {
