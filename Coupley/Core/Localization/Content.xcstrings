        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো বিচার নেই — এ ব্যাপারে তুমি কোথায় আছ, তা তোমার এনার্জি, মুড আর সময়সূচিতে প্রভাব ফেলে।"
