        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deňagramlylyk. Sen gözegçilik etmek islemeýärsiň, ýöne biriniň diňe ýarym ýanyňdadygyny duýýarsyň."
