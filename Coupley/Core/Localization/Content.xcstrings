        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cih bide, lê derî vekirî bihêle: “dema tu bixwazî, ez li vir im.”"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ага эркиндик бер, бирок эшикти ачык калтыр: «керек болсом, жаныңдамын»."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gëff Raum, mee looss eng Dier op: „Ech sinn do, wanns de mech brauchs.“"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໃຫ້ພື້ນທີ່ ແຕ່ເປີດປະຕູໄວ້: “ຢູ່ນີ້ສະເໝີ ເມື່ອໃດທີ່ຕ້ອງການ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duok erdvės, bet palik atviras duris: „esu čia, kai panorėsi“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dod otram telpu, bet atstāj durvis vaļā: ‚esmu te, kad mani vajadzēs’."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omeo toerana izy nefa avelao misokatra ny varavarana: “eto aho rehefa mila ahy ianao.”"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoatu he wāhi ki a ia, engari waiho kia tuwhera te kūaha: “kei konei au ina hiahia mai koe.”"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дај ѝ простор, но остави врата отворена: „Тука сум кога ќе ти требам“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവർക്ക് ഇടം നൽകൂ, പക്ഷേ ഒരു വാതിൽ തുറന്നിടൂ: “വേണമെങ്കിൽ ഞാൻ ഇവിടെയുണ്ട്.”"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зай өг, гэхдээ хаалгаа нээлттэй үлдээ: «хэрэгтэй үед энд байна»."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्यांना जागा द्या, पण दार उघडे ठेवा: “जेव्हा हवे असेल, मी इथेच आहे.”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri dia ruang tapi biarkan pintu terbuka: “saya ada bila anda perlukan.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agħti spazju lill-partner tiegħek imma ħalli l-bieb miftuħ: “hawn għalik meta trid.”"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေရာပေးပါ၊ ဒါပေမဲ့ တံခါးဖွင့်ထားပါ: “လိုချင်တဲ့အချိန် ဒီမှာ ရှိတယ်နော်။”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi partneren din rom, men la døren stå på gløtt: «Jeg er her når du vil.»"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उहाँलाई ठाउँ दिनुहोस्, तर ढोका खुला राख्नुहोस्: ‘मन लागे म यहीँ छु।’"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef ruimte, maar laat de deur open: “Ik ben er als je me nodig hebt.”"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatseni malo koma siyani khomo lotseguka: “ndilipo ukandifuna.”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iddoo kenni, garuu balbala banaa dhiisi: “yeroo na barbaaddu as jira.”"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତାଙ୍କୁ ଜାଗା ଦିଅନ୍ତୁ, କିନ୍ତୁ ଦୁଆର ଖୋଲା ରଖନ୍ତୁ: “ଯେବେ ଚାହିଁବ, ମୁଁ ଏଠି ଅଛି।”"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਨ੍ਹਾਂ ਨੂੰ ਥਾਂ ਦਿਓ, ਪਰ ਦਰਵਾਜ਼ਾ ਖੁੱਲ੍ਹਾ ਰੱਖੋ: “ਜਦੋਂ ਚਾਹੋ, ਮੈਂ ਇੱਥੇ ਹਾਂ।”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj przestrzeń, ale zostaw otwarte drzwi: „Jestem, kiedy zechcesz”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ځای ورکړئ، خو دروازه خلاصه پرېږدئ: «هر کله چې مې غواړې، دلته یم.»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê espaço, mas deixe a porta aberta: “tô aqui quando quiser”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá espaço, mas deixa a porta aberta: «estou aqui quando quiseres.»"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă-i spațiu, dar lasă și o ușă deschisă: „sunt aici când ai nevoie de mine”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай партнёру пространство, но оставь дверь открытой: «Я рядом, когда захочешь»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhe umwanya ariko usige umuryango ufunguye: “ndahari igihe uzankenera.”"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉඩ දෙන්න, ඒත් දොරක් ඇරලා තියන්න: “ඕනේ වෙලාවට මම මෙතන ඉන්නවා.”"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj priestor, ale nechaj otvorené dvere: „Som tu, keď ma budeš chcieť.“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj partnerju prostor, a pusti vrata odprta: „Tu sem, kadar me potrebuješ.“"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mupe nzvimbo asi siya musuwo wakavhurika: ‘ndiripo paunondida.’"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meel u bannee, balse albaab u dhaaf furan: “halkan ayaan joogaa markaad i rabto”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jepi hapësirë, por lëre derën hapur: „Jam këtu kur të duash.“"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дај простор, али остави врата отворена: „ту сам кад ти затребам“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasihan rohangan, tapi tetep buka panto: “abdi aya di dieu upami diperyogikeun.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge utrymme men lämna dörren på glänt: ”Jag finns här när du vill.”"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mpe nafasi lakini acha mlango wazi: “niko hapa ukinihitaji.”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவருக்கு இடம் கொடுங்கள், ஆனால் கதவைத் திறந்து வையுங்கள்: “வேண்டும்போது நான் இங்கே இருக்கிறேன்.”"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వారికి ఏకాంతం ఇవ్వండి, కానీ ఒక ద్వారం తెరిచి ఉంచండి: “నేను కావాలనుకున్నప్పుడు ఇక్కడే ఉన్నా.”"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба ёрат фазо деҳ, вале дарро кушода гузор: «Ҳар вақт хоҳӣ, ман инҷоям»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้พื้นที่ แต่เปิดประตูไว้: “อยู่ตรงนี้นะ เมื่อไหร่ที่อยากให้อยู่ด้วย”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቦታ ሃብዎም፣ ግን ማዕጾ ክፉት ግደፉ፦ «ምስ ዝደለኹምኒ ኣለኹ።»"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oňa giňişlik ber, ýöne gapyny açyk goý: “Gerek bolsam, şu ýerde.”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona alan tanı ama kapıyı açık bırak: “İstediğinde buradayım.”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай простір, але залиш двері відчиненими: «Я поруч, коли захочеш»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہیں جگہ دیں، مگر دروازہ کھلا رکھیں: “جب چاہیں، میں یہیں ہوں۔”"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joy bering, lekin eshikni ochiq qoldiring: «kerak boʻlsam, shu yerdaman»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho người ấy khoảng riêng nhưng để ngỏ cánh cửa: “mình ở đây khi bạn cần.”"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linike isithuba kodwa ushiye umnyango uvulekile: “Ndikhona xa undifuna.”"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fún un ní àyè, ṣùgbọ́n ẹ fi ilẹ̀kùn sílẹ̀ ní ṣíṣí: “mo wà níbí nígbà tí o bá fẹ́ mi.”"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給對方空間，但留一道門：「你需要我時，我都在。」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给另一半空间，但留一扇门：“你需要我的时候，我都在。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給對方空間，但留一扇門：「你需要我的時候，我都在。」"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mnike isikhala kodwa ushiye umnyango uvuliwe: “ngilapha uma ungidinga.”"
          }
        }
      }
    },
