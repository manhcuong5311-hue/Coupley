            "value" : "Բարձրաձայն ասել — «Սիրում եմ քեզ», հաճոյախոսություններ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengucapkannya — “aku sayang kamu”, pujian"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikwu ya n'olu dị elu — “A hụrụ m gị n'anya”, otuto"
          }
        },
        "is" : {
          "stringUnit" : {
