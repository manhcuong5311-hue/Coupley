    "We figure it out together as situations arise" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتدبر الأمر معًا حسب المواقف"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyřešíme to spolu, až to přijde"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi finder ud af det sammen, når det opstår"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir klären das gemeinsam, wenn es so weit ist"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το βρίσκουμε μαζί, ανάλογα με την περίσταση"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo resolvemos juntos según surja"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovimme yhdessä tilanteen mukaan"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinag-uusapan namin habang dumarating ang sitwasyon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On voit ensemble au cas par cas"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נחליט ביחד, כל פעם לפי המצב"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हालात के हिसाब से मिलकर तय करना"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Együtt kitaláljuk, ahogy a helyzetek adódnak"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami cari jalan bersama sesuai situasinya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo decidiamo insieme, caso per caso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その都度ふたりで考える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황이 생길 때마다 함께 풀어 가요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami fikirkan bersama mengikut keadaan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi finner ut av det sammen underveis"
