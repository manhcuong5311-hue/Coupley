        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ርክብን ውርሻን። ኣብቲ ናይ መወዳእታ ምዕራፍ ንእትፈትውዎም ሰባት ምህላው ንዓኹም ኩሉ ነገር እዩ።"
