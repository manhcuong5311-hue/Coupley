        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবার জন্য ঠিক কোনো উত্তর নেই — কিন্তু এখানে মিল থাকলে বড় খিটিমিটি এড়ানো যায়।"
