        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სახლიდან მუშაობა დღეს რეალობაა. სათანადო სივრცე მნიშვნელოვანია შენი პროდუქტიულობისთვის და სულიერი სიმშვიდისთვის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үйден жұмыс істеу қазір қалыпты өмір. Дұрыс жұмыс орны өнімділігің үшін де, жан тыныштығың үшін де маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការធ្វើការពីផ្ទះជាជីវិតពិតនាពេលបច្ចុប្បន្ន។ ការមានកន្លែងសមរម្យ សំខាន់សម្រាប់ផលិតភាព និងសុខភាពផ្លូវចិត្តរបស់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮನೆಯಿಂದ ಕೆಲಸ ಈಗ ಬದುಕಿನ ಭಾಗ. ಸರಿಯಾದ ಜಾಗವಿರುವುದು ನಿಮ್ಮ ಕೆಲಸಕ್ಕೂ ಮನಸ್ಸಿನ ನೆಮ್ಮದಿಗೂ ಮುಖ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 재택근무는 현실이에요. 제대로 된 공간은 업무 효율에도, 마음의 평화에도 중요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xebata ji malê êdî jiyana rastîn e. Hebûna cihekî guncav ji bo berhemdarî û aramiya te girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үйдөн иштөө азыр кадимки жашоонун бир бөлүгү. Өз жумуш ордуң болушу натыйжалуулугуңа жана тынчтыгыңа маанилүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vun doheem schaffen ass haut Alldag. E richtege Raum dofir zielt fir deng Produktivitéit — an däi Seelefridden."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເຮັດວຽກຈາກເຮືອນເປັນຊີວິດຈິງແລ້ວໃນຕອນນີ້ ການມີພື້ນທີ່ທີ່ເໝາະສົມສຳຄັນຕໍ່ທັງປະສິດທິພາບ ແລະ ສຸຂະພາບໃຈຂອງເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbas iš namų dabar – kasdienybė. Tinkama erdvė svarbi tavo produktyvumui ir ramybei."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbs no mājām tagad ir realitāte. Pienācīga darba vieta ir svarīga gan tavai produktivitātei, gan prāta mieram."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny miasa any an-trano no fiainana andavanandro ankehitriny. Zava-dehibe ho an'ny famokaranao sy ny fahatonianao ny fananana toerana mety."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te mahi i te kāinga te āhua o te oranga ināianei. He mea nui te wāhi tika mō tō whai hua me tō mauri tau."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата од дома сега е реалност. Вистински работен простор е важен за твојата продуктивност и за здравиот разум."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വീട്ടിലിരുന്നുള്ള ജോലി ഇന്ന് യാഥാർഥ്യമാണ്. ശരിയായ ഒരിടം ഉണ്ടാകുന്നത് നിങ്ങളുടെ ഉൽപ്പാദനക്ഷമതയ്ക്കും മനസ്സമാധാനത്തിനും പ്രധാനമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэрээсээ ажиллах нь одоо бодит амьдрал. Тохиромжтой орон зайтай байх нь бүтээмж, сэтгэлийн амгаланд чинь чухал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घरून काम करणे आता रोजचे वास्तव आहे. तुमच्या कामासाठी आणि मनःशांतीसाठी योग्य जागा असणे महत्त्वाचे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekerja dari rumah kini realiti hidup. Ruang yang sesuai penting untuk produktiviti dan kewarasan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ix-xogħol mid-dar issa huwa parti mill-ħajja. Spazju xieraq huwa importanti għall-produttività tiegħek u għal moħħok."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အိမ်ကနေ အလုပ်လုပ်တာက အခု တကယ့်ဘဝ ဖြစ်နေပြီ။ သင့်တော်တဲ့ နေရာ ရှိတာက သင့်ထိရောက်မှုနဲ့ စိတ်ငြိမ်မှုအတွက် အရေးကြီးတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmekontor er hverdagen nå. Et ordentlig sted å jobbe betyr mye for både produktiviteten og hodet ditt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घरबाट काम गर्नु अब वास्तविक जीवन हो। राम्रो ठाउँ हुनु तपाईंको काम र मनको शान्ति दुवैका लागि महत्त्वपूर्ण छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuiswerken hoort er nu gewoon bij. Een goede werkplek is belangrijk voor je productiviteit en je gemoedsrust."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugwira ntchito kunyumba tsopano ndi moyo weniweni. Kukhala ndi malo oyenera ndi kofunika pa ntchito yanu ndi mtendere wa maganizo anu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mana irraa hojjechuun amma jireenya dhugaa dha. Iddoo sirrii qabaachuun oomishtummaa kee fi tasgabbii sammuu keetiif barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଘରୁ କାମ କରିବା ଏବେ ବାସ୍ତବ ଜୀବନ। ଆପଣଙ୍କ କାମ ଓ ମନର ଶାନ୍ତି ପାଇଁ ଏକ ଠିକ୍ ଜାଗା ଥିବା ଜରୁରୀ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘਰੋਂ ਕੰਮ ਹੁਣ ਅਸਲ ਜ਼ਿੰਦਗੀ ਹੈ। ਇੱਕ ਸਹੀ ਥਾਂ ਹੋਣਾ ਤੁਹਾਡੇ ਕੰਮ ਅਤੇ ਤੁਹਾਡੇ ਸਕੂਨ, ਦੋਵਾਂ ਲਈ ਜ਼ਰੂਰੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca z domu to dziś codzienność. Porządne miejsce do pracy ma znaczenie dla twojej produktywności i zdrowia psychicznego."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له کوره کار اوس د ژوند برخه ده. یو سم ځای ستاسو د تولید او ذهني آرامۍ لپاره مهم دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar de casa virou a vida real. Ter um espaço de verdade importa para sua produtividade e sua sanidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teletrabalho é a vida real agora. Ter um espaço a sério importa para a tua produtividade e para a tua sanidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munca de acasă e acum realitatea de zi cu zi. Un spațiu potrivit contează pentru productivitatea și liniștea ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённая работа — теперь обычная жизнь. Нормальное рабочее место важно и для продуктивности, и для душевного равновесия."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukorera mu rugo ni ubuzima nyabwo ubu. Kugira umwanya ukwiye ni ingenzi ku musaruro wawe no ku mutuzo wawe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගෙදර ඉඳන් වැඩ කිරීම දැන් සැබෑ ජීවිතය. නිසි ඉඩක් තියෙන එක ඔබේ ඵලදායිතාවටත් මනසේ සමබරතාවටත් වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práca z domu je dnes realita. Poriadny priestor je dôležitý pre tvoju produktivitu aj zdravý rozum."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delo od doma je danes resničnost. Pravi prostor zanj je pomemben za tvojo produktivnost in tvoj duševni mir."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushandira kumba ndihwo hupenyu hwanhasi. Kuva nenzvimbo yakakodzera kunokosha pakushanda kwako nekugadzikana kwepfungwa dzako."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka-shaqaynta guriga waa nolosha dhabta ah hadda. Meel ku habboon oo aad haysato ayaa muhiim u ah wax-soo-saarkaaga iyo nabadda maskaxdaada."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puna nga shtëpia tani është realitet. Një hapësirë e mirëfilltë ka rëndësi për produktivitetin dhe qetësinë tënde."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рад од куће је сада стварност. Прави простор за рад важан је за твоју продуктивност и душевни мир."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damel ti bumi parantos janten kahirupan nyata ayeuna. Gaduh rohangan anu layak penting pikeun produktivitas sareng kawarasan anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att jobba hemifrån är vardag nu. Ett ordentligt utrymme spelar roll för både din produktivitet och ditt psyke."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanya kazi ukiwa nyumbani ni maisha halisi sasa. Kuwa na nafasi maalum ni muhimu kwa tija yako na utulivu wako wa akili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீட்டிலிருந்து வேலை இப்போது நிஜ வாழ்க்கை. சரியான இடம் இருப்பது உங்கள் உற்பத்தித் திறனுக்கும் மன அமைதிக்கும் முக்கியம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంటి నుంచి పని ఇప్పుడు నిజ జీవితంలో భాగం. సరైన చోటు ఉండటం మీ ఉత్పాదకతకు, మీ మనశ్శాంతికి ముఖ్యం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кор аз хона ҳоло зиндагии воқеист. Ҷои дурусти корӣ барои самаранокӣ ва оромии рӯҳиат муҳим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทำงานที่บ้านคือชีวิตจริงในตอนนี้ การมีมุมทำงานที่เหมาะสมสำคัญทั้งต่อประสิทธิภาพและสุขภาพใจของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ገዛ ምስራሕ ሕጂ ናይ ሓቂ ህይወት እዩ። ግቡእ ቦታ ምህላው ንፍርያምነትኩምን ንሚዛን ኣእምሮኹምን ኣገዳሲ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öýden işlemek indi gündelik durmuş. Kadaly iş ýeriniň bolmagy öndürijiligiň we rahatlygyň üçin möhüm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evden çalışmak artık hayatın bir parçası. Düzgün bir alan, hem verimliliğin hem akıl sağlığın için önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота з дому — тепер звична реальність. Повноцінне робоче місце важливе і для продуктивності, і для душевного спокою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھر سے کام اب حقیقت ہے۔ ایک مناسب جگہ آپ کی کارکردگی اور ذہنی سکون دونوں کے لیے اہم ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uydan ishlash endi hayotning bir qismi. Toʻgʻri jihozlangan joy unumdorligingiz va xotirjamligingiz uchun muhim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm việc tại nhà giờ đã là đời thực. Có một góc làm việc đàng hoàng rất quan trọng cho năng suất và sự tỉnh táo của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukusebenzela ekhaya bubomi bokwenyani ngoku. Ukuba nendawo efanelekileyo kubalulekile kwimveliso yakho nakwingqondo yakho."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣíṣiṣẹ́ láti ilé ti di ìgbésí ayé gidi báyìí. Níní àyè tó yẹ ṣe pàtàkì fún iṣẹ́ yín àti àlàáfíà ọkàn yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家工作已是現實生活。有個像樣的工作空間，對你的效率和心理健康都很重要。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居家办公已经是日常。有一个像样的空间，关系到你的效率和心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家工作已經是日常。擁有一個像樣的空間，對你的效率和身心平衡都很重要。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukusebenzela ekhaya sekuyimpilo yangempela manje. Ukuba nendawo efanele kubalulekile ekukhiqizeni kwakho nasempilweni yakho yengqondo."
          }
        }
      }
    },
