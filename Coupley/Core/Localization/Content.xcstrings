        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henoy toy ny namana, fa tsy toy ny mpanamboatra. Avereno izay tsapany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whakarongo pēnei i te hoa, kaua i te kaiwhakatika. Whakahokia ōna kare ā-roto ki a ia."
