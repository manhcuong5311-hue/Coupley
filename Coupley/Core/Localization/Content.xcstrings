    "Spontaneous and unbothered. You can enjoy almost anything. Low-maintenance taste." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عفويون ولا يزعجكم شيء. تستمتعون بكل شيء تقريبًا، وذوقكم سهل الإرضاء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontánnost a pohoda. Užiješ si skoro cokoli. Nenáročný vkus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontan og ubekymret. Du kan nyde næsten alt. En smag, der er nem at have med at gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontan und unkompliziert. Dir gefällt fast alles. Ein pflegeleichter Geschmack."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυθόρμητα και ανέμελα. Μπορείς να απολαύσεις σχεδόν τα πάντα. Γούστα χωρίς απαιτήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espontaneidad y cero complicaciones. Disfrutas casi de cualquier cosa. Un gusto fácil de complacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontaani ja huoleton. Pystyt nauttimaan melkein mistä vain. Vaivaton maku."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biglaan at chill lang. Halos kahit ano, kaya mong i-enjoy. Madali kang pasayahin pagdating sa music."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontanéité et décontraction. Tu peux apprécier presque tout. Des goûts faciles à satisfaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספונטניות ובלי לחץ. כמעט הכול יכול לעשות לך טוב. טעם קליל ולא תובעני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेफ़िक्र और सहज। आपको लगभग सब कुछ अच्छा लग सकता है। आपकी पसंद में कोई नख़रा नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontán és laza. Szinte bármit élvezel. Könnyű a kedvedre tenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontan dan santai. Kamu bisa menikmati hampir apa saja. Selera yang nggak ribet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontaneità e zero pretese. Ti piace quasi tutto. Un gusto facile da accontentare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気まぐれでこだわらないタイプです。たいていの曲を楽しめる、おおらかな好みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉흥적이고 무던해요. 웬만한 건 다 즐길 수 있는, 까다롭지 않은 취향이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontan dan tidak kisah. Anda boleh menikmati hampir apa sahaja. Citarasa yang mudah dilayan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontan og avslappet. Du kan nyte nesten hva som helst. Du er lett å gjøre fornøyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontaan en relaxed. Je kunt van bijna alles genieten. Een makkelijke smaak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spontanicznie i na luzie. Cieszy cię prawie wszystko. Gust bez wymagań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espontaneidade e zero estresse. Você curte quase qualquer coisa. Gosto fácil de agradar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
