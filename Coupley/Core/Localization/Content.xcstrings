        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ದೀರ್ಘಾವಧಿಯ ಆಟ ಆಡುತ್ತಿದ್ದೀರಿ. ಭವಿಷ್ಯದ ನೀವು ನಿಮ್ಮಿಬ್ಬರಿಗೂ ಧನ್ಯವಾದ ಹೇಳುತ್ತೀರಿ."
