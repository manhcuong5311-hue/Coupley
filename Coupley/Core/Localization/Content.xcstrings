        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі подобаються тварини, але до повної відповідальності зараз не тягне. Це може змінитися — а може й ні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thích động vật nhưng hiện chưa muốn gắn bó trọn vẹn. Điều đó có thể thay đổi — hoặc không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你喜欢动物，只是现在还不想承担养宠物的全部责任。这可能会变，也可能不会。"
