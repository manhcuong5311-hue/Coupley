        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं त्यो भावना साँचेर राख्नुहुन्छ। त्यसलाई जोगाएर सिधै दिनुमा एक किसिमको सोचविचार लुकेको छ।"
