    "The nuanced answer — and often the healthiest one. Together where it counts, independent where it matters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابة الأكثر عمقًا، وغالبًا الأصح. معًا حيث يهم الأمر، ومستقلّان حيث يلزم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvážená odpověď – a často ta nejzdravější. Spolu tam, kde na tom záleží, a samostatně tam, kde je to důležité."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nuancerede svar – og ofte det sundeste. Sammen, hvor det tæller, og selvstændige, hvor det betyder noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die differenzierte Antwort – und oft die gesündeste. Gemeinsam, wo es zählt, unabhängig, wo es wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πιο ώριμη απάντηση — και συχνά η πιο υγιής. Μαζί εκεί που μετράει, με ανεξαρτησία εκεί που έχει σημασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respuesta matizada, y a menudo la más sana. Juntos en lo esencial, independientes donde importa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivahteikas vastaus – ja usein myös se tervein. Yhdessä siellä, missä sillä on merkitystä, ja itsenäisesti siellä, missä se on tärkeää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang sagot na may lalim — at madalas, ang pinakamalusog. Magkasama kung saan mahalaga, malaya kung saan kailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse nuancée, et souvent la plus saine. Ensemble là où ça compte, autonomes là où c'est important."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשובה המורכבת — ולעיתים קרובות הבריאה ביותר. ביחד איפה שזה נחשב, עצמאות איפה שזה חשוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सधा हुआ जवाब — और अक्सर सबसे सेहतमंद भी। जहाँ ज़रूरी हो वहाँ साथ, जहाँ मायने रखे वहाँ आज़ाद।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az árnyalt válasz – és gyakran a legegészségesebb. Együtt, ahol számít, függetlenül, ahol fontos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban yang bernuansa — dan sering kali yang paling sehat. Bersama di hal yang penting, mandiri di hal yang berarti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La risposta più sfumata, e spesso la più sana. Insieme dove conta, indipendenti dove serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥行きのある答えで、いちばん健やかなことも多い考え方。大事なところでは一緒に、必要なところではそれぞれに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "섬세한 답이고, 대개 가장 건강한 답이에요. 중요한 곳에선 함께, 필요한 곳에선 따로."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawapan yang bernuansa — dan selalunya yang paling sihat. Bersama dalam perkara yang penting, bebas dalam hal yang bermakna bagi diri sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nyanserte svaret – og ofte det sunneste. Sammen der det teller, selvstendig der det betyr noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het genuanceerde antwoord – en vaak het gezondste. Samen waar het telt, onafhankelijk waar het ertoe doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź pełna niuansów – i często najzdrowsza. Razem tam, gdzie to ważne, osobno tam, gdzie to potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta cheia de nuances — e muitas vezes a mais saudável. Juntos onde conta, independentes onde importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răspunsul nuanțat — și adesea cel mai sănătos. Împreună unde contează, independent unde e important."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонкий ответ — и часто самый здоровый. Вместе там, где это важно, и независимо там, где это нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nyanserade svaret – och ofta det sundaste. Tillsammans där det räknas, självständiga där det spelar roll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบที่ละเอียดอ่อน และมักเป็นแบบที่ดีต่อใจที่สุด อยู่ด้วยกันในเรื่องที่สำคัญ และเป็นอิสระในเรื่องที่ควรเป็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnce ayarlı cevap ve çoğu zaman en sağlıklısı. Önemli yerde birlikte, gereken yerde bağımsız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонка відповідь — і часто найздоровіша. Разом — у головному, окремо — там, де це важливо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời tinh tế — và thường là lành mạnh nhất. Cùng nhau ở những điều đáng kể, độc lập ở những điều quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有分寸的答案，往往也是最健康的。重要的事一起面对，在意的地方保持独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細膩的答案，往往也是最健康的。該一起的地方一起，該獨立的地方獨立。"
          }
        }
      }
    },
    "The relationship is your sanctuary. Too many external commitments can feel like they dilute the intimacy you value." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العلاقة ملاذكم. كثرة الالتزامات الخارجية قد تبدو لكم كأنها تُضعف الحميمية التي تقدّرونها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vztah je tvoje útočiště. Máš pocit, že příliš mnoho závazků navenek ředí intimitu, které si ceníš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet er dit fristed. For mange forpligtelser udefra kan føles, som om de udvander den intimitet, du sætter pris på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Beziehung ist dein Rückzugsort. Zu viele Verpflichtungen nach außen fühlen sich an, als würden sie die Nähe verwässern, die dir so wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σχέση είναι το καταφύγιό σου. Οι πολλές εξωτερικές υποχρεώσεις σού μοιάζουν να αραιώνουν την οικειότητα που εκτιμάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relación es tu refugio. Demasiados compromisos externos pueden dar la sensación de diluir la intimidad que valoras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parisuhde on turvapaikkasi. Liian monet ulkoiset menot voivat tuntua laimentavan läheisyyttä, jota arvostat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang relasyon ang santuwaryo mo. Pakiramdam mo, napapalabnaw ng sobrang daming lakad sa labas ang lapit na pinahahalagahan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre couple est ton refuge. Trop d'engagements extérieurs, et tu as l'impression que l'intimité à laquelle tu tiens se dilue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזוגיות היא המקלט שלך. יותר מדי התחייבויות מבחוץ עלולות להרגיש כאילו הן מדללות את האינטימיות שחשובה לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिश्ता आपकी पनाह है। बाहर की बहुत सारी ज़िम्मेदारियाँ आपको उस नज़दीकी को फीका करती लगती हैं, जिसे आप संजोते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat a menedéked. A túl sok külső program mintha felhígítaná a bensőségességet, amelyet annyira értékelsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan adalah tempat berlindungmu. Terlalu banyak komitmen di luar bisa terasa mengencerkan keintiman yang kamu hargai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relazione è il tuo rifugio. Troppi impegni esterni rischiano di annacquare l’intimità a cui tieni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの関係が心の避難所です。外の予定が多すぎると、大切にしている親密さが薄まる気がしてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연애는 나만의 안식처예요. 바깥 약속이 너무 많으면 소중한 친밀함이 옅어지는 것처럼 느껴져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan ialah tempat perlindungan anda. Terlalu banyak komitmen luar boleh terasa seperti mencairkan keintiman yang anda hargai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet er fristedet ditt. For mange forpliktelser utenfra kan føles som om de vanner ut nærheten du setter pris på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De relatie is je veilige haven. Te veel verplichtingen buitenaf voelen alsof ze de intimiteit verwateren die je zo waardeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Związek to twoja przystań. Zbyt wiele zobowiązań na zewnątrz może rozmywać bliskość, którą tak cenisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relação é seu refúgio. Compromissos demais lá fora podem diluir a intimidade que você valoriza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relația e refugiul tău. Prea multe obligații din afară îți dau senzația că diluează intimitatea pe care o prețuiești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отношения — твоё убежище. Слишком много внешних обязательств словно размывает близость, которую ты ценишь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationen är din fristad. För många åtaganden utanför kan kännas som att de urvattnar närheten du värdesätter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสัมพันธ์คือที่พักใจของคุณ นัดข้างนอกที่มากเกินไปอาจทำให้ความใกล้ชิดที่คุณให้คุณค่าดูเจือจางลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişki senin sığınağın. Dışarıdaki fazla meşguliyet, değer verdiğin yakınlığı sulandırıyormuş gibi gelebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стосунки — твій прихисток. Забагато зовнішніх зобов’язань ніби розмивають ту близькість, яку ти цінуєш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mối quan hệ là chốn bình yên của bạn. Quá nhiều cuộc hẹn bên ngoài khiến bạn thấy sự thân mật mình trân trọng như bị pha loãng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情是你的避风港。外面的安排太多，会让你觉得你们珍视的亲密被冲淡了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段感情是你的避風港。太多外界的邀約，可能會讓你覺得珍惜的親密感被稀釋了。"
          }
        }
      }
    },
