        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτιμάς την οικονομική ανεξαρτησία. Δουλεύει καλά με σαφείς συμφωνίες για το πώς μοιράζονται τα κοινά έξοδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoras la independencia económica. Funciona bien con acuerdos claros sobre cómo se manejan los gastos comunes."
