    "A small gesture — coffee, a note, something thoughtful" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لفتة صغيرة: قهوة أو رسالة أو شيء لطيف"
