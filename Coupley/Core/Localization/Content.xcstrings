        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kafa yormayan bir şeyi birlikte yapın: yemek pişirin, çamaşır katlayın, resim çizin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зробіть разом щось, що нічого не вимагає, — приготуйте їсти, складіть білизну, помалюйте."
