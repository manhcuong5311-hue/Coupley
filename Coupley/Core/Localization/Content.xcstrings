    "Genuinely flexible. You probably won't cause holiday friction — you're the one who smooths it over." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرنون حقًا. على الأرجح لن تكونوا سبب احتكاك في العطلة، بل أنتم من يلطّف الأجواء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdová flexibilita. Třenice na dovolené nejspíš nezpůsobuješ – spíš je urovnáváš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virkelig fleksibel. Du skaber nok ikke gnidninger på ferien – du er den, der glatter dem ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echt flexibel. Für Urlaubsstress sorgst du wahrscheinlich nicht – eher glättest du die Wogen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αληθινή ευελιξία. Μάλλον δεν θα φέρεις τριβές στις διακοπές — εσύ είσαι που τις εξομαλύνεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad de verdad. Seguramente no causarás roces en vacaciones: eres quien los suaviza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidosti joustava. Tuskin aiheutat lomakitkaa – olet se, joka silottelee sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talagang flexible. Malamang hindi ka magdudulot ng tampuhan sa bakasyon — ikaw pa ang umaayos nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraiment flexible. Tu ne seras sûrement pas source de tensions en vacances : c'est plutôt toi qui les apaises."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות אמיתית. כנראה שלא יגיע ממך חיכוך בחופשה — להפך, בדרך כלל דווקא בזכותך החיכוכים נרגעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सच में लचीले। आपकी वजह से छुट्टी में शायद ही कोई टकराव हो — बल्कि आप ही उसे सुलझाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igazán rugalmas vagy. Valószínűleg nem te okozol súrlódást a nyaraláson – inkább te simítod el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar fleksibel. Kamu kemungkinan nggak akan memicu gesekan saat liburan — justru kamu yang meredakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibilità vera. Probabilmente non sarai tu a creare attriti in vacanza — anzi, sarai tu ad appianarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当に柔軟なタイプです。旅先でもめごとを起こすどころか、むしろ丸く収める役でしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 유연한 타입이에요. 여행 중 갈등을 만들기보다 오히려 부드럽게 풀어 주는 사람일 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar fleksibel. Anda mungkin tidak akan mencetuskan pergeseran semasa bercuti — andalah yang meredakannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virkelig fleksibel. Du skaper neppe gnisninger på ferie – du er den som glatter over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echt flexibel. Jij zorgt waarschijnlijk niet voor vakantiewrijving – jij bent juist degene die het gladstrijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprawdę elastycznie. Raczej nie wywołasz urlopowych tarć – to ty je łagodzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade de verdade. Você dificilmente vai causar atrito nas férias — é você quem acalma os ânimos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate reală. Probabil nu vei crea fricțiuni în vacanță — dimpotrivă, tu le netezești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-настоящему гибко. Ты вряд ли станешь причиной ссоры в отпуске — скорее именно ты всё сгладишь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkligen flexibel. Du orsakar nog inget semestergnissel – du är den som jämnar ut det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นอย่างแท้จริง คุณคงไม่ใช่ต้นเหตุของการกระทบกระทั่งในวันหยุด แต่เป็นคนที่ช่วยไกล่เกลี่ยให้ราบรื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçekten esneksin. Tatilde muhtemelen sürtüşme çıkaran değil, onu yatıştıran kişisin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справжня гнучкість. Навряд чи через тебе виникатиме тертя у відпустці — радше ти його згладжуватимеш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt thật sự. Có lẽ bạn sẽ không gây va chạm trong kỳ nghỉ — bạn là người xoa dịu mọi thứ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是真的很灵活。你多半不会在旅途中制造摩擦——你是那个负责缓和气氛的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真的很有彈性。你大概不會在旅途中製造摩擦，反而是負責化解的那個人。"
          }
        }
      }
    },
