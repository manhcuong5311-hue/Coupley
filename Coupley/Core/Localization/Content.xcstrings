        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୋ ପାଇଁ କଷ୍ଟକର କିଛି — ସଭାରେ କହିବା, ଆତ୍ମବିଶ୍ୱାସ"
