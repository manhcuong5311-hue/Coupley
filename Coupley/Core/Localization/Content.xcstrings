        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τακτικές κουβέντες για τη σχέση εμποδίζουν τα μικρά να γίνουν μεγάλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablar de la relación evita que las cosas pequeñas se vuelvan grandes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säännölliset suhdekeskustelut estävät pieniä asioita kasvamasta isoiksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
