        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azok az ételek, amelyektől otthon érzed magad – semmi ítélkezés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan yang bikin kamu merasa di rumah — tanpa menghakimi."
