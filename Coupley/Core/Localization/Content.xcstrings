    "Energy and access. You want walkability, noise, convenience. The city is your natural habitat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيوية وسهولة وصول. المشي إلى كل مكان، والصخب، والراحة. المدينة بيئتك الطبيعية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie a dostupnost. Chceš mít všechno pěšky, ruch a pohodlí. Město je tvoje přirozené prostředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi og nærhed. Du vil have gåafstand, liv og bekvemmelighed. Byen er dit naturlige habitat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie und kurze Wege. Du willst alles zu Fuß erreichen und magst Trubel und Komfort. Die Stadt ist dein natürlicher Lebensraum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενέργεια και πρόσβαση. Θες τα πάντα σε απόσταση με τα πόδια, βαβούρα, ευκολίες. Η πόλη είναι το φυσικό σου περιβάλλον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energía y acceso. Quieres tenerlo todo a un paseo, el bullicio, la comodidad. La ciudad es tu hábitat natural."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energiaa ja saavutettavuutta. Haluat kävelyetäisyydet, elämän äänet ja helppouden. Kaupunki on luonnollinen elinympäristösi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigla at accessibility. Gusto mo ng lugar na kayang lakarin, may ingay, at maginhawa. Ang lungsod ang natural mong tahanan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énergie et accès à tout. Tu veux tout pouvoir faire à pied, de l'animation et du pratique. La ville est ton habitat naturel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנרגיה ונגישות. בא לך הכול במרחק הליכה, רעש, נוחות. העיר היא בית הגידול הטבעי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रौनक और सुविधा। पैदल दूरी, चहल-पहल, आराम — शहर ही आपका असली ठिकाना है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pezsgés és elérhetőség. Gyalog mindenhova, zaj, kényelem. A város a természetes közeged."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi dan akses. Kamu ingin semuanya bisa dijangkau jalan kaki, ramai, dan praktis. Kota adalah habitat alamimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia e comodità. Vuoi fare tutto a piedi, vivere nel via vai, avere ogni servizio a portata di mano. La città è il tuo habitat naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活気とアクセスのよさ。歩いて暮らせる距離、にぎやかさ、便利さを求めています。都会こそが自分の居場所です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활기와 접근성이 중요해요. 걸어서 다닐 수 있고, 북적이고, 편리한 곳이요. 도시가 딱 맞는 서식지예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenaga dan kemudahan akses. Anda mahu tempat yang boleh dijelajah berjalan kaki, meriah dan serba mudah. Bandar ialah habitat semula jadi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi og nærhet. Du vil gå overalt, ha liv rundt deg og alt lett tilgjengelig. Byen er ditt naturlige habitat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie en alles binnen handbereik. Je wilt alles op loopafstand, reuring en gemak. De stad is je natuurlijke habitat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia i dostęp do wszystkiego. Chcesz mieć wszystko blisko, gwar i wygodę. Miasto to twoje naturalne środowisko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia e acesso. Você quer fazer tudo a pé, movimento, praticidade. A cidade é o seu habitat natural."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie și acces. Vrei totul la câțiva pași, zgomot, comoditate. Orașul e habitatul tău natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энергия и доступность. Тебе нужно, чтобы всё было рядом, — шум, удобство, движение. Город — твоя естественная среда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi och närhet. Du vill ha gångavstånd, liv och bekvämlighet. Staden är din naturliga miljö."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคึกคักและการเข้าถึงทุกอย่าง คุณอยากเดินไปไหนมาไหนได้ ชอบเสียงอึกทึกและความสะดวกสบาย เมืองคือที่ที่คุณเป็นตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji ve erişim. Yürüyerek her yere ulaşmak, hareket, kolaylık istiyorsun. Şehir senin doğal yaşam alanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія й доступність. Тобі потрібні піші відстані, гамір, зручність. Місто — твоє природне середовище."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năng lượng và tiện lợi. Bạn muốn đi bộ là tới, muốn nhộn nhịp, muốn tiện nghi. Thành phố là môi trường tự nhiên của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活力和便利。你想要步行可达、热闹、方便。城市就是你的天然栖息地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活力與便利。你想要走路就能到、熱鬧又方便。城市就是你的天然棲地。"
          }
        }
      }
    },
