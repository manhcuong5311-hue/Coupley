        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איזון. יש לך גאווה מקצועית בלי לאבד את עצמך בתוכה. כנראה שבנושא הזה קל להיות איתך בזוגיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संतुलित नज़रिया। काम पर गर्व है, पर उसमें ख़ुद को खोए बिना। इस मामले में आपके साथ रिश्ता निभाना शायद आसान है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiegyensúlyozott vagy. Büszke vagy a munkádra, de nem veszel el benne. Ezen a téren valószínűleg könnyű veled kapcsolatban lenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang. Kamu bangga dengan pekerjaanmu tanpa tenggelam di dalamnya. Soal ini, kamu mungkin mudah diajak menjalin hubungan."
