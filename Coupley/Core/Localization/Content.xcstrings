        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਿਹਾਰਕ ਸੋਚ। ਤੁਹਾਡੀ ਅਸਲ ਜ਼ਿੰਦਗੀ ਕੰਮ ਤੋਂ ਬਾਹਰ ਵਸਦੀ ਹੈ। ਨੌਕਰੀ ਤਾਂ ਵੱਡੇ ਸੁਪਨੇ ਤੱਕ ਪਹੁੰਚਣ ਦਾ ਜ਼ਰੀਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatycznie. Twoje prawdziwe życie toczy się poza pracą. Praca służy wizji."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملي لید. ستاسو اصلي ژوند له کار بهر تېرېږي. دنده ستاسو د لید خدمت کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatismo. Sua vida de verdade acontece fora do trabalho. O emprego está a serviço dos seus planos."
