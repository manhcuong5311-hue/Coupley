            "state" : "translated",
            "value" : "Конкретне > загальне. «Ти неймовірна людина» звучить пласко."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cụ thể hơn chung chung. “Bạn tuyệt lắm” nghe khá nhạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "具体胜过笼统。“你太棒了”听起来很空。"
