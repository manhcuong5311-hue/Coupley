        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dich ist die Beziehung ein gemeinsames Projekt. Große Entscheidungen trefft ihr zu zweit – und genau so willst du es."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βλέπεις τη σχέση σαν κοινό εγχείρημα. Οι μεγάλες αποφάσεις αφορούν και τους δυο σας — και έτσι ακριβώς το θέλεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves la relación como un proyecto común. Las grandes decisiones son cosa de los dos, y así es como lo quieres."
