        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բաց ես փոփոխությունների, բայց ծանոթ մշակույթի սահմաններում։ Ուզում ես նոր սկիզբ՝ առանց ամբողջովին տեղափոխվելու անորոշության։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terbuka pada perubahan, tapi tetap dalam budaya yang familier. Kamu ingin awal baru tanpa ketidakpastian pindah sepenuhnya."
