        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nkhani zachinsinsi zizikhala zachinsinsi. Kudzudzulidwa pagulu kumaoneka ngati kuphwanya ulemu kwakukulu."
