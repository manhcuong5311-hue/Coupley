        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "උපරිම ශක්තිය, උපරිම ශබ්දය. ඔබ පිටත් වුණු වෙලාවට වඩා හොඳ මනෝභාවයකින් ඔබ ගමනාන්තයට යනවා ඇති."
