        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtalen er din måde at afslutte dagen på. Det er et smukt ritual for et par – sørg for, at din partner ved, hvor meget det betyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Nähe schließt du den Tag ab. Ein wunderschönes Ritual für euch – sag deinem Schatz, wie viel es dir bedeutet."
