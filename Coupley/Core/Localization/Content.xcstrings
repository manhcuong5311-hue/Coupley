            "value" : "Rahat dymmak — doldurmak hökman däl"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat bir sessizlik, doldurmaya gerek yok"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затишна тиша — її не треба заповнювати"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آرام دہ خاموشی — بھرنے کی ضرورت نہیں"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qulay sukunat — uni toʻldirish shart emas"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im lặng dễ chịu — chẳng cần lấp đầy"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthula okukhululekileyo — akukho mfuneko yokukuzalisa"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdákẹ́jẹ́ tó rọ̀ni — kò sí ìdí láti kún un"
