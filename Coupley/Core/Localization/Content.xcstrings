    "Paint a picture — the life you'd both be living if things went well." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilder ’n prentjie – die lewe wat julle albei sou leef as dinge goed gaan."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስሉን ይሳሉ — ነገሮች መልካም ቢሄዱ ሁለታችሁ የምትኖሩት ሕይወት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسموا صورة للحياة التي ستعيشانها معًا لو جرت الأمور على ما يرام."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন ছবি আঁকক — সকলো ভালে ভালে গ'লে আপোনালোক দুয়ো যি জীৱন কটাব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təsəvvür et — hər şey yaxşı getsə, ikinizin yaşayacağı həyatı."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намалюй карціну — жыццё, якім вы абое жылі б, калі ўсё складзецца добра."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарисувай картина – живота, който бихте живели, ако всичко върви добре."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটা ছবি আঁকো — সব ঠিকঠাক চললে তোমরা দুজন যে জীবনটা কাটাতে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opiši život koji vas čeka ako sve krene kako treba."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta'n la imatge — la vida que viuríeu els dos si les coses anessin bé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresli to – život, jaký byste spolu vedli, kdyby se všechno dařilo."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disgrifia'r darlun — y bywyd y byddech chi'ch dau'n ei fyw petai pethau'n mynd yn dda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal et billede af det liv, I to ville leve, hvis alt gik godt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Male es dir aus – das Leben, das ihr beide führen würdet, wenn alles gut läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
