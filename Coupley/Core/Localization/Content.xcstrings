          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות מקסימלית — או אי־ודאות אמיתית. כך או כך, אין לך עוגן במקום מסוים, וזה חופש אמיתי."
