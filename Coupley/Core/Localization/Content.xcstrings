        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käwagt iň gowy duşuşyk — hiç kimiň aýakgap geýmeli däl ýeri. Ajaýyp gurşawdan rahatlyk we ýeňillik öňde."
