        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توازن۔ آپ کو نگرانی کرنا پسند نہیں، مگر جب کوئی آدھا ہی موجود ہو تو آپ کو محسوس ہو جاتا ہے۔"
