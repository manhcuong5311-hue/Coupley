        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swobodna cisza – nie trzeba jej wypełniać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silêncio confortável — sem precisar preencher"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăcerea confortabilă — nu trebuie umplută"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уютное молчание — его не нужно заполнять"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekväm tystnad – inget behov av att fylla den"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงียบอย่างสบายใจ ไม่ต้องหาอะไรมาเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat bir sessizlik, doldurmaya gerek yok"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затишна тиша — її не треба заповнювати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im lặng dễ chịu — chẳng cần lấp đầy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舒服的沉默，不必填满"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自在的沉默，不必刻意找話"
          }
        }
      }
    },
