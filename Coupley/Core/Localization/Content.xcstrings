        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ජීවත් වෙන අවකාශය හැමදේටම බලපානවා — ඔබ විවේක ගන්න, අනිත් අය එක්ක ගැවසෙන, වැඩ කරන හැටිට."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priestor, v ktorom žiješ, ovplyvňuje všetko – ako oddychuješ, stretávaš sa s ľuďmi aj pracuješ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor, v katerem živiš, vpliva na vse – na to, kako počivaš, se družiš in delaš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nzvimbo yaunogara inokanganisa zvose — mazororo ako, mashamwaridzano ako, mashandiro ako."
