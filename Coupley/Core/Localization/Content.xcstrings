      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groei in aksie. Jy het dinge raakgesien wat jy nie wil oordra nie – en jy doen die werk. Dis betekenisvol."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በተግባር ላይ ያለ እድገት። ማስተላለፍ የማይፈልጓቸውን ነገሮች ለይተዋል — እናም ሥራውን እየሠሩ ነው። ይህ ትልቅ ነገር ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نموّ على أرض الواقع. حددتم ما لا تريدون توريثه، وتبذلون الجهد لأجل ذلك، وهذا أمر كبير."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কামত প্ৰকাশ পোৱা বিকাশ। আপুনি আগলৈ নিদিব বিচৰা কথাবোৰ চিনাক্ত কৰিছে — আৰু তাৰ ওপৰত কাম কৰি আছে। এয়া উল্লেখযোগ্য।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hərəkətdə olan inkişaf. Ötürmək istəmədiyin şeyləri müəyyən etmisən — və bunun üzərində işləyirsən. Bu, çox önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рост у дзеянні. Ты ўжо ведаеш, чаго не хочаш перадаваць далей, — і працуеш над гэтым. Гэта вельмі шмат значыць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растеж в действие. Разпознаваш неща, които не искаш да предадеш нататък – и работиш по тях. Това е много."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেড়ে ওঠা, হাতে-কলমে। কী পরের প্রজন্মে নিয়ে যেতে চাও না, তা চিনেছ — আর তার ওপর কাজ করছ। এটা অনেক বড় ব্যাপার।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast na djelu. Prepoznaješ šta ne želiš prenijeti dalje – i radiš na tome. To mnogo znači."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creixement en acció. Has identificat coses que no vols transmetre — i hi estàs treballant. Això té molt de valor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Růst v praxi. Víš, co nechceš předávat dál – a pracuješ na tom. To je hodně."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twf ar waith. Rwyt ti wedi adnabod pethau dwyt ti ddim eisiau eu trosglwyddo — ac rwyt ti'n gwneud y gwaith. Mae hynny'n arwyddocaol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udvikling i praksis. Du har fundet ting, du ikke vil give videre – og du gør arbejdet. Det betyder meget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachstum in Aktion. Du hast erkannt, was du nicht weitergeben willst – und arbeitest daran. Das ist viel wert."
