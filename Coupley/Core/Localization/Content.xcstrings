        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert til í breytingar, en innan kunnuglegrar menningar. Þú vilt nýja byrjun án óvissunnar sem fylgir því að flytja alla leið."
