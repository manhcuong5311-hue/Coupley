    "Ask: 'do you want to vent, problem-solve, or be distracted?'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا: «ماذا يناسبك الآن: الفضفضة، أم البحث عن حل، أم شيء يلهيك؟»"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se: „Chceš se vypovídat, něco vyřešit, nebo přijít na jiné myšlenky?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg: »Vil du lufte ud, løse det eller tænke på noget andet?«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag: „Willst du Dampf ablassen, eine Lösung finden oder abgelenkt werden?“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα: «Θέλεις να ξεσπάσεις, να το λύσουμε ή να ξεχαστείς;»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale: “¿Quieres desahogarte, buscar soluciones o distraerte?”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy: ”Haluatko purkautua, ratkoa ongelmaa vai saada muuta ajateltavaa?”"
