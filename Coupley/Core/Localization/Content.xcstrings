        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịrụ ọrụ n'ụlọ bụ ndụ n'ezie ugbu a. Inwe ezigbo ebe dị mkpa maka ọrụ gị na udo uche gị."
