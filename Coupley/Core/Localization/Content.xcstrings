          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার প্রবণতা হাতে-কলমে সাহায্য করা। শুধু একবার দেখে নিয়ো, ও সমাধান চাইছে, নাকি শুধু কেউ শুনুক চাইছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instinktivno pomažeš praktično. Samo provjeri želi li voljena osoba rješenja ili samo nekoga ko će je saslušati."
