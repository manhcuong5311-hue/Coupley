            "value" : "Aktiviti yang menyibukkan tangan membuka ruang untuk perbualan tenang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når hendene har noe å gjøre, kommer de rolige samtalene lettere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je handen bezig zijn, komt een rustig gesprek vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajęte ręce otwierają drogę do spokojnej rozmowy."
