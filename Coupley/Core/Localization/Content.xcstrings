        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ ऐसा जो हम साथ मिलकर बनाएँ, और जो हम दोनों से बड़ा हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valami, amit együtt hozunk létre, és nagyobb bármelyikünknél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu yang kita bangun bersama, lebih besar dari kita masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa che costruiamo insieme e che è più grande di entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで一緒につくる、ひとりでは届かない大きなもの。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우리 둘보다 더 큰 무언가를 함께 만드는 일."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu yang kita bina bersama, lebih besar daripada kita berdua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det vi skaper sammen, som er større enn hver av oss."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets wat we samen opbouwen en dat groter is dan ieder van ons."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś, co tworzymy razem i co przerasta każde z nas z osobna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquilo que criamos juntos e que é maior do que cada um de nós."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva ce construim împreună și e mai mare decât fiecare dintre noi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что мы создаём вместе и что больше каждого из нас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det vi bygger tillsammans som är större än oss båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่เราสร้างด้วยกัน ซึ่งยิ่งใหญ่กว่าตัวเราแต่ละคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte yarattığımız, ikimizden de büyük olan şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, що ми створимо разом і що більше за кожного з нас."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều hai đứa cùng tạo nên, lớn hơn bất kỳ ai trong hai người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们一起创造的，比我们任何一个人都更大的事。"
