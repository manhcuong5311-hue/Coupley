        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makat naplno – dávám tomu všechno"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gweithio'n galed, chwarae'n galed — dw i'n rhoi popeth iddo"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
