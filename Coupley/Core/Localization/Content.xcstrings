        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابة الأكثر عمقًا، وغالبًا الأصح. معًا حيث يهم الأمر، ومستقلّان حيث يلزم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সূক্ষ্ম উত্তৰ — আৰু প্ৰায়ে আটাইতকৈ সুস্থ উত্তৰ। য'ত দৰকাৰ তাত একেলগে, য'ত গুৰুত্বপূৰ্ণ তাত স্বাধীন।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İncə cavab — və çox vaxt ən sağlamı. Lazım olan yerdə birlikdə, önəmli olan yerdə müstəqil."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адказ з нюансамі — і часта самы здаровы. Разам там, дзе гэта важна, і паасобку там, дзе гэта мае значэнне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нюансираният отговор – и често най-здравословният. Заедно в общото, поотделно в личното."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সূক্ষ্ম উত্তর — আর প্রায়ই সবচেয়ে সুস্থ। যেখানে দরকার সেখানে একসাথে, যেখানে জরুরি সেখানে স্বাধীন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijansiran odgovor – i često najzdraviji. Zajedno gdje je bitno, nezavisno gdje je važno."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resposta matisada — i sovint la més sana. Plegats en el que compta, independents en el que importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvážená odpověď – a často ta nejzdravější. Spolu tam, kde na tom záleží, a samostatně tam, kde je to důležité."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yr ateb cynnil — ac yn aml yr un iachaf. Gyda'ch gilydd lle mae'n cyfrif, yn annibynnol lle mae'n bwysig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nuancerede svar – og ofte det sundeste. Sammen, hvor det tæller, og selvstændige, hvor det betyder noget."
