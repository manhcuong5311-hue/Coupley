            "state" : "translated",
            "value" : "Tamar badan + farxad waa marka wax-aan-la-qorsheyn runtii dhacaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energji e lartë + lumturi është koha kur spontaniteti ndodh vërtet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пуно енергије + срећа = тренутак кад се спонтаност заиста дешава."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanaga luhur + bagja téh waktosna spontanitas leres-leres kajantenan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hög energi + glad är när spontanitet faktiskt blir av."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguvu nyingi na furaha ndio wakati mambo ya ghafla hutokea kweli."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உற்சாகமும் மகிழ்ச்சியும் இருக்கும்போதுதான் திடீர்த் திட்டங்கள் உண்மையில் நடக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "శక్తి ఎక్కువ + సంతోషం ఉన్నప్పుడే అప్పటికప్పుడు ప్లాన్లు నిజంగా జరుగుతాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қуввати баланд ва хушҳолӣ — маҳз ҳамон вақте, ки корҳои ногаҳонӣ воқеан рух медиҳанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนมีพลังและมีความสุข คือจังหวะที่การทำอะไรแบบไม่ได้วางแผนเกิดขึ้นได้จริง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዙሕ ጉልበትን ሓጐስን ምስ ዝህሉ እዩ ድንገታውነት ብሓቂ ዝፍጠር።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güýç köp we keýp şat bolanda, duýdansyzlyk hakykatdan amala aşýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji yüksek ve keyif yerindeyse spontanelik gerçekten yaşanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багато енергії + щастя — саме тоді спонтанність і стається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بھرپور توانائی اور خوشی، یہی وہ وقت ہے جب بے ساختگی واقعی ممکن ہوتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuch koʻp + baxtli kayfiyat — aynan spontanlik yuz beradigan payt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui vẻ và tràn năng lượng là lúc sự ngẫu hứng thật sự diễn ra."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amandla aphezulu + ulonwabo lixesha apho izinto zequbuliso zenzeka ngokwenene."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agbára púpọ̀ + ayọ̀ ni àkókò tí ìṣe lójijì máa ń ṣẹlẹ̀ gan-an."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力充沛又開心的時候，正是即興真正會發生的時候。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力充沛又开心的时候，才是真正说走就走的时刻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精神好又開心的時候，最容易說走就走。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amandla amaningi nenjabulo yisikhathi lapho izinto ezingahleliwe zenzeka khona ngempela."
          }
        }
      }
    },
