    "Salt air. Slower mornings. The sound of waves at night." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هواء مالح. صباحات أبطأ. صوت الأمواج في الليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaný vzduch. Pomalejší rána. Šumění vln v noci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt havluft. Langsommere morgener. Lyden af bølger om natten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salzige Luft. Ruhigere Morgen. Wellenrauschen in der Nacht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλμυρός αέρας. Πιο αργά πρωινά. Ο ήχος των κυμάτων τη νύχτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aire salado. Mañanas más lentas. El sonido de las olas por la noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suolainen tuuli. Hitaammat aamut. Aaltojen ääni öisin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maalat na hangin. Mas mabagal na umaga. Tunog ng alon sa gabi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'air salé. Des matins plus lents. Le bruit des vagues la nuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אוויר מלוח. בקרים איטיים יותר. קול הגלים בלילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमकीन हवा। धीमी सुबहें। रात में लहरों की आवाज़।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sós levegő. Lassabb reggelek. Hullámok hangja éjszaka."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udara asin. Pagi yang lebih pelan. Suara ombak di malam hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria salmastra. Mattine più lente. Il rumore delle onde di notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "潮の香り。ゆったりした朝。夜に聞こえる波の音。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짭짤한 바닷바람, 느긋한 아침, 밤마다 들리는 파도 소리."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udara masin. Pagi yang lebih tenang. Bunyi ombak pada waktu malam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt luft. Roligere morgener. Lyden av bølger om natten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilte lucht. Rustigere ochtenden. ’s Nachts het geluid van de golven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słone powietrze. Wolniejsze poranki. Szum fal nocą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar salgado. Manhãs mais lentas. O som das ondas à noite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aer sărat. Dimineți mai lente. Sunetul valurilor noaptea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солёный воздух. Неспешные утра. Шум волн по ночам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt havsluft. Lugnare morgnar. Ljudet av vågor om natten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลมทะเลกลิ่นเค็ม เช้าที่ช้าลง และเสียงคลื่นยามค่ำคืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuzlu hava. Daha yavaş sabahlar. Gece dalgaların sesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солоне повітря. Повільніші ранки. Шум хвиль уночі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gió biển mặn mòi. Những buổi sáng chậm hơn. Tiếng sóng về đêm."
          }
        },
