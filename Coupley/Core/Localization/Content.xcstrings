            "value" : "Diepgang boven toerisme. Je wilt een plek begrijpen, niet alleen fotograferen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębia ponad turystykę. Chcesz zrozumieć miejsce, a nie tylko je sfotografować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
