        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas yang menyibukkan tangan membuka obrolan yang tenang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere le mani occupate apre a conversazioni tranquille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手を動かしていると、静かな会話が自然と生まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손이 바쁘면 조용한 대화가 자연스럽게 시작돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
