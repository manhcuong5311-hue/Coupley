          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ અકળાયેલું હોય ત્યારે ઉકેલ કરતાં સમજાઈ જવું વધુ મહત્વનું છે."
