        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዋላ ሓንቲ ዘይሓትት ነገር ብሓባር ግበሩ — ምግቢ ምድላው፣ ክዳውንቲ ምዕጻፍ፣ ምስኣል።"
