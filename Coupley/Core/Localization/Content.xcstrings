        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperientzietan eskuzabala — dirua bizitzeko da"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دست‌ودل‌باز برای تجربه‌ها — پول برای زندگی است"
