        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dídára ju púpọ̀ lọ. Ìrìn-àjò àrà ọ̀tọ̀ kan lọ́dún sàn ju mẹ́rin tí kò fi bẹ́ẹ̀ dára lọ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重質不重量。一年一趟精彩的旅行，勝過四趟普普通通的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重质不重量。一年一次精彩的旅行，胜过四次平平无奇的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
