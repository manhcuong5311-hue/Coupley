        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përpjekje periodike në vend të mirëmbajtjes së përditshme. Për sa kohë pritshmëritë janë të njëjta, kjo funksionon mirë."
