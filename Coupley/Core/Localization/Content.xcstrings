        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手上有事做的時候，反而更容易安靜地聊開。"
          }
        }
      }
    },
    "Hard no — it's a textures thing" : {
      "extractionState" : "manual",
      "localizations" : {
