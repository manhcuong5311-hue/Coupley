        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το συγκεκριμένο νικάει το γενικό. Ένα σκέτο «τα σπας» πέφτει στο κενό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
