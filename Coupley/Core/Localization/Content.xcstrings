    "Family dynamics shape expectations in relationships — more than most people realise." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesinsdinamika vorm verwagtinge in verhoudings – meer as wat die meeste mense besef."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የቤተሰብ ሁኔታ በግንኙነት ውስጥ ያሉ ጥበቃዎችን ይቀርጻል — ብዙ ሰዎች ከሚገነዘቡት በላይ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ديناميكيات العائلة تشكّل التوقعات في العلاقات أكثر مما يدرك معظم الناس."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিয়ালৰ পৰিৱেশে সম্পৰ্কৰ প্ৰত্যাশা গঢ় দিয়ে — বেছিভাগ মানুহে ভবাতকৈও বেছি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ailə münasibətləri münasibətdəki gözləntiləri formalaşdırır — çoxlarının düşündüyündən də çox."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сямейныя адносіны фарміруюць чаканні ў пары — больш, чым думае большасць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семейната динамика оформя очакванията във връзката – повече, отколкото повечето хора осъзнават."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবারের ধরন সম্পর্কের প্রত্যাশা গড়ে দেয় — বেশিরভাগ মানুষ যতটা ভাবে, তার চেয়েও বেশি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porodična dinamika oblikuje očekivanja u vezi – više nego što većina ljudi shvata."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dinàmica familiar marca les expectatives en una relació — més del que la majoria de gent creu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodinné vztahy formují očekávání ve vztahu – víc, než si většina lidí uvědomuje."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae deinameg teulu'n siapio disgwyliadau mewn perthynas — yn fwy nag mae'r rhan fwyaf o bobl yn sylweddoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiedynamikker former forventningerne i et forhold – mere end de fleste tror."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie prägt Erwartungen an eine Beziehung – mehr, als den meisten bewusst ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οικογενειακές σχέσεις διαμορφώνουν τις προσδοκίες μας στη σχέση — περισσότερο απ' όσο νομίζουν οι περισσότεροι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dinámica familiar moldea lo que esperamos de una relación — más de lo que la mayoría cree."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peresuhted kujundavad ootusi suhtes — rohkem, kui enamik inimesi arvab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiako dinamikek harremanetako itxaropenak moldatzen dituzte — jende gehienak uste baino gehiago."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پویایی خانواده انتظارها در رابطه را شکل می‌دهد — بیشتر از آنچه اغلب آدم‌ها فکر می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhesuhteet muovaavat odotuksia parisuhteessa – enemmän kuin useimmat tajuavat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinuhubog ng dynamics ng pamilya ang mga inaasahan sa relasyon — higit pa sa akala ng karamihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dynamique familiale façonne nos attentes en couple, bien plus qu'on ne le pense."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Múnlaíonn dinimic an teaghlaigh ionchais i gcaidrimh — níos mó ná mar a thuigeann formhór na ndaoine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dinámicas familiares moldean as expectativas nas relacións, máis do que a maioría da xente pensa."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પરિવારના સંબંધો સંબંધમાંની અપેક્ષાઓને ઘડે છે — મોટા ભાગના લોકો ધારે એના કરતાં વધુ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanayin iyali na tsara abin da ake tsammani a dangantaka — fiye da yadda yawancin mutane ke zato."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדינמיקה המשפחתית מעצבת ציפיות בזוגיות — יותר ממה שרוב האנשים חושבים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार का माहौल रिश्ते की उम्मीदें तय करता है — ज़्यादातर लोगों की सोच से कहीं ज़्यादा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiteljska dinamika oblikuje očekivanja u vezi – više nego što većina ljudi shvaća."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jan fanmi an fonksyone fòme sa nou atann nan relasyon — plis pase sa pifò moun panse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A családi minták jobban alakítják a kapcsolati elvárásokat, mint azt a legtöbben gondolnák."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտանեկան դինամիկան ձևավորում է հարաբերությունների վերաբերյալ սպասումները — ավելի շատ, քան մարդկանց մեծ մասը կարծում է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamika keluarga membentuk harapan dalam hubungan — lebih dari yang disadari kebanyakan orang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọnọdụ ezinụlọ na-akpụzi ihe a na-atụ anya na mmekọrịta — karịa ka ọtụtụ mmadụ na-aghọta."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjölskyldumynstur móta væntingar í samböndum – meira en flestir gera sér grein fyrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dinamiche familiari modellano le aspettative nella coppia — più di quanto si pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族関係は、恋愛で何を期待するかにも影響します。思っている以上に。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahanan kulawarga mbentuk pangarep-arep ing sesambungan — luwih saka sing disadari akeh wong."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ოჯახური დინამიკა ურთიერთობაში მოლოდინებს აყალიბებს — უფრო მეტად, ვიდრე ადამიანების უმეტესობას ჰგონია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отбасылық қатынастар қарым-қатынастағы күтулерді қалыптастырады — көп адам ойлағаннан да көбірек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទំនាក់ទំនងក្នុងគ្រួសារ កំណត់ការរំពឹងទុកក្នុងស្នេហា — ច្រើនជាងមនុស្សភាគច្រើនគិត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕುಟುಂಬದ ಸ್ವರೂಪ ಸಂಬಂಧದ ನಿರೀಕ್ಷೆಗಳನ್ನು ರೂಪಿಸುತ್ತದೆ — ಹೆಚ್ಚಿನವರು ಅಂದುಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಹೆಚ್ಚು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 안에서 겪은 관계는 생각보다 훨씬 많이 연애에 대한 기대를 좌우해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dînamîkên malbatê hêviyan di têkiliyan de şekil didin — ji ya ku piraniya mirovan fêm dikin bêtir."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үй-бүлөдөгү мамилелер мамиледеги күтүүлөрдү түзөт — көпчүлүк ойлогондон да көбүрөөк."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familljendynamike prägen d'Erwaardungen an enger Bezéiung — méi, wéi déi meescht Leit mengen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄອບຄົວກຳນົດຄວາມຄາດຫວັງໃນຄວາມສຳພັນ — ຫຼາຍກວ່າທີ່ຄົນສ່ວນໃຫຍ່ຄິດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šeimos santykiai formuoja lūkesčius santykiuose – labiau, nei dauguma supranta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ģimenes dinamika veido gaidas attiecībās – vairāk, nekā lielākā daļa cilvēku apzinās."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fifandraisana ao amin'ny fianakaviana no mamolavola ny andrasana ao amin'ny fifandraisana — mihoatra noho izay heverin'ny ankamaroan'ny olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka hanga e ngā āhuatanga o te whānau ngā tūmanako i roto i ngā hononga — nui ake i tā te nuinga e mōhio ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семејната динамика ги обликува очекувањата во врската — повеќе отколку што мислат повеќето луѓе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മിക്കവരും തിരിച്ചറിയുന്നതിനെക്കാൾ കൂടുതൽ, കുടുംബത്തിലെ രീതികൾ ബന്ധങ്ങളിലെ പ്രതീക്ഷകളെ രൂപപ്പെടുത്തുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэр бүлийн харилцаа харилцаан дахь хүлээлтийг ихэнх хүний боддогоос ч илүү тодорхойлдог."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुटुंबातील नातेसंबंध नात्याकडून असलेल्या अपेक्षा घडवतात — बहुतेकांना वाटते त्यापेक्षा जास्त."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik keluarga membentuk jangkaan dalam hubungan — lebih daripada yang disedari kebanyakan orang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-dinamika tal-familja tifforma l-aspettattivi fir-relazzjonijiet — aktar milli ħafna nies jirrealizzaw."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မိသားစု ဆက်ဆံရေးက ချစ်သူ ဆက်ဆံရေးထဲက မျှော်လင့်ချက်တွေကို ပုံဖော်တယ် — လူအများ ထင်ထားတာထက် ပိုပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien former forventningene vi har i et forhold – mer enn de fleste tror."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवारको माहोलले सम्बन्धका अपेक्षालाई आकार दिन्छ — धेरैले सोचेभन्दा बढी।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familieverhoudingen bepalen je verwachtingen in een relatie – meer dan de meeste mensen beseffen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmene mabanja amakhalira zimapanga zoyembekezera m'maubale — kuposa mmene anthu ambiri amazindikira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalli maatii eegumsa hariiroo keessaa bocha — namoonni baay'een akka hubatan caalaa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିବାରର ଢଙ୍ଗ ସମ୍ପର୍କରେ ଆଶାକୁ ଗଢ଼େ — ଅଧିକାଂଶ ଲୋକ ଯାହା ଭାବନ୍ତି ତାହାଠୁ ଅଧିକ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਰਿਵਾਰ ਦਾ ਮਾਹੌਲ ਰਿਸ਼ਤਿਆਂ ਵਿੱਚ ਉਮੀਦਾਂ ਨੂੰ ਘੜਦਾ ਹੈ — ਜ਼ਿਆਦਾਤਰ ਲੋਕਾਂ ਦੀ ਸੋਚ ਨਾਲੋਂ ਵੀ ਵੱਧ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamika rodzinna kształtuje oczekiwania w związku – bardziej, niż większość ludzi sądzi."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د کورنۍ اړیکې په اړیکو کې تمې جوړوي — تر هغه ډېر چې ډېری خلک فکر کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dinâmica familiar molda as expectativas numa relação — mais do que a maioria imagina."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dinâmicas familiares moldam as expectativas nas relações — mais do que a maioria das pessoas imagina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamica familiei modelează așteptările dintr-o relație — mai mult decât își dau seama cei mai mulți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семейные отношения формируют ожидания в паре — сильнее, чем думает большинство."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imibanire yo mu muryango igena ibyo umuntu yitega mu mubano — kurusha uko abantu benshi babibona."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පවුලේ ගතිකත්වය සබඳතාවක බලාපොරොත්තු හැඩගස්වනවා — බොහෝ දෙනා හිතනවාට වඩා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodinné vzorce formujú očakávania vo vzťahoch – viac, než si väčšina ľudí uvedomuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Družinska dinamika oblikuje pričakovanja v odnosih – bolj, kot se večina zaveda."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maitiro emhuri anotara zvinotarisirwa muukama — kupfuura zvinofungwa nevanhu vazhinji."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xaaladaha qoysku waxay qaabeeyaan filashooyinka xiriirka — in ka badan inta dadka badankood ogyihiin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamikat familjare formësojnë pritshmëritë në marrëdhënie – më shumë nga ç’e kuptojnë shumica e njerëzve."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Породична динамика обликује очекивања у вези — више него што већина људи мисли."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamika kulawarga ngawangun harepan dina hubungan — langkung ti anu disadarkeun ku kalolobaan jalma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjedynamik formar förväntningarna i en relation – mer än de flesta tror."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hali ya familia hujenga matarajio katika mahusiano — zaidi ya watu wengi wanavyotambua."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "குடும்பச் சூழல்தான் உறவில் எதிர்பார்ப்புகளை வடிவமைக்கிறது — பெரும்பாலானோர் உணர்வதை விட அதிகமாக."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కుటుంబ పరిస్థితులు బంధంలోని అంచనాలను తీర్చిదిద్దుతాయి — చాలా మంది అనుకునే దానికంటే ఎక్కువగా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муносибатҳои оилавӣ интизориҳоро дар муносибат шакл медиҳанд — бештар аз он ки аксари одамон тасаввур мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสัมพันธ์ในครอบครัวหล่อหลอมความคาดหวังในความรัก มากกว่าที่คนส่วนใหญ่คิด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ናይ ስድራ ኩነታት ኣብ ርክብ ትጽቢታት ይቐርጽ — መብዛሕትኦም ሰባት ካብ ዝግምትዎ ንላዕሊ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maşgala gatnaşyklary gatnaşykdaky garaşyşlary kemala getirýär — köp adamyň pikir edişinden hem köp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aile dinamikleri ilişkideki beklentileri çoğu insanın sandığından daha fazla şekillendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сімейні стосунки формують очікування в парі — більше, ніж здається більшості людей."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاندانی تعلقات رشتوں میں توقعات کو شکل دیتے ہیں — زیادہ تر لوگوں کے اندازے سے کہیں زیادہ۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oilaviy munosabatlar juftlikdagi kutilmalarni shakllantiradi — koʻpchilik oʻylagandan ham koʻproq."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách gia đình vận hành định hình kỳ vọng trong tình yêu — nhiều hơn hầu hết mọi người nghĩ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imeko yosapho imisela ulindelo kubudlelwane — ngaphezu koko abantu abaninzi bakuqondayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìṣesí ẹbí ń ṣe àpẹẹrẹ ìrètí nínú ìbáṣepọ̀ — ju bí ọ̀pọ̀ ènìyàn ṣe mọ̀ lọ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭關係會塑造你對感情的期望，比大部分人以為的更多。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭关系会塑造一个人对感情的期待，影响远比大多数人以为的要大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭相處模式會影響你對感情的期待，影響程度比多數人以為的還大。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isimo somndeni sakha okulindelekile ebudlelwaneni — ngaphezu kwalokho abantu abaningi abakubonayo."
          }
        }
      }
    },
    "Family is central to your life. A partner will need to understand and respect that — and probably show up for family things regularly." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie is sentraal in jou lewe. ’n Maat sal dit moet verstaan en respekteer – en waarskynlik gereeld by familiedinge opdaag."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቤተሰብ የሕይወትዎ ማዕከል ነው። አጋርዎ ይህን መረዳትና ማክበር ያስፈልጋቸዋል — በቤተሰብ ዝግጅቶችም በየጊዜው መገኘት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العائلة في قلب حياتك. سيحتاج الشريك إلى فهم ذلك واحترامه، وربما الحضور في المناسبات العائلية بانتظام."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিয়াল আপোনাৰ জীৱনৰ কেন্দ্ৰবিন্দু। সংগীয়ে এইটো বুজিব আৰু সন্মান কৰিব লাগিব — আৰু সম্ভৱতঃ পৰিয়ালৰ অনুষ্ঠানবোৰত নিয়মীয়াকৈ উপস্থিত থাকিব লাগিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ailə həyatının mərkəzindədir. Partnyorun bunu anlamalı və hörmət etməlidir — yəqin ki, ailə tədbirlərində də müntəzəm iştirak etməlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сям’я — цэнтр твайго жыцця. Палавінцы трэба будзе гэта зразумець і паважаць — і, напэўна, рэгулярна бываць на сямейных падзеях."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семейството е в центъра на живота ти. Половинката ти ще трябва да разбира и уважава това – и вероятно редовно да присъства на семейни събирания."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবার তোমার জীবনের কেন্দ্রে। পার্টনারকে এটা বুঝতে আর সম্মান করতে হবে — আর হয়তো নিয়মিত পারিবারিক অনুষ্ঠানে আসতেও হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porodica je središte tvog života. Voljena osoba će to morati razumjeti i poštovati – i vjerovatno redovno dolaziti na porodična okupljanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La família és central a la teva vida. La teva parella haurà d'entendre-ho i respectar-ho — i probablement ser-hi sovint en els moments familiars."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodina je středem tvého života. Protějšek to bude muset chápat a respektovat – a nejspíš se pravidelně ukazovat na rodinných akcích."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae teulu'n ganolog i dy fywyd. Bydd angen i bartner ddeall a pharchu hynny — ac mae'n debyg bod yno ar gyfer achlysuron teuluol yn rheolaidd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien er central i dit liv. En partner skal forstå og respektere det – og nok dukke op til familiearrangementer jævnligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie steht im Mittelpunkt deines Lebens. Dein Schatz muss das verstehen und respektieren – und wird wohl regelmäßig bei Familienanlässen dabei sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η οικογένεια είναι στο κέντρο της ζωής σου. Το ταίρι σου θα πρέπει να το καταλαβαίνει και να το σέβεται — και μάλλον να δίνει συχνά το παρών στα οικογενειακά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La familia es el centro de tu vida. Tu pareja tendrá que entenderlo y respetarlo — y seguramente acompañarte a planes familiares con frecuencia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pere on sinu elu keskmes. Partner peab seda mõistma ja austama — ja ilmselt pereüritustel regulaarselt kohal olema."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familia zure bizitzaren erdigunea da. Bikotekide batek hori ulertu eta errespetatu beharko du — eta ziur asko familiako ekitaldietan maiz agertu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خانواده در مرکز زندگی توست. پارتنرت باید این را بفهمد و به آن احترام بگذارد — و احتمالاً مرتب در برنامه‌های خانوادگی حاضر باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhe on elämäsi keskiössä. Kumppanin täytyy ymmärtää ja kunnioittaa sitä – ja luultavasti osallistua perhejuttuihin säännöllisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentro ng buhay mo ang pamilya. Kailangang maintindihan at irespeto ito ng partner mo — at malamang madalas siyang dumalo sa mga family event."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La famille est au cœur de ta vie. L'autre devra le comprendre et le respecter, et sûrement répondre présent aux moments en famille."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá an teaghlach lárnach i do shaol. Beidh ar pháirtí é sin a thuiscint agus a urramú — agus is dócha a bheith i láthair go rialta ag ócáidí teaghlaigh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A familia é central na túa vida. A túa parella terá que entendelo e respectalo, e seguramente estar presente nos asuntos familiares con regularidade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પરિવાર તમારા જીવનનું કેન્દ્ર છે. પાર્ટનરે એ સમજવું અને માન આપવું પડશે — અને કદાચ પરિવારના પ્રસંગોમાં નિયમિત હાજરી આપવી પડશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iyali ne cibiyar rayuwarku. Abokin zama zai buƙaci ya fahimta ya girmama hakan — kuma wataƙila ya riƙa halartar al'amuran iyali akai-akai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשפחה במרכז החיים שלך. מי שאיתך יצטרך להבין ולכבד את זה — וכנראה גם להגיע לאירועים משפחתיים באופן קבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार आपकी ज़िंदगी का केंद्र है। पार्टनर को इसे समझना और इसका सम्मान करना होगा — और शायद पारिवारिक मौक़ों पर अक्सर साथ आना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obitelj ti je središte života. Voljena osoba to treba razumjeti i poštovati – i vjerojatno redovito dolaziti na obiteljska okupljanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanmi se kè lavi ou. Yon patnè ap bezwen konprann e respekte sa — e pwobableman patisipe nan aktivite fanmi souvan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A család az életed középpontja. A párodnak ezt meg kell értenie és tisztelnie kell – és valószínűleg rendszeresen ott kell lennie a családi eseményeken."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտանիքը քո կյանքի կենտրոնում է։ Զուգընկերդ պետք է հասկանա ու հարգի դա — և հավանաբար պարբերաբար մասնակցի ընտանեկան հավաքույթներին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarga adalah pusat hidupmu. Pasanganmu perlu memahami dan menghormatinya — dan mungkin sering ikut hadir di acara keluarga."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezinụlọ bụ isi ihe ná ndụ gị. Onye gị ga-achọ ịghọta ma kwanyere nke ahụ ugwu — ma eleghị anya na-abịakarị ihe ezinụlọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjölskyldan er miðlæg í lífi þínu. Maki þarf að skilja það og virða – og líklega mæta reglulega á fjölskylduviðburði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La famiglia è al centro della tua vita. Il tuo partner dovrà capirlo e rispettarlo — e probabilmente esserci spesso agli eventi di famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族が生活の中心にある人です。パートナーにはそれを理解して尊重してもらう必要があり、パートナーも家族の集まりによく顔を出すことになりそうです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulawarga iku pusering urip panjenengan. Pasangan perlu ngerti lan ngajeni kuwi — lan mbokmenawa ajeg teka ing acara kulawarga."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ოჯახი შენი ცხოვრების ცენტრშია. პარტნიორს ეს უნდა ესმოდეს და პატივს სცემდეს — და, ალბათ, ოჯახურ შეკრებებზე რეგულარულად გამოჩნდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отбасы — өміріңнің орталығы. Серігің мұны түсініп, құрметтеуі керек — әрі отбасылық жиындарға жиі қатысуы керек болар."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្រួសារជាចំណុចកណ្ដាលនៃជីវិតអ្នក។ ដៃគូត្រូវយល់ និងគោរពរឿងនោះ — ហើយប្រហែលជាត្រូវចូលរួមកម្មវិធីគ្រួសារជាប្រចាំ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕುಟುಂಬ ನಿಮ್ಮ ಬದುಕಿನ ಕೇಂದ್ರ. ಸಂಗಾತಿ ಅದನ್ನು ಅರ್ಥಮಾಡಿಕೊಂಡು ಗೌರವಿಸಬೇಕು — ಮತ್ತು ಕುಟುಂಬದ ಕಾರ್ಯಕ್ರಮಗಳಿಗೆ ನಿಯಮಿತವಾಗಿ ಬರಬೇಕಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족이 삶의 중심이에요. 연인이 그걸 이해하고 존중해야 하고, 가족 행사에도 자주 함께해야 할 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malbat di navenda jiyana te de ye. Divê hevjînê te vê fêm bike û rêz bigire — û belkî bi rêkûpêk beşdarî bûyerên malbatê bibe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үй-бүлө — жашооңдун борбору. Сүйгөнүң муну түшүнүп, сыйлашы керек — жана үй-бүлөлүк иштерге дайыма катышышы мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Famill steet bei dir am Mëttelpunkt. Däi Schatz muss dat verstoen a respektéieren — a wuel och reegelméisseg bei Familljesaache mat derbäi sinn."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄອບຄົວຄືສູນກາງຊີວິດຂອງເຈົ້າ ຄູ່ຈະຕ້ອງເຂົ້າໃຈ ແລະ ເຄົາລົບສິ່ງນັ້ນ — ແລະ ຄົງຕ້ອງໄປງານຄອບຄົວເປັນປະຈຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šeima – tavo gyvenimo centras. Antroji pusė turės tai suprasti ir gerbti – ir tikriausiai reguliariai dalyvauti šeimos susibūrimuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ģimene ir tavas dzīves centrā. Otrajai pusei tas būs jāsaprot un jāciena – un droši vien regulāri jāpiedalās ģimenes pasākumos."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ivon'ny fiainanao ny fianakaviana. Mila mahatakatra sy manaja izany ny olon-tiana — ary azo inoana fa manatrika ireo raharaham-pianakaviana matetika."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te whānau te pūtake o tō ora. Me mārama, me whakaute tētahi hoa aroha i tēnā — ā, tērā pea me tae auau mai ki ngā mahi a te whānau."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семејството е централно во твојот живот. Половинката ќе треба да го разбере и почитува тоа — и веројатно редовно да доаѓа на семејни настани."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കുടുംബമാണ് നിങ്ങളുടെ ജീവിതത്തിന്റെ കേന്ദ്രം. പങ്കാളി അത് മനസ്സിലാക്കുകയും മാനിക്കുകയും വേണം — കുടുംബകാര്യങ്ങൾക്ക് പതിവായി എത്തുകയും വേണ്ടിവരും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэр бүл бол чиний амьдралын төв. Хань чинь үүнийг ойлгож, хүндэлж — магадгүй гэр бүлийн арга хэмжээнд тогтмол оролцох хэрэгтэй болно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुटुंब तुमच्या आयुष्याचा केंद्रबिंदू आहे. जोडीदाराला हे समजून घ्यावे लागेल आणि त्याचा आदर करावा लागेल — आणि बहुधा कौटुंबिक कार्यक्रमांना नियमित हजेरीही लावावी लागेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarga ialah teras hidup anda. Pasangan perlu memahami dan menghormatinya — dan mungkin kerap hadir dalam acara keluarga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-familja hija ċentrali f'ħajtek. Partner ikollu bżonn jifhem u jirrispetta dan — u probabbli jattendi regolarment għall-okkażjonijiet tal-familja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မိသားစုက သင့်ဘဝရဲ့ ဗဟိုပါ။ ချစ်သူက ဒါကို နားလည်လေးစားဖို့ လိုမယ် — မိသားစုကိစ္စတွေမှာလည်း ပုံမှန် ပါဝင်ပေးဖို့ လိုမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien står sentralt i livet ditt. En partner må forstå og respektere det – og sikkert stille opp på familieting jevnlig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार तपाईंको जीवनको केन्द्र हो। पार्टनरले यो बुझ्नु र सम्मान गर्नुपर्छ — र पारिवारिक कार्यक्रममा नियमित सहभागी पनि हुनुपर्ला।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie staat centraal in je leven. Je partner moet dat begrijpen en respecteren – en waarschijnlijk geregeld meegaan naar familiedingen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banja lili pakatikati pa moyo wanu. Wokondedwa adzafunika kumvetsa ndi kulemekeza izi — ndipo mwina kupezeka pa zochitika za banja nthawi zonse."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maatiin jireenya kee keessatti ijoo dha. Jaalalleen kee kana hubachuu fi kabajuun barbaachisaa dha — dhimmoota maatii irrattis yeroo yeroon argamuun."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିବାର ଆପଣଙ୍କ ଜୀବନର କେନ୍ଦ୍ର। ସାଥୀଙ୍କୁ ଏହା ବୁଝିବା ଓ ସମ୍ମାନ କରିବା ଦରକାର — ଆଉ ବୋଧହୁଏ ନିୟମିତ ପାରିବାରିକ କାମରେ ସାମିଲ ହେବା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਰਿਵਾਰ ਤੁਹਾਡੀ ਜ਼ਿੰਦਗੀ ਦਾ ਕੇਂਦਰ ਹੈ। ਪਾਰਟਨਰ ਨੂੰ ਇਸ ਨੂੰ ਸਮਝਣਾ ਅਤੇ ਇਸ ਦੀ ਕਦਰ ਕਰਨੀ ਪਵੇਗੀ — ਅਤੇ ਸ਼ਾਇਦ ਪਰਿਵਾਰਕ ਮੌਕਿਆਂ ਉੱਤੇ ਅਕਸਰ ਹਾਜ਼ਰ ਹੋਣਾ ਪਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodzina jest w centrum twojego życia. Druga połówka będzie musiała to rozumieć i szanować – i pewnie regularnie pojawiać się na rodzinnych spotkaniach."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کورنۍ ستاسو د ژوند مرکز ده. ملګری به مو اړتیا ولري چې دا درک کړي او درناوی یې وکړي — او ښايي په منظمه توګه د کورنۍ په کارونو کې ګډون وکړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A família é central na sua vida. Seu amor vai precisar entender e respeitar isso — e provavelmente marcar presença nos eventos de família."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A família é central na tua vida. O teu par vai precisar de compreender e respeitar isso — e provavelmente marcar presença nas coisas de família com regularidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familia e în centrul vieții tale. Un partener va trebui să înțeleagă și să respecte asta — și probabil să fie des prezent la evenimentele de familie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья — центр твоей жизни. Партнёру нужно это понимать и уважать — и, скорее всего, регулярно бывать на семейных встречах."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuryango ni ishingiro ry'ubuzima bwawe. Umukunzi wawe azakenera kubyumva no kubyubaha — kandi birashoboka ko azitabira ibikorwa by'umuryango kenshi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පවුල ඔබේ ජීවිතයේ කේන්ද්‍රයයි. සහකරුවෙක් ඒක තේරුම් අරගෙන ගරු කරන්න ඕනේ — පවුලේ දේවල්වලට නිතර සහභාගී වෙන්නත් ඕනේ වෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodina je stredobodom tvojho života. Polovička to bude musieť chápať a rešpektovať – a asi aj pravidelne chodiť na rodinné akcie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Družina je središče tvojega življenja. Partner bo moral to razumeti in spoštovati – in verjetno redno prihajati na družinska srečanja."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mhuri iri pakati peupenyu hwako. Mudiwa achada kunzwisisa nekuremekedza izvozvo — uye pamwe kuvapo pazviitiko zvemhuri nguva dzose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoysku waa udub-dhexaadka noloshaada. Lammaane wuxuu u baahan doonaa inuu fahmo oo ixtiraamo taas — oo laga yaabee inuu si joogto ah uga qayb galo arrimaha qoyska."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familja është në qendër të jetës tënde. Partneri yt do të duhet ta kuptojë dhe ta respektojë këtë – dhe ndoshta të jetë rregullisht i pranishëm në ngjarjet familjare."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Породица је у средишту твог живота. Твоја половина треба то да разуме и поштује — и вероватно редовно долази на породична окупљања."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulawarga téh puseur kahirupan anjeun. Pasangan kedah ngartos sareng ngahargaan éta — sareng sigana sering ngiring dina acara kulawarga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjen är central i ditt liv. En partner behöver förstå och respektera det – och nog ställa upp på familjegrejer ganska ofta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familia ni kiini cha maisha yako. Mwenzi atahitaji kuelewa na kuheshimu hilo — na huenda kuhudhuria mambo ya familia mara kwa mara."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "குடும்பம் உங்கள் வாழ்க்கையின் மையம். துணை அதைப் புரிந்து மதிக்க வேண்டும் — குடும்ப நிகழ்வுகளுக்கும் தொடர்ந்து வர வேண்டியிருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కుటుంబమే మీ జీవితానికి కేంద్రం. భాగస్వామి దాన్ని అర్థం చేసుకుని గౌరవించాలి — బహుశా కుటుంబ కార్యక్రమాలకు తరచూ హాజరు కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оила дар маркази зиндагии туст. Ёрат бояд инро фаҳмаду эҳтиром кунад — ва эҳтимол мунтазам дар чорабиниҳои оилавӣ ширкат варзад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครอบครัวคือศูนย์กลางชีวิตคุณ คนรักต้องเข้าใจและเคารพเรื่องนี้ และน่าจะต้องไปร่วมงานครอบครัวเป็นประจำ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስድራ ማእከል ህይወትኩም እዩ። መጻምዲ ነዚ ክርድኦን ከኽብሮን የድልዮ — ኣብ ናይ ስድራ ኣጋጣሚታት ድማ ብስሩዕ ክርከብ ይኸውን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maşgala seniň durmuşyňyň merkezi. Söýgüliň muňa düşünmeli we hormat goýmaly — belki maşgala çärelerine hem yzygiderli gatnaşmaly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aile hayatının merkezinde. Partnerinin bunu anlaması, saygı duyması ve muhtemelen aile buluşmalarına düzenli olarak katılması gerekecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Родина — центр твого життя. Половинці треба це розуміти й поважати — і, мабуть, регулярно бувати на сімейних зустрічах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاندان آپ کی زندگی کا مرکز ہے۔ ساتھی کو یہ سمجھنا اور اس کا احترام کرنا ہوگا — اور شاید خاندانی موقعوں پر باقاعدگی سے شامل ہونا بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oila — hayotingiz markazi. Sherigingiz buni tushunishi va hurmat qilishi kerak — va, ehtimol, oilaviy tadbirlarda muntazam qatnashishi ham."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia đình là trung tâm cuộc sống của bạn. Người ấy cần hiểu và tôn trọng điều đó — và chắc sẽ thường xuyên có mặt trong các dịp gia đình."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usapho luphambili ebomini bakho. Iqabane liya kufuna ukukuqonda nokukuhlonipha oko — kwaye mhlawumbi libekho kwimicimbi yosapho rhoqo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹbí ni àárín gbùngbùn ayé yín. Olólùfẹ́ yín yóò nílò láti lóye àti bọ̀wọ̀ fún èyí — ó sì ṣeé ṣe kí ó máa wá síbi ọ̀rọ̀ ẹbí déédéé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人是你生活的核心。另一半需要理解並尊重這點，大概也要經常出席家庭活動。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人是你生活的中心。另一半需要理解并尊重这一点，可能还得常常参加家庭活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人是你生活的重心。另一半需要理解並尊重這點，大概也要常常一起參加家族活動。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umndeni ungumongo wempilo yakho. Umlingani kuzodingeka akuqonde futhi akuhloniphe lokho — futhi mhlawumbe abe khona ezintweni zomndeni njalo."
          }
        }
      }
    },
