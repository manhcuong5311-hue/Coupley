        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang secara semula jadi. Anda mungkin agak mudah berbincang tentang wang dengan kebanyakan pasangan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-bilanċ jiġik naturali. Probabbli titkellem dwar il-flus b'mod pjuttost faċli ma' ħafna partners."
