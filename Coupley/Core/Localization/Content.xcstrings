    "Being truly seen — not just looked at. Full attention, no distractions, just them focused on you. That's intimacy for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om regtig raakgesien te word – nie net aangekyk nie. Volle aandag, geen afleidings nie, net jou maat wat op jou fokus. Dís vir jou intimiteit."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በጥልቀት መታየት — ዝም ብሎ መታየት ብቻ ሳይሆን። ሙሉ ትኩረት፣ ምንም መዘናጋት የለም፣ አጋርዎ በእርስዎ ላይ ብቻ ያተኮሩበት። ለእርስዎ መቀራረብ ማለት ይህ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تُرَوا حقًا، لا أن يُنظر إليكم فحسب. انتباه كامل بلا مشتتات، وشريكك مركّز عليكم وحدكم. هذه هي الحميمية عندكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঁচাকৈয়ে বুজা পোৱা — কেৱল চোৱা নহয়। সম্পূৰ্ণ মনোযোগ, কোনো বিক্ষেপ নাই, কেৱল সংগী আপোনাৰ ওপৰত মনোনিৱেশ কৰি আছে। আপোনাৰ বাবে সেয়াই ঘনিষ্ঠতা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadəcə baxılmaq yox, həqiqətən görülmək. Tam diqqət, heç bir yayındırıcı yoxdur, yalnız onun sənə yönəlmiş diqqəti. Sənin üçün yaxınlıq budur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі цябе сапраўды бачаць, а не проста глядзяць. Поўная ўвага, ніякіх адцягненняў, толькі ты ў цэнтры. Вось што для цябе блізкасць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да те виждат наистина – а не просто да те гледат. Пълно внимание, без разсейване, само ти в центъра. Това е интимност за теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু তাকানো নয়, সত্যিই দেখা। পুরো মনোযোগ, কোনো বিক্ষেপ নেই, ও শুধু তোমাতেই মন দিয়ে আছে। তোমার কাছে এটাই ঘনিষ্ঠতা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad te neko zaista vidi – a ne samo gleda. Puna pažnja, bez ometanja, samo fokus na tebi. To je za tebe intimnost."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que et vegin de veritat — no només que et mirin. Atenció plena, sense distraccions, només tu al centre. Això és intimitat per a tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když tě někdo opravdu vidí – nejen se dívá. Plná pozornost, nic neruší, jen soustředění na tebe. To je pro tebe intimita."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cael dy weld go iawn — nid dim ond cael rhywun yn edrych arnat ti. Sylw llawn, dim byd yn tynnu sylw, dim ond dy bartner yn canolbwyntio arnat ti. Dyna agosatrwydd i ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At blive set for alvor – ikke bare kigget på. Fuld opmærksomhed, ingen forstyrrelser, kun din partners fokus på dig. Det er intimitet for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirklich gesehen werden – nicht nur angeschaut. Volle Aufmerksamkeit, keine Ablenkung, ganz auf dich gerichtet. Das ist für dich Intimität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να σε βλέπουν πραγματικά — όχι απλώς να σε κοιτάζουν. Πλήρης προσοχή, χωρίς περισπασμούς, μόνο το ταίρι σου εστιασμένο σε σένα. Αυτό είναι για σένα οικειότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir que te ven de verdad, no solo que te miran. Atención plena, sin distracciones, solo tu pareja pendiente de ti. Eso es intimidad para ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olla tõeliselt nähtud — mitte lihtsalt vaadatud. Täielik tähelepanu, ei mingeid segajaid, ainult tema, keskendunud sinule. See on sinu jaoks intiimsus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benetan ikusia izatea — ez begiratua bakarrik. Arreta osoa, distrakziorik gabe, zure bikotekidea zuregan zentratuta. Hori da intimitatea zuretzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقعاً دیده شدن — نه فقط نگاه شدن. توجه کامل، بی‌حواس‌پرتی، فقط او و تمرکزش روی تو. صمیمیت برای تو یعنی همین."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulla todella nähdyksi – ei vain katsotuksi. Täysi huomio, ei häiriöitä, vain toinen keskittyneenä sinuun. Se on sinulle läheisyyttä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang tunay na makita — hindi lang matingnan. Buong atensyon, walang abala, nakatuon lang siya sa’yo. Iyan ang lapit para sa’yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'on te voie vraiment, pas juste qu'on te regarde. Une attention totale, sans distraction, toute tournée vers toi. Voilà l'intimité pour toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go bhfeictear i ndáiríre thú — ní hamháin go mbreathnaítear ort. Aird iomlán, gan aon rud eile ag tarraingt, do pháirtí dírithe ortsa amháin. Sin dlúthchaidreamh duitse."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que te vexan de verdade, non só que te miren. Atención plena, sen distraccións, centrada en ti. Iso é intimidade para ti."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ખરેખર સમજાવું — ફક્ત જોવાવું નહીં. પૂરેપૂરું ધ્યાન, કોઈ ખલેલ નહીં, બસ તેઓ તમારા પર ધ્યાન આપે. તમારા માટે એ જ આત્મીયતા છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganin ku da gaske — ba kallo kawai ba. Cikakkiyar kulawa, babu shagala, hankalin abokin zamanku gaba ɗaya a kanku. Wannan ne kusanci a gare ku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שרואים אותך באמת — לא רק מסתכלים עליך. תשומת לב מלאה, בלי הסחות, והפוקוס כולו עליך. זו אינטימיות בשבילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सच में देखा जाना — बस नज़र डाली जाना नहीं। पूरा ध्यान, कोई भटकाव नहीं, बस पार्टनर का ध्यान आप पर। आपके लिए यही नज़दीकी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad te netko uistinu vidi – a ne samo gleda. Potpuna pažnja, bez ometanja, fokus samo na tebi. To je za tebe intimnost."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santi yo wè ou vre — pa sèlman gade ou. Tout atansyon, san distraksyon, jis li konsantre sou ou. Se sa entimite ye pou ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha igazán látnak – nem csak rád néznek. Teljes figyelem, semmi zavaró tényező, a párod csak rád fókuszál. Neked ez a bensőségesség."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբ քեզ իսկապես տեսնում են — ոչ թե պարզապես նայում։ Լիակատար ուշադրություն, ոչ մի շեղող բան, միայն զուգընկերդ՝ կենտրոնացած քեզ վրա։ Քեզ համար սա է մտերմությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar dilihat — bukan sekadar dipandang. Perhatian penuh, tanpa gangguan, hanya dia yang fokus padamu. Itulah keintiman bagimu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka a hụ gị n'ezie — ọ bụghị naanị ilele gị anya. Uche niile, enweghị ihe ndọpụ uche, naanị ya lekwasịrị gị anya. Nke ahụ bụ mmekọ nye gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að makinn sjái þig í alvöru – ekki bara horfi á þig. Full athygli, engar truflanir, bara makinn með alla athyglina á þér. Það er nánd fyrir þér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentire che qualcuno ti vede davvero — non che ti guarda e basta. Attenzione piena, niente distrazioni, l’altra persona concentrata su di te. Per te questa è intimità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ただ見られるのではなく、本当に見てもらえること。よそ見をせず、自分だけに向けられる関心。それがあなたにとっての親密さです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saestu digatekake — ora mung dideleng. Kawigaten wutuh, ora ana sing ngganggu, mung pasangan sing fokus marang panjenengan. Kuwi rasa cedhak kanggo panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როცა ნამდვილად გხედავენ — და არა უბრალოდ გიყურებენ. სრული ყურადღება, ყურადღების გაფანტვის გარეშე, მხოლოდ შენზე ორიენტირებული. შენთვის ეს სიახლოვეა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жай қаралу емес, шын көрінуің. Толық назар, алаңдатар ештеңе жоқ, серігің тек саған көңіл бөледі. Сен үшін жақындық — осы."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការត្រូវបានគេមើលឃើញពិតៗ — មិនមែនគ្រាន់តែមើលទេ។ ការយកចិត្តទុកដាក់ពេញលេញ គ្មានការរំខាន មានតែគាត់ផ្ដោតលើអ្នក។ នោះហើយជាភាពស្និទ្ធស្នាលសម្រាប់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸುಮ್ಮನೆ ನೋಡುವುದಲ್ಲ — ನಿಜವಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವುದು. ಪೂರ್ಣ ಗಮನ, ಯಾವ ಅಡ್ಡಿಯೂ ಇಲ್ಲ, ಅವರ ಗಮನ ಸಂಪೂರ್ಣ ನಿಮ್ಮ ಮೇಲೆ. ನಿಮಗೆ ಆತ್ಮೀಯತೆ ಎಂದರೆ ಅದೇ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그냥 보는 게 아니라 진짜로 나를 봐 주는 것. 방해 없이 오직 나에게 집중해 주는 것. 그게 나에게는 친밀함이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi rastî hatin dîtin — ne tenê lê nihêrîn. Bala tam, bê tiştên ku balê dikişînin, tenê ew û bala xwe li ser te. Ji bo te nêzîkî ev e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жөн эле каралбай, чын эле көрүлүү. Толук көңүл, алаксуусуз, ал сага гана бурулуп турат. Сен үчүн жакындык ушул."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wierklech gesi ginn — net just ugekuckt. Voll Opmierksamkeet, keng Oflenkung, däi Schatz ganz op dech konzentréiert. Dat ass fir dech Intimitéit."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຖືກເຫັນແທ້ໆ — ບໍ່ແມ່ນແຄ່ຖືກເບິ່ງ ຄວາມໃສ່ໃຈເຕັມທີ່ ບໍ່ມີສິ່ງລົບກວນ ມີແຕ່ຄູ່ທີ່ໃສ່ໃຈເຈົ້າ ນັ້ນຄືຄວາມໃກ້ຊິດສຳລັບເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai tave iš tiesų mato – ne tik žiūri. Visas dėmesys, jokių trukdžių, antroji pusė sutelkta į tave. Tau tai ir yra intymumas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad tevi patiešām redz – ne tikai skatās. Pilna uzmanība, bez traucēkļiem, otrā puse pievērsusies tikai tev. Tā tev ir tuvība."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny ho hita tokoa — fa tsy ho jerena fotsiny. Fifantohana feno, tsy misy manelingelina, izy mifantoka aminao fotsiny. Izany no fifanakaikezana aminao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te tino kitea — kaua e tirohia noa. He aro katoa, kāore he whakararu, ko ia anake e aro mai ana ki a koe. Koinā te tata ki a koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да бидеш навистина видено — не само погледнато. Целосно внимание, без одвлекување, само половинката насочена кон тебе. Тоа е блискост за тебе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വെറുതെ നോക്കപ്പെടുകയല്ല — ശരിക്കും കാണപ്പെടുക. പൂർണ ശ്രദ്ധ, ഒരു ശ്രദ്ധാഭംഗവുമില്ലാതെ, പങ്കാളിയുടെ ശ്രദ്ധ മുഴുവൻ നിങ്ങളിൽ. അതാണ് നിങ്ങൾക്ക് അടുപ്പം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зүгээр харагдах биш — үнэхээр харагдах. Бүрэн анхаарал, юунд ч сатааралгүй, зөвхөн чамд төвлөрсөн хань. Энэ л чамд дотно байдал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त पाहिले जाणे नव्हे — खरोखर समजून घेतले जाणे. पूर्ण लक्ष, कोणताही व्यत्यय नाही, फक्त जोडीदाराचे लक्ष तुमच्यावर. तुमच्यासाठी हीच जवळीक."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar dilihat — bukan sekadar dipandang. Perhatian penuh, tanpa gangguan, hanya dia yang fokus kepada anda. Itulah keintiman bagi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li xi ħadd verament jarak — mhux sempliċiment iħares lejk. Attenzjoni sħiħa, l-ebda distrazzjoni, l-attenzjoni kollha tal-partner tiegħek fuqek biss. Dik hija l-intimità għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကြည့်ရုံ မဟုတ်ဘဲ တကယ် မြင်ပေးခံရတာ။ အာရုံအပြည့်၊ အနှောင့်အယှက်မရှိ၊ သင့်အပေါ်မှာပဲ အာရုံစိုက်ထားတာ။ ဒါက သင့်အတွက် ရင်းနှီးမှုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å bli virkelig sett – ikke bare sett på. Full oppmerksomhet, ingen forstyrrelser, bare fokus på deg. Det er intimitet for deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेरिनु मात्र होइन — साँच्चै देखिनु। पूरा ध्यान, कुनै अवरोध छैन, उहाँ केवल तपाईंमा केन्द्रित। तपाईंका लागि आत्मीयता यही हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echt gezien worden – niet alleen bekeken. Volle aandacht, geen afleiding, je partner helemaal op jou gericht. Dat is voor jou intimiteit."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuonedwa kwenikweni — osati kungoyang'aniridwa. Chidwi chonse, popanda zosokoneza, iwo akungoyang'ana inu. Kwa inu, kumeneko ndiko kuyandikana."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilaalamuu qofa osoo hin taane, dhugumaan argamuu. Xiyyeeffannoo guutuu, jeequmsa malee, si qofa irratti xiyyeeffachuu. Kun siif walitti dhiyeenya dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ ଦେଖାଯିବା ନୁହେଁ — ସତରେ ବୁଝାଯିବା। ପୂରା ଧ୍ୟାନ, କୌଣସି ବିଚଳନ ନାହିଁ, କେବଳ ସେମାନଙ୍କ ଧ୍ୟାନ ଆପଣଙ୍କ ଉପରେ। ଆପଣଙ୍କ ପାଇଁ ଏହା ହିଁ ଆତ୍ମୀୟତା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੱਚਮੁੱਚ ਦੇਖੇ-ਸਮਝੇ ਜਾਣਾ — ਸਿਰਫ਼ ਨਜ਼ਰ ਮਾਰੇ ਜਾਣਾ ਨਹੀਂ। ਪੂਰਾ ਧਿਆਨ, ਕੋਈ ਭਟਕਾਅ ਨਹੀਂ, ਬੱਸ ਉਨ੍ਹਾਂ ਦਾ ਧਿਆਨ ਤੁਹਾਡੇ ਉੱਤੇ। ਤੁਹਾਡੇ ਲਈ ਇਹੀ ਨੇੜਤਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczucie, że ktoś naprawdę cię widzi – a nie tylko na ciebie patrzy. Pełna uwaga, zero rozpraszaczy, druga połówka skupiona tylko na tobie. To dla ciebie intymność."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په رښتیا لیدل کېدل — نه یوازې کتل. بشپړه پاملرنه، بې له ګډوډۍ، یوازې ستاسو ملګری چې پام یې پر تاسو دی. ستاسو لپاره نږدېوالی همدا دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir que enxergam você de verdade, e não só olham para você. Atenção total, sem distrações, seu amor focado só em você. Isso é intimidade para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir que te veem a sério — e não só que olham para ti. Atenção total, sem distrações, toda a atenção do teu par em ti. Para ti, isso é intimidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să simți că cineva te vede cu adevărat — nu doar se uită la tine. Atenție deplină, fără distrageri, doar partenerul tău concentrat pe tine. Asta e intimitatea pentru tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда тебя по-настоящему видят, а не просто смотрят. Полное внимание, никаких отвлечений, только ты в фокусе. Вот что для тебя близость."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubonwa koko — atari ukurebwa gusa. Kwitabwaho byuzuye, nta birangaza, umukunzi wawe akwitayeho wenyine. Ubwo ni bwo bucuti bwimbitse kuri wowe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඇත්තටම දකිනවා — නිකන් බලනවා විතරක් නෙවෙයි. සම්පූර්ණ අවධානය, කිසිම බාධාවක් නැතුව, ඔබේ සහකරුගේ අවධානය ඔබ ගැන විතරක්. ඔබට සමීපත්වය කියන්නේ ඒකයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď ťa niekto naozaj vidí – nielen pozerá. Plná pozornosť, nič, čo by rozptyľovalo, len ty v centre pozornosti. To je pre teba intimita."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te nekdo zares vidi – ne le pogleda. Polna pozornost, brez motenj, pogled samo zate. To je zate intimnost."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunyatsoonekwa — kwete kungotarisirwa. Kutarisa kwakazara, pasina zvinokanganisa, iye akatarisa iwe chete. Ndiko kuswedera kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In si dhab ah laguu arko — ma aha in lagu eego oo keliya. Dareen buuxa, mashquul la'aan, lammaanahaaga oo adiga diiradda ku haya. Taasi adiga waa dhawaansho."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të të shohin vërtet – jo thjesht të të shikojnë. Vëmendje e plotë, pa shpërqendrime, vetëm partneri yt i përqendruar te ti. Kjo është intimitet për ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да те неко заиста види — а не само гледа. Пуна пажња, без ометања, само ти у фокусу. То је за тебе блискост."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leres-leres ditingali — sanés ngan saukur dilirik. Perhatosan pinuh, teu aya gangguan, ngan pasangan anu museur ka anjeun. Éta kadeukeutan pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att bli sedd på riktigt – inte bara tittad på. Full uppmärksamhet, inga distraktioner, bara din partners fokus på dig. Det är intimitet för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuonekana kikweli — si kutazamwa tu. Umakini kamili, bila vikengeushi, mwenzi wako akikulenga wewe tu. Huo ndio ukaribu kwako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வெறுமனே பார்க்கப்படுவது அல்ல — உண்மையாகப் புரிந்துகொள்ளப்படுவது. முழுக் கவனம், எந்தக் கவனச்சிதறலும் இல்லாமல், அவர் உங்கள் மீது மட்டும் கவனம் செலுத்துவது. அதுதான் உங்களுக்கு நெருக்கம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కేవలం చూడటం కాదు — నిజంగా అర్థం చేసుకోవడం. పూర్తి శ్రద్ధ, ఎలాంటి అంతరాయం లేదు, వారి దృష్టి మీపైనే. మీకు సాన్నిహిత్యం అంటే అదే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воқеан дида шудан — на танҳо нигоҳ карда шудан. Диққати пурра, бе парешонӣ, танҳо ёрат ба ту нигаронида. Наздикӣ барои ту ҳамин аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การถูกมองเห็นจริงๆ ไม่ใช่แค่ถูกมอง ความใส่ใจเต็มร้อย ไม่มีสิ่งรบกวน แค่คนรักจดจ่ออยู่กับคุณ นั่นคือความใกล้ชิดสำหรับคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብሓቂ ክርኣዩ — ክጥመቱ ጥራይ ዘይኮነ። ምሉእ ኣቓልቦ፣ ብዘይ ምዝንጋዕ፣ ኣብኡ ዝተኣከበ ኣተኩሮ። ንዓኹም ቅርበት እዚ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diňe seredilmek däl — hakykatdan görülmek. Doly üns, hiç hili päsgelçilik ýok, diňe ol we seniň üstüňe jemlenen ünsi. Seniň üçin ýakynlyk şu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece bakılmak değil, gerçekten görülmek. Tam ilgi, dikkat dağıtan hiçbir şey yok, partnerin yalnızca sana odaklanmış. Senin için yakınlık bu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли тебе справді бачать, а не просто дивляться. Повна увага, жодних відволікань — лише половинка, зосереджена на тобі. Ось що для тебе близькість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقعی دیکھا جانا — صرف نظر ڈالنا نہیں۔ پوری توجہ، کوئی خلل نہیں، بس ان کا دھیان آپ پر۔ آپ کے لیے یہی قربت ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shunchaki qaralish emas — chinakam koʻrilish. Toʻliq eʼtibor, chalgʻishlarsiz, faqat sizga qaratilgan nigoh. Siz uchun yaqinlik — shu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được thật sự nhìn thấy — chứ không chỉ được nhìn. Chú tâm trọn vẹn, không xao nhãng, chỉ có người ấy hướng về bạn. Với bạn, đó là sự thân mật."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubonwa ngokwenene — hayi ukujongwa nje. Ingqalelo epheleleyo, akukho ziphazamiso, iqabane lakho lijolise kuwe. Kuwe, kukusondelelana oko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kí a rí yín lóòótọ́ — kì í ṣe kí a kàn wò yín. Àfiyèsí kíkún, láìsí ìdíwọ́, olólùfẹ́ yín tó gbájú mọ́ yín nìkan. Ìsúnmọ́ra nìyẹn fún yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被真正看見，而不只是被看著。全心專注、沒有分心，對方只專注在你身上。這就是你心中的親密。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被真正看见，而不只是被看着。全心关注、没有干扰，对方的注意力都在你身上。这就是你理解的亲密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真正被看見，而不只是被看著。全心全意、不分心，對方的注意力只在你身上，這就是你心中的親密。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubonwa ngempela — hhayi ukubukwa nje. Ukunakwa ngokugcwele, kungekho ziphazamiso, umlingani wakho egxile kuwe. Lokho kuwukusondelana kuwe."
          }
        }
      }
    },
    "Being truly there — not just physically. You need a partner who can sit with feelings, theirs and yours." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regtig daar wees – nie net fisiek nie. Jy het ’n maat nodig wat by gevoelens kan bly, joune én dié van jou maat."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በእውነት መገኘት — በአካል ብቻ ሳይሆን። የራሳቸውንም የእርስዎንም ስሜቶች ተቀብለው አብረው መቆየት የሚችሉ አጋር ያስፈልግዎታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحضور الحقيقي، لا الجسدي فقط. حاجتك شريك قادر على احتواء المشاعر، مشاعره ومشاعرك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঁচাকৈয়ে কাষত থকা — কেৱল শাৰীৰিকভাৱে নহয়। আপোনাক এনে সংগী লাগে যিয়ে অনুভৱবোৰৰ লগত থাকিব পাৰে, নিজৰো আৰু আপোনাৰো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həqiqətən yanında olmaq — təkcə fiziki yox. Hisslərlə — həm öz hissləri, həm də səninkilərlə — baş-başa qala bilən partnyora ehtiyacın var."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быць па-сапраўднаму побач — не толькі фізічна. Табе патрэбна палавінка, якая ўмее пабыць з пачуццямі — і сваімі, і тваімі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да си наистина там – не само физически. Трябва ти половинка, която може да остане с чувствата – своите и твоите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সত্যিই পাশে থাকা — শুধু শরীরে নয়। তোমার দরকার এমন পার্টনার, যে অনুভূতির সাথে থাকতে পারে, নিজের আর তোমার — দুজনেরই।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biti zaista tu – ne samo fizički. Treba ti voljena osoba koja zna podnijeti osjećaje, i svoje i tvoje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser-hi de veritat — no només físicament. Necessites una parella capaç d'acompanyar els sentiments, els seus i els teus."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Být opravdu nablízku – nejen fyzicky. Potřebuješ protějšek, který unese pocity, svoje i tvoje."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bod yno go iawn — nid dim ond yn gorfforol. Mae angen partner arnat ti sy'n gallu aros gyda theimladau, rhai'r ddau ohonoch chi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At være der helt – ikke kun fysisk. Du har brug for en partner, der kan rumme følelser, både sine egne og dine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirklich da sein – nicht nur körperlich. Du brauchst einen Menschen, der Gefühle aushalten kann, die eigenen und deine."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να είναι κανείς πραγματικά εκεί — όχι μόνο σωματικά. Χρειάζεσαι ένα ταίρι που αντέχει να μείνει με τα συναισθήματα, τα δικά του και τα δικά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar de verdad — no solo físicamente. Necesitas una pareja capaz de quedarse con los sentimientos, los suyos y los tuyos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päriselt olemas olemine — mitte ainult füüsiliselt. Sul on vaja partnerit, kes suudab tunnetega olla, nii enda kui ka sinu omadega."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benetan han egotea, ez fisikoki soilik. Sentimenduekin egoten dakien bikotekidea behar duzu, berearekin eta zurearekin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقعاً آنجا بودن — نه فقط با جسم. پارتنری می‌خواهی که بتواند با احساس‌ها بماند، هم احساس‌های خودش و هم تو."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olla oikeasti läsnä – ei vain fyysisesti. Tarvitset kumppanin, joka pystyy kohtaamaan tunteet, niin omansa kuin sinunkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunay na naroon — hindi lang pisikal. Kailangan mo ng partner na kayang damhin ang mga nararamdaman — kanya man o iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être vraiment là — pas seulement physiquement. Tu as besoin de quelqu'un qui sait accueillir les émotions, les siennes et les tiennes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bheith ann i ndáiríre — ní go fisiciúil amháin. Teastaíonn páirtí uait atá in ann fanacht le mothúcháin — mothúcháin na beirte agaibh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar de verdade, non só fisicamente. Necesitas unha parella capaz de acoller os sentimentos, os seus e os teus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાચે જ સાથે હોવું — ફક્ત શરીરથી નહીં. તમને એવા પાર્ટનર જોઈએ જે લાગણીઓ સાથે બેસી શકે, પોતાની અને તમારી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasancewa tare da gaske — ba a jiki kawai ba. Kuna buƙatar abokin zama mai iya zama da ji, na ku biyu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להיות שם באמת — לא רק פיזית. חשוב לך מישהו שיודע להכיל רגשות, שלו ושלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सच में साथ होना — सिर्फ़ शरीर से नहीं। आपको ऐसा पार्टनर चाहिए जो भावनाओं के साथ ठहर सके, अपनी भी और आपकी भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biti stvarno tu – ne samo fizički. Trebaš voljenu osobu koja može podnijeti osjećaje, i svoje i tvoje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La toutbon — pa sèlman fizikman. Ou bezwen yon patnè ki ka rete ak santiman yo, pa li ak pa ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tényleg ott lenni – nem csak fizikailag. Olyan párra van szükséged, aki el tudja viselni az érzéseket, a sajátját és a tiédet is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Իսկապես կողքին լինել, ոչ միայն ֆիզիկապես։ Քեզ պետք է զուգընկեր, ով կարող է մնալ զգացմունքների հետ՝ և՛ իր, և՛ քո։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar hadir — bukan cuma secara fisik. Kamu butuh pasangan yang bisa hadir untuk perasaan, baik perasaannya maupun perasaanmu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịnọ n'ezie — ọ bụghị naanị n'ahụ. Ị chọrọ onye nwere ike ịnọnyere mmetụta obi, nke ya na nke gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að vera í alvöru til staðar – ekki bara líkamlega. Þú þarft maka sem getur verið með tilfinningum, bæði sínum og þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esserci davvero — non solo fisicamente. Hai bisogno di un partner capace di stare con le emozioni, le sue e le tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体だけでなく、心も本当にそこにいること。自分の気持ちにも相手の気持ちにも寄り添えるパートナーが必要です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saestu ana — ora mung awake. Panjenengan butuh pasangan sing bisa nampa rasa, rasane dhewe lan rasa panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნამდვილად გვერდით ყოფნა — არა მხოლოდ ფიზიკურად. გჭირდება პარტნიორი, რომელსაც შეუძლია, გრძნობებს გაუძლოს — როგორც საკუთარს, ისე შენსას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тек тәнімен емес, шынымен қасында болу. Саған өз сезімдерін де, сенің сезімдеріңді де көтере алатын серік керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការនៅក្បែរគ្នាពិតប្រាកដ — មិនមែនត្រឹមតែរាងកាយទេ។ អ្នកត្រូវការដៃគូដែលអាចនៅជាមួយអារម្មណ៍ ទាំងរបស់គាត់ និងរបស់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಜವಾಗಿ ಜೊತೆಗಿರುವುದು — ದೇಹದಿಂದ ಮಾತ್ರವಲ್ಲ. ತಮ್ಮ ಮತ್ತು ನಿಮ್ಮ ಭಾವನೆಗಳ ಜೊತೆ ತಾಳ್ಮೆಯಿಂದ ಇರಬಲ್ಲ ಸಂಗಾತಿ ನಿಮಗೆ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸만이 아니라 마음까지 진짜로 곁에 있는 거예요. 연인의 감정도, 내 감정도 함께 감당해 줄 수 있는 사람이 필요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi rastî li wir bûn — ne tenê bi laş. Tu hewceyî hevjînekî yî ku bikaribe bi hestan re rûne, yên xwe û yên te."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физикалык гана эмес, чындап жанында болуу. Сага өзүнүн да, сенин да сезимдериңди көтөрө алган сүйгөнүң керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wierklech do sinn — net just kierperlech. Du brauchs e Schatz, dee Gefiller aushale kann, déi eegen an deng."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຢູ່ນຳກັນແທ້ໆ — ບໍ່ແມ່ນແຄ່ທາງກາຍ ເຈົ້າຕ້ອງການຄູ່ທີ່ຢູ່ກັບຄວາມຮູ້ສຶກໄດ້ ທັງຂອງລາວ ແລະ ຂອງເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Būti iš tiesų šalia – ne tik fiziškai. Tau reikia antrosios pusės, kuri gali pabūti su jausmais – savo ir tavo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Būt patiesi klāt – ne tikai fiziski. Tev vajag otro pusi, kas spēj pabūt ar jūtām – savām un tavām."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eo tokoa — fa tsy ara-batana fotsiny. Mila olon-tiana afaka miaraka amin'ny fihetseham-po ianao, na ny azy na ny anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kia tino noho mai — kaua ā-tinana noa iho. Me whai hoa aroha koe e taea ana te noho tahi me ngā kare ā-roto, ōna me ōu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да бидеш вистински тука — не само физички. Ти треба половинка што може да остане со чувствата, своите и твоите."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ശരിക്കും കൂടെയുണ്ടാകൽ — ശരീരം കൊണ്ട് മാത്രമല്ല. സ്വന്തം വികാരങ്ങൾക്കും നിങ്ങളുടേതിനുമൊപ്പം ഇരിക്കാൻ കഴിയുന്ന ഒരു പങ്കാളിയെയാണ് നിങ്ങൾക്ക് വേണ്ടത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зөвхөн биеэрээ биш — үнэхээр дэргэд байх. Чамд өөрийнхөө ч, чиний ч мэдрэмжтэй хамт байж чадах хань хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खऱ्या अर्थाने सोबत असणे — फक्त शरीराने नाही. जोडीदाराने भावनांसोबत — स्वतःच्या आणि तुमच्याही — थांबायला हवे, असे तुम्हाला वाटते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benar-benar hadir — bukan sekadar fizikal. Anda perlukan pasangan yang mampu menerima dan melayani perasaan, sama ada perasaannya atau perasaan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li tkun verament hemm — mhux biss fiżikament. Għandek bżonn partner li jista' joqgħod mas-sentimenti taż-żewġ naħat."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ်ခန္ဓာနဲ့တင် မဟုတ်ဘဲ တကယ် အနားမှာ ရှိနေခြင်း။ ချစ်သူ့ခံစားချက်ရော သင့်ခံစားချက်ရောနဲ့ အတူ ထိုင်နေပေးနိုင်တဲ့ ချစ်သူ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å være der på ordentlig – ikke bare fysisk. Du trenger en partner som kan romme følelser, både sine egne og dine."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साँच्चै साथमा हुनु — शारीरिक रूपमा मात्र होइन। तपाईंलाई आफ्नो र तपाईंको, दुवैको भावनासँग बस्न सक्ने पार्टनर चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er echt zijn – niet alleen fysiek. Je hebt een partner nodig die gevoelens kan toelaten, die van jou en die van zichzelf."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukhalapo kwenikweni — osati kwa thupi lokha. Mumafuna wokondedwa amene angakhale ndi malingaliro, ake ndi anu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhugumaan argamuu — qaamaan qofa miti. Hariiroo keessatti miirri — kan kee fi kan jaalallee keetii — obsaan akka dhaga'amu barbaadda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସତରେ ପାଖରେ ରହିବା — କେବଳ ଶାରୀରିକ ଭାବେ ନୁହେଁ। ଆପଣଙ୍କୁ ଏମିତି ସାଥୀ ଦରକାର ଯିଏ ଭାବନା ସହ ରହିପାରିବେ, ନିଜର ବି ଓ ଆପଣଙ୍କର ବି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੱਚਮੁੱਚ ਨਾਲ ਹੋਣਾ — ਸਿਰਫ਼ ਸਰੀਰਕ ਤੌਰ ਉੱਤੇ ਨਹੀਂ। ਤੁਹਾਨੂੰ ਅਜਿਹੇ ਪਾਰਟਨਰ ਦੀ ਲੋੜ ਹੈ ਜੋ ਜਜ਼ਬਾਤਾਂ ਨਾਲ ਬੈਠ ਸਕਣ — ਆਪਣੇ ਵੀ ਅਤੇ ਤੁਹਾਡੇ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bycie naprawdę obok – nie tylko fizycznie. Potrzebujesz drugiej połówki, która potrafi zatrzymać się przy uczuciach – swoich i twoich."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په رښتیا هلته اوسېدل — نه یوازې په جسم. تاسو داسې ملګري ته اړتیا لرئ چې له احساساتو سره کېنای شي، خپلو او ستاسو."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente de verdade — não só fisicamente. Você precisa de um amor que saiba acolher sentimentos, os próprios e os seus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar mesmo lá — não só fisicamente. Precisas de um par que saiba ficar com os sentimentos, os seus e os teus."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să fie cu adevărat acolo — nu doar fizic. Ai nevoie de un partener care să facă loc emoțiilor, ale sale și ale tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быть рядом по-настоящему, а не только физически. Тебе нужен партнёр, который умеет побыть с чувствами — своими и твоими."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuba uhari koko — si ku mubiri gusa. Ukeneye umukunzi ushobora kwakira amarangamutima, aye n'ayawe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ශාරීරිකව විතරක් නෙවෙයි, ඇත්තටම ළඟින් සිටීම. ඔවුන්ගේත් ඔබේත් හැඟීම් එක්ක ඉන්න පුළුවන් සහකරුවෙක් ඔබට ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byť naozaj pri sebe – nielen fyzicky. Potrebuješ polovičku, ktorá dokáže zostať s pocitmi, svojimi aj tvojimi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biti resnično zraven – ne le telesno. Potrebuješ partnerja, ki zmore ostati ob čustvih, svojih in tvojih."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunyatsovapo — kwete nemuviri chete. Unoda mudiwa anogona kugara nemanzwiro, ake neako."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaad runtii joogto — ma aha jidh ahaan oo kaliya. Waxaad u baahan tahay lammaane xamili kara dareemada labadiinaba."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të jesh vërtet aty – jo vetëm fizikisht. Të duhet një partner që di të rrijë me ndjenjat, të vetat dhe të tuat."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бити заиста ту — не само физички. Треба ти половина која уме да остане уз осећања, своја и твоја."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leres-leres hadir, sanés ngan awakna. Anjeun peryogi pasangan anu tiasa narima rasa, rasana sorangan sareng rasa anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att verkligen finnas där – inte bara fysiskt. Du behöver en partner som kan stanna i känslor, både sina egna och dina."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuwepo kweli — si kimwili tu. Unahitaji mwenzi anayeweza kukaa na hisia, zake na zako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உண்மையாக உடனிருப்பது — உடலால் மட்டுமல்ல. அவரது உணர்வுகளையும் உங்கள் உணர்வுகளையும் பொறுமையாக எதிர்கொள்ளும் துணை உங்களுக்குத் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిజంగా తోడుగా ఉండటం — కేవలం శారీరకంగా కాదు. భావాలతో — వారివీ, మీవీ — ఓపికగా ఉండగల భాగస్వామి మీకు కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воқеан будан — на танҳо бо ҷисм. Ба ту ёре лозим аст, ки бо ҳиссиёт — ҳам аз они худ, ҳам аз они ту — монда тавонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอยู่ตรงนั้นจริงๆ ไม่ใช่แค่ตัว คุณต้องการคนรักที่อยู่กับความรู้สึกได้ ทั้งของตัวเองและของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብሓቂ ምህላው — ብኣካል ጥራይ ዘይኮነ። ምስ ስምዒታት — ናይ ርእሱን ናትኩምን — ክጸንሕ ዝኽእል መጻምዲ የድልየኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakykatdan ýanynda bolmak — diňe beden taýdan däl. Saňa duýgulary — öz duýgularyny hem, seniňkini hem — kabul edip bilýän söýgüli gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece fiziksel olarak değil, gerçekten orada olmak. Hem kendi duygularına hem de seninkilere alan açabilen bir partnere ihtiyacın var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бути справді поруч — не лише фізично. Тобі потрібна половинка, яка не тікає від почуттів — своїх і твоїх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واقعی ساتھ ہونا، صرف جسمانی طور پر نہیں۔ آپ کو ایسا ساتھی چاہیے جو احساسات کے ساتھ ٹھہر سکے، اپنے بھی اور آپ کے بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chinakam yonida boʻlish — faqat jismonan emas. Sizga oʻzining ham, sizning ham his-tuygʻularingizni koʻtara oladigan sherik kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thật sự ở đó — không chỉ về thể xác. Bạn cần người ấy biết cùng ngồi lại với cảm xúc — của người ấy và của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubakho ngokwenene — hayi nje ngomzimba. Ufuna iqabane elinokuhlala neemvakalelo, ezalo nezakho."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wíwà níbẹ̀ lóòótọ́ — kì í ṣe ní ara nìkan. Ẹ nílò olólùfẹ́ tó lè wà pẹ̀lú ìmọ̀lára, tirẹ̀ àti tiyín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真正地在場，而不只是人在身邊。你需要一個能陪着感受情緒的另一半，無論是對方的還是你的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真正地在，而不只是人在。你需要一个能陪着感受情绪的另一半，无论是对方的还是你的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真正的陪伴，不只是人在身邊。你需要一個能和情緒相處的另一半，不論是對方的還是你的。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuba khona ngempela — hhayi nje ngokomzimba. Udinga umlingani ongahlala nemizwa, eyakhe neyakho."
          }
        }
      }
    },
    "Best of both worlds. You have a safety net but room to breathe. Most people travel happily with you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beste van albei wêrelde. Jy het ’n veiligheidsnet, maar ruimte om asem te skep. Die meeste mense reis gelukkig saam met jou."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሁለቱም ዓለም ምርጡ። የደህንነት መረብ አለዎት፣ ግን ለመተንፈስም ቦታ አለ። አብዛኞቹ ሰዎች ከእርስዎ ጋር በደስታ ይጓዛሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل ما في العالمين. لديكم شبكة أمان ومساحة للتنفس. معظم الناس يسافرون معكم بسعادة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুয়োটা জগতৰ শ্ৰেষ্ঠখিনি। আপোনাৰ এক সুৰক্ষা জাল আছে আৰু উশাহ লোৱাৰ ঠাইও। বেছিভাগ মানুহে আপোনাৰ লগত আনন্দেৰে ভ্ৰমণ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər iki dünyanın ən yaxşısı. Arxayınlığın da var, nəfəs almağa yerin də. İnsanların çoxu səninlə məmnuniyyətlə səyahət edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найлепшае з двух светаў. У цябе ёсць падушка бяспекі і месца для свабоды. З табой рады падарожнічаць большасць людзей."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-доброто от двата свята. Имаш предпазна мрежа, но и място за дишане. С теб на повечето хора им е приятно да пътуват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুই দিকেরই সেরাটা। তোমার নিরাপত্তার জাল আছে, শ্বাস নেওয়ার জায়গাও আছে। বেশিরভাগ মানুষ তোমার সাথে খুশি মনে ঘোরে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje od oba svijeta. Imaš sigurnosnu mrežu, ali i prostora za disanje. S tobom većina ljudi rado putuje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El millor dels dos mons. Tens una xarxa de seguretat però marge per respirar. Amb tu, la majoria de gent viatja a gust."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nejlepší z obou světů. Máš záchrannou síť, ale i volnost. S tebou se cestuje většině lidí dobře."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y gorau o'r ddau fyd. Mae gen ti rwyd ddiogelwch ond lle i anadlu. Mae'r rhan fwyaf o bobl yn hapus i deithio gyda ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bedste fra begge verdener. Du har et sikkerhedsnet, men plads til at trække vejret. De fleste rejser gladeligt med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Beste aus beiden Welten. Du hast ein Sicherheitsnetz, aber auch Luft zum Atmen. Mit dir reisen die meisten gern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καλύτερο και των δύο κόσμων. Έχεις δίχτυ ασφαλείας αλλά και χώρο να ανασάνεις. Με σένα ταξιδεύουν ευχάριστα οι περισσότεροι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo mejor de los dos mundos. Tienes una red de seguridad, pero también margen para respirar. Casi todo el mundo viaja a gusto contigo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parim mõlemast maailmast. Sul on turvavõrk, aga ka hingamisruumi. Enamik inimesi reisib sinuga meeleldi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi munduetako onena. Segurtasun-sarea duzu, baina arnasteko tartea ere bai. Jende gehienak gustura bidaiatzen du zurekin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بهترینِ هر دو دنیا. هم تور ایمنی داری، هم جای نفس کشیدن. بیشتر آدم‌ها با تو با خیال راحت سفر می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras molemmista maailmoista. Sinulla on turvaverkko mutta tilaa hengittää. Useimmat matkustavat kanssasi mielellään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinakamaganda sa dalawang mundo. May safety net ka pero may puwang huminga. Masaya ang karamihan na kasama kang bumiyahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meilleur des deux mondes. Tu as un filet de sécurité, mais de quoi respirer. Presque tout le monde voyage volontiers avec toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An dá thrá. Tá líon sábhála agat ach spás chun análú. Is breá le formhór na ndaoine taisteal leat."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mellor dos dous mundos. Tes unha rede de seguridade, pero con marxe para respirar. Coa maioría da xente viaxas a gusto."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બંને દુનિયાનું શ્રેષ્ઠ. સલામતીની જાળ પણ છે અને મોકળાશ પણ. મોટા ભાગના લોકો તમારી સાથે ખુશીથી મુસાફરી કરે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mafi kyau daga ɓangarorin biyu. Kuna da tabbaci amma da sararin numfashi. Yawancin mutane na jin daɗin tafiya tare da ku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכי טוב משני העולמות. יש רשת ביטחון, אבל גם מקום לנשום. לרוב האנשים כיף לטייל איתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों का बेहतरीन मेल। पक्का सहारा भी है और खुलकर साँस लेने की जगह भी। ज़्यादातर लोग आपके साथ ख़ुशी से सफ़र करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje od oba svijeta. Imaš sigurnosnu mrežu, ali i prostora za disanje. S tobom većina ljudi rado putuje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi bon nan toude mond yo. Ou gen yon filè sekirite men espas pou respire. Pifò moun vwayaje avè ou san pwoblèm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kettő legjobbja. Van biztonsági hálód, de marad levegő is. A legtöbben szívesen utaznak veled."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երկու աշխարհների լավագույնը։ Ունես անվտանգության բարձիկ, բայց նաև ազատություն։ Մարդկանց մեծ մասը քեզ հետ սիրով է ճամփորդում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat enaknya dua-duanya. Kamu punya jaring pengaman tapi tetap ada ruang bernapas. Kebanyakan orang senang traveling denganmu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe kacha mma n'akụkụ abụọ. I nwere nchekwa mana i nwekwara oghere iku ume. Ọtụtụ mmadụ na-eso gị eme njem n'obi ụtọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það besta úr báðum heimum. Þú hefur öryggisnet en svigrúm til að anda. Flestir ferðast glaðir með þér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il meglio dei due mondi. Hai una rete di sicurezza ma anche spazio per respirare. Con te viaggiano bene quasi tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいとこ取りのスタイル。安心できる備えがありつつ、ゆとりもあります。たいていの人と楽しく旅ができるでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paling apik saka loro-lorone. Panjenengan nduwe pengaman nanging isih ana ruang ambegan. Akeh wong seneng lelungan bareng panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორივე სამყაროს საუკეთესო მხარე. უსაფრთხოების ბადეც გაქვს და თავისუფლებაც. ადამიანების უმეტესობა შენთან სიამოვნებით იმოგზაურებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екі әлемнің ең жақсысы. Қауіпсіздік жастығы да, еркіндік те бар. Көп адам сенімен қуана саяхаттайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ល្អទាំងសងខាង។ អ្នកមានសំណាញ់សុវត្ថិភាព តែក៏មានចន្លោះដកដង្ហើមដែរ។ មនុស្សភាគច្រើនរីករាយធ្វើដំណើរជាមួយអ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎರಡೂ ಲೋಕಗಳ ಅತ್ಯುತ್ತಮ. ನಿಮಗೆ ಸುರಕ್ಷತೆಯೂ ಇದೆ, ಉಸಿರಾಡುವ ಅವಕಾಶವೂ ಇದೆ. ಹೆಚ್ಚಿನವರು ನಿಮ್ಮೊಂದಿಗೆ ಖುಷಿಯಾಗಿ ಪ್ರಯಾಣಿಸುತ್ತಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 마리 토끼를 다 잡았어요. 안전망도 있고 여유도 있죠. 누구와도 즐겁게 여행할 수 있는 타입이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ji herdu dinyayan ya herî baş. Tora ewlehiyê ya te heye, lê cihê bêhnê jî. Piraniya mirovan bi te re bi kêfxweşî digerin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эки дүйнөнүн эң жакшысы. Коопсуздук жаздыгың бар, бирок эркин дем алууга да орун бар. Көп адамдар сени менен кубанып саякаттайт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat Bescht aus zwou Welten. Du hues e Sécherheetsnetz, mee och Loft fir ze otmen. Mat dir reesen déi meescht Leit gär."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໄດ້ທັງສອງທາງ ເຈົ້າມີຕາໜ່າງຄວາມປອດໄພ ແຕ່ກໍມີບ່ອນໃຫ້ຫາຍໃຈ ຄົນສ່ວນໃຫຍ່ທ່ຽວກັບເຈົ້າໄດ້ຢ່າງມີຄວາມສຸກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geriausia iš abiejų pasaulių. Turi saugumo tinklą, bet ir laisvės atsikvėpti. Daugumai su tavimi keliauti malonu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labākais no abām pasaulēm. Tev ir drošības tīkls, bet arī vieta elpot. Ar tevi ceļot patīk gandrīz visiem."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny tsara indrindra amin'ny lafiny roa. Manana fiarovana ianao nefa misy toerana hiainana. Faly miara-dia aminao ny ankamaroan'ny olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pai o ngā ao e rua. He kupenga haumaru tōu, engari he wāhi hei whakatā. Ka harikoa te nuinga ki te haere tahi me koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Најдоброто од двата света. Имаш сигурносна мрежа, но и простор за дишење. Со тебе повеќето луѓе патуваат среќно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "രണ്ടിന്റെയും നല്ല വശം. നിങ്ങൾക്കൊരു സുരക്ഷാവലയുണ്ട്, ഒപ്പം ശ്വാസമെടുക്കാൻ ഇടവും. മിക്കവരും നിങ്ങളോടൊപ്പം സന്തോഷത്തോടെ യാത്ര ചെയ്യും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоёулангийнх нь сайныг. Чамд аюулгүйн дэр ч, амьсгаа авах зай ч бий. Ихэнх хүн чамтай аялахдаа баяртай байдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोन्हीचा उत्तम मेळ. तुमच्याकडे सुरक्षाकवचही आहे आणि मोकळीकही. बहुतेकजण तुमच्यासोबत आनंदाने प्रवास करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabungan terbaik kedua-duanya. Anda ada jaring keselamatan tetapi masih ada ruang bernafas. Kebanyakan orang gembira melancong bersama anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-aħjar taż-żewġ dinjiet. Għandek xibka ta' sigurtà imma spazju biex tieħu n-nifs. Ħafna nies jivvjaġġaw kuntenti miegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နှစ်ဖက်စလုံးရဲ့ အကောင်းဆုံး။ အရံအကာ ရှိပေမဲ့ အသက်ရှူချောင်တယ်။ လူအများစုက သင်နဲ့ ပျော်ပျော်ရွှင်ရွှင် ခရီးသွားနိုင်ကြတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det beste fra begge verdener. Du har et sikkerhetsnett, men rom til å puste. De fleste reiser gjerne med deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दुवैतिरको राम्रो पक्ष। तपाईंसँग सुरक्षा जाल पनि छ, खुला ठाउँ पनि। धेरैजसो मान्छे तपाईंसँग खुसीसाथ यात्रा गर्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het beste van twee werelden. Je hebt een vangnet, maar ook ademruimte. De meeste mensen reizen graag met je."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabwino za mbali zonse ziwiri. Muli ndi chitetezo koma muli ndi mpata wopuma. Anthu ambiri amasangalala kuyenda nanu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaarii lamaanuu. Gabatee nageenyaa qabda garuu iddoo hafuura baafachuus qabda. Namoonni baay'een si wajjin gammachuun imalu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦୁଇ ଦୁନିଆର ସବୁଠୁ ଭଲ। ଆପଣଙ୍କ ପାଖରେ ସୁରକ୍ଷା ଜାଲ ଅଛି, ତଥାପି ନିଶ୍ୱାସ ନେବାକୁ ଜାଗା। ଅଧିକାଂଶ ଲୋକ ଆପଣଙ୍କ ସହ ଖୁସିରେ ଯାତ୍ରା କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੋਵਾਂ ਦਾ ਸਭ ਤੋਂ ਵਧੀਆ। ਤੁਹਾਡੇ ਕੋਲ ਸੁਰੱਖਿਆ ਵੀ ਹੈ ਅਤੇ ਸਾਹ ਲੈਣ ਦੀ ਥਾਂ ਵੀ। ਜ਼ਿਆਦਾਤਰ ਲੋਕ ਤੁਹਾਡੇ ਨਾਲ ਖ਼ੁਸ਼ੀ-ਖ਼ੁਸ਼ੀ ਘੁੰਮਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co najlepsze z obu światów. Masz siatkę bezpieczeństwa, ale i swobodę. Z tobą większość ludzi podróżuje z radością."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د دواړو نړیو غوره. تاسو د خوندیتوب جال لرئ، خو د ساه اخیستو ځای هم. ډېر خلک درسره په خوښۍ سفر کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O melhor dos dois mundos. Você tem uma rede de segurança, mas espaço para respirar. Quase todo mundo viaja bem com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O melhor dos dois mundos. Tens uma rede de segurança, mas espaço para respirar. A maioria das pessoas viaja contigo sem problemas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce e mai bun din ambele lumi. Ai o plasă de siguranță, dar și loc de respirat. Majoritatea oamenilor călătoresc cu plăcere alături de tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшее из двух миров. У тебя есть страховка и при этом свобода. С тобой легко путешествовать почти любому."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibyiza by'impande zombi. Ufite ubwirinzi ariko n'umwanya wo guhumeka. Abantu benshi bakora ingendo nawe bishimye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දෙපැත්තේම හොඳම දේ. ඔබට ආරක්ෂක දැලකුත් හුස්ම ගන්න ඉඩකුත් තියෙනවා. බොහෝ දෙනා ඔබ එක්ක සතුටින් ගමන් යනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To najlepšie z oboch svetov. Máš záchrannú sieť, ale aj priestor dýchať. S tebou sa väčšine ľudí cestuje dobre."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najboljše iz obeh svetov. Imaš varnostno mrežo, a tudi prostor za dih. S tabo večina ljudi rada potuje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakanakisa zvemativi ose. Une chekudzivirira asi uine nzvimbo yekufema. Vanhu vazhinji vanofara kufamba newe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labada adduunba kuwooda ugu fiican. Shabag badbaado ayaad haysataa laakiin meel aad ku neefsato. Dadka badankood si farxad leh ayay kuula safraan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më e mira e të dyja botëve. Ke një rrjet sigurie, por edhe hapësirë për të marrë frymë. Shumica e njerëzve udhëtojnë me qejf me ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Најбоље од оба света. Имаш сигурносну мрежу, али и простора да дишеш. С тобом већина људи радо путује."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangsaéna tina duanana. Anjeun gaduh jaring pangaman tapi tetep aya rohangan. Kalolobaan jalma bungah ngumbara sareng anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bästa av två världar. Du har ett skyddsnät men utrymme att andas. De flesta reser gärna med dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bora ya pande zote mbili. Una kinga lakini pia nafasi ya kupumua. Watu wengi husafiri nawe kwa furaha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டிலும் சிறந்தது. பாதுகாப்பு வலையும் உண்டு, சுதந்திரமாக இருக்க இடமும் உண்டு. பெரும்பாலானோர் உங்களுடன் மகிழ்ச்சியாகப் பயணிப்பார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రెండింటిలోని మంచి. మీకు రక్షణ వలయమూ ఉంది, ఊపిరి తీసుకునే చోటూ ఉంది. చాలా మంది మీతో హాయిగా ప్రయాణిస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Беҳтарини ҳар ду ҷаҳон. Ту шабакаи бехатарӣ дорӣ, вале ҷои нафас кашидан ҳам ҳаст. Аксари одамон бо ту бо хурсандӣ сафар мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้ดีทั้งสองทาง คุณมีตาข่ายรองรับแต่ก็มีพื้นที่ให้หายใจ คนส่วนใหญ่เที่ยวกับคุณได้อย่างมีความสุข"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክልቲኡ ዝበለጸ። መከላኸሊ ኣለኩም ግን ናይ ምትንፋስ ቦታ እውን። መብዛሕትኦም ሰባት ምሳኹም ብሓጎስ ይጓዓዙ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iki dünýäniň hem iň gowusy. Seniň howpsuzlyk ýassygyň hem, dem alar ýaly ýeriň hem bar. Adamlaryň köpüsi seniň bilen syýahat etmekden hoşal bolýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki dünyanın en iyisi. Bir güvenlik ağın var ama nefes alacak alanın da var. Çoğu insan seninle mutlu mesut seyahat eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкраще з обох світів. У тебе є страховка, але й простір для маневру. З тобою більшості людей легко подорожувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں دنیاؤں کا بہترین۔ حفاظتی جال بھی ہے اور کھل کر سانس لینے کی گنجائش بھی۔ زیادہ تر لوگ آپ کے ساتھ خوشی سے سفر کرتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikki dunyoning eng yaxshisi. Sizda zaxira reja ham, erkin nafas olishga joy ham bor. Koʻpchilik siz bilan mamnuniyat bilan sayohat qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẹn cả đôi đường. Bạn có lưới an toàn mà vẫn có chỗ để thở. Hầu hết mọi người đều vui khi đi cùng bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okona kulungileyo kumacala omabini. Unokhuseleko kodwa unendawo yokuphefumla. Uninzi lwabantu luhamba kamnandi nawe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó dára ní ọ̀nà méjèèjì. Ẹ ní ààbò, ṣùgbọ́n àyè wà láti mí. Inú ọ̀pọ̀ ènìyàn máa ń dùn láti bá yín rìnrìn-àjò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩全其美。你有安全網，也有喘息空間。大部分人都能和你愉快地旅行。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两全其美。有安全网，也有喘息的空间。大多数人都会和你玩得很开心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩全其美。你有安全網，也保留喘息空間。大多數人都能和你開心出遊。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuhle kakhulu kwezinhlangothi zombili. Unenethi yokuphepha kodwa unesikhala sokuphefumula. Abantu abaningi bajabula ukuhamba nawe."
          }
        }
      }
    },
    "Big or small — just something that actually means something to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groot of klein – net iets wat regtig vir jou iets beteken."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትልቅም ይሁን ትንሽ — ለእርስዎ በእውነት ትርጉም ያለው ነገር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كبيرًا كان أو صغيرًا — المهم أن يعني لكم شيئًا حقًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাঙৰ বা সৰু — মাথোঁ যিটো আপোনাৰ বাবে সঁচাকৈয়ে অৰ্থপূৰ্ণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyük və ya kiçik — sadəcə sənin üçün həqiqətən məna daşıyan bir şey."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вялікім ці маленькім — галоўнае, каб яно сапраўды нешта для цябе значыла."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голямо или малко – просто нещо, което наистина има значение за теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বড় হোক বা ছোট — এমন কিছু, যা তোমার কাছে সত্যিই অর্থ বহন করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veliko ili malo – samo nešto što ti zaista nešto znači."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran o petit — només cal que signifiqui alguna cosa per a tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velký nebo malý – hlavně ať pro tebe opravdu něco znamená."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mawr neu fach — dim ond rhywbeth sydd wir yn golygu rhywbeth i ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor eller lille – bare noget, der virkelig betyder noget for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groß oder klein – Hauptsache, sie bedeutet dir wirklich etwas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλο ή μικρό — αρκεί να σημαίνει πραγματικά κάτι για σένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande o pequeño — solo algo que de verdad signifique mucho para ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suur või väike — peaasi, et see päriselt midagi tähendab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handia edo txikia: benetan zuretzat zerbait esan nahi duen zerbait."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بزرگ یا کوچک — فقط چیزی که واقعاً برایت معنا دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso tai pieni – kunhan se merkitsee sinulle oikeasti jotain."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malaki man o maliit — basta may tunay na kahulugan sa’yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande ou petite — juste quelque chose qui compte vraiment pour toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
