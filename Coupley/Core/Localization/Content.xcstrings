        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatisk. Det virkelige livet ditt skjer utenfor jobben. Jobben tjener visjonen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यावहारिक। तपाईंको वास्तविक जीवन कामभन्दा बाहिर चल्छ। जागिर त ठुलो सपना पूरा गर्ने साधन मात्र हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatisch. Je echte leven speelt zich buiten je werk af. Je baan staat in dienst van je droom."
