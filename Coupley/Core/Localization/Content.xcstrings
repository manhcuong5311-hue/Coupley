        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒന്നും ആവശ്യപ്പെടാത്ത എന്തെങ്കിലും ഒരുമിച്ച് ചെയ്യൂ — പാചകം, തുണി മടക്കൽ, വര."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Юу ч шаардахгүй юм хамтдаа хий — хоол хийх, угаалга эвхэх, зурах."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काहीही न मागणारे काहीतरी एकत्र करा — स्वयंपाक, कपड्यांच्या घड्या, चित्र काढणे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat sesuatu bersama yang tidak menuntut apa-apa — memasak, melipat baju, melukis."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agħmlu xi ħaġa flimkien li ma titlob xejn — sajru, intwew il-ħwejjeġ, pinġu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘာမှ မတောင်းဆိုတဲ့ အရာတစ်ခုကို အတူလုပ်ပါ — ချက်ပြုတ်တာ၊ အဝတ်ခေါက်တာ၊ ပုံဆွဲတာ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør noe sammen som ikke krever noe – lag mat, brett klær, tegn."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केही नमाग्ने काम सँगै गर्नुहोस् — खाना पकाउने, लुगा पट्याउने, चित्र कोर्ने।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe samen iets wat niks vraagt – koken, de was vouwen, tekenen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chitani kanthu limodzi kosafuna zambiri — kuphika, kupinda zovala, kujambula."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan homaa hin gaafanne waliin hojjedhaa — nyaata bilcheessaa, uffata maraa, fakkii kaasaa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକାଠି କିଛି କରନ୍ତୁ ଯାହା କିଛି ମାଗେ ନାହିଁ — ରାନ୍ଧିବା, ଲୁଗା ଭାଙ୍ଗିବା, ଆଙ୍କିବା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਕੱਠੇ ਕੁਝ ਅਜਿਹਾ ਕਰੋ ਜਿਸ ਵਿੱਚ ਕੋਈ ਮੰਗ ਨਾ ਹੋਵੇ — ਖਾਣਾ ਬਣਾਉਣਾ, ਕੱਪੜੇ ਤਹਿ ਕਰਨਾ, ਚਿੱਤਰ ਬਣਾਉਣਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Róbcie razem coś, co niczego nie wymaga – gotujcie, składajcie pranie, rysujcie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یوځای داسې کار وکړئ چې هېڅ نه غواړي — پخلی، د جامو قاتول، انځور ایستل."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Façam algo a dois que não exija nada — cozinhar, dobrar roupa, desenhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Façam juntos algo que não exige nada — cozinhar, dobrar roupa, desenhar."
          }
        },
        "ro" : {
          "stringUnit" : {
