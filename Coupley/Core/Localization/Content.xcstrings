        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukujula kudala ukusondelana. Lapho othile ekhuluma nawe ngokwethembeka, uzizwa useduze kakhulu. Izingxoxo ezingajulile zikushiya kude."
          }
        }
      }
