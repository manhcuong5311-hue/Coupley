        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ସବୁକିଛି ଉପରେ ପ୍ରଭାବ ପକାଉଛି — ଆପଣଙ୍କ ମନୋଭାବ, ଧୈର୍ଯ୍ୟ, ଅନ୍ୟ ସହ ଯୋଡ଼ି ହେବାର କ୍ଷମତା। ଏହାକୁ ପ୍ରାଥମିକତା ଦେବା ଉଚିତ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਦਾ ਅਸਰ ਹਰ ਚੀਜ਼ ਉੱਤੇ ਪੈ ਰਿਹਾ ਹੈ — ਤੁਹਾਡੇ ਮੂਡ, ਤੁਹਾਡੇ ਸਬਰ, ਅਤੇ ਜੁੜਨ ਦੀ ਤੁਹਾਡੀ ਤਾਕਤ ਉੱਤੇ। ਇਸ ਨੂੰ ਪਹਿਲ ਦੇਣੀ ਚਾਹੀਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wpływa na wszystko – nastrój, cierpliwość, zdolność do bliskości. Warto potraktować to priorytetowo."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا پر هر څه اغېز کوي — مزاج، حوصله او د اړیکې توان. ښه به وي چې دا لومړیتوب وګڼئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso está afetando tudo — seu humor, sua paciência, sua capacidade de se conectar. Vale tratar como prioridade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto afeta tudo — o teu humor, a tua paciência, a tua capacidade de ligação. Vale a pena tratá-lo como prioridade."
