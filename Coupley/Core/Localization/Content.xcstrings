        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव के लिए तैयार, पर जानी-पहचानी संस्कृति में। आपको नई शुरुआत चाहिए, पर पूरी तरह कहीं और बसने की अनिश्चितता नहीं।"
