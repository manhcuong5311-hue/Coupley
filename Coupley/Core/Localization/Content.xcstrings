    "Slow, quiet life — peace is the point" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حياة هادئة وبطيئة — السلام هو الغاية"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalý, tichý život – jde o klid"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et langsomt, stille liv – roen er pointen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiges, langsames Leben – Frieden ist das Ziel"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αργή, ήσυχη ζωή — η γαλήνη είναι το ζητούμενο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vida lenta y tranquila — la paz es lo importante"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidasta, hiljaista elämää – rauha on koko pointti"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabagal at tahimik na buhay — kapayapaan ang punto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vie lente et paisible — la tranquillité avant tout"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיים איטיים ושקטים — השקט הוא העיקר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धीमी, शांत ज़िंदगी — सुकून ही असली मक़सद"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassú, csendes élet – a béke a lényeg"
