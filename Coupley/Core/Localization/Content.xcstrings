        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不太亲近，客气但有距离"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不太親近，客氣但有距離"
          }
        }
      }
    },
    "Not what you think you should say — what you're actually working on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس ما ترون أنه الجواب المتوقع، بل ما تعملون عليه حقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne to, co by se mělo říct – ale na čem opravdu pracuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke det, du tror, du burde sige – men det, du faktisk arbejder på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht das, was man sagen sollte – sondern woran du wirklich arbeitest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όχι αυτό που νομίζεις ότι πρέπει να πεις — αυτό που δουλεύεις πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo que crees que deberías decir — en lo que de verdad estás trabajando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei sitä, mitä luulet, että pitäisi sanoa – vaan sitä, mitä oikeasti työstät."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ’yung sa tingin mo ay dapat mong sabihin — ’yung talagang ginagawa mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ce que tu penses devoir répondre — ce sur quoi tu travailles vraiment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מה שנראה לך שאמור להישמע טוב — אלא מה שבאמת בעבודה אצלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह नहीं जो कहना चाहिए — वह जिस पर सच में काम चल रहा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem azt, amit szerinted mondanod kéne – hanem amin tényleg dolgozol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan yang menurutmu seharusnya kamu jawab — tapi yang benar-benar sedang kamu usahakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non quello che pensi di dover dire — quello su cui stai lavorando davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言うべきだと思うことではなく、実際に取り組んでいること。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말해야 할 것 같은 답 말고, 실제로 노력하고 있는 걸 알려 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan apa yang anda rasa patut dikatakan — tapi apa yang betul-betul sedang anda usahakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke det du tror du bør svare – det du faktisk jobber med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet wat je denkt dat je hoort te zeggen – maar waar je echt mee bezig bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie to, co wypada powiedzieć – tylko to, nad czym naprawdę pracujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não o que você acha que deveria dizer — aquilo em que você está trabalhando de verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ce crezi că ar trebui să spui — ci la ce lucrezi cu adevărat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не то, что, по-твоему, принято говорить, — а то, над чем ты действительно работаешь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte det du tycker att du borde säga – det du faktiskt jobbar med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ใช่สิ่งที่คิดว่าควรตอบ แต่เป็นสิ่งที่คุณกำลังทำอยู่จริงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söylemen gerektiğini düşündüğün şey değil, gerçekten üzerinde çalıştığın şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не те, що «правильно» сказати, — а над чим ти справді працюєш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phải điều bạn nghĩ mình nên nói — mà là điều bạn thật sự đang làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是你觉得应该说的，而是你真正在努力的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是你覺得應該說的答案，而是你真正在努力的事。"
          }
        }
      }
    },
    "Nothing — I rest and I'm not sorry" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء — أرتاح ولا أعتذر"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic – odpočívám a nestydím se za to"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting – jeg slapper af og undskylder ikke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts – ich ruhe mich aus, ganz ohne Reue"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα — ξεκουράζομαι και δεν ζητάω συγγνώμη"
