        }
      }
    },
    "Atmosphere over formality. You want the energy of being out without the formality of a sit-down." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأجواء قبل الرسميات. حيوية الخروج تهمك من دون تكلّف الجلوس إلى مائدة رسمية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosféra před formalitami. Chceš tu energii venku, ale bez strojeného sezení u prostřeného stolu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemning frem for etikette. Du vil have energien ved at være ude uden det stive ved en lang middag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmung statt Etikette. Du willst die Energie vom Ausgehen, aber ohne steifes Dinner am gedeckten Tisch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ατμόσφαιρα αντί για τυπικότητες. Θες την ενέργεια της εξόδου χωρίς το τυπικό ενός καθιστού δείπνου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ambiente pesa más que la etiqueta. Quieres la energía de salir sin la formalidad de sentarte a la mesa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelma ennen muodollisuutta. Haluat ulkona olemisen energian ilman pöytään istumisen jäykkyyttä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosphere kaysa pormalidad. Gusto mo ang sigla ng paglabas nang hindi kailangang umupo sa pormal na kainan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ambiance plutôt que le protocole. Tu veux l'énergie d'une sortie, sans le cérémonial d'un vrai dîner assis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אווירה לפני רשמיות. מתחשקת לך האנרגיה של יציאה, בלי הטקסיות של ארוחה מסודרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "औपचारिकता से ज़्यादा माहौल। आपको बाहर की रौनक चाहिए, पर बैठकर खाने वाली औपचारिकता नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangulat fontosabb a formaságoknál. Szereted a kimozdulás pezsgését, de a merev ültetett vacsora nem a te világod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suasana lebih penting dari formalitas. Kamu ingin energi jalan-jalan keluar tanpa kakunya makan di restoran resmi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosfera prima dell’etichetta. Vuoi l’energia di uscire senza la rigidità di una cena servita al tavolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "かしこまるより雰囲気重視。きちんと座る食事の堅苦しさはなしで、外に出かけるにぎやかさを楽しみたいタイプです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격식보다 분위기예요. 정식 식사 자리의 딱딱함 없이 밖에 나와 있는 그 활기를 즐기고 싶어 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suasana lebih penting daripada formaliti. Anda mahu rasa meriah di luar tanpa perlu duduk makan secara formal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemning framfor stivhet. Du vil ha energien ved å være ute, uten det formelle ved en lang middag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfeer boven formaliteit. Je wilt de energie van een avondje uit, zonder het gedoe van een chic diner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimat ponad etykietę. Chcesz poczuć energię wyjścia bez sztywności eleganckiej kolacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O clima importa mais que a formalidade. Você quer a energia de sair sem a cerimônia de um restaurante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosfera înaintea formalității. Vrei energia ieșitului în oraș, fără rigiditatea unei mese la restaurant."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Атмосфера важнее формальностей. Тебе нужна энергия выхода в люди — без чопорного ужина за столиком."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämning före finess. Du vill ha energin av att vara ute, utan stelheten i en sittande middag."
