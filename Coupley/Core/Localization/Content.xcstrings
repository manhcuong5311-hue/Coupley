        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንክኪ እንደ መገናኛ — የግድ ወሲባዊ አይደለም። ዝም ብሎ አጠገብ ለአጠገብ መሆን፣ የሰውነት ቋንቋ «እዚህ ነኝ» ሲል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة وسيلة للتواصل، وليست بالضرورة جنسية. مجرد القرب من بعضكما، ولغة الجسد تقول «أنا هنا»."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগ হিচাপে স্পৰ্শ — যৌনতা হ'বই লাগিব বুলি নাই। কেৱল ইজনে সিজনৰ কাষত থকা, শৰীৰৰ ভাষাই কয় “মই আছোঁ”।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toxunuş bir bağdır — mütləq ehtiraslı olması vacib deyil. Sadəcə bir-birinə yaxın olmaq, bədən dilinin “buradayam” deməsi."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотык як сувязь — не абавязкова пачуццёвы. Проста быць побач, калі цела кажа «Я тут»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосването като връзка – не непременно сексуално. Просто да сте близо, а езикът на тялото да казва „Тук съм“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্পর্শ মানে সংযোগ — সবসময় যৌনতা নয়। শুধু একে অপরের কাছাকাছি থাকা, শরীরের ভাষায় বলা “আমি আছি”।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir kao povezanost – ne nužno seksualan. Samo biti blizu, govor tijela koji kaže „tu sam”."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacte com a connexió — no necessàriament sexual. Simplement estar a prop, amb un llenguatge corporal que diu «soc aquí»."
