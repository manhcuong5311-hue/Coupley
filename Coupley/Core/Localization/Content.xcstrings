        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedät ratkaisun, mutta et toteuta sitä. Aikaisemmin nukkumaan menevä kumppani voisi oikeasti auttaa – tai ajaa sinut hulluksi."
