          "stringUnit" : {
            "state" : "translated",
            "value" : "सजिलो रोजाइ, तर गहिरो हेरचाह।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weinig moeite voor de ander, veel zorg van jou."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusankha kosavuta, chisamaliro chachikulu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filannoo salphaa, kunuunsa guddaa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବାଛିବାରେ କମ୍ ପରିଶ୍ରମ, ଯତ୍ନରେ ବହୁତ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਨ੍ਹਾਂ ਲਈ ਘੱਟ ਮਿਹਨਤ, ਤੁਹਾਡੇ ਵੱਲੋਂ ਭਰਪੂਰ ਪਰਵਾਹ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mało wysiłku przy wyborze, dużo troski w geście."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لږ زحمت انتخاب، ډېره پاملرنه."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha que não pede esforço, cuidado que pede muito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha de pouco esforço, cuidado de muito esforço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegere fără efort, grijă cu tot efortul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никаких усилий с выбором — и много заботы."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhitamo bidasaba imbaraga, kwita ku muntu byuzuye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අඩු මහන්සියක් ඕනේ තේරීමක්, ලොකු සැලකිල්ලක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Málo námahy pri výbere, veľa starostlivosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbira z malo truda, skrb z veliko."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarudzo isingadi simba, rudo rwakadzama."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorasho fudud, daryeel culus."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgjedhje pa mundim, kujdes me shumë zemër."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избор без напора, брига с много труда."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan anu gampil, kanyaah anu ageung."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkelt val, stor omtanke."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaguo lisilo na juhudi, kujali kwa juhudi kubwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்வு எளிது, அக்கறை பெரிது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకోవడం సులభం, చూపే శ్రద్ధ గొప్పది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интихоби осон, ғамхории калон."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีกฝ่ายไม่ต้องออกแรง แต่เต็มไปด้วยความใส่ใจ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀሊል ምርጫ፣ ዓቢ ክንክን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saýlamak aňsat, alada uly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az çaba isteyen bir seçim, çok emek isteyen bir ilgi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибір без зусиль, турбота — на повну."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب آسان، خیال بھرپور۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kam harakatli tanlov, katta gʻamxoʻrlik."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lựa chọn nhẹ nhàng, quan tâm trọn vẹn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhetho olungafuni mzamo, ukhathalelo olunomzamo omkhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yíyàn tí kò gba agbára, ìtọ́jú tó jinlẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不費力的選擇，用心的關懷。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择很省力，关心很用心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不費力的選擇，滿滿的心意。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukhetha okulula, ukunakekela okukhulu."
          }
        }
      }
    },
    "Low-maintenance and adaptable. Just make sure you actually speak up when something matters to you — being 'easy' can leave you resentful." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maklik en aanpasbaar. Maak net seker jy praat regtig op as iets vir jou saak maak – om “maklik” te wees, kan jou met wrok laat."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀላልና ተላማጅ። ብቻ ለእርስዎ አስፈላጊ የሆነ ነገር ሲኖር በእውነት ይናገሩ — «ሁሉም ይስማማኛል» ማለት ቅሬታ ውስጥ ሊከትዎ ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سهلو المعشر ومرنون. فقط تأكدوا أن تعبّروا فعلًا حين يهمكم أمر ما، فالتساهل الدائم قد يترككم مستائين."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সহজে সন্তুষ্ট আৰু খাপ খুৱাব পৰা। কেৱল নিশ্চিত কৰক যে কোনো কথা আপোনাৰ বাবে গুৰুত্বপূৰ্ণ হ'লে আপুনি সঁচাকৈয়ে মুখ খোলে — সদায় “আপত্তি নাই” বুলি থাকিলে মনত ক্ষোভ জমিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tələbkar deyilsən və uyğunlaşansan. Sadəcə nəsə sənin üçün önəmli olanda mütləq de — həmişə “rahat” olmaq sonra incikliyə səbəb ola bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непатрабавальна і гнутка. Толькі не маўчы, калі нешта для цябе важна, — бо «мне ўсё падыходзіць» можа ператварыцца ў крыўду."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непретенциозно и гъвкаво. Само се погрижи наистина да казваш, когато нещо е важно за теб – вечната отстъпчивост може да натрупа обида."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঝামেলাহীন আর মানিয়ে নিতে পারো। শুধু খেয়াল রেখো, কিছু জরুরি মনে হলে সত্যিই মুখ খোলো — সবসময় “যা খুশি” হলে পরে মনে ক্ষোভ জমতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezahtjevno i prilagodljivo. Samo pazi da se zaista oglasiš kad ti je nešto važno – stalno popuštanje može ostaviti gorčinu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens poques exigències i t'adaptes. Només assegura't de dir-ho quan alguna cosa t'importa — fer sempre el que vol l'altre et pot acabar generant ressentiment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenáročnost a přizpůsobivost. Jen se opravdu ozvi, když ti na něčem záleží – být pořád „v pohodě“ může skončit tichou hořkostí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didrafferth ac addasol. Gwna'n siŵr dy fod yn siarad pan fydd rhywbeth yn bwysig i ti — gall bod yn ‘hawdd’ dy adael yn chwerw."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem at have med at gøre og omstillingsparat. Sørg bare for at sige fra, når noget betyder noget for dig – at være »nem« kan ende med at gøre dig bitter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unkompliziert und anpassungsfähig. Sag aber wirklich etwas, wenn dir etwas wichtig ist – wer immer „easy“ ist, staut leicht Groll an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς απαιτήσεις και με προσαρμοστικότητα. Απλώς φρόντισε να μιλάς όταν κάτι μετράει για σένα — το να συμφωνείς με όλα μπορεί να σου αφήσει πίκρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te adaptas sin complicaciones. Solo asegúrate de hablar cuando algo te importa de verdad: ceder siempre puede acabar generando resentimiento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähenõudlik ja kohanemisvõimeline. Vaata vaid, et sa päriselt sõna võtaksid, kui miski on sulle oluline — „lihtne olemine“ võib jätta su solvunuks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erraza eta moldakorra. Ziurtatu, hala ere, ahotsa altxatzen duzula zerbait garrantzitsua denean — beti «edozer ondo» esateak erresumina utz diezazuke."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بی‌دردسر و منعطفی. فقط مطمئن شو وقتی چیزی برایت مهم است واقعاً حرفت را می‌زنی — «راحت بودن» می‌تواند دلخورت کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaivaton ja sopeutuvainen. Muista kuitenkin sanoa ääneen, kun jokin on sinulle tärkeää – jatkuva myötäily voi jättää sinut katkeraksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madaling kasama at madaling umangkop. Siguraduhin lang na nagsasalita ka kapag may mahalaga sa’yo — puwedeng mauwi sa sama ng loob ang pagiging “madali”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facile à vivre et adaptable. Veille juste à vraiment t'exprimer quand quelque chose compte pour toi : toujours dire « comme tu veux » peut finir par te laisser de la rancœur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réchúiseach agus inoiriúnaithe. Bí cinnte go labhraíonn tú amach nuair is tábhachtach rud duit — má bhíonn tú “réchúiseach” i gcónaí, d'fhéadfadh doicheall a theacht ort."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptable e sen complicacións. Só asegúrate de falar cando algo che importe: deixarse levar sempre pode acabar xerando resentimento."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સહેલાઈથી અનુકૂળ થઈ જાઓ છો. બસ કોઈ વાત તમારા માટે મહત્ત્વની હોય ત્યારે ખરેખર બોલજો — હંમેશાં “બધું ચાલે” કહેવાથી મનમાં કડવાશ રહી શકે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba ku da wahala kuma kuna daidaitawa. Ku dai tabbatar kuna magana idan wani abu na da muhimmanci a gare ku — zama “mara wahala” na iya bar ku da ɓacin rai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלילות וגמישות. רק כדאי באמת להשמיע את הקול כשמשהו חשוב לך — לזרום עם הכול עלול להשאיר אצלך טינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आसान और ढल जाने वाले। बस ध्यान रखें कि जब कोई बात आपके लिए मायने रखे, तो आप सच में बोलें — हमेशा “कोई दिक़्क़त नहीं” कहना मन में नाराज़गी छोड़ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezahtjevno i prilagodljivo. Samo pazi da se stvarno oglasiš kad ti je nešto važno – stav „sve mi paše” može ostaviti gorak okus."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasil e ou adapte w. Jis asire ou pale vre lè yon bagay enpòtan pou ou — lè ou toujou “fasil”, ou ka fini ak rankin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Könnyen alkalmazkodsz, és nem vagy nehéz eset. Csak szólalj meg, ha valami fontos neked – a „nekem minden jó” hozzáállásból könnyen sérelem lesz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անպահանջ ու հարմարվող։ Պարզապես հետևիր, որ իսկապես խոսես, երբ ինչ-որ բան քեզ համար կարևոր է — միշտ «հեշտ» լինելը կարող է դժգոհություն կուտակել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak ribet dan mudah beradaptasi. Pastikan saja kamu tetap bersuara saat ada yang penting bagimu — terlalu “ikut saja” bisa bikin kamu memendam kesal."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ dị mfe ime gị obi ụtọ, ị na-agbanwekwa. Naanị hụ na ị na-ekwu okwu mgbe ihe dị gị mkpa — ịbụ onye “ihe niile dị mma” nwere ike ime ka iwe na-ebuli n'obi gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lítið vesen og mikil aðlögunarhæfni. Passaðu bara að láta í þér heyra þegar eitthvað skiptir þig máli – að vera alltaf til í allt getur skilið eftir gremju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti accontenti facilmente e ti adatti. Assicurati solo di farti sentire quando qualcosa conta per te — adattarti sempre può lasciarti del risentimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手がかからず、順応性のあるタイプです。ただ、大事なことはちゃんと口に出しましょう。「何でもいい」が続くと、不満がたまることもあります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora rewel lan gampang nyetel. Mung priksa panjenengan tetep ngomong yen ana bab sing wigati kanggo panjenengan — kakehan “manut” bisa nuwuhake rasa gela."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უპრეტენზიო და მოქნილი. უბრალოდ, აუცილებლად თქვი, როცა რამე მნიშვნელოვანია შენთვის — „ადვილობამ“ შეიძლება წყენა დაგიგროვოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қарапайым әрі бейімделгішсің. Тек саған бір нәрсе маңызды болғанда, міндетті түрде айт — «бәрібір» бола берсең, ішіңде өкпе жиналуы мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ងាយស្រួល និងចេះសម្របខ្លួន។ គ្រាន់តែប្រាកដថាអ្នកនិយាយចេញ ពេលមានអ្វីសំខាន់សម្រាប់អ្នក — ការ “អ្វីក៏បាន” អាចធ្វើឲ្យអ្នកអាក់អន់ចិត្តនៅពេលក្រោយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತಕರಾರಿಲ್ಲದ, ಹೊಂದಿಕೊಳ್ಳುವ ಸ್ವಭಾವ. ನಿಮಗೆ ಏನಾದರೂ ಮುಖ್ಯವಾದಾಗ ಖಂಡಿತ ಹೇಳಿ — ಯಾವಾಗಲೂ “ಏನಾದರೂ ಸರಿ” ಎನ್ನುವುದು ಒಳಗೊಳಗೇ ಅಸಮಾಧಾನ ತರಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무던하고 잘 맞춰 줘요. 다만 정말 중요한 게 있을 땐 꼭 말해 주세요. 늘 ‘다 좋아’라고 하다 보면 서운함이 쌓일 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bê daxwaz û guncav. Tenê bawer be ku dema tiştek ji te re girîng e tu bi rastî dengê xwe bilind dikî — “rehet” bûn dikare kînê di dilê te de bihêle."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жеңил жана ыңгайлашкыч. Болгону сен үчүн бир нерсе маанилүү болгондо, чын эле айт — «баарына макул» болуу кийин нааразылыкка алып келиши мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onkomplizéiert an upassungsfäeg. Pass just op, datt s du och eppes sees, wann dir eppes wichteg ass — ëmmer „onkomplizéiert“ ze sinn, kann dech mat der Zäit frustréieren."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ມັກງ່າຍ ແລະ ປັບຕົວໄດ້ ພຽງແຕ່ໃຫ້ແນ່ໃຈວ່າເຈົ້າເວົ້າອອກມາເມື່ອມີເລື່ອງທີ່ສຳຄັນກັບເຈົ້າ — ການເປັນຄົນ ‘ແນວໃດກໍໄດ້’ ອາດເຮັດໃຫ້ເຈົ້າຄ້ຽດໃຈພາຍຫຼັງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nereiklu ir lanksčiai. Tik pasirūpink, kad pasakytum, kai kas nors tau svarbu, – nuolatinis „man tinka viskas“ gali baigtis nuoskaudomis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepretenciozi un elastīgi. Tikai pārliecinies, ka tiešām ierunājies, kad kaut kas tev ir svarīgs, – ja vienmēr piekāpies, var sakrāties aizvainojums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mora arahina sy mahay mifanaraka ianao. Ataovy fotsiny izay hitenenanao rehefa misy zavatra manan-danja aminao — mety hamela lolom-po ao aminao ny maha-“mora” anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ngāwari, he urutau. Kia kōrero noa koe ina nui tētahi mea ki a koe — mā te “ngāwari” tonu ka riri puku pea koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непретенциозно и прилагодливо. Само погрижи се навистина да проговориш кога нешто ти е важно — да ти е „сеедно“ може да остави горчина."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിർബന്ധങ്ങളില്ലാത്ത, ഇണങ്ങിപ്പോകുന്ന രീതി. നിങ്ങൾക്ക് പ്രധാനപ്പെട്ട ഒരു കാര്യമുള്ളപ്പോൾ അത് തുറന്നുപറയുന്നുണ്ടെന്ന് മാത്രം ഉറപ്പാക്കൂ — എപ്പോഴും “എന്തും ഓക്കെ” ആയിരിക്കുന്നത് ഉള്ളിൽ നീരസം ബാക്കിയാക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэрэгцээ багатай, дасан зохицдог. Ямар нэг юм чамд чухал үед дуугараарай — «сонголтгүй» байх нь дотор чинь гомдол үлдээж болно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहज समाधानी आणि जुळवून घेणारे. फक्त एखादी गोष्ट तुमच्यासाठी महत्त्वाची असेल तेव्हा नक्की बोला — नेहमी “काहीही चालेल” म्हटल्याने मनात कटुता राहू शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudah dilayan dan pandai menyesuaikan diri. Cuma pastikan anda bersuara apabila sesuatu penting bagi anda — terlalu ‘ikut sahaja’ boleh membuatkan anda terkilan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faċli u tadatta ruħek. Biss kun żgur li titkellem meta xi ħaġa tkun importanti għalik — li dejjem tgħid “kollox jgħaddi” jista' jħallik bir-riżentiment."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လိုက်လျောလွယ်ပြီး ဆက်ဆံရလွယ်တယ်။ ကိုယ့်အတွက် အရေးကြီးတဲ့အခါ တကယ် ပြောထွက်ဖို့တော့ သေချာပါစေ — အမြဲ “အဆင်ပြေတယ်” ဆိုနေရင် နောက်ပိုင်း နာကြည်းစိတ် ဖြစ်လာနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite krevende og tilpasningsdyktig. Bare pass på at du faktisk sier fra når noe betyr noe for deg – å alltid være «grei» kan gjøre deg bitter."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहज र अनुकूल। बस, तपाईंलाई कुनै कुरा महत्त्वपूर्ण लाग्दा बोल्नुहोस् — सधैँ ‘सहज’ हुँदा मनमा गुनासो थुप्रिन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makkelijk en flexibel. Zorg wel dat je echt iets zegt als iets belangrijk voor je is – altijd ‘makkelijk’ zijn kan wrok opleveren."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wosavuta ndi wosinthasintha. Ingotsimikizirani kuti mumalankhula chinthu chikakhala chofunika kwa inu — kukhala “womasuka” nthawi zonse kungakusiyeni ndi mkwiyo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fedhii salphaa fi kan haala wajjin walsimu. Garuu yeroo wanti siif barbaachisu jiru dhugumaan dubbachuu kee mirkaneeffadhu — “salphaa” ta'uun aarii keessatti si hambisuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସହଜ ଓ ଖାପଖୁଆଇ ଚଳନ୍ତି। କେବଳ ନିଶ୍ଚିତ କରନ୍ତୁ, କିଛି ଜରୁରି ଲାଗିଲେ ଆପଣ ସତରେ କୁହନ୍ତି — ସବୁବେଳେ ‘ସହଜ’ ରହିଲେ ମନରେ ଅଭିମାନ ଜମିପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬੇਨਖ਼ਰਾ ਅਤੇ ਢਲ ਜਾਣ ਵਾਲਾ ਸੁਭਾਅ। ਬੱਸ ਪੱਕਾ ਕਰੋ ਕਿ ਜਦੋਂ ਕੋਈ ਗੱਲ ਤੁਹਾਡੇ ਲਈ ਅਹਿਮ ਹੋਵੇ ਤਾਂ ਤੁਸੀਂ ਬੋਲੋ — ਹਰ ਗੱਲ “ਮਨਜ਼ੂਰ” ਕਰਦੇ ਰਹਿਣ ਨਾਲ ਮਨ ਵਿੱਚ ਨਾਰਾਜ਼ਗੀ ਰਹਿ ਸਕਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezproblemowo i elastycznie. Pamiętaj tylko, by odezwać się, gdy coś jest dla ciebie ważne – ciągłe ustępowanie może zostawić w tobie żal."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسانه او د برابرېدو وړ. یوازې ډاډ ترلاسه کړئ چې کله یو څه ستاسو لپاره مهم وي، په رښتیا یې ووایئ — «هر څه راته سم دي» ویل کولی شي په زړه کې خپګان راټول کړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranquilidade e adaptação. Só garanta que você fale quando algo importa — ser a pessoa que “topa tudo” pode acabar gerando ressentimento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descontração e capacidade de adaptação. Só garante que falas mesmo quando algo te importa — alinhar sempre pode acabar em ressentimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ești ușor de mulțumit și te adaptezi. Ai grijă doar să vorbești când ceva contează pentru tine — să tot cedezi poate lăsa în urmă resentimente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неприхотливо и гибко. Только не молчи, когда для тебя что-то важно: привычка со всем соглашаться может обернуться обидой."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntusaba byinshi kandi wihuza n'ibihe. Gusa reba ko uvuga koko iyo hari ikintu gifite agaciro kuri wowe — kuba “udasaba byinshi” bishobora kugusigira inzika."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "තෘප්තිමත් කරන්න ලේසියි, හැඩගැසෙනවා. ඔබට වැදගත් දෙයක් ආවම ඇත්තටම කතා කරනවාද කියලා විතරක් බලන්න — නිතරම “කමක් නැහැ” කියන එක ඔබ තුළ අමනාපයක් ඇති කරන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenáročné a prispôsobivé. Len sa naozaj ozvi, keď ti na niečom záleží – ustupovať stále môže v tebe nechať krivdu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezahtevno in prilagodljivo. Le poskrbi, da spregovoriš, ko ti je kaj zares pomembno – večno popuščanje lahko pusti grenak priokus."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haunetsi uye unochinjika. Ingova nechokwadi chekuti unotaura kana chimwe chinhu chichikosha kwauri — kuva munhu “asinganetsi” kunogona kukusiya une shungu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fudud oo la qabsada. Kaliya hubi inaad dhab ahaan hadasho marka wax kuu muhiim yihiin — “fududaan” ayaa ku dhaafi karta xanaaq."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa kërkesa dhe me aftësi përshtatjeje. Thjesht sigurohu që e thua kur diçka ka rëndësi për ty – të jesh gjithmonë „në rregull me gjithçka“ mund të të lërë me mëri."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без компликација и прилагодљиво. Само пази да се стварно огласиш кад ти је нешто важно — кад си стално „свеједно“, лако се накупи кивност."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teu ngarépotkeun sareng gampil nyaluyukeun. Pastikeun waé anjeun leres-leres nyarios nalika aya hal anu penting pikeun anjeun — janten “gampil” tiasa ngajantenkeun anjeun kesel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okomplicerad och anpassningsbar. Se bara till att du faktiskt säger till när något är viktigt för dig – att alltid ”hänga med” kan leda till bitterhet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiye na masharti mengi na unayebadilika. Hakikisha tu unasema jambo linapokuwa muhimu kwako — kuwa “usiye na shida” kunaweza kukuachia kinyongo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எளிதில் திருப்தியடைபவர், எதற்கும் பொருந்திக்கொள்பவர். உங்களுக்கு ஏதாவது முக்கியமாக இருக்கும்போது வாய் திறந்து சொல்கிறீர்களா என்பதை மட்டும் உறுதிசெய்யுங்கள் — “எல்லாம் சரி” என்று இருப்பது மனக்கசப்பில் முடியலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తేలికగా, సర్దుకుపోయేలా. మీకు ఏదైనా ముఖ్యమైనప్పుడు మాత్రం తప్పక చెప్పండి — “ఏదైనా ఓకే” అంటూ ఉంటే లోపల అసంతృప్తి పేరుకుపోవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бедардисар ва мутобиқшаванда. Танҳо бубин, ки вақте чизе барои ту муҳим аст, воқеан онро бигӯӣ — «бедардисар» будан метавонад туро ранҷида гузорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอาใจง่ายและปรับตัวเก่ง แค่อย่าลืมพูดออกมาเมื่อมีอะไรสำคัญกับคุณ การเป็นคน “ไปได้หมด” อาจทำให้คุณเก็บความขุ่นเคืองไว้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀሊልን ተላማድን። ጥራይ ኣገዳሲ ነገር ምስ ዝህሉ ብሓቂ ከም እትዛረቡ ኣረጋግጹ — «ቀሊል» ምዃን ቂም ክገድፈልኩም ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aladasyz we uýgunlaşýan. Diňe bir zat seniň üçin möhüm bolanda hökman aýt — elmydama “razy” bolmak içiňde göwnüçökgünlik galdyryp biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahmetsiz ve uyumlusun. Sadece bir şey senin için önemli olduğunda gerçekten sesini çıkardığından emin ol; hep “bana uyar” demek içinde kırgınlık bırakabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невибагливо й гнучко. Лише не забувай говорити, коли щось для тебе важливо, — бо через «мені все підходить» може накопичуватися образа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آسان مزاج اور لچک دار۔ بس جب کوئی بات آپ کے لیے اہم ہو تو ضرور بولیں — ہمیشہ “سب چلتا ہے” کہنا دل میں رنجش چھوڑ سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
