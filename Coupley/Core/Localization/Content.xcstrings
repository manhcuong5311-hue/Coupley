        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি সম্পৰ্কটোক এটা যৌথ প্ৰকল্প হিচাপে চায়। ডাঙৰ সিদ্ধান্তবোৰত দুয়োজন জড়িত থাকে — আৰু আপুনি সেয়াই বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münasibəti ortaq layihə kimi görürsən. Böyük qərarlarda ikiniz də iştirak edirsiniz — və sən elə bunu istəyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цябе адносіны — агульны праект. Важныя рашэнні вы прымаеце ўдвух — і так табе падабаецца."
          }
