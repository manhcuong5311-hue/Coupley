        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කිසිවක් ඉල්ලන්නේ නැති දෙයක් එකට කරන්න — උයන්න, රෙදි නවන්න, චිත්‍ර අඳින්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robte spolu niečo nenáročné – varte, skladajte prádlo, kreslite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naredita skupaj nekaj, kar ne zahteva ničesar – kuhajta, zložita perilo, rišita."
