    "Sad + not drained often wants to be heard, not managed." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartseer maar nie uitgeput nie wil dikwels gehoor word, nie bestuur word nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሀዘን + ያልተሟጠጠ ጉልበት ብዙ ጊዜ መደመጥን እንጂ መመራትን አይፈልግም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزن مع طاقة باقية غالبًا يريد أن يُسمَع، لا أن يُدار."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুখী কিন্তু নিঃশেষ নোহোৱা মানুহে প্ৰায়ে শুনা যোৱাটো বিচাৰে, চম্ভালি দিয়াটো নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kədərli, amma yorğun olmayan biri çox vaxt idarə olunmaq yox, eşidilmək istəyir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі сумна, але сілы ёсць, часта хочацца, каб пачулі, а не кіравалі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тъга без изтощение често иска да бъде чута, а не управлявана."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মন খারাপ কিন্তু ক্লান্ত নয়, এমন সময় মানুষ প্রায়ই শুনতে পাওয়া চায়, সামলানো নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuga bez iscrpljenosti često želi da bude saslušana, a ne vođena."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tristesa sense esgotament sovint vol ser escoltada, no gestionada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smutek bez vyčerpání často chce být vyslyšen, ne řízen."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae trist + heb flino yn aml eisiau clust, nid rheolwr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når man er trist, men ikke drænet, vil man ofte høres, ikke håndteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traurig, aber nicht erschöpft heißt oft: gehört werden wollen, nicht gemanagt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν υπάρχει λύπη αλλά όχι εξάντληση, ο άλλος συνήθως θέλει να τον ακούσουν, όχι να τον διαχειριστούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hay tristeza pero no agotamiento, lo que suele hacer falta es que alguien escuche, no que lo gestione todo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurb, aga mitte kurnatud tahab sageli olla ära kuulatud, mitte juhitud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triste baina ez agortuta dagoenak askotan entzuna izan nahi du, ez kudeatua."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غمگین ولی نه خسته، اغلب می‌خواهد شنیده شود، نه مدیریت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surullinen mutta ei uupunut haluaa usein tulla kuulluksi, ei hoidetuksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag malungkot pero may lakas pa, kadalasan gusto niyang marinig, hindi asikasuhin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triste mais pas à plat, on a souvent besoin d'une oreille, pas d'un plan d'action."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brónach ach gan a bheith traochta: is minic a theastaíonn éisteacht, ní bainistíocht."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cando hai tristeza pero quedan forzas, adoita querer ser escoitada, non xestionada."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉદાસ હોય પણ થાકેલા ન હોય ત્યારે ઘણી વાર બસ સાંભળનાર જોઈએ, સંભાળનાર નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baƙin ciki ba tare da gajiya ba galibi na son a ji shi, ba a sarrafa shi ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצב בלי תשישות בדרך כלל רוצה הקשבה, לא ניהול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदासी हो पर थकान न हो, तो अक्सर सुने जाने की चाह होती है, संभाले जाने की नहीं।"
