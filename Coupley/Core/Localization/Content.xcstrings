    "Value-driven. You want a good bed and a good meal without feeling reckless. That's most people's sweet spot." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waardegedrewe. Jy wil ’n goeie bed en ’n goeie ete sonder om roekeloos te voel. Dis vir die meeste mense die soet plekkie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዋጋ ላይ ያተኮረ። ግድየለሽነት ሳይሰማዎት ጥሩ አልጋና ጥሩ ምግብ ይፈልጋሉ። ይህ የአብዛኞቹ ሰዎች ተስማሚ ነጥብ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبحثون عن القيمة. تريدون سريرًا جيدًا ووجبة جيدة دون شعور بالتهور. هذا هو التوازن المثالي لمعظم الناس."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মূল্যমুখী। দায়িত্বহীন যেন নালাগাকৈ আপুনি এখন ভাল বিছনা আৰু এসাঁজ ভাল আহাৰ বিচাৰে। বেছিভাগ মানুহৰ বাবে এয়াই উপযুক্ত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dəyərə baxırsan. Ehtiyatsızlıq etmədən yaxşı yataq və yaxşı yemək istəyirsən. Çoxlarının ideal nöqtəsi də budur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе важна, каб цана адпавядала якасці: добры ложак і смачная ежа без пачуцця, што грошы пушчаныя на вецер. Для большасці гэта ідэал."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсиш стойност. Искаш хубаво легло и хубава храна, без да прахосваш. Това е златната среда за повечето хора."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দামের হিসেব বোঝো। বেপরোয়া না হয়েই তুমি ভালো একটা বিছানা আর ভালো খাবার চাও। বেশিরভাগ মানুষের কাছে এটাই আদর্শ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodi te vrijednost za novac. Želiš dobar krevet i dobar obrok, bez osjećaja rasipništva. To je idealna mjera za većinu ljudi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busques una bona relació qualitat-preu. Vols un bon llit i un bon àpat sense sentir que t'has passat. És el punt ideal de gairebé tothom."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš, aby to za ty peníze stálo. Dobrou postel a dobré jídlo bez pocitu, že rozhazuješ. Pro většinu lidí ideál."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwerth am arian. Rwyt ti eisiau gwely da a phryd da heb deimlo'n fyrbwyll. Dyna'r man perffaith i'r rhan fwyaf o bobl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du går efter værdi. Du vil have en god seng og et godt måltid uden at føle dig uansvarlig. Det er det, de fleste har det bedst med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preis-Leistung zählt. Du willst ein gutes Bett und gutes Essen, ohne leichtsinnig zu sein. Für die meisten genau das Richtige."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιτάς τη σχέση ποιότητας–τιμής. Θέλεις ένα καλό κρεβάτι κι ένα καλό γεύμα χωρίς να νιώθεις ότι το παρακάνεις. Αυτή είναι η χρυσή τομή για τους περισσότερους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscas la mejor relación calidad-precio. Quieres una buena cama y una buena comida sin sentir que te pasas. Es el punto ideal para la mayoría."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väärtusele keskendunud. Tahad head voodit ja head sööki, ilma et tunneksid end pillajana. See on enamiku inimeste kuldne kesktee."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balioari begira. Ohe on bat eta otordu on bat nahi dituzu, zentzugabekeriarik egin gabe. Hori da jende gehienaren orekagunea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دنبال ارزش در برابر هزینه‌ای. یک تخت خوب و یک غذای خوب می‌خواهی، بی‌آنکه حس ولخرجی کنی. نقطهٔ ایده‌آل بیشتر آدم‌ها همین است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastinetta rahalle. Haluat hyvän sängyn ja hyvän aterian tuntematta itseäsi holtittomaksi. Se on useimpien sopiva keskikohta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulit ang hanap mo. Gusto mo ng magandang kama at masarap na pagkain nang hindi parang waldas. Iyan ang sweet spot ng karamihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bon rapport qualité-prix. Tu veux un bon lit et un bon repas sans faire de folies. C'est le juste milieu pour la plupart des gens."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dírithe ar luach. Teastaíonn leaba mhaith agus béile maith uait gan mothú meargánta. Is é sin an pointe foirfe ag formhór na ndaoine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscas o equilibrio calidade-prezo. Queres unha boa cama e unha boa comida sen sentir que te pasas. É o punto doce da maioría da xente."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કિંમતનું વળતર જોનારા. બેફામ ખર્ચ કર્યા વગર તમને સારી પથારી અને સારું ભોજન જોઈએ. મોટા ભાગના લોકો માટે આ જ યોગ્ય સંતુલન છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna duba darajar kuɗi. Kuna son gado mai kyau da abinci mai kyau ba tare da jin kun yi ɓarna ba. A nan ne yawancin mutane suka fi jin daɗi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמורה למחיר. מיטה טובה וארוחה טובה, בלי תחושה של בזבוז. זו נקודת האיזון של רוב האנשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैसे की पूरी वसूली। आपको अच्छा बिस्तर और अच्छा खाना चाहिए, बिना लापरवाह ख़र्च के एहसास के। ज़्यादातर लोगों के लिए यही सही संतुलन है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Važna ti je vrijednost za novac. Želiš dobar krevet i dobar obrok bez osjećaja rastrošnosti. To je zlatna sredina za većinu ljudi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou chèche bon valè. Ou vle yon bon kabann ak yon bon repa san ou pa santi ou ap gaspiye. Se kote pifò moun santi yo byen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ár-érték arány vezet. Jó ágyat és jó ételt szeretnél anélkül, hogy felelőtlennek éreznéd magad. A legtöbb embernek ez az ideális."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գնի և որակի հավասարակշռություն։ Ուզում ես լավ անկողին ու լավ ճաշ՝ առանց անխոհեմ ծախսի զգացման։ Մարդկանց մեծ մասի համար սա է ոսկե միջինը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang penting sepadan. Kamu ingin kasur yang enak dan makanan yang lezat tanpa merasa boros. Itu titik pas bagi kebanyakan orang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ele uru anya. Ị chọrọ ezigbo akwa na ezigbo nri n'emefughị ego n'efu. Nke ahụ bụ ebe ọtụtụ mmadụ kacha nọrọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verðmætamiðuð nálgun. Þú vilt gott rúm og góðan mat án þess að fara óvarlega með peningana. Þar liggur gullni meðalvegurinn hjá flestum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardi al rapporto qualità-prezzo. Vuoi un buon letto e un buon pasto senza sentirti in colpa per la spesa. È la via di mezzo ideale per molti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コスパ重視のタイプです。無茶はせずに、いいベッドとおいしい食事を楽しみたい。多くの人にとってのちょうどいいところです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikir regane. Panjenengan pengin kasur sing kepenak lan panganan sing enak tanpa rumangsa boros. Kuwi titik pas kanggo akeh wong."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ფასისა და ხარისხის ბალანსი. გინდა კარგი საწოლი და კარგი საჭმელი, ზედმეტი ფლანგვის გარეშე. ადამიანების უმეტესობისთვის ეს ოქროს შუალედია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құнына қарайсың. Ысырап етпей-ақ жақсы төсек пен жақсы тамақ қалайсың. Көп адам үшін дәл осы — алтын орта."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ដោតលើតម្លៃសមរម្យ។ អ្នកចង់បានគ្រែល្អ និងអាហារឆ្ងាញ់ ដោយមិនមានអារម្មណ៍ថាចាយខ្ជះខ្ជាយ។ នោះជាចំណុចល្មមរបស់មនុស្សភាគច្រើន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೌಲ್ಯವೇ ಮುಖ್ಯ. ದುಂದುವೆಚ್ಚದ ಭಾವವಿಲ್ಲದೆ ಒಳ್ಳೆಯ ಹಾಸಿಗೆ ಮತ್ತು ಒಳ್ಳೆಯ ಊಟ ಬೇಕು ನಿಮಗೆ. ಹೆಚ್ಚಿನವರಿಗೆ ಇದೇ ಸರಿಯಾದ ಜಾಗ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가성비를 따져요. 무리하지 않으면서 좋은 잠자리와 맛있는 식사를 원하죠. 대부분의 사람에게 딱 좋은 지점이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li gorî nirxê. Tu nivîneke baş û xwarineke baş dixwazî bêyî ku xwe bêhesab hîs bikî. Ev ji bo piraniya mirovan xala îdeal e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баалуулукка багытталган. Ысырапкорлук сезимисиз жакшы төшөк жана жакшы тамак каалайсың. Көпчүлүк үчүн эң ыңгайлуу чекит ушул."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kucks op dat, wat et wäert ass. Du wëlls e gutt Bett an e gutt Iessen, ouni dech leichtsinneg ze fillen. Dat ass fir déi meescht Leit dat richtegt Mooss."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເນັ້ນຄວາມຄຸ້ມຄ່າ ເຈົ້າຢາກໄດ້ບ່ອນນອນດີໆ ແລະ ອາຫານແຊບໆ ໂດຍບໍ່ຮູ້ສຶກວ່າຈ່າຍສຸ່ຍສຸ່ມ ນັ້ນຄືຈຸດພໍດີຂອງຄົນສ່ວນໃຫຍ່"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarbiausia vertė. Nori geros lovos ir gero maisto, bet be jausmo, kad švaistai. Tai daugumos aukso vidurys."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu meklē labu cenas un kvalitātes attiecību. Gribi labu gultu un labu maltīti, nejūtot, ka tērē bezatbildīgi. Tas ir vairumam cilvēku ideālais variants."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitady ny mendrika ny vola ianao. Fandriana tsara sy sakafo tsara no tadiavinao nefa tsy mahatsapa ho mandany foana. Izany no mety indrindra amin'ny ankamaroan'ny olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka aro koe ki te uara. E hiahia ana koe ki te moenga pai me te kai pai me te kore e rongo kua pōhēhē te whakapau. Koinā te wāhi reka mō te nuinga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Водено од вредноста. Сакаш добар кревет и добар оброк без чувство на непромисленост. Тоа е идеалната мерка за повеќето луѓе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മൂല്യത്തിനാണ് പ്രാധാന്യം. അമിതമായി ചെലവാക്കുന്നു എന്ന തോന്നലില്ലാതെ നല്ലൊരു കിടക്കയും നല്ല ഭക്ഷണവുമാണ് നിങ്ങൾക്ക് വേണ്ടത്. മിക്കവർക്കും ഏറ്റവും ചേരുന്നത് ഇതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үнэ цэнэд чиглэсэн. Чи хэт үрэлгэн биш, сайн ор, сайн хоол хүсдэг. Ихэнх хүний хамгийн тохиромжтой цэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैशाचे मोल जाणणारे. बेफिकीर वाटणार नाही अशा प्रकारे चांगला बिछाना आणि चांगले जेवण हवे. बहुतेकांसाठी हाच योग्य मध्य."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mementingkan nilai. Anda mahukan katil yang selesa dan makanan yang sedap tanpa rasa boros. Itulah titik selesa kebanyakan orang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-valur jiġi l-ewwel. Trid sodda tajba u ikla tajba mingħajr ma tħoss li qed tonfoq bla rażan. Dak il-punt ideali għal ħafna nies."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "တန်ဖိုးကို ကြည့်တယ်။ အလွန်အကျွံ မသုံးဘဲ အိပ်ရာကောင်းကောင်းနဲ့ အစားကောင်းကောင်း လိုချင်တယ်။ ဒါက လူအများစုရဲ့ အကိုက်ညီဆုံး အမှတ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdibevisst. Du vil ha en god seng og et godt måltid uten å føle deg uansvarlig. Det er gullsonen for de fleste."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल्यमा केन्द्रित। लापरबाह नभई राम्रो ओछ्यान र राम्रो खाना चाहनुहुन्छ। धेरैजसो मान्छेलाई यही सबैभन्दा उपयुक्त लाग्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij let op waar voor je geld. Je wilt een goed bed en een goede maaltijd zonder roekeloos te zijn. Voor de meeste mensen is dat precies goed."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumayang'ana phindu. Mumafuna bedi labwino ndi chakudya chabwino popanda kumva ngati mukuwononga. Ndi pomwe anthu ambiri amakonda."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatii irratti kan xiyyeeffate. Siree gaarii fi nyaata gaarii osoo of hin balleessin barbaadda. Kun iddoo namoota baay'ee itti tolu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୂଲ୍ୟ ଦେଖି ଚଳନ୍ତି। ବେପରୁଆ ନ ହୋଇ ଭଲ ବିଛଣା ଓ ଭଲ ଖାଦ୍ୟ ଚାହାଁନ୍ତି। ଅଧିକାଂଶ ଲୋକଙ୍କ ପାଇଁ ଏହା ଠିକ୍ ମଝି ବାଟ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੈਸੇ ਦਾ ਪੂਰਾ ਮੁੱਲ। ਤੁਸੀਂ ਬਿਨਾਂ ਫ਼ਜ਼ੂਲਖ਼ਰਚੀ ਦੇ ਵਧੀਆ ਬਿਸਤਰਾ ਅਤੇ ਵਧੀਆ ਖਾਣਾ ਚਾਹੁੰਦੇ ਹੋ। ਜ਼ਿਆਦਾਤਰ ਲੋਕਾਂ ਲਈ ਇਹੀ ਸਹੀ ਸੰਤੁਲਨ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się dla ciebie stosunek jakości do ceny. Chcesz dobrego łóżka i dobrego jedzenia bez szaleństwa. To złoty środek dla większości osób."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د ارزښت پر بنسټ. تاسو ښه بستر او ښه خواړه غواړئ، پرته له دې چې د بې‌پروايۍ احساس وکړئ. دا د ډېرو خلکو لپاره غوره منځنۍ لاره ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custo-benefício é o que guia você. Você quer uma boa cama e uma boa refeição sem cometer loucuras. É o ponto ideal para a maioria das pessoas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guias-te pela relação qualidade-preço. Queres uma boa cama e uma boa refeição sem loucuras. É o ponto ideal para a maioria das pessoas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ghidezi după raportul calitate-preț. Vrei un pat bun și o masă bună fără să simți că exagerezi. E echilibrul ideal pentru cei mai mulți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты ценишь соотношение цены и качества. Хочется хорошую кровать и вкусную еду, но без лишнего транжирства. Золотая середина для большинства."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ureba agaciro. Ushaka uburiri bwiza n'ifunguro ryiza utumva ko wasesaguye. Aho ni ho abantu benshi bumva bameze neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වටිනාකම මත පදනම්ව. නොසැලකිලිමත් බවක් නොදැනී හොඳ ඇඳකුත් හොඳ කෑමකුත් ඔබට ඕනේ. බොහෝ දෙනාට හොඳම සමබරතාව ඒකයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ide ti o pomer ceny a kvality. Chceš dobrú posteľ a dobré jedlo bez pocitu, že to preháňaš. Pre väčšinu ľudí ideálny stred."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šteje ti vrednost. Želiš dobro posteljo in dober obrok, brez občutka lahkomiselnosti. To je za večino ljudi ravno prav."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotarisa kukosha kwemari. Unoda mubhedha wakanaka nechikafu chakanaka usinganzwi kuti wapambadza. Ndipo panofarira vanhu vazhinji."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qiimo ayaad eegtaa. Waxaad rabtaa sariir fiican iyo cunto fiican iyadoo aadan dareemin isku-dhiibid. Taasi waa meesha dadka badankood ugu fiican."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të udhëheq vlera. Do një shtrat të mirë dhe një vakt të mirë pa shpenzuar pa hesap. Kjo është pika e ëmbël për shumicën e njerëzve."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Водиш се добром вредношћу. Желиш добар кревет и добар оброк, а без осећаја расипања. То је за већину људи идеална мера."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngutamakeun ajén. Anjeun hoyong ranjang anu saé sareng tuangeun anu ngeunah tanpa ngaraos boros. Éta titik pas pikeun kalolobaan jalma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisvärt är ledordet. Du vill ha en bra säng och en god middag utan att känna dig slösaktig. Där trivs de flesta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaongozwa na thamani. Unataka kitanda kizuri na chakula kizuri bila kuhisi umetumia ovyo. Hapo ndipo watu wengi hupapenda."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மதிப்பையே பார்ப்பவர். பொறுப்பில்லாமல் செலவழிப்பதாக உணராமல், நல்ல படுக்கையும் நல்ல சாப்பாடும் வேண்டும். பெரும்பாலானோருக்கு இதுதான் சரியான அளவு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విలువకు ప్రాధాన్యం. దుబారా అనిపించకుండా మంచి మంచం, మంచి భోజనం కావాలి. చాలా మందికి సరిగ్గా సరిపోయేది ఇదే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба арзиш нигаронида. Ту ҷогаҳи хубу таоми хуб мехоҳӣ, бе ҳисси беэҳтиётӣ. Ин ҳамон тавозуни дилхоҳи аксари одамон аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เน้นความคุ้มค่า คุณอยากได้ที่นอนดีๆ และอาหารอร่อยโดยไม่รู้สึกว่าใช้เงินมือเติบ นี่คือจุดที่ลงตัวของคนส่วนใหญ่"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዋጋ ዝምራሕ። ብዘይ ብኽነት ጽቡቕ ዓራትን ጽቡቕ መግብን ትደልዩ። ንመብዛሕትኦም ሰባት እዚ እዩ ዝበለጸ ሚዛን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasyna görä. Saňa özüňi biperwaý duýman, gowy düşek we gowy nahar gerek. Adamlaryň köpüsi üçin iň amatly ýer şu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyat-performans odaklısın. Pervasızca harcamadan iyi bir yatak ve iyi bir yemek istiyorsun. Çoğu insan için ideal olan da bu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі важливе співвідношення ціни та якості. Хочеться гарного ліжка й смачної їжі без відчуття марнотратства. Саме так більшості людей і найкраще."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدر پر نظر۔ آپ کو اچھا بستر اور اچھا کھانا چاہیے، بغیر فضول خرچی کے احساس کے۔ زیادہ تر لوگوں کے لیے یہی بہترین توازن ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qiymatga eʼtibor. Isrofgarchilikka yoʻl qoʻymay, yaxshi toʻshak va mazali taom istaysiz. Koʻpchilik uchun eng maqbul variant."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coi trọng giá trị. Bạn muốn giường êm, bữa ngon mà không thấy hoang phí. Đó là điểm vừa vặn của đa số mọi người."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhangela ixabiso. Ufuna ibhedi entle nesidlo esimnandi ngaphandle kokuziva uchitha kakubi. Yindawo emnandi kubantu abaninzi leyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń wo iye tí nǹkan tọ́. Ẹ fẹ́ ibùsùn tó dára àti oúnjẹ tó dára láìjẹ́ pé ẹ ń ná owó nínàkúnàá. Ibi tí ọ̀pọ̀ ènìyàn fẹ́ràn jù nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講求物有所值。你想要好床和好菜，又不想花得太揮霍。這是大部分人的甜蜜點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注重性价比。你想要好床和好饭，又不想花得太冲动。这是大多数人的最佳区间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講求划算。你想要好床和好餐，但不想花得太衝動。這是大多數人的甜蜜點。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugxile enanini. Ufuna umbhede omuhle nokudla okumnandi ngaphandle kokuzizwa unganaki. Lokho yikho abantu abaningi abakuthandayo."
          }
        }
      }
    },
    "Vegan" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veganisties"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቪጋን"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظام نباتي صرف"
          }
        },
        "as" : {
