      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelbewus oor wat jy inneem. Jy weet vergelyking en geraas raak jou gemoed – en jy hanteer dit."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለሚያስገቡት ነገር ጥንቃቄ ያደርጋሉ። ራስን ከሌሎች ጋር ማወዳደርና ጫጫታ በአእምሮዎ ሁኔታ ላይ ተጽዕኖ እንደሚያሳድሩ ያውቃሉ — እናም ይቆጣጠሩታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقاء واعٍ لما تتلقاه. المقارنة والضجيج يؤثران في حالتك النفسية، والوعي بذلك يساعدك على إدارته."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি কি গ্ৰহণ কৰে সেই বিষয়ে সচেতন। তুলনা আৰু হুলস্থুলে আপোনাৰ মনত প্ৰভাৱ পেলায় বুলি আপুনি জানে — আৰু আপুনি সেয়া নিয়ন্ত্ৰণ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nəyi qəbul etdiyinə diqqət edirsən. Müqayisənin və səs-küyün ruh halına təsir etdiyini bilirsən — və bunu idarə edirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты свядома выбіраеш, што спажываць. Ты ведаеш, што параўнанні і інфармацыйны шум уплываюць на твой стан, — і трымаеш гэта пад кантролем."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съзнателно подбираш какво поемаш. Знаеш, че сравненията и шумът влияят на психиката ти – и го контролираш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কী দেখছ-শুনছ, তা নিয়ে তুমি সচেতন। তুমি জানো তুলনা আর হইচই তোমার মনের ওপর প্রভাব ফেলে — আর তুমি সেটা সামলাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažljivo biraš šta upijaš. Znaš da poređenje i buka utiču na tvoje stanje – i znaš to držati pod kontrolom."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tries bé què consumeixes. Saps que les comparacions i el soroll afecten el teu estat mental — i ho gestiones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlídáš si, co do sebe pouštíš. Víš, že srovnávání a šum ovlivňují tvoje rozpoložení – a umíš s tím pracovat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n ofalus beth rwyt ti'n ei amsugno. Rwyt ti'n gwybod bod cymharu a sŵn yn effeithio ar dy gyflwr meddwl — ac rwyt ti'n rheoli hynny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er bevidst om, hvad du fylder dig med. Du ved, at sammenligning og støj påvirker dit sind – og du styrer det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du achtest darauf, was du konsumierst. Du weißt, dass Vergleiche und Lärm deiner Psyche zusetzen – und steuerst dagegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσέχεις τι σε «τροφοδοτεί». Ξέρεις ότι η σύγκριση και ο θόρυβος επηρεάζουν την ψυχολογία σου — και το διαχειρίζεσαι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidas lo que consumes. Sabes que las comparaciones y el ruido afectan a tu estado mental — y lo gestionas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valid teadlikult, mida endasse lased. Tead, et võrdlemine ja müra mõjutavad su meeleolu — ja hoiad seda kontrolli all."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontu handiz aukeratzen duzu zer kontsumitu. Badakizu konparazioek eta zaratak zure egoera mentalean eragiten dutela, eta kudeatu egiten duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حواست هست چه چیزی وارد ذهنت می‌شود. می‌دانی مقایسه و شلوغی روی حالت اثر می‌گذارد — و مدیریتش می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitset tarkkaan, mitä otat vastaan. Tiedät, että vertailu ja hälinä vaikuttavat mieleesi – ja pidät sen kurissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maingat ka sa pumapasok sa isip mo. Alam mong apektado ng pagkukumpara at ingay ang mental state mo — at kinokontrol mo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fais attention à ce que tu consommes. Tu sais que la comparaison et le bruit pèsent sur ton moral — et tu gères."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aireach faoin méid a ligeann tú isteach. Tá a fhios agat go dtéann comparáid agus callán i bhfeidhm ar do mheon — agus déileálann tú leis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coidas o que consumes. Sabes que as comparacións e o ruído afectan ao teu estado mental, e xestiónalo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે શું જુઓ-સાંભળો છો એ વિશે સજાગ. તમે જાણો છો કે સરખામણી અને ઘોંઘાટ તમારા મન પર અસર કરે છે — અને તમે એને સંભાળો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna kula da abin da kuke karɓa. Kun san cewa kwatanta kai da wasu da hayaniya na shafar yanayin zuciyarku — kuma kuna sarrafa hakan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשומת לב למה שנכנס. ידוע לך שהשוואות ורעש משפיעים על המצב הנפשי שלך — ויש לך דרך לנהל את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप क्या देखें-सुनें, इस पर आपका ध्यान है। तुलना और शोर का मन पर असर पड़ता है — यह आपको पता है, और इसे संभालना भी आता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažljivo biraš što upijaš. Znaš da uspoređivanje i buka utječu na tvoje mentalno stanje – i to držiš pod kontrolom."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou fè atansyon ak sa w ap resevwa. Ou konnen konparezon ak bri afekte moral ou — e ou jere sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudatosan választod meg, mit engedsz be. Tudod, hogy az összehasonlítgatás és a zaj hat a lelkiállapotodra – és kezeled is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու գիտակցված ես ընտրում, թե ինչով «սնվել»։ Գիտես, որ համեմատություններն ու աղմուկն ազդում են քո հոգեվիճակի վրա, և կառավարում ես դա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sengaja memilih apa yang kamu konsumsi. Kamu tahu membandingkan diri dan kebisingan memengaruhi kondisi mentalmu — dan kamu mengelolanya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-akpachara anya n'ihe ị na-anabata. Ị maara na ntụnyere na mkpọtụ na-emetụta uche gị — ị na-achịkwakwa ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú velur meðvitað hvað þú tekur inn. Þú veist að samanburður og hávaði hafa áhrif á líðan þína – og þú heldur því í skefjum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli con cura cosa ti entra in testa. Sai che i confronti e il rumore influiscono sul tuo stato d’animo — e te ne occupi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り入れる情報を意識して選んでいます。比べることや雑音が心に影響すると知っていて、うまくコントロールしています。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sengaja milih apa sing mlebu ing pikiran. Panjenengan ngerti yen mbandhingake dhiri lan rame-rame iku ngaruhi kahanan batin — lan panjenengan bisa ngatur."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გააზრებულად ირჩევ, რას უშვებ შენამდე. იცი, რომ შედარება და ხმაური შენს მდგომარეობაზე მოქმედებს — და ამას აკონტროლებ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не көріп, не тұтынатыныңды саналы таңдайсың. Салыстыру мен ақпарат шуы көңіл-күйіңе әсер ететінін білесің және оны басқара аласың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកប្រុងប្រយ័ត្នចំពោះអ្វីដែលអ្នកទទួលយក។ អ្នកដឹងថាការប្រៀបធៀប និងព័ត៌មានរំខាន ប៉ះពាល់ដល់ស្ថានភាពផ្លូវចិត្តរបស់អ្នក — ហើយអ្នកគ្រប់គ្រងវាបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಏನನ್ನು ನೋಡುತ್ತೀರಿ, ಕೇಳುತ್ತೀರಿ ಎಂಬ ಬಗ್ಗೆ ನಿಮಗೆ ಎಚ್ಚರವಿದೆ. ಹೋಲಿಕೆ ಮತ್ತು ಗದ್ದಲ ನಿಮ್ಮ ಮನಸ್ಥಿತಿಯ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತವೆ ಎಂದು ನಿಮಗೆ ಗೊತ್ತು — ಮತ್ತು ನೀವು ಅದನ್ನು ನಿಭಾಯಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아들이는 것을 신중하게 골라요. 비교와 소음이 마음 상태에 영향을 준다는 걸 알고, 잘 조절해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bi hişmendî hildibijêrî ka çi dikeve jiyana te. Tu dizanî ku berhevkirin û qelebalix bandorê li rewşa te ya derûnî dikin — û tu wê birêve dibî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмнени окуп-көрөрүңдү аң-сезимдүү тандайсың. Салыштыруу жана ызы-чуу маанайыңа таасир этерин билесиң — жана аны башкарасың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du passt op, wat s de konsuméiers. Du weess, dass Vergläicher a Kaméidi op deng Psyche schloen — an du gees bewosst domat ëm."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເລືອກສິ່ງທີ່ຮັບເຂົ້າມາຢ່າງຕັ້ງໃຈ ເຈົ້າຮູ້ວ່າການປຽບທຽບ ແລະ ຄວາມວຸ່ນວາຍມີຜົນຕໍ່ສະພາບຈິດໃຈ — ແລະ ເຈົ້າກໍຈັດການມັນໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sąmoningai renkiesi, ką įsileidi. Žinai, kad lyginimasis ir triukšmas veikia tavo savijautą – ir tai valdai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apzināti izvēlies, ko sevī ielaist. Zini, ka salīdzināšana un troksnis ietekmē tavu prātu – un to kontrolē."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mifantina izay idirana ao an-tsainao ianao. Fantatrao fa misy fiantraikany amin'ny toe-tsainao ny fampitahana sy ny tabataba — ary fehezinao izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka āta whiriwhiri koe i ngā mea ka uru mai. E mōhio ana koe ka pā te whakatairite me te turituri ki tō hinengaro — ā, ka whakahaere koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свесно бираш што внесуваш во себе. Знаеш дека споредувањето и бучавата влијаат на твојата ментална состојба — и тоа го контролираш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മനസ്സിലേക്ക് എന്ത് കടത്തിവിടുന്നു എന്നതിൽ നിങ്ങൾ ശ്രദ്ധാലുവാണ്. താരതമ്യവും ബഹളവും മനസ്സിനെ ബാധിക്കുമെന്ന് നിങ്ങൾക്കറിയാം — നിങ്ങൾ അത് നിയന്ത്രിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Юу хүлээн авахдаа ухамсартай. Харьцуулалт, шуугиан сэтгэлд чинь нөлөөлдгийг мэдээд, чи түүнийгээ зохицуулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही काय पाहता-ऐकता याबद्दल तुम्ही जागरूक आहात. तुलना आणि गोंगाट तुमच्या मनःस्थितीवर परिणाम करतात, हे तुम्हाला माहीत आहे — आणि तुम्ही ते सांभाळता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda berhati-hati dengan apa yang anda serap. Anda tahu perbandingan dan kebisingan mempengaruhi minda — dan anda mengawalnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagħżel b'attenzjoni dak li tikkonsma. Taf li t-tqabbil u l-istorbju jaffettwaw l-istat mentali tiegħek — u timmaniġġjah."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘာတွေကို လက်ခံယူမလဲဆိုတာ သတိထား ရွေးချယ်တယ်။ နှိုင်းယှဉ်မှုတွေနဲ့ ဆူညံမှုတွေက စိတ်အခြေအနေကို ထိခိုက်တယ်ဆိုတာ သိပြီး ထိန်းချုပ်တတ်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevisst på hva du tar inn. Du vet at sammenligning og støy påvirker hvordan du har det – og du gjør noe med det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफूले के हेर्ने भन्नेमा सचेत। तुलना र हल्लाखल्लाले मनमा असर गर्छ भन्ने तपाईंलाई थाहा छ — र तपाईं त्यसलाई सम्हाल्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaat bewust om met wat je binnenlaat. Je weet dat vergelijken en ruis je gemoed beïnvloeden – en daar ga je mee om."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumasamala zomwe mumalola m'maganizo mwanu. Mukudziwa kuti kudziyerekezera ndi ena ndi phokoso zimakhudza maganizo anu — ndipo mumaziwongolera."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan sammuu keetti galchitu ni filatta. Wal madaalchisuu fi sagaleen hedduun haala sammuu kee akka miidhu ni beekta — kanas ni to'atta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଯାହା ଦେଖନ୍ତି ଓ ଶୁଣନ୍ତି, ସେଥିପ୍ରତି ସଚେତନ। ତୁଳନା ଓ ହଟ୍ଟଗୋଳ ଆପଣଙ୍କ ମନ ଉପରେ ପ୍ରଭାବ ପକାଏ ବୋଲି ଆପଣ ଜାଣନ୍ତି — ଏବଂ ଆପଣ ତାହା ସମ୍ଭାଳନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਸੋਚ-ਸਮਝ ਕੇ ਚੁਣਦੇ ਹੋ ਕਿ ਮਨ ਵਿੱਚ ਕੀ ਜਾਵੇ। ਤੁਹਾਨੂੰ ਪਤਾ ਹੈ ਕਿ ਤੁਲਨਾ ਅਤੇ ਸ਼ੋਰ ਤੁਹਾਡੀ ਮਾਨਸਿਕ ਹਾਲਤ ਉੱਤੇ ਅਸਰ ਪਾਉਂਦੇ ਹਨ — ਅਤੇ ਤੁਸੀਂ ਇਸ ਨੂੰ ਸੰਭਾਲਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadomie wybierasz, co do ciebie dociera. Wiesz, że porównywanie się i szum wpływają na twoją psychikę – i nad tym panujesz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په دې پام لرئ چې ذهن ته مو څه ننوځي. پوهېږئ چې پرتله او شور ستاسو پر رواني حالت اغېز کوي — او اداره یې کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolhe o que consome. Sabe que comparação e barulho afetam sua cabeça — e cuida disso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhes bem o que consomes. Sabes que comparações e ruído afetam o teu estado mental — e geres isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenție la ce consumi. Știi că și comparațiile și zgomotul îți afectează starea mintală — și le ții sub control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты осознанно выбираешь, что впускать в свою жизнь. Ты знаешь, что сравнения и информационный шум влияют на состояние, — и управляешь этим."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witondera ibyo winjiza mu mutwe. Uzi ko kwigereranya n'urusaku bigira ingaruka ku mitekerereze yawe — kandi urabigenzura."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ඔබේ හිතට යන දේ ගැන සැලකිලිමත්. සංසන්දනය සහ ඝෝෂාව ඔබේ මානසික තත්ත්වයට බලපානවා කියලා ඔබ දන්නවා — ඔබ ඒක පාලනය කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedome si vyberáš, čo do seba púšťaš. Vieš, že porovnávanie a šum ovplyvňujú tvoje duševné rozpoloženie – a vieš s tým narábať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premišljeno izbiraš, kaj spustiš vase. Veš, da primerjanje in hrup vplivata na tvoje počutje – in s tem znaš upravljati."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoziva zvaunopinza mupfungwa. Unoziva kuti kuzvienzanisa nevamwe neruzha zvinokanganisa pfungwa dzako — uye unozvidzora."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waad ka taxaddartaa waxa aad maskaxdaada geliso. Waad ogtahay in is-barbardhigga iyo buuqu saameeyaan xaaladdaada maskaxeed — waadna maareysaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgjedh me kujdes atë që konsumon. E di që krahasimet dhe zhurma ndikojnë në gjendjen tënde mendore – dhe e mban nën kontroll."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пазиш шта уносиш у себе. Знаш да поређење и бука утичу на твоје ментално стање — и држиш то под контролом."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun milih naon anu asup kana diri anjeun. Anjeun terang yén ngabanding-bandingkeun sareng réa teuing informasi mangaruhan kaayaan méntal, sareng anjeun ngajagi éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du väljer medvetet vad du tar in. Du vet att jämförelser och brus påverkar hur du mår – och du hanterar det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unachagua kwa makini unachokiruhusu kukuingia. Unajua kwamba kujilinganisha na kelele huathiri hali yako ya akili — na unalidhibiti hilo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எதை உள்வாங்குகிறீர்கள் என்பதில் கவனமானவர். ஒப்பீடும் இரைச்சலும் உங்கள் மனநிலையைப் பாதிக்கும் என்று உங்களுக்குத் தெரியும் — அதை நீங்கள் கையாள்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఏం చూస్తున్నారో, వింటున్నారో జాగ్రత్తగా ఎంచుకుంటారు. పోలికలు, గోల మీ మనస్థితిని ప్రభావితం చేస్తాయని మీకు తెలుసు — దాన్ని మీరు అదుపులో ఉంచుకుంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту бошуурона интихоб мекунӣ, ки чӣ ба худ роҳ медиҳӣ. Медонӣ, ки муқоиса ва ғавғо ба ҳолати рӯҳиат таъсир мекунад — ва инро идора мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเลือกสิ่งที่รับเข้ามาอย่างตั้งใจ คุณรู้ว่าการเปรียบเทียบและความวุ่นวายส่งผลต่อใจ และคุณก็จัดการมันได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብቲ እትቕበልዎ ነገራት ጥንቁቓት ኢኹም። ምንጽጻርን ዕግርግርን ኣብ ኩነታት ኣእምሮኹም ከም ዝጸልዉ ትፈልጡ — ትቆጻጸርዎ ድማ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özüňe näme siňdirýäniňe üns berýärsiň. Deňeşdirmeleriň we galmagalyň ruhy ýagdaýyňa täsir edýändigini bilýärsiň — we ony dolandyrýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neye maruz kaldığını bilinçli seçiyorsun. Kıyaslamanın ve gürültünün ruh halini etkilediğini biliyor ve bunu yönetiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти свідомо обираєш, що споживати. Ти знаєш, що порівняння й інформаційний шум впливають на стан — і керуєш цим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو کچھ ذہن تک پہنچتا ہے، اس کا انتخاب سوچ سمجھ کر۔ موازنہ اور شور ذہنی حالت پر اثر ڈالتے ہیں، یہ آپ کو معلوم ہے، اور اسے قابو میں رکھنا آپ کو آتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimani qabul qilishingizni ongli tanlaysiz. Taqqoslash va axborot shovqini ruhiy holatingizga taʼsir qilishini bilasiz — va buni nazorat qilasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chọn lọc những gì mình tiếp nhận. Bạn biết so sánh và ồn ào ảnh hưởng đến tinh thần — và bạn kiểm soát được nó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhetha ngabom into oyingenisayo. Uyazi ukuba ukuzithelekisa nengxolo kuyichaphazela ingqondo yakho — kwaye uyakulawula."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń ṣọ́ ohun tí ẹ ń gbà sínú. Ẹ mọ̀ pé fífi ara yín wé àwọn ẹlòmíì àti ariwo ń nípa lórí ọkàn yín — ẹ sì ń ṣàkóso rẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會刻意篩選接收的資訊。你知道比較和雜訊會影響心情，而你懂得管理。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会有意识地筛选接收的信息。你知道比较和噪音会影响心态，并且会主动管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你很注意自己接收了什麼。你知道比較和雜訊會影響心情，也懂得管理。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakhetha ngenhloso ukuthi yini ongena kuyo. Uyazi ukuthi ukuziqhathanisa nomsindo kuthinta isimo sakho sengqondo — futhi uyakuphatha."
          }
        }
      }
    },
    "Intentional eater. Your goals drive your food choices. Helpful for a partner to understand — especially around shared cooking." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’n Doelbewuste eter. Jou doelwitte stuur jou koskeuses. Nuttig vir jou maat om te verstaan – veral as julle saam kook."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሆን ብለው የሚመገቡ። ግቦችዎ የምግብ ምርጫዎን ይመራሉ። አጋርዎ ይህን ቢረዱ ይጠቅማል — በተለይ በጋራ ምግብ ማብሰል ዙሪያ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكل عن وعي. أهدافك هي التي تقود اختياراتك الغذائية، ومن المفيد أن يفهم شريكك ذلك، خاصة عند الطبخ معًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সজ্ঞানে খোৱা মানুহ। আপোনাৰ লক্ষ্যই আপোনাৰ খাদ্যৰ বাছনি নিৰ্ধাৰণ কৰে। সংগীয়ে এইটো বুজাটো সহায়ক — বিশেষকৈ একেলগে ৰন্ধাৰ ক্ষেত্ৰত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilərəkdən qidalanırsan. Yemək seçimlərini hədəflərin müəyyən edir. Partnyorunun bunu anlaması yaxşıdır — xüsusən birgə yemək bişirəndə."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свядомае харчаванне. Твае мэты вызначаюць выбар ежы. Палавінцы карысна гэта разумець — асабліва калі вы гатуеце разам."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храниш се съзнателно. Целите ти определят какво ядеш. Полезно е половинката ти да го разбира – особено когато готвите заедно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সচেতনভাবে খাও। তোমার লক্ষ্যই খাবার বাছাই ঠিক করে। পার্টনারের এটা বোঝা কাজে দেয় — বিশেষ করে একসাথে রান্নার সময়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svjesno se hraniš. Tvoji ciljevi vode tvoje izbore hrane. Korisno je da voljena osoba to razumije – naročito kad zajedno kuhate."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menges amb intenció. Els teus objectius marquen el que tries menjar. Ajuda que la teva parella ho entengui — sobretot quan cuineu junts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jíš s rozmyslem. Tvoje cíle určují, co jíš. Pro protějšek je dobré tomu rozumět – hlavně když spolu vaříte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n bwyta'n fwriadol. Dy nodau sy'n llywio dy ddewisiadau bwyd. Mae'n help i bartner ddeall hyn — yn enwedig wrth goginio gyda'ch gilydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spiser med et formål. Dine mål styrer dine madvalg. Godt for en partner at forstå – især når I laver mad sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du isst bewusst. Deine Ziele bestimmen, was auf den Teller kommt. Gut, wenn die andere Person das versteht – besonders beim gemeinsamen Kochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρως με σκοπό. Οι στόχοι σου καθορίζουν τις επιλογές σου στο φαγητό. Βοηθάει να το καταλαβαίνει το ταίρι σου — ειδικά όταν μαγειρεύετε μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comes con un propósito. Tus metas guían lo que eliges comer. A tu pareja le ayuda entenderlo — sobre todo a la hora de cocinar juntos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teadlik sööja. Su eesmärgid juhivad su toiduvalikuid. Partneril on kasulik seda mõista — eriti ühise söögitegemise puhul."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahita jaten duzu. Zure helburuek gidatzen dituzte zure janari-aukerak. Komeni da bikotekideak ulertzea — batez ere elkarrekin sukaldatzean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آگاهانه غذا می‌خوری. هدف‌هایت انتخاب‌های غذایی‌ات را تعیین می‌کنند. خوب است پارتنرت این را بفهمد — مخصوصاً در آشپزی مشترک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syöt harkiten. Tavoitteesi ohjaavat ruokavalintojasi. Kumppanin on hyvä ymmärtää se – etenkin kun kokkaatte yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinasadya mo ang kinakain mo. Ang mga layunin mo ang nagdidikta sa pagkain mo. Makakatulong kung naiintindihan ito ng partner mo — lalo na pag sabay kayong nagluluto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chez toi, rien n'est mangé au hasard. Tes objectifs guident tes choix alimentaires. Mieux vaut que l'autre le comprenne, surtout quand vous cuisinez ensemble."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itheann tú d'aon ghnó. Is iad do spriocanna a stiúrann do roghanna bia. Is cabhair é do do pháirtí é seo a thuiscint — go háirithe maidir le cócaireacht le chéile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comes con intención. Os teus obxectivos guían o que comes. Convén que a túa parella o entenda, sobre todo á hora de cociñar xuntos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સમજીને ખાનારા. તમારાં લક્ષ્યો તમારી ખાવાની પસંદગી નક્કી કરે છે. પાર્ટનર આ સમજે તો સારું — ખાસ કરીને સાથે રાંધતી વખતે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna ci da niyya. Burinku ne ke jagorantar zaɓin abincinku. Zai taimaka abokin zama ya fahimta — musamman wajen girki tare."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אכילה מתוך כוונה. המטרות שלך מכתיבות את מה שבצלחת. כדאי שהצד השני יבין את זה — במיוחד כשמבשלים יחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोच-समझकर खाना। आपके लक्ष्य ही तय करते हैं कि थाली में क्या होगा। पार्टनर के लिए यह समझना मददगार है — ख़ासकर साथ खाना बनाते समय।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svjesno jedeš. Tvoji ciljevi određuju što biraš za jelo. Voljenoj osobi dobro je to razumjeti – osobito kod zajedničkog kuhanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou manje ak entansyon. Objektif ou yo gide chwa manje ou. Li bon pou patnè ou konprann sa — sitou lè n ap kwit ansanm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudatosan étkezel. A céljaid irányítják, mit eszel. Hasznos, ha a párod is érti ezt – főleg a közös főzésnél."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գիտակցված սնվող ես։ Նպատակներդ են որոշում ուտելիքի ընտրությունդ։ Օգտակար է, որ զուգընկերդ սա հասկանա — հատկապես միասին ճաշ պատրաստելիս։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu makan dengan tujuan. Targetmu yang menentukan pilihan makananmu. Bagus kalau pasanganmu paham — apalagi saat masak bareng."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eri nri n'ebumnuche. Ebumnuche gị na-ekpebi nri ị na-ahọrọ. Ọ ga-enyere onye gị aka ịghọta ya — karịsịa mgbe unu na-esi nri ọnụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meðvitað mataræði. Markmiðin þín stýra matarvalinu. Gott fyrir maka að skilja – sérstaklega þegar þið eldið saman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangi con consapevolezza. Sono i tuoi obiettivi a guidare le tue scelte. È utile che il tuo partner lo capisca — soprattutto quando cucinate insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目的を持って食べる人です。食べるものは目標で決まります。特に一緒に料理するときのために、パートナーに理解してもらえると助かります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangan kanthi sengaja. Ancas panjenengan nemtokake pilihan panganan. Becik dimangerteni pasangan — luwih-luwih nalika masak bareng."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეგნებულად ჭამ. საჭმლის არჩევანს შენი მიზნები განსაზღვრავს. კარგია, თუ პარტნიორს ეს ესმის — განსაკუთრებით, როცა ერთად ამზადებთ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саналы тамақтанасың. Тағам таңдауыңды мақсаттарың айқындайды. Серігің мұны түсінсе жақсы — әсіресе бірге ас әзірлегенде."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកញ៉ាំដោយមានគោលបំណង។ គោលដៅរបស់អ្នកកំណត់ជម្រើសម្ហូប។ ជារឿងល្អដែលដៃគូគួរយល់ — ជាពិសេសពេលធ្វើម្ហូបជាមួយគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ತಿನ್ನುವವರು. ನಿಮ್ಮ ಗುರಿಗಳೇ ನಿಮ್ಮ ಆಹಾರದ ಆಯ್ಕೆಗಳನ್ನು ನಿರ್ಧರಿಸುತ್ತವೆ. ಸಂಗಾತಿ ಇದನ್ನು ಅರ್ಥಮಾಡಿಕೊಂಡರೆ ಸಹಾಯ — ವಿಶೇಷವಾಗಿ ಜೊತೆಯ ಅಡುಗೆಯಲ್ಲಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목적 있게 먹는 사람이에요. 목표가 음식 선택을 이끌죠. 특히 함께 요리할 때 연인이 이해해 주면 큰 도움이 돼요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xwarina bi niyet. Armancên te bijartinên te yên xwarinê diyar dikin. Baş e ku hevjînê te vê fêm bike — bi taybetî di xwarin çêkirina hevpar de."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аң-сезимдүү тамактанасың. Тамак тандооңду максаттарың аныктайт. Сүйгөнүң муну түшүнсө жакшы — айрыкча бирге тамак жасаганда."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ëss ganz bewosst. Deng Ziler bestëmmen, wat op den Teller kënnt. Hëllefräich, wann däi Schatz dat versteet — besonnesch beim gemeinsame Kachen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ກິນຢ່າງຕັ້ງໃຈ ເປົ້າໝາຍຂອງເຈົ້າເປັນຕົວກຳນົດການເລືອກອາຫານ ດີທີ່ຄູ່ຈະເຂົ້າໃຈ — ໂດຍສະເພາະເວລາເຮັດອາຫານນຳກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sąmoninga mityba. Tavo tikslai lemia maisto pasirinkimus. Antrajai pusei naudinga tai suprasti – ypač gaminant kartu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apzināta ēšana. Tavi mērķi nosaka, ko tu ēd. Otrajai pusei to būtu labi saprast – īpaši, kad gatavojat kopā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mihinana amin'ny fikasana mazava ianao. Ny tanjonao no mitarika ny safidinao amin'ny sakafo. Ilaina ho azon'ny olon-tiana izany — indrindra amin'ny fiarahana mahandro."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He kaikai whai whakaaro. Mā ō whāinga ō kōwhiringa kai e ārahi. He pai kia mārama tō hoa aroha — ina koa mō te tunu kai tahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Јадеш со намера. Твоите цели ги водат изборите на храна. Корисно е половинката да го разбере ова — особено кога готвите заедно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബോധപൂർവം കഴിക്കുന്നവർ. നിങ്ങളുടെ ലക്ഷ്യങ്ങളാണ് ഭക്ഷണം തീരുമാനിക്കുന്നത്. പങ്കാളി ഇത് മനസ്സിലാക്കുന്നത് സഹായകരമാണ് — പ്രത്യേകിച്ച് ഒരുമിച്ച് പാചകം ചെയ്യുമ്പോൾ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Санаатайгаар хооллогч. Зорилго чинь хоолны сонголтыг чинь тодорхойлдог. Ялангуяа хамт хоол хийхэд хань чинь үүнийг ойлгох нь тустай."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाणीवपूर्वक खाणारे. तुमची ध्येये तुमच्या खाण्याच्या निवडी ठरवतात. जोडीदाराने हे समजून घेणे उपयोगी — विशेषतः एकत्र स्वयंपाक करताना."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda makan dengan tujuan. Matlamat anda menentukan pilihan makanan. Baik untuk pasangan memahaminya — terutamanya bila memasak bersama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiekol b'intenzjoni. L-għanijiet tiegħek jiggwidaw l-għażliet tal-ikel. Ta' għajnuna li l-partner tiegħek jifhem dan — speċjalment meta ssajru flimkien."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရည်ရွယ်ချက်ရှိရှိ စားတယ်။ သင့်ပန်းတိုင်တွေက အစားအသောက် ရွေးချယ်မှုကို ဦးဆောင်တယ်။ ချစ်သူ နားလည်ထားရင် အကျိုးရှိတယ် — အထူးသဖြင့် အတူ ချက်ပြုတ်တဲ့အခါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spiser bevisst. Målene dine styrer matvalgene. Fint for en partner å forstå – særlig når dere lager mat sammen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोचेर खाने व्यक्ति। तपाईंका लक्ष्यले खानाका रोजाइ तय गर्छन्। पार्टनरले यो बुझ्नु उपयोगी हुन्छ — खासगरी सँगै पकाउँदा।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bewuste eter. Je doelen bepalen wat je eet. Fijn als je partner dat begrijpt – zeker als jullie samen koken."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumadya mwadala. Zolinga zanu zimatsogolera zakudya zomwe mumasankha. Nchothandiza kuti wokondedwa wanu amvetse — makamaka pakuphika limodzi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyaata yaadee nyaatta. Kaayyoon kee filannoo nyaata kee murteessa. Kana hubachuun jaalallee keetiif gargaara — keessumaa yeroo waliin bilcheessitan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଜାଣିଶୁଣି ଖାଆନ୍ତି। ଆପଣଙ୍କ ଲକ୍ଷ୍ୟ ଆପଣଙ୍କ ଖାଦ୍ୟ ବାଛେ। ସାଥୀ ଏହା ବୁଝିଲେ ଭଲ — ବିଶେଷକରି ଏକାଠି ରାନ୍ଧିବା ବେଳେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੋਚ-ਸਮਝ ਕੇ ਖਾਣ ਵਾਲੇ। ਤੁਹਾਡੇ ਟੀਚੇ ਤੁਹਾਡੇ ਖਾਣੇ ਦੀ ਚੋਣ ਤੈਅ ਕਰਦੇ ਹਨ। ਪਾਰਟਨਰ ਲਈ ਇਹ ਸਮਝਣਾ ਮਦਦਗਾਰ ਹੈ — ਖ਼ਾਸ ਕਰਕੇ ਇਕੱਠੇ ਖਾਣਾ ਬਣਾਉਂਦਿਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedzenie z intencją. To twoje cele decydują o tym, co jesz. Dobrze, żeby druga połówka to rozumiała – zwłaszcza przy wspólnym gotowaniu."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په پوهه خوړل. ستاسو موخې ستاسو د خوړو انتخاب ټاکي. ښه به وي ستاسو ملګری پرې پوه شي — په ځانګړې توګه د ګډ پخلي پر مهال."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolhe o que come com propósito. Seus objetivos guiam suas escolhas. É bom seu amor entender isso — principalmente na hora de cozinhar juntos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comes com intenção. Os teus objetivos guiam as tuas escolhas. É útil o teu par perceber isto — sobretudo quando cozinham a dois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mănânci cu un scop. Obiectivele îți ghidează alegerile alimentare. E util ca partenerul tău să înțeleagă asta — mai ales când gătiți împreună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осознанный подход к еде. Твои цели определяют, что ты ешь. Партнёру полезно это понимать — особенно когда вы готовите вместе."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urya ubigambiriye. Intego zawe ni zo zigena ibyo urya. Ni byiza ko umukunzi wawe abyumva — cyane cyane mu guteka muri kumwe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හිතාමතාම කන කෙනෙක්. ඔබේ ඉලක්ක තමයි ඔබේ කෑම තේරීම් තීරණය කරන්නේ. ඔබේ සහකරු මේක තේරුම් ගන්න එක ප්‍රයෝජනවත් — විශේෂයෙන් එක්ව උයනකොට."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ješ vedome. Tvoje ciele určujú, čo si vyberáš. Pre polovičku je dobré to chápať – najmä pri spoločnom varení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premišljena prehrana. Tvoji cilji vodijo tvoje izbire hrane. Partnerju koristi, da to razume – sploh pri skupnem kuhanju."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unodya nechinangwa. Zvinangwa zvako zvinotungamira zvaunodya. Zvinobatsira mudiwa kuzvinzwisisa — kunyanya pakubika pamwe chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cune ujeeddo leh. Hadafyadaada ayaa hagaya doorashooyinkaaga cuntada. Waa waxtar in lammaanahaagu fahmo — gaar ahaan karinta la wadaago."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha me qëllim. Synimet e tua drejtojnë zgjedhjet ushqimore. Ndihmon që partneri yt ta kuptojë – sidomos kur gatuani bashkë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храна с намером. Твоји циљеви одређују шта једеш. Корисно је да твоја половина то разуме — нарочито кад кувате заједно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuang kalayan tujuan. Tujuan anjeun nangtukeun pilihan kadaharan anjeun. Mantuan upami pasangan ngartos — utamina nalika masak babarengan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du äter med ett syfte. Dina mål styr dina matval. Bra för en partner att förstå – särskilt när ni lagar mat tillsammans."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mlaji wa makusudi. Malengo yako huongoza uchaguzi wako wa chakula. Inasaidia mwenzi wako kuelewa — hasa mnapopika pamoja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டமிட்டுச் சாப்பிடுபவர். உங்கள் இலக்குகளே உங்கள் உணவுத் தேர்வுகளைத் தீர்மானிக்கின்றன. துணை இதைப் புரிந்துகொள்வது உதவும் — குறிப்பாக ஒன்றாகச் சமைக்கும்போது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉద్దేశపూర్వకంగా తినేవారు. మీ లక్ష్యాలే మీ ఆహార ఎంపికలను నడిపిస్తాయి. భాగస్వామి ఇది అర్థం చేసుకుంటే మంచిది — ముఖ్యంగా కలిసి వండేటప్పుడు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Огоҳона мехӯрӣ. Ҳадафҳоят интихоби таомро муайян мекунанд. Фаҳмидани ин барои ёрат фоиданок аст — махсусан ҳангоми якҷоя пухтан."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกินอย่างตั้งใจ เป้าหมายเป็นตัวกำหนดสิ่งที่คุณเลือกกิน ถ้าคนรักเข้าใจเรื่องนี้จะช่วยได้มาก โดยเฉพาะตอนทำอาหารด้วยกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብንቕሓት ትምገቡ። ዕላማታትኩም ምርጫ መግብኹም ይመርሕዎ። መጻምድኹም ክርድእዎ ይሕግዝ — ብፍላይ ኣብ ናይ ሓባር ምኽሻን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aňly iýýän adam. Maksatlaryň nahar saýlawyňy kesgitleýär. Söýgüliň muňa düşünse gowy — esasan hem bile nahar bişirilende."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinçli besleniyorsun. Yemek seçimlerini hedeflerin belirliyor. Partnerinin bunu anlaması, özellikle birlikte yemek yaparken işe yarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усвідомлене харчування. Твої цілі визначають, що в тебе на тарілці. Половинці корисно це розуміти — особливо коли ви готуєте разом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوچ سمجھ کر کھانا۔ آپ کے اہداف آپ کی خوراک طے کرتے ہیں۔ ساتھی کے لیے یہ سمجھنا مفید ہے — خاص طور پر مل کر پکاتے وقت۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongli ovqatlanasiz. Taom tanlovingizni maqsadlaringiz belgilaydi. Buni sherigingiz tushunsa yaxshi — ayniqsa, birga ovqat pishirganda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn ăn có chủ đích. Mục tiêu dẫn dắt lựa chọn món ăn của bạn. Người ấy nên hiểu điều này — nhất là khi nấu nướng chung."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utya ngenjongo. Iinjongo zakho zikhokela ukhetho lwakho lokutya. Kuluncedo ukuba iqabane lakho likuqonde oku — ingakumbi xa nipheka kunye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹni tó ń jẹun pẹ̀lú èrò. Àfojúsùn yín ló ń darí ohun tí ẹ ń jẹ. Ó wúlò kí olólùfẹ́ yín lóye rẹ̀ — pàápàá nínú sísè papọ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你吃得很有目的，目標主導你的飲食選擇。讓另一半了解這點會很有幫助，尤其是一起下廚的時候。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你吃东西很有规划。你的目标决定你的饮食选择。让另一半了解这一点会很有帮助，尤其是一起做饭的时候。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你吃得很有意識，目標決定了你的選擇。讓另一半了解這點會很有幫助，尤其是一起下廚的時候。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udla ngenhloso. Imigomo yakho iqondisa ukudla okukhethayo. Kuyasiza ukuthi umlingani akuqonde — ikakhulukazi uma nipheka ndawonye."
          }
        }
      }
    },
    "Intentional stillness. You've built a practice that grounds you — and that probably makes you calmer in conflict too." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelbewuste stilte. Jy het ’n gewoonte opgebou wat jou gegrond hou – en dit maak jou waarskynlik ook kalmer in konflik."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሆን ተብሎ የሚደረግ ጸጥታ። የሚያረጋጋዎት ልማድ ገንብተዋል — ይህም ምናልባት በአለመግባባት ጊዜም የበለጠ እንዲረጋጉ ያደርግዎታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سكون مقصود. لديك ممارسة تمنحك الثبات، وربما تجعلك أهدأ في الخلافات أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সচেতন স্থিৰতা। আপুনি এনে এটা অভ্যাস গঢ়ি তুলিছে যিয়ে আপোনাক মাটিত ভৰি থৈ ৰাখে — আৰু হয়তো কাজিয়াৰ সময়তো আপোনাক শান্ত কৰি ৰাখে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilərəkdən seçilmiş sakitlik. Səni yerə bağlayan bir vərdiş qurmusan — yəqin ki, bu, mübahisələrdə də səni daha təmkinli edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свядомая цішыня. У цябе ёсць практыка, якая дае апору, — і, мусіць, дапамагае захоўваць спакой і ў спрэчках."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съзнателно спокойствие. Имаш практика, която те заземява – и вероятно затова запазваш спокойствие и при конфликт."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সচেতনভাবে থিতু হওয়া। তুমি এমন একটা অভ্যাস গড়েছ যা তোমাকে স্থির রাখে — আর সম্ভবত ঝগড়ার সময়ও তোমাকে শান্ত রাখে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namjerni mir. Imaš naviku koja te prizemljuje – a zbog nje vjerovatno i u svađama lakše čuvaš mir."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quietud buscada. Has creat un hàbit que t'arrela — i segurament també et dona més calma en els conflictes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vědomé ztišení. Máš návyk, který tě uzemňuje – a díky němu jsi nejspíš klidnější i v konfliktu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llonyddwch bwriadol. Rwyt ti wedi creu arfer sy'n dy angori — ac mae'n debyg ei fod yn dy wneud yn dawelach mewn gwrthdaro hefyd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevidst stilhed. Du har opbygget en praksis, der giver dig jordforbindelse – og den gør dig nok også roligere i konflikter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewusste Stille. Du hast eine Praxis gefunden, die dich erdet – und die dich wahrscheinlich auch im Streit ruhiger macht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνειδητή ησυχία. Έχεις χτίσει μια πρακτική που σε γειώνει — και που μάλλον σε βοηθά να κρατάς την ηρεμία σου και στις διαφωνίες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calma buscada. Has creado una práctica que te centra — y seguramente también te da más serenidad en los conflictos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teadlik vaikus. Oled loonud harjumuse, mis hoiab sind kindlalt maa peal — ja see teeb sind tõenäoliselt ka tülis rahulikumaks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahita bilatutako lasaitasuna. Lurrean jartzen zaituen ohitura bat landu duzu, eta ziurrenik gatazketan ere lasaiago egoten zara horri esker."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سکونی آگاهانه. عادتی ساخته‌ای که تو را آرام و پابرجا نگه می‌دارد — و احتمالاً در دعواها هم آرام‌ترت می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoista hiljentymistä. Olet luonut itsellesi harjoituksen, joka maadoittaa sinua – ja se tekee sinusta luultavasti rauhallisemman myös riidoissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinasadyang katahimikan. May nabuo kang gawi na nagpapakalma sa’yo — at malamang mas kalmado ka rin sa away dahil dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calme choisi. Tu as construit une pratique qui t'ancre — et qui t'aide sûrement à garder ton calme en cas de conflit aussi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciúnas d’aon ghnó. Tá cleachtas tógtha agat a choinníonn ar do bhonnaibh thú — agus is dócha go bhfágann sé níos suaimhní thú i gcoimhlint freisin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calma buscada. Construíches unha práctica que te ancora, e probablemente tamén te axuda a manter a calma nos conflitos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જાણીજોઈને મેળવેલી શાંતિ. તમે એક એવી આદત બનાવી છે જે તમને સ્થિર રાખે છે — અને કદાચ ઝઘડામાં પણ તમને વધુ શાંત રાખે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutsuwa da gangan. Kun gina al'adar da ke kwantar muku da hankali — kuma wataƙila hakan na sa ku fi natsuwa idan an samu saɓani."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקט מכוון. בנית לעצמך תרגול שמקרקע אותך — וכנראה שזה גם מביא יותר רוגע לרגעי קונפליקט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोचा-समझा ठहराव। आपने एक ऐसी आदत बनाई है जो आपको स्थिर रखती है — और शायद झगड़ों में भी आपको शांत रखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namjerna tišina. Izgradila se navika koja te prizemljuje – a zbog nje vjerojatno i u sukobu zadržavaš više mira."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon kalm ou chwazi. Ou bati yon pratik ki ancre ou — e sa gendwa fè ou pi kalm lè gen konfli tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudatos csend. Kialakítottál egy gyakorlatot, ami egyensúlyban tart – és valószínűleg a vitákban is nyugodtabb vagy tőle."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գիտակցված անդորր։ Դու ունես պրակտիկա, որը քեզ հավասարակշռում է, և դա հավանաբար քեզ ավելի հանգիստ է դարձնում նաև վեճերի ժամանակ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hening yang disengaja. Kamu punya kebiasaan yang membuatmu membumi — dan mungkin itu juga membuatmu lebih tenang saat berselisih."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịnọ jụụ n'ebumnuche. Ị ruola omume na-eme ka ị guzosie ike — nke a nwekwara ike ime ka obi dajụọ gị n'oge esemokwu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meðvituð kyrrð. Þú hefur komið þér upp venju sem veitir þér jarðtengingu – og hún gerir þig líklega rólegri í ágreiningi líka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calma intenzionale. Hai costruito una pratica che ti centra — e probabilmente ti dà più serenità anche nei conflitti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意識して静けさをつくる人です。心を落ち着かせる習慣があるので、ケンカのときもきっと冷静でいられます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meneng kanthi sengaja. Panjenengan wis mbangun kabiasaan sing nggawe ati ayem — lan mbokmenawa iku uga nggawe panjenengan luwih tenang nalika padudon."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეგნებული სიმშვიდე. შენ ისეთი პრაქტიკა ჩამოაყალიბე, რომელიც წონასწორობას გინარჩუნებს — და, ალბათ, კამათშიც უფრო მშვიდს გხდის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әдейі жасалған тыныштық. Сені тұрақтандыратын әдет қалыптастырғансың, сондықтан даулы сәттерде де сабырлырақ болатын шығарсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពស្ងប់ស្ងាត់ដោយចេតនា។ អ្នកបានកសាងទម្លាប់មួយដែលធ្វើឲ្យអ្នកនឹងន — ហើយវាប្រហែលជាធ្វើឲ្យអ្នកស្ងប់ជាងមុនពេលមានជម្លោះផងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉದ್ದೇಶಪೂರ್ವಕ ನಿಶ್ಚಲತೆ. ನಿಮ್ಮನ್ನು ನೆಲೆಗೊಳಿಸುವ ಅಭ್ಯಾಸವನ್ನು ನೀವು ರೂಢಿಸಿಕೊಂಡಿದ್ದೀರಿ — ಜಗಳದ ಸಮಯದಲ್ಲೂ ಅದು ಬಹುಶಃ ನಿಮ್ಮನ್ನು ಶಾಂತವಾಗಿರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의식적인 고요함이에요. 나를 단단하게 붙잡아 주는 습관을 만들었고, 덕분에 갈등 상황에서도 더 차분할 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bêdengiya bi mebest. Te adetek ava kiriye ku te aram dike — û belkî ev te di nakokiyan de jî aramtir dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Атайын тынчтык. Сени тең салмакта кармаган практиканы түзгөнсүң — балким, ошондуктан урушта да тынчыраак болосуң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewosst Rou. Du hues der eng Praxis opgebaut, déi dir Halt gëtt — an déi dech wahrscheinlech och bei Konflikter méi roueg mécht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມສະຫງົບທີ່ເຈົ້າຕັ້ງໃຈສ້າງ ເຈົ້າມີການຝຶກທີ່ຊ່ວຍໃຫ້ໃຈໝັ້ນຄົງ — ແລະ ມັນຄົງເຮັດໃຫ້ເຈົ້າໃຈເຢັນຂຶ້ນເວລາຜິດຖຽງກັນນຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sąmoninga ramybė. Susikūrei praktiką, kuri tave įžemina – ir tikriausiai padeda išlaikyti ramybę per konfliktus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apzināts klusums. Tev ir prakse, kas tevi iezemē – un, visticamāk, palīdz saglabāt mieru arī strīdos."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahanginana nofidiana. Nanangana fanao mampitony anao ianao — ary azo inoana fa mahatonga anao ho tony kokoa koa izany rehefa misy fifandirana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He āta noho mārie. Kua hanga koe i tētahi tikanga e tau ai koe — ā, ka mārie ake pea koe i ngā tautohetohe hoki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намерна тишина. Имаш изградено навика што те смирува — и таа веројатно ти помага да го зачуваш мирот и во расправија."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മനഃപൂർവമായ ശാന്തത. നിങ്ങളെ ഉറപ്പിച്ചുനിർത്തുന്ന ഒരു ശീലം നിങ്ങൾ വളർത്തിയെടുത്തിട്ടുണ്ട് — തർക്കങ്ങളിലും അത് നിങ്ങളെ കൂടുതൽ ശാന്തരാക്കുന്നുണ്ടാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зориуд тогтсон нам гүм. Чи өөрийгөө тогтворжуулах дадал бий болгосон — энэ нь маргааны үед ч чамайг илүү тайван байлгадаг байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाणीवपूर्वक शांतता. तुम्हाला स्थिर ठेवणारा सराव तुम्ही जोपासला आहे — आणि त्यामुळे वादातही तुम्ही बहुधा अधिक शांत राहता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketenangan yang disengajakan. Anda sudah membina amalan yang menenangkan — dan mungkin itu membuatkan anda lebih tenang ketika bertelagah juga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwiet intenzjonali. Bnejt prattika li żżommok b'saqajk mal-art — u probabbilment tgħinek iżżomm il-kalma anke fil-kunflitt."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရည်ရွယ်ချက်ရှိရှိ ငြိမ်သက်ခြင်းပါ။ သင့်ကို တည်ငြိမ်စေတဲ့ အလေ့အကျင့်တစ်ခု တည်ဆောက်ထားတယ် — အဲဒါက အငြင်းပွားချိန်မှာလည်း သင့်ကို ပိုအေးဆေးစေလောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevisst stillhet. Du har bygget en praksis som gir deg ro – og det gjør deg nok roligere i konflikter også."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सचेत स्थिरता। तपाईंले आफूलाई स्थिर राख्ने अभ्यास बनाउनुभएको छ — र यसले झगडामा पनि तपाईंलाई सायद बढी शान्त राख्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewuste stilte. Je hebt een gewoonte opgebouwd die je aardt – en daardoor ben je vast ook rustiger bij ruzie."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bata losankhidwa mwadala. Mwapanga chizolowezi chomwe chimakukhazikitsani — ndipo mwina chimakupangitsani kukhala odekha pa mikangano."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasgabbii yaadamee. Shaakala si tasgabbeessu ijaarteerta — kunis yeroo walitti bu'iinsaa caalaatti akka tasgabbooftu si godha ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଚେତନ ସ୍ଥିରତା। ଆପଣ ଏମିତି ଏକ ଅଭ୍ୟାସ ଗଢ଼ିଛନ୍ତି ଯାହା ଆପଣଙ୍କୁ ସ୍ଥିର ରଖେ — ଏବଂ ସମ୍ଭବତଃ ମତଭେଦ ସମୟରେ ବି ଆପଣଙ୍କୁ ଅଧିକ ଶାନ୍ତ ରଖେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੋਚ-ਸਮਝ ਕੇ ਚੁਣੀ ਸ਼ਾਂਤੀ। ਤੁਸੀਂ ਇੱਕ ਅਜਿਹਾ ਅਭਿਆਸ ਬਣਾਇਆ ਹੈ ਜੋ ਤੁਹਾਨੂੰ ਟਿਕਾਈ ਰੱਖਦਾ ਹੈ — ਅਤੇ ਸ਼ਾਇਦ ਝਗੜੇ ਵੇਲੇ ਵੀ ਤੁਹਾਨੂੰ ਸ਼ਾਂਤ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadome wyciszenie. Masz praktykę, która cię uziemia – i pewnie dzięki niej zachowujesz więcej spokoju w konfliktach."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارادي سکون. تاسو داسې عادت جوړ کړی چې آرام مو ساتي — او شاید په شخړو کې هم ستاسو ارامي زیاتوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa com intenção. Você criou uma prática que te centra — e isso provavelmente te traz mais calma nos conflitos também."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calma intencional. Criaste uma prática que te centra — e que provavelmente também te traz mais calma nos conflitos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liniște asumată. Ți-ai construit o practică ce te echilibrează — și probabil te ajută să-ți păstrezi calmul și în conflicte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осознанная тишина. У тебя есть практика, которая заземляет, — и, скорее всего, благодаря ей ты спокойнее и в конфликтах."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ituze ubigambiriye. Wiyubakiye akamenyero kagutuza — kandi birashoboka ko kanagufasha gutuza mu makimbirane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හිතාමතා නිශ්චලතාව. ඔබව සමබරව තියන පුරුද්දක් ඔබ ගොඩනගාගෙන තියෙනවා — ඒ නිසා ගැටුම් වලදීත් ඔබ වඩා සන්සුන් වෙන්න ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedomé stíšenie. Máš prax, ktorá ťa ukotvuje – a vďaka nej si asi zachovávaš pokoj aj v konfliktoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namerna tišina. Imaš navado, ki te prizemlji – in zaradi nje verjetno tudi v sporih ohraniš več miru."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunyarara nemaune. Wakavaka tsika inokugadzikanisa — uye zvimwe inokuita kuti uve wakadzikama kana paine kupesana."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degganaan ula kac ah. Waxaad dhisatay caado ku dejisa — taasina malaha waxay kaa dhigtaa qof deggan xitaa marka la is-khilaafo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qetësi e qëllimshme. Ke krijuar një praktikë që të mban të qetë – dhe ndoshta të bën më të qetë edhe në konflikte."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намерни мир. Имаш праксу која те уземљује — а због ње вероватно лакше чуваш мир и у сукобу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenang anu dihaja. Anjeun parantos ngawangun kabiasaan anu ngajantenkeun anjeun ajeg, sareng meureun éta ogé ngajantenkeun anjeun langkung kalem nalika aya pasea."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medveten stillhet. Du har byggt upp en vana som jordar dig – och den gör dig nog lugnare i konflikter också."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utulivu wa makusudi. Umejijengea desturi inayokutuliza — na huenda inakufanya mtulivu zaidi wakati wa mabishano pia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டமிட்ட அமைதி. உங்களை நிலைப்படுத்தும் ஒரு பழக்கத்தை உருவாக்கியிருக்கிறீர்கள் — அது கருத்து வேறுபாடுகளிலும் உங்களை அமைதியாக வைத்திருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉద్దేశపూర్వకమైన నిశ్చలత. మిమ్మల్ని స్థిరంగా ఉంచే ఒక అలవాటును మీరు ఏర్పరచుకున్నారు — అది గొడవల్లోనూ మిమ్మల్ని ప్రశాంతంగా ఉంచుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ороми бошуурона. Ту одате сохтӣ, ки туро ба замин мебандад — ва эҳтимол дар баҳсҳо ҳам туро оромтар мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความนิ่งอย่างตั้งใจ คุณมีกิจวัตรที่ช่วยให้ใจนิ่ง และน่าจะทำให้คุณใจเย็นลงเวลามีปัญหากันด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብፍላጥ ዝመጽእ ህድኣት። ዘረጋግኣኩም ልምዲ ሃኒጽኩም ኣለኹም — እዚ ድማ ኣብ ግርጭት'ውን ዝያዳ ህዱኣት ይገብረኩም ይኸውን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilkastlaýyn asudalyk. Seni deňagramlaşdyrýan endik döretdiň — we bu, megerem, jedel wagtynda hem seni has sabyrly edýändir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinçli bir dinginlik. Seni dengede tutan bir pratik edinmişsin; bu muhtemelen tartışmalarda da daha sakin olmanı sağlıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свідома тиша. У тебе є практика, яка заземлює — і, мабуть, допомагає зберігати спокій і в конфліктах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوچا سمجھا سکون۔ آپ نے ایک ایسی عادت بنائی ہے جو آپ کو ٹھہراؤ دیتی ہے، اور شاید اسی وجہ سے اختلاف کے وقت بھی آپ میں زیادہ ٹھہراؤ ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongli sokinlik. Sizni xotirjam tutadigan odat shakllantirgansiz — ehtimol, bu sizni kelishmovchiliklarda ham bosiqroq qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tĩnh lặng có chủ đích. Bạn đã xây được thói quen giúp mình vững vàng — và có lẽ nhờ vậy mà bạn bình tĩnh hơn khi có mâu thuẫn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzola ngabom. Wakhe umkhwa okuzinzisayo — kwaye oko mhlawumbi kukwenza uzole nangexesha leengxabano."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdákẹ́rọ́rọ́ tí ẹ mọ̀ọ́mọ̀ yàn. Ẹ ti kọ́ àṣà kan tó ń mú yín balẹ̀ — ó sì ṣeé ṣe kí ó jẹ́ kí ẹ fara balẹ̀ jù nígbà èdèàìyédè pẹ̀lú."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刻意的平靜。你建立了一套讓自己安定下來的習慣，這大概也讓你在衝突中更冷靜。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有意识地静下来。你养成了让自己稳下来的习惯，这大概也让你在冲突中更冷静。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刻意讓自己靜下來。你養成了讓自己安定的習慣，這大概也讓你在吵架時更冷靜。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthula ngenhloso. Wakhe umkhuba okuzinzisayo — futhi lokho kungenzeka kukwenza uzole nasezingxabanweni."
          }
        }
      }
    },
    "Intimacy" : {
