        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጉልበት ምስ ዝውዳእ፣ ምቅላል > ምርግጋጽ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güýç gutaranda, ýeňillik köşeşdirmekden has gowy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji bittiğinde yükü hafifletmek, güvence vermekten iyidir."
