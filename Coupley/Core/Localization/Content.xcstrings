        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በደመነፍስ በተግባር መርዳት ይፈልጋሉ። ብቻ አጋርዎ የሚፈልጉት መፍትሔ እንጂ የሚያዳምጣቸው ሰው ብቻ አለመሆኑን ያረጋግጡ።"
