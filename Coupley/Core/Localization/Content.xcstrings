        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማኅበራዊና ስልታዊ። የሰሌዳ ጨዋታዎች ስለ ጨዋታው ያህል ስለ ሰዎቹም ናቸው። ለጥንዶች ግሩም የጋራ መዝናኛ።"
