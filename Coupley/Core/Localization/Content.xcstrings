        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua reação ao estresse mostra como seu sistema nervoso funciona — e como seu amor pode ajudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felul în care reacționezi la stres arată cum funcționează sistemul tău nervos — și cum te poate ajuta partenerul tău."
          }
