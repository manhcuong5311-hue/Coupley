        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mifantoka amin'ny ankehitriny. Tsy natao handrafitra lavitra ianao — na mbola tanora ampy ka toa teoria fotsiny izany."
