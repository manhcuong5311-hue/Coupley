    "Offer a no-pressure wind-down: 'no need to chat, just here.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bied ’n drukvrye afskakeltyd aan: “Ons hoef nie te gesels nie, ek is net hier.”"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጫና የሌለበት የማረፊያ ጊዜ ያቅርቡ፦ «ማውራት አያስፈልግም፣ እዚሁ ነኝ።»"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقترحوا استرخاءً بلا ضغط: «لا داعي للكلام، أنا هنا فقط»."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাপ নোহোৱাকৈ জিৰণিৰ সময় আগবঢ়াওক: “কথা পাতিব নালাগে, মই মাথোঁ ইয়াতে আছোঁ।”"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təzyiqsiz sakitləşmə təklif et: “Danışmağa ehtiyac yoxdur, sadəcə buradayam.”"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прапануй спакойны вечар без ціску: «можна не размаўляць, я проста побач»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложи спокойно отпускане без натиск: „Няма нужда да говорим, просто съм тук.“"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাপহীনভাবে মন শান্ত করার সময় দাও: “কথা বলতে হবে না, আমি পাশেই আছি।”"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponudi opuštanje bez pritiska: „Ne moramo pričati, samo sam tu.”"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proposa-li desconnectar sense pressió: «no cal parlar, només soc aquí»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídni zklidnění bez tlaku: „Nemusíme mluvit, jsem tu.“"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cynigia ymlacio heb bwysau: ‘dim angen sgwrsio, dw i yma.’"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbyd en rolig afslutning på dagen uden pres: »Vi behøver ikke snakke, jeg er bare her.«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biete entspanntes Runterkommen an: „Wir müssen nicht reden, ich bin einfach da.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρότεινε ένα χαλαρό κλείσιμο της μέρας χωρίς πίεση: «Δεν χρειάζεται να μιλήσουμε, είμαι απλώς εδώ.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrécele un rato para desconectar sin presión: “No hace falta hablar, solo estoy aquí”."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paku survevaba maharahunemist: „Pole vaja rääkida, olen lihtsalt siin.“"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eskaini presiorik gabeko lasaitzea: «ez dago hitz egin beharrik, hemen nago»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک آرام شدن بی‌فشار پیشنهاد بده: «لازم نیست حرف بزنیم، فقط اینجام.»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjoa paineetonta rauhoittumista: ”Ei tarvitse jutella, olen vain tässä.”"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-alok ng pahingang walang pressure: “hindi kailangang mag-usap, nandito lang ako.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose un moment calme, sans pression : « pas besoin de parler, je suis juste là »."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tairg suaimhniú gan bhrú: “ní gá comhrá, táim anseo.”"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrécelle un momento para desconectar sen presión: «non fai falta falar, estou aquí»."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ દબાણ વગર હળવા થવાનું કહો: “વાત કરવાની જરૂર નથી, બસ અહીં છું.”"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku ba da damar hutawa ba tare da matsi ba: “ba sai mun yi hira ba, ina nan kawai.”"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להציע התכנסות בלי לחץ: \"לא צריך לדבר, אני פשוט כאן.\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना दबाव के सुस्ताने का मौक़ा दें: “बात करने की ज़रूरत नहीं, मैं बस यहीं हूँ।”"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponudi opuštanje bez pritiska: „ne moramo pričati, samo sam tu”."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofri yon moman detant san presyon: “pa bezwen pale, m la.”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajánlj egy nyomás nélküli lazítást: „Nem kell beszélgetnünk, csak itt vagyok.”"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առաջարկիր հանգիստ երեկո առանց ճնշման՝ «պետք չէ խոսել, պարզապես այստեղ եմ»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tawarkan waktu santai tanpa tekanan: “nggak usah ngobrol, aku di sini aja.”"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tụọ aro izu ike n'enweghị nrụgide: ‘Ọ dịghị mkpa ikwu okwu, anọ m ebe a.’"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bjóddu upp á þrýstingslausa slökun: „Þú þarft ekki að spjalla, ég er bara hér.“"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponi un momento di relax senza pressioni: «Non serve parlare, sono qui»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「話さなくていいよ、そばにいるね」と、気負わずくつろげる時間を差し出しましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajak ngaso tanpa tekanan: “Ora usah ngobrol, aku mung ana ing kene.”"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შესთავაზე მშვიდი საღამო ყოველგვარი ზეწოლის გარეშე: „ლაპარაკი საჭირო არ არის, უბრალოდ აქ ვარ“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қысымсыз тынығуды ұсын: «Сөйлесудің керегі жоқ, мен жай осындамын»."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ដល់ពេលបន្ធូរអារម្មណ៍ដោយគ្មានសម្ពាធ៖ “មិនបាច់និយាយទេ ខ្ញុំគ្រាន់តែនៅទីនេះ។”"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒತ್ತಡವಿಲ್ಲದೆ ವಿರಮಿಸಲು ಅವಕಾಶ ಕೊಡಿ: “ಮಾತಾಡಬೇಕಿಲ್ಲ, ನಾನು ಇಲ್ಲೇ ಇದ್ದೇನೆ.”"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“얘기 안 해도 돼요, 그냥 옆에 있을게요” 하며 편하게 쉬게 해 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bêhnvedaneke bê zext pêşkêş bike: “ne hewce ye em biaxivin, ez tenê li vir im.”"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кысымсыз тынчып алууну сунушта: «сүйлөшпөсөк да болот, жөн гана жаныңдамын»."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitt e gemittlechen Ausklang ouni Drock un: „Mir mussen net schwätzen, ech sinn einfach do.“"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຊວນຜ່ອນຄາຍແບບບໍ່ກົດດັນ: “ບໍ່ຕ້ອງລົມກໍໄດ້ ຢູ່ນີ້ຄຽງຂ້າງ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasiūlyk ramų vakarą be spaudimo: „nebūtina kalbėtis, aš tiesiog čia“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piedāvā mierīgu vakaru bez spiediena: ‚nav jārunā, esmu blakus’."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manolora fotoana mampitony tsy misy tsindry: “tsy voatery hiresaka, eto fotsiny aho.”"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoatu he wā whakatau kāore he pēhanga: “kāore he take o te kōrero, kei konei noa au.”"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понуди опуштање без притисок: „Не мора да зборуваме, само сум тука“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സമ്മർദമില്ലാതെ ശാന്തമാകാൻ ഒരു അവസരം നൽകൂ: “സംസാരിക്കേണ്ട, ഞാൻ ഇവിടെയുണ്ട്.”"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дарамтгүй тайвшрахыг санал болго: «ярих хэрэггүй, зүгээр энд байна»."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दडपण नसलेला निवांत वेळ द्या: “बोलायची गरज नाही, मी इथेच आहे.”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajak berehat tanpa tekanan: “tak perlu berbual, saya ada di sini.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offri mument ta' rilassament bla pressjoni: “m'hemmx bżonn nitkellmu, jien hawn.”"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဖိအားမပါတဲ့ အနားယူချိန်လေး ပေးပါ: “စကားပြောစရာ မလိုပါဘူး၊ ဒီမှာ ရှိနေရုံပါ။”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By på en rolig stund uten krav: «Vi trenger ikke prate, jeg er bare her.»"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिनादबाबको आराम दिनुहोस्: ‘कुरा गर्नुपर्दैन, म यहीँ छु।’"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bied een ontspannen avond zonder druk: “We hoeven niet te praten, ik ben er gewoon.”"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatseni nthawi yopuma yopanda kukakamiza: “palibe chifukwa chocheza, ndili pano basi.”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boqonnaa dhiibbaa malee dhiyeessi: “haasa'uun hin barbaachisu, as jira qofa.”"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚାପମୁକ୍ତ ଆରାମ ସମୟ ଦିଅନ୍ତୁ: “କଥା ହେବା ଦରକାର ନାହିଁ, ମୁଁ କେବଳ ପାଖରେ ଅଛି।”"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਿਨਾਂ ਦਬਾਅ ਦੇ ਸ਼ਾਂਤ ਹੋਣ ਦਾ ਸਮਾਂ ਦਿਓ: “ਗੱਲ ਕਰਨ ਦੀ ਲੋੜ ਨਹੀਂ, ਬੱਸ ਮੈਂ ਇੱਥੇ ਹਾਂ।”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproponuj spokojne wyciszenie bez presji: „Nie musimy rozmawiać, po prostu jestem”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بې فشاره آرامي وړاندې کړئ: «خبرو ته اړتیا نشته، یوازې دلته یم.»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofereça um momento para relaxar sem pressão: “não precisa conversar, só tô aqui”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propõe um descanso sem pressão: «não precisamos de conversar, estou só aqui.»"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propune o seară liniștită, fără presiune: „nu trebuie să vorbim, sunt doar aici”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложи спокойно расслабиться без давления: «Можно не болтать, я просто рядом»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutegurire akanya ko gutuza nta gitutu: “si ngombwa kuganira, ndi hano gusa.”"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පීඩනයක් නැති සැහැල්ලු වීමක් යෝජනා කරන්න: “කතා කරන්න ඕනේ නෑ, මම මෙතන ඉන්නවා.”"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponúkni pokojné vydýchnutie bez tlaku: „Nemusíme sa rozprávať, som tu.“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponudi umiritev brez pritiska: „Ni treba klepetati, samo tu sem.“"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mupe nguva yekuzorora pasina kumanikidza: ‘hapana chikonzero chekutaura, ndiri pano.’"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U soo bandhig nasasho aan cadaadis lahayn: “looma baahna in la sheekaysto, halkan uun baan joogaa”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofro një çlodhje pa presion: „S’ka nevojë të flasim, jam thjesht këtu.“"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понуди опуштање без притиска: „не мораш да причаш, само сам ту“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tawarkeun waktos santé tanpa tekanan: “teu kedah ngobrol, abdi aya di dieu.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erbjud en stund att varva ner, helt utan press: ”Vi behöver inte prata, jag är bara här.”"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mpe nafasi ya kutulia bila shinikizo: “hakuna haja ya kuongea, niko hapa tu.”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அழுத்தமில்லாத ஓய்வைக் கொடுங்கள்: “பேச வேண்டாம், நான் இங்கேதான் இருக்கிறேன்.”"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒత్తిడి లేని విశ్రాంతి ఇవ్వండి: “మాట్లాడక్కర్లేదు, ఇక్కడే ఉన్నా.”"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истироҳати бе фишор пешниҳод кун: «Гап задан шарт нест, ман фақат инҷоям»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชวนผ่อนคลายแบบไม่กดดัน: “ไม่ต้องคุยก็ได้ แค่อยู่ตรงนี้”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጸቕጢ ዘይብሉ ምዕራፍ ኣቕርቡ፦ «ምዝራብ ኣየድልን፣ ኣለኹ ጥራይ።»"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basyşsyz köşeşmäge çagyr: “Gürleşmek hökman däl, men diňe şu ýerde.”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
