        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կենտրոնացած ես լուծման վրա։ Հարաբերություններն ավելի կարևոր ես համարում, քան վեճը։ Սա իսկական ուժ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus pada solusi. Bagimu hubungan lebih besar daripada perselisihan. Itu kekuatan yang nyata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-elekwasị anya na nkwekọ. Ị na-ahụ mmekọrịta ahụ ka ọ dị ukwuu karịa esemokwu ahụ. Nke ahụ bụ ezigbo ike."
