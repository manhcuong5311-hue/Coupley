        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪರಿಹಾರವೇ ನಿಮ್ಮ ಗುರಿ. ಭಿನ್ನಾಭಿಪ್ರಾಯಕ್ಕಿಂತ ಸಂಬಂಧ ದೊಡ್ಡದು ಎಂದು ನೀವು ನೋಡುತ್ತೀರಿ. ಅದು ನಿಜವಾದ ಶಕ್ತಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해결에 집중하는 타입이에요. 의견 차이보다 관계가 더 크다고 생각하죠. 정말 큰 장점이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çareserî li pêş e. Tu têkiliyê ji nakokiyê mezintir dibînî. Ev hêzeke rastîn e."
