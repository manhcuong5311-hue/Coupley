        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa dipercaya iku sing paling wigati. Ngerti pasangan bakal ana tanpa kudu dijaluki iku nggawe ati paling ayem."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საიმედოობა ყველაფერია. იმის ცოდნა, რომ თხოვნის გარეშეც გვერდით იქნება, ყველაზე მეტად გამშვიდებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенімділік — бәрі. Сұрамай-ақ қасыңда болатынын білу — әлемдегі ең тыныштандыратын нәрсе."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពជឿទុកចិត្តបានគឺសំខាន់បំផុត។ ការដឹងថាគាត់នឹងនៅទីនោះដោយមិនបាច់សុំ គឺជាអ្វីដែលធ្វើឲ្យអ្នកនឹងនរបំផុតក្នុងលោក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಂಬಿಕೆಯೇ ಎಲ್ಲ. ಕೇಳದೆಯೇ ಅವರು ಜೊತೆಗಿರುತ್ತಾರೆ ಎಂದು ತಿಳಿದಿರುವುದು ಜಗತ್ತಿನಲ್ಲೇ ಅತ್ಯಂತ ನೆಮ್ಮದಿಯ ವಿಷಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믿을 수 있다는 게 전부예요. 말하지 않아도 곁에 있어 줄 거라는 확신만큼 든든한 건 없어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêbawerî her tişt e. Zanîna ku ew ê bêyî pirsînê li wir be, di cîhanê de tiştê herî aramker e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ишенимдүүлүк — баары. Сурабасаң да ал жаныңда болорун билүү — дүйнөдөгү эң бекем таяныч."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlechkeet ass alles. Ze wëssen, datt däi Schatz do ass, ouni datt s du froe muss, gëtt dir méi Halt wéi alles op der Welt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມໄວ້ໃຈໄດ້ຄືທຸກສິ່ງ ການຮູ້ວ່າຄູ່ຈະຢູ່ນຳໂດຍບໍ່ຕ້ອງຂໍ ເຮັດໃຫ້ເຈົ້າໝັ້ນຄົງໃຈທີ່ສຸດໃນໂລກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patikimumas – viskas. Žinoti, kad antroji pusė bus šalia net neprašyta, yra didžiausia atrama pasaulyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzticamība ir viss. Zināt, ka otrā puse būs klāt bez lūgšanas, – tas dod vislielāko drošības sajūtu pasaulē."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fahatokisana no zava-drehetra. Ny fahafantarana fa ho eo izy na dia tsy mangataka aza ianao no tena mampiorina anao indrindra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pono te mea nui katoa. Ko te mōhio ka tae mai ia me te kore koe e tono, te mea tino whakaū i te ao."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурноста е сè. Да знаеш дека половинката ќе биде тука без да мораш да бараш е најсмирувачкото нешто на светот."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആശ്രയിക്കാനാവുക എന്നതാണ് എല്ലാം. ചോദിക്കാതെ തന്നെ പങ്കാളി കൂടെയുണ്ടാകുമെന്ന അറിവാണ് ലോകത്തിലെ ഏറ്റവും വലിയ ഉറപ്പ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдвартай байх нь бүх юм. Гуйх шаардлагагүйгээр хань чинь дэргэд байна гэдгийг мэдэх нь дэлхийн хамгийн тайвшруулдаг зүйл."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विश्वासार्हता हेच सर्वस्व. न मागताही जोडीदार सोबत असेल, ही खात्री जगातली सर्वात आधार देणारी गोष्ट आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebolehpercayaan ialah segalanya. Mengetahui pasangan anda akan ada tanpa perlu diminta ialah perkara paling menenangkan di dunia."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-affidabbiltà hija kollox. Li taf li xi ħadd ikun hemm mingħajr ma tistaqsi hija l-aktar ħaġa li tagħtik serħan fid-dinja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အားကိုးလို့ရတာက အရာအားလုံးပါ။ မတောင်းဆိုရဘဲ အနားမှာ ရှိနေပေးမယ်ဆိုတာ သိရတာက ကမ္ဘာပေါ်မှာ စိတ်အေးရဆုံး အရာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitelighet er alt. Å vite at noen er der uten at du må spørre, er det tryggeste i verden."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भरोसा नै सबथोक हो। नभनी पनि उहाँ साथमा हुनुहुन्छ भन्ने थाहा हुनु संसारमै सबैभन्दा ढुक्क बनाउने कुरा हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrouwbaarheid is alles. Weten dat je partner er is zonder dat je het hoeft te vragen, geeft je meer rust dan wat ook."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudalirika ndi chilichonse. Kudziwa kuti adzakhalapo popanda kupempha ndi chinthu chokhazikitsa mtima kwambiri padziko lapansi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amanamummaan waan hundaa dha. Osoo hin gaafatin deeggarsi akka siif argamu beekuun waan addunyaa irratti caalaatti si tasgabbeessu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଭରସା ହିଁ ସବୁକିଛି। ନ ମାଗିଲେ ବି ସେମାନେ ପାଖରେ ରହିବେ ବୋଲି ଜାଣିବା ଦୁନିଆର ସବୁଠୁ ଆଶ୍ୱାସନାଦାୟକ କଥା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਭਰੋਸਾ ਹੀ ਸਭ ਕੁਝ ਹੈ। ਇਹ ਜਾਣਨਾ ਕਿ ਉਹ ਬਿਨਾਂ ਕਹੇ ਤੁਹਾਡੇ ਕੋਲ ਹੋਣਗੇ, ਦੁਨੀਆ ਦੀ ਸਭ ਤੋਂ ਵੱਧ ਸਕੂਨ ਦੇਣ ਵਾਲੀ ਗੱਲ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezawodność to wszystko. Pewność, że druga połówka będzie przy tobie bez proszenia, daje ci największe poczucie oparcia."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باور هر څه دی. دا پوهېدل چې ستاسو ملګری به بې له غوښتنې درسره وي، په نړۍ کې تر ټولو ډاډ ورکوونکی شی دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poder contar com alguém é tudo. Saber que seu amor vai estar lá sem você precisar pedir é o que mais traz segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiabilidade é tudo. Saber que o teu par vai estar lá sem ser preciso pedir é o que mais te dá chão no mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să te poți baza pe cineva e totul. Să știi că partenerul tău va fi acolo fără să-i ceri e cel mai liniștitor lucru din lume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжность — это всё. Знать, что партнёр будет рядом и просить не придётся, — ничто не успокаивает сильнее."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwizerwa ni byo byose. Kumenya ko azaba ahari utabanje kubimusaba ni cyo kintu gituza umutima kurusha ibindi ku isi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "විශ්වාසවන්තකම තමයි හැමදේම. ඉල්ලන්නෙ නැතුවම ඔබේ සහකරු ළඟ ඉඳියි කියලා දැනගැනීම ලෝකයේ තියෙන වඩාත්ම සනසන දෙයක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoľahlivosť je všetko. Vedieť, že pri tebe bude aj bez prosenia, ťa ukotví ako nič iné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanesljivost je vse. Vedeti, da bo nekdo tu, ne da bi bilo treba prositi, je najbolj pomirjujoč občutek na svetu."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvimbika ndizvo zvose. Kuziva kuti achavapo usina kumbokumbira ndicho chinhu chinonyanya kukudzikamisa pasi pose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku halayntu waa wax walba. Ogaanshaha in lagu garab joogi doono adigoo aan weydiin ayaa ah waxa adduunka ugu dejinta badan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besueshmëria është gjithçka. Të dish që partneri yt do të jetë aty pa pasur nevojë ta kërkosh është gjëja që të jep më shumë siguri në botë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поузданост је све. Знати да ће твоја половина бити ту и без питања — ништа те више не умирује."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiasa diandelkeun téh sagala-galana. Terang yén pasangan bakal aya tanpa kedah dipénta téh hal anu paling ngajantenkeun tengtrem di dunya."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitlighet är allt. Att veta att din partner finns där utan att du behöver be om det är det tryggaste som finns."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutegemewa ni kila kitu. Kujua atakuwepo bila kulazimika kuomba ndicho kitu kinachokutuliza zaidi duniani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நம்பகத்தன்மையே எல்லாம். கேட்காமலேயே அவர் அருகில் இருப்பார் என்று தெரிவதுதான் உலகிலேயே மிகப் பெரிய மன நிம்மதி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నమ్మకమే అన్నీ. అడగాల్సిన అవసరం లేకుండా వారు పక్కన ఉంటారని తెలియడమే ప్రపంచంలో అత్యంత భరోసా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боварӣ ҳама чиз аст. Донистани он ки ёрат бе пурсиш дар паҳлӯят мешавад, аз ҳама чиз бештар туро устувор мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความไว้ใจได้คือทุกอย่าง การรู้ว่าคนรักจะอยู่ตรงนั้นโดยไม่ต้องร้องขอ คือสิ่งที่ทำให้คุณรู้สึกมั่นคงที่สุดในโลก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተኣማንነት ኩሉ ነገር እዩ። ከይሓተትኩም ኣብ ጎንኹም ከም ዝህልዉ ምፍላጥ ካብ ዝኾነ ነገር ንላዕሊ የረጋግኣኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ynamdarlyk hemme zat. Soramazdan onuň ýanyňda boljakdygyny bilmek — dünýäde iň köp daýanç berýän zat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenilir olmak her şey. İstemene gerek kalmadan orada olacağını bilmek, dünyadaki en huzur verici şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійність — це все. Знати, що половинка буде поруч і просити не доведеться, — найбільша опора у світі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بھروسا ہی سب کچھ ہے۔ یہ جاننا کہ بغیر کہے ساتھ مل جائے گا، دنیا کی سب سے زیادہ سکون دینے والی بات ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishonchlilik — hamma narsa. Soʻramasangiz ham sherigingiz yoningizda boʻlishini bilish dunyodagi eng xotirjamlik beruvchi narsa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự đáng tin là tất cả. Biết người ấy sẽ ở đó mà không cần phải nhờ là điều khiến bạn vững lòng nhất trên đời."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka yiyo yonke into. Ukwazi ukuba umntu uya kubakho ngaphandle kokuba ucele yeyona nto ikuzinzisayo emhlabeni."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìgbẹ́kẹ̀lé ni ohun gbogbo. Mímọ̀ pé olólùfẹ́ yín yóò wà níbẹ̀ láìjẹ́ pé ẹ béèrè ni ohun tó ń fini lọ́kàn balẹ̀ jù láyé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠就是一切。知道不用開口，對方也會在身邊，是世上最令人安心的事。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠就是一切。知道不用开口对方也会在，是世上最让人踏实的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠就是一切。知道不用開口，對方也會在身邊，是世界上最讓人安心的事。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka kuyikho konke. Ukwazi ukuthi uzoba khona ungadinganga ukucela yinto ekuzinzisa kakhulu emhlabeni."
          }
        }
      }
    },
    "Reliability is your baseline for trust. Small broken commitments add up and erode confidence." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betroubaarheid is jou basis vir vertroue. Klein gebroke beloftes tel op en kalwe vertroue weg."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቃልን መጠበቅ ለእምነትዎ መሠረት ነው። ትናንሽ ያልተጠበቁ ቃሎች ተደምረው መተማመንን ይሸረሽራሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاعتمادية هي أساس الثقة عندكم. الالتزامات الصغيرة التي لا يُوفى بها تتراكم وتهزّ الثقة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিৰ্ভৰযোগ্যতাই আপোনাৰ বিশ্বাসৰ ভেটি। সৰু সৰু ভংগ হোৱা কথাবোৰ জমা হৈ আস্থা খহাই নিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etibarlılıq sənin üçün güvənin təməlidir. Pozulan kiçik öhdəliklər yığılır və inamı aşındırır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надзейнасць — аснова твайго даверу. Дробныя парушаныя абяцанні назапашваюцца і падточваюць упэўненасць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надеждността е основата на доверието ти. Малките неспазени ангажименти се трупат и рушат увереността."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভরসার ভিত্তিই তোমার কাছে কথা রাখা। ছোট ছোট না-রাখা কথা জমে জমে বিশ্বাস ক্ষয় করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost je tvoja osnova za povjerenje. Mala prekršena obećanja se zbrajaju i nagrizaju sigurnost."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilitat és la teva base per confiar. Els petits compromisos incomplerts se sumen i desgasten la confiança."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolehlivost je pro tebe základ důvěry. Drobné nesplněné závazky se sčítají a podkopávají jistotu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibynadwyedd yw sail dy ymddiriedaeth. Mae ymrwymiadau bach sy'n cael eu torri yn adio i fyny ac yn erydu hyder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålidelighed er dit fundament for tillid. Små brudte aftaler hober sig op og tærer på tilliden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlichkeit ist deine Basis für Vertrauen. Kleine gebrochene Zusagen summieren sich und untergraben das Vertrauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αξιοπιστία είναι η βάση της εμπιστοσύνης σου. Οι μικρές αθετημένες δεσμεύσεις αθροίζονται και τη διαβρώνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilidad es tu base para confiar. Los pequeños compromisos incumplidos se acumulan y desgastan la confianza."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaldusväärsus on su usalduse alus. Väikesed murtud lubadused kogunevad ja õõnestavad kindlustunnet."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fidagarritasuna da zure konfiantzaren oinarria. Bete gabeko konpromiso txikiak pilatu eta konfiantza higatzen dute."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابل اعتماد بودن پایهٔ اعتماد توست. تعهدهای کوچکِ شکسته روی هم جمع می‌شوند و اطمینان را می‌فرسایند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luotettavuus on luottamuksesi perusta. Pienetkin rikotut sitoumukset kasautuvat ja syövät luottamusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagiging maaasahan ang pundasyon ng tiwala mo. Naiipon ang maliliit na napakong pangako at unti-unting sinisira ang kumpiyansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiabilité est la base de ta confiance. Les petits engagements non tenus s'additionnent et l'érodent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an iontaofacht bonn do mhuiníne. Carnann gealltanais bheaga bhriste agus creimeann siad an mhuinín."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiabilidade é a túa base da confianza. Os pequenos compromisos incumpridos vanse sumando e minan a confianza."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ભરોસાનો તમારો પાયો છે વિશ્વસનીયતા. નાનાં નાનાં તૂટેલાં વચનો ભેગાં થઈને વિશ્વાસ ઘસી નાખે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dogaro shi ne tushen amincewarku. Ƙananan alƙawuran da aka karya suna taruwa suna rage yarda."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמינות היא הבסיס שלך לאמון. התחייבויות קטנות שלא קוימו מצטברות ושוחקות את הביטחון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए भरोसे की बुनियाद है वादे निभाना। छोटे-छोटे टूटे वादे जुड़ते जाते हैं और भरोसा कमज़ोर करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost je temelj tvog povjerenja. Mala prekršena obećanja se zbrajaju i nagrizaju sigurnost."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfyans ou chita sou fyab. Ti angajman ki pa respekte yo vin anpil e yo manje konfyans lan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad a megbízhatóság a bizalom alapja. A kis megszegett vállalások összeadódnak, és rombolják a bizalmat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հուսալիությունը քո վստահության հիմքն է։ Փոքր չկատարված խոստումները կուտակվում են ու քայքայում հավատը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa diandalkan adalah dasar kepercayaanmu. Komitmen kecil yang dilanggar lama-lama menumpuk dan mengikis keyakinan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntụkwasị obi gị na-adabere n'ịdị njikere. Obere nkwa a na-emezughị na-agbakọ ma na-emebi ntụkwasị obi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áreiðanleiki er grunnurinn að trausti hjá þér. Lítil svikin loforð safnast upp og grafa undan traustinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per te l’affidabilità è la base della fiducia. Tanti piccoli impegni non mantenuti si sommano e la logorano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼の土台は、約束を守ること。小さな約束破りも積み重なると、信頼を少しずつ削っていきます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa dipercaya iku dhasar kapercayan panjenengan. Janji cilik sing diblenjani suwe-suwe numpuk lan ngrusak kapercayan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საიმედოობა შენთვის ნდობის საფუძველია. პატარა შეუსრულებელი დაპირებები გროვდება და ნდობას ძირს უთხრის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенімділік — сенің сеніміңнің негізі. Орындалмаған ұсақ уәделер жиналып, сенімді шайқалтады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពជឿទុកចិត្តបាន គឺជាមូលដ្ឋាននៃការទុកចិត្តរបស់អ្នក។ ការមិនរក្សាពាក្យតូចៗបូកបញ្ចូលគ្នា ហើយធ្វើឲ្យជំនឿចិត្តរសាត់បាត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಂಬಿಕೆಗೆ ನಿಮ್ಮ ಅಡಿಪಾಯ ವಿಶ್ವಾಸಾರ್ಹತೆ. ಸಣ್ಣ ಸಣ್ಣ ಮುರಿದ ಮಾತುಗಳು ಸೇರಿ ವಿಶ್ವಾಸವನ್ನು ಸವೆಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믿을 수 있는지가 신뢰의 기본이에요. 사소한 약속이라도 자꾸 어기면 믿음이 조금씩 무너져요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêbawerî bingeha baweriya te ye. Sozên biçûk ên neanîn kom dibin û baweriyê dixwin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ишенимдүүлүк — сенин ишенимиңдин пайдубалы. Кичинекей аткарылбаган убадалар топтолуп, ишенимди жешет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlechkeet ass d'Basis vun dengem Vertrauen. Kleng gebrach Zouso leeë sech op an zerstéieren d'Vertrauen lues a lues."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມໄວ້ໃຈໄດ້ຄືພື້ນຖານຄວາມເຊື່ອໃຈຂອງເຈົ້າ ຄຳໝັ້ນນ້ອຍໆທີ່ຖືກລະເມີດສະສົມກັນ ແລະ ກັດກ່ອນຄວາມໝັ້ນໃຈ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patikimumas – tavo pasitikėjimo pagrindas. Maži neištesėti įsipareigojimai kaupiasi ir griauna pasitikėjimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzticamība ir tavas uzticēšanās pamats. Mazi nepildīti solījumi sakrājas un grauj paļāvību."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fahatokisana no fototry ny fitokisanao. Mitambatra ireo fanoloran-tena kely tsy notanana ka manimba ny fitokisana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pono tō tūāpapa mō te whakawhirinaki. Ko ngā kī taurangi iti kua whatiia ka kohikohi, ka horo te whakapono."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурноста ти е основа за доверба. Малите прекршени обврски се собираат и ја нагризуваат довербата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ വിശ്വാസത്തിന്റെ അടിസ്ഥാനം ആശ്രയിക്കാനാവുക എന്നതാണ്. പാലിക്കാത്ത ചെറിയ വാക്കുകൾ കൂടിക്കൂടി വന്ന് വിശ്വാസം ഇല്ലാതാക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдвартай байдал бол чиний итгэлийн суурь. Биелээгүй жижиг амлалтууд хуримтлагдаж, итгэлийг сулруулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विश्वासार्हता हा तुमच्या विश्वासाचा पाया आहे. छोटी छोटी न पाळलेली वचनेही साचत जातात आणि भरवसा कमी करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebolehpercayaan ialah asas kepercayaan anda. Komitmen kecil yang dimungkiri bertimbun dan menghakis keyakinan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-affidabbiltà hija l-bażi tal-fiduċja tiegħek. Impenji żgħar li ma jinżammux jinġabru u jnaqqsu l-fiduċja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အားကိုးလို့ရတာက သင့်ယုံကြည်မှုရဲ့ အခြေခံပါ။ သေးငယ်တဲ့ ကတိဖျက်မှုတွေ စုလာရင် ယုံကြည်မှုကို တဖြည်းဖြည်း တိုက်စားတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitelighet er grunnmuren for tilliten din. Små brutte avtaler hoper seg opp og tærer på tryggheten."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भरोसाको आधार नै विश्वसनीयता हो। साना-साना तोडिएका वाचा थुप्रिँदै गएर विश्वास खियाउँछन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrouwbaarheid is jouw basis voor vertrouwen. Kleine niet-nagekomen afspraken tellen op en vreten aan je vertrouwen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudalirika ndiye maziko a chikhulupiriro chanu. Malonjezo ang'onoang'ono osakwaniritsidwa amachulukana n'kuwononga chidaliro."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amanamummaan bu'uura amantaa keeti. Waadaan xixiqqoon cabe walitti dabalamee amantaa balleessa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଭରସାଯୋଗ୍ୟତା ହିଁ ଆପଣଙ୍କ ବିଶ୍ୱାସର ମୂଳଦୁଆ। ଛୋଟ ଛୋଟ ଭଙ୍ଗା ପ୍ରତିଶ୍ରୁତି ଜମି ବିଶ୍ୱାସକୁ କ୍ଷୟ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਲਈ ਭਰੋਸੇ ਦੀ ਨੀਂਹ ਵਾਅਦੇ ਨਿਭਾਉਣਾ ਹੈ। ਛੋਟੇ-ਛੋਟੇ ਟੁੱਟੇ ਵਾਅਦੇ ਜੁੜ ਕੇ ਯਕੀਨ ਨੂੰ ਖੋਰਾ ਲਾਉਂਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezawodność to fundament twojego zaufania. Drobne niedotrzymane zobowiązania sumują się i podkopują pewność."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د ژمنې پوره کول ستاسو د باور بنسټ دی. وړې ماتې ژمنې سره راټولېږي او باور کمزوری کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser confiável é a base da confiança para você. Pequenos compromissos quebrados se somam e minam a segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiabilidade é a tua base para a confiança. Pequenos compromissos falhados acumulam-se e minam a segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriozitatea e pentru tine temelia încrederii. Micile promisiuni neținute se adună și o erodează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжность — основа твоего доверия. Мелкие невыполненные обещания копятся и подтачивают уверенность."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwizerwa ni ishingiro ry'icyizere cyawe. Amasezerano mato atubahirizwa agenda yiyongera agasenya icyizere."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "විශ්වාසවන්තකම තමයි ඔබේ විශ්වාසයේ පදනම. කඩවුණු පොඩි පොරොන්දු එකතු වෙලා විශ්වාසය ඛාදනය කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoľahlivosť je základ tvojej dôvery. Malé nedodržané záväzky sa sčítavajú a nahlodávajú istotu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanesljivost je tvoj temelj zaupanja. Majhne prelomljene zaveze se seštevajo in načenjajo zaupanje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvimbika ndiyo nheyo yekuvimba kwako. Zvivimbiso zvidiki zvakaputswa zvinowanda zvopedza chivimbo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku halayntu waa saldhigga kalsoonidaada. Ballamo yaryar oo la jebiyo way isku darsamaan oo kalsoonida ayay nabaadguuraan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besueshmëria është baza jote e besimit. Angazhimet e vogla të pambajtura grumbullohen dhe e gërryejnë sigurinë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поузданост је твоја основа поверења. Мала прекршена обећања се сабирају и нагризају поверење."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiasa diandelkeun téh dasar kapercayaan anjeun. Jangji leutik anu teu ditepati numpuk sareng ngirangan kapercayaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitlighet är din grund för tillit. Små svikna åtaganden blir många till slut och nöter på förtroendet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutegemewa ndio msingi wa imani yako. Ahadi ndogo zinazovunjwa hujumlika na kumomonyoa imani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நம்பகத்தன்மையே உங்கள் நம்பிக்கையின் அடித்தளம். சிறிய வாக்குறுதி மீறல்களும் சேர்ந்து நம்பிக்கையை அரித்துவிடும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నమ్మకానికి మీ పునాది మాట నిలబెట్టుకోవడమే. చిన్న చిన్న మాట తప్పడాలు పేరుకుపోయి నమ్మకాన్ని తగ్గిస్తాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боварӣ асоси эътимоди туст. Ваъдаҳои хурди иҷронашуда ҷамъ шуда, эътимодро суст мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรักษาคำพูดคือพื้นฐานของความเชื่อใจสำหรับคุณ คำสัญญาเล็กๆ ที่ไม่ได้รักษาสะสมไปเรื่อยๆ จนบั่นทอนความเชื่อมั่น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተኣማንነት መሰረት እምነትኩም እዩ። ንኣሽቱ ዝተሰብሩ መብጽዓታት ተኣኪቦም እምነት ይሽርሽሩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ynamdarlyk seniň ynamyňyň esasy. Kiçi bozulan sözler ýygnanyp, ynamy gowşadýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin için güvenin temeli sözünde durmak. Küçük de olsa tutulmayan sözler birikir ve güveni aşındırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійність — твоя основа довіри. Дрібні невиконані обіцянки накопичуються й підточують упевненість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے بھروسے کی بنیاد قول کا پکا ہونا ہے۔ چھوٹے چھوٹے ٹوٹے وعدے جمع ہو کر اعتماد کو کمزور کر دیتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishonchlilik — siz uchun ishonchning asosi. Bajarilmagan mayda vaʼdalar toʻplanib, ishonchni yemiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với bạn, giữ lời là nền móng của niềm tin. Những lời hứa nhỏ bị bỏ dở cứ cộng dồn và làm lòng tin hao mòn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka sisiseko sakho sokuthemba. Izithembiso ezincinci ezaphukileyo ziyanqwabelana zize zonakalise intembeko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣíṣe bí a ti wí ni ìpìlẹ̀ ìgbẹ́kẹ̀lé fún yín. Àwọn ìlérí kékeré tí a dà máa ń kóra jọ, wọ́n sì ń ba ìgbàgbọ́ jẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠是你信任的基礎。小小的失信一點一滴累積，就會磨掉你的信心。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠是你信任的底线。小小的失约积累起来，会慢慢消磨信心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠是你信任的基礎。小小的失信一點一滴累積，就會磨掉你的信心。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka kuyisisekelo sokwethemba kwakho. Izithembiso ezincane ezephulwayo ziyanqwabelana zibe sezilinyazisa ukwethemba."
          }
        }
      }
    },
    "Reliability over heroics. You're not there for the drama — you're there in the daily showing up." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betroubaarheid bo heldedade. Jy is nie daar vir die drama nie – jy is daar in die daaglikse opdaag."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከጀግንነት ይልቅ አስተማማኝነት። የሚገኙት ለድራማው አይደለም — በየዕለቱ በመገኘት ውስጥ ነው ያሉት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الثبات قبل البطولات. لستم هنا من أجل اللحظات الدرامية، بل من أجل الحضور في تفاصيل كل يوم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বীৰত্বতকৈ নিৰ্ভৰযোগ্যতা। আপুনি নাটকীয়তাৰ বাবে নাথাকে — দৈনিক উপস্থিতিৰ মাজেৰেই আপুনি কাষত থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qəhrəmanlıqdan çox etibarlılıq. Dram üçün yox — hər gün yanında olmaq üçün varsan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надзейнасць, а не подзвігі. Ты не дзеля драмы — ты проста побач кожны дзень."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надеждност пред героизъм. Не си там заради драмата – а в ежедневното присъствие."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বীরত্বের চেয়ে নির্ভরযোগ্যতা। তুমি নাটকের জন্য থাকো না — থাকো রোজকার উপস্থিতিতে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost umjesto herojstva. Nisi tu zbog drame – tu si iz dana u dan."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constància per sobre d'heroïcitats. No hi ets pel drama — hi ets en el dia a dia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolehlivost místo hrdinských gest. Nejde ti o drama – jde ti o to být tu každý den."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibynadwyedd yn hytrach nag arwriaeth. Dwyt ti ddim yno ar gyfer y ddrama — rwyt ti yno yn y pethau bach bob dydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålidelighed frem for heltegerninger. Du er der ikke for dramaet – du er der ved at dukke op hver eneste dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlichkeit statt Heldentaten. Du bist nicht fürs Drama da – sondern dafür, jeden Tag aufs Neue da zu sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνέπεια πάνω από τους ηρωισμούς. Δεν είσαι εκεί για το δράμα — είσαι εκεί κάθε μέρα, σταθερά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiabilidad antes que heroicidades. No estás ahí por el drama: estás en lo cotidiano, día tras día."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaldusväärsus kangelastegude asemel. Sa pole kohal draama pärast — sa oled kohal igapäevases olemasolus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fidagarritasuna, heroikerien gainetik. Ez zaude hor dramagatik: egunero agertzean zaude."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابل اعتماد بودن به‌جای قهرمان‌بازی. برای هیجانش آنجا نیستی — در حضور هرروزه‌ات هستی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luotettavuus ennen sankaritekoja. Et ole mukana draaman takia – olet läsnä arjessa päivästä toiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagiging maaasahan kaysa kabayanihan. Hindi ka nandiyan para sa drama — nandiyan ka araw-araw, kahit sa maliliit na bagay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constance plutôt que l'héroïsme. Tu n'es pas là pour les grands gestes, mais pour répondre présent au quotidien."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iontaofacht thar ghaisce. Ní ar mhaithe leis an drámaíocht atá tú ann — bíonn tú ann sa láithreacht laethúil."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiabilidade antes ca heroicidades. Non estás aí polo drama: estás aí no día a día, aparecendo sempre."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મોટાં પરાક્રમ કરતાં ભરોસાપાત્રતા. તમે નાટક માટે નથી — રોજ હાજર રહેવામાં તમે સાથે છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dogaro ya fi jarumta. Ba don wasan kwaikwayo kuke nan ba — kuna nan ne a cikin bayyana a kowace rana."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמינות במקום גבורה. הדרמה לא מעניינת אותך — מה שחשוב לך זה להיות שם, יום אחרי יום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े कारनामों से ज़्यादा भरोसेमंद होना। आप ड्रामे के लिए नहीं, रोज़-रोज़ साथ निभाने के लिए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouzdanost umjesto junaštva. Nisi tu zbog drame – tu si u svakodnevnom pojavljivanju."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyab pase ewo. Ou pa la pou dram nan — ou la chak jou, san rate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megbízhatóság a hőstettek helyett. Nem a drámáért vagy ott – hanem a mindennapi jelenlétben."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հուսալիություն՝ սխրանքների փոխարեն։ Դու այնտեղ ես ոչ թե դրամայի, այլ ամենօրյա ներկայության համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa diandalkan, bukan heroik. Kamu tidak hadir demi drama — kamu hadir lewat kebiasaan sehari-hari."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntụkwasị obi karịa ịme dike. Ị nọghị ebe ahụ maka mkpọtụ — ị nọ ebe ahụ n'ịbịa kwa ụbọchị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áreiðanleiki frekar en hetjudáðir. Þú ert ekki til staðar fyrir dramað – heldur í því að mæta dag eftir dag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affidabilità più che eroismi. Non ci sei per il dramma — ci sei nella presenza di ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒーローより、信頼できる存在。特別な場面のためではなく、毎日そばにいることで支えています。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa diandelake luwih aji tinimbang dadi pahlawan. Panjenengan ora ana kanggo drama — panjenengan ana liwat tekane saben dina."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საიმედოობა გმირობაზე მეტია. დრამისთვის კი არ ხარ გვერდით — ყოველდღიური ყოფნით ამტკიცებ ამას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ерлік емес, сенімділік. Сен драма үшін емес, күн сайын қасында болу үшін барсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពអាចទុកចិត្តបាន លើសពីវីរភាព។ អ្នកមិនមែននៅទីនោះសម្រាប់រឿងល្ខោនទេ — អ្នកនៅទីនោះតាមរយៈការមករករៀងរាល់ថ្ងៃ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಾಹಸಕ್ಕಿಂತ ನಂಬಿಕೆಗೆ ಅರ್ಹತೆ. ನೀವು ನಾಟಕೀಯ ಕ್ಷಣಗಳಿಗಾಗಿ ಅಲ್ಲ — ಪ್ರತಿದಿನದ ಜೊತೆಗಿರುವಿಕೆಯಲ್ಲಿ ಇರುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "극적인 영웅보다 믿음직한 사람이에요. 거창한 순간이 아니라 매일 곁에 있어 주는 데서 사랑을 보여 줘요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêbawerî ji qehremaniyê girîngtir e. Tu ne ji bo dramayê li wir î — tu her roj li wir î."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баатырдыктан көрө ишенимдүүлүк. Драма үчүн эмес — күн сайын жанында болуу менен колдойсуң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässlechkeet virun Heldentaten. Du bass net fir d'Drama do — du bass do, all Dag, ëmmer erëm."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໜ້າເຊື່ອຖືຫຼາຍກວ່າວິລະກຳ ເຈົ້າບໍ່ໄດ້ມາເພື່ອຄວາມຕື່ນເຕັ້ນ — ເຈົ້າຢູ່ຄຽງຂ້າງໃນທຸກໆມື້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patikimumas, o ne žygdarbiai. Esi šalia ne dėl dramos – o kasdien, paprastais darbais."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzticamība, nevis varoņdarbi. Tu neesi tur drāmas dēļ – tu esi klāt ikdienā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahatokiana mihoatra noho ny fahasahiana mahavariana. Tsy eo noho ny tantara mampientanentana ianao — fa eo amin'ny fanatrehana isan'andro."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pūmau i mua i te toa. Ehara i te mea kei reira koe mō te whakaari — kei reira koe i te tae mai ia rā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурност пред херојство. Не си тука за драмата — туку во секојдневното присуство."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വീരകൃത്യങ്ങളേക്കാൾ വിശ്വസ്തത. നാടകീയതയ്ക്കല്ല നിങ്ങൾ കൂടെയുള്ളത് — എല്ലാ ദിവസവും ഒപ്പമുണ്ടാകുന്നതിലാണ് കാര്യം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баатарлаг үйлсээс илүү найдвартай байдал. Чи жүжиглэлийн төлөө биш — өдөр бүр хажууд нь байхын төлөө байдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोठ्या पराक्रमांपेक्षा विश्वासार्हता. तुम्ही नाट्यासाठी नसता — रोज न चुकता सोबत असण्यात तुमचे प्रेम दिसते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh diharap, bukan sekadar wira sekali-sekala. Anda bukan hadir untuk drama — anda hadir setiap hari, tanpa gagal."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affidabbiltà aktar milli eroiżmu. M'intix hemm għad-drama — int hemm f'kuljum, dejjem preżenti."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သူရဲကောင်းဆန်တာထက် အားကိုးရမှု။ အဖြစ်အပျက်ကြီးတွေအတွက် ရှိနေတာ မဟုတ်ဘူး — နေ့စဉ် အနားရောက်နေပေးခြင်းထဲမှာ ရှိတာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitelighet framfor heltedåder. Du er ikke der for dramaet – du er der i det å stille opp hver dag."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठुलो वीरताभन्दा भरपर्दोपन। तपाईं नाटकीय क्षणका लागि होइन — हरेक दिनको साथका लागि हुनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrouwbaarheid boven heldendaden. Het gaat jou niet om het drama – je bent er gewoon, elke dag weer."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudalirika kuposa ngwazi. Simuli komweko chifukwa cha phokoso — muli komweko pakupezeka tsiku ndi tsiku."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gootummaa caalaa amanamummaa. Diraamaaf hin argamtu — guyyaa guyyaan argamuun jirta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବୀରତ୍ୱଠାରୁ ଭରସାଯୋଗ୍ୟତା ବଡ଼। ଆପଣ ନାଟକୀୟ ମୁହୂର୍ତ୍ତ ପାଇଁ ନୁହେଁ — ପ୍ରତିଦିନ ପାଖରେ ରହିବାରେ ବିଶ୍ୱାସ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਡੇ ਕਾਰਨਾਮਿਆਂ ਨਾਲੋਂ ਭਰੋਸੇਯੋਗਤਾ। ਤੁਸੀਂ ਡਰਾਮੇ ਲਈ ਨਹੀਂ — ਰੋਜ਼ ਦੇ ਸਾਥ ਲਈ ਮੌਜੂਦ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezawodność zamiast bohaterstwa. Nie chodzi ci o wielkie sceny – liczy się dla ciebie codzienna obecność."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باور تر اتلولۍ غوره. تاسو د ډرامې لپاره نه یاست — تاسو په ورځني حضور کې هلته یاست."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constância acima de heroísmo. Você não está ali pelo drama — está ali marcando presença todo dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiabilidade acima de heroísmos. Não estás lá pelo drama — estás lá no dia a dia, sempre presente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statornicie, nu eroism. Nu ești acolo pentru dramă — ești acolo în fiecare zi, prin prezența ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжность важнее подвигов. Тебе не нужна драма — ты рядом каждый день."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwizerwa kurusha ubutwari bw'akanya gato. Ntuhaba kubera ibintu bikomeye — uhaba mu kwigaragaza buri munsi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වීරකම් වලට වඩා විශ්වාසනීයත්වය. ඔබ ඉන්නේ නාට්‍යය වෙනුවෙන් නෙවෙයි — දවසින් දවස ළඟින් ඉන්න එකෙන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoľahlivosť pred hrdinstvom. Nejde ti o veľké gestá – podpora je pre teba každodenná prítomnosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanesljivost pred junaštvom. Ne gre ti za dramo – zraven si vsak dan, znova in znova."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvimbika kupfuura ushingi hukuru. Hausi ipapo nekuda kwedhirama — uripo mukuuya kwezuva nezuva."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku halleyn ka badan geesinimo. Uma joogtid xamaasadda — waxaad joogtaa maalin kasta adigoo soo muuqda."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besueshmëri më shumë se heroizëm. Nuk je aty për dramën – je aty në praninë e përditshme."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поузданост пре херојства. Ниси ту због драме — ту си у свакодневном појављивању."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiasa dipercanten langkung ti kapahlawanan. Anjeun aya sanés kanggo dramana; anjeun aya dina kahadiran unggal dinten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitlighet framför hjältedåd. Du är inte där för dramat – du är där i det vardagliga, dag efter dag."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutegemewa kuliko ushujaa. Hauko pale kwa ajili ya makubwa — uko pale kwa kujitokeza kila siku."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீரச் செயல்களைவிட நம்பகத்தன்மை. நாடகத்திற்காக அல்ல — தினமும் உடனிருப்பதில்தான் நீங்கள் இருக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "హీరోయిజం కన్నా నమ్మకమే ముఖ్యం. మీరు హడావుడి కోసం కాదు — రోజూ తోడుగా ఉండటంలోనే ఉంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эътимоднокӣ аз қаҳрамонӣ болотар. Ту барои драма нестӣ — ту дар ҳузури ҳаррӯза ҳастӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความมั่นคงสำคัญกว่าวีรกรรม คุณไม่ได้อยู่เพื่อฉากดราม่า แต่อยู่ตรงนั้นในทุกๆ วันธรรมดา"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ጅግንነት ተኣማንነት። ንድራማ ኣይኮንኩምን ዘለኹም — ኣብቲ ዕለታዊ ምህላው ኢኹም ትርከቡ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahrymançylykdan has ygtybarlylyk. Sen dramatik pursatlar üçin däl — gündelik ýanynda bolmak üçin barsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahramanlık değil, güvenilirlik. Drama için değil, her gün yanında olmak için oradasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійність замість героїзму. Ти не про драму — ти про те, щоб бути поруч щодня."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہادری سے بڑھ کر بھروسا۔ آپ کا ساتھ ڈرامے میں نہیں، روز کی موجودگی میں ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qahramonlikdan koʻra ishonchlilik. Siz dramatik lahzalar uchun emas — har kungi gʻamxoʻrlik uchun yonidasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đáng tin cậy hơn là làm người hùng. Bạn không ở đó vì kịch tính — bạn ở đó qua sự có mặt mỗi ngày."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka ngaphezu kobuqhawe. Akukho apho ngenxa yedrama — ukhona ngokuzibonakalisa yonke imihla."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdúróṣinṣin ju akíkanjú lọ. Ẹ kò sí níbẹ̀ fún ariwo — ẹ wà níbẹ̀ nínú wíwá lójoojúmọ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可靠勝過英雄式的壯舉。你不是為了大場面而出現，而是在每天的點滴中陪伴。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靠得住，胜过轰轰烈烈。你的陪伴不在戏剧性的时刻，而在每天的出现里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起英雄式的壯舉，你更重視可靠。你不追求轟轟烈烈，而是在每天的日常裡默默出現。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthembeka kunobuqhawe. Awukho ngenxa yomdlalo — ukhona ngokuvela nsuku zonke."
          }
        }
      }
    },
    "Resolution-focused. You see the relationship as bigger than the disagreement. That's a real strength." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplossingsgerig. Vir jou is die verhouding groter as die meningsverskil. Dis ’n regte sterkpunt."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መፍትሔ ላይ ያተኮሩ ነዎት። ግንኙነቱን ከአለመግባባቱ በላይ ያዩታል። ይህ እውነተኛ ጥንካሬ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تركيزكم على الحل. ترون العلاقة أكبر من أي خلاف، وهذه قوة حقيقية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমাধানমুখী। আপোনাৰ বাবে সম্পৰ্কটো মতানৈক্যতকৈ ডাঙৰ। এয়া এক সঁচা শক্তি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həllə yönəlmisən. Münasibəti mübahisədən daha böyük görürsən. Bu, əsl güclü cəhətdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе важна знайсці рашэнне. Для цябе адносіны большыя за любую спрэчку. Гэта сапраўдная моц."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насочваш се към решението. За теб връзката е по-голяма от несъгласието. Това е истинска сила."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার চোখ সমাধানে। তোমার কাছে সম্পর্কটা মতের অমিলের চেয়ে বড়। এটা সত্যিই একটা শক্তি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus na rješenje. Vezu vidiš kao nešto veće od neslaganja. To je prava snaga."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mires cap a la solució. Veus la relació com una cosa més gran que la discussió. Això és una gran fortalesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Míříš k řešení. Vztah je pro tebe větší než jakákoli neshoda. To je skutečná síla."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n canolbwyntio ar ddatrys. Rwyt ti'n gweld y berthynas yn fwy na'r anghytundeb. Mae hynny'n gryfder go iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er fokuseret på løsninger. Du ser forholdet som større end uenigheden. Det er en reel styrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du willst eine Lösung. Eure Beziehung ist dir wichtiger als der Streitpunkt. Das ist eine echte Stärke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εστιάζεις στη λύση. Βλέπεις τη σχέση ως κάτι μεγαλύτερο από τη διαφωνία. Αυτό είναι πραγματική δύναμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te centras en la solución. Para ti, la relación es más grande que el desacuerdo. Eso es una verdadera fortaleza."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lahendusele keskendunud. Suhe on sinu jaoks suurem kui lahkarvamus. See on tõeline tugevus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konponbideari begira. Harremana desadostasuna baino handiagoa dela ikusten duzu. Benetako indargunea da hori."
