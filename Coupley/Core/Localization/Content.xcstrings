    "Alignment on the big things — how you want to live, what you're building. Compatibility of vision matters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توافق على الأمور الكبرى: كيف تريدان العيش، وماذا تبنيان. تقارب الرؤية مهم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoda ve velkých věcech – jak chcete žít, co budujete. Záleží na tom, jestli máte stejnou vizi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enighed om de store ting – hvordan I vil leve, hvad I bygger op. Det betyder noget, at jeres visioner passer sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einigkeit in den großen Dingen – wie ihr leben wollt, was ihr aufbaut. Eine gemeinsame Vision zählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμφωνία στα μεγάλα — πώς θέλετε να ζήσετε, τι χτίζετε. Μετράει να ταιριάζει το όραμά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar en sintonía en lo importante — cómo vivir, qué construir juntos. Compartir una visión importa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteinen linja isoissa asioissa – miten haluatte elää ja mitä rakennatte. Visioiden yhteensopivuus on tärkeää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkakasundo sa malalaking bagay — kung paano ninyo gustong mabuhay, ano ang binubuo ninyo. Mahalaga ang tugmang pananaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être d'accord sur l'essentiel — comment vous voulez vivre, ce que vous construisez. Partager la même vision compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיאום בדברים הגדולים — איך רוצים לחיות, מה בונים. התאמה בחזון חשובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़ी बातों पर तालमेल — कैसे जीना है, क्या बना रहे हैं। एक जैसा नज़रिया मायने रखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetértés a nagy dolgokban – hogyan akartok élni, mit építetek. Számít, hogy a jövőképetek összeillik-e."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepaham soal hal-hal besar — bagaimana kalian ingin hidup, apa yang sedang kalian bangun. Kesamaan visi itu penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essere in sintonia sulle grandi cose — come volete vivere, cosa state costruendo. Condividere la stessa visione conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大事なことでの一致。どう生きたいか、何を築いていくか。描く未来が重なっていることが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떻게 살고 싶은지, 무엇을 함께 만들어 가는지 같은 큰 것들이 맞아야 해요. 그리는 미래가 맞는지가 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehaluan dalam perkara besar — cara anda mahu hidup, apa yang anda bina. Keserasian visi itu penting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enighet om de store tingene – hvordan dere vil leve, hva dere bygger. Det betyr mye å ha samme visjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op één lijn over de grote dingen – hoe je wilt leven, wat je samen opbouwt. Een gedeelde visie doet ertoe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgoda w najważniejszych sprawach – jak chcecie żyć, co budujecie. Liczy się zgodność wizji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhamento nas grandes coisas — como querem viver, o que estão construindo. Ter a mesma visão importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acord asupra lucrurilor mari — cum vreți să trăiți, ce construiți. Contează să aveți aceeași viziune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласие в главном — как вы хотите жить и что строите. Важно смотреть в одну сторону."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att vara överens om det stora – hur ni vill leva, vad ni bygger. En gemensam vision spelar roll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นตรงกันในเรื่องใหญ่ๆ ทั้งการใช้ชีวิตและสิ่งที่กำลังสร้าง วิสัยทัศน์ที่เข้ากันได้สำคัญมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük konularda uyum: nasıl yaşamak istediğiniz, ne inşa ettiğiniz. Vizyon uyumu önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згода в головному — як ви хочете жити, що будуєте. Важить сумісність бачення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng điệu ở những điều lớn — cách hai bạn muốn sống, điều hai bạn đang xây dựng. Chung tầm nhìn mới là điều quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大事上合拍：想怎么生活、要一起建立什么。愿景契合很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大事上有共識，像是想怎麼生活、一起打造什麼。願景契合很重要。"
          }
        }
      }
    },
