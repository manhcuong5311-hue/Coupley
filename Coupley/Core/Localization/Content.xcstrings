        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubiganiraho ni bwo buryo bwawe bwo kubyakira. Kumvwa no gusobanukirwa ni byo ukeneye mbere ya byose."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කතා කරලා බලන එක තමයි ඔබ දේවල් තේරුම් ගන්න විදිහ. වෙන ඕනෑම දෙයකට කලින් ඔබට ඕනේ කවුරුහරි ඔබට ඇහුම්කන් දීලා තේරුම් ගන්න එකයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veci spracúvaš tak, že sa o nich porozprávaš. Najprv potrebuješ, aby ťa niekto vypočul a pochopil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko stvari predebatiraš, jih predelaš. Najprej potrebuješ, da te nekdo sliši in razume."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutaura nezvazvo ndiyo nzira yaunonzwisisa nayo zvinhu. Kunzwiwa nekunzwisiswa ndizvo zvaunoda pamberi pezvimwe zvose."
