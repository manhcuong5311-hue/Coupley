        }
      }
    },
    "A more committed choice that affects many shared meals and dining decisions. Alignment here is genuinely important." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار أكثر التزامًا يمسّ كثيرًا من الوجبات المشتركة وقرارات الخروج. التفاهم هنا مهم حقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zásadnější volba, která ovlivňuje spoustu společných jídel i rozhodnutí, kam jít jíst. Shoda je tady opravdu důležitá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et mere forpligtende valg, der påvirker mange fælles måltider og valg af spisesteder. Her betyder det virkelig noget at være på linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine klare Entscheidung, die viele gemeinsame Mahlzeiten und Restaurantwahlen betrifft. Hier auf einer Linie zu sein, ist wirklich wichtig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πιο δεσμευτική επιλογή που επηρεάζει πολλά κοινά γεύματα και αποφάσεις για έξοδο. Εδώ η συμφωνία μετράει πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una elección más firme que afecta a muchas comidas compartidas y decisiones a la hora de salir. Estar en sintonía aquí importa de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitoutuneempi valinta, joka vaikuttaa moniin yhteisiin aterioihin ja ravintolavalintoihin. Yhteinen linja on tässä oikeasti tärkeä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas seryosong desisyon ito na nakaaapekto sa maraming sabay na pagkain at pagpili ng kainan. Talagang mahalaga na magkasundo kayo rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un choix plus engagé, qui touche beaucoup de repas et de sorties à deux. Être sur la même longueur d'onde là-dessus compte vraiment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירה מחייבת יותר, שמשפיעה על הרבה ארוחות משותפות ועל ההחלטות איפה לאכול. כאן התאמה באמת חשובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ज़्यादा पक्का फ़ैसला, जिसका असर साथ के कई खानों और बाहर खाने के फ़ैसलों पर पड़ता है। इस पर तालमेल सच में अहम है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elkötelezettebb döntés, ami sok közös étkezést és étteremválasztást érint. Itt tényleg fontos az összhang."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan yang lebih teguh dan memengaruhi banyak momen makan bareng. Kesepahaman soal ini benar-benar penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scelta più impegnativa che incide su tanti pasti condivisi e sulle uscite al ristorante. Essere in sintonia qui conta davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くの食事や外食の選択に関わる、しっかりとした選択です。ここで足並みがそろっているかは、本当に大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께하는 식사와 외식 선택에 많은 영향을 주는, 더 확고한 선택이에요. 이 부분에서 서로 맞추는 건 정말 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan yang lebih tegas dan memberi kesan pada banyak hidangan serta keputusan makan bersama. Sependapat dalam hal ini memang penting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tydeligere valg som påvirker mange felles måltider og restaurantvalg. Her er det virkelig viktig å være enige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verdergaande keuze die veel gedeelde maaltijden bepaalt, en ook waar jullie uit eten gaan. Op één lijn zitten is hier echt belangrijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardziej zdecydowany wybór, który wpływa na wiele wspólnych posiłków i decyzji przy stole. Zgodność w tej kwestii naprawdę ma znaczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma escolha mais firme, que afeta muitas refeições e decisões a dois. Estar na mesma página aqui importa de verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O alegere mai fermă, care influențează multe mese împreună și deciziile despre unde mâncați. Aici, potrivirea chiar contează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более серьёзный выбор, который влияет на многие совместные трапезы и походы в рестораны. Здесь согласие действительно важно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett mer genomgripande val som påverkar många gemensamma måltider och restaurangval. Att ni är överens här är verkligen viktigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นทางเลือกที่จริงจังกว่า และส่งผลต่อมื้ออาหารและการเลือกร้านร่วมกันหลายครั้ง การเห็นตรงกันในเรื่องนี้จึงสำคัญจริงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birçok ortak yemeği ve dışarıda yeme kararını etkileyen daha kararlı bir tercih. Burada aynı noktada olmak gerçekten önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серйозніший вибір, що впливає на багато спільних трапез і рішень, де поїсти. Тут справді важливо бути на одній хвилі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lựa chọn gắn bó hơn, ảnh hưởng đến nhiều bữa ăn chung và quyết định ăn uống. Thống nhất ở điểm này thực sự quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是更坚定的选择，会影响很多一起吃的饭和用餐决定。在这件事上合拍真的很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是更堅定的選擇，會影響很多一起吃飯和外食的決定。在這點上有共識真的很重要。"
          }
        }
      }
    },
