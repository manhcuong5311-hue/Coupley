        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿದ್ರೆ ನಿಮ್ಮ ಮೂಡ್, ತಾಳ್ಮೆ ಮತ್ತು ಸಂಗಾತಿಯಾಗಿ ನೀವು ಎಷ್ಟು ಜೊತೆಗಿರಬಲ್ಲಿರಿ ಎಂಬುದರ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ."
