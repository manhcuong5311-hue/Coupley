        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinananatili mo siyang kasama sa araw-araw mong buhay. Makahulugan sa’yo ang mga nakasanayan at bagay na nag-uugnay sa inyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gardes une place pour l'autre dans ton quotidien. Les rituels partagés et les petites associations comptent beaucoup pour toi."
