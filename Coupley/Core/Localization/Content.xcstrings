        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከፍተኛ መጣጣም። መመገብም ውጭ መውሰድም ቀላል ነዎት። ደፋር ጣዕም ሳይኖርዎት አይቀርም።"
