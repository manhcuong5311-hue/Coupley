    "Encouragement and belief that I'll get through it" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التشجيع والإيمان بأنني سأتجاوز الأمر"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povzbuzení a víru, že to zvládnu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmuntring og tro på, at jeg klarer det"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermutigung – dass du an mich glaubst"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενθάρρυνση και πίστη ότι θα τα καταφέρω"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánimo y confianza en que lo voy a superar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannustusta ja uskoa, että selviän"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakas ng loob at tiwala na malalagpasan ko ito"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des encouragements et sentir qu'on croit en moi"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עידוד ואמונה שאעבור את זה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हौसला, और यह यक़ीन कि सब पार हो जाएगा"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztatás, és hogy higgy bennem"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semangat dan keyakinan bahwa aku bisa melewatinya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoraggiamento e fiducia che ce la farò"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「きっと乗り越えられる」と励ましてほしい"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응원하고 해낼 거라고 믿어 줘요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galakan dan keyakinan bahawa saya boleh harunginya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppmuntring og tro på at jeg klarer det"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanmoediging en geloof dat het me lukt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otucha i wiara, że dam radę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incentivo e fé de que vou dar conta"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încurajare și încredere că o să trec peste"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подбодрить и верить, что я справлюсь"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peppa mig och tro på att jag fixar det"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังใจ และเชื่อว่าจะผ่านไปได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesaret ver, atlatacağıma inan"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підбадьорити й вірити, що я впораюся"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
