        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느리고 조용한 삶, 평화가 핵심이에요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidup perlahan dan tenang — ketenangan itulah tujuannya"
