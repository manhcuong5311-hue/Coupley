        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ធ្វើអ្វីមួយជាមួយគ្នាដែលមិនទាមទារអ្វី — ធ្វើម្ហូប បត់ខោអាវ គូររូប។"
