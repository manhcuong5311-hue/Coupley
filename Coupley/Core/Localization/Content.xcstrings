        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Награда за годы работы — увидеть мир. Наверное, ты уже копишь на свою версию свободы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belöningen för ett helt arbetsliv är att få se världen. Du sparar nog till din egen version av frihet."
