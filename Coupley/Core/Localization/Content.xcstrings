    "The space you live in affects everything — how you rest, socialise, work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكان الذي تعيشون فيه يؤثر في كل شيء: الراحة والحياة الاجتماعية والعمل."
