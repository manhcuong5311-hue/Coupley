        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ერთად გააკეთეთ რაღაც, რაც არაფერს მოითხოვს — მოამზადეთ საჭმელი, დაკეცეთ სარეცხი, ხატეთ."
