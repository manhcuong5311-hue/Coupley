    "Ritual grounds you. Doing something familiar and nourishing together is its own kind of therapy." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rituele aard jou. Om saam iets bekends en voedends te doen, is sy eie soort terapie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተለመደ ልማድ ያረጋጋዎታል። የሚያውቁትንና የሚያጠግብን ነገር አብሮ መሥራት በራሱ ፈውስ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطقوس تمنحكم الثبات. فعل شيء مألوف ومُغذٍّ معًا هو نوع من العلاج بحد ذاته."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিয়মীয়া অভ্যাসে আপোনাক থিতাপি দিয়ে। একেলগে চিনাকি আৰু পুষ্টিকৰ কিবা কৰাটো নিজেই এক প্ৰকাৰৰ চিকিৎসা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rituallar səni sakitləşdirir. Birlikdə tanış və doyurucu bir iş görmək özü bir növ terapiyadır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рытуалы вяртаюць табе раўнавагу. Рабіць разам нешта знаёмае і цёплае — асаблівы від тэрапіі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ритуалите те заземяват. Нещо познато и сгряващо, направено заедно, е своеобразна терапия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেনা অভ্যাস তোমাকে স্থির রাখে। একসাথে পরিচিত, মন ভরানো কিছু করা নিজেই এক ধরনের থেরাপি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rituali te smiruju. Raditi zajedno nešto poznato i hranjivo posebna je vrsta terapije."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els rituals t'ancoren. Fer junts alguna cosa familiar i que nodreix és una teràpia en si mateixa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rituály ti dávají pevnou půdu. Dělat spolu něco známého, co vás zahřeje a nasytí, je svým způsobem terapie."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae defod yn dy sadio. Mae gwneud rhywbeth cyfarwydd a maethlon gyda'ch gilydd yn fath o therapi ynddo'i hun."
