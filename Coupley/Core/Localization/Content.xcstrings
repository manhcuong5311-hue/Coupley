            "value" : "ማለት አለብኝ ብለው የሚያስቡትን ሳይሆን — በእርግጥ እየሠሩበት ያለውን።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس ما ترون أنه الجواب المتوقع، بل ما تعملون عليه حقًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক'ব লাগে বুলি ভবা কথা নহয় — আপুনি সঁচাকৈয়ে যিটোৰ ওপৰত কাম কৰি আছে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deməli olduğunu düşündüyün şeyi yox — həqiqətən üzərində işlədiyin şeyi."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не тое, што «трэба» сказаць, — а над чым ты сапраўды працуеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не каквото смяташ, че трябва да кажеш – а по какво наистина работиш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা বলা উচিত মনে হয় তা নয় — যার ওপর সত্যিই কাজ করছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ono što misliš da bi trebalo reći – nego ono na čemu zaista radiš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No el que creus que hauries de dir — el que de veritat estàs treballant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne to, co by se mělo říct – ale na čem opravdu pracuješ."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nid beth rwyt ti'n meddwl y dylet ti ei ddweud — beth rwyt ti'n gweithio arno go iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke det, du tror, du burde sige – men det, du faktisk arbejder på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht das, was man sagen sollte – sondern woran du wirklich arbeitest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όχι αυτό που νομίζεις ότι πρέπει να πεις — αυτό που δουλεύεις πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo que crees que deberías decir — en lo que de verdad estás trabajando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte see, mida arvad, et peaksid ütlema — vaid see, mille kallal päriselt töötad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez esan beharko zenukeela uste duzuna: benetan lantzen ari zarena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نه چیزی که فکر می‌کنی باید بگویی — چیزی که واقعاً رویش کار می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei sitä, mitä luulet, että pitäisi sanoa – vaan sitä, mitä oikeasti työstät."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ’yung sa tingin mo ay dapat mong sabihin — ’yung talagang ginagawa mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ce que tu penses devoir répondre — ce sur quoi tu travailles vraiment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní an rud ar cheart duit a rá, dar leat — ach an rud atá idir lámha agat i ndáiríre."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non o que cres que deberías dicir, senón no que estás traballando de verdade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારે શું કહેવું જોઈએ એ નહીં — તમે ખરેખર જેના પર કામ કરો છો એ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba abin da kuke ganin ya kamata ku faɗa ba — abin da kuke aiki a kai da gaske."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מה שנראה לך שאמור להישמע טוב — אלא מה שבאמת בעבודה אצלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह नहीं जो कहना चाहिए — वह जिस पर सच में काम चल रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ono što misliš da bi trebalo reći – nego ono na čemu stvarno radiš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa sa ou panse ou ta dwe di — sa w ap travay sou li vre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem azt, amit szerinted mondanod kéne – hanem amin tényleg dolgozol."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ոչ թե այն, ինչ կարծում ես, որ պետք է ասել, այլ այն, ինչի վրա իրականում աշխատում ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan yang menurutmu seharusnya kamu jawab — tapi yang benar-benar sedang kamu usahakan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ bụghị ihe i chere na ị kwesịrị ikwu — kama ihe ị na-arụ ọrụ na ya n'ezie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki það sem þér finnst að þú ættir að segja – heldur það sem þú ert í alvöru að vinna í."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non quello che pensi di dover dire — quello su cui stai lavorando davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言うべきだと思うことではなく、実際に取り組んでいること。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudu sing panjenengan rasa kudu diucapake — nanging sing pancen lagi diupayakake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არა ის, რაც გგონია, რომ უნდა თქვა — არამედ ის, რაზეც ნამდვილად მუშაობ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Айтуға тиіс деп ойлағаныңды емес, шынымен үстінде жұмыс істеп жатқаныңды айт."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនមែនអ្វីដែលអ្នកគិតថាគួរនិយាយទេ — គឺអ្វីដែលអ្នកពិតជាកំពុងខិតខំធ្វើ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೇಳಬೇಕು ಎಂದು ನಿಮಗನಿಸುವುದಲ್ಲ — ನೀವು ನಿಜವಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತಿರುವುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말해야 할 것 같은 답 말고, 실제로 노력하고 있는 걸 알려 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ya ku tu difikirî divê bibêjî — ya ku tu bi rastî li ser dixebitî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Айтыш керек деп ойлогонуңду эмес — чындап эле эмнеге аракет кылып жатканыңды."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net dat, wat s de mengs, soen ze mussen — mee dat, un deem s de wierklech schaffs."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບໍ່ແມ່ນສິ່ງທີ່ເຈົ້າຄິດວ່າຄວນເວົ້າ — ແຕ່ແມ່ນສິ່ງທີ່ເຈົ້າກຳລັງເຮັດແທ້ໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne tai, ką, tavo manymu, reikėtų pasakyti, – o tai, prie ko iš tikrųjų dirbi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne to, ko, tavuprāt, būtu jāsaka, – bet to, pie kā tiešām strādā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy izay heverinao fa tokony holazainao — fa izay tena iasanao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehara ko tāu e whakaaro ana me kī — engari ko tāu e mahi tūturu ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не она што мислиш дека треба да кажеш — туку она на што навистина работиш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പറയേണ്ടതാണെന്ന് നിങ്ങൾ കരുതുന്നതല്ല — നിങ്ങൾ ശരിക്കും ശ്രമിക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэлэх ёстой гэж бодсон зүйлээ биш — үнэхээр хичээж буй зүйлээ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काय सांगायला हवे ते नाही — प्रत्यक्षात तुम्ही कशावर काम करत आहात ते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan apa yang anda rasa patut dikatakan — tapi apa yang betul-betul sedang anda usahakan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mhux dak li taħseb li għandek tgħid — dak li verament qed taħdem fuqu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပြောသင့်တယ်လို့ ထင်တာ မဟုတ်ဘဲ — တကယ် ကြိုးစားနေတာကို ပြောပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke det du tror du bør svare – det du faktisk jobber med."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भन्नुपर्ला जस्तो लागेको होइन — साँच्चै गरिरहेको कुरा।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet wat je denkt dat je hoort te zeggen – maar waar je echt mee bezig bent."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osati zomwe mukuganiza kuti muyenera kunena — koma zomwe mukuyesetsadi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan jechuu qabdu sitti fakkaatu miti — waan dhugumaan irratti hojjechaa jirtu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାହା କହିବା ଉଚିତ ବୋଲି ଭାବୁଛନ୍ତି ତାହା ନୁହେଁ — ଯାହା ଉପରେ ପ୍ରକୃତରେ କାମ କରୁଛନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਹ ਨਹੀਂ ਜੋ ਕਹਿਣਾ ਚਾਹੀਦਾ ਲੱਗਦਾ ਹੈ — ਉਹ ਜਿਸ ਉੱਤੇ ਤੁਸੀਂ ਸੱਚਮੁੱਚ ਕੰਮ ਕਰ ਰਹੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie to, co wypada powiedzieć – tylko to, nad czym naprawdę pracujesz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نه هغه څه چې فکر کوئ باید ووایئ — هغه څه چې په رښتیا پرې کار کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não o que você acha que deveria dizer — aquilo em que você está trabalhando de verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não o que achas que devias dizer — aquilo em que estás mesmo a trabalhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ce crezi că ar trebui să spui — ci la ce lucrezi cu adevărat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не то, что, по-твоему, принято говорить, — а то, над чем ты действительно работаешь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si icyo utekereza ko ukwiye kuvuga — ahubwo icyo urimo gukoraho koko."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කියන්න ඕනේ කියලා හිතෙන දේ නෙවෙයි — ඔබ ඇත්තටම වැඩ කරන දේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie to, čo sa patrí povedať – ale na čom naozaj pracuješ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne tisto, kar misliš, da je treba reči – tisto, na čemer res delaš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwete zvaunofunga kuti unofanira kutaura — zvauri kunyatsoshandira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma aha waxa aad u malaynayso inaad tidhaahdo — waa waxa aad runtii ka shaqaynayso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo atë që mendon se duhet të thuash – atë për të cilën po punon vërtet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не оно што мислиш да треба да кажеш — већ оно на чему стварно радиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanés anu numutkeun anjeun kedah diucapkeun, tapi anu leres-leres nuju diusahakeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte det du tycker att du borde säga – det du faktiskt jobbar med."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si unachofikiri unapaswa kusema — bali unachokifanyia kazi kweli."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சொல்ல வேண்டும் என்று நினைப்பதல்ல — உண்மையில் நீங்கள் உழைத்துக்கொண்டிருப்பது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చెప్పాలనిపించేది కాదు — మీరు నిజంగా దేనిపై పని చేస్తున్నారో అది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На он чизе, ки гуфтанаш «бояд», балки он чизе, ки воқеан дар болояш кор мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ใช่สิ่งที่คิดว่าควรตอบ แต่เป็นสิ่งที่คุณกำลังทำอยู่จริงๆ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክትብሉ ዝግባእ ዝመስለኩም ዘይኮነ — ብሓቂ እትሰርሑሉ ዘለኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aýtmaly diýip pikir edýän zadyňy däl — hakykatdan üstünde işleýän zadyňy."
          }
        },
        "tr" : {
          "stringUnit" : {
