          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကျန်းမာတဲ့ ပါဝင်မှု။ ရောက်လာတယ်၊ ဂရုစိုက်တယ်၊ ဒါပေမဲ့ နှစ်ယောက်ရဲ့ နေရာကိုလည်း ကာကွယ်တယ်။ ဒါက ရေရှည် ထိန်းထားနိုင်တယ်။"
