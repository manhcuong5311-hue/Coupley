        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პრაქტიკული ბალანსი. საერთო პასუხისმგებლობა და პირადი დამოუკიდებლობა. წყვილების უმეტესობას ეს დიდი ხნით ერგება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практикалық тепе-теңдік. Ортақ жауапкершілік пен жеке дербестік. Жұптардың көбі мұны ұзақ мерзімде тиімді деп табады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "តុល្យភាពជាក់ស្ដែង។ ទំនួលខុសត្រូវរួម បូកនឹងសេរីភាពផ្ទាល់ខ្លួន។ គូស្នេហ៍ភាគច្រើនយល់ថាវិធីនេះអាចរក្សាបានយូរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಾಯೋಗಿಕ ಸಮತೋಲನ. ಹಂಚಿಕೊಂಡ ಜವಾಬ್ದಾರಿ ಜೊತೆಗೆ ವೈಯಕ್ತಿಕ ಸ್ವಾತಂತ್ರ್ಯ. ಹೆಚ್ಚಿನ ಜೋಡಿಗಳಿಗೆ ಇದು ದೀರ್ಘಾವಧಿಯಲ್ಲಿ ಸರಿಹೊಂದುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현실적인 균형이에요. 함께 책임지면서 각자의 자유도 지키죠. 많은 커플이 오래 유지하기 좋은 방식이라고 느껴요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hevsengiya pratîk. Berpirsiyariya hevpar û serbixwebûna kesane. Piraniya cotan vê di demeke dirêj de domdar dibînin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практикалуу тең салмак. Жалпы жоопкерчилик плюс жеке эркиндик. Көп жуптар муну узак мөөнөттө ыңгайлуу деп табышат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E praktescht Gläichgewiicht. Gemeinsam Verantwortung plus e Stéck Fräiheet. Fir vill Koppele funktionéiert dat op laang Siicht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສົມດຸນແບບໃຊ້ໄດ້ຈິງ ຮັບຜິດຊອບຮ່ວມກັນ ບວກກັບອິດສະຫຼະສ່ວນຕົວ ຄູ່ຮັກສ່ວນໃຫຍ່ເຫັນວ່າແບບນີ້ໄປໄດ້ຍາວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktiška pusiausvyra. Bendra atsakomybė ir asmeninė laisvė. Daugumai porų tai tinka ilgam."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisks līdzsvars. Kopīga atbildība un personiska brīvība. Lielākajai daļai pāru tas ilgtermiņā strādā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fandanjalanjana azo ampiharina. Andraikitra iraisana miampy fahaleovan-tena manokana. Hitan'ny ankamaroan'ny mpifankatia fa maharitra izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He taurite tōtika. He kawenga tahi, me te mana motuhake. Ki te nuinga o te tokorua, ka taea te pupuri i tēnei mō te wā roa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практична рамнотежа. Заедничка одговорност плус лична самостојност. Повеќето двојки го наоѓаат ова одржливо на долг рок."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രായോഗികമായ സന്തുലനം. പങ്കിട്ട ഉത്തരവാദിത്തവും വ്യക്തിപരമായ സ്വാതന്ത്ര്യവും. മിക്ക ജോഡികൾക്കും ഇത് ദീർഘകാലം തുടരാനാകുന്നതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бодит тэнцвэр. Хамтын хариуцлага дээр хувийн бие даасан байдал. Ихэнх хосуудад энэ урт хугацаанд тохирдог."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यवहारी समतोल. सामायिक जबाबदारी आणि वैयक्तिक स्वातंत्र्य दोन्ही. बहुतेक जोडप्यांना हे दीर्घकाळ टिकणारे वाटते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keseimbangan yang praktikal. Tanggungjawab bersama serta kebebasan peribadi. Kebanyakan pasangan mendapati cara ini mampan dalam jangka panjang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilanċ prattiku. Responsabbiltà komuni flimkien ma' awtonomija personali. Ħafna koppji jsibu li dan jaħdem fit-tul."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်တွေ့ကျတဲ့ မျှတမှု။ ဘုံတာဝန်နဲ့ ကိုယ်ပိုင်လွတ်လပ်မှု။ စုံတွဲအများစုက ဒါကို ရေရှည် ထိန်းထားနိုင်ကြတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisk balanse. Felles ansvar pluss personlig frihet. De fleste par synes dette fungerer godt på lang sikt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यावहारिक सन्तुलन। साझा जिम्मेवारीसँगै व्यक्तिगत स्वतन्त्रता। धेरैजसो जोडीलाई यो लामो समयसम्म दिगो लाग्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktische balans. Gedeelde verantwoordelijkheid plus eigen vrijheid. De meeste stellen houden dit op de lange termijn goed vol."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulinganiza kwanzeru. Udindo wogawana pamodzi ndi ufulu waumwini. Okondana ambiri amapeza kuti izi zimakhalitsa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madaala qabatamaa. Itti gaafatamummaa waliinii fi bilisummaa dhuunfaa. Jaalallee lamaan baay'een kana yeroo dheeraaf itti fufsiisuu danda'u."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବ୍ୟବହାରିକ ସନ୍ତୁଳନ। ମିଳିତ ଦାୟିତ୍ୱ ସହ ନିଜସ୍ୱ ସ୍ୱାଧୀନତା। ଅଧିକାଂଶ ଯୁଗଳ ଏହାକୁ ଲମ୍ବା ସମୟ ପାଇଁ ଚଳାଇପାରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਿਹਾਰਕ ਸੰਤੁਲਨ। ਸਾਂਝੀ ਜ਼ਿੰਮੇਵਾਰੀ ਦੇ ਨਾਲ ਨਿੱਜੀ ਆਜ਼ਾਦੀ। ਜ਼ਿਆਦਾਤਰ ਜੋੜਿਆਂ ਨੂੰ ਇਹ ਲੰਮੇ ਸਮੇਂ ਤੱਕ ਨਿਭਾਉਣਾ ਸੌਖਾ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktyczna równowaga. Wspólna odpowiedzialność plus osobista swoboda. Większość par uważa to za trwałe rozwiązanie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملي انډول. ګډ مسؤلیت او شخصي خپلواکي. ډېرې جوړې دا په اوږد مهال کې د دوام وړ ګڼي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio prático. Responsabilidade compartilhada com autonomia pessoal. A maioria dos casais acha isso sustentável a longo prazo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio prático. Responsabilidade partilhada e autonomia pessoal. A maioria dos casais acha isto sustentável a longo prazo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un echilibru practic. Responsabilitate comună plus autonomie personală. Majoritatea cuplurilor găsesc varianta asta sustenabilă pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практичный баланс: общая ответственность и личная свобода. Большинству пар такой вариант подходит надолго."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uburinganire bufatika. Inshingano musangiye wongeyeho ubwigenge bwa buri wese. Abakundana benshi basanga ibi bishoboka igihe kirekire."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ප්‍රායෝගික සමබරතාව. පොදු වගකීම සහ පුද්ගලික නිදහස. බොහෝ යුවළයන්ට මේක දිගුකාලීනව පවත්වාගන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktická rovnováha. Spoločná zodpovednosť plus osobná nezávislosť. Pre väčšinu párov je to dlhodobo udržateľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktično ravnovesje. Skupna odgovornost in osebna samostojnost. Večina parov meni, da to dolgoročno deluje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuenzanisa kune njere. Basa ramunogovana pamwe nerusununguko rwemumwe nemumwe. Vadiwa vazhinji vanoona izvi zvichigoneka munguva refu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dheelitir wax ku ool ah. Mas'uuliyad la wadaago iyo madax-bannaani shakhsi ah. Lammaanayaasha badankood tan waxay u arkaan mid waarta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekuilibër praktik. Përgjegjësi e përbashkët plus autonomi personale. Shumica e çifteve e gjejnë këtë të qëndrueshme në afat të gjatë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практична равнотежа. Заједничка одговорност плус лична самосталност. Већина парова то може дугорочно да одржи."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasaimbangan anu praktis. Tanggung jawab babarengan ditambah kabébasan pribadi. Kalolobaan pasangan mendakan ieu tiasa dijalankeun dina jangka panjang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisk balans. Delat ansvar plus egen frihet. De flesta par tycker att det håller i längden."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwiano wa kivitendo. Majukumu ya pamoja pamoja na uhuru binafsi. Wenzi wengi huona hili linadumu kwa muda mrefu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நடைமுறைச் சமநிலை. பகிர்ந்த பொறுப்பும் தனிப்பட்ட சுதந்திரமும். பெரும்பாலான ஜோடிகளுக்கு இது நீண்ட காலம் நீடிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆచరణాత్మక సమతుల్యత. కలిసి బాధ్యత, దానితో పాటు వ్యక్తిగత స్వేచ్ఛ. చాలా జంటలకు ఇది దీర్ఘకాలం నిలుస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мувозинати амалӣ. Масъулияти муштарак ва мустақилияти шахсӣ. Аксари ҷуфтҳо инро дар дарозмуддат устувор меёбанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมดุลแบบใช้ได้จริง รับผิดชอบร่วมกันพร้อมมีอิสระส่วนตัว คู่รักส่วนใหญ่พบว่าวิธีนี้ยั่งยืนในระยะยาว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተግባራዊ ሚዛን። ናይ ሓባር ሓላፍነትን ውልቃዊ ናጽነትን። መብዛሕትኦም ጽምዲ እዚ ንነዊሕ ግዜ ዝቕጽል ኮይኑ ይረኽብዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaly deňagramlylyk. Umumy jogapkärçilik we şahsy erkinlik. Jübütleriň köpüsi muny uzak möhletde amatly hasaplaýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratik bir denge. Ortak sorumluluk artı kişisel özerklik. Çoğu çift bunu uzun vadede sürdürülebilir bulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практичний баланс. Спільна відповідальність плюс особиста свобода. Більшості пар такий формат підходить надовго."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملی توازن۔ مشترکہ ذمہ داری کے ساتھ ذاتی آزادی بھی۔ زیادہ تر جوڑوں کے لیے یہ طویل مدت تک چلتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaliy muvozanat. Umumiy masʼuliyat va shaxsiy mustaqillik. Aksariyat juftliklar buni uzoq muddatda qulay deb biladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng thực tế. Chia sẻ trách nhiệm mà vẫn có tự chủ riêng. Phần lớn các cặp đôi thấy cách này bền vững lâu dài."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulungelelwano olusebenzayo. Uxanduva enabelana ngalo kunye nenkululeko yomntu ngamnye. Uninzi lwezibini lufumanisa ukuba oku kuyasebenza kwixesha elide."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwọ̀ntúnwọ̀nsì tó wúlò. Ojúṣe àjọṣe pẹ̀lú òmìnira ara ẹni. Ọ̀pọ̀ olólùfẹ́ rí i pé èyí ṣeé ṣe fún ọjọ́ pípẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "務實的平衡。共同承擔責任，也保有個人自主。大部分情侶覺得這樣能長久維持。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "务实的平衡。共同承担，也保留个人空间。大多数情侣觉得这样能长久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "務實的平衡。共同承擔責任，也保有個人自主。多數情侶覺得這樣能長久維持。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukulinganisela okusebenzayo. Umthwalo owabelwanayo kanye nokuzimela komuntu ngamunye. Imibhangqwana eminingi ithola lokhu kusimeme isikhathi eside."
          }
        }
      }
    },
