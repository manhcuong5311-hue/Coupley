    "Tackling the uncomfortable. This is growth at its most valuable — and often the hardest." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ongemaklike aanpak. Dis groei op sy waardevolste – en dikwels op sy moeilikste."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የማይመቸውን መጋፈጥ። ይህ እጅግ ዋጋ ያለው እድገት ነው — ብዙ ጊዜም በጣም ከባዱ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواجهة ما يزعج. هذا هو النمو في أثمن صوره، وغالبًا أصعبها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অস্বস্তিৰ মুখামুখি হোৱা। এয়াই আটাইতকৈ মূল্যৱান বিকাশ — আৰু প্ৰায়ে আটাইতকৈ কঠিন।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narahatlıq yaradan şeyin üstünə getmək. Bu, ən dəyərli inkişafdır — və çox vaxt ən çətini."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выклік уласнаму дыскамфорту. Гэта самы каштоўны рост — і часта самы цяжкі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се изправиш срещу неудобното. Това е растеж в най-ценната му форма – и често най-трудният."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অস্বস্তির মুখোমুখি হওয়া। এটাই সবচেয়ে মূল্যবান বেড়ে ওঠা — আর প্রায়ই সবচেয়ে কঠিন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suočavanje s neugodnim. To je rast u svom najdragocjenijem obliku – i često najteži."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrontar el que incomoda. És el creixement més valuós — i sovint el més difícil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouštíš se do toho, co je ti nepříjemné. To je nejcennější druh růstu – a často ten nejtěžší."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mynd i'r afael â'r anghyfforddus. Dyma dwf ar ei fwyaf gwerthfawr — ac yn aml ar ei anoddaf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tager fat på det ubehagelige. Det er den mest værdifulde form for vækst – og ofte den sværeste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gehst das Unbequeme an. Das ist Wachstum in seiner wertvollsten Form – und oft der schwerste Weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιμετωπίζεις το άβολο. Αυτή είναι η πιο πολύτιμη εξέλιξη — και συχνά η πιο δύσκολη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrontar lo incómodo. Es el crecimiento más valioso — y muchas veces, el más difícil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebamugavaga silmitsi seismine. See on kasv kõige väärtuslikumal kujul — ja sageli kõige raskem."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deserosoari aurre egitea. Hau da hazkunderik baliotsuena, eta askotan zailena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روبه‌رو شدن با چیزهای ناخوشایند. این ارزشمندترین نوع رشد است — و اغلب سخت‌ترینش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epämukavuuden kohtaamista. Tämä on kasvua arvokkaimmillaan – ja usein vaikeimmillaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinaharap ang hindi komportable. Ito ang pinakamahalagang uri ng paglago — at madalas, ang pinakamahirap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affronter l'inconfort. C'est la forme de progrès la plus précieuse — et souvent la plus dure."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dul i ngleic leis an míchompord. Seo fás ag a luachmhaire — agus go minic ag a dheacra."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfrontarte ao incómodo. Este é o crecemento máis valioso, e moitas veces o máis difícil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અસહજ વાતનો સામનો. આ સૌથી કીમતી વિકાસ છે — અને ઘણી વાર સૌથી અઘરો પણ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuskantar abin da ba ya muku daɗi. Wannan shi ne ci gaba mafi daraja — kuma sau da yawa mafi wahala."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתמודד עם הלא נוח. זו צמיחה במיטבה — ולרוב גם הקשה ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असहज चीज़ों का सामना। ख़ुद को निखारने का यही सबसे क़ीमती रूप है — और अक्सर सबसे मुश्किल भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvatanje u koštac s neugodnim. To je rast u svom najvrjednijem obliku – i često najteži."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atake sa ki pa konfòtab. Se kwasans ki gen plis valè — e souvan ki pi difisil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szembenézel a kényelmetlennel. Ez a legértékesebb fejlődés – és gyakran a legnehezebb is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անհարմարի դեմ դուրս գալ։ Սա աճն է իր ամենաարժեքավոր ձևով, և հաճախ՝ ամենադժվար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghadapi hal yang nggak nyaman. Inilah pertumbuhan yang paling berharga — dan sering kali yang paling sulit."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịlụso ihe na-adịghị mfe ọgụ. Nke a bụ uto kacha bara uru — ọ na-abụkarịkwa nke kacha sie ike."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að takast á við það óþægilega. Þetta er vöxtur eins og hann gerist verðmætastur – og oft erfiðastur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affrontare il disagio. È la crescita più preziosa — e spesso la più difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居心地の悪さに向き合う人です。これこそいちばん価値のある成長で、たいていいちばん難しいものです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngadhepi sing ora kepenak. Iki wujud tuwuh sing paling aji — lan asring sing paling angel."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არაკომფორტულთან გამკლავება. ეს ყველაზე ღირებული ზრდაა — და ხშირად ყველაზე რთულიც."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ыңғайсыз нәрсеге батыл қадам. Бұл — ең құнды, әрі көбіне ең қиын өсу."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រឈមមុខនឹងអ្វីដែលមិនស្រួល។ នេះជាការរីកចម្រើនដែលមានតម្លៃបំផុត — ហើយជារឿយៗក៏ពិបាកបំផុត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಸೌಕರ್ಯವನ್ನು ಎದುರಿಸುವುದು. ಇದು ಅತ್ಯಂತ ಅಮೂಲ್ಯವಾದ ಬೆಳವಣಿಗೆ — ಮತ್ತು ಹಲವು ಬಾರಿ ಅತ್ಯಂತ ಕಷ್ಟದ್ದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불편한 것에 맞서요. 가장 값지면서도 가장 어려운 성장이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rûbirûbûna bi tiştên ne rehet re. Ev mezinbûn e di forma xwe ya herî bi qîmet de — û gelek caran ya herî zehmet."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ыңгайсыздык менен бетме-бет келүү. Бул эң баалуу — жана көбүнчө эң оор өсүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat Onbequeemt upaken. Dat ass Wuesstem a senger wäertvollster Form — an dacks déi schwéierst."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ກ້າຜະເຊີນສິ່ງທີ່ບໍ່ສະບາຍໃຈ ນີ້ແມ່ນການເຕີບໂຕທີ່ມີຄ່າທີ່ສຸດ — ແລະ ມັກຈະຍາກທີ່ສຸດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iššūkis nepatogumui. Tai pats vertingiausias augimas – ir dažnai sunkiausias."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stāties pretī neērtajam. Tā ir visvērtīgākā izaugsme – un bieži arī visgrūtākā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miatrika ny tsy mahazo aina. Fitomboana sarobidy indrindra izany — ary matetika ny sarotra indrindra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te anga atu ki te mea uaua. Koinei te tipu e tino whai hua ana — ā, ko te mea uaua rawa i te nuinga o te wā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соочување со непријатното. Ова е раст во својот највреден облик — и често најтешкиот."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അസ്വസ്ഥതയെ നേരിടൽ. ഇതാണ് ഏറ്റവും വിലപ്പെട്ട വളർച്ച — പലപ്പോഴും ഏറ്റവും പ്രയാസമേറിയതും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эвгүй зүйлтэй нүүр тулах. Энэ бол хамгийн үнэ цэнтэй — бас ихэвчлэн хамгийн хэцүү өсөлт."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्वस्थ करणाऱ्या गोष्टींना भिडणे. ही सर्वात मौल्यवान वाढ आहे — आणि बहुधा सर्वात कठीणही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdepan dengan yang tidak selesa. Inilah pertumbuhan yang paling bernilai — dan selalunya paling sukar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiffaċċja l-iskumdità. Dan huwa t-tkabbir fl-aqwa valur tiegħu — u spiss l-aktar diffiċli."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အဆင်မပြေတာကို ရင်ဆိုင်ခြင်း။ ဒါဟာ အတန်ဖိုးအရှိဆုံး ကြီးထွားမှုပါ — အခက်ဆုံးလည်း ဖြစ်တတ်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar tak i det ubehagelige. Dette er vekst når den er mest verdifull – og ofte vanskeligst."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असजिलो कुराको सामना। यो सबैभन्दा मूल्यवान् विकास हो — र प्रायः सबैभन्दा कठिन पनि।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ongemak aangaan. Dit is groei op z’n waardevolst – en vaak op z’n moeilijkst."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulimbana ndi zovuta. Uku ndiko kukula kwamtengo wapatali kwambiri — ndipo nthawi zambiri kovuta kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan nama hin mijanne fuuluu. Kun guddina isa baay'ee gatii qabu dha — yeroo baay'ees isa cimaa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅସ୍ୱସ୍ତିକର କଥାର ସାମ୍ନା କରିବା। ଏହା ସବୁଠାରୁ ମୂଲ୍ୟବାନ ବିକାଶ — ଏବଂ ପ୍ରାୟତଃ ସବୁଠାରୁ କଠିନ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬੇਆਰਾਮੀ ਦਾ ਸਾਹਮਣਾ। ਇਹ ਸਭ ਤੋਂ ਕੀਮਤੀ ਤਰੱਕੀ ਹੈ — ਅਤੇ ਅਕਸਰ ਸਭ ਤੋਂ ਔਖੀ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmierzenie się z tym, co niewygodne. To najcenniejszy rodzaj rozwoju – i często najtrudniejszy."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له ناآرامۍ سره مخ کېدل. دا تر ټولو ارزښتناکه وده ده — او اکثره تر ټولو سخته."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encarar o desconfortável. É o crescimento mais valioso — e muitas vezes o mais difícil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfrentar o desconfortável. É o crescimento mais valioso — e muitas vezes o mais difícil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să înfrunți ce e incomod. E creșterea cea mai valoroasă — și adesea cea mai grea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг навстречу дискомфорту. Это самый ценный рост — и часто самый трудный."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhangana n'ibitorohera. Uku ni ugukura gufite agaciro kurusha ibindi — kandi akenshi kugoye kurusha ibindi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අපහසු දේට මුහුණ දීම. මේ තමයි වඩාත්ම වටිනා වර්ධනය — බොහෝ විට අමාරුම එකත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustiť sa do nepohodlného. Takýto rast má najväčšiu hodnotu – a často býva najťažší."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoprijemanje z neprijetnim. To je rast v najdragocenejši obliki – in pogosto najtežja."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutarisana nezvisingafadzi. Uku ndiko kukura kunokosha kwazvo — uye kazhinji kwakaoma kupfuura kwose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajihidda waxa aan raaxada lahayn. Tani waa korriinka ugu qiimaha badan — inta badanna kan ugu adag."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përballje me të pakëndshmen. Kjo është rritja në formën e saj më të vlefshme – dhe shpesh më të vështirë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хватање укоштац с непријатним. Ово је раст у свом највреднијем облику — и често најтежем."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyanghareupan anu teu ngeunah. Ieu kamekaran anu pangberharga, sareng sering ogé anu panghésé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta sig an det obekväma. Det är utveckling när den är som mest värdefull – och ofta som svårast."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukabili yasiyostarehesha. Huu ndio ukuaji wenye thamani kubwa zaidi — na mara nyingi mgumu zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சங்கடமானதை எதிர்கொள்வது. இதுவே மிக மதிப்புமிக்க வளர்ச்சி — பெரும்பாலும் மிகக் கடினமானதும் கூட."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అసౌకర్యాన్ని ఎదుర్కోవడం. ఇదే అత్యంత విలువైన ఎదుగుదల — తరచుగా అత్యంత కష్టమైనది కూడా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рӯ ба рӯ шудан бо нороҳатӣ. Ин арзишмандтарин навъи рушд аст — ва аксар вақт душвортаринаш."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้าเผชิญสิ่งที่ไม่สบายใจ นี่คือการเติบโตที่มีค่าที่สุด และมักยากที่สุดด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነቲ ዘይምቹእ ምግጣም። እዚ ኣዝዩ ዋጋ ዘለዎ ዕቤት እዩ — መብዛሕትኡ ግዜ ድማ እቲ ዝኸበደ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oňaýsyz zat bilen ýüzbe-ýüz bolmak. Bu iň gymmatly ösüş — we köplenç iň kyny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni zorlayanla yüzleşmek. Gelişimin en değerli hâli bu ve çoğu zaman en zoru."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крок назустріч дискомфорту. Це найцінніший різновид зростання — і часто найважчий."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بے آرامی کا سامنا۔ یہ سب سے قیمتی ترقی ہے، اور اکثر سب سے مشکل بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noqulaylikka qarshi borish. Bu eng qimmatli oʻsish — va koʻpincha eng qiyini."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đối mặt với điều khó chịu. Đây là kiểu trưởng thành quý giá nhất — và thường cũng khó nhất."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukujongana nento engakhululekanga. Oku kukukhula okona kuxabisekileyo — kwaye kudla ngokuba kokona kunzima."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kíkojú ohun tí kò rọrùn. Èyí ni ìdàgbàsókè tó níye lórí jù — ó sì sábà máa ń le jù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直面不自在的事。這是最有價值的成長，往往也最困難。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走出舒适区。这是最有价值的成长，往往也是最难的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勇敢面對不舒服的事。這是最有價值、也常常最難的成長。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubhekana nokungakhululekile. Lokhu kungukukhula okubaluleke kakhulu — futhi kuvame ukuba nzima kakhulu."
          }
        }
      }
    },
    "Take one small thing off their plate today, silently." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem vandag een klein dingetjie van jou maat se bord af, sonder om iets te sê."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዛሬ ከሥራቸው አንድ ትንሽ ነገር በዝምታ ያቅልሉላቸው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خففوا عن شريكك مهمة صغيرة اليوم، بصمت."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজি তেওঁৰ কামৰ পৰা সৰু এটা কাম মনে মনে নিজে কৰি দিয়ক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gün onun yükündən kiçik bir şeyi səssizcə götür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сёння моўчкі вазьмі на сябе адну дробязь са спраў палавінкі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поеми днес едно малко нещо от задачите ѝ, без да казваш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজ চুপচাপ ওর কাজের তালিকা থেকে ছোট একটা কাজ সরিয়ে নাও।"
