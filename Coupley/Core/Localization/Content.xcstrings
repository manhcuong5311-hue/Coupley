        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሁለቱም እኩል — አብሮም ተለያይቶም ማደግ"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاثنان بالتساوي، ننمو معًا وكلٌّ وحده"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুয়োটা সমানে — একেলগেও বাঢ়ে, বেলেগে বেলেগেও"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər ikisi bərabər — həm birlikdə, həm ayrı böyüyürük"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "І тое, і другое — расці і разам, і паасобку"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "И двете – растем и заедно, и поотделно"
