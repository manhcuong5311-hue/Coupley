          "stringUnit" : {
            "state" : "translated",
            "value" : "સંસ્કૃતિ ખરેખર ભોજનની થાળીમાં જીવે છે. તમે ફ્લાઇટ પહેલાં રેસ્ટોરન્ટ બુક કરો છો, અને એ બિલકુલ સાચું છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teburin abinci ne inda al'ada ke rayuwa da gaske. Kuna fara keɓe wurin cin abinci kafin jirgin sama, kuma hakan daidai ne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השולחן הוא המקום שבו התרבות באמת חיה. אצלך מזמינים מסעדות לפני טיסות, וזה בדיוק נכון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी जगह की असली संस्कृति खाने की मेज़ पर बसती है। आप फ़्लाइट से पहले रेस्टोरेंट बुक करते हैं — और यही सही है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za stolom zapravo živi kultura. Restorane rezerviraš prije letova – i to je posve ispravno."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sou tab la vrè kilti a ye. Ou rezève restoran anvan avyon, e ou gen rezon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kultúra valójában az asztalnál él. Előbb foglalsz éttermet, mint repülőjegyet – és ez így is van jól."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մշակույթն իրականում սեղանի շուրջ է ապրում։ Դու ռեստորաններն ամրագրում ես թռիչքներից առաջ, և դա ճիշտ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budaya yang sesungguhnya ada di meja makan. Kamu memesan restoran sebelum tiket pesawat, dan itu sudah benar."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okpokoro nri bụ ebe omenala bi n'ezie. Ị na-ebu ụzọ debe ụlọ nri tupu ụgbọ elu, nke ahụ ziri ezi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við matarborðið lifir menningin í raun. Þú bókar veitingastaðina á undan fluginu og það er hárrétt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È a tavola che vive davvero la cultura. Prenoti i ristoranti prima dei voli, ed è giusto così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文化が本当に息づいているのは食卓。飛行機より先にレストランを予約するタイプで、それは大正解です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meja mangan iku panggonan budaya sing sabenere urip. Panjenengan pesen restoran sadurunge tiket montor mabur, lan kuwi pancen bener."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კულტურა სინამდვილეში სუფრასთან ცხოვრობს. რესტორნებს ბილეთებზე ადრე ჯავშნი — და ეს სწორია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәдениеттің шын өмір сүретін жері — дастарқан. Сен ұшақ билетінен бұрын мейрамхана брондайсың — және дұрыс істейсің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "តុអាហារគឺជាកន្លែងដែលវប្បធម៌រស់នៅពិតៗ។ អ្នកកក់ភោជនីយដ្ឋានមុនកក់ជើងហោះហើរ ហើយនោះគឺត្រឹមត្រូវណាស់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಸ್ಕೃತಿ ನಿಜವಾಗಿ ನೆಲೆಸಿರುವುದು ಊಟದ ಮೇಜಿನಲ್ಲಿ. ವಿಮಾನಕ್ಕಿಂತ ಮೊದಲೇ ನೀವು ಹೋಟೆಲ್ ಬುಕ್ ಮಾಡುತ್ತೀರಿ, ಅದು ಸರಿಯಾದದ್ದೇ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진짜 문화는 식탁 위에 있어요. 항공권보다 식당 예약을 먼저 하는 타입이고, 그게 정답이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sifre cihê ku çand bi rastî lê dijî ye. Tu berî firînan xwaringehan rezerv dikî û ev rast e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маданият чындыгында дасторкондо жашайт. Учактан мурун ресторан брондойсуң — жана бул туура."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Dësch lieft d'Kultur wierklech. Du reservéiers d'Restauranten nach virun de Flich, an dat ass och richteg esou."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໂຕະອາຫານຄືບ່ອນທີ່ວັດທະນະທຳມີຊີວິດແທ້ໆ ເຈົ້າຈອງຮ້ານອາຫານກ່ອນຈອງຖ້ຽວບິນ ແລະ ນັ້ນກໍຖືກແລ້ວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikroji kultūra gyvena prie stalo. Restoranus užsisakai anksčiau nei lėktuvo bilietus – ir tai teisinga."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultūra patiesībā dzīvo pie galda. Tu rezervē restorānus pirms lidojumiem – un tā ir pareizi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eo amin'ny latabatra no tena ipetrahan'ny kolontsaina. Mamandrika trano fisakafoanana ianao alohan'ny fiaramanidina, ary marina izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei te tēpu te ahurea e ora ana. Ka tono koe i ngā wharekai i mua i ngā rererangi, ā, he tika tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Културата всушност живее на трпезата. Прво резервираш ресторани, па летови — и тоа е сосема правилно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സംസ്കാരം ശരിക്കും ജീവിക്കുന്നത് ഭക്ഷണമേശയിലാണ്. ഫ്ലൈറ്റിന് മുമ്പേ നിങ്ങൾ റെസ്റ്റോറന്റ് ബുക്ക് ചെയ്യും — അതാണ് ശരി."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соёл жинхэнэдээ ширээн дээр амьдардаг. Чи нислэгээсээ өмнө ресторанаа захиалдаг — энэ бол зөв."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संस्कृती खरी जगते ती जेवणाच्या टेबलावर. तुम्ही विमानाच्या आधी रेस्टॉरंट बुक करता, आणि ते अगदी बरोबर आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meja makan ialah tempat budaya sebenarnya hidup. Anda menempah restoran sebelum tiket penerbangan, dan itu memang betul."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mejda hija fejn verament tgħix il-kultura. Tibbukkja r-ristoranti qabel it-titjiriet, u għandek raġun."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ယဉ်ကျေးမှုက တကယ်တော့ ထမင်းဝိုင်းမှာ ရှိတယ်။ လေယာဉ်လက်မှတ် မဝယ်ခင် စားသောက်ဆိုင် အရင် ဘိုကင်လုပ်တတ်တယ် — ဒါ မှန်ပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er rundt bordet kulturen virkelig lever. Du bestiller restaurant før fly, og det er helt riktig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संस्कृति साँच्चै खानाको टेबलमा बस्छ। तपाईं उडानभन्दा पहिले रेस्टुरेन्ट बुक गर्नुहुन्छ, र त्यो एकदम सही हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan tafel leeft de cultuur pas echt. Jij boekt restaurants nog vóór de vluchten, en terecht."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patebulo ndiye pamene chikhalidwe chimakhala kwenikweni. Mumasungitsa malo odyera musanasungitse ndege, ndipo nzolondola."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aadaan dhugumaan maaddii irratti jiraata. Xiyyaara dura mana nyaataa qabachiifatta, kunis sirrii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଂସ୍କୃତି ଆସଲରେ ଖାଇବା ଟେବୁଲରେ ବଞ୍ଚେ। ଆପଣ ଫ୍ଲାଇଟ୍ ଆଗରୁ ରେସ୍ତୋରାଁ ବୁକ୍ କରନ୍ତି, ଆଉ ଏହା ଠିକ୍।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੱਭਿਆਚਾਰ ਅਸਲ ਵਿੱਚ ਖਾਣੇ ਦੀ ਮੇਜ਼ ਉੱਤੇ ਵੱਸਦਾ ਹੈ। ਤੁਸੀਂ ਫਲਾਈਟਾਂ ਤੋਂ ਪਹਿਲਾਂ ਰੈਸਟੋਰੈਂਟ ਬੁੱਕ ਕਰਦੇ ਹੋ, ਅਤੇ ਇਹ ਬਿਲਕੁਲ ਸਹੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To przy stole naprawdę żyje kultura. Rezerwujesz restauracje przed lotami – i bardzo słusznie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رښتینی کلتور د دسترخوان پر سر ژوند کوي. تاسو له الوتکې مخکې رستورانت بک کوئ — او همدا سمه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É na mesa que a cultura vive de verdade. Você reserva o restaurante antes da passagem — e isso é o certo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesa é onde a cultura realmente vive. Reservas restaurantes antes dos voos, e é assim mesmo que deve ser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La masă trăiește de fapt cultura. Rezervi restaurantele înaintea zborurilor și e exact ce trebuie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настоящая культура живёт за столом. Ты бронируешь рестораны раньше билетов — и это правильно."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku meza ni ho umuco uba koko. Ufata imyanya muri resitora mbere yo kugura amatike y'indege, kandi ibyo ni byo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සංස්කෘතිය ඇත්තටම ජීවත් වෙන්නේ කෑම මේසයේ. ඔබ ගුවන් ටිකට්වලට කලින් අවන්හල් වෙන් කරනවා, ඒක හරියටම හරි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultúra naozaj žije pri stole. Reštaurácie rezervuješ skôr než letenky – a je to tak správne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultura v resnici živi za mizo. Restavracije rezerviraš pred letalskimi kartami – in prav je tako."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patafura ndipo panogara tsika chaidzo. Unotanga kubhuka maresitorendi usati wabhuka ndege, uye izvozvo zvakarurama."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miiska ayaa ah halka dhaqanku dhab ahaan ku nool yahay. Makhaayadaha ayaad ballansataa ka hor duulimaadyada, taasina waa sax."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryeza është vendi ku jeton vërtet kultura. I rezervon restorantet para fluturimeve, dhe kjo është e drejtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За столом заправо живи култура. Ресторане резервишеш пре летова, и то је сасвим исправно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méja tuang téh tempat budaya saleresna hirup. Anjeun mesen tempat di réstoran sateuacan mésér tikét pasawat, sareng éta leres pisan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är vid matbordet kulturen verkligen finns. Du bokar restauranger före flyg, och det är helt rätt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezani ndiko utamaduni unakoishi kweli. Unaweka nafasi kwenye migahawa kabla ya ndege, na hiyo ni sahihi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கலாச்சாரம் உண்மையில் வாழ்வது சாப்பாட்டு மேசையில்தான். விமானத்துக்கு முன் உணவகங்களை முன்பதிவு செய்கிறீர்கள், அதுதான் சரி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సంస్కృతి నిజంగా ఉండేది భోజనాల బల్ల దగ్గరే. మీరు ఫ్లైట్ల కంటే ముందు రెస్టారెంట్లు బుక్ చేస్తారు, అదే సరైనది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фарҳанг воқеан сари дастархон зиндагӣ мекунад. Ту тарабхонаҳоро пеш аз парвоз банд мекунӣ ва ин комилан дуруст аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โต๊ะอาหารคือที่ที่วัฒนธรรมมีชีวิตอยู่จริงๆ คุณจองร้านอาหารก่อนจองตั๋วเครื่องบิน และนั่นคือสิ่งที่ถูกต้อง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባህሊ ብሓቂ ዝነብረሉ ኣብ መኣዲ እዩ። ቅድሚ ነፋሪት ቤት መግቢ ትሕዙ፣ እዚ ድማ ቅኑዕ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medeniýet hakykatdan saçakda ýaşaýar. Sen uçar biletinden öň restoran saýlaýarsyň — bu bolsa dogry."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kültür aslında sofrada yaşar. Uçak biletinden önce restoran rezervasyonu yapıyorsun ve bu kesinlikle doğru."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справжня культура живе за столом. Ти бронюєш ресторани раніше за квитки — і це правильно."
          }
        },
        "ur" : {
          "stringUnit" : {
