        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceridad. Le pasa a casi todo el mundo. Lo más importante es la disposición a examinarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Enamik inimesi on samas seisus. Valmisolek seda uurida on kõige olulisem osa."
