    "More trips, less per trip. You want volume of experience. Hostels and street food don't scare you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رحلات أكثر وإنفاق أقل في كل رحلة. تريدون أكبر قدر من التجارب، ولا تخيفكم النُّزل البسيطة وطعام الشارع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víc cest, míň za každou. Chceš co nejvíc zážitků. Hostely a pouliční jídlo tě nevyděsí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere rejser, mindre pr. rejse. Du vil have mange oplevelser. Vandrerhjem og streetfood skræmmer dig ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Reisen, weniger pro Reise. Du willst möglichst viel erleben. Hostels und Streetfood schrecken dich nicht ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περισσότερα ταξίδια, λιγότερα έξοδα στο καθένα. Θέλεις πολλές εμπειρίες. Οι ξενώνες και το street food δεν σε τρομάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más viajes, menos gasto por viaje. Quieres vivir muchas experiencias. Los albergues y la comida callejera no te asustan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enemmän matkoja, vähemmän per matka. Haluat paljon kokemuksia. Hostellit ja katuruoka eivät pelota sinua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas maraming biyahe, mas mura bawat isa. Gusto mo ng dami ng karanasan. Hindi ka natatakot sa hostel at street food."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de voyages, moins cher à chaque fois. Tu veux multiplier les expériences. Les auberges de jeunesse et la street food ne te font pas peur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר טיולים, פחות לכל טיול. כמות החוויות היא מה שחשוב לך. הוסטלים ואוכל רחוב לא מפחידים אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा ट्रिप, हर ट्रिप पर कम ख़र्च। आपको ढेर सारे अनुभव चाहिए। हॉस्टल और स्ट्रीट फ़ूड से आपको डर नहीं लगता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Több utazás, kevesebb pénz egy-egy útra. Az élmények mennyisége számít. A hostelek és az utcai kaja nem riasztanak el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak perjalanan, lebih hemat per perjalanan. Kamu mengejar banyaknya pengalaman. Hostel dan jajanan kaki lima nggak bikin kamu takut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più viaggi, meno spesa per ciascuno. Vuoi tante esperienze. Ostelli e street food non ti spaventano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回あたりの費用を抑えて、旅の回数を増やしたいタイプです。とにかくたくさん体験したい。ゲストハウスも屋台ごはんもへっちゃらです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 적게 쓰고 더 자주 떠나요. 경험의 양이 중요하죠. 게스트하우스나 길거리 음식도 두렵지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak percutian, kurang belanja setiap kali. Anda mahukan pengalaman yang banyak. Hostel dan makanan tepi jalan tidak menakutkan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere turer, mindre per tur. Du vil ha mange opplevelser. Hostel og gatemat skremmer deg ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer reizen, minder per reis. Je wilt zo veel mogelijk beleven. Hostels en streetfood schrikken je niet af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej wyjazdów, mniej na każdy. Chcesz jak najwięcej przeżyć. Hostele i jedzenie z ulicy cię nie straszą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais viagens, menos por viagem. Você quer quantidade de experiências. Hostel e comida de rua não assustam você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai multe călătorii, mai puțini bani pe fiecare. Vrei cât mai multe experiențe. Hostelurile și mâncarea de stradă nu te sperie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше поездок, меньше трат на каждую. Тебе важно количество впечатлений. Хостелы и уличная еда тебя не пугают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler resor, mindre per resa. Du vill ha många upplevelser. Vandrarhem och gatumat skrämmer dig inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เที่ยวบ่อยขึ้น จ่ายต่อทริปน้อยลง คุณอยากได้ประสบการณ์เยอะๆ โฮสเทลและสตรีทฟู้ดไม่ทำให้คุณหวั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha çok gezi, gezi başına daha az harcama. Bol deneyim istiyorsun. Hosteller ve sokak yemekleri seni korkutmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше подорожей, менше витрат на кожну. Тобі важлива кількість вражень. Хостели й вулична їжа тебе не лякають."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi nhiều chuyến, mỗi chuyến chi ít. Bạn muốn thật nhiều trải nghiệm. Hostel và đồ ăn đường phố chẳng làm khó được bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多去几趟，每趟少花点。你追求体验的数量。青旅和路边摊吓不倒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多去幾趟，每趟少花一點。你追求體驗的數量，青年旅館和路邊小吃都嚇不倒你。"
          }
        }
      }
    },
    "Morning compatibility is surprisingly important when you share a space." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوافق الصباحي مهم أكثر مما يُتوقع حين تتشاركان المكان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když sdílíte jeden prostor, ranní souhra je překvapivě důležitá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det betyder overraskende meget, at jeres morgener passer sammen, når I bor sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ihr euch ein Zuhause teilt, ist es überraschend wichtig, dass eure Morgen zusammenpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να ταιριάζετε τα πρωινά είναι εκπληκτικά σημαντικό όταν μοιράζεστε τον ίδιο χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser compatibles por las mañanas importa más de lo que parece cuando se comparte casa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamujen yhteensopivuus on yllättävän tärkeää, kun asutte yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakagulat kung gaano kahalaga ang pagkakatugma sa umaga kapag iisa ang tinitirhan ninyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'accorder le matin compte étonnamment quand on partage le même toit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה בבקרים חשובה במפתיע כשחולקים מרחב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप एक ही जगह रहते हैं, तो सुबह का तालमेल हैरानी की हद तक अहम होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha közös a lakás, meglepően fontos, hogy a reggeleitek összeférjenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecocokan di pagi hari ternyata penting saat kalian tinggal bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si condivide lo stesso spazio, avere mattine compatibili conta più di quanto si pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に暮らすなら、朝の相性は意外と大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 공간에서 지낸다면 아침 리듬이 맞는지가 생각보다 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keserasian waktu pagi lebih penting daripada yang disangka apabila anda berkongsi ruang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å passe sammen om morgenen er overraskende viktig når dere deler hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je samenwoont, is het verrassend belangrijk dat jullie ochtenden bij elkaar passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowanie porannych rytmów jest zaskakująco ważne, gdy mieszkacie razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compatibilidade de manhã é surpreendentemente importante quando se divide o mesmo espaço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibilitatea de dimineață e surprinzător de importantă când locuiți împreună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместимость по утрам на удивление важна, когда вы живёте вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ha liknande morgnar är förvånansvärt viktigt när man bor ihop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้ากันได้ตอนเช้าสำคัญกว่าที่คิดเมื่อใช้พื้นที่ร่วมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı evi paylaşırken sabah uyumu şaşırtıcı derecede önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумісність уранці напрочуд важлива, коли ви живете разом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hợp nhau vào buổi sáng quan trọng đến bất ngờ khi sống chung một nhà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住在一起时，早晨合不合拍出乎意料地重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住在一起時，早晨合不合得來，比想像中重要。"
          }
        }
      }
    },
    "Morning person through and through. You probably make better decisions, have deeper conversations, and feel most creative before noon." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنتم صباحيون حتى النخاع. على الأرجح تتخذون قرارات أفضل، وتخوضون أحاديث أعمق، وتكونون في أوج إبداعكم قبل الظهر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranní ptáče každým coulem. Před polednem se nejspíš líp rozhoduješ, vedeš hlubší rozhovory a máš nejvíc nápadů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgenmenneske hele vejen igennem. Du træffer nok bedre beslutninger, har dybere samtaler og er mest kreativ før middag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch und durch Morgenmensch. Vor Mittag triffst du wahrscheinlich die besseren Entscheidungen, führst tiefere Gespräche und bist am kreativsten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνθρωπος του πρωινού μέχρι το κόκαλο. Μάλλον παίρνεις καλύτερες αποφάσεις, κάνεις βαθύτερες κουβέντες και έχεις τη μεγαλύτερη έμπνευση πριν το μεσημέρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo tuyo son las mañanas, sin duda. Seguramente tomas mejores decisiones, tienes conversaciones más profundas y tu creatividad está en su punto antes del mediodía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamuihminen henkeen ja vereen. Teet luultavasti parempia päätöksiä, käyt syvempiä keskusteluja ja tunnet olosi luovimmaksi ennen puoltapäivää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morning person ka talaga. Malamang mas maganda ang mga desisyon mo, mas malalim ang mga usapan, at pinakamalikhain ka bago magtanghali."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es du matin, sans aucun doute. Tu prends sûrement de meilleures décisions, as des discussions plus profondes et ta créativité est au sommet avant midi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אדם של בוקר עד הסוף. כנראה שלפני הצהריים ההחלטות שלך טובות יותר, השיחות עמוקות יותר והיצירתיות בשיאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी तरह सुबह वाले इंसान। दोपहर से पहले आप शायद बेहतर फ़ैसले लेते हैं, गहरी बातें करते हैं और सबसे ज़्यादा रचनात्मक महसूस करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ízig-vérig reggeli ember vagy. Valószínűleg délelőtt hozod a legjobb döntéseket, akkor jönnek a legmélyebb beszélgetések, és akkor vagy a legkreatívabb."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang pagi sejati. Kamu mungkin mengambil keputusan lebih baik, ngobrol lebih dalam, dan paling kreatif sebelum tengah hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mattino è il tuo regno. Probabilmente prima di mezzogiorno prendi decisioni migliori, fai conversazioni più profonde e ti senti al massimo della creatività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根っからの朝型です。午前中のほうが判断も冴え、深い話ができ、いちばんクリエイティブになれるでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누가 봐도 아침형 인간이에요. 정오 전에 더 좋은 결정을 내리고, 더 깊은 대화를 나누고, 가장 창의적이라고 느낄 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memang orang pagi sejati. Anda mungkin membuat keputusan lebih baik, berbual lebih mendalam dan paling kreatif sebelum tengah hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgenmenneske til fingerspissene. Du tar nok bedre avgjørelser, har dypere samtaler og er mest kreativ før lunsj."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ochtendmens in hart en nieren. Vóór de middag neem je waarschijnlijk betere beslissingen, voer je diepere gesprekken en ben je het creatiefst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranny ptaszek z krwi i kości. Przed południem zapewne podejmujesz najlepsze decyzje, prowadzisz najgłębsze rozmowy i masz najwięcej kreatywności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoa da manhã de carteirinha. Você provavelmente decide melhor, tem conversas mais profundas e sente mais criatividade antes do meio-dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ești om al dimineții până în măduva oaselor. Probabil iei decizii mai bune, ai discuții mai profunde și ai cele mai creative idei înainte de prânz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаворонок до мозга костей. Скорее всего, до полудня ты принимаешь лучшие решения, ведёшь самые глубокие разговоры и чаще всего ловишь вдохновение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgonmänniska ut i fingerspetsarna. Du fattar nog bättre beslut, har djupare samtal och är som mest kreativ före lunch."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนตื่นเช้าเต็มตัว คุณน่าจะตัดสินใจได้ดีกว่า คุยกันได้ลึกกว่า และสร้างสรรค์ที่สุดก่อนเที่ยง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen tam bir sabah insanısın. Muhtemelen öğleden önce daha iyi kararlar veriyor, daha derin sohbetler ediyor ve en yaratıcı halini yaşıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти — жайворонок до кісток. Мабуть, до полудня тобі краще вдаються рішення, глибші розмови й творчість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đúng chuẩn người của buổi sáng. Có lẽ bạn quyết định sáng suốt hơn, trò chuyện sâu hơn và sáng tạo nhất trước buổi trưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是彻头彻尾的早起型。中午之前，你多半判断最准、聊得最深、也最有创意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是道道地地的晨型人。中午以前，你大概做決定最清楚、聊天最深入，也最有創意。"
          }
        }
      }
    },
    "Mornings are something to survive, not enjoy. You probably thrive later in the day — and that's fine, just worth knowing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصباح شيء تتجاوزونه، لا تستمتعون به. على الأرجح تزدهرون لاحقًا في اليوم، ولا بأس في ذلك، لكن من الجيد معرفته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rána jsou na přežití, ne na užívání. Nejspíš rozkvétáš až později během dne – a to je v pořádku, jen je dobré to vědět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgener er noget, man skal overleve, ikke nyde. Du blomstrer nok senere på dagen – og det er helt fint, bare godt at vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Morgen überstehst du eher, als ihn zu genießen. Später am Tag läufst du wahrscheinlich zur Hochform auf – völlig okay, aber gut zu wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πρωινά απλώς τα βγάζεις, δεν τα απολαμβάνεις. Μάλλον ανθίζεις αργότερα μέσα στη μέρα — και δεν πειράζει, απλώς αξίζει να το ξέρετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las mañanas son para sobrevivirlas, no para disfrutarlas. Seguramente rindes más a medida que avanza el día, y está bien; solo es bueno saberlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamuista selvitään, niistä ei nautita. Olet luultavasti parhaimmillasi myöhemmin päivällä – ja se on ihan ok, mutta hyvä tietää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang umaga ay isang bagay na kailangang malampasan, hindi i-enjoy. Malamang mas buhay ka sa bandang hapon — at ayos lang iyan, mabuti lang na alam ninyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le matin, tu le subis plus que tu n'en profites. Tu t'épanouis sûrement plus tard dans la journée, et c'est très bien, c'est juste bon à savoir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "את הבוקר צריך לשרוד, לא ליהנות ממנו. כנראה שהשיא שלך מגיע מאוחר יותר ביום — וזה בסדר, רק שווה לדעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह आपके लिए झेलने की चीज़ है, मज़े की नहीं। शायद आप दिन ढलने के साथ खिलते हैं — और यह ठीक है, बस जानने लायक है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reggelt túlélni kell, nem élvezni. Valószínűleg a nap későbbi részében vagy elemedben – és ez rendben van, csak jó tudni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi itu untuk dilewati, bukan dinikmati. Kamu mungkin lebih bersinar di siang atau malam hari — dan itu nggak apa-apa, cuma perlu diketahui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mattine sono qualcosa da superare, non da godersi. Probabilmente dai il meglio più tardi nella giornata — e va benissimo, è solo bene saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝は楽しむものではなく、乗り切るもの。きっと一日の後半に本領を発揮するタイプです。それで大丈夫。知っておくと役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침은 즐기는 게 아니라 버티는 시간이에요. 하루 중 늦은 시간에 더 빛날 거예요. 괜찮아요, 알아 두기만 하면 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi ialah sesuatu untuk ditempuhi, bukan dinikmati. Anda mungkin lebih cergas apabila hari semakin lewat — dan itu tidak mengapa, cuma elok diketahui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgener er noe man kommer seg gjennom, ikke noe man nyter. Du blomstrer nok senere på dagen – og det er helt greit, bare verdt å vite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ochtend is iets om door te komen, niet om van te genieten. Later op de dag kom je waarschijnlijk pas echt op gang – en dat is prima, gewoon goed om te weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poranki trzeba przetrwać, a nie się nimi cieszyć. Pewnie rozkwitasz później w ciągu dnia – i to w porządku, po prostu warto o tym wiedzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manhã é para sobreviver, não para curtir. Você provavelmente rende melhor mais tarde — e tudo bem, só vale saber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminețile sunt de supraviețuit, nu de savurat. Probabil înflorești mai târziu în zi — și e în regulă, doar că merită știut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро нужно пережить, а не наслаждаться им. Скорее всего, ты расцветаешь ближе к вечеру — и это нормально, просто стоит знать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgnar är något att överleva, inte njuta av. Du blommar nog upp senare på dagen – och det är helt okej, bara bra att veta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงเช้าคือสิ่งที่ต้องฝ่าไปให้ได้ ไม่ใช่ช่วงเวลาที่จะมาเพลิดเพลิน คุณคงมีพลังมากขึ้นในช่วงหลังของวัน ซึ่งก็ไม่เป็นไร แค่รู้ไว้ก็ดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabahlar keyif alınacak değil, atlatılacak bir şey. Muhtemelen günün ilerleyen saatlerinde açılıyorsun; bu gayet normal, sadece bilmekte fayda var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ранок треба пережити, а не насолоджуватися ним. Мабуть, ти розквітаєш пізніше — і це нормально, просто варто про це знати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buổi sáng là thứ để vượt qua, không phải để tận hưởng. Có lẽ bạn tỏa sáng hơn vào cuối ngày — và điều đó hoàn toàn ổn, chỉ là đáng để biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早晨是用来熬过去的，不是用来享受的。你多半在一天晚些时候状态更好——这没关系，只是值得让对方知道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早晨對你來說是要撐過去，而不是享受。你大概到了晚一點才會進入狀態，這沒關係，只是值得讓對方知道。"
          }
        }
      }
    },
    "Mornings set the tone for your whole day. You need a gentle start — a rushed or chaotic morning throws you off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصباح يحدد نبرة يومكم كله. تحتاجون إلى بداية لطيفة، فالصباح المستعجل أو الفوضوي يُربككم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ráno udává tón celému tvému dni. Potřebuješ pozvolný start – uspěchané nebo chaotické ráno tě rozhodí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgenen sætter tonen for hele din dag. Du har brug for en blid start – en stresset eller kaotisk morgen slår dig ud af kurs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Morgen gibt den Ton für deinen ganzen Tag an. Du brauchst einen sanften Start – ein hektischer oder chaotischer Morgen bringt dich aus dem Takt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρωί δίνει τον τόνο σε όλη σου τη μέρα. Χρειάζεσαι ένα απαλό ξεκίνημα — ένα βιαστικό ή χαοτικό πρωινό σε βγάζει εκτός."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las mañanas marcan el tono de todo tu día. Necesitas un comienzo suave; una mañana con prisas o caótica te descoloca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamu määrää koko päiväsi sävyn. Tarvitset lempeän alun – kiireinen tai kaoottinen aamu heittää sinut raiteiltasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang umaga ang nagtatakda ng tono ng buong araw mo. Kailangan mo ng banayad na simula — nagugulo ka kapag nagmamadali o magulo ang umaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le matin donne le ton de toute ta journée. Tu as besoin d'un démarrage en douceur : une matinée pressée ou chaotique te déstabilise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבוקר קובע לך את הטון לכל היום. יש לך צורך בהתחלה עדינה — בוקר לחוץ או כאוטי מוציא אותך מאיזון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह आपके पूरे दिन का मिज़ाज तय करती है। आपको आराम से शुरुआत चाहिए — जल्दबाज़ी या अफ़रा-तफ़री वाली सुबह आपका पूरा दिन बिगाड़ देती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reggel meghatározza az egész napodat. Szelíd kezdésre van szükséged – egy rohanós vagy kaotikus reggel kizökkent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi menentukan suasana seharianmu. Kamu butuh awal yang lembut — pagi yang terburu-buru atau kacau bikin harimu berantakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mattino dà il tono a tutta la tua giornata. Ti serve un inizio dolce — una mattina di corsa o caotica ti manda fuori strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝がその日一日を左右するタイプです。穏やかなスタートが必要で、慌ただしい朝だと調子が狂ってしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침이 하루 전체의 분위기를 정해요. 부드러운 시작이 필요하죠. 아침이 바쁘거나 정신없으면 하루가 흔들려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi menentukan suasana sepanjang hari anda. Anda perlukan permulaan yang lembut — pagi yang tergesa-gesa atau kelam-kabut mengganggu anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgenen setter tonen for hele dagen din. Du trenger en myk start – en stressete eller kaotisk morgen setter deg helt ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ochtend zet de toon voor je hele dag. Jij hebt een zachte start nodig – een gehaaste of chaotische ochtend haalt je uit je evenwicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poranek nadaje ton całemu dniu. Potrzebujesz łagodnego startu – pośpiech czy chaos rano wytrącają cię z równowagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A manhã define o tom do seu dia inteiro. Você precisa de um começo suave — uma manhã corrida ou caótica tira você do eixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimineața dă tonul întregii zile. Ai nevoie de un început blând — o dimineață grăbită sau haotică te dă peste cap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро задаёт тон всему дню. Тебе нужно мягкое начало — суматошное утро выбивает тебя из колеи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgonen sätter tonen för hela din dag. Du behöver en mjuk start – en stressig eller kaotisk morgon får dig ur balans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงเช้ากำหนดบรรยากาศของทั้งวันสำหรับคุณ คุณต้องการการเริ่มต้นแบบนุ่มนวล เช้าที่เร่งรีบหรือวุ่นวายทำให้คุณเสียจังหวะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabahlar bütün gününün tonunu belirliyor. Yumuşak bir başlangıca ihtiyacın var; aceleli ya da karmaşık bir sabah dengeni bozuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ранок задає тон усьому дню. Тобі потрібен м’який старт — поспіх чи хаос уранці вибивають тебе з колії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buổi sáng định nhịp cho cả ngày của bạn. Bạn cần khởi đầu nhẹ nhàng — một buổi sáng vội vã hay hỗn loạn khiến bạn lệch nhịp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早晨决定你一整天的基调。你需要温和地开始——匆忙或混乱的早晨会打乱你的节奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早晨決定你一整天的基調。你需要溫和地開始，匆忙或混亂的早晨會打亂你的節奏。"
          }
        }
      }
    },
    "Most conflict issues aren't about who's right — they're about two different styles colliding." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معظم الخلافات لا تتعلق بمن هو على حق، بل باصطدام أسلوبين مختلفين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Většina konfliktů není o tom, kdo má pravdu – jde o střet dvou různých stylů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste konflikter handler ikke om, hvem der har ret – men om to forskellige stilarter, der støder sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei den meisten Konflikten geht es nicht darum, wer recht hat – sondern darum, dass zwei verschiedene Stile aufeinanderprallen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι περισσότερες συγκρούσεις δεν αφορούν το ποιος έχει δίκιο — αφορούν δύο διαφορετικά στυλ που συγκρούονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de los conflictos no van de quién tiene razón: son dos estilos distintos que chocan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useimmat riidat eivät koske sitä, kuka on oikeassa – niissä kaksi erilaista tyyliä törmää toisiinsa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karamihan sa mga away ay hindi tungkol sa kung sino ang tama — tungkol ito sa dalawang magkaibang istilong nagbabanggaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des conflits ne sont pas une question de qui a raison : ce sont deux styles différents qui se heurtent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוב הקונפליקטים הם לא על מי צודק — אלא על שני סגנונות שונים שמתנגשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादातर झगड़े इस बारे में नहीं होते कि कौन सही है — बल्कि दो अलग-अलग तरीक़ों के टकराने से होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legtöbb konfliktus nem arról szól, kinek van igaza – hanem két különböző stílus ütközéséről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan konflik bukan soal siapa yang benar — tapi dua gaya berbeda yang bertabrakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte dei conflitti non riguarda chi ha ragione — nasce da due stili diversi che si scontrano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケンカの多くは、どちらが正しいかではなく、ふたつの異なるスタイルがぶつかることで起こります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 갈등은 누가 옳은지가 아니라, 서로 다른 방식이 부딪히면서 생겨요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan konflik bukan tentang siapa yang betul — tetapi tentang dua gaya berbeza yang bertembung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste konflikter handler ikke om hvem som har rett – men om to ulike stiler som kolliderer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meeste conflicten gaan niet over wie er gelijk heeft – het zijn twee verschillende stijlen die botsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość konfliktów nie dotyczy tego, kto ma rację – to zderzenie dwóch różnych stylów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos conflitos não é sobre quem tem razão — é sobre dois estilos diferentes se chocando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majoritatea conflictelor nu țin de cine are dreptate — țin de două stiluri diferite care se ciocnesc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство конфликтов не о том, кто прав, а о столкновении двух разных стилей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De flesta konflikter handlar inte om vem som har rätt – utan om två olika stilar som krockar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
