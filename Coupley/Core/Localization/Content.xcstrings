        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყველასთვის სწორი პასუხი არ არსებობს — მაგრამ აქ შეთანხმება სერიოზულ უთანხმოებას აგარიდებთ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бәріне бірдей дұрыс жауап жоқ — бірақ бұл жерде көзқарастың үйлесуі үлкен түсініспеушіліктің алдын алады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានចម្លើយណាត្រឹមត្រូវសម្រាប់គ្រប់គ្នាទេ — ប៉ុន្តែការយល់ស្របគ្នាលើរឿងនេះ ការពារការទាស់ទែងធ្ងន់ធ្ងរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎಲ್ಲರಿಗೂ ಸರಿಹೊಂದುವ ಉತ್ತರ ಇಲ್ಲ — ಆದರೆ ಇಲ್ಲಿ ಒಮ್ಮತವಿದ್ದರೆ ಗಂಭೀರ ಘರ್ಷಣೆ ತಪ್ಪುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 맞는 정답은 없지만, 생각을 맞춰 두면 큰 갈등을 막을 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersiveke ku ji bo her kesî rast be tune — lê li vir lihevkirin pêşiya nakokiyên giran digire."
