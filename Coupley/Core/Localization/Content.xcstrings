        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细小又贴心的照顾，就是你的爱的语言。记得你喜欢什么，这份细节很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小小的、貼心的照顧，就是你的愛之語。記得你喜歡什麼，這份細心很重要。"
