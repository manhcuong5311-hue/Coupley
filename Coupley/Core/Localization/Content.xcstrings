    "Board games with friends — that's my thing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألعاب الطاولة مع الأصدقاء — هذا عالمي"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskovky s přáteli – to je moje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brætspil med venner – det er lige mig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brettspiele mit Freund:innen – mein Ding"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτραπέζια με φίλους — αυτό είναι το δικό μου"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juegos de mesa con amistades — es lo mío"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautapelit kavereiden kanssa – se on minun juttuni"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Board games kasama ang barkada — ’yan ang hilig ko"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux de société entre amis — c'est mon truc"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משחקי קופסה עם חברים — זה הקטע שלי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्तों के साथ बोर्ड गेम — यही मेरा शौक़ है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Társasozás barátokkal – ez az én világom"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Board game bareng teman — itu aku banget"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giochi da tavolo con gli amici — è la mia passione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達とボードゲームが好き"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들과 보드게임, 그게 제 취향이에요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan papan dengan kawan — itu kegemaran saya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brettspill med venner – det er min greie"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordspellen met vrienden – mijn ding"
          }
        },
        "pl" : {
          "stringUnit" : {
