          "stringUnit" : {
            "state" : "translated",
            "value" : "Excuses die de plank misslaan, kunnen erger voelen dan helemaal geen – dit is dus belangrijk."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupepesa kosafika pamtima kumatha kupweteka kuposa kusapepesa n'komwe — izi nzofunika."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhiifamni bakka isaa hin argatin tokkollee dhabuu caalaa nama miidhuu danda'a — kun barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଠିକ୍ ଜାଗାରେ ନ ପହଞ୍ଚୁଥିବା କ୍ଷମାପ୍ରାର୍ଥନା ନ ମାଗିବାଠୁ ବି ଖରାପ ଲାଗିପାରେ — ଏହା ଜରୁରି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗ਼ਲਤ ਢੰਗ ਨਾਲ ਮੰਗੀ ਮਾਫ਼ੀ ਕਈ ਵਾਰ ਮਾਫ਼ੀ ਨਾ ਮੰਗਣ ਨਾਲੋਂ ਵੀ ਬੁਰੀ ਲੱਗਦੀ ਹੈ — ਇਹ ਗੱਲ ਅਹਿਮ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nietrafione przeprosiny potrafią zaboleć bardziej niż żadne – to ważne."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هغه بښنه چې ځای ته ونه رسېږي، کېدای شي له هېڅ بښنې بدتره وي — دا مهمه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pedido de desculpas que erra o alvo pode ser pior do que nenhum — isso importa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pedido de desculpas que falha o alvo pode ser pior do que nenhum — isto importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O scuză nepotrivită poate durea mai mult decât niciuna — asta contează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неудачное извинение бывает хуже, чем никакого, — так что это важно."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbabazi zisabwe nabi zishobora kubabaza kuruta kutazisaba — ibi bifite akamaro."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හරියට ඉලක්කයට නොවදින සමාව ඉල්ලීමක් කිසිවක් නැතිවාට වඩා නරක වෙන්න පුළුවන් — මේක වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ospravedlnenie, ktoré minie cieľ, môže byť horšie než žiadne – toto je dôležité."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravičilo, ki zgreši, je lahko slabše kot nobeno – zato je to pomembno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukumbira ruregerero kusingasviki pachinangwa kunogona kurwadza kupfuura kusakumbirwa zvachose — izvi zvinokosha."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raalli-gelin aan meesheeda ku dhicin waxay ka xumaan kartaa mid aan jirin — tani waa muhiim."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një falje që nuk e qëllon shenjën mund të duket më keq se asnjë fare – kjo ka rëndësi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извињење које промаши може бити горе него никакво — ово је важно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapunten anu teu kena sasaran tiasa karaos langkung awon tibatan teu aya pisan — ieu penting."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ursäkt som missar målet kan kännas värre än ingen alls – det här spelar roll."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Msamaha usiolenga shabaha unaweza kuumiza kuliko kutokuwepo kabisa — hili ni muhimu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சரியாகச் சேராத மன்னிப்பு, மன்னிப்பே கேட்காததை விட மோசமாகத் தோன்றலாம் — இது முக்கியம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సరిగ్గా తాకని క్షమాపణ అసలు లేకపోవడం కంటే ఘోరంగా అనిపించవచ్చు — ఇది ముఖ్యం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узре, ки ба ҳадаф намерасад, метавонад аз умуман набуданаш бадтар бошад — ин муҳим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอโทษที่ไม่ตรงใจอาจแย่กว่าไม่ขอโทษเลย เรื่องนี้จึงสำคัญ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዕላምኡ ዝሰሓተ ይቕሬታ ካብ ዘይምሕታት ክኸፍእ ይኽእል — እዚ ኣገዳሲ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýerine düşmedik ötünç asla ötünç soramazlykdan hem erbet bolup biler — bu möhüm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerini bulmayan bir özür, hiç özür dilenmemesinden daha kötü hissettirebilir; bu önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невдале вибачення може ранити більше, ніж його відсутність, — тож це важливо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانے سے چوکی ہوئی معافی، معافی نہ ہونے سے بھی بُری لگ سکتی ہے — یہ بات اہم ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nishonga tegmagan uzr umuman uzr soʻramaslikdan ham yomonroq tuyulishi mumkin — bu muhim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lời xin lỗi không đúng cách có khi còn tệ hơn không xin lỗi — điều này quan trọng đấy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uxolo olungafikeleli apho kufanele khona lunokuva kubi ngaphezu kokungaxoliswa konke — oku kubalulekile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àforíjìn tí kò dé ibi tó yẹ lè burú ju kí a má tọrọ rárá — èyí ṣe pàtàkì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說不到心坎裡的道歉，可能比不道歉更難受，所以這很重要。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不到位的道歉，可能比不道歉还糟——这很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒說到心坎的道歉，可能比不道歉更糟，所以這很重要。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuxolisa okungashayi khona kungazwakala kukubi kakhulu kunokungaxolisi nhlobo — lokhu kubalulekile."
          }
        }
      }
    },
