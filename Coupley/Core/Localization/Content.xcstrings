        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řídíš se situací a mluvíš upřímně. Pokud dokážeš říct, jak na tom zrovna jsi, tahle flexibilita funguje dobře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situationsbestemt og ærlig. Så længe du kan sige, hvordan du har det, fungerer den fleksibilitet fint."
