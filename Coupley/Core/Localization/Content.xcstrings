        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บางครั้งเดตที่ดีที่สุดคือเดตที่ไม่มีใครต้องใส่รองเท้า คุณเลือกความสบายและความง่ายมากกว่าบรรยากาศ"
