        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyitott vagy a változásra, de ismerős kultúrán belül. Új kezdetet akarsz egy teljes külföldre költözés bizonytalansága nélkül."
