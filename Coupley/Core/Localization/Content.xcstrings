    "A lot — for better and worse, it made me" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثيرًا، بخيرها وشرها صنعتني"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodně – v dobrém i zlém mě to utvořilo"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meget – på godt og ondt har den skabt mig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr – im Guten wie im Schlechten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ — για καλό και για κακό, με έφτιαξε"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucho: para bien y para mal, me formó"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paljon – hyvässä ja pahassa, se teki minusta minut"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malaki — sa mabuti at masama, ito ang humubog sa akin"
