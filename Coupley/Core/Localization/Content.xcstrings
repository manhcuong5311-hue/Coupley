    "The reward for a life of work is seeing the world. You're probably saving toward a version of freedom." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكافأة عمر من العمل هي رؤية العالم. على الأرجح ادخارك موجّه نحو شكل من أشكال الحرية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odměnou za celoživotní práci je poznat svět. Nejspíš si šetříš na svou verzi svobody."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belønningen for et arbejdsliv er at se verden. Du sparer nok op til din egen version af frihed."
