          "stringUnit" : {
            "state" : "translated",
            "value" : "મુસાફરીમાં મેળ રજાને બનાવી કે બગાડી શકે — આ વહેલું જાણવા જેવું છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacewa a tafiya na iya gyara ko ɓata hutu — ya dace a sani tun da wuri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה בטיולים יכולה לעשות או להרוס חופשה — שווה לדעת את זה מוקדם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़र में तालमेल छुट्टी बना भी सकता है और बिगाड़ भी — इसे जल्दी जान लेना अच्छा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibilnost na putovanjima može stvoriti ili upropastiti odmor – vrijedi to znati na vrijeme."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè nou pa vwayaje menm jan, sa ka fè oswa defèt yon vakans — li bon pou konnen sa bonè."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy mennyire vagytok jó útitársak, azon múlhat egy egész nyaralás – ezt érdemes korán tudni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճամփորդելու համատեղելիությունը կարող է արձակուրդը դարձնել հրաշալի կամ փչացնել այն — արժե դա վաղ իմանալ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecocokan saat traveling bisa bikin liburan sukses atau gagal — ini layak diketahui sejak awal."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikwekọ na njem nwere ike ime ka ezumike mara mma ma ọ bụ mebie ya — ọ bara uru ịma nke a n'oge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvort þið passið saman á ferðalögum getur ráðið úrslitum um fríið – gott að vita það snemma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compatibilità in viaggio può salvare o rovinare una vacanza — meglio saperlo presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅の相性は旅行の成否を左右します。早めに知っておく価値があります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocoging gaya lelungan bisa nggawe liburan apik utawa ambyar — iki pantes dimangerteni wiwit awal."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოგზაურობაში თავსებადობამ შეიძლება შვებულება გააფუჭოს ან გაალამაზოს — ამის ადრევე ცოდნა ღირს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапардағы үйлесім демалысты не тамаша етеді, не бұзады — мұны ерте білген жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពត្រូវគ្នាពេលធ្វើដំណើរ អាចធ្វើឲ្យថ្ងៃឈប់សម្រាកល្អ ឬខូច — គួរដឹងរឿងនេះតាំងពីដំបូង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರವಾಸದ ಹೊಂದಾಣಿಕೆ ರಜೆಯನ್ನು ಸುಂದರವಾಗಿಸಬಹುದು ಅಥವಾ ಕೆಡಿಸಬಹುದು — ಇದನ್ನು ಬೇಗನೆ ತಿಳಿದಿರುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 궁합에 따라 휴가가 즐거울 수도, 망칠 수도 있어요. 일찍 알아 두면 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihevhatina di gerê de dikare betlaneyekê xweş bike an xera bike — hêja ye ku zû bê zanîn."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саякаттагы шайкештик эс алууну сонун же бузук кылышы мүмкүн — муну эрте билген жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob dir beim Reesen zesummepasst, kann eng Vakanz maachen oder kapott maachen — dat ass gutt, fréi ze wëssen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເຂົ້າກັນໄດ້ເວລາທ່ຽວ ຕັດສິນໄດ້ເລີຍວ່າວັນພັກຈະດີ ຫຼື ພັງ — ຄວນຮູ້ໄວ້ແຕ່ເນີ່ນໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelionių suderinamumas gali atostogas padaryti arba sugadinti – tai verta žinoti anksti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceļošanas saderība var padarīt atvaļinājumu lielisku vai to sabojāt – to vērts zināt laikus."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fifanarahana amin'ny fomba fandehanana dia mety hahatsara na hanimba ny fialan-tsasatra — mendrika ho fantatra aloha izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka hanga, ka whakangaro rānei te ōrite o te haere i tētahi hararei — he pai kia mōhiotia moata."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усогласеноста на патувањето може да направи или да уништи одмор — ова вреди да се знае навреме."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "യാത്രയിലെ ഒത്തുപോക്കാണ് ഒരു അവധിക്കാലം നന്നാക്കുന്നതും മോശമാക്കുന്നതും — ഇത് നേരത്തെ അറിയുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аяллын нийцэл амралтыг бүтээж ч, сүйтгэж ч чадна — үүнийг эрт мэдэх нь зүйтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रवासाच्या आवडी जुळल्या तर सुट्टी छान होते, नाहीतर बिघडते — हे लवकर माहीत असलेले बरे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keserasian ketika melancong boleh menentukan berjaya atau gagalnya percutian — elok diketahui awal."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kompatibbiltà fl-ivvjaġġar tista' tagħmel jew tkisser vaganza — ta' min tkun taf dan kmieni."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခရီးသွားပုံ ကိုက်ညီမှုက အားလပ်ရက်ကို ကောင်းစေနိုင်သလို ဖျက်ဆီးနိုင်တယ် — စောစော သိထားသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om dere passer sammen på reise, kan avgjøre hele ferien – verdt å vite tidlig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रामा तालमेल मिल्नु वा नमिल्नुले बिदा बनाउन वा बिगार्न सक्छ — यो सुरुमै थाहा पाउनु राम्रो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of jullie qua reizen bij elkaar passen, kan een vakantie maken of breken – goed om dit vroeg te weten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugwirizana pa maulendo kungapangitse tchuthi kukhala chabwino kapena choipa — nchofunika kudziwa msanga."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imalaaf walsimuun boqonnaa tokko bareechuu ykn balleessuu danda'a — kana dursanii beekuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାତ୍ରାରେ ମେଳ ଏକ ଛୁଟିକୁ ଗଢ଼ିପାରେ ବା ଭାଙ୍ଗିପାରେ — ଏହା ଆଗରୁ ଜାଣିବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘੁੰਮਣ-ਫਿਰਨ ਦਾ ਮੇਲ ਛੁੱਟੀਆਂ ਨੂੰ ਬਣਾ ਜਾਂ ਵਿਗਾੜ ਸਕਦਾ ਹੈ — ਇਹ ਛੇਤੀ ਜਾਣ ਲੈਣਾ ਚੰਗਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, czy podróżujecie podobnie, potrafi uratować albo zrujnować urlop – warto wiedzieć o tym wcześnie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د سفر سمون کولی شي رخصتي جوړه یا خرابه کړي — ښه به وي له مخکې پرې پوه شئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compatibilidade na viagem pode salvar ou estragar as férias — vale saber disso cedo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compatibilidade a viajar pode fazer ou desfazer umas férias — vale a pena saber isto cedo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibilitatea în călătorii poate face sau desface o vacanță — merită știut din timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместимость в путешествиях может спасти или испортить отпуск — это стоит узнать пораньше."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhuza mu ngendo bishobora kunoza cyangwa kwangiza ikiruhuko — ni byiza kubimenya kare."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගමන් ගැළපීම නිවාඩුවක් සාර්ථක හෝ අසාර්ථක කරන්න පුළුවන් — මේක කලින්ම දැනගන්න වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súlad pri cestovaní môže dovolenku vytvoriť aj zničiť – oplatí sa to vedieť včas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popotniška usklajenost lahko naredi ali uniči dopust – to je vredno vedeti zgodaj."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuwirirana pakufamba kunogona kuita kuti zororo rinakidze kana kuparara — zvakakodzera kuzviziva nekukurumidza."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-waafaqa safarku wuu dhisi karaa ama burburin karaa fasax — tan waa mudan tahay in goor hore la ogaado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të shkuarit mirë në udhëtime mund ta bëjë ose ta prishë një pushim – vlen ta dini herët."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усклађеност на путу може да направи или упропасти одмор — ово вреди знати на време."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kacocogan dina ngumbara tiasa ngajantenkeun atanapi ngaruksak liburan — ieu patut dipikanyaho ti awal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att passa ihop som resesällskap kan göra eller förstöra en semester – värt att veta tidigt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuendana katika safari kunaweza kufanikisha au kuharibu likizo — ni vyema kujua hili mapema."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயணத்தில் ஒத்துப்போவது ஒரு விடுமுறையை உருவாக்கவும் கெடுக்கவும் செய்யும் — இதை ஆரம்பத்திலேயே தெரிந்துகொள்வது நல்லது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రయాణ తీరు కలవడమే హాలిడేను నిలబెడుతుంది లేదా పాడుచేస్తుంది — ఇది ముందుగానే తెలుసుకోవడం మంచిది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мувофиқат дар сафар метавонад таътилро зебо ё вайрон кунад — инро барвақт донистан арзанда аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเที่ยวเข้าขากันหรือไม่อาจชี้ชะตาวันหยุดได้เลย เรื่องนี้ควรรู้ไว้แต่เนิ่นๆ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ መገሻ ምስምማዕ ንዕረፍቲ ከዕውቶ ወይ ከበላሽዎ ይኽእል — ኣቐዲምኩም ምፍላጡ ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syýahatda gabat gelmek dynç alşy ajaýyp ýa-da agyr edip biler — muny ir bilmäge degýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahat uyumu bir tatili güzelleştirebilir de mahvedebilir de; bunu erkenden bilmeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумісність у подорожах може зробити відпустку чудовою або зіпсувати її — це варто знати заздалегідь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر میں ہم آہنگی چھٹیاں بنا بھی سکتی ہے اور بگاڑ بھی — یہ جلد جان لینا اچھا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayohatda bir-biriga mos kelish taʼtilni yo ajoyib, yo barbod qilishi mumkin — buni erta bilgan yaxshi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hợp nhau khi đi du lịch có thể làm nên hoặc phá hỏng một kỳ nghỉ — điều này nên biết sớm."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuvumelana kwindlela yokuhamba kunokwakha okanye kutshabalalise iholide — kufanelekile ukukwazi kwangoko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíbá ara mu nínú ìrìn-àjò lè gbé ìsinmi ró tàbí bà á jẹ́ — ó yẹ kí ẹ mọ èyí ní kùtùkùtù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行合不合拍，足以成就或毀掉一個假期，值得及早知道。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行合不合拍，能决定一次假期的成败——值得早点了解。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行合不合拍，可能決定一趟假期的成敗，值得早點知道。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuvumelana ohambweni kungalenza noma kulibulale iholide — lokhu kufanele kwaziwe kusenesikhathi."
          }
