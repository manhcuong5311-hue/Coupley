    "The gift of being heard. You know how to hold space — and you resist the urge to fix. That's rare." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدية أن يُسمَع المرء. تعرفون كيف تحتوون الآخر وتقاومون الرغبة في إصلاح كل شيء، وهذا نادر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar naslouchání. Umíš druhému dát prostor – a odoláš nutkání všechno hned řešit. To je vzácné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du giver andre følelsen af at blive hørt. Du kan rumme det, der bliver sagt, og modstå trangen til at løse det. Det er sjældent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geschenk, gehört zu werden. Du kannst einfach da sein und zuhören – und widerstehst dem Drang, alles zu lösen. Das ist selten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δώρο του να νιώθει κάποιος ότι τον ακούνε. Ξέρεις να δίνεις χώρο — και αντιστέκεσαι στην παρόρμηση να διορθώσεις. Σπάνιο αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El regalo de la escucha. Sabes acompañar sin querer arreglarlo todo, y eso es poco común."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulluksi tulemisen lahja. Osaat antaa tilaa ja vastustat halua korjata asioita. Se on harvinaista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang regalo ng pakikinig. Marunong kang magbigay ng espasyo — at pinipigilan mo ang tuksong ayusin agad. Bihira iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadeau d'une vraie écoute. Tu sais accueillir ce que l'autre vit, sans chercher à tout réparer. C'est rare."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המתנה של להרגיש מוקשבים. יש לך יכולת להכיל — ולהתאפק מהדחף לתקן. זה נדיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुने जाने का तोहफ़ा। किसी को अपनी बात कहने की जगह देना आपको आता है — और तुरंत हल बताने की इच्छा पर आपका क़ाबू रहता है। यह कम ही देखने को मिलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az odafigyelés ajándéka. Tudsz teret tartani – és ellenállsz a késztetésnek, hogy megjavítsd a dolgokat. Ez ritka."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memberi hadiah berupa rasa didengar. Kamu tahu cara menemani — dan menahan dorongan untuk langsung memperbaiki. Itu langka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dono di sentirsi ascoltati. Sai fare spazio all’altro e resisti alla tentazione di aggiustare tutto. È raro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ちゃんと聴いてもらえた」と感じさせられる人。解決したくなる気持ちをこらえて、ただ受け止められるのは、なかなかできないことです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들어 주는 것도 큰 선물이에요. 상대가 마음 놓고 털어놓을 수 있게 곁을 지키고, 고쳐 주고 싶은 마음을 참을 줄 알죠. 흔치 않은 능력이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memberi sesuatu yang berharga: rasa didengari. Anda tahu cara memberi ruang — dan anda menahan diri daripada terus menyelesaikan masalah. Itu jarang ditemui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaven det er å bli hørt. Du vet hvordan du gir rom – og du motstår trangen til å fikse. Det er sjeldent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het cadeau van gehoord worden. Je weet hoe je ruimte geeft – en je weerstaat de neiging om het op te lossen. Dat is zeldzaam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar wysłuchania. Umiesz po prostu być obok i słuchać – i powstrzymujesz się przed naprawianiem. To rzadkie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O presente de ouvir de verdade. Você sabe acolher — e resiste à vontade de consertar. Isso é raro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul de a fi auzit. Știi să faci loc celuilalt — și reziști tentației de a repara totul. E rar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты даришь другим ощущение, что их слышат. Ты умеешь просто быть рядом и не спешишь всё исправлять. Это редкость."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gåvan att bli hörd. Du kan ge någon utrymme – och motstå frestelsen att fixa. Det är sällsynt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมอบของขวัญแห่งการรับฟัง คุณรู้วิธีเปิดพื้นที่ให้อีกฝ่าย และอดใจไม่รีบแก้ปัญหาให้ ซึ่งหาได้ยากมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duyulmanın armağanı. Alan açmayı biliyorsun ve her şeyi düzeltme isteğine direniyorsun. Bu nadir bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти даруєш людям відчуття, що їх чують. Ти вмієш просто бути поруч і стримуєш бажання все виправити. Це рідкість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món quà được lắng nghe. Bạn biết cách ở bên — và kìm được mong muốn sửa chữa mọi thứ. Điều đó hiếm lắm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让对方被听见，是一份礼物。你懂得给对方空间，也忍得住不急着去“解决”，这很难得。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓人被聽見，是一份禮物。你懂得接住對方的情緒，也忍得住想解決問題的衝動，這很難得。"
          }
        }
      }
    },
