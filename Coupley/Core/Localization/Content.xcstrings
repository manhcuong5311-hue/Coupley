        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पक्कै पनि। तपाईंलाई कथा र विचार अझै मन पर्छ — बस तपाईंको जीवनशैलीमा मिल्ने रूपमा।"
