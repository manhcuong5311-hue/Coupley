        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी कुरा निजी नै रहनुपर्छ। सबैका अगाडि औँला ठड्याइनु तपाईंलाई सम्मानको आधारभूत उल्लङ्घनजस्तो लाग्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privé blijft privé. In het openbaar terechtgewezen worden voelt als een fundamenteel gebrek aan respect."
