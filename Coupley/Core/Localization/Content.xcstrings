        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lojërat janë pjesë e vërtetë e jetës tënde shoqërore dhe e kohës së lirë. Partneri yt duhet ta kuptojë kohën dhe komunitetin që vijnë bashkë me to."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игре су прави део твог друштвеног живота и слободног времена. Твоја половина треба да разуме колико времена то тражи и заједницу која иде уз то."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game téh bagian nyata tina kahirupan sosial sareng waktos luang anjeun. Pasangan kedah ngartos waktos sareng komunitas anu aya di jerona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaming är en verklig del av ditt sociala liv och din fritid. En partner behöver förstå tiden och gemenskapen som hör till."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Michezo ni sehemu halisi ya maisha yako ya kijamii na ya mapumziko. Mwenzi anahitaji kuelewa muda na jumuiya inayoambatana nayo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேமிங் உங்கள் சமூக, ஓய்வு வாழ்க்கையின் உண்மையான பகுதி. அதற்கான நேரத்தையும் அதனுடன் வரும் நண்பர் கூட்டத்தையும் உங்கள் துணை புரிந்துகொள்ள வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "గేమింగ్ మీ సామాజిక, విరామ జీవితంలో నిజమైన భాగం. దానికి వెచ్చించే సమయాన్ని, దానితో వచ్చే స్నేహ బృందాన్ని మీ భాగస్వామి అర్థం చేసుకోవాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бозӣ қисми воқеии муошират ва фароғати туст. Ёрат бояд вақт ва ҷамоатеро, ки бо он меояд, фаҳмад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมเป็นส่วนหนึ่งของชีวิตทางสังคมและการพักผ่อนของคุณจริงๆ คนรักต้องเข้าใจทั้งเวลาและคอมมูนิตี้ที่มาพร้อมกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጸወታ ናይ ሓቂ ክፋል ማሕበራዊ ህይወትኩምን ዕረፍትኹምን እዩ። መጻምዲ ነቲ ዝወስዶ ግዜን ምስኡ ዝመጽእ ማሕበረሰብን ክርድኦ ኣለዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oýunlar seniň gatnaşyk we dynç alyş durmuşyňyň hakyky bölegi. Söýgüliň oňa gidýän wagta we onuň bilen gelýän jemgyýete düşünmeli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun, sosyal hayatının ve boş zamanının gerçek bir parçası. Partnerinin bunun gerektirdiği zamanı ve beraberinde gelen topluluğu anlaması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ігри — справжня частина твого дозвілля й соціального життя. Половинці треба розуміти, скільки часу це забирає і яка спільнота з цим пов’язана."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گیمنگ آپ کی سماجی اور تفریحی زندگی کا حقیقی حصہ ہے۔ ساتھی کو اس کے لیے درکار وقت اور اس سے جڑی کمیونٹی کو سمجھنا ہو گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻyinlar ijtimoiy hayotingiz va dam olishingizning haqiqiy bir qismi. Sherigingiz bunga ketadigan vaqtni va u bilan birga keladigan hamjamiyatni tushunishi kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game là một phần thật sự trong đời sống giải trí và xã hội của bạn. Người ấy cần hiểu thời gian và cộng đồng đi kèm với nó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukudlala imidlalo yinxalenye yokwenyani yobomi bakho bentlalo nokuzonwabisa. Iqabane kufuneka liqonde ixesha noluntu oluhamba nako."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eré fídíò jẹ́ apá gidi nínú ìbákẹ́gbẹ́ àti ìgbádùn yín. Olólùfẹ́ yín nílò láti lóye àkókò àti àwùjọ tó ń bá a wá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲是你社交和休閒生活中實實在在的一部分。另一半需要理解它所需的時間，以及隨之而來的圈子。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏是你社交和休闲生活中实实在在的一部分。另一半需要理解它占用的时间，以及随之而来的圈子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲是你社交和休閒生活的重要部分。另一半需要理解它占的時間，以及隨之而來的社群。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imidlalo iyingxenye yangempela yempilo yakho yokuzijabulisa nokuhlalisana nabanye. Umlingani kudingeka aqonde isikhathi nomphakathi ohambisana nakho."
          }
        }
      }
    },
