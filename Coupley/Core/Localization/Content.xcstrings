        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل پر نظر۔ آپ کے لیے رشتہ اختلاف سے بڑا ہے۔ یہ ایک حقیقی خوبی ہے۔"
