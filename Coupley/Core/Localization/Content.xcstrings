        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기운이 없을 땐 괜찮다는 말보다 짐을 덜어 주는 게 나아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila tenaga sudah habis, kelegaan lebih bermakna daripada kata-kata pujukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når energien er borte, er avlastning bedre enn trøst."
