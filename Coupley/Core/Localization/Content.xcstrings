    "Understated. Your humour rewards people who are paying attention. Not everyone gets it — but the ones who do, get you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فكاهة هادئة تكافئ من ينتبه. لا يفهمها الجميع، لكن من يفهمها يفهمكم أنتم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenápadný. Tvůj humor odměňuje ty, kdo dávají pozor. Ne každý ho pochopí – ale kdo ano, ten pochopí i tebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underspillet. Din humor belønner dem, der er opmærksomme. Ikke alle fanger den – men dem, der gør, forstår dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtil. Dein Humor belohnt alle, die genau hinhören. Nicht jeder versteht ihn – aber wer ihn versteht, versteht dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλών τόνων. Το χιούμορ σου ανταμείβει όσους προσέχουν. Δεν το πιάνουν όλοι — αλλά όσοι το πιάνουν, πιάνουν κι εσένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sutil. Tu humor premia a quien presta atención. No todo el mundo lo pilla, pero quien lo hace te entiende de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hillitty. Huumorisi palkitsee ne, jotka ovat tarkkana. Kaikki eivät tajua sitä – mutta ne, jotka tajuavat, ymmärtävät sinua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahimik ang dating. Para sa mga taong nakikinig nang mabuti ang humor mo. Hindi lahat nakakagets — pero ang mga nakakagets, kilala ka talaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout en finesse. Ton humour récompense ceux qui sont attentifs. Tout le monde ne le saisit pas, mais ceux qui le saisissent te comprennent vraiment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאופק. ההומור שלך מתגמל את מי ששם לב. לא כולם קולטים אותו — אבל מי שכן, קולט אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दबा-दबा सा। आपका ह्यूमर ध्यान देने वालों को ही समझ आता है। हर कोई नहीं समझता — पर जो समझते हैं, वे आपको समझते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszafogott. A humorod azokat jutalmazza, akik figyelnek. Nem mindenki érti – de aki igen, az téged is ért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halus. Humormu baru terasa bagi orang yang benar-benar memperhatikan. Tidak semua orang menangkapnya — tapi yang menangkap, benar-benar memahamimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sottile. Il tuo umorismo premia chi presta attenzione. Non tutti lo colgono, ma chi lo coglie capisce davvero te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控えめなユーモア。ちゃんと聞いている人にだけ伝わります。誰にでも通じるわけではないけれど、わかる人はあなたのことをわかってくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절제된 유머예요. 주의 깊게 듣는 사람만 알아채죠. 모두가 이해하진 못해도, 알아듣는 사람이라면 진짜 모습까지 알아봐 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersahaja. Jenaka anda hanya ditangkap oleh mereka yang betul-betul memberi perhatian. Bukan semua orang faham — tetapi yang faham, memang faham anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underspilt. Humoren din belønner dem som følger med. Ikke alle skjønner den – men de som gjør det, skjønner deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingetogen. Je humor beloont mensen die opletten. Niet iedereen snapt het – maar wie het snapt, snapt jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtelny humor. Nagradza tych, którzy uważnie słuchają. Nie każdy go łapie – ale ci, którzy łapią, łapią też ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sutileza. Seu humor premia quem está prestando atenção. Nem todo mundo entende — mas quem entende, entende você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtilitate. Umorul tău îi răsplătește pe cei atenți. Nu oricine îl prinde — dar cine îl prinde te înțelege cu adevărat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдержанный. Твой юмор открывается тем, кто внимателен. Понимают его не все — но кто понимает, тот понимает и тебя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underfundig. Din humor belönar den som är uppmärksam. Alla fattar den inte – men de som gör det fattar dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขำแบบนิ่งๆ อารมณ์ขันของคุณเป็นรางวัลสำหรับคนที่ตั้งใจฟัง ไม่ใช่ทุกคนจะเก็ต แต่คนที่เก็ตก็คือคนที่เข้าใจคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alttan alta. Mizahın dikkat edenleri ödüllendiriyor. Herkes anlamıyor ama anlayanlar seni de anlıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стриманий. Твій гумор винагороджує уважних. Не всі його розуміють — але ті, хто розуміє, розуміють і тебе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kín đáo. Sự hài hước của bạn dành cho người chịu để ý. Không phải ai cũng hiểu — nhưng ai hiểu được thì sẽ hiểu bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低调含蓄。只有用心听的人才接得住你的幽默。不是每个人都懂，但懂的人，就懂你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低調內斂。你的幽默，只有用心聽的人才接得住。不是每個人都懂，但懂的人，就懂你。"
          }
        }
      }
    },
    "Undivided attention is your standard for quality time. Scrolling while together feels dismissive to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانتباه الكامل هو معياركم للوقت النوعي. تصفّح الهاتف أثناء اللقاء يبدو لكم استخفافًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedělená pozornost je pro tebe měřítkem času spolu. Scrollování při společných chvílích ti připadá jako nezájem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelt opmærksomhed er din standard for kvalitetstid. At scrolle, mens I er sammen, føles afvisende for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungeteilte Aufmerksamkeit ist dein Maßstab für Zeit zu zweit. Scrollen, während ihr zusammen seid, wirkt auf dich abweisend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αμέριστη προσοχή είναι το μέτρο σου για τον ποιοτικό χρόνο. Το σκρολάρισμα όταν είστε μαζί το νιώθεις σαν αδιαφορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ti, el tiempo de calidad exige atención plena. Que alguien se ponga a mirar el teléfono mientras comparten un momento te parece una falta de interés."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakamaton huomio on sinun mittapuusi yhteiselle ajalle. Selaaminen yhdessä ollessa tuntuu sinusta väheksyvältä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buong atensyon ang pamantayan mo sa oras na magkasama. Parang pambabalewala sa’yo ang pag-scroll habang magkasama kayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toi, un vrai moment à deux, c'est une attention totale. Scroller pendant un moment à deux te donne l'impression de passer au second plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשומת לב מלאה היא הסטנדרט שלך לזמן איכות. גלילה בזמן שאתם ביחד מרגישה לך מזלזלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ बिताए वक़्त के लिए पूरा ध्यान आपका पैमाना है। साथ होते हुए स्क्रॉल करना आपको अनदेखी जैसा लगता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked az osztatlan figyelem a minőségi idő mércéje. Ha együttlét közben a másik görget, az lekezelőnek tűnik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatian penuh adalah standarmu untuk waktu berkualitas. Scroll HP saat sedang bersama terasa meremehkan bagimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per te il tempo di qualità significa attenzione piena. Scrollare mentre state insieme ti sembra una mancanza di rispetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に過ごす時間には、相手だけを見ていてほしいタイプです。一緒にいるのにスマホをいじられると、ないがしろにされた気がします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온전한 집중이 함께하는 시간의 기본이에요. 같이 있으면서 화면만 넘기면 무시당하는 기분이 들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatian sepenuhnya ialah standard anda untuk masa berkualiti. Menatal telefon ketika bersama terasa seperti tidak dipedulikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelt oppmerksomhet er standarden din for kvalitetstid. Scrolling når dere er sammen, føles avvisende for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onverdeelde aandacht is jouw maatstaf voor tijd samen. Scrollen terwijl jullie samen zijn, voelt voor jou als afwijzing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niepodzielna uwaga to twój standard wspólnego czasu. Przewijanie ekranu, gdy jesteście razem, odbierasz jako lekceważenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenção total é seu padrão de tempo de qualidade. Ficar rolando a tela quando estão juntos parece descaso para você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenția deplină e standardul tău pentru timpul petrecut împreună. Să stai pe telefon când sunteți împreună ți se pare o lipsă de respect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безраздельное внимание — твой стандарт времени вместе. Листать ленту, когда вы рядом, кажется тебе пренебрежением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odelad uppmärksamhet är din standard för kvalitetstid. Att scrolla när ni är tillsammans känns avfärdande för dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความใส่ใจเต็มร้อยคือมาตรฐานเวลาคุณภาพของคุณ การไถจอตอนอยู่ด้วยกันทำให้คุณรู้สึกถูกมองข้าม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte zaman için ölçütün bölünmemiş ilgi. Birlikteyken ekranda gezinmek sana umursamazlık gibi geliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повна увага — твій стандарт якісного часу разом. Коли поруч гортають стрічку, це здається тобі неповагою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự chú tâm trọn vẹn là tiêu chuẩn của bạn cho thời gian bên nhau. Lướt điện thoại khi ở cạnh nhau khiến bạn thấy bị xem nhẹ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全心全意的关注，是你对陪伴的标准。在一起时还刷手机，会让你觉得被敷衍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專心陪伴是你對相處時光的標準。在一起時還一直滑手機，會讓你覺得被忽略。"
          }
        }
      }
    },
    "Uninhibited. You're comfortable being ridiculous — and that ease is actually quite intimate. Hard to be silly with someone you're guarded around." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا قيود. لا تخجلون من أن تبدوا مضحكين، وهذه الأريحية حميمة في الحقيقة، فمن الصعب أن نمزح بعفوية مع من نتحفّظ أمامه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zábran. Nebojíš se působit směšně – a ta lehkost je vlastně hodně intimní. S někým, před kým se hlídáš, se blbnout nedá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhæmmet. Du har det fint med at være fjollet – og den lethed er faktisk ret intim. Det er svært at være fjollet med nogen, man holder på afstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungehemmt. Du hast kein Problem damit, dich lächerlich zu machen – und diese Leichtigkeit ist richtig intim. Mit jemandem, bei dem man auf der Hut ist, albert man nicht herum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς αναστολές. Δεν σε πειράζει να γελοιοποιείσαι — και αυτή η άνεση είναι στην ουσία πολύ οικεία. Δεν κάνεις εύκολα χαζομάρες μπροστά σε κάποιον όταν κρατάς άμυνες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin filtros. No te importa hacer el ridículo, y esa soltura es en realidad muy íntima. Cuesta hacer tonterías con alguien ante quien te proteges."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoton. Kehtaat olla naurettava – ja se huolettomuus on itse asiassa aika intiimiä. On vaikea hassutella sellaisen kanssa, jonka seurassa on varuillaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang inhibisyon. Komportable kang magmukhang katawa-tawa — at ang ganoong gaan ay talagang intimate. Mahirap magpakakulit kasama ang taong may pader ka pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans complexe. Tu n'as pas peur du ridicule, et cette aisance est en fait très intime. Difficile de faire l'idiot avec quelqu'un face à qui on reste sur ses gardes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי עכבות. נוח לך להשתטות — והקלילות הזאת היא בעצם אינטימית מאוד. קשה להשתטות ליד מישהו כשנמצאים מולו במגננה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेझिझक। आपको बेतुका दिखने से परहेज़ नहीं — और यह सहजता असल में बहुत अपनापन भरी है। जिसके सामने आप सतर्क हों, उसके साथ बेवकूफ़ियाँ करना मुश्किल है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felszabadult. Nem zavar, ha nevetségesnek tűnsz – és ez a könnyedség valójában nagyon bensőséges. Nehéz bolondozni valakivel, akivel szemben védekezel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepas. Kamu nyaman terlihat konyol — dan keluwesan itu sebenarnya sangat intim. Sulit bertingkah konyol di depan orang yang membuatmu menjaga sikap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza freni. Non hai paura del ridicolo, e questa naturalezza è molto intima. È difficile fare gli scemi con chi ci mette sulla difensiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飾らない人。ばかばかしい自分を見せられるその気楽さは、実はとても親密なもの。気を張っている相手の前では、なかなかふざけられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거리낌이 없어요. 우스꽝스러워지는 걸 겁내지 않고, 그 편안함이 오히려 친밀함이 되죠. 경계하는 사람 앞에선 엉뚱해지기 어려우니까요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa segan silu. Anda selesa berperangai lucu — dan keselesaan itu sebenarnya sangat intim. Sukar untuk berlucu di depan seseorang jika anda masih menjaga diri dengannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhemmet. Du tør å være latterlig – og den tryggheten er faktisk ganske intim. Det er vanskelig å fjase med noen man har garden oppe overfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeremd. Je durft gek te doen – en die ontspannenheid is eigenlijk heel intiem. Bij iemand bij wie je op je hoede bent, ben je niet zo snel melig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zahamowań. Nie boisz się śmieszności – a ta swoboda jest naprawdę intymna. Trudno wygłupiać się przy kimś, przy kim się pilnujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem filtro. Você não tem medo de pagar mico — e essa leveza é, na verdade, bem íntima. É difícil fazer palhaçada perto de quem deixa a gente na defensiva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără inhibiții. Nu te deranjează să faci pe caraghiosul — și lejeritatea asta e de fapt foarte intimă. E greu să faci prostii cu cineva în fața căruia stai în gardă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без стеснения. Тебе не страшно выглядеть нелепо, и в этой лёгкости много близости. Трудно дурачиться с тем, перед кем держишь оборону."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohämmad. Du vågar vara löjlig – och den lättheten är faktiskt ganska intim. Det är svårt att vara fånig med någon man håller garden uppe inför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปล่อยตัวสุดๆ คุณสบายใจที่จะดูตลก และความสบายใจแบบนั้นสะท้อนความใกล้ชิดจริงๆ เพราะเราไม่มีทางบ้าบอได้กับคนที่เรายังระวังตัวอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çekincesiz. Gülünç olmaktan rahatsız değilsin ve bu rahatlık aslında çok samimi. Kendini koruduğun biriyle saçmalamak zordur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без гальм. Тобі не страшно виглядати смішно — і в цій легкості чимало близькості. Важко дуріти з тим, з ким ти насторожі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoải mái hết mình. Bạn không ngại trông ngớ ngẩn — và sự tự nhiên đó thật ra rất thân mật. Khó mà ngớ ngẩn được với người mình còn dè chừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放得开。你不怕出糗，而这种自在其实很亲密。毕竟在有戒心的人面前，很难耍宝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毫無包袱。你不怕看起來很蠢，而這份自在其實很親密。對著有防備的人，是很難耍寶的。"
          }
        }
      }
    },
    "Unpredictability was part of your experience. You may have complicated feelings about celebrations as a result." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدم القدرة على التوقع كان جزءًا من تجربتكم، وقد تحملون لذلك مشاعر متشابكة تجاه المناسبات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepředvídatelnost byla součástí tvého dětství. Možná proto máš k oslavám smíšené pocity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uforudsigelighed var en del af din opvækst. Derfor har du måske blandede følelser omkring fester og højtider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unberechenbarkeit gehörte für dich dazu. Vielleicht hast du deshalb gemischte Gefühle, was Feste angeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το απρόβλεπτο ήταν μέρος της εμπειρίας σου. Γι' αυτό ίσως έχεις ανάμεικτα συναισθήματα για τις γιορτές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo impredecible formaba parte de tu experiencia. Puede que por eso tengas sentimientos encontrados con las celebraciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvaamattomuus kuului kokemukseesi. Siksi tunteesi juhlia kohtaan voivat olla ristiriitaisia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahagi ng karanasan mo ang hindi inaasahan. Baka may halo-halo kang damdamin tungkol sa mga selebrasyon dahil dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'imprévisibilité faisait partie de ton enfance. Tu as peut-être des sentiments mêlés envers les fêtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוסר הצפיות היה חלק מהחוויה שלך. אולי בגלל זה יש לך רגשות מורכבים כלפי חגיגות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनिश्चितता आपके अनुभव का हिस्सा थी। इस वजह से जश्न को लेकर आपकी भावनाएँ थोड़ी उलझी हुई हो सकती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszámíthatatlanság a tapasztalatod része volt. Emiatt lehet, hogy vegyes érzéseid vannak az ünnepekkel kapcsolatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketidakpastian jadi bagian dari pengalamanmu. Karena itu, perasaanmu soal perayaan mungkin rumit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’imprevedibilità faceva parte della tua esperienza. Per questo potresti avere sentimenti contrastanti verso le feste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予測できないことが当たり前だった経験。そのぶん、お祝いごとに複雑な気持ちを抱いているかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예측할 수 없는 게 경험의 일부였어요. 그래서 기념일에 대해 복잡한 감정이 있을 수도 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketidaktentuan menjadi sebahagian pengalaman anda. Oleh itu, anda mungkin ada perasaan bercampur-baur tentang sambutan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uforutsigbarhet var en del av oppveksten din. Kanskje har du blandede følelser rundt feiringer på grunn av det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onvoorspelbaarheid hoorde bij jouw ervaring. Daardoor heb je misschien gemengde gevoelens bij feestdagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprzewidywalność była częścią twojego doświadczenia. Przez to możesz mieć do świąt mieszane uczucia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imprevisibilidade fez parte da sua história. Talvez por isso você tenha sentimentos complicados sobre comemorações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprevizibilul a făcut parte din experiența ta. Poate de aceea ai sentimente amestecate față de sărbători."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непредсказуемость была частью твоего опыта. Поэтому у тебя могут быть непростые чувства к праздникам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oförutsägbarhet var en del av din uppväxt. Därför kan du ha blandade känslor inför högtider."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความไม่แน่นอนเป็นส่วนหนึ่งของประสบการณ์คุณ จึงอาจมีความรู้สึกซับซ้อนกับการฉลอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirsizlik deneyiminin bir parçasıydı. Bu yüzden kutlamalara karşı karmaşık duyguların olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непередбачуваність була частиною твого досвіду. Тож свята можуть викликати в тебе змішані почуття."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự khó đoán là một phần trải nghiệm của bạn. Vì thế, có thể bạn có những cảm xúc phức tạp về các dịp lễ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不确定是你成长经历的一部分。因此，你对庆祝可能抱有复杂的感受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不確定性是你成長經驗的一部分，所以你對慶祝這件事，可能有些複雜的感受。"
          }
        }
      }
    },
    "Vague praise rebounds. Concrete lands." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المديح المبهم يرتد، والمحدد يصل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecná chvála se odrazí. Konkrétní zasáhne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vag ros preller af. Konkret ros rammer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vages Lob prallt ab. Konkretes kommt an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο αόριστος έπαινος γλιστράει. Ο συγκεκριμένος πιάνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elogio vago rebota. El concreto llega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylimalkainen kehu kimpoaa pois. Konkreettinen menee perille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumatalbog ang malabong papuri. Tumatama ang tiyak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compliment vague glisse. Un compliment concret touche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחמאה כללית מחליקה. מחמאה מוחשית נוחתת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गोलमोल तारीफ़ असर नहीं करती। ठोस तारीफ़ दिल तक पहुँचती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az általános dicséret lepattan. A konkrét célba ér."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pujian samar mudah terpental. Pujian konkret mengena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I complimenti vaghi scivolano via. Quelli concreti arrivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あいまいなほめ言葉は流されがち。具体的な言葉は心に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "막연한 칭찬은 튕겨 나가고, 구체적인 칭찬은 마음에 닿아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pujian samar mudah dilupakan. Pujian khusus lebih mengena."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vag ros preller av. Konkret ros treffer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vaag compliment ketst af. Een concreet compliment komt aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogólne pochwały się odbijają. Konkret trafia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elogio vago escorrega. O concreto toca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laudele vagi ricoșează. Cele concrete ajung la inimă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общие похвалы отскакивают. Конкретные — попадают в цель."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagt beröm studsar tillbaka. Konkret landar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำชมกว้างๆ มักเด้งกลับ คำชมที่ชัดเจนจะไปถึงใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirsiz övgü sekip gider. Somut olan yerine ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмита похвала відскакує. Конкретна — влучає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời khen chung chung dễ trôi qua. Lời khen cụ thể mới chạm tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空泛的夸奖容易被一笑带过，具体的才能打动人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空泛的稱讚容易彈回來，具體的才說得進心裡。"
          }
        }
      }
    },
    "Validation first, solutions (maybe) later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التفهّم أولًا، والحلول (ربما) لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív pochopení, řešení (možná) později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anerkendelse først, løsninger (måske) senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Verständnis, Lösungen (vielleicht) später."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρώτα η κατανόηση, οι λύσεις (ίσως) μετά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero validar; las soluciones, quizá, después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensin ymmärrys, ratkaisut (ehkä) myöhemmin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unawain muna, solusyon (siguro) mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'abord valider ce que l'autre ressent, les solutions (peut-être) après."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודם תיקוף, פתרונות (אולי) אחר כך."
