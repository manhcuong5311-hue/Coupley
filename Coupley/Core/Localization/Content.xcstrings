    "Joy is contagious; reflect it back and it doubles." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفرح معدٍ؛ اعكسوه يتضاعف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radost je nakažlivá; když ji oplatíš, zdvojnásobí se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glæde smitter. Spejl den, og den bliver dobbelt så stor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freude steckt an – spiegelst du sie, verdoppelt sie sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χαρά είναι μεταδοτική· γύρνα την πίσω και διπλασιάζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alegría es contagiosa: devuélvela y se duplica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilo tarttuu – heijasta sitä takaisin, niin se kaksinkertaistuu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakahawa ang saya; ibalik mo ito at dodoble."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La joie est contagieuse : renvoie-la et elle double."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמחה מדבקת; כשמחזירים אותה, היא מוכפלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ुशी फैलती है; उसे लौटाएँ तो दोगुनी हो जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az öröm ragályos; ha visszatükrözöd, megduplázódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebahagiaan itu menular; pantulkan kembali dan ia jadi berlipat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gioia è contagiosa: se la ricambi, raddoppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うれしさは伝染します。返してあげると、喜びは2倍に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기쁨은 전염돼요. 함께 나누면 두 배가 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kegembiraan itu berjangkit; balas semula dan ia berganda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glede smitter; speil den, så dobles den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vreugde is besmettelijk: kaats het terug en het verdubbelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radość jest zaraźliwa – odwzajemnij ją, a się podwoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegria é contagiante; devolva e ela dobra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucuria e contagioasă; dacă o reflectezi înapoi, se dublează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радость заразительна: отрази её — и её станет вдвое больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glädje smittar; spegla den så fördubblas den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
