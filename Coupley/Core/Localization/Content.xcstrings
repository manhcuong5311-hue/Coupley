        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att passa ihop som resesällskap kan göra eller förstöra en semester – värt att veta tidigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเที่ยวเข้าขากันหรือไม่อาจชี้ชะตาวันหยุดได้เลย เรื่องนี้ควรรู้ไว้แต่เนิ่นๆ"
