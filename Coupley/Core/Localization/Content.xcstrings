    "Structured but not overwhelming. You like intentional moments without it feeling like therapy every week." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestruktureerd, maar nie oorweldigend nie. Jy hou van doelbewuste oomblikke sonder dat dit elke week soos terapie voel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተደራጀ ግን የማያጨናንቅ። በየሳምንቱ የምክር ክፍለ ጊዜ የመሰለ ስሜት ሳይኖር ሆን ተብለው የሚዘጋጁ ጊዜያትን ይወዳሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظيم دون إرهاق. تحبون اللحظات المقصودة دون أن تشعروا بأنها جلسة علاج كل أسبوع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সুগঠিত, কিন্তু বোজা নহয়। প্ৰতি সপ্তাহে থেৰাপী যেন নালাগাকৈ আপুনি উদ্দেশ্যপূৰ্ণ মুহূৰ্ত ভাল পায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlı, amma yorucu olmayan. Hər həftə terapiya kimi hiss olunmayan, düşünülmüş anları sevirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Структура без перагрузкі. Табе падабаюцца свядомыя моманты, але без адчування штотыднёвай тэрапіі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Структурирано, но не прекалено. Харесваш съзнателните моменти, без да е като терапия всяка седмица."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গোছানো, কিন্তু চাপের নয়। তুমি সচেতন মুহূর্ত চাও, তবে প্রতি সপ্তাহে থেরাপির মতো মনে না হোক।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturirano, ali ne previše. Voliš svjesne trenutke, a da to ne liči na terapiju svake sedmice."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb estructura però sense atabalar. T'agraden els moments intencionats sense que sembli teràpia cada setmana."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řád, ale ne přehnaný. Stojíš o vědomé chvíle, aniž by to každý týden působilo jako terapie."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strwythur, ond dim gormod. Rwyt ti'n hoffi eiliadau bwriadol heb iddo deimlo fel therapi bob wythnos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktur, men ikke for meget. Du kan lide bevidste øjeblikke, uden at det føles som terapi hver uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturiert, aber nicht zu viel. Du magst bewusste Momente, ohne dass es sich jede Woche wie Therapie anfühlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με δομή αλλά χωρίς υπερβολές. Σου αρέσουν οι συνειδητές στιγμές, χωρίς να μοιάζει με θεραπεία κάθε εβδομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con estructura, pero sin agobiar. Te gusta reservar momentos para ello sin que parezca terapia cada semana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktuurne, aga mitte üle jõu käiv. Sulle meeldivad teadlikud hetked, ilma et see tunduks iganädalase teraapiana."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egituratua, baina ez astuna. Une kontzienteak gustatzen zaizkizu, astero terapian zaudela sentitu gabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منظم ولی نه طاقت‌فرسا. لحظه‌های آگاهانه را دوست داری، بی‌آنکه حس کنی هر هفته جلسهٔ مشاوره دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmällistä muttei uuvuttavaa. Pidät tarkoituksellisista hetkistä ilman, että joka viikko tuntuu terapialta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May istruktura pero hindi nakakapagod. Gusto mo ng sinadyang sandali nang hindi parang therapy linggo-linggo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structuré sans être pesant. Tu aimes les moments choisis, sans avoir l'impression d'une séance de thérapie chaque semaine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struchtúrtha ach gan a bheith róthrom. Is maith leat nóiméid d'aon ghnó gan go mbraithfeadh sé cosúil le teiripe gach seachtain."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con estrutura pero sen abafar. Gústanche os momentos intencionados sen que pareza terapia cada semana."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વ્યવસ્થિત, પણ ભારે નહીં. તમને ઇરાદાપૂર્વકની ક્ષણો ગમે છે, પણ દર અઠવાડિયે થેરાપી જેવું ન લાગવું જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akwai tsari amma ba mai nauyi ba. Kuna son lokuta na niyya ba tare da ya zama kamar zaman jinya kowane mako ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסודר אבל לא מכביד. רגעים מכוונים מתאימים לך, בלי שזה ירגיש כמו טיפול זוגי כל שבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय ढंग से, पर बोझ बने बिना। आपको सोचे-समझे पल पसंद हैं, लेकिन ऐसा नहीं कि हर हफ़्ते थेरेपी जैसा लगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturirano, ali ne prenaporno. Voliš namjerne trenutke, ali da to ne bude terapija svaki tjedan."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Òganize men pa twòp. Ou renmen moman ki fèt ak entansyon san sa pa sanble yon terapi chak semèn."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van rendje, de nem megterhelő. Szereted a tudatos pillanatokat, de nem akarod, hogy minden hét terápiának tűnjön."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կանոնավոր, բայց ոչ ծանրաբեռնող։ Սիրում ես գիտակցված պահեր՝ առանց զգացողության, թե ամեն շաբաթ թերապիայի ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terstruktur tapi nggak berlebihan. Kamu suka momen yang disengaja tanpa terasa seperti sesi terapi tiap minggu."
