        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eletyn näköinen on mukava – pidän kodikkaasta"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komportable ang medyo magulo — mas gusto ko ang homey"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un intérieur qui vit, c'est plus chaleureux"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is compordach an teach a bhfuil cónaí ann — is maith liom teolaí é"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vivido é cómodo: gústame acolledor"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રહેવા જેવું ઘર આરામદાયક — ઘરેલુ માહોલ ગમે"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gidan da ake zaune a ciki na da daɗi — ina son jin gida"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בית שחיים בו — נעים וביתי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा बिखरा भी चलता है — घर जैसा लगे"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volim kad se vidi da se tu živi – toplo i domaće"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon ti dezòd konfòtab — m renmen yon kay ki viv"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kicsit szanaszét – így otthonos"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի քիչ խառը տունը հարմարավետ է — սիրում եմ տնային մթնոլորտ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedikit berantakan itu nyaman — homey"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ụlọ e bi n'ime ya dị mma — ọ na-amasị m ka ọ dị ka ụlọ"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heimilislegt er notalegt – það má sjást að hér er búið"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un po’ di vissuto è accogliente — mi piace una casa calda"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活感があるほうが落ち着く"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rada awut-awutan malah kepenak — aku seneng sing krasan"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ცოცხალი სახლი მყუდროა — მიყვარს, როცა შინაურულია"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тұрмыстың ізі жайлы — үй үй сияқты болсын"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រញ៉េរញ៉ៃបន្តិចក៏ស្រួល — ខ្ញុំចូលចិត្តផ្ទះមានបរិយាកាសរស់នៅ"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಳಕೆಯ ಮನೆಯೇ ಆರಾಮ — ಮನೆಯಂತಿರಲಿ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적당히 생활감 있는 게 편해요"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maleke jiyayî rehet e — germahiya malê dixwazim"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жашалган үй ыңгайлуу — үйдөгүдөй жылуу болсо дейм"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewunnt ass gemittlech — ech hunn et heemlech"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຮືອນທີ່ມີຮ່ອງຮອຍການຢູ່ອາໄສສະບາຍກວ່າ — ຂ້ອຍມັກແບບອົບອຸ່ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyvenama erdvė jauki – man patinka naminė atmosfera"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazliet nekārtības ir omulīgi – man patīk mājīgums"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahafinaritra ny trano iainana — tiako ny mafana fo"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pai te whare e noho ana — he pai ki ahau kia rite ki te kāinga"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малку неред е удобно — сакам да е домашно"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ജീവനുള്ള വീടാണ് സുഖം — വീടുപോലെ തോന്നണം"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амьдралтай гэр эвтэйхэн — гэр шиг байх дуртай"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राहते घर आरामदायी — घरगुती वाटलेले आवडते"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedikit bersepah pun selesa — lebih terasa macam rumah"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ftit diżordni hija komda — inħobb dar li tinħass dar"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေထိုင်ထားတဲ့ပုံ ပေါ်တာ သက်တောင့်သက်သာ ရှိတယ် — အိမ်လိုလို နွေးထွေးတာ ကြိုက်တယ်"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litt rot er greit – jeg liker det hjemmekoselig"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलि घरेलु अस्तव्यस्त नै सहज — घरजस्तो लाग्छ"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een beetje geleefd is gezellig – ik hou van huiselijk"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyumba yokhalamo ndi yomasuka — ndimakonda ikhale ngati kwathu"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mana keessa jiraatamaa — akka manaa natti tola"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଟିକେ ଅଗୋଛାଳ ଆରାମଦାୟକ — ଘରୋଇ ଲାଗେ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਸਦਾ-ਰੱਸਦਾ ਘਰ ਸੁਖਾਵਾਂ ਹੈ — ਮੈਨੂੰ ਘਰੇਲੂ ਮਾਹੌਲ ਪਸੰਦ ਹੈ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekki nieład jest przytulny – lubię swojsko"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کورنی حالت آرام دی — خوښوم چې کور کور ښکاري"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa com cara de vivida é aconchegante"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa vivida é confortável — gosto de aconchego"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îmi place o casă locuită, cu suflet"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжитой уют — мне так комфортно"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inzu ibamo abantu irisanzuye — nkunda ko imeze nk'urugo"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ජීවත් වෙන ගෙයක් වගේ තියෙන එක හොඳයි — ගෙදර හැඟීමට කැමතියි"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útulný neporiadok je pohodlný – nech je to domácke"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malo živo je udobno – všeč mi je domačnost"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imba inogarwa inonakidza — ndinoda kuti inzwike semusha"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guri la deggan yahay ayaa raaxo leh — waxaan jeclahay inuu guri u ekaado"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak rrëmujë është rehati – e dua shtëpinë të ngrohtë"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мало нереда је пријатно — волим кад је ушушкано"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rada awut-awutan mah raoseun — abdi resep anu karaos imah"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite stök är mysigt – jag gillar det hemtrevligt"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyumba yenye maisha ina raha — napenda iwe ya kawaida"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வாழும் வீடு போல இருந்தால்தான் இதம் — வீட்டுச் சூழல் பிடிக்கும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కాస్త వాడినట్టే హాయి — ఇల్లు ఇల్లులా ఉండాలి"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хонаи зиндагидор бароҳат аст — гармиро дӯст медорам"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รกนิดๆ ก็สบายดี ชอบแบบอบอุ่นเป็นบ้าน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝንበረሉ ገዛ ምቹእ እዩ — ሙቐት ዘለዎ እፈቱ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýaşalýan öý rahat — öý ýaly bolsun"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz dağınıklık rahattır, ev sıcak olsun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затишний безлад — мені так по-домашньому"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رہا بسا گھر آرام دہ ہے — گھریلو پن پسند ہے"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biroz betartiblik qulay — uy uydek boʻlsin"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hơi bừa mới thoải mái — mình thích ấm cúng"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikhaya elisetyenziswayo liyakhululeka — ndithanda livakala njengekhaya"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilé tí a ń gbé ló rọ̀ni — mo fẹ́ kí ó rí bí ilé"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有生活感才舒服，我喜歡有家的感覺"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有生活气才舒服"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有生活感才舒服，像個家"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikhaya elihlalwayo liyakhululeka — ngithanda kube nomuzwa wasekhaya"
          }
        }
      }
