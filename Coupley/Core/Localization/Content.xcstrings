    "Ambient and calming. You're not trying to perform — you just want a pleasant backdrop." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجواء هادئة ومريحة. لا تسعون إلى الاستعراض، بل تريدون خلفية لطيفة فحسب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambient a klid. Nejde ti o show – chceš jen příjemnou kulisu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemningsfuldt og beroligende. Du prøver ikke at optræde – du vil bare have en behagelig lydkulisse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhig und sanft. Du willst nicht performen – nur eine angenehme Kulisse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ατμοσφαιρικό και ήρεμο. Δεν θέλεις να κάνεις σόου — θέλεις απλώς ένα ευχάριστο φόντο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambiental y relajante. No buscas lucirte: solo quieres un fondo agradable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelmallista ja rauhoittavaa. Et yritä esittää – haluat vain miellyttävän taustan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banayad at nakakakalma. Hindi ka nagpe-perform — gusto mo lang ng masarap na background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ambiance douce et apaisante. Pas besoin de te donner en spectacle : tu veux juste un fond agréable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אווירה רגועה ומרגיעה. אין לך צורך להופיע — רק רקע נעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शांत और सुकून भरा। आपको कोई दिखावा नहीं करना — बस एक सुहाना माहौल चाहिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Könnyed és megnyugtató. Nem akarsz produkálni – csak egy kellemes háttér kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenang dan menenangkan. Kamu nggak sedang tampil — kamu cuma ingin latar suara yang menyenangkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosfera e calma. Non cerchi lo spettacolo — vuoi solo un sottofondo piacevole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかで心地よい音が好きなタイプです。盛り上がりたいのではなく、ただ心地よい背景がほしいのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분하고 편안하게. 누구에게 보여 주려는 게 아니라, 그저 기분 좋은 배경이 있으면 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenang dan mendamaikan. Anda bukan mahu beraksi — anda cuma mahukan latar yang menyenangkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemningsfullt og beroligende. Du skal ikke opptre – du vil bare ha et behagelig bakteppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfeervol en kalmerend. Je hoeft geen show te geven – je wilt gewoon een fijne achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastrojowo i kojąco. Nie robisz koncertu – chcesz po prostu przyjemnego tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som ambiente, clima calmo. Você não quer show — só um fundo agradável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva ambiental și liniștitor. Nu vrei să dai un spectacol — vrei doar un fundal plăcut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягко и умиротворяюще. Тебе не нужно шоу — просто приятный фон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämningsfullt och lugnande. Du vill inte uppträda – du vill bara ha en behaglig ljudkuliss."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังสบายและผ่อนคลาย คุณไม่ได้อยากโชว์อะไร แค่อยากได้บรรยากาศดีๆ เป็นฉากหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
