        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những món khiến bạn thấy như ở nhà — không phán xét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那些让你有家的感觉的食物——不评判。"
