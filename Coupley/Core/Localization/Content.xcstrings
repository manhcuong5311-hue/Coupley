        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現実的で順応性があるタイプです。どんなお金の価値観の人ともうまくやれる、それは強みです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan praktis lan gampang nyetel. Panjenengan bisa cocog karo meh kabeh watak bab dhuwit, lan kuwi kekuwatan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პრაგმატული და მოქნილი ხარ. ფულისადმი თითქმის ნებისმიერ მიდგომას ეწყობი, და ეს ძალაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен прагматик әрі бейімделгішсің. Ақшаға әр түрлі қарайтын адамдардың көбімен тіл табыса аласың — бұл күшті қасиет."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកជាមនុស្សជាក់ស្ដែង និងចេះសម្របខ្លួន។ អ្នកអាចសហការជាមួយមនុស្សដែលមានទម្លាប់ចាយលុយភាគច្រើនបាន ដែលជាចំណុចខ្លាំងមួយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಪ್ರಾಯೋಗಿಕ ಮತ್ತು ಹೊಂದಿಕೊಳ್ಳುವವರು. ಹಣದ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚಿನ ಸ್ವಭಾವದವರ ಜೊತೆ ನೀವು ಹೊಂದಿಕೊಳ್ಳಬಲ್ಲಿರಿ, ಅದು ಒಂದು ಶಕ್ತಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현실적이고 융통성 있는 타입이에요. 어떤 소비 성향과도 잘 맞출 수 있다는 게 장점이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pragmatîk û nerm î. Tu dikarî bi piraniya kesayetiyên pereyan re li hev bikî, ev hêzek e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен практикалуу жана ыңгайлашкычсың. Акчага ар кандай мамиледеги адамдар менен иштеше аласың — бул күч."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bass pragmatesch an upassungsfäeg. Du kënns mat de meeschte Geldtypen eens, an dat ass eng Stäerkt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເປັນຄົນມີເຫດຜົນ ແລະ ປັບຕົວເກັ່ງ ເຈົ້າເຂົ້າກັບຄົນທີ່ມີນິໄສການເງິນແບບຕ່າງໆໄດ້ເກືອບທຸກແບບ ເຊິ່ງເປັນຈຸດແຂງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau būdingas praktiškumas ir lankstumas. Gali sutarti su daugeliu skirtingų požiūrių į pinigus – tai stiprybė."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev ir praktiska un elastīga pieeja. Tu vari sastrādāties ar gandrīz jebkuru naudas tipu, un tā ir stiprā puse."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahay mampihatra sy mahay mifanaraka ianao. Afaka miara-miasa amin'ny ankamaroan'ny toetra eo amin'ny vola ianao, ary tanjaka izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tōtika, he urutau hoki koe. Ka taea e koe te mahi tahi me te nuinga o ngā momo whakaaro moni — he kaha tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практичен пристап и прилагодливост. Можеш да се сложиш со повеќето пристапи кон парите, а тоа е сила."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ പ്രായോഗികബുദ്ധിയും വഴക്കവുമുള്ളവരാണ്. പണത്തോട് മിക്ക സമീപനങ്ങളുമുള്ളവരുമായി നിങ്ങൾക്ക് ഒത്തുപോകാനാകും — അതൊരു കരുത്താണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи бодитой, дасан зохицох чадвартай. Ихэнх мөнгөний зан чанартай хүмүүстэй эвтэй байж чадна, энэ бол давуу тал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही व्यवहारी आणि जुळवून घेणारे आहात. पैशांबाबत बहुतेक स्वभावांशी तुमचे जमू शकते, ही तुमची ताकद आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda praktikal dan mudah menyesuaikan diri. Anda boleh serasi dengan kebanyakan jenis personaliti kewangan, dan itu satu kekuatan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għandek sens prattiku u tadatta ruħek. Tista' taħdem ma' ħafna personalitajiet differenti fil-flus, u din hija saħħa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် လက်တွေ့ကျပြီး လိုက်လျောညီထွေ ရှိတယ်။ ငွေကြေးအမြင် အမျိုးမျိုးနဲ့ တွဲလုပ်နိုင်တာက အားသာချက်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er pragmatisk og tilpasningsdyktig. Du kan samarbeide med de fleste pengetyper, og det er en styrke."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं व्यावहारिक र अनुकूल हुनुहुन्छ। पैसाबारे धेरैजसो स्वभावका मान्छेसँग तपाईं मिलेर चल्न सक्नुहुन्छ, जुन ठूलो शक्ति हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bent pragmatisch en flexibel. Je kunt met de meeste geldtypes overweg, en dat is een kracht."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndinu ozindikira ndipo mumasinthasintha. Mutha kugwirizana ndi anthu ambiri a makhalidwe osiyana pa ndalama, ndipo imeneyo ndi mphamvu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qabatamaa fi kan haala wajjin walsimu dha. Amala maallaqaa baay'ee wajjin hojjechuu dandeessa, kunis cimina dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ବ୍ୟବହାରିକ ଓ ଖାପଖୁଆଇ ଚଳନ୍ତି। ଟଙ୍କା ନେଇ ପ୍ରାୟ ସବୁ ପ୍ରକାର ସ୍ୱଭାବ ସହ ଆପଣ ଚଳିପାରନ୍ତି, ଏହା ଏକ ଶକ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਵਿਹਾਰਕ ਹੋ ਅਤੇ ਹਾਲਾਤ ਮੁਤਾਬਕ ਢਲ ਜਾਂਦੇ ਹੋ। ਪੈਸੇ ਬਾਰੇ ਲਗਭਗ ਹਰ ਤਰ੍ਹਾਂ ਦੇ ਸੁਭਾਅ ਨਾਲ ਤੁਸੀਂ ਨਿਭਾ ਸਕਦੇ ਹੋ, ਜੋ ਇੱਕ ਤਾਕਤ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz praktyczne i elastyczne podejście. Dogadasz się z większością finansowych osobowości, a to duży atut."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو عملي او د برابرېدو وړ یاست. له ډېرو مالي شخصیتونو سره کار کولی شئ، چې دا یو ځواک دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu jeito é prático e adaptável. Você consegue lidar com quase todo perfil financeiro, e isso é uma força."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens pragmatismo e capacidade de adaptação. Consegues entender-te com a maioria das personalidades financeiras, o que é uma força."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai simț practic și te adaptezi ușor. Te poți înțelege cu majoritatea stilurilor de a gestiona banii, iar asta e un atu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тебе есть практичность и гибкость. Ты уживёшься почти с любым отношением к деньгам, и это сильная сторона."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufata ibintu uko biri kandi wihuza n'ibihe. Ushobora gukorana n'abantu benshi bafite imyumvire itandukanye ku mafaranga, kandi izo ni imbaraga."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ප්‍රායෝගිකයි, හැඩගැසෙන්න පුළුවන්. බොහෝ මුදල් පෞරුෂ එක්ක ඔබට වැඩ කරන්න පුළුවන්, ඒක ශක්තියක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si praktický typ a vieš sa prispôsobiť. Zvládneš to s väčšinou finančných povah, a to je sila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktičen pristop in prilagodljivost. Z večino denarnih osebnosti se lahko uskladiš, kar je prednost."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une njere uye unochinjika. Unokwanisa kushanda nemaitiro akawanda emari, uye iro isimba."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad tahay qof wax ku ool ah oo la qabsada. Waxaad la shaqayn kartaa inta badan dabeecadaha lacagta, taasina waa xoog."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qasja jote është praktike dhe e përshtatshme. Mund të shkosh mirë me shumicën e personaliteteve financiare, dhe kjo është një forcë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прагматичност и прилагодљивост су ти јача страна. Можеш да се снађеш уз већину финансијских типова, а то је предност."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun praktis sareng gampil nyaluyukeun. Anjeun tiasa cocog sareng seueur kapribadian kauangan, sareng éta téh kakuatan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är pragmatisk och anpassningsbar. Du kan funka med de flesta pengapersonligheter, och det är en styrka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wewe ni mtu wa vitendo na unayebadilika. Unaweza kuendana na tabia nyingi za kifedha, na hiyo ni nguvu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் நடைமுறையானவர், எதற்கும் பொருந்திக்கொள்பவர். பெரும்பாலான பணப் பழக்கங்கள் உள்ளவர்களுடனும் உங்களால் இணைந்து செயல்பட முடியும், அது ஒரு பலம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఆచరణాత్మకంగా, సర్దుకుపోయేలా ఉంటారు. డబ్బు విషయంలో చాలా రకాల మనుషులతో కలిసి నడవగలరు, అది ఒక బలం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту амалгаро ва мутобиқшаванда ҳастӣ. Ту бо аксари феълу хӯйҳои пулӣ кор карда метавонӣ ва ин қуввати туст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมีเหตุผลและปรับตัวเก่ง เข้ากับคนที่มีนิสัยการเงินแบบต่างๆ ได้เกือบทั้งหมด ซึ่งเป็นจุดแข็ง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተግባራውያንን ተላመድትን ኢኹም። ምስ መብዛሕትኦም ዓይነታት ኣተሓሕዛ ገንዘብ ክትሰርሑ ትኽእሉ፣ እዚ ድማ ሓይሊ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen amaly we uýgunlaşýan. Pula garaýşy dürli adamlaryň köpüsi bilen ylalaşyp bilýärsiň — bu güýç."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratik ve uyumlusun. Çoğu para kişiliğiyle anlaşabiliyorsun; bu bir güç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти поєднуєш прагматизм і гнучкість. З більшістю грошових характерів тобі вдасться домовитися, і це сила."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ میں عملی سوچ بھی ہے اور لچک بھی۔ پیسوں کے معاملے میں زیادہ تر مزاجوں سے آپ کی بن جاتی ہے، اور یہ ایک خوبی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz amaliy va moslashuvchansiz. Pulga turlicha qaraydigan aksariyat odamlar bilan til topisha olasiz — bu kuchli tomoningiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thực tế và dễ thích nghi. Bạn hợp với hầu hết kiểu người khi nói chuyện tiền bạc — đó là một điểm mạnh."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usebenzisa ingqiqo kwaye uyaziqhelanisa. Ungasebenzisana neentlobo ezininzi zabantu malunga nemali, yaye loo nto ingamandla."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ní ọgbọ́n ìlò, ẹ sì lè yí padà bí ó ṣe yẹ. Ẹ lè bá ọ̀pọ̀ ìwà owó ṣiṣẹ́, agbára sì nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你務實又懂得變通，能和大部分理財性格的人相處，這是你的優勢。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你务实又灵活。你能和大多数金钱观合得来，这是一种优势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你務實又懂得變通，能和大多數理財個性相處，這是你的優勢。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usebenza ngokwenzeka futhi uyazivumelanisa. Ungasebenzisana nezinhlobo eziningi zabantu ngokwemali, futhi lawo ngamandla."
          }
        }
      }
    },
    "You're proactive about the relationship. Regular check-ins keep you connected and prevent things from festering." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy’s proaktief oor die verhouding. Gereelde gesprekke hou julle verbind en keer dat dinge sweer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለግንኙነቱ ቀድመው ይንቀሳቀሳሉ። በየጊዜው መጠያየቅ እንድትገናኙ ያደርጋል፣ ነገሮችም እንዳይመረቅዙ ይከላከላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبادرون في رعاية علاقتكم. الأحاديث المنتظمة تُبقيكم قريبين وتمنع تراكم الأمور."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি সম্পৰ্কৰ প্ৰতি সক্ৰিয়। নিয়মীয়া খবৰ-খাতিৰে আপোনালোকক সংযুক্ত কৰি ৰাখে আৰু কথাবোৰ মনত পুতি থাকিবলৈ নিদিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münasibətdə təşəbbüskarsan. Müntəzəm söhbətlər sizi yaxın saxlayır və problemlərin dərinləşməsinə imkan vermir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты клапоцішся пра адносіны загадзя. Рэгулярныя размовы трымаюць вас блізка і не даюць крыўдам назапашвацца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грижиш се за връзката проактивно. Редовните разговори ви държат близо и не оставят нещата да загнояват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পর্কের ব্যাপারে তুমি আগ বাড়িয়ে চলো। নিয়মিত কথা বললে তোমরা কাছাকাছি থাকো আর কিছু ভেতরে ভেতরে জমে থাকে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proaktivno brineš o vezi. Redovni razgovori vas drže povezanima i sprečavaju da se stvari gomilaju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuides la relació de manera proactiva. Parlar-ne sovint us manté connectats i evita que les coses s'enquistin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke vztahu přistupuješ aktivně. Pravidelné rozhovory vás drží blízko a nenechají problémy doutnat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n rhagweithiol am y berthynas. Mae sgyrsiau rheolaidd yn eich cadw chi'n agos ac yn atal pethau rhag mudlosgi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er proaktiv i forholdet. Faste check-ins holder jer tæt forbundne og forhindrer, at ting får lov at ulme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kümmerst dich vorausschauend um eure Beziehung. Regelmäßige Check-ins halten euch verbunden und verhindern, dass etwas schwelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φροντίζεις τη σχέση προληπτικά. Οι τακτικές κουβέντες σάς κρατούν κοντά και δεν αφήνουν τα θέματα να φουσκώνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidas la relación de forma activa. Hablar con regularidad los mantiene conectados y evita que las cosas se enquisten."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa oled suhtes ennetav. Regulaarsed vestlused hoiavad teid lähedal ega lase asjadel mädanema minna."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harremanean aurrea hartzen duzu. Aldizkako elkarrizketek konektatuta mantentzen zaituzte eta gauzak usteltzea saihesten dute."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای رابطه پیش‌دستی می‌کنی. گفتگوهای مرتب شما را به هم وصل نگه می‌دارد و نمی‌گذارد چیزی در دل بماند و زخم شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huolehdit suhteesta ennakoivasti. Säännölliset keskustelut pitävät teidät yhteydessä ja estävät asioita hautumasta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proactive ka pagdating sa relasyon. Pinananatili kayong konektado ng regular na check-in at hindi hinahayaang lumala ang mga bagay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prends soin de votre relation de façon proactive. Faire souvent le point vous garde proches et évite que les choses s'enveniment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá tú réamhghníomhach faoin gcaidreamh. Coinníonn comhráite rialta sibh nasctha agus cuireann siad cosc ar rudaí a bheith ag déanamh angaidh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coidas a relación de forma proactiva. Falar dela con regularidade mantén a conexión e evita que as cousas se enquisten."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે સંબંધ માટે આગોતરું વિચારો છો. નિયમિત વાતચીત તમને જોડાયેલા રાખે છે અને વાતોને અંદર ને અંદર ઘૂંટાવા દેતી નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna ɗaukar mataki tun kafin matsala ta zo a dangantakarku. Tattaunawa akai-akai na ci gaba da haɗa ku tare kuma na hana abubuwa su ruɓe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך גישה יוזמת לזוגיות. שיחות קבועות שומרות על החיבור ומונעות מדברים להתבשל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप रिश्ते को लेकर पहल करते हैं। नियमित चेक-इन आपको जोड़े रखते हैं और बातों को अंदर ही अंदर पनपने नहीं देते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proaktivno brineš o vezi. Redoviti razgovori drže vas povezanima i ne daju da se stvari zagnoje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pran devan pou relasyon an. Fè pwen regilyèman kenbe nou konekte e anpeche bagay yo pouri."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudatosan ápolod a kapcsolatot. A rendszeres beszélgetések összetartanak, és nem hagyják, hogy a dolgok elmérgesedjenek."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու նախաձեռնող ես հարաբերություններում։ Պարբերական զրույցները ձեզ կապված են պահում և թույլ չեն տալիս, որ խնդիրները կուտակվեն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu proaktif soal hubungan. Check-in rutin menjaga kalian tetap dekat dan mencegah masalah menumpuk."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ebu ụzọ elekọta mmekọrịta ahụ. Ịkọrịta ọnọdụ mgbe niile na-eme ka unu jikọọ ma na-egbochi ihe ire ure n'obi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú hugsar fram í tímann um sambandið. Regluleg samtöl halda ykkur tengdum og koma í veg fyrir að hlutir grafi um sig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti prendi cura della relazione in modo proattivo. I check-in regolari vi tengono in contatto e impediscono che i problemi si incancreniscano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係づくりに積極的なタイプです。定期的に話すことで、つながりを保ち、わだかまりがこじれるのを防げます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan tumindak dhisik kanggo sesambungan. Omong-omongan sing ajeg njaga panjenengan sakloron tetep cedhak lan nyegah masalah dadi bosok."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ურთიერთობაში ინიციატივიანი ხარ. რეგულარული საუბრები კავშირს გინარჩუნებთ და პრობლემებს გაღრმავების საშუალებას არ აძლევს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен қарым-қатынасқа белсенді қарайсың. Тұрақты әңгімелер байланысты сақтап, мәселелердің ушығуына жол бермейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកសកម្មក្នុងការថែទំនាក់ទំនង។ ការសួរសុខទុក្ខគ្នាជាប្រចាំ ធ្វើឲ្យអ្នកទាំងពីរនៅជិតស្និទ្ធ ហើយការពារមិនឲ្យរឿងរ៉ាវកកកុញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಬಂಧದ ಬಗ್ಗೆ ನೀವು ಮುಂಚಿತವಾಗಿ ಕಾಳಜಿ ವಹಿಸುತ್ತೀರಿ. ನಿಯಮಿತ ಮಾತುಕತೆಗಳು ನಿಮ್ಮನ್ನು ಹತ್ತಿರವಿಡುತ್ತವೆ ಮತ್ತು ವಿಷಯಗಳು ಒಳಗೊಳಗೇ ಕೊಳೆಯದಂತೆ ತಡೆಯುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관계를 먼저 챙기는 타입이에요. 꾸준한 대화가 두 사람을 이어 주고, 문제가 곪지 않게 막아 줘요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ji bo têkiliyê pêşdest î. Sohbetên bi rêkûpêk we girêdayî digirin û nahêlin tişt di dil de birizin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен мамиле үчүн алдын ала аракет кыласың. Дайыма сүйлөшүп туруу экөөңдү жакын кармап, нараазылыктын ичте топтолушуна жол бербейт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du këmmers dech aktiv ëm är Bezéiung. Reegelméisseg Check-ins halen iech verbonnen a verhënneren, datt eppes am Stillen ugeet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າດູແລຄວາມສຳພັນແບບລ່ວງໜ້າ ການລົມກັນເປັນປະຈຳຊ່ວຍໃຫ້ໃກ້ຊິດກັນ ແລະ ບໍ່ໃຫ້ບັນຫາຄ້າງຄາຈົນລຸກລາມ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rūpiniesi santykiais iš anksto. Reguliarūs pokalbiai palaiko jūsų ryšį ir neleidžia problemoms rūgti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par attiecībām tu rūpējies laikus. Regulāras pārrunas uztur tuvību un neļauj lietām sakrāties."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandray andraikitra mialoha ianao amin'ny fifandraisana. Ny resaka tsy tapaka no mitazona anareo hifandray ary misoroka ny olana tsy hitombo."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ngākau hihiri koe mō te hononga. Mā ngā tirohanga auau e hono tonu ai kōrua, e kore ai ngā mea e pirau."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проактивно се грижиш за врската. Редовните проверки ве држат поврзани и не дозволуваат работите да се загнојат."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബന്ധത്തിന്റെ കാര്യത്തിൽ നിങ്ങൾ മുൻകൈയെടുക്കുന്നു. പതിവായുള്ള സംസാരങ്ങൾ നിങ്ങളെ അടുപ്പത്തിൽ നിർത്തുകയും കാര്യങ്ങൾ ഉള്ളിൽ പുകയുന്നത് തടയുകയും ചെയ്യുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи харилцаандаа идэвхтэй ханддаг. Тогтмол ярилцах нь та хоёрыг холбоотой байлгаж, асуудлыг даамжруулахгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नात्याबाबत तुम्ही पुढाकार घेता. नियमित चर्चेमुळे तुम्ही जोडलेले राहता आणि गोष्टी चिघळत नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda proaktif tentang hubungan. Perbualan yang kerap memastikan anda kekal rapat dan menghalang masalah daripada terbuku."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieħu l-inizjattiva fir-relazzjoni. Check-ins regolari jżommukom konnessi u ma jħallux l-affarijiet jinfexxu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်ဆံရေးအတွက် သင် ကြိုတင် တက်ကြွစွာ ဂရုစိုက်တယ်။ ပုံမှန် ပြောဆိုမှုတွေက နှစ်ယောက်ကို နီးစပ်စေပြီး ကိစ္စတွေ ပြည်တည်နာ မဖြစ်လာအောင် ကာကွယ်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er proaktiv med forholdet. Jevnlige innsjekker holder dere nær hverandre og hindrer at ting får ulme."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं सम्बन्धप्रति सक्रिय हुनुहुन्छ। नियमित कुराकानीले तपाईं दुवैलाई जोडिराख्छ र कुराहरूलाई भित्रभित्रै बिग्रन दिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij investeert actief in de relatie. Regelmatige check-ins houden jullie verbonden en voorkomen dat dingen gaan etteren."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumasamalira ubale mwakhama. Kukambirana pafupipafupi kumakusungani olumikizana ndipo kumaletsa zinthu kuola."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hariiroo keessatti dursitee hojjetta. Haasaan yeroo yeroon godhamu walitti isin hidha; dhimmoonni akka hin hammaanne ittisa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସମ୍ପର୍କ ପ୍ରତି ଆପଣ ସକ୍ରିୟ। ନିୟମିତ କଥାବାର୍ତ୍ତା ଆପଣଙ୍କୁ ଯୋଡ଼ି ରଖେ ଓ କଥାକୁ ଭିତରେ ଭିତରେ ପଚିବାକୁ ଦିଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਰਿਸ਼ਤੇ ਲਈ ਪਹਿਲਕਦਮੀ ਕਰਦੇ ਹੋ। ਨਿਯਮਿਤ ਚੈੱਕ-ਇਨ ਤੁਹਾਨੂੰ ਜੋੜੀ ਰੱਖਦੇ ਹਨ ਅਤੇ ਗੱਲਾਂ ਨੂੰ ਅੰਦਰੋ-ਅੰਦਰੀ ਸੁਲਗਣ ਤੋਂ ਰੋਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dbasz o relację z wyprzedzeniem. Regularne rozmowy utrzymują bliskość i nie pozwalają, by coś się jątrzyło."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو د خپلې اړیکې په اړه له مخکې فکر کوئ. منظمې کتنې ستاسو نږدېوالی ساتي او نه پرېږدي چې ستونزې زړې شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você cuida da relação de forma ativa. Conversas frequentes mantêm a conexão de vocês e evitam que as coisas fiquem mal resolvidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens uma atitude proativa na relação. Conversas regulares mantêm a ligação viva e evitam que as coisas apodreçam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai grijă de relație din timp. Check-in-urile regulate vă țin aproape și nu lasă lucrurile să mocnească."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты заботишься об отношениях заранее. Регулярные разговоры сохраняют близость и не дают обидам копиться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witangira kwita ku mubano. Kuganira kenshi bibagumisha hafi kandi bikabuza ibibazo kubora."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ සබඳතාව ගැන කලින්ම ක්‍රියා කරනවා. නිතිපතා අහලා බැලීම ඔබ දෙදෙනාව සමීපව තියනවා, දේවල් හිතේ පැසවන එක වළක්වනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K vzťahu pristupuješ aktívne. Pravidelné rozhovory vás držia spolu a nenechajú veci hniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za odnos poskrbiš vnaprej. Redni pogovori vaju ohranjajo povezana in preprečijo, da bi stvari tlele."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotanga kutarisira ukama usati wanetseka. Kugara muchigovana kunokuchengetai makabatana uye kunodzivirira zvinhu kuti zvisaora mukati."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriirka hore ayaad uga fekertaa. Is-hubinta joogtada ah ayaa idinku haysa xiriir oo ka hortagta in waxyaabo qudhmaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujdesesh për marrëdhënien përpara se të lindin problemet. Bisedat e rregullta ju mbajnë të lidhur dhe nuk i lënë gjërat të acarohen."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проактивно бринеш о вези. Редовни разговори вас држе повезанима и не дају да се ствари загноје."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun proaktif kana hubungan. Mariksa kaayaan sacara rutin ngajaga aranjeun tetep nyambung sareng nyegah masalah ngendap lami-lami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är proaktiv i relationen. Regelbundna avstämningar håller er nära och hindrar saker från att gro."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unachukua hatua mapema kwa ajili ya uhusiano. Mazungumzo ya mara kwa mara huwaweka karibu na huzuia mambo yasioze."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உறவைப் பற்றி நீங்கள் முன்கூட்டியே செயல்படுபவர். தொடர்ந்த உரையாடல்கள் உங்களை இணைப்பில் வைத்திருக்கின்றன, விஷயங்கள் புரையோடுவதைத் தடுக்கின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బంధం విషయంలో మీరు ముందుంటారు. తరచూ మాట్లాడుకోవడం మిమ్మల్ని దగ్గరగా ఉంచుతుంది, విషయాలు లోపల ముదరకుండా చూస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар муносибат ташаббускорӣ. Сӯҳбатҳои мунтазам шуморо пайваст нигоҳ медоранд ва намегузоранд, ки чизе дар дил ҷамъ шавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณดูแลความสัมพันธ์เชิงรุก การเช็กอินกันเป็นประจำช่วยให้ใกล้ชิดกันและไม่ปล่อยให้ปัญหาค้างคา"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንርክብኩም ኣቐዲምኩም ትሓልዉ። ስሩዕ ዕላላት ተኣሳሲርኩም ከም እትጸንሑ ይገብርን ነገራት ከይበሰዩ ይከላኸልን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen gatnaşyk barada öňünden alada edýärsiň. Yzygiderli söhbetler sizi ýakyn saklaýar we zatlaryň içde ýygnanmagynyň öňüni alýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişki konusunda proaktifsin. Düzenli konuşmalar bağınızı canlı tutuyor ve sorunların içten içe büyümesini önlüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти дбаєш про стосунки наперед. Регулярні розмови тримають вас близько й не дають образам накопичуватися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رشتے کے بارے میں آپ کا انداز پہل کا ہے۔ باقاعدہ بات چیت آپ کو جوڑے رکھتی ہے اور باتوں کو اندر ہی اندر پکنے نہیں دیتی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz munosabatlarga faol yondashasiz. Muntazam suhbatlar ikkalangizni yaqin tutadi va muammolar ichda yiringlashiga yoʻl qoʻymaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chủ động vun đắp mối quan hệ. Trò chuyện đều đặn giúp hai bạn gắn kết và không để chuyện gì âm ỉ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakhuthala ngobudlelwane. Iincoko ezenziwa rhoqo zinigcina nidibene kwaye zithintela izinto ekubeni zibole."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń ṣáájú nínú ìbáṣepọ̀ yín. Àyẹ̀wò déédéé ń mú kí ẹ wà ní ìsopọ̀, ó sì ń dènà kí nǹkan má jẹrà sínú."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會主動經營感情。定期談談讓你們保持連繫，也不讓問題悶到發酵。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对感情很主动。定期聊聊让你们保持连接，也不让问题越积越深。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會主動經營感情。定期聊聊讓你們保持連結，也不讓問題悶到發酵。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazinakekela izinto ebudlelwaneni ngaphambi kwesikhathi. Ukuhlola njalo kunigcina nixhumene futhi kuvimbela izinto ukuthi zibole."
          }
        }
      }
    },
    "You're reactive rather than proactive — which works if you're both good at raising things when they happen." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy reageer eerder as om vooruit te werk – wat werk as julle albei goed is daarmee om dinge op te noem wanneer dit gebeur."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀድመው ከመንቀሳቀስ ይልቅ ሲፈጠር ምላሽ ይሰጣሉ — ሁለታችሁም ነገሮችን በጊዜው ማንሳት ከቻላችሁ ይሠራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتفاعلون أكثر مما تبادرون، وهذا ينجح إن كنتما كلاكما بارعين في طرح الأمور حين تحدث."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি আগতীয়াকৈ নহয়, পৰিস্থিতি অনুসৰি সঁহাৰি দিয়ে — যদি দুয়ো কথা উঠাৰ লগে লগে উত্থাপন কৰাত পাকৈত, তেন্তে এয়া কামত আহে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qabaqcadan yox, vəziyyətə görə hərəkət edirsən — ikiniz də məsələləri vaxtında qaldırmağı bacarırsınızsa, bu işləyir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты хутчэй рэагуеш, чым дзейнічаеш на апярэджанне, — і гэта працуе, калі вы абое ўмееце адразу казаць пра тое, што здарылася."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-скоро реагираш, отколкото предвиждаш – това работи, ако и ти, и половинката ти умеете да повдигате нещата, когато се случат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি আগে থেকে নয়, দরকার পড়লে সাড়া দাও — তোমরা দুজনেই যদি সময়মতো কথা তুলতে পারো, তাহলে এটা ভালোই চলে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaguješ kad zatreba, a ne unaprijed – to funkcioniše ako oboje dobro otvarate teme čim se pojave."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reacciones més que no pas t'anticipes — cosa que funciona si a tots dos se us dona bé treure les coses quan passen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spíš reaguješ, než předcházíš – což funguje, pokud oba umíte věci otevřít, když nastanou."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n ymateb yn hytrach na rhagweld — sy'n gweithio os ydych chi'ch dau yn dda am godi pethau pan maen nhw'n digwydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du reagerer hellere, end du planlægger – og det fungerer, hvis I begge er gode til at tage ting op, når de sker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du reagierst eher, als vorzubeugen – das klappt, wenn ihr beide gut darin seid, Dinge direkt anzusprechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιδράς όταν χρειάζεται αντί να προλαβαίνεις — κάτι που δουλεύει μια χαρά αν και οι δυο σας θίγετε τα πράγματα την ώρα που συμβαίνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaccionas más de lo que te anticipas, y eso funciona si a los dos se les da bien sacar los temas en el momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa pigem reageerid kui ennetad — see toimib, kui te mõlemad oskate asju üles tõsta kohe, kui need tekivad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurrea hartu baino gehiago, erantzun egiten duzu — eta ondo dabil, biok gauzak sortu ahala ateratzen trebeak bazarete."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیشتر واکنشی عمل می‌کنی تا پیش‌دستانه — که جواب می‌دهد اگر هر دوتان در مطرح کردن مسائل به‌موقع خوب باشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reagoit mieluummin kuin ennakoit – se toimii, jos osaatte molemmat ottaa asiat puheeksi silloin, kun niitä tapahtuu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinaharap mo ang mga bagay kapag dumating na, hindi inuunahan — gumagana ito kung pareho kayong magaling magbukas ng isyu kapag nangyayari ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu réagis plutôt que d'anticiper, et ça marche si vous deux savez aborder les choses quand elles arrivent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is imoibríoch seachas réamhghníomhach thú — oibríonn sé sin má tá an bheirt agaibh go maith ag tarraingt rudaí anuas nuair a tharlaíonn siad."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es máis de reaccionar ca de anticiparte, e iso funciona se os dous sabedes sacar as cousas cando pasan."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે અગાઉથી નહીં, પણ જરૂર પડ્યે વાત કરો છો — જો તમે બંને વાત બને ત્યારે જ એને ઉઠાવવામાં સારા હો તો આ સરસ ચાલે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna mayar da martani maimakon riga-kafi — wannan na aiki idan ku biyu kun ƙware wajen tayar da magana idan abu ya faru."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצלך מגיבים לדברים כשהם קורים יותר מאשר יוזמים — וזה עובד אם שניכם יודעים להעלות דברים בזמן אמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप पहले से नहीं, ज़रूरत पड़ने पर बात करते हैं — यह तब ठीक चलता है जब आप दोनों बातें उठते ही कह देने में अच्छे हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reagiraš umjesto da preduhitriš – što funkcionira ako oboje dobro otvarate teme čim se pojave."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou reyaji plis pase ou prevwa — sa mache si nou tou de konn pale de bagay yo lè yo rive."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább reagálsz, mint megelőzöl – ez akkor működik, ha mindketten jól szóvá teszitek a dolgokat, amikor történnek."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու ավելի շուտ արձագանքում ես, քան կանխում — ինչը գործում է, եթե երկուսդ էլ լավ եք կարողանում խոսել խնդիրների մասին, երբ դրանք առաջանում են։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lebih reaktif daripada proaktif — dan itu berhasil kalau kalian berdua sama-sama pandai membahas masalah begitu muncul."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-aza ihe mgbe ọ mere karịa ibu ụzọ — nke na-arụ ọrụ ma ọ bụrụ na unu abụọ maara ikwupụta ihe mgbe ọ mere."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú bregst frekar við en að fyrirbyggja – sem virkar ef þið eruð bæði góð í að taka málin upp þegar þau koma upp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più che prevenire, reagisci — e funziona, se siete entrambi bravi a sollevare le cose quando capitano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先回りより、起きてから対応するタイプです。ふたりとも、その場で気になることを言えるなら、それでうまくいきます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan luwih nanggepi tinimbang tumindak dhisik — iki bisa mlaku yen panjenengan sakloron padha pinter ngomongake bab nalika kedadeyan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფრო რეაგირებ, ვიდრე წინასწარ მოქმედებ — და ეს მუშაობს, თუ ორივე კარგად ახერხებთ საკითხების დროულად წამოწევას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен алдын ала емес, жағдайға қарай әрекет етесің — екеуің де мәселені дер кезінде көтере алсаңдар, бұл жұмыс істейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកឆ្លើយតបពេលមានរឿង ជាជាងបង្ការទុកមុន — វាដំណើរការល្អ បើអ្នកទាំងពីរពូកែលើករឿងមកនិយាយពេលវាកើតឡើង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಂಚಿತವಾಗಿ ಅಲ್ಲ, ಸಂದರ್ಭ ಬಂದಾಗ ಸ್ಪಂದಿಸುತ್ತೀರಿ — ವಿಷಯಗಳು ಎದುರಾದಾಗಲೇ ಅವನ್ನು ಎತ್ತುವುದರಲ್ಲಿ ನೀವಿಬ್ಬರೂ ಚೆನ್ನಾಗಿದ್ದರೆ ಇದು ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 챙기기보다 그때그때 대응하는 편이에요. 두 사람 모두 일이 생겼을 때 잘 꺼낼 수 있다면 잘 맞는 방식이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu li şûna pêşdestiyê bersiv didî — ev dixebite heke hûn herdu jî dema tişt diqewimin baş wan tînin ziman."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен алдын ала эмес, бир нерсе болгондо гана аракет кыласың — эгер экөөң тең маселени өз убагында айта алсаңар, бул иштейт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du reagéiers éischter, wéi s du virausplangs — dat funktionéiert, wann dir zwee gutt dra sidd, Saachen unzeschwätzen, wann se geschéien."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າແກ້ເມື່ອມີເລື່ອງ ຫຼາຍກວ່າປ້ອງກັນລ່ວງໜ້າ — ເຊິ່ງໃຊ້ໄດ້ດີຖ້າທັງສອງເກັ່ງໃນການຍົກເລື່ອງຂຶ້ນມາລົມເມື່ອມັນເກີດຂຶ້ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu labiau reaguoji, nei užbėgi už akių – tai veikia, jei jūs abu mokate iškelti dalykus, kai jie nutinka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu drīzāk reaģē, nekā apsteidz, – tas strādā, ja jūs abi protat ierunāties par lietām, kad tās notiek."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamaly rehefa misy ianao fa tsy mialoha — mandeha tsara izany raha samy mahay mampiakatra resaka rehefa mitranga ny zavatra ianareo roa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka urupare koe, kaua e whakarite i mua — e pai ana tēnā mēnā he pai kōrua tahi ki te whakaara take i te wā e puta ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повеќе реагираш отколку што однапред покренуваш — што функционира ако и ти и половинката лесно ги отворате работите кога ќе се случат."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മുൻകൂട്ടി ഇറങ്ങുന്നതിനെക്കാൾ, സംഭവിക്കുമ്പോൾ പ്രതികരിക്കുന്നതാണ് നിങ്ങളുടെ രീതി — കാര്യങ്ങൾ ഉണ്ടാകുമ്പോൾത്തന്നെ തുറന്നുപറയാൻ നിങ്ങൾ ഇരുവർക്കും കഴിയുമെങ്കിൽ ഇത് നന്നായി നടക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи урьдчилан бус, тухайн үед нь хариу үйлдэл үзүүлдэг — хоёулаа асуудлыг гарангуут нь хөнддөг бол энэ сайн ажилладаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही आधीच पुढाकार घेण्यापेक्षा प्रसंगानुसार प्रतिसाद देता — गोष्टी घडताच त्या मांडण्यात तुम्ही दोघे चांगले असाल, तर हे छान चालते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda lebih reaktif daripada proaktif — yang berkesan jika anda berdua pandai membangkitkan perkara sebaik ia berlaku."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirreaġixxi aktar milli tantiċipa — u dan jaħdem jekk intom it-tnejn tafu tqajmu l-affarijiet meta jiġru."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် ကြိုတင်လုပ်တာထက် ဖြစ်လာမှ တုံ့ပြန်တတ်တယ် — နှစ်ယောက်စလုံး ကိစ္စတွေ ဖြစ်လာတာနဲ့ ပြောတတ်ရင်တော့ ဒါ အဆင်ပြေပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er mer reaktiv enn proaktiv – og det fungerer hvis dere begge er flinke til å ta opp ting når de skjer."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं पहिल्यै भन्दा पनि कुरा आइपरेपछि कदम चाल्नुहुन्छ — तपाईं दुवै कुरा आइपर्दा उठाउन सिपालु हुनुहुन्छ भने यो राम्रै चल्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij reageert liever op wat er speelt dan dat je vooruitloopt – dat werkt prima als jullie allebei goed zijn in dingen meteen aankaarten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumachita zinthu zikachitika m'malo moziyembekezera — zimagwira ntchito ngati nonse awiri muli aluso pofotokoza zinthu zikangochitika."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dursitee osoo hin taane, yeroo wanti uumamu deebii kennita — kun yoo lamaan keessan yeroo dhimmi uumame kaasuu dandeessan ni hojjeta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଆଗୁଆ ନୁହେଁ, ପରିସ୍ଥିତି ଅନୁସାରେ ପ୍ରତିକ୍ରିୟା ଦିଅନ୍ତି — ଦୁହେଁ ସମୟରେ କଥା ଉଠାଇବାରେ ଭଲ ହେଲେ ଏହା ଠିକ୍ ଚାଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਪਹਿਲਕਦਮੀ ਦੀ ਥਾਂ ਹਾਲਾਤ ਮੁਤਾਬਕ ਚੱਲਦੇ ਹੋ — ਇਹ ਤਾਂ ਹੀ ਕੰਮ ਕਰਦਾ ਹੈ ਜੇ ਤੁਸੀਂ ਦੋਵੇਂ ਗੱਲਾਂ ਨੂੰ ਵੇਲੇ ਸਿਰ ਛੇੜਨ ਵਿੱਚ ਚੰਗੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reagujesz, zamiast zapobiegać – to działa, jeśli każde z was umie poruszać sprawy na bieżąco."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو له مخکې نه، بلکې د پېښې پر وخت غبرګون ښیئ — دا هغه وخت ښه کار کوي چې تاسو دواړه په خپل وخت د خبرو په یادولو کې ښه یاست."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você reage em vez de se antecipar — o que funciona se os dois souberem falar das coisas quando acontecem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reages mais do que te antecipas — o que funciona se os dois souberem pôr as coisas em cima da mesa quando acontecem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reacționezi mai mult decât anticipezi — ceea ce merge dacă amândoi știți să aduceți vorba pe loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты скорее реагируешь, чем предупреждаешь, — и это работает, если вы оба умеете поднимать темы сразу."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utegereza ko ibintu biba aho kubitegura mbere — ibyo bigenda neza niba mwembi muzi kuvuga ibibazo bikimara kuvuka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ කලින් ක්‍රියා කරනවාට වඩා සිදුවෙනකොට ප්‍රතිචාර දක්වනවා — ඔබ දෙදෙනාම දේවල් සිදුවුණු ගමන් කතා කරන්න දක්ෂ නම් ඒක හොඳට වැඩ කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skôr reaguješ, než predchádzaš – čo funguje, ak obaja viete veci otvoriť hneď, keď nastanú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odzivaš se sproti, ne vnaprej – kar deluje, če vsak od vaju zna stvari načeti takoj, ko se zgodijo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unopindura zvinhu kana zvaitika pane kutanga — izvi zvinoshanda kana mose muri vaviri muchikwanisa kutaura nezvezvinhu zvichangoitika."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad wax ka qabataa marka ay dhacaan halkii aad hore uga fekeri lahayd — taas oo shaqaynaysa haddii labadiinaba aad ku fiican tihiin inaad waxyaabaha soo qaaddaan marka ay dhacaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më shumë reagon sesa parandalon – gjë që funksionon nëse të dy dini t’i ngrini gjërat sapo ndodhin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Више реагујеш него што предухитриш — што функционише ако обоје лако покрећете теме кад се појаве."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun langkung réaktif tibatan proaktif — anu tiasa jalan upami aranjeun duaan sami-sami parigel nyarioskeun hiji hal nalika kajadian."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är mer reaktiv än proaktiv – vilket funkar om ni båda är bra på att ta upp saker när de händer."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaitikia badala ya kutangulia — jambo linalofaa ikiwa nyote wawili mnaweza kuibua mambo yanapotokea."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் முன்கூட்டியே அல்ல, தேவைப்படும்போது செயல்படுபவர் — விஷயங்கள் நடக்கும்போதே அவற்றைப் பேச நீங்கள் இருவருமே தயங்காதவர்கள் என்றால் இது நன்றாகவே பொருந்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ముందుగా కాకుండా, అవసరం వచ్చినప్పుడు స్పందిస్తారు — విషయాలు జరిగినప్పుడే చెప్పడంలో మీరిద్దరూ బాగుంటే ఇది పనిచేస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту бештар ба вазъият вокуниш мекунӣ, на пешакӣ — ин кор медиҳад, агар ҳар дуи шумо масъалаҳоро сари вақт ба миён гузоред."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรับมือเมื่อเกิดเรื่องมากกว่าป้องกันล่วงหน้า ซึ่งได้ผลถ้าคุณทั้งสองกล้าพูดทันทีเมื่อมีอะไรเกิดขึ้น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣቐዲምኩም ዘይኮነስ ምስ ኣድለየ ኢኹም ትገብሩ — ክልቴኹም ነገራት ኣብ ግዜኦም ምልዓል እንተ ክኢልኩም ይሰርሕ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen öňünden däl-de, ýagdaýa görä hereket edýärsiň — eger ikiňiz hem zatlary wagtynda gozgamagy başarýan bolsaňyz, bu işleýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceden değil, ihtiyaç doğunca hareket ediyorsun; ikiniz de bir şey olduğunda dile getirmekte iyiyseniz bu işe yarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти радше реагуєш на ситуацію, ніж дієш наперед, — і це працює, якщо ви обоє вмієте одразу говорити про те, що виникло."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انداز پہل کے بجائے ردِعمل کا ہے — جو تب کامیاب رہتا ہے جب آپ دونوں بات ہوتے ہی اسے سامنے لانے میں اچھے ہوں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz oldindan emas, vaziyatga qarab harakat qilasiz — ikkalangiz ham muammoni oʻz vaqtida aytishga usta boʻlsangiz, bu yaxshi ishlaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn phản ứng khi cần hơn là chủ động — cách này ổn nếu cả hai đều giỏi nói ra ngay khi có chuyện."
