    "Family dynamics shape expectations in relationships — more than most people realise." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ديناميكيات العائلة تشكّل التوقعات في العلاقات أكثر مما يدرك معظم الناس."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodinné vztahy formují očekávání ve vztahu – víc, než si většina lidí uvědomuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiedynamikker former forventningerne i et forhold – mere end de fleste tror."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie prägt Erwartungen an eine Beziehung – mehr, als den meisten bewusst ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οικογενειακές σχέσεις διαμορφώνουν τις προσδοκίες μας στη σχέση — περισσότερο απ' όσο νομίζουν οι περισσότεροι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dinámica familiar moldea lo que esperamos de una relación — más de lo que la mayoría cree."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhesuhteet muovaavat odotuksia parisuhteessa – enemmän kuin useimmat tajuavat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinuhubog ng dynamics ng pamilya ang mga inaasahan sa relasyon — higit pa sa akala ng karamihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dynamique familiale façonne nos attentes en couple, bien plus qu'on ne le pense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדינמיקה המשפחתית מעצבת ציפיות בזוגיות — יותר ממה שרוב האנשים חושבים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार का माहौल रिश्ते की उम्मीदें तय करता है — ज़्यादातर लोगों की सोच से कहीं ज़्यादा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A családi minták jobban alakítják a kapcsolati elvárásokat, mint azt a legtöbben gondolnák."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamika keluarga membentuk harapan dalam hubungan — lebih dari yang disadari kebanyakan orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dinamiche familiari modellano le aspettative nella coppia — più di quanto si pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族関係は、恋愛で何を期待するかにも影響します。思っている以上に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 안에서 겪은 관계는 생각보다 훨씬 많이 연애에 대한 기대를 좌우해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik keluarga membentuk jangkaan dalam hubungan — lebih daripada yang disedari kebanyakan orang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien former forventningene vi har i et forhold – mer enn de fleste tror."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familieverhoudingen bepalen je verwachtingen in een relatie – meer dan de meeste mensen beseffen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamika rodzinna kształtuje oczekiwania w związku – bardziej, niż większość ludzi sądzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dinâmica familiar molda as expectativas numa relação — mais do que a maioria imagina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamica familiei modelează așteptările dintr-o relație — mai mult decât își dau seama cei mai mulți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семейные отношения формируют ожидания в паре — сильнее, чем думает большинство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjedynamik formar förväntningarna i en relation – mer än de flesta tror."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสัมพันธ์ในครอบครัวหล่อหลอมความคาดหวังในความรัก มากกว่าที่คนส่วนใหญ่คิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aile dinamikleri ilişkideki beklentileri çoğu insanın sandığından daha fazla şekillendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сімейні стосунки формують очікування в парі — більше, ніж здається більшості людей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách gia đình vận hành định hình kỳ vọng trong tình yêu — nhiều hơn hầu hết mọi người nghĩ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭关系会塑造一个人对感情的期待，影响远比大多数人以为的要大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭相處模式會影響你對感情的期待，影響程度比多數人以為的還大。"
          }
        }
      }
    },
    "Family is central to your life. A partner will need to understand and respect that — and probably show up for family things regularly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العائلة في قلب حياتك. سيحتاج الشريك إلى فهم ذلك واحترامه، وربما الحضور في المناسبات العائلية بانتظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodina je středem tvého života. Protějšek to bude muset chápat a respektovat – a nejspíš se pravidelně ukazovat na rodinných akcích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien er central i dit liv. En partner skal forstå og respektere det – og nok dukke op til familiearrangementer jævnligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie steht im Mittelpunkt deines Lebens. Dein Schatz muss das verstehen und respektieren – und wird wohl regelmäßig bei Familienanlässen dabei sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η οικογένεια είναι στο κέντρο της ζωής σου. Το ταίρι σου θα πρέπει να το καταλαβαίνει και να το σέβεται — και μάλλον να δίνει συχνά το παρών στα οικογενειακά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La familia es el centro de tu vida. Tu pareja tendrá que entenderlo y respetarlo — y seguramente acompañarte a planes familiares con frecuencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhe on elämäsi keskiössä. Kumppanin täytyy ymmärtää ja kunnioittaa sitä – ja luultavasti osallistua perhejuttuihin säännöllisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentro ng buhay mo ang pamilya. Kailangang maintindihan at irespeto ito ng partner mo — at malamang madalas siyang dumalo sa mga family event."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La famille est au cœur de ta vie. L'autre devra le comprendre et le respecter, et sûrement répondre présent aux moments en famille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשפחה במרכז החיים שלך. מי שאיתך יצטרך להבין ולכבד את זה — וכנראה גם להגיע לאירועים משפחתיים באופן קבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार आपकी ज़िंदगी का केंद्र है। पार्टनर को इसे समझना और इसका सम्मान करना होगा — और शायद पारिवारिक मौक़ों पर अक्सर साथ आना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A család az életed középpontja. A párodnak ezt meg kell értenie és tisztelnie kell – és valószínűleg rendszeresen ott kell lennie a családi eseményeken."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarga adalah pusat hidupmu. Pasanganmu perlu memahami dan menghormatinya — dan mungkin sering ikut hadir di acara keluarga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La famiglia è al centro della tua vita. Il tuo partner dovrà capirlo e rispettarlo — e probabilmente esserci spesso agli eventi di famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族が生活の中心にある人です。パートナーにはそれを理解して尊重してもらう必要があり、パートナーも家族の集まりによく顔を出すことになりそうです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족이 삶의 중심이에요. 연인이 그걸 이해하고 존중해야 하고, 가족 행사에도 자주 함께해야 할 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarga ialah teras hidup anda. Pasangan perlu memahami dan menghormatinya — dan mungkin kerap hadir dalam acara keluarga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien står sentralt i livet ditt. En partner må forstå og respektere det – og sikkert stille opp på familieting jevnlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie staat centraal in je leven. Je partner moet dat begrijpen en respecteren – en waarschijnlijk geregeld meegaan naar familiedingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodzina jest w centrum twojego życia. Druga połówka będzie musiała to rozumieć i szanować – i pewnie regularnie pojawiać się na rodzinnych spotkaniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A família é central na sua vida. Seu amor vai precisar entender e respeitar isso — e provavelmente marcar presença nos eventos de família."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familia e în centrul vieții tale. Un partener va trebui să înțeleagă și să respecte asta — și probabil să fie des prezent la evenimentele de familie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья — центр твоей жизни. Партнёру нужно это понимать и уважать — и, скорее всего, регулярно бывать на семейных встречах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjen är central i ditt liv. En partner behöver förstå och respektera det – och nog ställa upp på familjegrejer ganska ofta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครอบครัวคือศูนย์กลางชีวิตคุณ คนรักต้องเข้าใจและเคารพเรื่องนี้ และน่าจะต้องไปร่วมงานครอบครัวเป็นประจำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aile hayatının merkezinde. Partnerinin bunu anlaması, saygı duyması ve muhtemelen aile buluşmalarına düzenli olarak katılması gerekecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Родина — центр твого життя. Половинці треба це розуміти й поважати — і, мабуть, регулярно бувати на сімейних зустрічах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia đình là trung tâm cuộc sống của bạn. Người ấy cần hiểu và tôn trọng điều đó — và chắc sẽ thường xuyên có mặt trong các dịp gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人是你生活的中心。另一半需要理解并尊重这一点，可能还得常常参加家庭活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人是你生活的重心。另一半需要理解並尊重這點，大概也要常常一起參加家族活動。"
          }
        }
      }
    },
