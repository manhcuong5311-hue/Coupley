        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilitet dhe rrënjë. Kjo është shenjë afatgjatë – po mendon për një të ardhme të përbashkët, jo vetëm për tani."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабилност и корени. То је дугорочан знак — размишљаш о заједничкој будућности, а не само о садашњем тренутку."
          }
        },
        "su" : {
          "stringUnit" : {
