        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punom snagom i na poslu i u zabavi – dajem sve"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treballar molt, gaudir molt — m'hi deixo la pell"
