    "Music as expression. Even modest skill in an instrument changes how you experience music entirely." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiek as uitdrukking. Selfs ’n bietjie vaardigheid op ’n instrument verander heeltemal hoe jy musiek beleef."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙዚቃ እንደ መግለጫ። በአንድ መሣሪያ መጠነኛ ክህሎት እንኳ ሙዚቃን የሚያጣጥሙበትን መንገድ ሙሉ በሙሉ ይለውጣል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموسيقى تعبير. حتى المهارة المتواضعة في العزف تغيّر تجربتك مع الموسيقى تمامًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংগীত প্ৰকাশৰ মাধ্যম হিচাপে। বাদ্যযন্ত্ৰত অলপ দক্ষতা থাকিলেও সংগীত অনুভৱ কৰাৰ ধৰণটোৱেই সম্পূৰ্ণ সলনি হৈ যায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İfadə vasitəsi kimi musiqi. Bir alətdə hətta sadə bacarıq da musiqini necə hiss etdiyini tamamilə dəyişir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка як самавыяўленне. Нават сціплае ўменне іграць на інструменце цалкам мяняе тое, як ты адчуваеш музыку."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музиката като изразяване. Дори скромно умение да свириш на инструмент променя изцяло начина, по който преживяваш музиката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গান মানে নিজেকে প্রকাশ। কোনো যন্ত্রে সামান্য দক্ষতাও গান শোনার পুরো অনুভূতিটা বদলে দেয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika kao izraz. Čak i skromno znanje sviranja potpuno mijenja način na koji doživljavaš muziku."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música com a expressió. Fins i tot un nivell modest amb un instrument canvia del tot com vius la música."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hudba jako vyjádření. I základní hra na nástroj úplně změní, jak hudbu prožíváš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerddoriaeth fel mynegiant. Mae hyd yn oed ychydig o sgil ar offeryn yn newid yn llwyr sut rwyt ti'n profi cerddoriaeth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik som udtryk. Selv beskedne evner på et instrument ændrer helt, hvordan du oplever musik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik als Ausdruck. Schon ein bisschen Können an einem Instrument verändert, wie du Musik erlebst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική ως έκφραση. Ακόμα και λίγη εξοικείωση με ένα όργανο αλλάζει εντελώς τον τρόπο που ζεις τη μουσική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música como expresión. Incluso un nivel modesto con un instrumento cambia por completo cómo vives la música."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muusika kui eneseväljendus. Isegi tagasihoidlik pillimänguoskus muudab täielikult seda, kuidas sa muusikat koged."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musika adierazpide gisa. Instrumentu batean trebetasun apala izateak ere guztiz aldatzen du musika bizitzeko modua."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی به‌عنوان بیان. حتی مهارتی ساده در یک ساز، تجربه‌ات از موسیقی را کاملاً عوض می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiikki ilmaisuna. Vaatimatonkin soittotaito muuttaa täysin sen, miten koet musiikin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musika bilang pagpapahayag. Kahit kaunting galing sa isang instrumento ay buong nagbabago sa pakikinig mo sa musika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique comme expression. Même un niveau modeste à un instrument change complètement ta façon de vivre la musique."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceol mar shlí chun tú féin a chur in iúl. Athraíonn fiú beagán scile ar uirlis an chaoi a mbraitheann tú an ceol ar fad."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A música como expresión. Ata un dominio modesto dun instrumento cambia por completo como vives a música."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંગીત દ્વારા અભિવ્યક્તિ. કોઈ વાદ્ય થોડું પણ વગાડતાં આવડે તો સંગીત માણવાની આખી રીત બદલાઈ જાય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waƙa a matsayin hanyar bayyanawa. Ko da ɗan ƙwarewa a kayan kiɗa na sauya yadda kuke jin waƙa gaba ɗaya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוזיקה כביטוי. גם יכולת צנועה בכלי נגינה משנה לגמרי את הדרך שבה מוזיקה נחווית אצלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत, अभिव्यक्ति का ज़रिया। किसी वाद्य पर थोड़ा-सा हाथ बैठ जाए, तो भी संगीत का पूरा अनुभव बदल जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glazba kao izražavanje. Čak i skromno sviranje instrumenta potpuno mijenja doživljaj glazbe."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mizik kòm ekspresyon. Menm yon ti konpetans nan yon enstriman chanje jan ou viv mizik nèt."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zene mint kifejezés. Már egy kis hangszeres tudás is teljesen megváltoztatja, hogyan éled meg a zenét."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երաժշտությունը՝ որպես արտահայտում։ Նվագարանի նույնիսկ համեստ տիրապետումը ամբողջովին փոխում է, թե ինչպես ես զգում երաժշտությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik sebagai ekspresi. Bahkan kemampuan sederhana memainkan alat musik bisa mengubah caramu menikmati musik sepenuhnya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egwu dịka ngosipụta. Ọbụlagodị obere nka na ngwa egwu na-agbanwe otu i si enwe mmetụta egwu kpamkpam."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tónlist sem tjáning. Jafnvel smávegis færni á hljóðfæri breytir algjörlega því hvernig þú upplifir tónlist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica come espressione. Anche saper suonare un po’ uno strumento cambia del tutto il modo in cui vivi la musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽で表現したい人です。楽器が少し弾けるようになるだけで、音楽の感じ方がまるごと変わります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik minangka ekspresi. Senajan mung bisa sethithik main alat musik, cara panjenengan ngrasakake musik bakal owah babar pisan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მუსიკა, როგორც თვითგამოხატვა. ინსტრუმენტზე დაკვრის მცირე უნარიც კი მთლიანად ცვლის, როგორ აღიქვამ მუსიკას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — өзіңді білдіру тәсілі. Аспапта аздап ойнай білудің өзі музыканы қабылдауыңды мүлде өзгертеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "តន្ត្រីជាការបញ្ចេញអារម្មណ៍។ សូម្បីតែជំនាញតិចតួចលើឧបករណ៍តន្ត្រី ក៏ផ្លាស់ប្ដូររបៀបដែលអ្នកស្ដាប់តន្ត្រីទាំងស្រុងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಗೀತವೇ ಅಭಿವ್ಯಕ್ತಿ. ಒಂದು ವಾದ್ಯದಲ್ಲಿ ಸ್ವಲ್ಪ ಕೌಶಲ ಬಂದರೂ ಸಂಗೀತವನ್ನು ನೀವು ಅನುಭವಿಸುವ ರೀತಿಯೇ ಬದಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악으로 표현하고 싶어 해요. 악기를 조금만 다룰 줄 알아도 음악을 느끼는 방식이 완전히 달라져요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzîk wekî îfade. Heta jêhatîbûneke hindik di amûrekê de jî awayê ku tu muzîkê dijî bi tevahî diguherîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — өзүңдү билдирүү. Аспапты бир аз эле үйрөнсөң да, музыканы таптакыр башкача сезе баштайсың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musek als Ausdrock. Schonn e bësse Kënnen un engem Instrument ännert komplett, wéi s de Musek erlieft."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ດົນຕີຄືການສະແດງອອກ ເຖິງແມ່ນຫຼິ້ນເຄື່ອງດົນຕີໄດ້ພຽງເລັກນ້ອຍ ກໍປ່ຽນວິທີທີ່ເຈົ້າສຳຜັດດົນຕີໄປໝົດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika kaip saviraiška. Net kuklūs grojimo įgūdžiai visiškai pakeičia tai, kaip išgyveni muziką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mūzika kā izpausme. Pat neliela prasme spēlēt instrumentu pilnībā maina to, kā tu uztver mūziku."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny mozika ho fanehoana. Na dia fahaizana kely amin'ny zavamaneno aza dia manova tanteraka ny fihainoanao mozika."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te puoro hei whakapuaki. Ahakoa he pūkenga iti noa i tētahi taonga puoro, ka huri katoa tō rongo i te puoro."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музиката како израз. Дури и скромно свирење на инструмент целосно го менува начинот на кој ја доживуваш музиката."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആവിഷ്കാരമായി സംഗീതം. ഒരു ഉപകരണത്തിലെ ചെറിയ കഴിവ് പോലും നിങ്ങൾ സംഗീതം അനുഭവിക്കുന്ന രീതി തന്നെ മാറ്റും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөгжим бол илэрхийлэл. Зэмсэг бага ч гэсэн тоглож чаддаг болох нь хөгжмийг мэдрэх байдлыг чинь бүрэн өөрчилдөг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीतातून अभिव्यक्ती. एखादे वाद्य थोडेफार जरी वाजवता आले, तरी संगीत अनुभवण्याची तुमची पद्धतच बदलते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzik sebagai ekspresi. Walaupun sekadar mahir sedikit bermain alat muzik, cara anda menikmati muzik akan berubah sepenuhnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mużika bħala espressjoni. Anke ftit ħila fi strument tbiddel għal kollox kif tesperjenza l-mużika."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂီတကို ဖော်ပြမှုအဖြစ် မြင်တယ်။ တူရိယာတစ်ခုကို အနည်းငယ် တီးတတ်ရုံနဲ့တောင် ဂီတကို ခံစားပုံ လုံးဝ ပြောင်းသွားတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikk som uttrykk. Selv litt ferdighet på et instrument endrer helt hvordan du opplever musikk."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत अभिव्यक्तिको माध्यम। बाजामा अलिकति सीप भए पनि संगीतलाई अनुभव गर्ने तरिका नै बदलिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek als expressie. Al kun je een instrument maar een beetje bespelen, het verandert compleet hoe je muziek beleeft."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyimbo ngati njira yofotokozera. Ngakhale luso lochepa pa chida choimbira limasintha kotheratu mmene mumamvera nyimbo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuziqaa akka of ibsuutti. Dandeettiin meeshaa muuziqaa xiqqaan illee akkaataa ati muuziqaa itti dhaga'attu guutummaatti jijjiira."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଙ୍ଗୀତ ଏକ ପ୍ରକାଶ। ବାଦ୍ୟଯନ୍ତ୍ରରେ ସାମାନ୍ୟ ଦକ୍ଷତା ବି ସଙ୍ଗୀତକୁ ଅନୁଭବ କରିବାର ଢଙ୍ଗ ପୂରା ବଦଳାଇଦିଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੰਗੀਤ ਪ੍ਰਗਟਾਵੇ ਵਜੋਂ। ਕਿਸੇ ਸਾਜ਼ ਵਿੱਚ ਥੋੜ੍ਹੀ ਜਿਹੀ ਮੁਹਾਰਤ ਵੀ ਸੰਗੀਤ ਨੂੰ ਮਹਿਸੂਸ ਕਰਨ ਦਾ ਤੁਹਾਡਾ ਪੂਰਾ ਅੰਦਾਜ਼ ਬਦਲ ਦਿੰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka jako ekspresja. Nawet skromne umiejętności gry na instrumencie całkowicie zmieniają odbiór muzyki."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقي د څرګندونې په توګه. په یوه آله کې حتی لږ مهارت هم د موسیقۍ تجربه په بشپړه توګه بدلوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música como expressão. Mesmo um pouco de prática num instrumento muda totalmente como você vive a música."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A música como expressão. Mesmo pouco jeito num instrumento muda por completo a forma como vives a música."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzica drept exprimare. Chiar și puțină pricepere la un instrument îți schimbă complet felul în care trăiești muzica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка как самовыражение. Даже скромное владение инструментом полностью меняет то, как ты слышишь музыку."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuziki nk'uburyo bwo kwigaragaza. N'ubumenyi buke mu gucuranga buhindura burundu uko wumva umuziki."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සංගීතය ප්‍රකාශනයක් විදිහට. සංගීත භාණ්ඩයක පොඩි හැකියාවක් වුණත් ඔබ සංගීතය අත්විඳින විදිහ මුළුමනින්ම වෙනස් කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hudba ako vyjadrenie. Aj skromná zručnosť na nástroji úplne zmení, ako hudbu prežívaš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasba kot izraz. Že skromno znanje igranja na inštrument povsem spremeni, kako doživljaš glasbo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimhanzi sekuzviratidza. Kunyange hunyanzvi hushoma pachiridzwa hunochinja zvachose manzwiro aunoita mimhanzi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muusigu waa hab aad isku muujiso. Xitaa xirfad yar oo qalab muusig ah ayaa gebi ahaanba beddesha sida aad u dareento muusigga."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika si shprehje. Edhe pak aftësi me një instrument e ndryshon krejt mënyrën si e përjeton muzikën."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музика као израз. Чак и скромно знање свирања потпуно мења то како доживљаваш музику."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik salaku cara ngébréhkeun diri. Sanaos ngan saeutik mahér dina alat musik, éta ngarobah pisan cara anjeun ngaraoskeun musik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik som uttryck. Även lite kunskap på ett instrument förändrar helt hur du upplever musik."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziki kama njia ya kujieleza. Hata ujuzi mdogo wa ala hubadilisha kabisa jinsi unavyoufurahia muziki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இசை ஒரு வெளிப்பாடு. ஓர் இசைக்கருவியில் கொஞ்சம் திறமை வந்தாலும், இசையை நீங்கள் அனுபவிக்கும் விதமே முழுதாக மாறும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సంగీతం ఒక వ్యక్తీకరణ. ఒక వాద్యంలో కొద్దిపాటి నైపుణ్యం ఉన్నా, మీరు సంగీతాన్ని అనుభవించే తీరే పూర్తిగా మారిపోతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мусиқӣ ҳамчун ифода. Ҳатто маҳорати хоксорона дар навохтан эҳсоси туро аз мусиқӣ тамоман дигар мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดนตรีคือการแสดงออก แค่เล่นเครื่องดนตรีได้นิดหน่อยก็เปลี่ยนวิธีที่คุณสัมผัสดนตรีไปทั้งหมด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙዚቃ ከም መግለጺ። ኣብ መሳርሒ ሙዚቃ ዋላ ንእሽቶ ክእለት፣ ንሙዚቃ ዘለኩም ተመክሮ ምሉእ ብምሉእ ይቕይሮ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aýdym-saz — beýan ediş. Saz guralynda azajyk başarnyk hem aýdym-sazy duýşuňy düýpgöter üýtgedýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İfade biçimi olarak müzik. Bir enstrümanda mütevazı bir beceri bile müziği deneyimleme şeklini tamamen değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музика як самовираження. Навіть скромне вміння грати на інструменті повністю змінює те, як ти чуєш музику."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی بطور اظہار۔ کسی ساز پر معمولی سی مہارت بھی موسیقی کو محسوس کرنے کا انداز پوری طرح بدل دیتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiqa — ifoda vositasi. Cholgʻu asbobini oz-moz chala olish ham musiqani his qilishingizni butunlay oʻzgartiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm nhạc là cách thể hiện. Chơi một nhạc cụ dù chỉ ở mức khá thôi cũng thay đổi hoàn toàn cách bạn cảm nhận âm nhạc."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umculo njengendlela yokuzichaza. Nokuba sisakhono esincinci kwisixhobo somculo, sitshintsha ngokupheleleyo indlela owuva ngayo umculo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orin bí ọ̀nà ìfihàn ọkàn. Kódà ọgbọ́n díẹ̀ lórí ohun èlò orin ń yí bí ẹ ṣe ń gbádùn orin padà pátápátá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用音樂表達自己。即使只學會一點樂器，也會完全改變你感受音樂的方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用音乐表达自己。哪怕只会一点乐器，也会彻底改变你感受音乐的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用音樂表達自己。就算只學會一點點樂器，也會完全改變你感受音樂的方式。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umculo njengendlela yokuziveza. Ngisho nekhono elincane lokudlala ithuluzi lishintsha ngokuphelele indlela ozwa ngayo umculo."
          }
        }
      }
    },
    "Music is memory. Tell us what it is — or what period of life it reminds you of." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiek is herinnering. Vertel ons watter een dit is – of aan watter tyd in jou lewe dit jou laat dink."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙዚቃ ትዝታ ነው። ምን እንደሆነ ይንገሩን — ወይም የትኛውን የሕይወት ዘመን እንደሚያስታውስዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموسيقى ذاكرة. أخبرونا ما هي، أو بأي مرحلة من حياتكم تذكّركم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংগীত মানেই স্মৃতি। গীতটো কি কওক — বা ই আপোনাক জীৱনৰ কোন সময়ৰ কথা মনত পেলায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiqi xatirədir. Hansı mahnı olduğunu — ya da sənə həyatının hansı dövrünü xatırlatdığını bizə de."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — гэта памяць. Раскажы, што гэта за песня — ці які перыяд жыцця яна нагадвае."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музиката е памет. Кажи ни коя е – или за кой период от живота ти напомня."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গান মানেই স্মৃতি। গানটা কী, বলো — অথবা জীবনের কোন সময়ের কথা মনে করায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika je sjećanje. Reci nam koja je to pjesma – ili na koji te period života podsjeća."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música és memòria. Explica'ns quina és — o quina època de la teva vida et recorda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hudba je paměť. Napiš, která to je – nebo jaké období života ti připomíná."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerddoriaeth yw cof. Dywed wrthon ni beth yw hi — neu pa gyfnod o dy fywyd mae'n dy atgoffa ohono."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik er minder. Fortæl os, hvilken sang det er – eller hvilken periode af dit liv den minder dig om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik ist Erinnerung. Verrat uns, welcher Song es ist – oder an welche Lebensphase er dich erinnert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική είναι μνήμη. Πες μας ποιο είναι — ή ποια περίοδο της ζωής σου σού θυμίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música es memoria. Cuéntanos cuál es, o qué etapa de tu vida te recuerda."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muusika on mälu. Kirjuta, mis laul see on — või millist eluperioodi see meenutab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musika oroimena da. Kontatu zein den — edo bizitzako zein garai gogorarazten dizun."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی یعنی خاطره. بگو چه آهنگی است — یا تو را یاد کدام دورهٔ زندگی‌ات می‌اندازد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiikki on muistia. Kerro, mikä kappale se on – tai mitä elämänvaihetta se tuo mieleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alaala ang musika. Sabihin sa amin kung ano ito — o kung anong yugto ng buhay mo ang ipinapaalala nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique, c'est la mémoire. Dis-nous laquelle, ou à quelle période de ta vie elle te renvoie."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is cuimhne é an ceol. Inis dúinn cén t-amhrán é — nó cén tréimhse de do shaol a chuireann sé i gcuimhne duit."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A música é memoria. Cóntanos cal é, ou que etapa da vida che lembra."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંગીત એટલે યાદો. કહો કે એ કયું ગીત છે — કે એ તમને જીવનના કયા સમયગાળાની યાદ અપાવે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiɗa ƙwaƙwalwa ne. Ku faɗa mana wace waƙa ce — ko wane lokaci a rayuwa take tuna muku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוזיקה היא זיכרון. אפשר לספר לנו איזה שיר — או לאיזו תקופה בחיים הוא מחזיר אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत यादों से जुड़ा होता है। बताइए कौन-सा गाना है — या वह ज़िंदगी के किस दौर की याद दिलाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glazba je sjećanje. Reci nam koja je to – ili na koje te životno razdoblje podsjeća."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mizik se memwa. Di nou ki chante — oswa ki peryòd nan lavi ou li fè ou sonje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zene emlék. Mondd el, melyik az – vagy hogy melyik életszakaszodra emlékeztet."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երաժշտությունը հիշողություն է։ Պատմիր, թե որն է այն — կամ կյանքիդ որ շրջանն է հիշեցնում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik adalah kenangan. Ceritakan lagunya — atau masa dalam hidupmu yang teringat karenanya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egwu bụ ncheta. Gwa anyị ihe ọ bụ — ma ọ bụ oge ndụ ọ na-echetara gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tónlist er minning. Segðu okkur hvaða lag það er – eða hvaða tímabil það minnir þig á."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica è memoria. Raccontaci qual è — o quale periodo della vita ti ricorda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽は思い出そのもの。どんな曲か、または人生のどんな時期を思い出すか教えてください。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik iku kenangan. Critakna lagu apa — utawa mangsa urip apa sing dielingake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მუსიკა მეხსიერებაა. გვითხარი, რომელია — ან ცხოვრების რომელ პერიოდს გახსენებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — естелік. Ол қандай ән екенін не өміріңнің қай кезеңін еске түсіретінін айт."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "តន្ត្រីគឺជាអនុស្សាវរីយ៍។ ប្រាប់យើងថាវាជាចម្រៀងអ្វី — ឬវារំលឹកអ្នកពីដំណាក់កាលណាមួយនៃជីវិត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಗೀತವೇ ನೆನಪು. ಅದು ಯಾವುದು — ಅಥವಾ ಬದುಕಿನ ಯಾವ ಕಾಲವನ್ನು ನೆನಪಿಸುತ್ತದೆ ಎಂದು ಹೇಳಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악은 곧 추억이에요. 어떤 노래인지, 아니면 인생의 어느 시절이 떠오르는지 들려주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzîk bîranîn e. Ji me re bibêje kîjan stran e — an jî kîjan serdema jiyana te tîne bîra te."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — бул эскерүү. Кайсы ыр экенин айт — же ал жашооңдун кайсы мезгилин эске салат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musek ass Erënnerung. Sot eis, wat fir eent et ass — oder un wéi eng Zäit et dech erënnert."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເພງຄືຄວາມຊົງຈຳ ບອກແດ່ວ່າແມ່ນເພງຫຍັງ — ຫຼື ມັນເຮັດໃຫ້ນຶກເຖິງຊ່ວງໃດຂອງຊີວິດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika – tai atmintis. Papasakok, kokia tai daina – ar kokį gyvenimo laikotarpį ji primena."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mūzika ir atmiņa. Pastāsti, kas tā ir, – vai kādu dzīves posmu tā tev atgādina."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahatsiarovana ny mozika. Lazao izay hira izany — na ny vanim-potoana amin'ny fiainana ampahatsiahiviny anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He maharatanga te puoro. Kōrerotia mai he aha — he aha rānei te wā o tō ora e maumahara ai koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музиката е спомен. Кажи ни која е — или на кој период од животот те потсетува."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സംഗീതം ഓർമയാണ്. ആ പാട്ട് ഏതാണെന്ന് പറയൂ — അല്ലെങ്കിൽ ജീവിതത്തിലെ ഏത് കാലമാണ് അത് ഓർമിപ്പിക്കുന്നതെന്ന്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөгжим бол дурсамж. Аль дуу болохыг — эсвэл амьдралын аль үеийг санагдуулдгийг хэлээрэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत म्हणजे आठवण. ते कोणते गाणे आहे — किंवा आयुष्यातल्या कोणत्या काळाची आठवण करून देते, ते सांगा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzik ialah kenangan. Kongsikan lagunya — atau zaman dalam hidup yang diingatkannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mużika hija memorja. Għidilna liema hi — jew liema żmien ta' ħajtek tfakkrek fih."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂီတဆိုတာ အမှတ်တရပါ။ ဘယ်သီချင်းလဲ — ဒါမှမဟုတ် ဘဝရဲ့ ဘယ်ကာလကို သတိရစေလဲ ပြောပြပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikk er minner. Fortell hvilken sang det er – eller hvilken periode i livet den minner deg om."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत सम्झना हो। त्यो गीत कुन हो — वा त्यसले जीवनको कुन समय सम्झाउँछ, हामीलाई भन्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek is herinnering. Vertel welk nummer het is – of aan welke periode in je leven het je doet denken."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyimbo ndi zokumbukira. Tiuzeni kuti ndi iti — kapena nthawi ya moyo yomwe imakukumbutsani."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuziqaan yaadannoo dha. Maal akka ta'e — ykn yeroo jireenyaa kam akka si yaadachiisu nutti himi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଙ୍ଗୀତ ହିଁ ସ୍ମୃତି। ଗୀତଟି କ'ଣ କୁହନ୍ତୁ — ବା ଏହା ଜୀବନର କେଉଁ ସମୟକୁ ମନେ ପକାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੰਗੀਤ ਯਾਦਾਂ ਦਾ ਖ਼ਜ਼ਾਨਾ ਹੈ। ਦੱਸੋ ਕਿਹੜਾ ਗੀਤ ਹੈ — ਜਾਂ ਇਹ ਤੁਹਾਨੂੰ ਜ਼ਿੰਦਗੀ ਦੇ ਕਿਹੜੇ ਦੌਰ ਦੀ ਯਾਦ ਦਿਵਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka to pamięć. Napisz, co to za utwór – albo jaki okres życia ci przypomina."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقي خاطره ده. موږ ته ووایئ چې کومه ده — یا د ژوند کوم پړاو مو را یادوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música é memória. Conta pra gente qual é — ou de que fase da vida ela faz lembrar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A música é memória. Conta-nos qual é — ou que fase da vida te lembra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzica e memorie. Spune-ne care e — sau ce perioadă din viață îți amintește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка — это память. Расскажи, что это за песня или какой период жизни она напоминает."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuziki ni urwibutso. Tubwire iyo ari yo — cyangwa igihe cy'ubuzima ikwibutsa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සංගීතය කියන්නේ මතකයක්. ඒ මොකක්ද කියලා කියන්න — නැත්නම් ඒකෙන් ඔබට මතක් වෙන්නේ ජීවිතයේ මොන කාලයද කියලා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hudba je spomienka. Napíš, aká je to pesnička – alebo aké obdobie života ti pripomína."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasba je spomin. Povej, katera je – ali na katero obdobje življenja te spominja."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimhanzi ndangariro. Tiudze kuti ndorwupi — kana kuti runokuyeuchidza nguva ipi yeupenyu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muusiggu waa xusuus. Noo sheeg waa tee — ama xilliga nolosha ee ay ku xusuusiso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzika është kujtesë. Na trego cila është – ose çfarë periudhe të jetës të kujton."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музика је сећање. Реци која је то песма — или на који период живота те подсећа."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik téh kenangan. Wartosan lagu naon — atanapi mangsa hirup mana anu diémutkeunana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik är minnen. Berätta vilken låt det är – eller vilken period i livet den påminner dig om."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziki ni kumbukumbu. Tuambie ni wimbo gani — au unakukumbusha kipindi gani cha maisha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இசை என்பது நினைவு. அது எந்தப் பாடல் என்று சொல்லுங்கள் — அல்லது அது வாழ்க்கையின் எந்தக் காலகட்டத்தை நினைவூட்டுகிறது என்று சொல்லுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సంగీతమే జ్ఞాపకం. ఆ పాట ఏమిటో చెప్పండి — లేదా అది జీవితంలోని ఏ దశను గుర్తుచేస్తుందో."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мусиқӣ хотира аст. Бигӯ, он кадом суруд аст — ё кадом давраи зиндагиатро ба ёд меорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพลงคือความทรงจำ บอกเราหน่อยว่าเพลงอะไร หรือทำให้นึกถึงช่วงไหนของชีวิต"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙዚቃ ዝኽሪ እዩ። እንታይ ምዃኑ — ወይ ኣየናይ እዋን ህይወት ከም ዘዘኻኽረኩም — ንገሩና።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aýdym — ýatlama. Haýsy aýdymdygyny — ýa-da durmuşyňyň haýsy döwrüni ýatladýandygyny aýt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müzik demek anı demek. Hangi şarkı olduğunu ya da sana hayatının hangi dönemini hatırlattığını anlat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музика — це пам’ять. Розкажи, що це за пісня або який період життя вона нагадує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی یاد ہے۔ ہمیں بتائیں کہ وہ کون سا گانا ہے — یا زندگی کے کس دور کی یاد دلاتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiqa — bu xotira. Qaysi qoʻshiq ekanini — yoki u hayotingizning qaysi davrini eslatishini yozing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm nhạc là ký ức. Kể cho chúng mình nghe đó là bài gì — hoặc nó gợi nhớ giai đoạn nào trong đời bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umculo yinkumbulo. Sixelele ukuba yeyiphi — okanye ikukhumbuza eliphi ixesha lobomi bakho."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orin jẹ́ ìrántí. Ẹ sọ fún wa orin náà — tàbí àsìkò ayé tí ó ń rán yín létí."
          }
        },
        "zh-HK" : {
