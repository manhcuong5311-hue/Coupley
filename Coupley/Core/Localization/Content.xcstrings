    "Being chosen, consistently. Not just at the beginning — but every day after that too." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om aanhoudend gekies te word. Nie net aan die begin nie – maar elke dag daarna ook."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በቋሚነት መመረጥ። በመጀመሪያው ላይ ብቻ ሳይሆን — ከዚያ በኋላ በየቀኑም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن يقع عليك الاختيار دائمًا. ليس في البداية فقط، بل في كل يوم بعدها أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাৰে বাৰে বাছি লোৱা। কেৱল আৰম্ভণিতে নহয় — তাৰ পিছৰ প্ৰতিটো দিনতো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər dəfə seçilmək. Təkcə başlanğıcda yox — ondan sonrakı hər gün də."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб цябе выбіралі — увесь час. Не толькі на пачатку, але і кожны дзень пасля."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да те избират постоянно. Не само в началото – а всеки ден след това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিদিন বেছে নেওয়া হওয়া। শুধু শুরুতে নয় — তার পরের প্রতিটা দিনও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osjećaj da te neko bira, iznova. Ne samo na početku – nego i svaki dan poslije."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que et triïn, sempre. No només al principi — sinó també cada dia després."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vědět, že si tě ten druhý vybírá, pořád znovu. Nejen na začátku – ale i každý další den."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cael dy ddewis, yn gyson. Nid dim ond ar y dechrau — ond bob dydd wedi hynny hefyd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At blive valgt, igen og igen. Ikke kun i starten – men også hver eneste dag derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer wieder gewählt werden. Nicht nur am Anfang – sondern auch an jedem Tag danach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να σε επιλέγουν σταθερά. Όχι μόνο στην αρχή — αλλά και κάθε μέρα μετά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir que te eligen, siempre. No solo al principio — también cada día después."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olla järjekindlalt valitud. Mitte ainult alguses — vaid ka igal päeval pärast seda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratua izatea, etengabe. Ez hasieran bakarrik, baita ondorengo egun guztietan ere."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب شدن، همیشه. نه فقط در آغاز — بلکه هر روزِ بعد از آن هم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulla valituksi yhä uudelleen. Ei vain alussa – vaan joka ikinen päivä sen jälkeenkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mapili, palagi. Hindi lang sa simula — kundi araw-araw pagkatapos noon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que l'autre te choisisse, encore et encore. Pas seulement au début — mais chaque jour qui suit aussi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bheith roghnaithe, i gcónaí. Ní ag an tús amháin — ach gach lá ina dhiaidh sin freisin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que te escollan, sempre. Non só ao principio, senón tamén cada día despois."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હંમેશાં પસંદ થવું. ફક્ત શરૂઆતમાં નહીં — એ પછીના દરેક દિવસે પણ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zaɓe ku, akai-akai. Ba a farko kawai ba — har ma kowace rana bayan haka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיבחרו בך, שוב ושוב. לא רק בהתחלה — אלא גם כל יום אחרי זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बार चुना जाना। सिर्फ़ शुरुआत में नहीं — उसके बाद हर दिन भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osjećaj da te netko bira, iznova i iznova. Ne samo na početku – nego i svaki dan nakon toga."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo chwazi ou, toutan. Pa sèlman nan kòmansman — men chak jou apre sa tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy következetesen téged válasszanak. Nem csak az elején – hanem utána minden egyes nap."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լինել ընտրված՝ անընդհատ։ Ոչ միայն սկզբում, այլ նաև դրանից հետո ամեն օր։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih, terus-menerus. Bukan cuma di awal — tapi juga setiap hari setelahnya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka a na-ahọrọ gị mgbe niile. Ọ bụghị naanị na mmalite — kama kwa ụbọchị mgbe nke ahụ gasịrị."
