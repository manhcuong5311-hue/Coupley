      }
    },
    "Efficient. You don't need rituals to decompress — or you're usually exhausted enough not to need them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليّون. لا تحتاجون إلى طقوس للاسترخاء، أو أنكم عادةً منهكون بما يكفي للاستغناء عنها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektivita. K uvolnění nepotřebuješ rituály – nebo bývá únava tak velká, že je nepotřebuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektivt. Du har ikke brug for ritualer for at lande – eller også er du som regel træt nok til at kunne undvære dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effizient. Du brauchst keine Rituale zum Runterkommen – oder bist meist müde genug, dass es ohne geht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτελεσματικό. Δεν χρειάζεσαι τελετουργίες για να χαλαρώσεις — ή συνήθως η κούραση σε προλαβαίνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia pura. No necesitas rituales para desconectar… o normalmente terminas el día con tan poca energía que no te hacen falta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehokasta. Et tarvitse rituaaleja purkautumiseen – tai olet yleensä niin väsynyt, ettei niitä tarvita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episyente. Hindi mo kailangan ng ritwal para mag-relax — o kadalasan masyado ka nang pagod para kailanganin pa ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficace. Tu n'as pas besoin de rituels pour décompresser, ou alors la fatigue suffit généralement à t'endormir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יעילות. אין לך צורך בטקסים כדי להתפרק — או שבדרך כלל העייפות כל כך גדולה שאין בהם צורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमाल की सादगी। सुकून पाने के लिए आपको रस्मों की ज़रूरत नहीं — या आप अक्सर इतने थके होते हैं कि ज़रूरत ही नहीं पड़ती।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatékony. Nincs szükséged rituálékra a kikapcsoláshoz – vagy általában elég fáradt vagy hozzá, hogy ne kelljen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efisien. Kamu nggak butuh ritual untuk melepas penat — atau biasanya kamu sudah cukup capek sampai nggak perlu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficienza. Non ti servono rituali per staccare — o di solito la stanchezza basta e avanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "効率派です。リラックスのための儀式はいらないか、いつもそれが必要ないほど疲れているのかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효율적이에요. 긴장을 푸는 의식이 필요 없는 타입이거나, 보통 그런 게 필요 없을 만큼 지쳐 있는 걸 수도 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cekap. Anda tidak perlukan rutin untuk melepaskan penat — atau anda biasanya cukup letih sehingga tidak memerlukannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektiv. Du trenger ikke ritualer for å koble av – eller så er du som regel sliten nok til å klare deg uten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficiënt. Je hebt geen rituelen nodig om tot rust te komen – of je bent meestal moe genoeg om ze niet nodig te hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektywnie. Nie potrzebujesz rytuałów, by się wyciszyć – albo zwykle masz tak dość, że po prostu padasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiência. Você não precisa de rituais para desacelerar — ou normalmente o cansaço já resolve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiență. Nu ai nevoie de ritualuri ca să te relaxezi — sau, de obicei, oboseala e atât de mare încât nici nu-ți trebuie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффективно. Тебе не нужны ритуалы, чтобы расслабиться, — или к вечеру ты обычно слишком устаёшь, чтобы в них нуждаться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektivt. Du behöver inga ritualer för att varva ner – eller så är du oftast så trött att du inte behöver dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีประสิทธิภาพ คุณไม่ต้องมีพิธีกรรมเพื่อผ่อนคลาย หรือไม่ก็เหนื่อยจนไม่ต้องใช้มันอยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratiksin. Gevşemek için ritüellere ihtiyacın yok ya da genelde onlara gerek kalmayacak kadar yorgun oluyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ефективно. Тобі не потрібні ритуали, щоб розслабитися, — або зазвичай ти настільки втомлюєшся, що вони й не потрібні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gọn lẹ. Bạn không cần nghi thức để thả lỏng — hoặc thường đã đủ mệt để chẳng cần đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高效。你不需要仪式来放松——或者通常已经累到不需要了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有效率。你不需要儀式來放鬆，或是你通常累到根本不需要。"
          }
        }
      }
    },
    "Effort should go both ways. When it feels one-sided, you start questioning where you stand." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجهد يجب أن يكون متبادلًا. حين يبدو من طرف واحد، تبدؤون بالتساؤل عن مكانتكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snaha by měla jít oběma směry. Když je jednostranná, začneš si klást otázku, kde vlastně stojíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsatsen skal gå begge veje. Når den føles ensidig, begynder du at tvivle på, hvor du står."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einsatz sollte von beiden kommen. Wenn es sich einseitig anfühlt, fragst du dich, wo du eigentlich stehst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσπάθεια πρέπει να είναι αμοιβαία. Όταν μοιάζει μονόπλευρη, αρχίζεις να αναρωτιέσαι τι θέση έχεις στη σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo debería ir en las dos direcciones. Cuando parece que va en una sola, empiezas a preguntarte qué lugar ocupas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaivannäön pitäisi kulkea molempiin suuntiin. Kun se tuntuu yksipuoliselta, alat miettiä, missä asemassa olet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat galing sa dalawang panig ang effort. Kapag parang isang panig lang, napapaisip ka kung ano ba talaga ang lugar mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les efforts doivent venir des deux côtés. Quand ça semble à sens unique, tu commences à te demander quelle place tu occupes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאמץ צריך לבוא משני הכיוונים. כשזה מרגיש חד־צדדי, מתחילות לעלות אצלך שאלות לגבי המקום שלך בקשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोशिश दोनों तरफ़ से होनी चाहिए। जब यह एकतरफ़ा लगे, तो आप सोचने लगते हैं कि रिश्ते में आप कहाँ हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az erőfeszítésnek kölcsönösnek kell lennie. Ha egyoldalúnak érzed, elkezded kérdezni magadtól, hol is állsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha harus datang dari dua arah. Saat terasa sepihak, kamu mulai mempertanyakan posisimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impegno deve venire da entrambe le parti. Quando sembra a senso unico, cominci a chiederti a che punto siete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力はお互いさまであってほしいタイプです。一方通行だと感じると、自分の立ち位置がわからなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노력은 양쪽에서 해야 해요. 한쪽으로 기운 느낌이 들면 내가 연인에게 어떤 존재인지 의문이 들기 시작하죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha sepatutnya datang dari kedua-dua pihak. Apabila ia terasa berat sebelah, anda mula tertanya-tanya di mana kedudukan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innsats skal gå begge veier. Når det føles ensidig, begynner du å lure på hvor du står."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moeite moet van twee kanten komen. Als het eenzijdig voelt, ga je twijfelen waar je staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starania powinny być obustronne. Gdy tak nie jest, zaczynasz się zastanawiać, na czym stoisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esforço tem que vir dos dois lados. Quando parece unilateral, você começa a questionar seu lugar na relação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efortul ar trebui să vină din ambele părți. Când pare unilateral, începi să te întrebi ce loc ai în relație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усилия должны быть взаимными. Когда всё в одни ворота, ты начинаешь сомневаться, какое место занимаешь в этих отношениях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansträngningen ska gå åt båda hållen. När det känns ensidigt börjar du undra var du står."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความพยายามควรมาจากทั้งสองฝ่าย เมื่อรู้สึกว่ามีแต่ฝ่ายเดียว คุณจะเริ่มสงสัยว่าตัวเองอยู่ตรงไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emek iki taraflı olmalı. Tek taraflı hissettiğinde nerede durduğunu sorgulamaya başlıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зусилля мають бути взаємними. Коли все однобічно, ти починаєш сумніватися, яке місце займаєш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nỗ lực phải đến từ cả hai phía. Khi thấy chỉ một bên cố gắng, bạn bắt đầu tự hỏi mình đang ở đâu trong lòng người ấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付出应该是双向的。当感觉一头热时，你会开始怀疑自己在对方心里的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付出應該是雙向的。一旦感覺只有自己在努力，你就會開始懷疑自己在對方心中的位置。"
          }
        }
      }
    },
    "Eight weeks. Eight nights that are just for you two." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثمانية أسابيع. ثماني أمسيات لكما وحدكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osm týdnů. Osm večerů jen pro vás dva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otte uger. Otte aftener kun for jer to."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acht Wochen. Acht Abende nur für euch zwei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οκτώ εβδομάδες. Οκτώ βράδια μόνο για τους δυο σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocho semanas. Ocho noches solo para los dos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahdeksan viikkoa. Kahdeksan iltaa vain teille kahdelle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walong linggo. Walong gabing para lang sa inyong dalawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huit semaines. Huit soirées rien que pour vous deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמונה שבועות. שמונה ערבים רק לשניכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आठ हफ़्ते। आठ शामें, सिर्फ़ आप दोनों के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyolc hét. Nyolc este, ami csak a tiétek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delapan minggu. Delapan malam khusus untuk kalian berdua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otto settimane. Otto serate solo per voi due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8週間。ふたりだけのための8つの夜。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8주 동안, 두 사람만을 위한 8번의 밤."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lapan minggu. Lapan malam khas untuk anda berdua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtte uker. Åtte kvelder bare for dere to."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acht weken. Acht avonden alleen voor jullie twee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiem tygodni. Osiem wieczorów tylko dla was dwojga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oito semanas. Oito noites só de vocês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opt săptămâni. Opt seri doar pentru voi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восемь недель. Восемь вечеров только для вас двоих."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtta veckor. Åtta kvällar bara för er två."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปดสัปดาห์ แปดค่ำคืนที่เป็นของคุณทั้งสองเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekiz hafta. Sadece ikinize ait sekiz akşam."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вісім тижнів. Вісім вечорів лише для вас двох."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tám tuần. Tám buổi tối chỉ dành riêng cho hai bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "八周，八个只属于你们俩的夜晚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "八個星期，八個只屬於你們兩人的夜晚。"
          }
        }
      }
    },
