        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuch tugaganda: yengillik > tasalli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đã cạn năng lượng, được nhẹ gánh quý hơn lời trấn an."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xa amandla ephelile, ukukhululeka > ukuqinisekisa."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nígbà tí agbára bá tán, ìrọ̀rùn ju ìdánilójú lọ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當能量耗盡，減輕負擔比安慰更有用。"
