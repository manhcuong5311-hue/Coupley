        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qaphela into eyodwa encane ngaye namuhla bese uyisho."
          }
        }
      }
    },
    "Novelty is exciting to you even in dining. You enjoy the discovery — and you probably eat more adventurously too." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuwigheid is vir jou opwindend, selfs as dit by eet kom. Jy geniet die ontdekking – en jy eet waarskynlik ook meer avontuurlustig."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በምግብ ረገድም አዲስነት ያስደስትዎታል። ማግኘትን ይወዳሉ — በምግብ ምርጫም ደፋር ሳይሆኑ አይቀሩም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجديد يثير حماسك حتى في الطعام. متعة الاكتشاف جزء من السهرة عندك، وذوقك في الأكل غالبًا جريء أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খোৱাৰ ক্ষেত্ৰতো নতুনত্বই আপোনাক উৎসাহিত কৰে। আপুনি আৱিষ্কাৰ উপভোগ কৰে — আৰু হয়তো সাহসেৰে নতুন খাদ্যও খায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemək məsələsində belə yenilik səni həyəcanlandırır. Kəşf etməkdən zövq alırsan — yəqin ki, yeməkdə də cəsarətlisən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навізна захапляе цябе нават у ежы. Табе падабаецца адкрываць новае — і, напэўна, у ежы ты таксама смела эксперыментуеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новото те вълнува дори в храната. Радваш се на откритията – и вероятно опитваш по-смели ястия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খাওয়াদাওয়াতেও নতুনত্ব তোমাকে উত্তেজিত করে। তুমি খুঁজে পাওয়ার আনন্দ উপভোগ করো — আর খাবারের ব্যাপারেও হয়তো বেশ সাহসী।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novine te uzbuđuju čak i za stolom. Uživaš u otkrivanju – a vjerovatno i hranu biraš avanturistički."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novetat t'il·lusiona fins i tot a l'hora de menjar. Gaudeixes descobrint — i segurament també menges de manera més aventurera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinky tě lákají i u jídla. Baví tě objevovat – a nejspíš jíš i odvážněji."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae pethau newydd yn gyffrous i ti, hyd yn oed wrth fwyta allan. Rwyt ti'n mwynhau darganfod — ac mae'n siŵr dy fod yn fwy mentrus wrth fwyta hefyd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye frister dig, også når du spiser ude. Du nyder opdagelsen – og du er nok også mere eventyrlysten med maden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues reizt dich, sogar beim Essen. Du liebst das Entdecken – und isst wahrscheinlich auch experimentierfreudiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καινούριο σε ενθουσιάζει ακόμα και στο φαγητό. Απολαμβάνεις την ανακάλυψη — και μάλλον τρως και πιο τολμηρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novedad te emociona incluso a la hora de comer. Disfrutas descubriendo — y seguramente también te atreves con platos más arriesgados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudsus erutab sind isegi söögikohtades. Naudid avastamist — ja sööd ilmselt ka julgemalt."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berritasunak zirraragarria izaten jarraitzen du zuretzat, baita jatean ere. Aurkitzeaz gozatzen duzu — eta ziur asko ausartago jaten duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تازگی حتی در غذا خوردن هم هیجان‌زده‌ات می‌کند. از کشف کردن لذت می‌بری — و احتمالاً در غذا هم ماجراجوتری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutuus innostaa sinua jopa ruoassa. Nautit löytämisen ilosta – ja syöt todennäköisesti muutenkin rohkeammin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit sa pagkain, nakaka-excite sa’yo ang bago. Gusto mo ang pagtuklas — at malamang mas adventurous ka rin kumain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouveauté t'attire, même à table. Tu aimes découvrir, et tu goûtes sûrement plus volontiers à l'inconnu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuireann an nuacht sceitimíní ort, fiú agus tú ag ithe amuigh. Is breá leat an fhionnachtain — agus is dócha go mbíonn tú níos dána le bia freisin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A novidade emociónate ata á hora de comer fóra. Gozas descubrindo, e seguramente tamén te atreves con máis pratos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ભોજનમાં પણ નવીનતા તમને રોમાંચ આપે છે. તમને નવું શોધવાની મજા આવે છે — અને કદાચ ખાવામાં પણ તમે વધુ સાહસિક છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabon abu na burge ku har ma a cin abinci. Kuna jin daɗin ganowa — kuma wataƙila kuna gwada abinci iri-iri fiye da wasu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חידוש מרגש אותך, גם כשזה מגיע לאוכל. הגילוי הוא חלק מהכיף — וכנראה שגם בצלחת יש לך נטייה להרפתקאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाने में भी नयापन आपको रोमांचित करता है। नई चीज़ें खोजने में आपको मज़ा आता है — और शायद नए स्वाद आज़माने का शौक़ भी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novo te uzbuđuje čak i kad je riječ o jelu. Uživaš u otkrivanju – a vjerojatno i jedeš avanturističkije."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvote eksite ou menm nan manje. Ou renmen dekouvri — e ou pwobableman pi avantirye nan sa ou manje tou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téged még az étkezésben is az újdonság lelkesít. Élvezed a felfedezést – és valószínűleg bátrabban is kóstolsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նորությունը քեզ ոգևորում է նույնիսկ ուտելիքի հարցում։ Սիրում ես բացահայտումները — և հավանաբար ավելի համարձակ ես նաև ճաշացանկում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal baru selalu seru buatmu, bahkan soal makan. Kamu suka sensasi menemukan sesuatu — dan mungkin kamu juga lebih berani mencoba makanan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe ọhụrụ na-akpali gị ọbụlagodi n'iri nri. Ịchọpụta ihe na-atọ gị ụtọ — o nwekwara ike ịbụ na ị na-anwale nri dị iche iche karịa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nýjungar heilla þig, líka þegar kemur að mat. Þú nýtur þess að uppgötva – og ert líklega ævintýragjarnari í matarvali líka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novità ti entusiasma anche a tavola. Ami scoprire — e probabilmente mangi in modo più avventuroso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事にも新しさとワクワクを求めるタイプです。発見そのものを楽しめるので、きっと食べ物にも冒険心があるはず。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bab anyar nyenengake kanggo panjenengan, senajan bab panganan. Panjenengan seneng nemokake — lan mbokmenawa uga wani njajal panganan sing aneh-aneh."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიახლე ჭამაშიც კი გიტაცებს. აღმოჩენით ტკბები — და, ალბათ, ახალ გემოებსაც გაბედულად სცდი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тамақтануда да жаңалық сені қызықтырады. Жаңалық ашқанды ұнатасың — әрі тағам таңдауда да батыл шығарсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពថ្មីថ្មោងធ្វើឲ្យអ្នករំភើប សូម្បីតែពេលញ៉ាំអាហារ។ អ្នកចូលចិត្តការរកឃើញថ្មី — ហើយអ្នកប្រហែលជាហ៊ានសាកម្ហូបចម្លែកៗដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಊಟದಲ್ಲೂ ಹೊಸತನ ನಿಮಗೆ ರೋಮಾಂಚನ. ಹೊಸದನ್ನು ಕಂಡುಕೊಳ್ಳುವುದು ನಿಮಗಿಷ್ಟ — ತಿನ್ನುವುದರಲ್ಲೂ ನೀವು ಹೆಚ್ಚು ಸಾಹಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사에서도 새로움이 설레는 타입이에요. 발견하는 즐거움을 좋아하고, 음식도 아마 과감하게 도전하는 편일 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nûbûn heta di xwarinê de jî ji te re heyecan e. Tu kêfê ji keşfê dikî — û belkî tu bi wêrektir jî dixwî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тамакта да жаңылык сени кызыктырат. Ачылыштан ырахат аласың — тамакты да тайманбай сынап көрсөң керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neies begeeschtert dech och beim Iessen. Du entdecks gär — an du ëss wuel och méi experimentéierfreedeg."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມແປກໃໝ່ເຮັດໃຫ້ເຈົ້າຕື່ນເຕັ້ນ ແມ່ນແຕ່ເລື່ອງກິນ ເຈົ້າມ່ວນກັບການຄົ້ນພົບ — ແລະ ເຈົ້າຄົງກ້າລອງອາຫານແປກໆນຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naujovės tave žavi net renkantis, kur pavalgyti. Mėgsti atradimus – ir tikriausiai drąsiau ragauji."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunums tevi aizrauj pat ēdienā. Tev patīk atklāt – un droši vien arī ēdienus tu izvēlies drosmīgāk."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mampientanentana anao ny zava-baovao na dia amin'ny sakafo aza. Tianao ny fahitana zava-baovao — ary azo inoana fa sahy manandrana sakafo hafahafa koa ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He whakaohooho te hou ki a koe, ahakoa i te kai. He pai ki a koe te kitenga hou — ā, tērā pea he māia ake tō kai hoki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новото те возбудува дури и кога станува збор за храна. Уживаш во откривањето — и веројатно јадеш поавантуристички."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഭക്ഷണത്തിൽപ്പോലും പുതുമ നിങ്ങൾക്ക് ആവേശമാണ്. കണ്ടെത്തൽ നിങ്ങൾ ആസ്വദിക്കുന്നു — ഭക്ഷണത്തിലും നിങ്ങൾ കൂടുതൽ സാഹസികരായിരിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоолонд ч гэсэн шинэлэг зүйл чамайг догдлуулдаг. Чи нээлт хийх дуртай — магадгүй хоолны хувьд ч илүү зоримог байдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेवणातही नावीन्य तुम्हाला उत्साहित करते. नवे शोधण्यात तुम्हाला मजा येते — आणि खाण्याच्या बाबतीतही तुम्ही बहुधा धाडसी असाल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benda baharu mengujakan anda, walaupun soal makan. Anda suka meneroka — dan mungkin lebih berani mencuba makanan juga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ġdid jeċċitak anke fl-ikel. Tgawdi l-iskoperta — u probabbli tiekol b'aktar kuraġġ ukoll."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စားသောက်ရာမှာတောင် အသစ်အဆန်းက သင့်ကို စိတ်လှုပ်ရှားစေတယ်။ ရှာဖွေတွေ့ရှိရတာကို ပျော်တယ် — အစားအသောက်မှာလည်း ပိုစွန့်စားရဲမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye ting frister deg, også når du skal spise ute. Du elsker å oppdage – og er nok litt mer eventyrlysten på menyen også."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खानामा पनि नयाँपनले तपाईंलाई रोमाञ्चित बनाउँछ। तपाईं खोजीमा रमाउनुहुन्छ — र खानामा पनि अलि साहसी हुनुहुन्छ होला।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwigheid maakt je blij, zelfs als het om eten gaat. Je geniet van het ontdekken – en je eet vast ook avontuurlijker."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinthu zatsopano zimakusangalatsani ngakhale pa chakudya. Mumasangalala kupeza zatsopano — ndipo mwina mumalimba mtima kulawa zakudya zachilendo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haaraan nyaata keessattillee si gammachiisa. Waan haaraa argachuu ni jaallatta — nyaata adda addaas ni yaalta ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଖାଇବାରେ ବି ନୂଆପଣ ଆପଣଙ୍କୁ ଉତ୍ସାହିତ କରେ। ଆପଣ ନୂଆ ଖୋଜିବା ଉପଭୋଗ କରନ୍ତି — ଆଉ ବୋଧହୁଏ ନୂଆ ନୂଆ ଖାଦ୍ୟ ଚାଖିବାକୁ ବି ପଛାନ୍ତି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਨੂੰ ਖਾਣੇ ਵਿੱਚ ਵੀ ਨਵਾਂਪਣ ਰੋਮਾਂਚਕ ਲੱਗਦਾ ਹੈ। ਤੁਸੀਂ ਖੋਜ ਦਾ ਮਜ਼ਾ ਲੈਂਦੇ ਹੋ — ਅਤੇ ਸ਼ਾਇਦ ਨਵੇਂ-ਨਵੇਂ ਸੁਆਦ ਚੱਖਣ ਤੋਂ ਵੀ ਨਹੀਂ ਝਿਜਕਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowości ekscytują cię nawet przy stole. Lubisz odkrywać – i pewnie jesz też odważniej niż inni."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوښت تاسو ته حتی د خوړو په برخه کې هم په زړه پورې دی. تاسو له موندنې خوند اخلئ — او ښايي نوي خواړه هم په زړورتیا ازمویئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até na hora de comer, a novidade te empolga. Você curte descobrir — e provavelmente topa pratos mais ousados também."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A novidade entusiasma-te, até à mesa. Gostas da descoberta — e provavelmente também arriscas mais no que comes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noutatea te entuziasmează chiar și la masă. Îți place să descoperi — și probabil mănânci și mai aventuros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна волнует тебя даже в еде. Тебе нравится открывать новое — и, скорее всего, в выборе блюд ты тоже смелее других."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibishya biragushimisha no mu by'ibiryo. Wishimira kuvumbura — kandi birashoboka ko utinyuka kurya ibintu bishya."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කෑම ගැන වුණත් අලුත් දේවල් ඔබට උද්වේගකරයි. සොයාගැනීම ඔබ විඳිනවා — ඔබ කන දේවල් ගැනත් වික්‍රමාන්විත ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinky ťa lákajú aj pri jedle. Baví ťa objavovať – a asi aj ješ odvážnejšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novosti te navdušujejo tudi pri hrani. Uživaš v odkrivanju – in verjetno si tudi pri jedeh bolj pustolovske sorte."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvinhu zvitsva zvinokufadza kunyange pakudya. Unofarira kuwana zvitsva — uye pamwe unoedza zvikafu zvakasiyana-siyana zvakare."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cusubnaantu way kuu xiisaha badan tahay xitaa cuntada. Waxaad ku raaxaysataa helitaanka — waxayna u badan tahay inaad cunto cusub isku daydo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risia të emocionon edhe kur bëhet fjalë për ushqim. Të pëlqen zbulimi – dhe ndoshta provon edhe pjata më të guximshme."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новине те узбуђују чак и кад је реч о ресторанима. Уживаш у откривању — а вероватно и храбрије бираш шта ћеш јести."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal énggal matak gumbira pikeun anjeun, sanajan dina tuang. Anjeun resep mendakan hal énggal — sareng anjeun sigana langkung wani nyobian kadaharan ogé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lockas av det nya, även när det gäller mat. Du älskar att upptäcka – och du är nog lite modigare än de flesta när du beställer."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mambo mapya yanakusisimua hata katika kula. Unafurahia kugundua — na huenda unakula vyakula vya aina nyingi zaidi pia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாப்பாட்டில் கூட புதுமை உங்களுக்கு உற்சாகம் தருகிறது. கண்டுபிடிப்பதை ரசிக்கிறீர்கள் — சாப்பிடுவதிலும் துணிச்சலானவர் போலும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "భోజనంలో కూడా కొత్తదనం మీకు ఉత్సాహం. కనుగొనడాన్ని మీరు ఆస్వాదిస్తారు — తినడంలో కూడా బహుశా సాహసంగానే ఉంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навгонӣ ҳатто дар таом туро ба ваҷд меорад. Ту аз кашф лаззат мебарӣ — ва эҳтимол дар хӯрок ҳам ҷасуртар ҳастӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความแปลกใหม่ทำให้คุณตื่นเต้น แม้แต่เรื่องกิน คุณสนุกกับการค้นพบ และน่าจะกล้าลองอาหารแปลกๆ มากกว่าคนอื่นด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሓድሽ ነገር ኣብ መግቢ እውን የበራብረኩም። ምርካብ ሓድሽ ነገር የሐጉሰኩም — ብዙሕ ዓይነት መግቢ ድማ ትፍትኑ ትኾኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täzelik seni hatda nahar saýlanyňda-da joşdurýar. Sen açyş etmekden lezzet alýarsyň — tagamlarda hem has batyrgaý bolsaň gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemekte bile yenilik seni heyecanlandırıyor. Keşfetmenin tadını çıkarıyorsun ve muhtemelen yemek konusunda da maceracısın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе захоплює новизна навіть у виборі ресторанів. Тобі до вподоби відкриття — і в їжі ти, мабуть, теж любиш експерименти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھانے میں بھی نیا پن آپ کو پرجوش کرتا ہے۔ آپ کو دریافت کا مزہ آتا ہے — اور شاید کھانے میں بھی آپ کا ذوق کافی مہم جو ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatto taomda ham yangilik sizni hayajonlantiradi. Kashf etishdan zavq olasiz — ehtimol, taomlarni ham dadilroq tanlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngay cả chuyện ăn uống, cái mới cũng khiến bạn hào hứng. Bạn mê cảm giác khám phá — và chắc cũng ăn uống phiêu lưu hơn người khác."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinto ezintsha ziyakuvuyisa nasekutyeni. Uyonwabela ukufumanisa — kwaye mhlawumbi uyakuzama ukutya okwahlukileyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohun tuntun ń mórí yín wú, kódà nínú oúnjẹ. Ẹ gbádùn àwárí — ó sì ṣeé ṣe kí ẹ máa tọ́ oúnjẹ àjèjì wò láìbẹ̀rù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就連吃飯，新鮮感也讓你興奮。你享受發掘的樂趣，口味大概也比較敢於嘗試。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连吃饭你都喜欢新鲜感。你享受发现的过程，口味大概也更敢尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連吃飯你都喜歡新鮮感。你享受探索的過程，口味大概也比較敢嘗試。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinto ezintsha ziyakujabulisa ngisho nasekudleni. Uthokozela ukuthola okusha — futhi kungenzeka uyazama nokudla okungajwayelekile."
          }
        }
      }
    },
    "Novelty is the fuel. New experiences together keep you from going stale. You need to keep exploring as a couple." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuwigheid is die brandstof. Nuwe ervarings saam keer dat dinge oud raak. Julle moet as paartjie aanhou verken."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አዲስነት ማገዶው ነው። አብሮ አዳዲስ ልምዶች እንዳትሰለቹ ያደርጋል። እንደ ጥንዶች ማሰስዎን መቀጠል ያስፈልግዎታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجديد هو الوقود. التجارب الجديدة معًا تحميكما من الرتابة، وتحتاجان إلى مواصلة الاستكشاف كثنائي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুনত্বই ইন্ধন। একেলগে নতুন অভিজ্ঞতাই আপোনালোকক একঘেয়ে হ'বলৈ নিদিয়ে। যুগল হিচাপে আপোনালোকে অন্বেষণ কৰি থাকিব লাগে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilik yanacaqdır. Birlikdə yaşanan yeni təcrübələr münasibəti köhnəlməyə qoymur. Cütlük olaraq kəşf etməyə davam etməlisiniz."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навізна — паліва. Новыя ўражанні разам не даюць вам засумаваць. Вам як пары трэба працягваць адкрываць свет."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новото е горивото. Новите общи преживявания не ви позволяват да залинеете. Трябва да продължавате да откривате света като двойка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুনত্বই জ্বালানি। একসাথে নতুন অভিজ্ঞতা তোমাদের একঘেয়ে হতে দেয় না। জুটি হিসেবে তোমাদের খুঁজে দেখা চালিয়ে যেতে হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novine su gorivo. Nova zajednička iskustva čuvaju vas od ustajalosti. Trebate nastaviti istraživati kao par."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novetat és el combustible. Les experiències noves junts eviten que us estanqueu. Necessiteu continuar explorant com a parella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palivem jsou novinky. Nové společné zážitky vám nedovolí zevšednět. Jako pár potřebujete pořád objevovat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Newydd-deb yw'r tanwydd. Mae profiadau newydd gyda'ch gilydd yn eich cadw rhag mynd yn hen. Mae angen i chi ddal ati i ddarganfod fel cwpl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye er brændstoffet. Nye oplevelser sammen forhindrer, at det bliver kedeligt. I skal blive ved med at udforske som par."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues ist der Treibstoff. Gemeinsame neue Erlebnisse schützen euch vor dem Alltagstrott. Als Paar solltet ihr immer weiter auf Entdeckungstour gehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καινούργιο είναι το καύσιμο. Οι νέες εμπειρίες μαζί δεν σας αφήνουν να μπαγιατέψετε. Χρειάζεται να εξερευνάτε συνέχεια ως ζευγάρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novedad es el combustible. Vivir experiencias nuevas juntos evita que la relación se estanque. Necesitas seguir explorando en pareja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudsus on kütus. Ühised uued kogemused ei lase teil rutiini kinni jääda. Te peate paarina edasi avastama."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berritasuna da erregaia. Elkarrekin bizitako esperientzia berriek ez dizuete aspertzen uzten. Bikote gisa esploratzen jarraitu behar duzue."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تازگی سوخت است. تجربه‌های تازه با هم نمی‌گذارند رابطه کهنه شود. باید به‌عنوان زوج به کشف کردن ادامه دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutuus on polttoaine. Yhteiset uudet kokemukset estävät teitä urautumasta. Teidän pitää jatkaa uuden löytämistä yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bago ang gasolina. Pinipigilan kayo ng mga bagong karanasan na maging matabang. Kailangan ninyong patuloy na mag-explore bilang magkapareha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouveauté, c'est le carburant. Les expériences inédites à deux vous évitent de tomber dans la routine. Vous avez besoin de continuer à explorer en couple."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is í an nuacht an breosla. Coinníonn eispéiris nua le chéile úr sibh. Caithfidh sibh leanúint ag fiosrú mar lánúin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A novidade é o combustible. As experiencias novas xuntos evitan que caiades na rutina. Precisades seguir explorando como parella."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નવીનતા જ બળતણ છે. સાથેના નવા અનુભવો તમને વાસી થવા દેતા નથી. કપલ તરીકે તમારે નવું શોધતા રહેવું જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabon abu shi ne mai. Sababbin abubuwan da kuke yi tare na hana ku gundura. Kuna buƙatar ci gaba da bincike a matsayin masoya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החידוש הוא הדלק. חוויות חדשות ביחד שומרות עליכם רעננים. חשוב לך להמשיך לגלות ביחד כזוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नयापन ही ईंधन है। साथ में नए अनुभव रिश्ते को बासी होने से बचाते हैं। एक जोड़े के तौर पर आपको खोजते रहना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novo je gorivo. Nova zajednička iskustva čuvaju vas od ustajalosti. Kao par trebate stalno istraživati."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvote se gaz la. Nouvo eksperyans ansanm anpeche relasyon an vin plat. Ou bezwen kontinye dekouvri antanke koup."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újdonság az üzemanyag. A közös új élmények nem hagyják, hogy belefásuljatok. Szükségetek van rá, hogy párként folyamatosan új dolgokat fedezzetek fel."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նորությունն է վառելիքը։ Միասին նոր տպավորությունները թույլ չեն տալիս ձանձրանալ։ Քեզ պետք է որպես զույգ շարունակել բացահայտել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal baru adalah bahan bakarnya. Pengalaman baru bersama menjaga hubungan kalian tetap segar. Kalian perlu terus menjelajah sebagai pasangan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe ọhụrụ bụ mmanụ ọkụ ahụ. Ahụmahụ ọhụrụ ọnụ na-egbochi unu ịda mbà. Ị chọrọ ka unu abụọ na-achọpụta ihe ọhụrụ mgbe niile."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nýjungar eru eldsneytið. Nýjar upplifanir saman koma í veg fyrir að allt verði staðnað. Þið þurfið að halda áfram að kanna heiminn sem par."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novità è il carburante. Le esperienze nuove insieme vi impediscono di cadere nella monotonia. Avete bisogno di continuare a esplorare come coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しさが燃料です。ふたりでの新しい体験が、マンネリを防いでくれます。ふたりで新しいことを探し続けたいタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bab anyar iku bahan bakare. Pengalaman anyar bareng nggawe sesambungan ora mbosenake. Panjenengan sakloron butuh terus nglencer bareng."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიახლეა საწვავი. ერთად ახალი შთაბეჭდილებები ურთიერთობას ახალს უნარჩუნებს. წყვილად გამუდმებით აღმოჩენები გჭირდებათ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаңалық — отын. Бірге алған жаңа әсерлер жұпты жалықтырмайды. Жұп ретінде әрдайым жаңаны ашып жүруің керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពថ្មីថ្មោងគឺជាឥន្ធនៈ។ បទពិសោធន៍ថ្មីៗជាមួយគ្នា ការពារកុំឲ្យស្នេហាធុញទ្រាន់។ អ្នកត្រូវការបន្តរុករកជាគូ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೊಸತನವೇ ಇಂಧನ. ಜೊತೆಯ ಹೊಸ ಅನುಭವಗಳು ನಿಮ್ಮನ್ನು ಬೇಸರದಿಂದ ಕಾಪಾಡುತ್ತವೆ. ಜೋಡಿಯಾಗಿ ನೀವು ಹೊಸದನ್ನು ಹುಡುಕುತ್ತಲೇ ಇರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로움이 연료예요. 함께하는 새로운 경험이 관계를 지루하지 않게 해 줘요. 커플로서 계속 탐험해야 하는 타입이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nûbûn sotemenî ye. Ezmûnên nû yên bi hev re nahêlin hûn bêrû bibin. Divê hûn wekî cot keşfê bidomînin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаңылык — отун. Бирге жаңы тажрыйбалар сени көнүмүштөн сактайт. Жуп болуп изилдей беришиңер керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neies ass de Brennstoff. Nei Erliefnesser zesumme verhënneren, datt et fad gëtt. Dir musst als Koppel weider entdecken."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມແປກໃໝ່ຄືເຊື້ອໄຟ ປະສົບການໃໝ່ໆນຳກັນຊ່ວຍບໍ່ໃຫ້ຄວາມສຳພັນຈືດຊືດ ເຈົ້າຕ້ອງສືບຕໍ່ສຳຫຼວດໂລກນຳກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naujovės – kuras. Naujos bendros patirtys neleidžia jums nuobodžiauti. Jums kaip porai reikia nuolat atrasti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunais ir degviela. Kopīgi jauni piedzīvojumi neļauj jums iesūnot. Jums kā pārim jāturpina atklāt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny zava-baovao no solika. Ny traikefa vaovao iarahana no misakana anareo tsy ho lasa mahasorena. Mila manohy mikaroka miaraka ianareo."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te hou te wahie. Mā ngā wheako hou tahi e kore ai kōrua e mātao. Me hōpara tonu kōrua hei tokorua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новото е горивото. Новите заеднички доживувања не ви дозволуваат да се заситите. Треба да продолжите да истражувате како двојка."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പുതുമയാണ് ഇന്ധനം. ഒരുമിച്ചുള്ള പുതിയ അനുഭവങ്ങൾ നിങ്ങളെ മടുപ്പിൽനിന്ന് കാക്കുന്നു. ജോഡിയായി നിങ്ങൾ എന്നും പുതിയത് തേടിക്കൊണ്ടിരിക്കണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шинэлэг байдал бол түлш. Хамтын шинэ туршлага та хоёрыг уйдахаас сэргийлдэг. Чамд хосоороо үргэлж шинийг нээх хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नावीन्य हेच इंधन. एकत्र घेतलेले नवे अनुभव नात्याला शिळे होऊ देत नाहीत. जोडपे म्हणून तुम्हाला सतत नवे शोधत राहायला हवे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkara baharu ialah bahan bakarnya. Pengalaman baharu bersama menghalang hubungan anda daripada jadi hambar. Anda perlu terus meneroka sebagai pasangan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ġdid huwa l-fjuwil. Esperjenzi ġodda flimkien ma jħallukomx tistaġnaw. Għandkom bżonn tibqgħu tesploraw bħala koppja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အသစ်အဆန်းက လောင်စာပါ။ အတူ အတွေ့အကြုံသစ်တွေက ငြီးငွေ့မသွားအောင် ထိန်းပေးတယ်။ စုံတွဲအနေနဲ့ ဆက်ပြီး စူးစမ်းနေဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye er drivstoffet. Nye opplevelser sammen hindrer at det blir stillestående. Dere må fortsette å utforske som par."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नयाँपन नै इन्धन हो। सँगैका नयाँ अनुभवले सम्बन्धलाई बासी हुन दिँदैनन्। जोडीका रूपमा तपाईंलाई खोजी गरिरहनु चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe dingen zijn de brandstof. Samen nieuwe ervaringen opdoen houdt het fris. Als stel moeten jullie blijven ontdekken."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinthu zatsopano ndiwo mafuta. Zochitika zatsopano limodzi zimakulepheretsani kunyong'onyeka. Muyenera kupitiriza kufufuza zinthu limodzi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haaraan boba'aa dha. Muuxannoon haaraan waliinii akka hin dulloomne isin eega. Akka jaalallee lamaaniitti qorachuu itti fufuu qabdu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନୂଆପଣ ହିଁ ଇନ୍ଧନ। ଏକାଠି ନୂଆ ଅନୁଭୂତି ଆପଣଙ୍କୁ ବାସି ହେବାକୁ ଦିଏ ନାହିଁ। ଯୁଗଳ ଭାବେ ଆପଣଙ୍କୁ ଖୋଜୁଥିବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨਵਾਂਪਣ ਹੀ ਬਾਲਣ ਹੈ। ਇਕੱਠੇ ਨਵੇਂ ਤਜਰਬੇ ਤੁਹਾਨੂੰ ਬਾਸੀ ਹੋਣ ਤੋਂ ਬਚਾਉਂਦੇ ਹਨ। ਜੋੜੇ ਵਜੋਂ ਤੁਹਾਨੂੰ ਨਵਾਂ ਖੋਜਦੇ ਰਹਿਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowość to paliwo. Nowe wspólne przeżycia chronią was przed stagnacją. Wspólne odkrywanie świata to dla ciebie potrzeba."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوښت یې سونګ دی. یوځای نوې تجربې نه پرېږدي چې ستاسو اړیکه زړه شي. تاسو اړتیا لرئ چې د جوړې په توګه لټون ته دوام ورکړئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade é o combustível. Experiências novas juntos evitam que a relação caia na mesmice. Vocês precisam continuar explorando como casal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A novidade é o combustível. Experiências novas a dois impedem que a relação fique parada. Precisam de continuar a explorar enquanto casal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noutatea e combustibilul. Experiențele noi împreună vă feresc de monotonie. Aveți nevoie să explorați mereu, în doi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна — топливо. Новые впечатления вместе не дают вам заскучать. Вам нужно продолжать открывать мир вдвоём."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibishya ni byo bicana umuriro. Ibihe bishya muri kumwe bibarinda kurambirwa. Mukeneye gukomeza kuvumbura muri kumwe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අලුත් දේවල් තමයි ඉන්ධනය. එක්ව ලබන අලුත් අත්දැකීම් ඔබව එකම විදිහට හිරවෙන්න දෙන්නේ නැහැ. යුවළක් විදිහට ඔබට දිගටම ගවේෂණය කරන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novota je palivo. Nové spoločné zážitky vám nedovolia zovšednieť. Ako pár potrebujete stále objavovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novosti so gorivo. Nova skupna doživetja preprečujejo, da bi vajin odnos zastal. Kot par morata še naprej raziskovati."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvitsva ndizvo zvinokurudzira. Zviitiko zvitsva pamwe chete zvinokudzivirirai kuneta nezvakajairwa. Munoda kuramba muchiongorora muri vaviri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cusubnaantu waa shidaalka. Waayo-aragnimooyin cusub oo wadajir ah ayaa idinka ilaaliya inaad caajistaan. Waxaad u baahan tihiin inaad lammaane ahaan sii sahamisaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risia është karburanti. Përvojat e reja bashkë nuk ju lënë të ndryshkeni. Ju duhet të vazhdoni të eksploroni si çift."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новине су гориво. Нова заједничка искуства вас чувају од устајалости. Треба вам да као пар стално истражујете."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal énggal téh bahan bakarna. Pangalaman énggal babarengan ngajaga aranjeun tina rasa bosen. Anjeun peryogi teras ngajajah salaku pasangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nya är bränslet. Nya upplevelser tillsammans hindrar er från att gå i stå. Ni behöver fortsätta upptäcka som par."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mambo mapya ndiyo mafuta. Uzoefu mpya pamoja huwazuia msizoee kupita kiasi. Mnahitaji kuendelea kugundua mkiwa pamoja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புதுமையே எரிபொருள். ஒன்றாகப் பெறும் புதிய அனுபவங்கள் உறவைச் சலிப்படையாமல் வைத்திருக்கின்றன. ஜோடியாகத் தொடர்ந்து புதியவற்றைத் தேட வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొత్తదనమే ఇంధనం. కలిసి కొత్త అనుభవాలు బంధాన్ని పాతబడనీయవు. జంటగా మీరు అన్వేషిస్తూనే ఉండాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навгонӣ сӯзишворист. Таассуроти нави муштарак намегузорад, ки шумо кӯҳна шавед. Ба шумо лозим аст, ки ҳамчун ҷуфт кашф карданро идома диҳед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความแปลกใหม่คือเชื้อเพลิง ประสบการณ์ใหม่ๆ ด้วยกันช่วยไม่ให้ความสัมพันธ์จืดชืด คุณต้องออกสำรวจไปด้วยกันเรื่อยๆ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሓድሽ ነገር ነዳዲ እዩ። ብሓባር ሓደሽቲ ተሞክሮታት ከይትሃስሱ ይሕልወኩም። ከም ጽምዲ ምድህሳስ ክትቅጽሉ የድልየኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täzelik — ýangyç. Bile täze täsirler sizi bir hilli bolmakdan saklaýar. Saňa jübüt bolup öwrenmegi dowam etmek gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakıtın yenilik. Birlikte yaşanan yeni deneyimler sizi bayatlamaktan koruyor. Çift olarak keşfetmeye devam etmeniz gerek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна — це паливо. Нові спільні враження не дають вам застоюватися. Вам потрібно й далі досліджувати світ як пара."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیا پن ہی ایندھن ہے۔ مل کر نئے تجربات رشتے کو باسی ہونے سے بچاتے ہیں۔ بطور جوڑا آپ کو دریافت کا سفر جاری رکھنا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangilik — yoqilgʻi. Birga yangi taassurotlar munosabatlaringizni zerikarli boʻlishdan asraydi. Juftlik sifatida doim kashf etib turishingiz kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự mới mẻ là nhiên liệu. Những trải nghiệm mới cùng nhau giúp hai bạn không nhàm chán. Hai bạn cần tiếp tục khám phá cùng nhau."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinto ezintsha zingamafutha. Amava amatsha kunye anithintela ekuphelelweni yincasa. Kufuneka niqhubeke nihlola njengesibini."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohun tuntun ni epo rẹ̀. Ìrírí tuntun papọ̀ ń dènà kí ẹ má sú ara yín. Ẹ nílò láti máa ṣàwárí papọ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鮮感就是燃料。一起經歷新事物，讓你們不會變得沉悶。你們需要兩個人一起不斷探索。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鲜感就是燃料。一起经历新事物，能让感情不至于变得平淡。你们需要一直一起探索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鮮感就是燃料。一起體驗新事物，讓你們不會變得乏味。你們需要一起持續探索。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinto ezintsha ziyizibaseli. Okuhlangenwe nakho okusha ndawonye kunivimbela ukuthi nibe yisicefe. Kudingeka niqhubeke nihlola njengombhangqwana."
          }
        }
      }
