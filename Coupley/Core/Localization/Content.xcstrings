    "We often love others the way we want to be loved — not always how they receive it best." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا نحب الآخرين بالطريقة التي نريد أن نُحَب بها، لا بالطريقة التي يتلقون بها الحب على أفضل وجه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Často dáváme lásku tak, jak ji chceme dostávat my – ne vždy tak, jak ji druhý přijímá nejlíp."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi elsker ofte andre, sådan som vi selv vil elskes – ikke altid sådan, de bedst tager imod det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir lieben oft so, wie wir selbst geliebt werden wollen – nicht immer so, wie es beim anderen am besten ankommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συχνά αγαπάμε τους άλλους όπως θέλουμε να μας αγαπούν — όχι πάντα όπως το δέχονται καλύτερα εκείνοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menudo queremos a los demás como nos gustaría que nos quisieran, no siempre como mejor lo reciben."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakastamme usein muita niin kuin itse haluamme tulla rakastetuiksi – emme aina niin kuin he sen parhaiten ottavat vastaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madalas, minamahal natin ang iba sa paraang gusto nating mahalin — hindi laging sa paraang pinakamadali nilang matanggap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On aime souvent les autres comme on aimerait être aimé, pas toujours comme eux le reçoivent le mieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לרוב אוהבים אחרים כמו שרוצים לקבל אהבה — לא תמיד כמו שהם הכי מקבלים אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम अक्सर दूसरों को वैसे प्यार करते हैं जैसे ख़ुद प्यार पाना चाहते हैं — ज़रूरी नहीं कि वैसे जैसे उन्हें सबसे अच्छा लगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyakran úgy szeretünk másokat, ahogy mi szeretnénk, hogy szeressenek – nem mindig úgy, ahogy ők a legjobban befogadják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita sering mencintai orang lain dengan cara yang ingin kita terima — belum tentu cara yang paling mereka rasakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso amiamo gli altri come vorremmo essere amati noi — non sempre nel modo in cui loro lo ricevono meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人は、自分が愛されたい形で相手を愛しがち。それが相手にいちばん届く形とは限りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우리는 흔히 내가 받고 싶은 방식으로 사랑을 줘요. 상대가 가장 잘 받아들이는 방식과는 다를 수 있죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita sering menyayangi orang lain dengan cara kita mahu disayangi — tidak semestinya cara mereka paling mudah menerimanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi elsker ofte andre slik vi selv vil bli elsket – ikke alltid slik den andre helst tar imot kjærlighet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We houden vaak van anderen zoals we zelf graag geliefd worden – niet altijd zoals de ander het best ontvangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często okazujemy miłość tak, jak chcemy ją otrzymywać – nie zawsze tak, jak druga osoba najlepiej ją odbiera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas vezes amamos os outros do jeito que gostaríamos de receber amor — e nem sempre do jeito que a outra pessoa recebe melhor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adesea îi iubim pe ceilalți așa cum vrem să fim iubiți — nu mereu așa cum primesc ei cel mai bine iubirea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы часто любим других так, как хотим, чтобы любили нас, — а не так, как им легче это принять."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi älskar ofta andra som vi själva vill bli älskade – inte alltid som de tar emot det bäst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรามักรักคนอื่นในแบบที่อยากถูกรัก ซึ่งอาจไม่ใช่แบบที่อีกฝ่ายรับได้ดีที่สุดเสมอไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu zaman başkalarını, kendimizin sevilmek istediği gibi severiz; her zaman onların en iyi aldığı şekilde değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми часто любимо інших так, як хочемо, щоб любили нас, — і не завжди так, як це найкраще сприймають вони."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta thường yêu người khác theo cách mình muốn được yêu — chứ không phải lúc nào cũng là cách người ấy đón nhận tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们常用自己希望被爱的方式去爱别人——但那不一定是对方最能接收的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們常用自己想被愛的方式去愛人，但那不一定是對方最能接收的方式。"
          }
