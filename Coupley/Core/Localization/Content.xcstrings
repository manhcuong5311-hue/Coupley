        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انډول ستاسو په طبیعت کې دی. ښايي له ډېرو ملګرو سره د پیسو خبرې نسبتاً په اسانۍ پر مخ یوسئ."
