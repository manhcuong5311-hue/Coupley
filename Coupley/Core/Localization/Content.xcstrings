        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეხება, როგორც კავშირი — სულაც არა აუცილებლად სექსუალური. უბრალოდ ერთმანეთის გვერდით ყოფნა, სხეულის ენა, რომელიც ამბობს: „აქ ვარ“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Байланыс ретіндегі жанасу — міндетті түрде құмарлық емес. Жай ғана бір-біріңнің жаныңда болу, дене тілімен «Мен осындамын» деу."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការប៉ះពាល់ជាការភ្ជាប់ចិត្ត — មិនចាំបាច់ជារឿងផ្លូវភេទទេ។ គ្រាន់តែនៅក្បែរគ្នា ភាសាកាយប្រាប់ថា “ខ្ញុំនៅទីនេះ”។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಾಂಧವ್ಯವಾಗಿ ಸ್ಪರ್ಶ — ಅದು ಲೈಂಗಿಕವೇ ಆಗಬೇಕಿಲ್ಲ. ಸುಮ್ಮನೆ ಒಬ್ಬರ ಪಕ್ಕ ಒಬ್ಬರು, ದೇಹಭಾಷೆ “ನಾನಿಲ್ಲೇ ಇದ್ದೇನೆ” ಎನ್ನುತ್ತಾ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꼭 성적인 의미가 아닌, 연결로서의 스킨십이에요. 그냥 곁에 붙어서 몸으로 “나 여기 있어”라고 말하는 것."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destlêdan wekî girêdan — ne bi neçarî zayendî. Tenê li nêzî hev bûn, zimanê laş dibêje “Ez li vir im”."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тийүү байланыш катары — сөзсүз эле жыныстык эмес. Жөн эле бири-бириңдин жаныңда болуу, дене тили «Мен бул жердемин» дейт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beréierung als Verbindung — net onbedéngt sexuell. Einfach no beieneen sinn, d'Kierpersprooch seet „Ech sinn do“."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການສຳຜັດຄືການເຊື່ອມໃຈ — ບໍ່ຈຳເປັນຕ້ອງເປັນເລື່ອງທາງເພດ ແຄ່ໄດ້ຢູ່ໃກ້ກັນ ພາສາກາຍທີ່ບອກວ່າ ‘ຂ້ອຍຢູ່ນີ້’"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisilietimas kaip ryšys – nebūtinai seksualus. Tiesiog būti arti vienas kito, kai kūno kalba sako „aš čia“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskāriens kā saikne – ne obligāti seksuāls. Vienkārši būt tuvu, kad ķermeņa valoda saka: „Es esmu šeit”."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fikasihana ho fifandraisana — tsy voatery ho ara-nofo. Mifanakaiky fotsiny, ny fihetsiky ny vatana milaza hoe “Eto aho”."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pā hei hononga — ehara i te mea taitōkai. Ko te noho tata noa, me te reo o te tinana e kī ana “Kei konei ahau”."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допирот како поврзаност — не нужно сексуален. Само да сте блиску еден до друг, а говорот на телото да кажува „Тука сум“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്പർശനം അടുപ്പമായി — അത് ലൈംഗികമാകണമെന്നില്ല. പരസ്പരം അടുത്തിരിക്കുക, ശരീരഭാഷയിലൂടെ “ഞാൻ ഇവിടെയുണ്ട്” എന്ന് പറയുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хүрэлцэх нь холбоо — заавал дурлалын биш. Зүгээр л бие биеийнхээ дэргэд байж, биеийн хэлээр «Би энд байна» гэх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोडणारा स्पर्श — प्रत्येक वेळी शृंगारिकच नव्हे. फक्त एकमेकांच्या जवळ असणे, देहबोलीतून “मी इथे आहे” सांगणे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan sebagai penghubung — tidak semestinya seksual. Sekadar berada dekat, bahasa badan yang menyampaikan ‘Saya ada di sini’."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mess bħala konnessjoni — mhux bilfors sesswali. Sempliċiment li tkunu qrib xulxin, bil-lingwaġġ tal-ġisem jgħid “Jien hawn”."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထိတွေ့မှုက နီးစပ်မှုပါ — လိင်ပိုင်းဆိုင်ရာ မဖြစ်မနေ မဟုတ်ဘူး။ အနားမှာ ရှိနေရုံ၊ ကိုယ်ဟန်က “ကိုယ် ဒီမှာ ရှိတယ်” လို့ ပြောနေတာ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring som kontakt – ikke nødvendigvis seksuell. Bare å være nær hverandre, med et kroppsspråk som sier «jeg er her»."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोडिने माध्यमका रूपमा स्पर्श — यौनिक नै हुनुपर्छ भन्ने छैन। बस एकअर्काको नजिक हुनु, शरीरले ‘म यहीँ छु’ भनिरहनु।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking als verbinding – niet per se seksueel. Gewoon dicht bij elkaar zijn, met een lichaamstaal die zegt: ‘ik ben er’."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukhudzana ngati kulumikizana — osati kwenikweni za kugonana. Kungokhala pafupi wina ndi mnzake, thupi likunena kuti “Ndili pano”."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuqaa akka walitti dhufeenyaatti — saalqunnamtii ta'uu hin qabu. Wal bira jiraachuu qofa, qaamni “Asan jira” jechuu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସମ୍ପର୍କର ମାଧ୍ୟମ ଭାବେ ସ୍ପର୍ଶ — ଯୌନ ହେବା ଜରୁରି ନୁହେଁ। କେବଳ ପରସ୍ପରର ପାଖରେ ରହିବା, ଦେହର ଭାଷା କହୁଛି ‘ମୁଁ ଏଠି ଅଛି’।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਛੋਹ ਜੁੜਨ ਦਾ ਜ਼ਰੀਆ — ਜ਼ਰੂਰੀ ਨਹੀਂ ਕਿ ਜਿਨਸੀ ਹੋਵੇ। ਬੱਸ ਇੱਕ-ਦੂਜੇ ਦੇ ਕੋਲ ਹੋਣਾ, ਸਰੀਰ ਦੀ ਭਾਸ਼ਾ ਕਹਿੰਦੀ ਹੈ “ਮੈਂ ਇੱਥੇ ਹਾਂ”।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk jako więź – niekoniecznie seksualny. Po prostu bycie blisko siebie, mowa ciała, która mówi „jestem tu”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس د نږدېوالي په توګه — نه حتماً جنسي. یوازې یو بل ته نږدې اوسېدل، د بدن ژبه چې وايي: «زه دلته یم»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque como conexão — não necessariamente sexual. Só estar perto, com o corpo dizendo “estou aqui”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque como ligação — não necessariamente sexual. Só estar perto, com a linguagem corporal a dizer «estou aqui»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea ca legătură — nu neapărat sexuală. Doar să fiți unul lângă altul, cu un limbaj al trupului care spune „sunt aici”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновение как связь, и не обязательно о сексе. Просто быть рядом, когда само тело говорит «я здесь»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukoranaho nk'uburyo bwo kwegerana — atari ngombwa iby'imibonano. Kuba hafi gusa, umubiri uvuga ngo “Ndi hano”."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සම්බන්ධතාවක් විදිහට ස්පර්ශය — අනිවාර්යයෙන්ම ලිංගික නොවන. නිකන්ම එකිනෙකාට ළඟින් ඉන්න එක, ශරීර භාෂාවෙන් “මම මෙතන ඉන්නවා” කියන එක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk ako spojenie – nie nevyhnutne sexuálny. Len byť pri sebe a rečou tela hovoriť „som tu“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotik kot povezava – ne nujno spolni. Preprosto biti blizu, govorica telesa, ki pravi „tu sem“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubatana nekubatwa — kwete zvepabonde nguva dzose. Kungova pedyo, muviri uchiti “Ndiri pano”."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taabasho xiriir ahaan — ma aha in ay galmo tahay. Kaliya inaad isku dhow tihiin, jidhkuna leeyahay “Waan joogaa”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekja si lidhje – jo domosdoshmërisht seksuale. Thjesht të jeni pranë njëri-tjetrit, me gjuhën e trupit që thotë „Jam këtu“."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додир као веза — не обавезно сексуални. Само бити близу, док говор тела каже „ту сам“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan salaku sambungan — teu kedah séksual. Ngan saukur silih caket, basa awak nyarioskeun “abdi di dieu”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring som kontakt – inte nödvändigtvis sexuell. Att bara vara nära varandra, med ett kroppsspråk som säger ”jag är här”."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mguso kama njia ya kuungana — si lazima wa kimapenzi. Kuwa karibu tu, lugha ya mwili ikisema “niko hapa”."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைப்பாகத் தொடுதல் — அவசியம் காமம் சார்ந்தது அல்ல. வெறுமனே ஒருவருக்கொருவர் அருகில் இருப்பது, உடல்மொழியே “நான் இங்கே இருக்கிறேன்” என்று சொல்வது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్పర్శ అనుబంధంగా — తప్పనిసరిగా శృంగారం కాదు. ఒకరికొకరు దగ్గరగా ఉండటం, హావభావాలే “నేను ఇక్కడే ఉన్నాను” అని చెప్పడం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ламс ҳамчун пайванд — на ҳатман ҷинсӣ. Танҳо дар наздикии ҳамдигар будан, забони бадан, ки мегӯяд: «Ман инҷоям»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสคือการเชื่อมถึงกัน ไม่จำเป็นต้องเป็นเรื่องทางเพศ แค่ได้อยู่ใกล้กัน ให้ภาษากายบอกว่า “ฉันอยู่ตรงนี้”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምትንካፍ ከም ርክብ — ጾታዊ ክኸውን ኣየድልዮን። ኣብ ጥቓ ንሓድሕድ ምህላው ጥራይ፣ ኣካል «ኣብዚ ኣለኹ» እናበለ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degmek ýakynlyk hökmünde — hökman jynsy däl. Diňe biri-biriňe ýakyn bolmak, beden diliň bilen “Men şu ýerde” diýmek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağ kurmanın yolu olarak dokunmak; illa cinsel değil. Sadece birbirinize yakın olmak, beden dilinin “Buradayım” demesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик як зв’язок — не обов’язково сексуальний. Просто бути поруч, коли тіло каже: «Я тут»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس بطور تعلق — ضروری نہیں کہ جنسی ہو۔ بس ایک دوسرے کے پاس ہونا، جسم کی زبان کہہ رہی ہو “میں یہاں ہوں”۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teginish — bogʻlanish usuli, shart emas ehtirosli boʻlishi. Shunchaki bir-biringiz yonida boʻlish, tana tili «Men shu yerdaman» deyishi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm như sự kết nối — không nhất thiết là chuyện ân ái. Chỉ cần ở gần nhau, cử chỉ nói lên “mình ở đây”."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuchukumisa njengonxibelelwano — kungengokwesondo. Ukuba kufuphi nje omnye nomnye, umzimba uthi “Ndikhona”."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìfọwọ́kàn bí ìsopọ̀ — kì í ṣe ti ìbálòpọ̀ dandan. Kí ẹ kàn wà nítòsí ara yín, kí ara yín máa sọ pé “Mo wà níbí”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用觸碰來連繫，不一定和性有關。只是靠在一起，身體語言在說「我在這裡」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用触碰传递亲近，不一定与性有关。只是挨在一起，用身体语言说“我在”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是一種連結，不一定和性有關。就只是待在彼此身邊，用肢體語言說「我在這裡」。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthintana njengokuxhumana — hhayi ngokocansi ngempela. Ukuba seduze nje, ulimi lomzimba luthi “Ngikhona.”"
          }
        }
      }
    },
    "Touch is instinctive for you. You reach out physically when you care — and you probably notice when that diminishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is vir jou instinktief. Jy reik fisies uit as jy omgee – en jy merk waarskynlik op wanneer dit minder word."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንክኪ ለእርስዎ በደመነፍስ የሚመጣ ነው። ሲያስቡ በአካል ይቀርባሉ — ሲቀንስም ሳያስተውሉ አይቀሩም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة غريزية لديكم. تقتربون جسديًا حين تهتمون، وعلى الأرجح تلاحظون حين يقلّ ذلك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্পৰ্শ আপোনাৰ সহজাত। যত্ন কৰিলে আপুনি শাৰীৰিকভাৱে ওচৰ চাপে — আৰু সেয়া কমি আহিলে আপুনি হয়তো গম পায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toxunuş sənin üçün instinktivdir. Qayğı göstərəndə fiziki olaraq yaxınlaşırsan — və yəqin ki, bu azalanda dərhal hiss edirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотык для цябе інстынктыўны. Калі табе не ўсё роўна, ты цягнешся да чалавека — і, напэўна, заўважаеш, калі гэтага становіцца менш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосването е инстинктивно за теб. Когато те е грижа, посягаш физически – и вероятно усещаш, когато това намалее."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্পর্শ তোমার সহজাত। যত্ন করলে তুমি ছুঁয়ে কাছে আসো — আর সেটা কমে গেলে হয়তো টেরও পাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir ti je instinktivan. Kad ti je stalo, posegneš fizički – i vjerovatno primijetiš kad ga ima manje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacte és instintiu per a tu. Quan algú t'importa, el busques físicament — i segurament notes quan això minva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotek je pro tebe instinktivní. Když ti na někom záleží, natáhneš ruku – a nejspíš si všimneš, když toho ubývá."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae cyffwrdd yn reddfol i ti. Rwyt ti'n estyn allan yn gorfforol pan fyddi di'n poeni am rywun — ac mae'n siŵr dy fod yn sylwi pan fydd hynny'n lleihau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er instinktiv for dig. Du rækker ud fysisk, når du holder af nogen – og du mærker sikkert, når den bliver mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung ist für dich instinktiv. Wenn dir jemand wichtig ist, suchst du Körperkontakt – und merkst wohl auch, wenn er weniger wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα είναι ενστικτώδες για σένα. Όταν νοιάζεσαι, απλώνεις το χέρι — και μάλλον το προσέχεις όταν αυτό λιγοστεύει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto te sale por instinto. Cuando te importa alguien, lo buscas físicamente, y seguramente notas cuando eso disminuye."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puudutus on sulle instinktiivne. Hoolides sirutad käe välja — ja märkad ilmselt, kui seda vähemaks jääb."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukimena berezkoa da zuretzat. Norbait maite duzunean, fisikoki hurbiltzen zara — eta ziur asko konturatzen zara hori gutxitzen denean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس برایت غریزی است. وقتی کسی برایت مهم است، دستت به سمتش می‌رود — و احتمالاً وقتی کم شود متوجه می‌شوی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus on sinulle vaistonvaraista. Hakeudut fyysisesti lähelle, kun välität – ja huomaat luultavasti, jos se vähenee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likas sa’yo ang haplos. Pisikal kang lumalapit kapag nagmamalasakit ka — at malamang napapansin mo kapag nababawasan iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le toucher est instinctif chez toi. Quand quelqu'un compte pour toi, tu vas vers l'autre physiquement, et tu remarques sûrement quand ça diminue."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagann an tadhall ó instinn chugat. Síneann tú amach go fisiciúil nuair is cás leat duine — agus is dócha go dtugann tú faoi deara nuair a laghdaíonn sé."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O contacto é instintivo para ti. Cando che importa alguén, achégaste fisicamente, e seguramente notas cando iso diminúe."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્પર્શ તમારી સહજ વૃત્તિ છે. કાળજી હોય ત્યારે તમે સ્પર્શથી નજીક આવો છો — અને એ ઓછું થાય ત્યારે કદાચ તમને તરત ખબર પડે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taɓawa ɗabi'a ce a gare ku. Kuna miƙa hannu idan kuna kulawa — kuma wataƙila kuna lura idan hakan ya ragu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע הוא אינסטינקט אצלך. כשאכפת לך, היד נשלחת מעצמה — וכנראה שזה בולט לך כשיש פחות מזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श आपके लिए सहज है। परवाह होने पर आप छूकर जताते हैं — और जब यह कम होता है, तो शायद आपको महसूस भी होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir ti je instinktivan. Kad ti je stalo, posegneš fizički – i vjerojatno primijetiš kad ga ima manje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manyen se yon ensten pou ou. Ou lonje men lè ou renmen yon moun — e ou pwobableman remake lè sa vin diminye."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad az érintés ösztönös. Ha törődsz valakivel, fizikailag is közeledsz – és valószínűleg észreveszed, ha ez megfogyatkozik."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հպումը քեզ համար բնազդային է։ Երբ հոգ ես տանում, ֆիզիկապես ես մոտենում — և հավանաբար նկատում ես, երբ դա պակասում է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan itu naluriahmu. Kamu menyentuh saat peduli — dan kamu mungkin sadar saat itu mulai berkurang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmetụ bụ ihe ebumpụta ụwa nye gị. Ị na-eruru mmadụ aka mgbe ọ dị gị mkpa — o nwekwara ike ịbụ na ị na-ahụ mgbe nke ahụ belatara."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snerting er þér eðlislæg. Þú teygir þig til makans þegar þér þykir vænt um einhvern – og tekur líklega eftir því þegar það minnkar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto per te è istintivo. Quando tieni a qualcuno lo cerchi fisicamente — e probabilmente ti accorgi quando diminuisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れることが本能的なタイプです。大切に思うと自然に手が伸び、それが減るとすぐに気づくでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan iku naluri panjenengan. Panjenengan nyedhaki kanthi fisik yen peduli — lan panjenengan mbokmenawa ngrasa yen kuwi saya suda."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეხება შენთვის ინსტინქტურია. როცა ზრუნავ, ფიზიკურად იწვდი ხელს — და, ალბათ, ამჩნევ, როცა ეს მცირდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жанасу сен үшін түйсіктік. Жаның ашыса, қол созасың — ал ол азайса, байқайтын шығарсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការប៉ះពាល់ជាសភាវគតិរបស់អ្នក។ អ្នកលូកដៃទៅរកពេលអ្នកខ្វល់ — ហើយអ្នកប្រហែលជាកត់សម្គាល់ឃើញពេលវាថយចុះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಪರ್ಶ ನಿಮಗೆ ಸಹಜ ಪ್ರವೃತ್ತಿ. ಕಾಳಜಿ ಇದ್ದಾಗ ನೀವು ಸ್ಪರ್ಶದ ಮೂಲಕ ತಲುಪುತ್ತೀರಿ — ಅದು ಕಡಿಮೆಯಾದಾಗ ನೀವು ಗಮನಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킨십이 본능적이에요. 아끼는 마음이 들면 몸이 먼저 다가가죠. 그게 줄어들면 아마 바로 알아챌 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destlêdan ji te re xwezayî ye. Dema xema te dibe, tu bi laşî nêzîk dibî — û belkî tu ferq dikî dema ew kêm dibe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тийүү — сенин инстинктиң. Кам көргөндө колуңду сунасың — жана ал азайса, байкап каласың го."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beréierung ass bei dir instinktiv. Wann dir een um Häerz läit, gees du kierperlech op deen zou — an du mierks bestëmmt, wann dat manner gëtt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການສຳຜັດເປັນສັນຊາດຕະຍານຂອງເຈົ້າ ເຈົ້າຍື່ນມືອອກໄປເມື່ອເຈົ້າຫ່ວງໃຍ — ແລະ ເຈົ້າຄົງສັງເກດໄດ້ເມື່ອມັນໜ້ອຍລົງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisilietimai tau instinktyvūs. Kai tau rūpi, ištiesi ranką – ir tikriausiai pastebi, kai to sumažėja."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskāriens tev ir instinktīvs. Kad tev rūp, tu sniedzies pretī – un droši vien pamani, kad pieskārienu kļūst mazāk."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avy ho azy aminao ny fikasihana. Manatona ara-batana ianao rehefa mikarakara — ary azo inoana fa tsikaritrao rehefa mihena izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He parapara te pā ki a koe. Ka toro atu tō ringa ina manaaki koe — ā, tērā pea ka kite koe ina iti haere."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допирот ти е инстинктивен. Кога ти е грижа, посегнуваш физички — и веројатно забележуваш кога тоа ќе се намали."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്പർശനം നിങ്ങൾക്ക് സഹജമാണ്. കരുതലുള്ളപ്പോൾ നിങ്ങൾ ശാരീരികമായി അടുത്തുചെല്ലും — അത് കുറയുമ്പോൾ നിങ്ങൾ അത് ശ്രദ്ധിക്കുകയും ചെയ്യും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хүрэлцэх нь чамд зөн совингийн зүйл. Санаа тавихдаа чи биеэрээ ойртдог — тэр нь багасахад анзаардаг байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श तुमच्यासाठी उपजत आहे. काळजी वाटली की तुम्ही स्पर्शातून जवळ जाता — आणि तो कमी झाला की तुमच्या लगेच लक्षात येत असेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan datang secara naluri bagi anda. Apabila sayang, anda spontan menghulurkan sentuhan — dan anda mungkin perasan apabila ia berkurangan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mess huwa istintiv għalik. Tersaq fiżikament meta jimpurtak — u probabbli tinduna meta dan jonqos."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထိတွေ့မှုက သင့်အတွက် ပင်ကိုယ်စိတ်ပါ။ ဂရုစိုက်တဲ့အခါ ကိုယ်ထိလက်ရောက် ဆက်သွယ်တယ် — အဲဒါ လျော့နည်းလာရင်လည်း သတိထားမိမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er instinktivt for deg. Du søker fysisk kontakt når du bryr deg – og du merker nok når det blir mindre av det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श तपाईंको स्वभाव हो। माया लाग्दा तपाईं शारीरिक रूपमा नजिक जानुहुन्छ — र त्यो कम हुँदा तपाईंले याद पनि गर्नुहुन्छ होला।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is voor jou instinctief. Als je om iemand geeft, zoek je fysiek contact – en je merkt het waarschijnlijk als dat minder wordt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukhudzana nkwachibadwa kwa inu. Mumafikira mwa thupi mukamasamala — ndipo mwina mumazindikira zikachepa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuqaan siif uumamaa dha. Yeroo yaaddu qaamaan ni dhiyaatta — yeroo kun hir'atus ni hubatta ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ପର୍ଶ ଆପଣଙ୍କ ସହଜାତ ପ୍ରବୃତ୍ତି। ଯତ୍ନ ନେଲେ ଆପଣ ଛୁଇଁ ଜଣାନ୍ତି — ଆଉ ଏହା କମିଗଲେ ଆପଣ ବୋଧହୁଏ ଲକ୍ଷ୍ୟ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਛੋਹ ਤੁਹਾਡਾ ਸੁਭਾਅ ਹੈ। ਜਦੋਂ ਤੁਹਾਨੂੰ ਪਰਵਾਹ ਹੁੰਦੀ ਹੈ, ਤੁਸੀਂ ਛੋਹ ਕੇ ਜਤਾਉਂਦੇ ਹੋ — ਅਤੇ ਜਦੋਂ ਇਹ ਘਟਦੀ ਹੈ ਤਾਂ ਤੁਹਾਨੂੰ ਸ਼ਾਇਦ ਝੱਟ ਮਹਿਸੂਸ ਹੋ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk jest u ciebie instynktowny. Gdy ci zależy, sięgasz po kontakt fizyczny – i pewnie zauważasz, gdy go ubywa."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس ستاسو فطرت دی. کله چې پاملرنه کوئ، جسمي نږدېوالی ښیئ — او ښايي کله چې کم شي، پام مو کېږي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é instintivo para você. Quando se importa, você busca contato — e provavelmente percebe quando isso diminui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é instintivo para ti. Quando gostas de alguém, procuras o contacto físico — e provavelmente notas quando isso diminui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea e instinctivă pentru tine. Când îți pasă, cauți apropierea fizică — și probabil observi când ea scade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновения для тебя инстинктивны. Когда тебе не всё равно, хочется прикоснуться — и ты наверняка замечаешь, когда этого становится меньше."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukoranaho bikwizanira. Uramukoraho iyo umwitayeho — kandi birashoboka ko ubibona iyo bigabanutse."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ස්පර්ශය ඔබට සහජයි. ඔබ සැලකිලිමත් වෙනකොට ශාරීරිකව ළඟා වෙනවා — ඒක අඩු වෙනකොට ඔබට බොහෝ විට තේරෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk je pre teba inštinkt. Keď ti na niekom záleží, natiahneš ruku – a asi si všimneš, keď toho ubúda."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotik je zate nagonski. Ko ti je mar, iščeš telesno bližino – in verjetno opaziš, ko je je manj."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubata kunouya pachako kwauri. Unotambanudza ruoko kana uine hanya — uye pamwe unoona kana izvozvo zvaderera."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taabashadu waa dareen kuu dabiici ah. Marka aad daryeesho, jidh ahaan ayaad u gaadhaa — waxayna u badan tahay inaad dareento marka ay yaraato."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekja është instinktive për ty. Kur të intereson dikush, e kërkon fizikisht – dhe ndoshta e vë re kur kjo pakësohet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додир ти је инстинктиван. Кад ти је стало, посегнеш физички — и вероватно приметиш кад тога има мање."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan téh naluri pikeun anjeun. Anjeun ngadeukeutan sacara fisik nalika anjeun paduli — sareng anjeun sigana sadar nalika éta ngirangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring är instinktivt för dig. Du söker fysisk kontakt när du bryr dig – och märker nog när den minskar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mguso ni silika kwako. Unanyoosha mkono unapojali — na huenda unagundua mguso huo unapopungua."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடுதல் உங்களுக்கு உள்ளுணர்வு. அக்கறை இருக்கும்போது நீங்கள் தொட்டு அணுகுகிறீர்கள் — அது குறையும்போது நீங்கள் கவனிப்பீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్పర్శ మీకు సహజం. శ్రద్ధ ఉన్నప్పుడు మీరు చేయి చాస్తారు — అది తగ్గితే బహుశా మీరు గమనిస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ламс барои ту ғаризист. Вақте ғамхорӣ мекунӣ, ҷисман даст дароз мекунӣ — ва эҳтимол пай мебарӣ, вақте ин кам мешавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสเป็นสัญชาตญาณของคุณ เมื่อใส่ใจใครคุณจะเข้าไปใกล้ชิด และคุณคงสังเกตได้เมื่อสิ่งนั้นลดลง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምትንካፍ ንዓኹም ደመ ነፍሲ እዩ። ምስ እትግደሱ ብኣካል ትቐርቡ — ምስ ዝጎድል ድማ ተስተብህሉ ትኾኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degmek seniň üçin tebigy. Alada edeniňde fiziki taýdan ýakynlaşýarsyň — we bu azalanda muny duýýansyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunmak senin için içgüdüsel. Birini önemsediğinde ona dokunarak yaklaşıyorsun ve bu azaldığında muhtemelen hemen fark ediyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик для тебе інстинктивний. Коли тобі хтось дорогий, ти шукаєш дотику — і, мабуть, помічаєш, коли їх стає менше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس آپ کی فطرت میں ہے۔ جب آپ کو کسی کی پروا ہو تو آپ کا ہاتھ خود بڑھتا ہے — اور جب یہ کم ہو تو شاید آپ کو فوراً محسوس ہو جاتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teginish siz uchun beixtiyor. Qaygʻursangiz, jismonan intilasiz — va bu kamayib qolsa, ehtimol, darhol sezasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm là bản năng của bạn. Bạn chạm vào người mình thương — và chắc hẳn bạn nhận ra khi điều đó vơi đi."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuchukumisa kuyimvelo kuwe. Ufikelela ngomzimba xa ukhathala — kwaye mhlawumbi uyaqaphela xa oko kuncipha."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìfọwọ́kàn jẹ́ ẹ̀mí yín. Ẹ máa ń nawọ́ sí ẹni tí ẹ bìkítà fún — ó sì ṣeé ṣe kí ẹ kíyè sí i nígbà tí ìyẹn bá dín kù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的本能。你在乎一個人時會自然靠近，而當這些少了，你大概也會察覺。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触碰对你来说是本能。在乎一个人时，你会自然地靠近——一旦变少，你多半也会察觉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的本能。在乎一個人時，你會自然地靠近，而這份親近變少時，你大概也會察覺。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthinta kuyimvelo kuwe. Uyelula isandla uma ukhathalela — futhi kungenzeka uyabona lapho lokho kuncipha."
          }
        }
      }
    },
    "Touch is your anchor. A hand on your back, a hug that lasts — it communicates care on a level words can't always reach." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is jou anker. ’n Hand op jou rug, ’n drukkie wat bly – dit wys omgee op ’n vlak waar woorde nie altyd kan uitkom nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንክኪ መልሕቅዎ ነው። ጀርባዎ ላይ ያረፈ እጅ፣ የሚዘገይ እቅፍ — ቃላት ሁልጊዜ ሊደርሱበት በማይችሉት ደረጃ እንክብካቤን ያስተላልፋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة هي مرساتكم. يد على الظهر أو عناق يطول، كلها تنقل اهتمامًا يتجاوز ما تبلغه الكلمات أحيانًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্পৰ্শই আপোনাৰ আশ্ৰয়। পিঠিত এখন হাত, দীঘলীয়া এটা সাৱটি — ই এনে এক স্তৰত যত্ন প্ৰকাশ কৰে য'লৈ শব্দ সদায় যাব নোৱাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toxunuş sənin dayağındır. Kürəyinə qoyulan əl, uzun bir qucaqlaşma — sözlərin həmişə çatdıra bilmədiyi qayğını çatdırır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотык — твая апора. Рука на спіне, доўгія абдымкі — гэта гаворыць пра клопат там, куды словы не заўсёды дастаюць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосването е твоята опора. Ръка на гърба, дълга прегръдка – така се показва грижа там, където думите невинаги стигат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্পর্শই তোমার ভরসার জায়গা। পিঠে একটা হাত, অনেকক্ষণ ধরে জড়িয়ে ধরা — এগুলো এমনভাবে যত্ন বোঝায়, যেখানে কথা সবসময় পৌঁছাতে পারে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir je tvoje sidro. Ruka na leđima, zagrljaj koji traje – to prenosi brigu tamo gdje riječi ne stignu uvijek."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacte és la teva àncora. Una mà a l'esquena, una abraçada que dura — transmet afecte a un nivell on les paraules no sempre arriben."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotek je tvoje kotva. Ruka na zádech, objetí, které chvíli trvá – vyjádří péči tam, kam slova ne vždycky dosáhnou."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyffyrddiad yw dy angor. Llaw ar dy gefn, cwtsh sy'n para — mae'n dangos gofal ar lefel na all geiriau ei chyrraedd bob amser."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er dit anker. En hånd på ryggen, et kram, der varer ved – det viser omsorg på et plan, ord ikke altid kan nå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung ist dein Anker. Eine Hand auf deinem Rücken, eine lange Umarmung – das zeigt Fürsorge auf einer Ebene, die Worte nicht immer erreichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα είναι το λιμάνι σου. Ένα χέρι στην πλάτη, μια αγκαλιά που κρατάει — μιλάει για φροντίδα εκεί που οι λέξεις δεν φτάνουν πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto es tu ancla. Una mano en la espalda, un abrazo largo… Eso transmite cariño a un nivel al que las palabras no siempre llegan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puudutus on sinu ankur. Käsi seljal, pikk kallistus — see annab hoolimisest märku seal, kuhu sõnad alati ei ulatu."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukimena da zure aingura. Esku bat bizkarrean, luze irauten duen besarkada bat — hitzak beti iristen ez diren tokira iristen da maitasun hori."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس، لنگرگاه توست. دستی روی شانه‌ات، بغلی که طول بکشد — مهری را می‌رساند که کلمات همیشه به آن نمی‌رسند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus on sinun ankkurisi. Käsi selälläsi, pitkä halaus – ne kertovat välittämisestä tavalla, johon sanat eivät aina yllä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang haplos ang sandigan mo. Kamay sa likod mo, yakap na matagal — naipaparating nito ang malasakit sa paraang hindi laging kaya ng salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contact physique, c'est ton point d'ancrage. Une main dans le dos, un câlin qui dure : ça exprime une tendresse que les mots n'atteignent pas toujours."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an tadhall d'ancaire. Lámh ar do dhroim, barróg a mhaireann — cuireann sé cúram in iúl ar leibhéal nach féidir le focail a bhaint amach i gcónaí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O contacto é a túa áncora. Unha man nas costas, unha aperta que dura: transmite cariño a un nivel ao que as palabras non sempre chegan."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્પર્શ તમારો સહારો છે. પીઠ પર મૂકેલો હાથ, લાંબું આલિંગન — એ કાળજીને ત્યાં સુધી પહોંચાડે છે જ્યાં શબ્દો હંમેશાં પહોંચી શકતા નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taɓawa ita ce ginshiƙinku. Hannu a bayanku, runguma mai tsawo — tana isar da kulawa ta hanyar da kalmomi ba koyaushe suke iya kaiwa ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע הוא העוגן שלך. יד על הגב, חיבוק שנמשך — הם מעבירים אכפתיות למקום שמילים לא תמיד מגיעות אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श आपका सहारा है। पीठ पर रखा हाथ, देर तक चलने वाला गले लगना — यह उस गहराई तक परवाह पहुँचाता है जहाँ शब्द हमेशा नहीं पहुँच पाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir je tvoje sidro. Ruka na leđima, zagrljaj koji potraje – to prenosi brigu ondje kamo riječi ne dopiru uvijek."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manyen se pwen apui ou. Yon men sou do ou, yon anbrasad ki dire — sa montre swen nan yon fason pawòl pa toujou ka rive."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érintés a horgonyod. Egy kéz a hátadon, egy hosszú ölelés – olyan szinten fejezi ki a törődést, ahová a szavak nem mindig érnek el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հպումը քո հենարանն է։ Ձեռքը մեջքիդ, երկար գրկախառնություն — դրանք հոգատարություն են փոխանցում այնպես, ինչպես բառերը միշտ չէ, որ կարող են։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan adalah jangkarmu. Tangan di punggungmu, pelukan yang lama — itu menyampaikan kepedulian yang kadang tak terjangkau kata-kata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmetụ bụ ihe na-eme ka obi gị guzosie ike. Aka n'azụ gị, mmakụ na-adịte aka — ọ na-egosi nlekọta n'ụzọ okwu na-anaghị eru mgbe niile."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snerting er akkerið þitt. Hönd á bakinu, langt faðmlag – það tjáir umhyggju á stað sem orð ná ekki alltaf til."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto è la tua àncora. Una mano sulla schiena, un abbraccio che dura — trasmette cura là dove le parole non sempre arrivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れ合いが心のよりどころです。背中に添えられた手、長めのハグ。言葉だけでは届かないところまで、思いやりが伝わります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan iku cekelan panjenengan. Tangan ing gegere, rangkulan sing suwe — kuwi ngandharake rasa peduli sing ora mesthi bisa digayuh tembung."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეხება შენი საყრდენია. ხელი ზურგზე, ხანგრძლივი ჩახუტება — ზრუნვას ისე გადმოსცემს, როგორც სიტყვები ყოველთვის ვერ ახერხებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жанасу — сенің тірегің. Арқаңа қойылған алақан, ұзаққа созылған құшақ — сөз әрдайым жеткізе алмайтын қамқорлықты білдіреді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការប៉ះពាល់គឺជាទីពឹងរបស់អ្នក។ ដៃដែលអង្អែលខ្នង ការឱបយូរបន្តិច — វាបង្ហាញក្ដីយកចិត្តទុកដាក់ក្នុងកម្រិតមួយ ដែលពាក្យសម្ដីមិនតែងតែទៅដល់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಪರ್ಶವೇ ನಿಮ್ಮ ಆಸರೆ. ಬೆನ್ನ ಮೇಲೊಂದು ಕೈ, ಬಹಳ ಹೊತ್ತು ಉಳಿಯುವ ಅಪ್ಪುಗೆ — ಮಾತುಗಳು ಯಾವಾಗಲೂ ತಲುಪಲಾಗದ ಮಟ್ಟದಲ್ಲಿ ಅದು ಕಾಳಜಿಯನ್ನು ತಿಳಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킨십은 마음의 닻이에요. 등을 감싸는 손길, 오래 머무는 포옹은 말로 다 전하지 못하는 마음까지 전해 줘요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destlêdan lengera te ye. Destek li ser pişta te, hembêzeke dirêj — ev xemxwariyê li astekê radigihîne ku gotin her tim nagihîjinê."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тийүү — сенин таянычың. Аркаңа коюлган алакан, узак кучак — сөз дайым эле жеткире албаган камкордукту билдирет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beréierung ass däin Anker. Eng Hand um Réck, eng Ëmaarmung, déi dauert — dat weist Zouneigung op eng Aart, déi Wierder net ëmmer erreechen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການສຳຜັດຄືບ່ອນຍຶດໝັ້ນຂອງເຈົ້າ ມືທີ່ວາງເທິງຫຼັງ, ການກອດທີ່ຍາວນານ — ມັນສື່ຄວາມຫ່ວງໃຍໄດ້ເລິກກວ່າທີ່ຄຳເວົ້າຈະໄປເຖິງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisilietimas – tavo atrama. Ranka ant nugaros, ilgas apkabinimas – tai perteikia rūpestį ten, kur žodžiai ne visada pasiekia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskāriens ir tavs enkurs. Roka uz muguras, ilgs apskāviens – tas pauž rūpes tur, kur vārdi ne vienmēr aizsniedz."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fikasihana no fiankinanao. Tanana eo an-damosinao, famihina maharitra — mampita fiahiana any amin'izay tsy tratran'ny teny foana izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pā tō punga. He ringa ki tō tuarā, he awhi roa — ka whakapuaki i te manaaki ki tētahi taumata kāore e taea i ngā kupu i ngā wā katoa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допирот е твоето сидро. Рака на грбот, прегратка што трае — тоа пренесува грижа на ниво до кое зборовите не секогаш стигнуваат."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്പർശനമാണ് നിങ്ങളുടെ നങ്കൂരം. മുതുകിൽ ഒരു കൈ, നീണ്ടുനിൽക്കുന്ന ഒരു ആലിംഗനം — വാക്കുകൾക്ക് എപ്പോഴും എത്താനാകാത്ത ഒരു തലത്തിൽ അത് കരുതൽ അറിയിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хүрэлцэх нь чиний түшиг. Нуруун дээр чинь тавьсан гар, удаан тэврэлт — үгээр үргэлж хүрч чаддаггүй түвшинд халамжийг илэрхийлдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श हा तुमचा आधार आहे. पाठीवर ठेवलेला हात, रेंगाळणारी मिठी — शब्द जिथे नेहमी पोहोचू शकत नाहीत, तिथे तो काळजी पोहोचवतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan ialah sauh anda. Tangan di belakang anda, pelukan yang lama — ia menyampaikan rasa sayang pada tahap yang tidak selalu dapat dicapai oleh kata-kata."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mess huwa l-ankra tiegħek. Id fuq dahrek, għannieqa li ddum — jesprimu l-kura f'livell li l-kliem mhux dejjem jasal għalih."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထိတွေ့မှုက သင့်ရဲ့ ကျောက်ဆူးပါ။ ကျောပေါ် အသာတင်ထားတဲ့ လက်တစ်ဖက်၊ ကြာကြာ ဖက်ထားတဲ့ အဖက် — စကားလုံးတွေ အမြဲ မရောက်နိုင်တဲ့ အဆင့်ထိ ဂရုစိုက်မှုကို ပြောပြပေးတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er ankeret ditt. En hånd på ryggen, en klem som varer – det viser omsorg på et nivå ord ikke alltid når fram til."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श तपाईंको सहारा हो। ढाडमा राखिएको हात, लामो अँगालो — यसले शब्दले सधैँ पुग्न नसक्ने तहमा हेरचाह व्यक्त गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is je anker. Een hand op je rug, een knuffel die blijft duren – het brengt zorg over op een niveau waar woorden niet altijd bij kunnen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukhudzana ndi nangula wanu. Dzanja pamsana panu, kukumbatira kwa nthawi yaitali — zimasonyeza chisamaliro mozama kuposa mmene mawu angafikire."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuqaan hundee kee ti. Harka dugda kee irra kaa'amu, hammannaa turu — jechoonni yeroo hundaa bira ga'uu kan hin dandeenye kunuunsa ibsa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ପର୍ଶ ହିଁ ଆପଣଙ୍କ ଭରସା। ପିଠିରେ ଏକ ହାତ, ଲମ୍ବା ଆଲିଙ୍ଗନ — ଏହା ଏମିତି ଯତ୍ନ ଜଣାଏ ଯାହା ଶବ୍ଦ ସବୁବେଳେ ପହଞ୍ଚିପାରେ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਛੋਹ ਤੁਹਾਡਾ ਸਹਾਰਾ ਹੈ। ਪਿੱਠ ਉੱਤੇ ਰੱਖਿਆ ਹੱਥ, ਲੰਮੀ ਜੱਫੀ — ਇਹ ਪਰਵਾਹ ਨੂੰ ਉੱਥੋਂ ਤੱਕ ਪਹੁੰਚਾਉਂਦੇ ਹਨ ਜਿੱਥੇ ਸ਼ਬਦ ਹਮੇਸ਼ਾ ਨਹੀਂ ਪਹੁੰਚ ਸਕਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk to twoja kotwica. Dłoń na plecach, długi uścisk – przekazują troskę tam, dokąd słowa nie zawsze sięgają."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس ستاسو د ډاډ لنګر دی. ستاسو پر شا یو لاس، یوه اوږده غېږ — دا پاملرنه په داسې کچه رسوي چې خبرې تل ورته نه رسېږي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é seu porto seguro. Uma mão nas costas, um abraço demorado — isso fala de cuidado num nível que as palavras nem sempre alcançam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é a tua âncora. Uma mão nas costas, um abraço que demora — transmite carinho a um nível que as palavras nem sempre alcançam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea e ancora ta. O mână pe spate, o îmbrățișare care durează — transmit grijă acolo unde cuvintele nu ajung mereu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновения — твоя опора. Ладонь на спине, долгие объятия — они говорят о заботе там, где слов не всегда хватает."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukoranaho ni bwo buhungiro bwawe. Ikiganza ku mugongo wawe, guhoberana birambye — bigaragaza urukundo ku rwego amagambo atabasha kugeraho buri gihe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ස්පර්ශය ඔබේ නැංගුරමයි. පිටට තබන අතක්, දිගු වෙලාවක් රැඳෙන බදාගැනීමක් — වචනවලට හැම වෙලේම යන්න බැරි තැනකට ඒවායින් සැලකිල්ල කියවෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk je tvoja kotva. Ruka na chrbte, dlhé objatie – vyjadrí starostlivosť tam, kam slová nie vždy dosiahnu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotik je tvoje sidro. Roka na hrbtu, objem, ki traja – skrb sporoči na ravni, do katere besede ne sežejo vedno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubatwa ndiko kunokudzikamisa. Ruoko pamusana pako, kumbundirwa kwenguva refu — zvinoratidza hanya padanho iro mazwi asingagoni kugara achisvika."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taabashadu waa barroosinkaaga. Gacan dhabarkaaga saaran, hab muddo socda — waxay daryeel ku gudbisaa heer aan erayadu mar walba gaarin karin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekja është spiranca jote. Një dorë mbi shpinë, një përqafim që zgjat – kjo e shpreh kujdesin aty ku fjalët s’arrijnë gjithmonë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додир је твоје сидро. Рука на леђима, загрљај који траје — то преноси бригу на нивоу до ког речи не допиру увек."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan téh jangkar anjeun. Leungeun dina tonggong, rangkulan anu lami — éta nepikeun kanyaah dina tingkat anu teu salawasna kahontal ku kecap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring är ditt ankare. En hand på ryggen, en kram som dröjer sig kvar – den visar omtanke på ett sätt som ord inte alltid når."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mguso ndio nanga yako. Mkono mgongoni, kumbatio linalodumu — huonyesha kujali kwa namna ambayo maneno hayawezi kufikia kila mara."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடுதலே உங்கள் நங்கூரம். முதுகில் ஒரு கை, நீண்ட அணைப்பு — வார்த்தைகள் எப்போதும் எட்ட முடியாத ஆழத்தில் அது அக்கறையைச் சொல்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్పర్శే మీకు ఆధారం. వీపు మీద ఒక చేయి, ఎక్కువసేపు ఉండే కౌగిలింత — మాటలు ఎప్పుడూ చేరలేని స్థాయిలో ఇవి శ్రద్ధను తెలియజేస్తాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ламс такягоҳи туст. Даст бар китф, оғӯше, ки дароз давом мекунад — ғамхориро дар сатҳе мерасонад, ки суханон на ҳамеша ба он мерасанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสคือที่ยึดเหนี่ยวของคุณ มือที่แตะหลังเบาๆ อ้อมกอดที่ยาวนาน สื่อถึงความห่วงใยได้ลึกซึ้งในแบบที่คำพูดอาจไปไม่ถึง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምትንካፍ መልሕቕኹም እዩ። ኣብ ሕቖኹም ዝዓረፈ ኢድ፣ ነዊሕ ዝጸንሕ ሕቝፊ — ቃላት ኩሉ ግዜ ክበጽሕዎ ዘይክእሉ ክንክን የመሓላልፍ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degmek seniň daýanjyň. Arkaňa goýlan el, uzak gujak — bu aladany sözleriň elmydama ýetip bilmeýän derejesinde beýan edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunuş sana en çok güven veren şey. Sırtına konan bir el, uzun süren bir sarılma… Sözlerin her zaman ulaşamadığı bir yerden şefkat anlatıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик — твоя опора. Рука на спині, довгі обійми — так турбота передається там, куди слова не завжди дістають."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمس آپ کا سہارا ہے۔ کمر پر رکھا ہاتھ، دیر تک رہنے والی جپھی — یہ اُس سطح پر پیار جتاتا ہے جہاں الفاظ ہمیشہ نہیں پہنچ پاتے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teginish — sizning tayanchingiz. Yelkangizga qoʻyilgan qoʻl, uzoq quchoq — bular soʻzlar har doim ham yetib borolmaydigan darajada gʻamxoʻrlikni bildiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm là điểm tựa của bạn. Một bàn tay đặt sau lưng, một cái ôm thật lâu — truyền tải sự quan tâm ở nơi lời nói không phải lúc nào cũng chạm tới."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuchukumisa yinkxaso yakho. Isandla emqolo wakho, ukwanga okuthatha ixesha — kubonisa inkathalo ngendlela amazwi angasoloko ekwazi ukuyifikelela."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìfọwọ́kàn ni òpó yín. Ọwọ́ lẹ́yìn yín, ìgbámọ́ra tó pẹ́ — ó ń fi ìtọ́jú hàn ní ọ̀nà tí ọ̀rọ̀ kì í fi gbogbo ìgbà dé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的定心丸。輕放在背上的手、一個長長的擁抱，傳達的關心往往是言語未必能及的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触碰让你安心。手轻轻放在你背上，一个久久的拥抱——它传递的在乎，有时是语言到不了的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的定心丸。輕放在背上的手、一個久久的擁抱，能傳達言語不一定到得了的關心。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuthintwa kuyisisekelo sakho. Isandla emhlane wakho, ukwanga okuthatha isikhathi — kudlulisa ukunakekela ngendlela amazwi angayifinyeleli njalo."
          }
        }
      }
    },
    "Touch speaks when energy is low but the mood is warm." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking praat as die energie laag maar die bui warm is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጉልበት ዝቅ ብሎ ስሜት ሞቅ ሲል ንክኪ ይናገራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة تتكلم حين تكون الطاقة منخفضة والمزاج دافئًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শক্তি কম কিন্তু মন উষ্ণ থাকিলে পৰশেই কথা কয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji az, əhval isə isti olanda toxunuş danışır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотык гаворыць, калі сіл мала, але на душы цёпла."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосването говори, когато енергията е ниска, но настроението е топло."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এনার্জি কম কিন্তু মন উষ্ণ থাকলে ছোঁয়াই কথা বলে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodir govori kad je energija niska, a raspoloženje toplo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tacte parla quan l'energia és baixa però l'ànim és càlid."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když chybí energie, ale nálada je vřelá, mluví dotek."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae cyffwrdd yn siarad pan fydd yr egni'n isel ond yr hwyliau'n gynnes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring taler, når energien er lav, men stemningen er varm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung spricht, wenn die Energie niedrig, aber die Stimmung warm ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα μιλάει όταν η ενέργεια είναι χαμηλή αλλά η διάθεση ζεστή."
          }
        },
        "es" : {
          "stringUnit" : {
