        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د پیزا په اړه یو دقیق دریځ. شاید د ژوند پر ډېرو پوښتنو همداسې مشروط فکر کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
