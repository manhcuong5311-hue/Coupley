        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এনার্জি আর হাতের কাছে সব। হেঁটে যাওয়ার সুবিধা, কোলাহল, আরাম চাও। শহরই তোমার স্বাভাবিক ঠিকানা।"
