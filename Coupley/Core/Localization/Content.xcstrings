        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyakorlatias és alkalmazkodó vagy. A legtöbb pénzügyi alkattal ki tudsz jönni, és ez erősség."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու գործնական ես ու հարմարվող։ Կարող ես յոլա գնալ փողի նկատմամբ գրեթե ցանկացած վերաբերմունքի հետ, և սա ուժ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu pragmatis dan mudah beradaptasi. Kamu bisa cocok dengan hampir semua tipe orang soal uang, dan itu kekuatan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ele ihe anya n'ụzọ bara uru ma na-agbanwe agbanwe. Ị nwere ike iso ọtụtụ ụdị mmadụ n'ihe gbasara ego rụkọọ ọrụ, nke ahụ bụ ike."
