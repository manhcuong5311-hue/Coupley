    "Worth knowing early — it shapes where you eat, what you cook, and potentially what your partner is willing to adapt to." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed om vroeg te weet – dit bepaal waar julle eet, wat julle kook en moontlik waarby jou maat bereid is om aan te pas."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀደም ብሎ ማወቅ ይጠቅማል — የት እንደሚበሉ፣ ምን እንደሚያበስሉ፣ አጋርዎ ምን ያህል ሊላመዱ ፈቃደኛ እንደሆኑም ይወስናል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من المهم معرفة ذلك مبكرًا، فهو يحدد أين تأكلان وماذا تطبخان، وربما ما يستعد شريكك للتكيّف معه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগতীয়াকৈ জনা ভাল — ই আপুনি ক'ত খায়, কি ৰান্ধে, আৰু সম্ভৱতঃ আপোনাৰ সংগীয়ে কিমান খাপ খুৱাবলৈ সাজু তাক গঢ় দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu erkən bilmək yaxşıdır — harada yediyinizə, nə bişirdiyinizə və bəlkə də partnyorunun nəyə uyğunlaşmağa hazır olduğuna təsir edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варта ведаць загадзя — гэта ўплывае на тое, дзе вы ясце, што гатуеце і да чаго палавінка гатовая падладзіцца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добре е да се знае отрано – влияе на това къде ядете, какво готвите и евентуално на какво е готова да се приспособи половинката ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগেভাগে জানা ভালো — কোথায় খাবে, কী রাঁধবে, আর তোমার পার্টনার কতটা মানিয়ে নিতে রাজি, সবকিছুতেই এর প্রভাব পড়ে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi znati rano – to oblikuje gdje jedete, šta kuhate i, možda, čemu je voljena osoba spremna da se prilagodi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Val la pena saber-ho aviat — determina on mengeu, què cuineu i potser fins on està disposada a adaptar-se la teva parella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dobré to vědět včas – ovlivňuje to, kde jíte, co vaříte, a možná i to, nakolik se tvůj protějšek přizpůsobí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae'n werth ei wybod yn gynnar — mae'n effeithio ar ble rydych chi'n bwyta, beth rydych chi'n ei goginio, ac o bosib faint mae dy bartner yn fodlon addasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt at vide tidligt – det former, hvor I spiser, hvad I laver, og måske hvad din partner er villig til at tilpasse sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut, das früh zu wissen – es prägt, wo ihr esst, was ihr kocht und vielleicht auch, worauf sich dein Schatz einstellen mag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλό είναι να ειπωθεί νωρίς — καθορίζει πού τρώτε, τι μαγειρεύετε και ίσως σε τι είναι διατεθειμένο να προσαρμοστεί το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conviene saberlo pronto — define dónde comen los dos, qué cocinan y, quizá, a qué está dispuesta a adaptarse tu pareja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasub varakult teada — see mõjutab, kus te sööte, mida te süüa teete ja võib-olla ka seda, millega su partner on valmis kohanema."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merezi du goiz jakitea — non jaten duzuen, zer prestatzen duzuen eta zure bikotekidea zertara moldatzeko prest dagoen baldintzatzen du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوب است زود دانسته شود — روی اینکه کجا غذا می‌خورید، چه می‌پزید و احتمالاً اینکه پارتنرت با چه چیزهایی کنار می‌آید اثر می‌گذارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvä tietää ajoissa – se vaikuttaa siihen, missä syötte, mitä kokkaatte ja ehkä siihen, mihin kumppanisi on valmis mukautumaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magandang malaman nang maaga — hinuhubog nito kung saan kayo kakain, ano ang lulutuin, at posibleng kung ano ang handang i-adjust ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon à savoir tôt : ça influence où vous mangez, ce que vous cuisinez, et peut-être jusqu'où l'autre acceptera de s'adapter."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is fiú é a bheith ar eolas go luath — múnlaíonn sé an áit a n-itheann sibh, an rud a chócarálann sibh, agus b'fhéidir an méid oiriúnaithe a bheidh do pháirtí sásta a dhéanamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convén sabelo pronto: determina onde comes, que cociñas e, posiblemente, a que estará disposta a adaptarse a túa parella."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વહેલું જાણવા જેવું — ક્યાં જમવું, શું રાંધવું અને કદાચ તમારા પાર્ટનર કેટલું અનુકૂળ થવા તૈયાર છે, એ બધું આના પર આધાર રાખે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya dace a sani tun da wuri — yana shafar inda kuke cin abinci, abin da kuke dafawa, da kuma abin da abokin zamanku zai iya amincewa ya daidaita da shi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לדעת את זה מוקדם — זה משפיע על איפה אוכלים, מה מבשלים, ואולי גם על מה שהצד השני יהיה מוכן להתאים את עצמו אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह शुरू में ही जान लेना अच्छा है — इसी से तय होता है कि कहाँ खाना है, क्या पकाना है, और शायद आपके पार्टनर को किन बातों में ढलना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi znati na vrijeme – to određuje gdje jedete, što kuhate i čemu je voljena osoba možda spremna prilagoditi se."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li bon pou konnen bonè — sa detèmine ki kote nou manje, sa nou kwit, e petèt sa patnè ou dispoze adapte l pou li."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt jó korán tisztázni – meghatározza, hol esztek, mit főztök, és hogy a párod mennyire hajlandó alkalmazkodni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արժե վաղ իմանալ — դա որոշում է, թե որտեղ եք ուտում, ինչ եք պատրաստում և, հնարավոր է, թե ինչին է զուգընկերդ պատրաստ հարմարվել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baik diketahui sejak awal — ini menentukan tempat makan, apa yang dimasak, dan mungkin seberapa jauh pasanganmu mau menyesuaikan diri."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ bara uru ịma n'oge — ọ na-ekpebi ebe unu na-eri nri, ihe ị na-esi, na ikekwe ihe onye gị dị njikere ịgbanwe maka ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gott að vita snemma – það mótar hvar þið borðið, hvað þið eldið og mögulega hverju makinn þinn er tilbúinn að laga sig að."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meglio saperlo presto — influenza dove mangiate, cosa cucinate e forse anche quanto il tuo partner è disposto ad adattarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早めに伝えておきたいこと。どこで食べるか、何を作るか、そしてパートナーがどこまで合わせられるかにも関わってきます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantes dimangerteni wiwit awal — iki nemtokake mangan ing ngendi, masak apa, lan bisa uga sepira pasangan gelem nyetel."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ღირს, ადრევე იცოდეთ — ეს განსაზღვრავს, სად ჭამთ, რას ამზადებთ და, შესაძლოა, რას მოერგება შენი პარტნიორი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ерте білген жөн — бұл қайда тамақтанатындарыңа, не пісіретіндеріңе және серігің неге бейімделуге дайын екеніне әсер етеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គួរដឹងតាំងពីដំបូង — វាកំណត់កន្លែងដែលអ្នកញ៉ាំ អ្វីដែលអ្នកធ្វើម្ហូប ហើយប្រហែលជាអ្វីដែលដៃគូរបស់អ្នកសុខចិត្តសម្របតាម។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬೇಗನೆ ತಿಳಿದಿರುವುದು ಒಳ್ಳೆಯದು — ನೀವು ಎಲ್ಲಿ ತಿನ್ನುತ್ತೀರಿ, ಏನು ಅಡುಗೆ ಮಾಡುತ್ತೀರಿ, ಮತ್ತು ನಿಮ್ಮ ಸಂಗಾತಿ ಎಷ್ಟು ಹೊಂದಿಕೊಳ್ಳಲು ಸಿದ್ಧರು ಎಂಬುದನ್ನು ಇದು ರೂಪಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일찍 알아 두면 좋아요. 어디서 먹을지, 무엇을 요리할지, 그리고 연인이 얼마나 맞춰 줄 수 있을지에도 영향을 주니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hêja ye ku zû bê zanîn — ev diyar dike tu li ku dixwî, çi çêdikî û belkî hevjînê te amade ye xwe li gorî çi biguncîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муну эрте билген жакшы — бул кайда тамактанарыңарды, эмне бышырарыңарды жана сүйгөнүң эмнеге ыңгайлашууга даяр экенин аныктайт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gutt, fréi ze wëssen — et bestëmmt, wou dir iesst, wat dir kacht, a vläicht och, wéi vill sech däi Schatz upasse wëll."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວນຮູ້ແຕ່ເນີ່ນໆ — ມັນກຳນົດວ່າຈະກິນໃສ, ເຮັດອາຫານຫຍັງ ແລະ ຄູ່ຂອງເຈົ້າພ້ອມຈະປັບຕົວແນວໃດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verta žinoti anksti – tai lemia, kur valgote, ką gaminate ir galbūt prie ko antroji pusė pasiruošusi prisitaikyti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vērts zināt laikus – tas nosaka, kur ēdat, ko gatavojat un, iespējams, kam otrā puse ir gatava pielāgoties."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendrika ho fantatra aloha — mamolavola ny toerana hisakafoananao, izay andrahoinao, ary mety ho izay vonona hifanarahan'ny olon-tianao izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pai kia mōhiotia moata — ka pā ki te wāhi e kai ai kōrua, ki āu e tunu ai, ā, tērā pea ki ngā mea ka urutau tō hoa aroha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вреди да се знае навреме — влијае каде јадете, што готвите и можеби на што е подготвена да се прилагоди половинката."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നേരത്തെ അറിയുന്നത് നല്ലതാണ് — നിങ്ങൾ എവിടെ കഴിക്കുന്നു, എന്ത് പാചകം ചെയ്യുന്നു, പങ്കാളി എത്രത്തോളം ഇണങ്ങാൻ തയ്യാറാണ് എന്നതെല്ലാം ഇത് സ്വാധീനിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эрт мэдэх нь зүйтэй — хаана хооллох, юу хийх, магадгүй хань чинь юунд дасан зохицоход бэлэн байгаа зэрэгт нөлөөлнө."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे लवकर माहीत असलेले बरे — तुम्ही कुठे जेवता, काय बनवता आणि जोडीदार कशाशी जुळवून घ्यायला तयार असेल, हे यावर ठरते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elok diketahui awal — ia menentukan tempat makan, apa yang dimasak, dan mungkin sejauh mana pasangan anda sanggup menyesuaikan diri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta' min tkun taf kmieni — jaffettwa fejn tieklu, x'issajru, u possibbilment kemm il-partner tiegħek lest li jadatta ruħu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စောစော သိထားသင့်တယ် — ဘယ်မှာ စားမလဲ၊ ဘာချက်မလဲ၊ ချစ်သူက ဘယ်လောက် လိုက်လျောမလဲဆိုတာကို ပုံဖော်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greit å vite tidlig – det former hvor dere spiser, hva dere lager, og kanskje hva partneren din er villig til å tilpasse seg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरुमै थाहा पाउनु राम्रो — यसले तपाईं कहाँ खानुहुन्छ, के पकाउनुहुन्छ, र पार्टनर कति मिलाउन तयार हुनुहुन्छ भन्नेमा असर गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed om vroeg te weten – het bepaalt waar je eet, wat je kookt en misschien waar je partner zich aan wil aanpassen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nchofunika kudziwa msanga — chimakhudza kumene mumadyera, zomwe mumaphika, ndipo mwina zomwe wokondedwa wanu angavomereze kusintha."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dursanii beekuun gaarii dha — bakka itti nyaattan, waan bilcheessitan, akkasumas jaalallee kee irraa walsimsiisuun hammam akka eegamu irratti dhiibbaa qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଗରୁ ଜାଣିବା ଭଲ — ଏହା ଆପଣ କେଉଁଠି ଖାଆନ୍ତି, କ'ଣ ରାନ୍ଧନ୍ତି, ଆଉ ହୁଏତ ଆପଣଙ୍କ ସାଥୀ କେତେ ଖାପ ଖୁଆଇବାକୁ ପ୍ରସ୍ତୁତ, ତାହା ସ୍ଥିର କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਛੇਤੀ ਜਾਣ ਲੈਣਾ ਚੰਗਾ ਹੈ — ਇਸ ਨਾਲ ਤੈਅ ਹੁੰਦਾ ਹੈ ਕਿ ਤੁਸੀਂ ਕਿੱਥੇ ਖਾਂਦੇ ਹੋ, ਕੀ ਬਣਾਉਂਦੇ ਹੋ, ਅਤੇ ਸ਼ਾਇਦ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਕਿੰਨਾ ਢਲਣ ਨੂੰ ਤਿਆਰ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warto o tym powiedzieć wcześnie – to wpływa na to, gdzie jecie, co gotujecie i do czego twoja druga połówka będzie chciała się dostosować."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ښه به وي له مخکې پرې پوه شئ — دا ټاکي چې چېرته خواړه خورئ، څه پخوئ، او ښايي ستاسو ملګری له څه سره ځان برابرولو ته چمتو وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale saber logo no começo — isso define onde vocês comem, o que cozinham e talvez o quanto seu amor topa se adaptar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a pena saber cedo — define onde comem, o que cozinham e, talvez, aquilo que o teu par aceita adaptar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E bine de știut devreme — influențează unde mâncați, ce gătiți și, poate, la ce e dispus partenerul tău să se adapteze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это лучше обсудить пораньше: от этого зависит, где вы едите, что готовите и насколько партнёру придётся подстраиваться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni byiza kubimenya kare — bigena aho murira, ibyo muteka, kandi wenda n'ibyo umukunzi wawe yiteguye kwihuza na byo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කලින්ම දැනගන්න වටිනවා — ඔබ කන තැන්, උයන දේ, සමහර විට ඔබේ සහකරු හැඩගැසෙන්න කැමති දේවලුත් ඒකෙන් තීරණය වෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplatí sa to vedieť včas – ovplyvňuje to, kde jete, čo varíte a možno aj to, čomu sa tvoja polovička je ochotná prispôsobiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vredno je vedeti zgodaj – vpliva na to, kje jesta, kaj kuhata in morda na to, čemu se je tvoj partner pripravljen prilagoditi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakakodzera kuziva nekukurumidza — zvinotara kwamunodyira, zvamunobika, uye pamwe zvinodiwa nemudiwa wako kuchinja."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waa mudan tahay in goor hore la ogaado — waxay qaabeysaa meesha aad wax ka cuntaan, waxa aad karisaan, iyo laga yaabee waxa lammaanahaagu diyaar u yahay inuu la qabsado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlen ta dini herët – ndikon ku hani, çfarë gatuani dhe ndoshta sa është gati partneri yt të përshtatet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вреди знати на време — то одређује где једете, шта кувате и, можда, на шта је твоја половина спремна да се прилагоди."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patut dipikanyaho ti awal — éta mangaruhan dimana aranjeun tuang, naon anu dimasak, sareng panginten naon anu daék disaluyukeun ku pasangan anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bra att veta tidigt – det styr var ni äter, vad ni lagar och kanske vad din partner är beredd att anpassa sig till."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni vyema kujua mapema — huathiri mnapokula, mnachopika, na huenda kile mwenzi wako yuko tayari kukizoea."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆரம்பத்திலேயே தெரிந்துகொள்வது நல்லது — எங்கே சாப்பிடுகிறீர்கள், என்ன சமைக்கிறீர்கள், உங்கள் துணை எதற்குப் பொருந்திக்கொள்ளத் தயாராக இருக்கிறார் என்பதையெல்லாம் இது தீர்மானிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ముందుగానే తెలుసుకోవడం మంచిది — మీరు ఎక్కడ తింటారో, ఏం వండుతారో, మీ భాగస్వామి ఎంతవరకు సర్దుకోవడానికి సిద్ధమో అది నిర్ణయిస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барвақт донистанаш муҳим аст — ин муайян мекунад, ки дар куҷо мехӯред, чӣ мепазед ва эҳтимол ёрат ба чӣ мутобиқ шуданро омода аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควรรู้กันตั้งแต่เนิ่นๆ เพราะเรื่องนี้กำหนดว่าจะไปกินที่ไหน ทำอาหารอะไร และอาจรวมถึงว่าคนรักพร้อมจะปรับตัวแค่ไหน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣቐዲምኩም ምፍላጡ ይጠቅም — ኣበይ ከም እትበልዑ፣ እንታይ ከም እትኽሽኑ፣ መጻምድኹም ድማ ክንደይ ክላመዱ ፍቓደኛታት ምዃኖም ይውስን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muny ir bilmäge degýär — bu nirede iýýändigiňize, näme bişirýändigiňize we söýgüliňiň näme uýgunlaşmaga taýýardygyna täsir edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenden bilinmesi iyi olur; nerede yediğini, ne pişirdiğini ve belki partnerinin neye uyum sağlamaya hazır olduğunu belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це варто знати одразу — від цього залежить, де ви їсте, що готуєте і до чого, можливо, готова пристосуватися твоя половинка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلد جان لینا اچھا ہے — اس سے طے ہوتا ہے کہ کہاں کھانا ہے، کیا پکانا ہے، اور شاید یہ بھی کہ آپ کا ساتھی کس حد تک خود کو ڈھالنے کو تیار ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buni erta bilgan yaxshi — u qayerda ovqatlanishingiz, nima pishirishingiz va, ehtimol, sherigingiz nimaga moslashishga tayyorligini belgilaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nên biết sớm — nó quyết định hai bạn ăn ở đâu, nấu món gì, và có thể cả việc người ấy sẵn lòng thay đổi đến đâu."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanelekile ukukwazi kwangoko — kumisela apho nitya khona, oko nikuphekayo, nokuba iqabane lakho lizimisele ukuziqhelanisa nantoni na."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó yẹ ní mímọ̀ ní kùtùkùtù — ó ń pinnu ibi tí ẹ ti ń jẹun, ohun tí ẹ ń sè, àti bóyá ohun tí olólùfẹ́ yín ṣetán láti bá mu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得及早知道，這會影響你們去哪裡吃、煮甚麼，也可能影響另一半願意調整多少。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好早点说清楚。它会影响你们去哪儿吃、在家做什么，也可能关系到另一半愿意配合多少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好早點讓對方知道，這會影響你們去哪吃、煮什麼，也關係到另一半願意調整多少。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanele kwaziwe kusenesikhathi — kuthinta lapho nidla khona, enikuphekayo, futhi mhlawumbe lokho umlingani wakho azimisele ukuzivumelanisa nakho."
          }
        }
      }
    },
    "Worth thinking about together. Supporting each other's wellbeing is one of the best things couples can do." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets om saam oor te dink. Om mekaar se welstand te ondersteun, is een van die beste dinge wat ’n paartjie kan doen."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አብራችሁ ልታስቡበት የሚገባ ነገር ነው። አንዳችሁ የሌላውን ደህንነት መደገፍ ጥንዶች ሊያደርጉት ከሚችሉት ምርጥ ነገሮች አንዱ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستحق التفكير فيه معًا. دعم كل منكما لعافية الآخر من أجمل ما يمكن أن يفعله الثنائي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুয়ো একেলগে ভাবি চোৱাৰ যোগ্য। ইজনে সিজনৰ সুস্থতাত সহায় কৰাটো যুগলে কৰিব পৰা আটাইতকৈ ভাল কামবোৰৰ এটা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikdə düşünməyə dəyər. Bir-birinizin rifahına dəstək olmaq cütlüklərin edə biləcəyi ən gözəl şeylərdən biridir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варта падумаць пра гэта разам. Клапаціцца пра самаадчуванне адно аднаго — адна з лепшых рэчаў, якія могуць рабіць пары."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Струва си да помислите заедно. Да подкрепяте взаимно благополучието си е едно от най-хубавите неща, които една двойка може да прави."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুজনে মিলে ভেবে দেখার মতো বিষয়। একে অপরের ভালো থাকায় পাশে থাকা জুটিদের করা সবচেয়ে ভালো কাজগুলোর একটা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi o tome razmisliti zajedno. Briga o dobrobiti jedno drugog jedna je od najboljih stvari koje par može raditi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Val la pena que hi penseu els dos. Donar-vos suport en el benestar és de les millors coses que pot fer una parella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stojí za to o tom přemýšlet spolu. Podporovat se navzájem v duševní pohodě je jedna z nejlepších věcí, které pár může dělat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwerth meddwl amdano gyda'ch gilydd. Cefnogi lles eich gilydd yw un o'r pethau gorau y gall cwpl ei wneud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værd at tænke over sammen. At støtte hinandens trivsel er noget af det bedste, et par kan gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denkt gemeinsam darüber nach. Sich gegenseitig beim Wohlbefinden zu unterstützen, gehört zum Besten, was ein Paar tun kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αξίζει να το σκεφτείτε μαζί. Το να στηρίζει ο ένας την ευεξία του άλλου είναι από τα καλύτερα που μπορεί να κάνει ένα ζευγάρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena pensarlo juntos. Apoyarse en el bienestar mutuo es de lo mejor que puede hacer una pareja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasub koos läbi mõelda. Teineteise heaolu toetamine on üks parimaid asju, mida paar teha saab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merezi du biok batera pentsatzea. Elkarren ongizatea zaintzea da bikote batek egin dezakeen gauzarik onenetako bat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارزش دارد با هم به آن فکر کنید. حمایت از حال خوب همدیگر یکی از بهترین کارهایی است که یک زوج می‌تواند بکند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä kannattaa miettiä yhdessä. Toistensa hyvinvoinnin tukeminen on parhaita asioita, mitä pari voi tehdä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magandang pag-isipan nang magkasama. Ang pagsuporta sa kapakanan ng isa’t isa ay isa sa pinakamagandang magagawa ng mag-partner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une piste à explorer ensemble. Prendre soin du bien-être l'un de l'autre est l'une des plus belles choses qu'un couple puisse faire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiú smaoineamh air le chéile. Tacú le folláine a chéile — sin ceann de na rudaí is fearr is féidir le lánúin a dhéanamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga a pena pensalo xuntos. Apoiar o benestar do outro é unha das mellores cousas que pode facer unha parella."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાથે બેસીને વિચારવા જેવું છે. એકબીજાની સુખાકારીમાં સાથ આપવો એ કપલ કરી શકે એવી સૌથી સારી વાતોમાંની એક છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abu ne da ya cancanci ku yi tunani a kai tare. Tallafa wa lafiyar juna na ɗaya daga cikin abubuwa mafi kyau da masoya za su iya yi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שווה לחשוב על זה יחד. לתמוך זה ברווחה של זה הוא אחד הדברים הכי טובים שזוג יכול לעשות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पर साथ मिलकर सोचना अच्छा रहेगा। एक-दूसरे की ख़ुशहाली में साथ देना, कपल के लिए सबसे अच्छी चीज़ों में से एक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi o tome razmisliti zajedno. Međusobna podrška u dobrobiti jedna je od najboljih stvari koje par može učiniti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa vo lapenn nou reflechi sou sa ansanm. Soutni byennèt youn lòt se youn nan pi bon bagay yon koup ka fè."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érdemes együtt átgondolni. Egymás jóllétének támogatása az egyik legjobb dolog, amit egy pár tehet."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արժե միասին մտածել այդ մասին։ Միմյանց բարեկեցությանն աջակցելը լավագույն բաներից է, որ զույգը կարող է անել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layak dipikirkan bersama. Saling mendukung kesejahteraan adalah salah satu hal terbaik yang bisa dilakukan pasangan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ bara uru iche ya echiche ọnụ. Ịkwado ọdịmma onwe unu bụ otu n'ime ihe kacha mma ndị hụrụ onwe ha n'anya nwere ike ime."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vert að skoða saman. Að styðja vellíðan hvort annars er eitt það besta sem pör geta gert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena pensarci insieme. Sostenere il benessere l’uno dell’altro è una delle cose migliori che una coppia possa fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで考えてみる価値があります。お互いの心身の健康を支え合うことは、カップルにできる最高のことのひとつです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantes dipikirake bareng. Nyengkuyung kasarasan siji lan sijine iku salah siji bab paling apik sing bisa ditindakake pasangan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ღირს, ამაზე ერთად იფიქროთ. ერთმანეთის კეთილდღეობის მხარდაჭერა ერთ-ერთი საუკეთესო რამაა, რისი გაკეთებაც წყვილს შეუძლია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл туралы бірге ойланған жөн. Бір-біріңнің саулығыңды қолдау — жұптардың жасай алатын ең жақсы істерінің бірі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គួរគិតរឿងនេះជាមួយគ្នា។ ការគាំទ្រសុខុមាលភាពរបស់គ្នាទៅវិញទៅមក ជារឿងល្អបំផុតមួយដែលគូស្នេហ៍អាចធ្វើបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದರ ಬಗ್ಗೆ ಇಬ್ಬರೂ ಜೊತೆಯಾಗಿ ಯೋಚಿಸಬಹುದು. ಒಬ್ಬರ ಯೋಗಕ್ಷೇಮವನ್ನು ಇನ್ನೊಬ್ಬರು ಬೆಂಬಲಿಸುವುದು ಜೋಡಿಗಳು ಮಾಡಬಹುದಾದ ಅತ್ಯುತ್ತಮ ಕೆಲಸಗಳಲ್ಲಿ ಒಂದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 생각해 보면 좋아요. 서로의 건강과 행복을 챙기는 건 커플이 할 수 있는 최고의 일 중 하나예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hêja ye ku hûn bi hev re li ser bifikirin. Piştgiriya başbûna hev yek ji tiştên herî baş e ku cot dikarin bikin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муну бирге ойлонуп көргүлө. Бири-бириңдин жыргалчылыгыңды колдоо — жуптар кыла ала турган эң жакшы нерселердин бири."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et lount sech, zesummen driwwer nozedenken. Sech géigesäiteg ze ënnerstëtzen, dass et engem gutt geet, ass ee vun de beschte Saachen, déi Koppele maache kënnen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເປັນເລື່ອງທີ່ຄວນຄິດນຳກັນ ການຊ່ວຍດູແລສຸຂະພາບໃຈຂອງກັນແລະກັນ ເປັນໜຶ່ງໃນສິ່ງທີ່ດີທີ່ສຸດທີ່ຄູ່ຮັກເຮັດໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verta apie tai pagalvoti kartu. Palaikyti vienas kito gerovę – vienas geriausių dalykų, kuriuos pora gali daryti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vērts par to padomāt kopā. Rūpēties par otra labsajūtu ir viens no labākajiem, ko pāris var darīt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendrika hodinihina miaraka. Ny fifanohanana amin'ny fahasalamana dia iray amin'ireo zavatra tsara indrindra azon'ny mpifankatia atao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mea pai hei whakaaro tahi. Ko te tautoko i te oranga o tētahi ki tētahi tētahi o ngā mea pai rawa ka taea e te tokorua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вреди да размислите заедно. Взаемната грижа за добросостојбата е едно од најубавите нешта што може да ги прави една двојка."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരുമിച്ച് ആലോചിക്കാവുന്ന കാര്യം. പരസ്പരം സൗഖ്യത്തിന് താങ്ങാകുന്നത് ജോഡികൾക്ക് ചെയ്യാവുന്ന ഏറ്റവും നല്ല കാര്യങ്ങളിൽ ഒന്നാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хамтдаа бодоод үзэх хэрэгтэй. Бие биеийнхээ сайн сайхныг дэмжих нь хосуудын хийж чадах хамгийн сайн зүйлсийн нэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यावर एकत्र विचार करण्यासारखे आहे. एकमेकांच्या स्वास्थ्याला साथ देणे, ही जोडप्याने करावी अशा सर्वोत्तम गोष्टींपैकी एक आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elok difikirkan bersama. Saling menyokong kesejahteraan antara perkara terbaik yang boleh dilakukan pasangan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta' min taħsbu flimkien. Li tappoġġjaw il-benessri ta' xulxin hija waħda mill-aħjar affarijiet li jistgħu jagħmlu l-koppji."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အတူတူ စဉ်းစားကြည့်သင့်တယ်။ တစ်ယောက်ရဲ့ ကျန်းမာချမ်းသာမှုကို တစ်ယောက် အားပေးတာက စုံတွဲတွေ လုပ်နိုင်တဲ့ အကောင်းဆုံးအရာတွေထဲက တစ်ခုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdt å tenke på sammen. Å støtte hverandres trivsel er noe av det beste et par kan gjøre."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सँगै सोच्न लायक कुरा। एकअर्काको स्वास्थ्य र खुसीमा साथ दिनु जोडीले गर्न सक्ने सबैभन्दा राम्रो काममध्ये एक हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed om samen over na te denken. Elkaars welzijn steunen is een van de mooiste dingen die je als stel kunt doen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndi bwino kuganizira zimenezi limodzi. Kuthandizana kuti aliyense akhale bwino ndi chimodzi mwa zinthu zabwino kwambiri zomwe okondana angachite."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waliin irratti yaaduun gaarii dha. Nagaa fi fayyaa wal deeggaruun waan jaalalleewwan gochuu danda'an keessaa isa filatamaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକାଠି ଭାବିବା ଭଳି କଥା। ପରସ୍ପରର ସୁସ୍ଥତାରେ ସାଥ ଦେବା ଯୁଗଳମାନେ କରିପାରୁଥିବା ସବୁଠାରୁ ଭଲ କାମ ମଧ୍ୟରୁ ଗୋଟିଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਬਾਰੇ ਇਕੱਠੇ ਸੋਚਣਾ ਚੰਗਾ ਰਹੇਗਾ। ਇੱਕ-ਦੂਜੇ ਦੀ ਭਲਾਈ ਦਾ ਖ਼ਿਆਲ ਰੱਖਣਾ ਜੋੜਿਆਂ ਲਈ ਸਭ ਤੋਂ ਵਧੀਆ ਕੰਮਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warto pomyśleć o tym razem. Wspieranie wzajemnego dobrostanu to jedna z najlepszych rzeczy, jakie para może dla siebie zrobić."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د دې په اړه یوځای فکر کول ارزښت لري. د یو بل د هوساینې ملاتړ یو له هغو تر ټولو ښو کارونو دی چې جوړې یې کولای شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale pensar nisso juntos. Apoiar o bem-estar um do outro é uma das melhores coisas que um casal pode fazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a pena pensarem nisto juntos. Apoiar o bem-estar um do outro é das melhores coisas que um casal pode fazer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merită să vă gândiți împreună. Să vă sprijiniți reciproc starea de bine e unul dintre cele mai bune lucruri pe care le poate face un cuplu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об этом стоит подумать вместе. Поддерживать благополучие друг друга — едва ли не лучшее, что может делать пара."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni byiza kubitekerezaho mwembi. Gushyigikirana ku mibereho myiza ni kimwe mu bintu byiza cyane abakundana bashobora gukora."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එකට හිතලා බලන්න වටිනවා. එකිනෙකාගේ යහපැවැත්මට සහාය දීම යුවළකට කරන්න පුළුවන් හොඳම දේවල් වලින් එකක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stojí za to porozmýšľať o tom spolu. Navzájom podporovať svoju pohodu je jedna z najlepších vecí, ktoré pár môže robiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tem je vredno razmisliti skupaj. Skrb za dobro počutje drug drugega je ena najlepših stvari, ki jih par lahko naredi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakakodzera kufunga nezvazvo pamwe chete. Kutsigira hutano hwemumwe nemumwe ndechimwe chezvinhu zvakanakisa zvinogona kuitwa nevadiwa vaviri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waa wax mudan inaad wadajir uga fikirtaan. Inaad isu taageertaan fayoobaanta waa mid ka mid ah waxyaabaha ugu wanaagsan ee lammaanayaashu samayn karaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia vlen ta mendoni bashkë. Të mbështesësh mirëqenien e njëri-tjetrit është nga gjërat më të mira që mund të bëjë një çift."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вредно је да о томе размислите заједно. Да подржавате једно друго у бризи о себи — то је једна од најбољих ствари које пар може да уради."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saé dipikirkeun babarengan. Silih rojong kana karaharjaan masing-masing téh salah sahiji hal pangsaéna anu tiasa dilakukeun ku pasangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värt att fundera på tillsammans. Att stötta varandras välmående är något av det bästa ett par kan göra."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inafaa kulifikiria pamoja. Kusaidiana katika ustawi wa kila mmoja ni mojawapo ya mambo bora ambayo wenzi wanaweza kufanya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதைப் பற்றி இருவரும் சேர்ந்து யோசிக்கலாம். ஒருவர் நலனை ஒருவர் ஆதரிப்பது, ஜோடிகள் செய்யக்கூடிய மிகச் சிறந்த விஷயங்களில் ஒன்று."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కలిసి ఆలోచించాల్సిన విషయం. ఒకరి శ్రేయస్సుకు ఒకరు అండగా ఉండటం జంటలు చేయగల ఉత్తమమైన పనుల్లో ఒకటి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арзад, ки якҷоя дар ин бора фикр кунед. Дастгирии саломатии ҳамдигар яке аз беҳтарин корҳоест, ки ҷуфт карда метавонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น่าคิดเรื่องนี้ไปด้วยกัน การดูแลความเป็นอยู่ที่ดีของกันและกันคือหนึ่งในสิ่งที่ดีที่สุดที่คู่รักทำให้กันได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብሓባር ክሕሰበሉ ዝግባእ። ንደሓንነት ሓድሕድ ምድጋፍ ጽምድታት ክገብርዎ ካብ ዝኽእሉ ዝበለጹ ነገራት ሓደ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu barada bile pikirlenmäge degýär. Biri-biriňiziň saglygyny goldamak jübütleriň edip biljek iň gowy zatlarynyň biri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte düşünmeye değer. Birbirinin iyi oluşunu desteklemek, çiftlerin yapabileceği en güzel şeylerden biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варто подумати про це разом. Дбати про самопочуття одне одного — одна з найкращих речей, які може робити пара."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس پر مل کر سوچنا اچھا رہے گا۔ ایک دوسرے کی صحت اور خوشحالی کا خیال رکھنا جوڑوں کے لیے بہترین کاموں میں سے ایک ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haqda birga oʻylab koʻrishga arziydi. Bir-biringizning farovonligini qoʻllab-quvvatlash — juftliklar qila oladigan eng yaxshi ishlardan biri."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đáng để hai bạn cùng nghĩ. Chăm lo cho sức khỏe tinh thần của nhau là một trong những điều tuyệt nhất các cặp đôi có thể làm."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanelekile ukucinga ngako kunye. Ukuxhasana kwimpilo-ntle yomnye nomnye yenye yezona zinto zintle isibini esinokuzenza."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó yẹ kí ẹ jọ ronú nípa rẹ̀. Títi ara yín lẹ́yìn fún àlàáfíà ara àti ọkàn wà lára ohun tó dára jù tí olólùfẹ́ méjì lè ṣe."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得一起想想。互相照顧彼此的身心健康，是情侶能為對方做的最好的事之一。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得一起想一想。互相照顾彼此的身心状态，是情侣能为彼此做的最好的事之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值得兩人一起想想。支持彼此的身心健康，是情侶能為彼此做的最好的事之一。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanele nicabange ngakho ndawonye. Ukusekelana enhlalakahleni kungenye yezinto ezinhle kakhulu imibhangqwana engazenza."
          }
        }
      }
    },
