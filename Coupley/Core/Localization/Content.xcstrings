            "value" : "Hizmet davranışları"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Турботливі справи"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hành động quan tâm"
