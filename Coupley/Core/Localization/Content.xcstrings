    "Sleep affects mood, patience, and how available you are as a partner." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap raak jou bui, jou geduld en hoe beskikbaar jy as maat is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንቅልፍ በስሜት፣ በትዕግስትና እንደ አጋር ምን ያህል እንደሚገኙ ላይ ተጽዕኖ ያሳድራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوم يؤثر في المزاج والصبر ومدى حضورك كشريك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টোপনিয়ে মন, ধৈৰ্য আৰু সংগী হিচাপে আপুনি কিমান উপস্থিত থাকিব পাৰে তাৰ ওপৰত প্ৰভাৱ পেলায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuxu əhvala, səbrə və partnyor kimi nə qədər yanında ola bildiyinə təsir edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон уплывае на настрой, цярплівасць і на тое, колькі ў цябе сіл на адносіны."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сънят влияе на настроението, търпението и на това колко си на разположение като половинка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘুম তোমার মুড, ধৈর্য আর পার্টনার হিসেবে তুমি কতটা পাশে থাকতে পারো — সবকিছুর ওপর প্রভাব ফেলে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San utiče na raspoloženje, strpljenje i na to koliko možeš biti tu za voljenu osobu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El son afecta l'humor, la paciència i com de disponible estàs per a la teva parella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek ovlivňuje náladu, trpělivost i to, nakolik můžeš být protějšku k dispozici."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae cwsg yn effeithio ar hwyliau, amynedd, a pha mor bresennol wyt ti fel partner."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvn påvirker humør, tålmodighed og hvor nærværende du kan være som partner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf beeinflusst Stimmung, Geduld und wie präsent du in der Beziehung bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος επηρεάζει τη διάθεση, την υπομονή και το πόση ενέργεια έχεις για το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño afecta al ánimo, a la paciencia y a cuánto puedes estar para tu pareja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
