    "Keep expectations small. Don't plan — just share the couch." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعلوا التوقعات بسيطة. لا تخططوا، فقط تشاركوا الأريكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná velká očekávání. Nic neplánuj – jen se dělte o gauč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold forventningerne små. Planlæg ikke noget – del bare sofaen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Erwartungen klein. Nichts planen – einfach zusammen aufs Sofa."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα τις προσδοκίες μικρές. Μην κανονίσεις τίποτα — απλώς μοιραστείτε τον καναπέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expectativas bajas. Nada de planes: solo compartir el sofá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä odotukset pieninä. Älä suunnittele – jakakaa vain sohva."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gawing maliit ang inaasahan. Huwag magplano — magsalo lang sa sopa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de grandes attentes. Rien à prévoir : partagez juste le canapé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשמור על ציפיות קטנות. בלי תוכניות — רק לחלוק את הספה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उम्मीदें छोटी रखें। कोई प्लान नहीं — बस सोफ़ा साझा करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legyenek kicsik az elvárások. Ne tervezz – csak osszátok meg a kanapét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan berharap banyak. Tak usah rencana — cukup berbagi sofa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspettative basse. Niente piani — dividete il divano e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期待は小さく。予定は立てずに、ただ一緒にソファでくつろぎましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기대는 작게, 계획은 없이. 그냥 소파에서 함께 쉬세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan letak harapan tinggi. Tak perlu merancang — duduk saja bersama di sofa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold forventningene små. Ikke planlegg – bare del sofaen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de verwachtingen klein. Plan niks – deel gewoon de bank."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie nastawiaj się na wiele. Nic nie planuj – po prostu dzielcie kanapę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expectativas pequenas. Nada de planos — só dividam o sofá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu avea așteptări mari. Nu plănui nimic — doar împărțiți canapeaua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никаких больших ожиданий. Ничего не планируй — просто устройтесь вместе на диване."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll förväntningarna låga. Planera inget – dela bara soffan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องคาดหวังเยอะ ไม่ต้องวางแผน แค่นั่งโซฟาด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beklentileri küçük tut. Plan yapma, sadece kanepeyi paylaşın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без великих очікувань. Нічого не плануй — просто посидьте разом на дивані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng kỳ vọng nhiều. Không cần kế hoạch — chỉ cần ngồi chung ghế sofa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别抱太多期待，也不用计划，一起窝在沙发上就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低期待，不用計畫什麼，一起窩在沙發上就好。"
          }
        }
      }
    },
