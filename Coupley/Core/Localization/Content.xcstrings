        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух і свежае паветра праясняюць галаву. Калі вы ідзяце побач, а не сядзіце тварам да твару, лягчэй раскрыцца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движението и свежият въздух ти прочистват главата. Рамо до рамо, а не лице в лице, е по-лесно да се отвориш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হাঁটাচলা আর খোলা হাওয়া তোমার মাথা হালকা করে। মুখোমুখি নয়, পাশাপাশি থাকলে মন খোলা সহজ হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje i svjež zrak razbistre ti glavu. Kad ste jedno pored drugog, a ne licem u lice, lakše se otvoriš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moure't i l'aire fresc t'aclareixen el cap. Caminar colze a colze, no cara a cara, fa que costi menys obrir-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb a čerstvý vzduch ti vyčistí hlavu. Když jdete bok po boku, ne tváří v tvář, snáz se otevřeš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae symud ac awyr iach yn clirio dy ben. Mae bod ochr yn ochr, nid wyneb yn wyneb, yn ei gwneud hi'n haws agor dy galon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse og frisk luft klarer dit hoved. Når I går side om side i stedet for ansigt til ansigt, er det lettere at åbne op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung und frische Luft machen deinen Kopf frei. Nebeneinander statt gegenüber fällt es dir leichter, dich zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση και ο καθαρός αέρας σού καθαρίζουν το μυαλό. Δίπλα δίπλα κι όχι πρόσωπο με πρόσωπο, ανοίγεσαι πιο εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moverte y tomar aire te despeja la mente. Caminar lado a lado, no cara a cara, hace que sea más fácil abrirse."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikumine ja värske õhk teevad pea selgeks. Kõrvuti, mitte silmast silma olles on lihtsam avaneda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mugimenduak eta aire freskoak burua garbitzen dizute. Alboz albo egoteak, aurrez aurre beharrean, errazago irekitzen laguntzen dizu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت و هوای تازه ذهنت را باز می‌کند. کنار هم بودن، نه رودررو، باز کردن سفرهٔ دل را راحت‌تر می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liike ja raitis ilma selkeyttävät ajatuksia. Kun kuljette rinnakkain eikä kasvokkain, on helpompi avautua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nililinaw ng paggalaw at sariwang hangin ang isip mo. Mas madali kang magbukas kapag magkatabi kayo, hindi magkaharap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouger et prendre l'air t'aident à y voir clair. Marcher côte à côte plutôt que face à face rend la confidence plus facile."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glanann gluaiseacht agus aer úr do cheann. Agus sibh taobh le taobh seachas aghaidh ar aghaidh, is fusa do chroí a oscailt."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moverte e tomar o aire aclárache a cabeza. Ir lado a lado, non cara a cara, fai que sexa máis doado abrirse."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હલનચલન અને તાજી હવા મન સાફ કરી દે છે. સામસામે નહીં, પણ બાજુબાજુમાં ચાલતાં દિલ ખોલવું સહેલું બને છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motsi da iska mai daɗi suna wanke tunaninku. Tafiya kafaɗa da kafaɗa, ba fuska da fuska ba, na sauƙaƙa buɗe zuciya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה ואוויר צח מנקים לך את הראש. כשהולכים זה לצד זה ולא פנים מול פנים, קל יותר להיפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलना-फिरना और ताज़ी हवा आपका मन साफ़ कर देते हैं। आमने-सामने नहीं, कंधे से कंधा मिलाकर चलते हुए दिल की बात कहना आसान हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje i svjež zrak razbistre ti glavu. Kad hodate rame uz rame, a ne sjedite licem u lice, lakše se otvaraš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouvman ak bon lè fre netwaye tèt ou. Lè nou kòt a kòt, pa fas a fas, li pi fasil pou ou louvri kè ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozgás és a friss levegő kitisztítja a fejed. Egymás mellett, nem szemtől szemben könnyebb megnyílni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շարժումն ու մաքուր օդը պարզեցնում են մտքերդ։ Կողք կողքի, ոչ թե դեմ դիմաց լինելը հեշտացնում է սիրտդ բացելը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak dan udara segar menjernihkan pikiranmu. Berjalan berdampingan, bukan berhadapan, membuatmu lebih mudah terbuka."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ije na ikuku ọhụrụ na-eme ka uche gị doo anya. Ịnọ n'akụkụ ibe unu, ọ bụghị ihu na ihu, na-eme ka ọ dị mfe ikwupụta ihe dị n'obi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hreyfing og ferskt loft hreinsa hugann. Að ganga hlið við hlið, frekar en að sitja augliti til auglitis, gerir auðveldara að opna sig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoverti e prendere aria ti schiarisce le idee. Stare fianco a fianco, invece che faccia a faccia, rende più facile aprirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を動かし外の空気を吸うと、頭がすっきりします。向かい合うより並んで歩くほうが、素直に話しやすくなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obah lan hawa seger nggawe pikiran padhang. Jejer-jejeran, dudu adhep-adhepan, nggawe luwih gampang mbukak ati."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოძრაობა და სუფთა ჰაერი გონებას გინათებს. როცა გვერდიგვერდ ხართ და არა პირისპირ, გულის გახსნა უფრო ადვილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қозғалыс пен таза ауа ойыңды сергітеді. Бетпе-бет емес, қатар жүргенде ашылу оңайырақ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចលនា និងខ្យល់អាកាសបរិសុទ្ធជួយឲ្យចិត្តអ្នកស្រឡះ។ ការដើរទន្ទឹមគ្នា ជាជាងអង្គុយទល់មុខគ្នា ធ្វើឲ្យងាយបើកចិត្តនិយាយជាង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಡಿಗೆ ಮತ್ತು ತಾಜಾ ಗಾಳಿ ನಿಮ್ಮ ತಲೆಯನ್ನು ಹಗುರಾಗಿಸುತ್ತವೆ. ಮುಖಾಮುಖಿಯಾಗಿ ಅಲ್ಲ, ಪಕ್ಕಪಕ್ಕದಲ್ಲಿ ಇರುವಾಗ ಮನಸ್ಸು ಬಿಚ್ಚಿಡುವುದು ಸುಲಭ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸을 움직이고 바람을 쐬면 머리가 맑아져요. 마주 보기보다 나란히 걸을 때 마음을 열기가 더 쉬워요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tevger û hewaya paqij serê te zelal dikin. Dema hûn li kêleka hev in, ne rû bi rû, vekirina dilê xwe hêsantir e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кыймыл жана таза аба башыңды тазалайт. Бетме-бет эмес, жанаша басканда жүрөгүңдү ачуу оңой."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweegung a frësch Loft maachen de Kapp fräi. Niewenteneen ze goen amplaz vis-à-vis ze sëtze mécht et méi einfach, sech opzemaachen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເຄື່ອນໄຫວ ແລະ ອາກາດສົດຊື່ນຊ່ວຍໃຫ້ຫົວໂລ່ງ ການຍ່າງຄຽງຂ້າງກັນ ບໍ່ແມ່ນນັ່ງປະເຊີນໜ້າ ເຮັດໃຫ້ເປີດໃຈໄດ້ງ່າຍຂຶ້ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judėjimas ir grynas oras praskaidrina galvą. Kai einate greta, o ne sėdite akis į akį, lengviau atsiverti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kustība un svaigs gaiss noskaidro galvu. Iet blakus, nevis sēdēt pretī, – tā ir vieglāk atvērties."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fihetsehana sy ny rivotra madio no manazava ny sainao. Ny mifanila, fa tsy mifanatrika, dia manamora ny fanokafana ny fo."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te nekeneke me te hau hou e mārama ai tō hinengaro. Ina noho tahi kōrua i te taha, kaua e anga kanohi ana, ka māmā ake te whakapuaki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движењето и свежиот воздух ти ја чистат главата. Кога сте рамо до рамо, а не лице в лице, полесно се отвораш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നടത്തവും ശുദ്ധവായുവും നിങ്ങളുടെ മനസ്സ് തെളിക്കുന്നു. മുഖാമുഖം ഇരിക്കുന്നതിനെക്കാൾ, തോളോടുതോൾ ചേർന്ന് നടക്കുമ്പോൾ മനസ്സ് തുറക്കാൻ എളുപ്പമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөдөлгөөн, цэвэр агаар толгойг чинь сэргээдэг. Нүүр тулах биш, зэрэгцэн алхах нь сэтгэлээ нээхэд хялбар болгодог."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हालचाल आणि मोकळी हवा तुमचे मन हलके करतात. समोरासमोर नव्हे, तर शेजारी शेजारी चालताना मन मोकळे करणे सोपे जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak dan udara segar menjernihkan fikiran anda. Berjalan bersebelahan, bukan bertentang muka, memudahkan anda untuk meluahkan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iċ-ċaqliq u l-arja friska jċċarawlek moħħok. Meta tkunu ħdejn xulxin, mhux wiċċ imb wiċċ, ikun aktar faċli tiftaħ qalbek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လှုပ်ရှားမှုနဲ့ လေကောင်းလေသန့်က သင့်ခေါင်းကို ကြည်လင်စေတယ်။ မျက်နှာချင်းဆိုင် မဟုတ်ဘဲ ဘေးချင်းယှဉ်နေတာက ရင်ဖွင့်ရတာ ပိုလွယ်စေတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse og frisk luft klarner hodet. Når dere går side om side i stedet for ansikt til ansikt, er det lettere å åpne seg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिँडडुल र ताजा हावाले तपाईंको दिमाग हलुका बनाउँछ। आमनेसामने होइन, छेउछेउमा हुँदा मन खोल्न सजिलो हुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging en frisse lucht maken je hoofd leeg. Naast elkaar lopen in plaats van tegenover elkaar zitten maakt het makkelijker om je open te stellen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuyenda ndi mpweya wabwino zimatsitsimutsa mutu wanu. Kukhala mbali ndi mbali, osati moyang'anana, kumapangitsa kukhala kosavuta kutsegula mtima."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sochiin fi qilleensi qulqulluun sammuu kee qulqulleessa. Fuula walitti garagalchuu osoo hin taane, cinaa walii deemuun garaa banachuu salphisa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚାଲିବା ଓ ଖୋଲା ପବନ ଆପଣଙ୍କ ମନ ସଫା କରେ। ମୁହାଁମୁହିଁ ନୁହେଁ, ପାଖାପାଖି ଚାଲିଲେ ମନ ଖୋଲି କହିବା ସହଜ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਰਨ-ਫਿਰਨ ਅਤੇ ਤਾਜ਼ੀ ਹਵਾ ਨਾਲ ਤੁਹਾਡਾ ਮਨ ਸਾਫ਼ ਹੁੰਦਾ ਹੈ। ਆਹਮੋ-ਸਾਹਮਣੇ ਨਹੀਂ, ਨਾਲ-ਨਾਲ ਤੁਰਦਿਆਂ ਦਿਲ ਦੀ ਗੱਲ ਕਹਿਣੀ ਸੌਖੀ ਹੋ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch i świeże powietrze oczyszczają ci głowę. Łatwiej się otworzyć, idąc ramię w ramię, a nie twarzą w twarz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت او تازه هوا ستاسو ذهن روښانه کوي. اوږه په اوږه، نه مخامخ، د زړه خبرې اسانه کېږي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento e ar fresco clareiam sua mente. Lado a lado, e não frente a frente, fica mais fácil se abrir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movimento e o ar fresco limpam-te a cabeça. Estar lado a lado, e não frente a frente, torna mais fácil abrir o coração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcarea și aerul curat îți limpezesc mintea. Umăr lângă umăr, nu față în față, îți vine mai ușor să te deschizi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение и свежий воздух проясняют голову. Когда вы идёте бок о бок, а не сидите лицом к лицу, открыться проще."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugenda no guhumeka umwuka mwiza bigutuza umutwe. Kuba muri iruhande rw'undi, aho kurebana mu maso, byoroshya kuvuga ibikuri ku mutima."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "චලනය සහ නැවුම් වාතය ඔබේ හිත පැහැදිලි කරනවා. මුහුණට මුහුණ නෙවෙයි, පැත්තට පැත්තෙන් ඉන්නකොට හිත විවෘත කරන්න ලේසියි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb a čerstvý vzduch ti vyčistia hlavu. Keď idete bok po boku, a nie tvárou v tvár, ľahšie sa otvoríš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibanje in svež zrak ti zbistrita misli. Ko hodita drug ob drugem, ne iz oči v oči, se lažje odpreš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufamba nemhepo yakachena zvinojekesa pfungwa dzako. Kufamba muri parutivi, kwete makatarisana, kunoita kuti zvive nyore kutaura zviri mumwoyo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhaqdhaqaaqa iyo hawada nadiifta ah ayaa maskaxdaada caddeeya. Dhinac-dhinac u socodka, halkii aad is wajihi lahaydeen, ayaa sahla in qalbiga la furo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lëvizja dhe ajri i pastër ta qartësojnë mendjen. Kur jeni krah për krah e jo ballë për ballë, është më e lehtë të hapesh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кретање и свеж ваздух ти бистре главу. Кад сте једно поред другог, а не лицем у лице, лакше је отворити се."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerak sareng hawa seger ngabersihan pikiran anjeun. Leumpang sisi-sisian, sanés papayun-payun, ngajantenkeun anjeun langkung gampil muka haté."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse och frisk luft rensar huvudet. Att gå sida vid sida, inte ansikte mot ansikte, gör det lättare att öppna sig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutembea na hewa safi husafisha akili yako. Kuwa bega kwa bega, si uso kwa uso, hurahisisha kufunguka."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நடப்பதும் சுத்தமான காற்றும் உங்கள் மனதைத் தெளிவாக்குகின்றன. நேருக்கு நேர் அல்லாமல் பக்கம் பக்கமாக இருப்பது மனம் திறந்து பேசுவதை எளிதாக்குகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కదలిక, తాజా గాలి మీ మనసును తేలిక చేస్తాయి. ఎదురెదురుగా కాకుండా పక్కపక్కనే ఉంటే మనసు విప్పడం సులభం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳаракат ва ҳавои тоза сари туро соф мекунад. Паҳлӯ ба паҳлӯ будан, на рӯ ба рӯ, кушода шуданро осон мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขยับตัวและอากาศบริสุทธิ์ช่วยให้หัวโล่ง การเดินเคียงข้างกันแทนการนั่งหันหน้าเข้าหากันทำให้เปิดใจได้ง่ายขึ้น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምንቅስቓስን ንጹህ ኣየርን ኣእምሮኹም የጽርዩ። ገጽ ንገጽ ዘይኮነስ ጎኒ ንጎኒ ምኻድ ልብኹም ንምኽፋት የቃልል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hereket we arassa howa kelläňi arassalaýar. Ýüzbe-ýüz däl-de, ýanaşyk bolmak açylmagy aňsatlaşdyrýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket ve temiz hava kafanı açıyor. Karşı karşıya değil yan yana olmak, içini açmayı kolaylaştırıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух і свіже повітря прочищають голову. Коли ви йдете пліч-о-пліч, а не сидите віч-на-віч, легше відкритися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت اور تازہ ہوا آپ کا ذہن صاف کر دیتی ہے۔ آمنے سامنے کے بجائے ساتھ ساتھ چلتے ہوئے دل کی بات کہنا آسان ہو جاتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harakat va toza havo fikrni tiniqlashtiradi. Yuzma-yuz emas, yonma-yon boʻlganda dilni ochish osonroq."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động và không khí trong lành giúp đầu óc bạn thông thoáng. Đi cạnh nhau thay vì đối diện khiến việc mở lòng dễ dàng hơn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukushukuma nomoya opholileyo kucacisa ingqondo yakho. Ukuba ecaleni komnye, hayi ubuso nobuso, kwenza kube lula ukuvula intliziyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn àti atẹ́gùn tútù ń mú orí yín mọ́. Rírìn lẹ́gbẹ̀ẹ́ ara yín, dípò kí ẹ dojú kọ ara yín, ń jẹ́ kí ó rọrùn láti ṣí ọkàn payá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走走路、吹吹風，讓你頭腦清醒。並肩而行而不是面對面，反而更容易打開心扉。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走走路、吹吹风，脑子就清醒了。肩并肩而不是面对面，更容易敞开心扉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走走路、吹吹風，讓你腦袋清醒。肩並肩而不是面對面，反而更容易敞開心。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunyakaza nomoya ohlanzekile kuyakucacisa ingqondo. Ukuhamba eceleni komunye, ningabhekene ubuso nobuso, kwenza kube lula ukuvula inhliziyo."
          }
        }
      }
    },
    "Movement as medicine. Your mood, energy, and stress are closely tied to whether you've moved your body. A partner should know this." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging as medisyne. Jou bui, energie en stres hang nou saam met of jy jou lyf beweeg het. ’n Maat moet dit weet."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንቅስቃሴ እንደ መድኃኒት። ስሜትዎ፣ ጉልበትዎና ጭንቀትዎ ሰውነትዎን ከማንቀሳቀስዎ ጋር በቅርበት የተያያዙ ናቸው። አጋርዎ ይህን ማወቅ አለባቸው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركة دواء. مزاجك وطاقتك وتوترك مرتبطة جدًا بتحريك جسدك، ومن المفيد أن يعرف الشريك ذلك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শৰীৰ চলোৱাটোৱেই ঔষধ। আপোনাৰ মন, শক্তি আৰু চাপ — সকলো আপুনি শৰীৰ চলাইছে নে নাই তাৰ লগত জড়িত। সংগীয়ে এই কথা জনা উচিত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hərəkət dərmandır. Əhvalın, enerjin və stresin bədənini hərəkət etdirib-etdirmədiyinlə sıx bağlıdır. Partnyorun bunu bilməlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух як лекі. Твой настрой, энергія і стрэс моцна залежаць ад таго, ці рухаешся ты. Палавінцы варта гэта ведаць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движението е лекарство. Настроението, енергията и стресът ти са тясно свързани с това дали тялото ти е получило движение. Половинката ти трябва да го знае."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নড়াচড়াই তোমার ওষুধ। তোমার মুড, এনার্জি আর স্ট্রেস অনেকটাই নির্ভর করে শরীর নাড়ানো হয়েছে কি না তার ওপর। পার্টনারের এটা জানা উচিত।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje kao lijek. Raspoloženje, energija i stres usko ti zavise od toga koliko se krećeš. Tvoja voljena osoba to treba znati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El moviment com a medicina. El teu humor, la teva energia i el teu estrès depenen molt de si has mogut el cos. La teva parella ho hauria de saber."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb jako lék. Tvoje nálada, energie i stres úzce souvisí s tím, jestli se hýbeš. Protějšek by to měl vědět."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symud fel moddion. Mae dy hwyliau, dy egni a dy straen ynghlwm wrth p'un a wyt ti wedi symud dy gorff. Dylai partner wybod hyn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse som medicin. Dit humør, din energi og dit stressniveau hænger tæt sammen med, om du har rørt dig. Det bør en partner vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung als Medizin. Deine Stimmung, Energie und dein Stresslevel hängen eng davon ab, ob du dich bewegt hast. Das sollte dein Schatz wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση ως φάρμακο. Η διάθεση, η ενέργεια και το άγχος σου εξαρτώνται πολύ από το αν έχεις κινηθεί. Καλό είναι να το ξέρει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento como medicina. Tu ánimo, tu energía y tu estrés dependen mucho de si te has movido. Tu pareja debería saberlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikumine on ravim. Sinu tuju, energia ja stress sõltuvad suuresti sellest, kas oled end liigutanud. Partner peaks seda teadma."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mugimendua sendagai. Zure aldartea, energia eta estresa lotuta daude gorputza mugitu duzun ala ez. Bikotekideak hori jakin beharko luke."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت به‌عنوان دارو. حس‌وحال، انرژی و استرست به اینکه بدنت را تکان داده‌ای یا نه بستگی زیادی دارد. پارتنرت باید این را بداند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liike on lääkettä. Mielialasi, energiasi ja stressisi riippuvat paljon siitä, oletko liikkunut. Kumppanin kannattaa tietää tämä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galaw bilang gamot. Malaki ang epekto sa mood, lakas, at stress mo kung nakagalaw ka ba o hindi. Dapat itong malaman ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement comme remède. Ton humeur, ton énergie et ton stress dépendent beaucoup du fait d'avoir bougé ou non. L'autre devrait le savoir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gluaiseacht mar leigheas. Tá do ghiúmar, d’fhuinneamh agus do strus ceangailte go dlúth le cé acu a bhog tú do chorp nó nár bhog. Ba cheart go mbeadh a fhios sin ag do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movemento como medicina. O teu ánimo, a túa enerxía e o teu estrés dependen moito de se moviches o corpo. A túa parella debería sabelo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હલનચલન એ જ દવા. તમારો મૂડ, ઊર્જા અને ટેન્શન — બધું શરીર હલાવ્યું કે નહીં એના પર ઘણું આધાર રાખે છે. પાર્ટનરે આ જાણવું જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motsa jiki magani ne. Yanayinku, kuzarinku da damuwarku na da alaƙa sosai da ko kun motsa jiki. Wannan abin sani ne ga abokin zamanku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה כתרופה. מצב הרוח, האנרגיה והלחץ שלך קשורים מאוד לשאלה אם הזזת את הגוף. כדאי שהצד השני ידע את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिलना-डुलना ही दवा है। आपका मूड, ऊर्जा और तनाव इस बात से गहराई से जुड़े हैं कि शरीर को कितना चलाया। पार्टनर को यह पता होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje kao lijek. Raspoloženje, energija i stres usko ti ovise o tome koliko se krećeš. Voljena osoba to treba znati."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouvman se remèd ou. Imè ou, enèji ou ak estrès ou depann anpil de si ou te fè kò ou bouje. Yon patnè ta dwe konnen sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozgás a gyógyszered. A hangulatod, az energiád és a stressz-szinted szorosan összefügg azzal, hogy mozogtál-e. Ezt a párodnak tudnia kell."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շարժումը՝ որպես դեղ։ Տրամադրությունդ, էներգիադ ու սթրեսը սերտորեն կապված են նրա հետ, թե որքան ես շարժվել։ Զուգընկերդ պետք է իմանա դա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak adalah obat. Mood, energi, dan stresmu sangat bergantung pada apakah kamu sudah menggerakkan badan. Pasanganmu perlu tahu ini."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmegharị ahụ dị ka ọgwụ. Ọnọdụ obi gị, ike gị na nrụgide gị na-adabere ma ị megharịrị ahụ gị. Onye gị kwesịrị ịma nke a."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hreyfing sem lyf. Skapið, orkan og stressið haldast í hendur við hvort þú hafir hreyft þig. Makinn þinn ætti að vita það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il movimento come medicina. Umore, energia e stress dipendono molto da quanto movimento hai fatto. Il tuo partner dovrebbe saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を動かすことが薬になる人です。気分も元気もストレスも、体を動かしたかどうかに大きく左右されます。パートナーに知っておいてもらいましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obahing awak dadi tamba. Swasana ati, tenaga, lan stres panjenengan raket banget karo apa panjenengan wis obah apa durung. Pasangan perlu ngerti iki."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოძრაობა, როგორც წამალი. შენი განწყობა, ენერგია და სტრესი ძალიან არის დამოკიდებული იმაზე, იმოძრავე თუ არა. პარტნიორმა ეს უნდა იცოდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қозғалыс сен үшін ем. Көңіл-күйің, күш-қуатың және стресс деңгейің денеңді қимылдатқаныңа тікелей байланысты. Серігің мұны білуі керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចលនាជាឱសថ។ អារម្មណ៍ ថាមពល និងភាពតានតឹងរបស់អ្នក ជាប់ទាក់ទងយ៉ាងជិតស្និទ្ធនឹងថាតើអ្នកបានធ្វើចលនារាងកាយឬអត់។ ដៃគូគួរដឹងរឿងនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಲನೆಯೇ ಔಷಧಿ. ನಿಮ್ಮ ಮೂಡ್, ಶಕ್ತಿ ಮತ್ತು ಒತ್ತಡ — ಇವೆಲ್ಲ ನೀವು ದೇಹಕ್ಕೆ ಚಲನೆ ಕೊಟ್ಟಿದ್ದೀರೋ ಇಲ್ಲವೋ ಎಂಬುದರ ಮೇಲೆ ನಿಂತಿವೆ. ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ಇದು ತಿಳಿದಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸을 움직이는 게 약이에요. 기분과 에너지, 스트레스가 몸을 움직였느냐에 크게 좌우돼요. 연인이 알아 두면 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tevger wekî derman. Hal, enerjî û stresa te bi wê yekê ve girêdayî ne ku te laşê xwe livandiye an na. Divê hevjînê te vê zanibe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кыймыл — дары. Маанайың, күчүң жана стрессиң денеңди кыймылдатканыңа жараша болот. Сүйгөнүң муну билиши керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweegung als Medizin. Deng Stëmmung, deng Energie an däi Stress hänke staark dovun of, obs de dech beweegt hues. Däi Schatz sollt dat wëssen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເຄື່ອນໄຫວຄືຢາຂອງເຈົ້າ ອາລົມ ພະລັງ ແລະ ຄວາມຄຽດຂອງເຈົ້າ ຂຶ້ນກັບວ່າເຈົ້າໄດ້ຂະຫຍັບຮ່າງກາຍຫຼືບໍ່ ຄູ່ຂອງເຈົ້າຄວນຮູ້ເລື່ອງນີ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judėjimas kaip vaistas. Tavo nuotaika, energija ir stresas glaudžiai susiję su tuo, ar judėjai. Antroji pusė turėtų tai žinoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kustība kā zāles. Tavs noskaņojums, enerģija un stress cieši saistīti ar to, vai esi izkustējies. Otrajai pusei tas jāzina."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fihetsehana no fanafody. Mifamatotra akaiky amin'ny hoe nihetsika ve ny vatanao ny toe-ponao, ny herinao ary ny adin-tsainao. Tokony hahafantatra izany ny olon-tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te korikori hei rongoā. He hono tata tō wairua, tō kaha me tō taumaha ki te korikori o tō tinana. Me mōhio tō hoa aroha ki tēnei."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движењето е лек. Расположението, енергијата и стресот ти зависат од тоа дали денес го раздвижи телото. Половинката треба да го знае ова."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചലനം തന്നെ മരുന്ന്. നിങ്ങളുടെ മൂഡും ഊർജവും സമ്മർദവും ശരീരം അനങ്ങിയോ എന്നതുമായി അടുത്ത ബന്ധമുള്ളതാണ്. പങ്കാളി ഇത് അറിഞ്ഞിരിക്കണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөдөлгөөн бол эм. Сэтгэл, эрч хүч, стресс чинь биеэ хөдөлгөсөн эсэхээс шууд хамаардаг. Хань чинь үүнийг мэдэх ёстой."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हालचाल हेच औषध. तुमचा मूड, ऊर्जा आणि ताण, हे सगळे तुम्ही शरीराची हालचाल केली की नाही यावर अवलंबून असते. हे जोडीदाराला माहीत असायला हवे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergerakan sebagai ubat. Perasaan, tenaga dan tekanan anda berkait rapat dengan sama ada anda sudah menggerakkan badan. Pasangan anda patut tahu hal ini."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-moviment bħala mediċina. Il-burdata, l-enerġija u l-istress tiegħek huma marbuta mill-qrib ma' jekk ċċaqlaqtx ġismek. Ta' min tgħarraf lill-partner tiegħek b'dan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လှုပ်ရှားမှုက ဆေးပါပဲ။ သင့်စိတ်ခံစားမှု၊ အင်အားနဲ့ ဖိစီးမှုတွေက ခန္ဓာကိုယ်ကို လှုပ်ရှားခဲ့သလားဆိုတာနဲ့ နီးနီးကပ်ကပ် ဆက်စပ်နေတယ်။ ဒါကို ချစ်သူ သိထားသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse som medisin. Humøret, energien og stresset ditt henger tett sammen med om du har rørt på deg. Det bør en partner vite."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलफिर नै औषधि। तपाईंको मुड, ऊर्जा र तनाव शरीर चलाउनुभयो कि भएन भन्नेमा धेरै भर पर्छ। पार्टनरलाई यो थाहा हुनुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen als medicijn. Je stemming, energie en stress hangen sterk af van of je in beweging bent geweest. Goed als je partner dat weet."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuyenda ngati mankhwala. Mtima wanu, mphamvu zanu ndi kupanikizika kwanu zimadalira ngati mwasuntha thupi lanu. Wokondedwa wanu ayenera kudziwa zimenezi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sochiin qoricha. Miirri kee, humni kee fi dhiphinni kee qaama kee sochoofte moo hin sochoofne irratti hundaa'u. Kun jaalallee keetiin beekamuu qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶରୀର ଚଳାଇବା ହିଁ ଔଷଧ। ଆପଣ ଦେହ ହଲାଇଛନ୍ତି କି ନାହିଁ, ତା’ ସହ ଆପଣଙ୍କ ମନୋଭାବ, ଶକ୍ତି ଓ ଚାପ ଘନିଷ୍ଠ ଭାବେ ଜଡ଼ିତ। ସାଥୀଙ୍କୁ ଏହା ଜଣାଥିବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਿੱਲਣਾ-ਜੁੱਲਣਾ ਹੀ ਦਵਾਈ ਹੈ। ਤੁਹਾਡਾ ਮੂਡ, ਊਰਜਾ ਅਤੇ ਤਣਾਅ ਇਸ ਗੱਲ ਨਾਲ ਡੂੰਘੇ ਜੁੜੇ ਹਨ ਕਿ ਤੁਸੀਂ ਸਰੀਰ ਨੂੰ ਹਿਲਾਇਆ ਜਾਂ ਨਹੀਂ। ਪਾਰਟਨਰ ਨੂੰ ਇਹ ਪਤਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch jako lekarstwo. Twój nastrój, energia i stres mocno zależą od tego, czy się poruszasz. Druga połówka powinna o tym wiedzieć."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت د درمل په څېر. ستاسو مزاج، انرژي او فشار ډېر په دې پورې تړلي دي چې ورزش مو کړی که نه. ملګری باید پرې پوه وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento como remédio. Seu humor, sua energia e seu estresse dependem muito de ter mexido o corpo. Seu amor deveria saber disso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movimento como remédio. O teu humor, a tua energia e o teu stress dependem muito de te teres mexido. O teu par deve saber isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcarea ca medicament. Starea, energia și stresul tău depind mult de cât te-ai mișcat. Un partener ar trebui să știe asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение как лекарство. Твоё настроение, энергия и уровень стресса сильно зависят от того, было ли сегодня движение. Партнёру стоит это знать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukoresha umubiri ni umuti. Amarangamutima yawe, imbaraga n'umunaniro wawe bifitanye isano rya hafi no kuba wakoresheje umubiri. Umukunzi wawe akwiye kubimenya."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "චලනය ඔබට ඖෂධයක්. ඔබේ මනෝභාවය, ශක්තිය සහ ආතතිය බොහෝ දුරට රඳා පවතින්නේ ඔබ ශරීරය චලනය කළාද කියන එක මත. ඔබේ සහකරු මේක දැනගන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb ako liek. Tvoja nálada, energia aj stres úzko súvisia s tým, či si dopraješ pohyb. Tvoja polovička by to mala vedieť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibanje kot zdravilo. Tvoje razpoloženje, energija in stres so tesno povezani s tem, ali se razgibaš. Partner bi moral to vedeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufambisa muviri semushonga. Manzwiro ako, simba rako nekunetseka kwako zvinoenderana nekuti wafambisa muviri wako here. Mudiwa anofanira kuziva izvi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhaqdhaqaaqu waa daawo kuu ah. Niyaddaada, tamartaada iyo walbahaarkaagu waxay si dhow ugu xiran yihiin inaad jidhkaaga dhaqaajisay iyo in kale. Waa in tan lammaanahaaga loo sheegaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lëvizja si ilaç. Humori, energjia dhe stresi yt varen shumë nga fakti nëse e ke lëvizur trupin. Partneri yt duhet ta dijë këtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кретање као лек. Расположење, енергија и стрес ти тесно зависе од тога да ли је тело добило своје кретање. Твоја половина то треба да зна."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerak téh ubar. Wanda, tanaga, sareng setrés anjeun raket pisan patalina sareng naha anjeun parantos ngagerakkeun awak. Pasangan kedah terang ieu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse som medicin. Ditt humör, din energi och din stress hänger tätt ihop med om du har rört på dig. Det bör en partner veta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwendo kama dawa. Hisia, nguvu na msongo wako vinahusiana sana na kama umeushughulisha mwili wako. Mwenzi anapaswa kujua hili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அசைவே மருந்து. உங்கள் மனநிலை, ஆற்றல், அழுத்தம் எல்லாம் நீங்கள் உடலை அசைத்தீர்களா என்பதோடு நெருக்கமாகப் பிணைந்துள்ளன. இது உங்கள் துணைக்குத் தெரிய வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కదలికే మీకు మందు. మీరు శరీరాన్ని కదిలించారా లేదా అన్నదానిపై మీ మూడ్, శక్తి, ఒత్తిడి ఎక్కువగా ఆధారపడతాయి. ఇది మీ భాగస్వామికి తెలిసి ఉండాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳаракат ҳамчун дору. Кайфият, қувват ва стресси ту ба он вобаста аст, ки баданат ҳаракат кард ё не. Ёрат бояд инро донад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขยับร่างกายคือยา อารมณ์ พลังงาน และความเครียดของคุณขึ้นอยู่กับว่าวันนั้นได้ขยับร่างกายหรือเปล่า คนรักควรรู้เรื่องนี้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምንቅስቓስ ከም መድሃኒት። ስምዒትኩም፣ ጉልበትኩምን ጸቕጥኹምን ምስ ኣካላዊ ምንቅስቓስኩም ብቐረባ ይተኣሳሰሩ። እዚ ብመጻምድኹም ክፍለጥ ይግባእ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hereket — derman. Keýpiň, güýjüň we stresiň bedeniňi hereketlendirendigiňe berk bagly. Söýgüliň muny bilmeli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket senin ilacın. Ruh halin, enerjin ve stresin, bedenini hareket ettirip ettirmediğinle yakından ilgili. Partnerin bunu bilmeli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух як ліки. Твій настрій, енергія й стрес тісно залежать від того, чи був сьогодні рух. Половинці варто це знати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت ہی دوا ہے۔ آپ کا موڈ، توانائی اور دباؤ اس بات سے گہرا جڑا ہے کہ جسم کو حرکت ملی یا نہیں۔ ساتھی کو یہ معلوم ہونا چاہیے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harakat — dori. Kayfiyatingiz, kuchingiz va stress darajangiz tanangizni harakatlantirganingizga bogʻliq. Sherigingiz buni bilishi kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động là liều thuốc. Tâm trạng, năng lượng và căng thẳng của bạn gắn chặt với việc hôm đó có vận động hay không. Người ấy nên biết điều này."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukushukuma ngamayeza. Imo yakho, amandla noxinezelelo zinxulumene kakhulu nokuba ulushukumisile umzimba wakho na. Iqabane kufuneka likwazi oku."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn ara bí oògùn. Ìṣesí yín, agbára yín àti wàhálà yín so mọ́ bóyá ẹ ti mi ara yín. Olólùfẹ́ yín yẹ kí ó mọ èyí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動就是良藥。你的心情、精力和壓力，跟你有沒有活動身體息息相關。另一半應該知道這一點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动就是良药。你的心情、精力和压力，和有没有动起来紧密相关。另一半应该知道这一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動就是你的良藥。你的心情、精力和壓力，和有沒有動一動身體息息相關。另一半應該要知道這點。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunyakaza kungumuthi. Imizwa yakho, amandla, nengcindezi kuhlobene kakhulu nokuthi uwunyakazisile yini umzimba wakho. Umlingani kufanele akwazi lokhu."
          }
        }
      }
    },
    "Movement without intensity. You value feeling good over performance. Great for someone who can match that pace." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging sonder intensiteit. Om goed te voel is vir jou belangriker as prestasie. Wonderlik saam met iemand wat by daardie pas kan hou."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ያለ ከባድ ጥረት መንቀሳቀስ። ከውጤት ይልቅ ጥሩ ስሜትን ያስቀድማሉ። ያንን ፍጥነት መከተል ለሚችል ሰው ምርጥ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة بلا إجهاد. تقدّرون الشعور الجيد أكثر من الأداء. مثالي مع شريك يجاريكم في هذا الإيقاع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তীব্ৰতা নোহোৱাকৈ চলাফুৰা। আপুনি সাফল্যতকৈ ভাল অনুভৱক মূল্য দিয়ে। সেই গতিৰ লগত খোজ মিলাব পৰা কাৰোবাৰ বাবে চমৎকাৰ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gərginliksiz hərəkət. Nəticədən çox özünü yaxşı hiss etməyə dəyər verirsən. Bu tempə uyğunlaşa bilən biri üçün əladır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух без інтэнсіўнасці. Табе важней добра сябе адчуваць, чым ставіць рэкорды. Выдатна з тым, хто можа трымаць такі ж тэмп."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение без натоварване. Цениш доброто усещане повече от постиженията. Чудесно с някого, който може да върви в същото темпо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তীব্রতা ছাড়া নড়াচড়া। পারফরম্যান্সের চেয়ে ভালো বোধ করাকে তুমি মূল্য দাও। এই ছন্দে তাল মেলাতে পারে এমন কারও সাথে দারুণ মানায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje bez intenziteta. Važniji ti je dobar osjećaj od rezultata. Odlično uz nekoga ko može pratiti taj tempo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moviment sense intensitat. Valores sentir-te bé més que el rendiment. Ideal amb algú que pugui seguir aquest ritme."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb bez intenzity. Důležitější je pro tebe dobrý pocit než výkon. Ideální s někým, kdo udrží stejné tempo."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symud heb ddwyster. Rwyt ti'n gwerthfawrogi teimlo'n dda yn fwy na pherfformio. Gwych i rywun sy'n gallu dilyn yr un cyflymder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse uden intensitet. Du sætter det at have det godt over præstationen. Perfekt med en, der kan følge det tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung ohne Leistungsdruck. Sich gut zu fühlen zählt für dich mehr als jede Bestleistung. Perfekt mit jemandem, der dieses Tempo mitgeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κίνηση χωρίς ένταση. Σε ενδιαφέρει να νιώθεις καλά, όχι οι επιδόσεις. Ιδανικό με κάποιον που μπορεί να ακολουθήσει αυτόν τον ρυθμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimiento sin intensidad. Valoras sentirte bien más que el rendimiento. Ideal con alguien que pueda seguir ese ritmo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikumine ilma intensiivsuseta. Hea enesetunne on sulle olulisem kui tulemused. Sobib hästi kellegagi, kes sama tempot hoiab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mugimendua, intentsitaterik gabe. Ondo sentitzea baloratzen duzu, emaitzak baino gehiago. Primeran erritmo horri jarraitu diezaiokeen norbaitentzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت بدون شدت. حال خوب برایت مهم‌تر از رکورد است. عالی برای کسی که بتواند با همین سرعت همراهت شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikettä ilman tehoja. Hyvä olo on sinulle tärkeämpi kuin suoritus. Sopii hyvin yhteen jonkun kanssa, joka liikkuu samaan tahtiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paggalaw nang walang tindi. Mas mahalaga sa’yo ang gumaan ang pakiramdam kaysa sa performance. Bagay sa taong kayang sumabay sa bilis na iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouger sans intensité. Tu privilégies le bien-être plutôt que la performance. Idéal avec quelqu'un qui peut suivre ce rythme."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gluaiseacht gan déine. Is mó leat mothú go maith ná feidhmíocht. Iontach le duine atá in ann an luas sin a choinneáil."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movemento sen intensidade. Valoras sentirte ben máis ca o rendemento. Ideal con alguén que poida levar ese ritmo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તીવ્રતા વગરનું હલનચલન. પ્રદર્શન કરતાં સારું અનુભવવું તમારા માટે વધુ મહત્ત્વનું છે. એ જ ગતિએ ચાલી શકે એવી વ્યક્તિ માટે સરસ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motsi ba tare da tsanani ba. Kuna daraja jin daɗin jiki fiye da nasara. Ya dace sosai da wanda zai iya bin wannan sauri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה בלי עצימות. להרגיש טוב חשוב לך יותר מביצועים. מושלם עם מי שמתאים את עצמו לקצב הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना ज़ोर-ज़बरदस्ती के चलना-फिरना। आपके लिए प्रदर्शन से ज़्यादा अच्छा महसूस करना अहम है। उसी रफ़्तार से चल सकने वाले साथी के लिए बढ़िया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje bez intenziteta. Važniji ti je dobar osjećaj od rezultata. Odlično uz nekoga tko može pratiti taj tempo."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouvman san entansite. Ou pito santi ou byen pase fè pèfòmans. Bèl bagay ak yon moun ki ka swiv ritm sa a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgás intenzitás nélkül. Neked a jó közérzet fontosabb a teljesítménynél. Ideális, ha a párod is hasonló tempóban mozog."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շարժում առանց ինտենսիվության։ Լավ զգալը քեզ համար ավելի կարևոր է, քան արդյունքը։ Հրաշալի է նրա համար, ով կարող է այդ տեմպին համընթաց քայլել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak tanpa intensitas tinggi. Kamu lebih mementingkan rasa nyaman daripada performa. Cocok dengan seseorang yang bisa mengikuti ritme itu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmegharị ahụ n'enweghị ike karịrị akarị. Ị na-akpọ ịdị mma n'ahụ ihe karịa ịrụpụta ihe. Ọ dị mma nye onye nwere ike iso ụdị ọsọ ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hreyfing án ákefðar. Þú metur vellíðan fram yfir árangur. Frábært með einhverjum sem getur haldið sama takti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento senza intensità. Per te conta sentirti bene, non la prestazione. Perfetto con chi sa tenere lo stesso ritmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "激しさより、気持ちよく体を動かしたいタイプです。結果より心地よさを大切にしています。同じペースで楽しめる人とぴったりです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obah tanpa ngoyo. Panjenengan luwih ngajeni rasa seger tinimbang prestasi. Cocog banget karo wong sing bisa ngimbangi iramane."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოძრაობა ინტენსივობის გარეშე. კარგ შეგრძნებას შედეგზე მეტად აფასებ. იდეალურია ვინმესთვის, ვინც ამ ტემპს აგყვება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қарқынсыз қозғалыс. Нәтижеден гөрі жақсы сезінуді бағалайсың. Осындай ырғақты бөлісетін адамға тамаша."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ធ្វើចលនាដោយមិនខ្លាំងពេក។ អ្នកឲ្យតម្លៃលើអារម្មណ៍ល្អ ជាងលទ្ធផល។ ល្អសម្រាប់នរណាម្នាក់ដែលអាចដើរតាមចង្វាក់នោះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತೀವ್ರತೆಯಿಲ್ಲದ ಚಲನೆ. ಸಾಧನೆಗಿಂತ ಚೆನ್ನಾಗಿರುವ ಭಾವ ನಿಮಗೆ ಮುಖ್ಯ. ಅದೇ ವೇಗದಲ್ಲಿ ಜೊತೆಯಾಗಬಲ್ಲವರಿಗೆ ಇದು ಅದ್ಭುತ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강도보다 꾸준한 움직임이에요. 기록보다 기분 좋은 게 중요하죠. 이 속도에 맞춰 줄 수 있는 사람과 잘 맞아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tevger bê tundî. Ji te re xwe baş hîs kirin ji performansê girîngtir e. Ji bo kesê ku dikare bi heman lezê bimeşe, pir baş e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Катуу күчсүз кыймыл. Натыйжадан көрө жакшы сезимди баалайсың. Ушул ыргакты кармай алган адам үчүн сонун."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweegung ouni Drock. Dir ass et méi wichteg, dech gutt ze fillen, wéi Leeschtung ze bréngen. Ideal mat engem, deen deem Tempo matgeet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຄື່ອນໄຫວແບບບໍ່ໜັກ ເຈົ້າໃຫ້ຄຸນຄ່າກັບຄວາມຮູ້ສຶກດີຫຼາຍກວ່າຜົນງານ ເໝາະກັບຄົນທີ່ໄປໃນຈັງຫວະດຽວກັນໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judėjimas be įtampos. Geri pojūčiai tau svarbiau už rezultatus. Puiku su tuo, kas gali palaikyti tokį tempą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kustība bez intensitātes. Tev svarīgāka ir laba pašsajūta nekā rezultāts. Lieliski, ja otrā puse var turēt līdzīgu tempu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fihetsehana tsy mafy loatra. Ny fahatsapana ho salama no sarobidy aminao fa tsy ny fahombiazana. Tsara ho an'ny olona afaka manaraka izany gadona izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nekeneke me te kore kaha nui. He nui ake ki a koe te rongo pai i te whakaputa. He pai mō tētahi e taea ana te ōrite ki taua tere."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движење без интензитет. Ти е поважно да се чувствуваш добро отколку резултатот. Одлично за некого што може да го следи тоа темпо."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തീവ്രതയില്ലാത്ത ചലനം. പ്രകടനത്തെക്കാൾ നല്ല തോന്നലിനാണ് നിങ്ങൾ വില നൽകുന്നത്. ആ വേഗത്തിനൊപ്പം നീങ്ങാൻ കഴിയുന്ന ഒരാൾക്ക് ഇത് നന്നായി ചേരും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эрчимгүй хөдөлгөөн. Чи амжилтаас илүү сайхан мэдрэмжийг үнэлдэг. Тэр хэмнэлийг дагаж чадах хүнд гайхалтай."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीव्रतेशिवाय हालचाल. कामगिरीपेक्षा छान वाटणे तुम्हाला महत्त्वाचे वाटते. त्या गतीशी जुळणाऱ्या व्यक्तीसाठी उत्तम."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak tanpa intensiti. Anda mengutamakan rasa sihat berbanding prestasi. Sesuai dengan seseorang yang boleh mengikut rentak itu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ċaqliq mingħajr intensità. Tapprezza li tħossok tajjeb aktar mill-prestazzjoni. Ideali ma' xi ħadd li jista' jżomm l-istess ritmu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပြင်းထန်မှု မပါတဲ့ လှုပ်ရှားမှု။ စွမ်းဆောင်ရည်ထက် နေကောင်းတယ်လို့ ခံစားရတာကို တန်ဖိုးထားတယ်။ အဲဒီအရှိန်နဲ့ လိုက်နိုင်တဲ့သူအတွက် အကောင်းဆုံးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse uten intensitet. Det viktigste for deg er å føle deg bra, ikke å prestere. Perfekt med noen som kan holde samme tempo."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीव्रताबिनाको हिँडडुल। तपाईं प्रदर्शनभन्दा राम्रो महसुसलाई महत्त्व दिनुहुन्छ। त्यही गतिमा साथ दिन सक्ने कसैका लागि उत्तम।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen zonder intensiteit. Je voelt je liever goed dan dat je presteert. Fijn met iemand die hetzelfde tempo heeft."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuyendayenda popanda kudzikakamiza. Mumayamikira kumva bwino kuposa kupambana. Zabwino kwa munthu amene angayende pa liwiro lomwelo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciminna malee sochii. Raawwii caalaa miira gaarii ni kabajta. Nama saffisa sana wajjin walsimuuf baay'ee gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତୀବ୍ରତା ବିନା ଚଳପ୍ରଚଳ। ପ୍ରଦର୍ଶନଠୁ ଭଲ ଅନୁଭବ କରିବାକୁ ଆପଣ ମୂଲ୍ୟ ଦିଅନ୍ତି। ସେହି ଗତିରେ ଚାଲିପାରୁଥିବା କାହା ପାଇଁ ବହୁତ ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਿਨਾਂ ਜ਼ੋਰ ਲਾਏ ਹਿਲਜੁਲ। ਤੁਸੀਂ ਪ੍ਰਦਰਸ਼ਨ ਨਾਲੋਂ ਚੰਗਾ ਮਹਿਸੂਸ ਕਰਨ ਦੀ ਕਦਰ ਕਰਦੇ ਹੋ। ਕਿਸੇ ਅਜਿਹੇ ਸਾਥ ਲਈ ਵਧੀਆ ਜੋ ਉਸੇ ਰਫ਼ਤਾਰ ਨਾਲ ਚੱਲ ਸਕੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch bez intensywności. Liczy się dla ciebie dobre samopoczucie, a nie wyniki. Idealne z kimś, kto lubi podobne tempo."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت بې له فشاره. تاسو ښه احساس له لاسته راوړنې غوره ګڼئ. د هغه چا لپاره ښه دی چې له همدې رفتار سره برابر شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento sem intensidade. Você valoriza se sentir bem mais do que o desempenho. Perfeito com alguém que acompanhe esse ritmo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento sem intensidade. Dás mais valor a sentires-te bem do que ao desempenho. Ótimo com alguém que acompanhe esse ritmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcare fără intensitate. Pentru tine contează să te simți bine, nu performanța. Ideal alături de cineva care poate ține același ritm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение без надрыва. Тебе важнее хорошее самочувствие, чем результат. Отлично, если партнёру подходит такой же темп."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunyeganyega nta guhatiriza. Uha agaciro kumererwa neza kuruta kugera ku mihigo. Ni byiza ku muntu ushobora kugendana n'iyo njyana."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "තීව්‍රතාවක් නැති චලනය. ඔබ ප්‍රතිඵලයට වඩා හොඳ හැඟීමට වටිනාකම දෙනවා. ඒ වේගයටම එන්න පුළුවන් කෙනෙක්ට නියමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb bez intenzity. Dobrý pocit je pre teba dôležitejší než výkon. Ideálne s niekým, kto udrží rovnaké tempo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibanje brez napora. Bolj kot zmogljivost ti šteje dobro počutje. Odlično z nekom, ki lahko sledi temu tempu."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufamba pasina kunyanyisa. Unokoshesa kunzwa zvakanaka pane kukunda. Zvakanaka nemunhu anokwanisa kufamba nekumhanya ikoko."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhaqdhaqaaq aan xoog lahayn. Waxaad qiimaysaa inaad fiicnaato, ma aha natiijo. Aad bay ugu fiican tahay qof la socon kara xawaarahaas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lëvizje pa intensitet. Për ty ka më shumë rëndësi të ndihesh mirë sesa performanca. Shumë mirë me dikë që e ndjek këtë ritëm."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кретање без напора. Важнији ти је добар осећај од резултата. Одлично уз некога ко може да прати тај темпо."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerak tanpa kedah beurat. Anjeun langkung ngahargaan raos séhat tibatan prestasi. Cocog pisan sareng jalma anu tiasa nyaluyukeun laju éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse utan intensitet. Att må bra är viktigare för dig än att prestera. Perfekt med någon som håller samma tempo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusonga bila nguvu nyingi. Unathamini kujisikia vizuri kuliko matokeo. Inamfaa mtu anayeweza kwenda kwa mwendo huo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தீவிரம் இல்லாத அசைவு. சாதனையை விட நன்றாக உணர்வதையே மதிக்கிறீர்கள். அதே வேகத்தில் வரக்கூடியவருக்கு அருமையான பொருத்தம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తీవ్రత లేని కదలిక. ప్రదర్శన కంటే హాయిగా అనిపించడమే మీకు ముఖ్యం. ఆ వేగానికి తోడుండగల వారికి చక్కగా సరిపోతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳаракат бе шиддат. Барои ту худро хуб ҳис кардан аз натиҷа муҳимтар аст. Барои касе, ки бо ҳамин суръат ҳамроҳӣ карда метавонад, олист."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขยับตัวแบบไม่หักโหม คุณให้ความสำคัญกับความรู้สึกดีมากกว่าผลลัพธ์ เหมาะกับคนที่ไปจังหวะเดียวกันได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዘይ ብርቱዕ ጻዕሪ ምንቅስቓስ። ካብ ውጽኢት ጽቡቕ ስምዒት ተኽብሩ። ነቲ ቅልጣፈ ክስዕብ ንዝኽእል ሰብ ጽቡቕ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agyrlyksyz hereket. Sen netijeden has köp gowy duýmagy gymmatlandyrýarsyň. Şol depgine eýerip bilýän adam üçin ajaýyp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoğunluk olmadan hareket. Performanstan çok iyi hissetmeye değer veriyorsun. Bu tempoya ayak uydurabilen biri için harika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух без інтенсивності. Для тебе важливіше добре почуватися, ніж ставити рекорди. Чудово, якщо поруч хтось у такому ж темпі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدت کے بغیر حرکت۔ آپ کے لیے کارکردگی سے زیادہ اچھا محسوس کرنا اہم ہے۔ ایسے کسی کے لیے بہترین جو یہی رفتار رکھ سکے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoʻriqishsiz harakat. Natijadan koʻra oʻzingizni yaxshi his qilishni qadrlaysiz. Shu maromga mos keladigan inson uchun ajoyib."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động không cần cường độ. Bạn coi trọng cảm giác dễ chịu hơn thành tích. Rất hợp với người theo kịp nhịp đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukushukuma ngaphandle kokuzinyanzela. Uxabisa ukuziva kamnandi ngaphezu kokuphumelela. Kuhle kumntu onokuhamba ngesantya esinjalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn láìfi agbára pọ̀. Ẹ mọyì kí ara yín yá ju àṣeyọrí lọ. Ó dára fún ẹni tó lè bá ìlù yín mu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活動身體但不求強度。你重視感覺舒服多於表現。很適合能配合這個節奏的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动但不追求强度。比起成绩，你更看重身体舒服。和节奏相近的人在一起会很合拍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動一動，但不求強度。你重視舒服的感覺勝過表現，很適合能配合這個步調的人。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunyakaza ngaphandle kokuzikhandla. Wazisa ukuzizwa kahle kunokuphumelela. Kuhle kumuntu ongahambisana naleso sivinini."
          }
        }
      }
    },
