    "Baseline healthy. You probably take it for granted, which is fine — until you're sharing a bed with someone with very different habits." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أساس صحي. ربما يبدو لك أمرًا مسلّمًا به، ولا بأس، إلى أن يأتي تقاسم السرير مع شخص بعادات مختلفة جدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravý základ. Nejspíš to bereš jako samozřejmost, což je v pořádku – dokud nesdílíš postel s někým, kdo má úplně jiné návyky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundlæggende sundt. Du tager det nok for givet, og det er fint – indtil du deler seng med en, der har helt andre vaner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundsätzlich gesund. Du nimmst es wahrscheinlich als selbstverständlich hin, und das ist okay – bis du das Bett mit jemandem teilst, der ganz andere Gewohnheiten hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υγιής βάση. Μάλλον τον θεωρείς δεδομένο, και δεν πειράζει — μέχρι να μοιραστείς κρεβάτι με κάποιον που έχει πολύ διαφορετικές συνήθειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una base sana. Seguramente lo das por hecho, y está bien — hasta que compartes cama con alguien de hábitos muy distintos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perusterve. Pidät sitä luultavasti itsestäänselvyytenä, mikä on ok – kunnes jaat sängyn jonkun kanssa, jolla on hyvin erilaiset tavat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malusog sa pangkalahatan. Malamang hindi mo ito masyadong iniisip, at ayos lang — hanggang may katabi ka nang ibang-iba ang gawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne base. Tu n'y penses sûrement pas, et c'est très bien — jusqu'au jour où tu partages ton lit avec quelqu'un aux habitudes très différentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בסיס בריא. כנראה שזה מובן מאליו בשבילך, וזה בסדר — עד שחולקים מיטה עם מישהו עם הרגלים שונים מאוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुनियादी तौर पर सेहतमंद। शायद आपके लिए यह कोई बड़ी बात ही नहीं, और यह ठीक है — जब तक बिस्तर किसी बिल्कुल अलग आदतों वाले के साथ साझा न हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapvetően egészséges. Valószínűleg magától értetődőnek veszed, ami rendben is van – amíg nem osztod meg az ágyat valakivel, akinek egészen mások a szokásai."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada dasarnya sehat. Kamu mungkin menganggapnya biasa, dan itu wajar — sampai kamu berbagi ranjang dengan orang yang kebiasaannya sangat berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una base sana. Probabilmente lo dai per scontato, e va bene — finché non dividi il letto con qualcuno dalle abitudini molto diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本的には健康です。当たり前だと思っているかもしれませんが、それで大丈夫。習慣がまったく違う人と同じベッドで寝るまでは。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 건강해요. 아마 당연하게 여기고 있을 텐데 괜찮아요. 습관이 아주 다른 사람과 한 침대를 쓰기 전까지는요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asasnya sihat. Anda mungkin tak terfikir pun tentangnya, dan itu tak mengapa — sehinggalah anda berkongsi katil dengan orang yang tabiatnya sangat berbeza."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sunt utgangspunkt. Du tar det nok for gitt, og det er greit – helt til du deler seng med noen med helt andre vaner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezond in de basis. Je neemt het waarschijnlijk voor lief, en dat is prima – tot je een bed deelt met iemand met heel andere gewoonten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowa podstawa. Pewnie traktujesz to jako oczywistość, i dobrze – dopóki nie dzielisz łóżka z kimś o zupełnie innych nawykach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saudável no geral. Você provavelmente nem pensa nisso, e tudo bem — até dividir a cama com alguém de hábitos bem diferentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un somn sănătos, în general. Probabil îl iei ca pe ceva de la sine înțeles, ceea ce e în regulă — până când împarți patul cu cineva cu obiceiuri foarte diferite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здоровая база. Наверное, ты воспринимаешь это как должное — и это нормально, пока не начнёшь делить кровать с человеком с совсем другими привычками."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sund grund. Du tar det nog för givet, och det är okej – tills du delar säng med någon som har helt andra vanor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุขภาพการนอนพื้นฐานดี คุณอาจมองว่าเป็นเรื่องธรรมดา ซึ่งก็ไม่เป็นไร จนกว่าจะต้องนอนเตียงเดียวกับคนที่นิสัยการนอนต่างกันมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temelde sağlıklı. Muhtemelen bunu kanıksıyorsun ve bu normal; ta ki alışkanlıkları çok farklı biriyle aynı yatağı paylaşana kadar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здорова база. Ти, мабуть, сприймаєш це як належне, і це нормально — доки не ділиш ліжко з кимось із зовсім іншими звичками."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khỏe mạnh ở mức cơ bản. Có lẽ bạn coi đó là điều hiển nhiên, cũng chẳng sao — cho đến khi ngủ chung với người có thói quen rất khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本健康。你大概习以为常，这没关系，直到和作息很不一样的人同床共枕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本上很健康。你大概覺得理所當然，這也沒關係，直到你和作息差很多的人同床共枕。"
          }
        }
      }
    },
    "Be close to family and watch them grow" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
