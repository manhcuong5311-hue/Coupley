    "Ask what they *need* — listen, don't fix." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا عمّا *يحتاجه* شريكك. أصغوا ولا تحاولوا الإصلاح."
          }
        },
        "cs" : {
