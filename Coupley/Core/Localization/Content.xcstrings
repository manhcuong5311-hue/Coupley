        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ገለ ግዜ ዝበለጸ ቆጸራ ዋላ ሓደ ሰብ ጫማ ክወድይ ዘየድልዮ እዩ። ካብ ሃዋህው ምቾትን ቅሳነትን።"
