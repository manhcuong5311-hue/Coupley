        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្មោះត្រង់។ មនុស្សភាគច្រើនក៏ដូច្នេះដែរ។ ឆន្ទៈក្នុងការពិនិត្យមើលវា គឺជាផ្នែកសំខាន់បំផុត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಾಮಾಣಿಕ ಉತ್ತರ. ಹೆಚ್ಚಿನವರೂ ಹಾಗೇ. ಅದನ್ನು ಪರಿಶೀಲಿಸಲು ಸಿದ್ಧರಿರುವುದೇ ಅತಿ ಮುಖ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "솔직한 답이에요. 대부분 그렇거든요. 들여다보려는 마음이 가장 중요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastgo. Piraniya mirovan wisa ne. Amadebûna lêkolîna wê beşa herî girîng e."
