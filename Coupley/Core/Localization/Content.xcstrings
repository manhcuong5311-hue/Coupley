        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليست نقطة توتر بالنسبة إليكم. يستحق الأمر أن تتحدثوا عنه مع شريكك، فربما يكون كذلك بالنسبة إليه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ বাবে এইটো টানটোৰ বিষয় নহয়। আপোনাৰ সংগীৰ বাবে হ'ব পাৰে, সেয়ে এবাৰ কথা পাতি চোৱা ভাল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, sənin üçün gərginlik nöqtəsi deyil. Amma partnyorunla bölüşməyə dəyər — bəlkə onun üçün belədir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цябе гэта не балючае месца. Варта абмеркаваць з палавінкай — раптам для яе гэта важна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За теб това не е повод за напрежение. Струва си да го споделиш с половинката си – за нея може да е."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার কাছে এটা টানাপোড়েনের বিষয় নয়। তবু পার্টনারকে বলে রাখা ভালো — ওর কাছে হয়তো বিষয়টা জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za tebe to nije tačka napetosti. Vrijedi to podijeliti s voljenom osobom, za slučaj da njoj jeste."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a tu no és un punt de tensió. Val la pena comentar-ho amb la teva parella, per si de cas a ella sí que li ho és."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tebe to není třecí plocha. Stojí za to říct to protějšku – pro něj by být mohla."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dydy e ddim yn achos tensiwn i ti. Mae'n werth holi dy bartner, rhag ofn ei fod yn bwysig o'r ochr arall."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke et ømt punkt for dig. Men fortæl det gerne til din partner, hvis det er det for vedkommende."
