        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከምቾት ጥልቀት። እውነተኛ መቀራረብ ሌሎች ጥንዶች ስለሚሸሿቸው ነገሮች በማውራት ይመጣል ብለው ያምናሉ።"
