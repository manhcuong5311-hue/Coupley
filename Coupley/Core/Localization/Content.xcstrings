    "Deferred dreams. There's something you've always wanted to build or create — and you're playing a long game." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحلام مؤجلة. هناك شيء لطالما حلمت ببنائه أو صنعه، ونفَسك في ذلك طويل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložené sny. Je něco, co odjakživa chceš vybudovat nebo vytvořit – a hraješ dlouhou hru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udskudte drømme. Der er noget, du altid har villet bygge eller skabe – og du spiller det lange spil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgeschobene Träume. Es gibt etwas, das du schon immer aufbauen oder erschaffen wolltest – und du denkst langfristig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όνειρα σε αναμονή. Υπάρχει κάτι που πάντα ήθελες να χτίσεις ή να δημιουργήσεις — και το παίζεις μακροπρόθεσμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueños aplazados. Hay algo que siempre has querido construir o crear — y juegas a largo plazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lykättyjä unelmia. On jotain, mitä olet aina halunnut rakentaa tai luoda – ja pelaat pitkää peliä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangarap na ipinagpaliban. May bagay kang matagal nang gustong buuin o likhain — at pangmatagalan ang laro mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rêves mis en attente. Il y a quelque chose que tu as toujours voulu construire ou créer — et tu joues sur le long terme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלומות שחיכו בסבלנות. יש משהו שתמיד רצית לבנות או ליצור — והמשחק שלך ארוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टले हुए सपने। कुछ ऐसा है जिसे बनाने या रचने की चाह हमेशा से रही है — और इसके लिए आपकी नज़र दूर तक है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elhalasztott álmok. Van valami, amit mindig is meg akartál építeni vagy alkotni – és hosszú távra játszol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impian yang ditunda. Ada sesuatu yang selalu ingin kamu bangun atau ciptakan — dan kamu menyiapkannya untuk jangka panjang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sogni rimandati. C’è qualcosa che hai sempre voluto costruire o creare — e stai giocando sul lungo periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先送りにしてきた夢があります。ずっと作りたかったものがあって、長い目で準備しているのでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미뤄 둔 꿈이 있어요. 늘 만들고 싶었던 무언가가 있고, 긴 호흡으로 준비하고 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impian yang ditangguhkan. Ada sesuatu yang selalu anda mahu bina atau cipta — dan anda sabar merancangnya untuk jangka panjang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utsatte drømmer. Det er noe du alltid har villet bygge eller skape – og du tenker langsiktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgestelde dromen. Er is iets wat je altijd al wilde bouwen of maken – en daar heb je een lange adem voor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odroczone marzenia. Jest coś, co od zawsze chcesz zbudować lub stworzyć – i myślisz o tym długofalowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonhos adiados. Tem algo que você sempre quis construir ou criar — e você está jogando a longo prazo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vise amânate. E ceva ce ți-ai dorit mereu să construiești sau să creezi — și joci pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложенные мечты. Есть что-то, что тебе всегда хотелось построить или создать, — и ты играешь вдолгую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppskjutna drömmar. Det finns något du alltid velat bygga eller skapa – och du spelar på lång sikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความฝันที่รอเวลา มีบางอย่างที่คุณอยากสร้างมาตลอด และคุณกำลังวางแผนระยะยาว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertelenmiş hayaller. Hep yapmak ya da üretmek istediğin bir şey var ve uzun vadeli düşünüyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
