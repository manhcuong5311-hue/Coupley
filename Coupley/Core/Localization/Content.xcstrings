        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ግዜ መገሻ ንምምሃር ወይ ታሪኻት ንምድህሳስ ትጥቀሙሉ። እዚ ፍርያምን ህንጡይን ኣተሓሳስባ እዩ።"
