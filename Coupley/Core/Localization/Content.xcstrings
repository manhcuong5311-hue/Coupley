        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandi sforzi periodici più che manutenzione quotidiana. Finché le aspettative coincidono, funziona benissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日の片づけより、ときどきまとめて頑張るタイプです。期待値がそろっていれば、それで問題ありません。"
