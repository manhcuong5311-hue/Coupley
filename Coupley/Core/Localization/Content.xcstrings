    "Notice one small thing about them today and mention it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحظوا شيئًا صغيرًا في شريكك اليوم واذكروه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všimni si dnes na protějšku jedné drobnosti a řekni mu to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg mærke til én lille ting ved din partner i dag, og nævn den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte heute auf eine Kleinigkeit an deinem Schatz und sprich sie an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσεξε σήμερα κάτι μικρό στο ταίρι σου και πες το."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fíjate hoy en algún pequeño detalle de tu pareja y díselo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa tänään yksi pieni asia hänessä ja mainitse se."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pansinin ang isang maliit na bagay sa kanya ngayon at banggitin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque une petite chose chez l'autre aujourd'hui, et dis-le."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשים לב היום לדבר קטן אחד אצל הצד השני ולומר את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज उनकी कोई छोटी-सी बात नोटिस करें और उसका ज़िक्र करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegyél észre ma egy apróságot rajta, és említsd meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatikan satu hal kecil tentangnya hari ini, lalu sebutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi nota una piccola cosa del tuo partner e diglielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、パートナーについて何か小さなことに気づいたら、それを伝えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 연인의 작은 변화 하나를 알아채고 말해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatikan satu perkara kecil tentangnya hari ini dan sebutkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg merke til én liten ting ved partneren din i dag, og si det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let vandaag op één klein ding aan je partner en benoem het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zauważ dziś jedną drobną rzecz u drugiej połówki i powiedz o niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repare numa coisinha no seu amor hoje e comente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observă azi un lucru mic la partenerul tău și spune-i."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметь сегодня в партнёре одну мелочь и скажи об этом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg märke till en liten sak hos din partner i dag och säg det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สังเกตสิ่งเล็กๆ เกี่ยวกับคนรักวันนี้ แล้วเอ่ยถึงมัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün onunla ilgili küçük bir şey fark et ve bunu söyle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поміть сьогодні одну дрібницю в половинці й скажи про неї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để ý một điều nhỏ ở người ấy hôm nay và nói ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天留意另一半的一件小事，并说出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天留意對方的一件小事，然後說出來。"
          }
        }
      }
    },
    "Novelty is exciting to you even in dining. You enjoy the discovery — and you probably eat more adventurously too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجديد يثير حماسك حتى في الطعام. متعة الاكتشاف جزء من السهرة عندك، وذوقك في الأكل غالبًا جريء أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinky tě lákají i u jídla. Baví tě objevovat – a nejspíš jíš i odvážněji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye frister dig, også når du spiser ude. Du nyder opdagelsen – og du er nok også mere eventyrlysten med maden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues reizt dich, sogar beim Essen. Du liebst das Entdecken – und isst wahrscheinlich auch experimentierfreudiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καινούριο σε ενθουσιάζει ακόμα και στο φαγητό. Απολαμβάνεις την ανακάλυψη — και μάλλον τρως και πιο τολμηρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novedad te emociona incluso a la hora de comer. Disfrutas descubriendo — y seguramente también te atreves con platos más arriesgados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutuus innostaa sinua jopa ruoassa. Nautit löytämisen ilosta – ja syöt todennäköisesti muutenkin rohkeammin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit sa pagkain, nakaka-excite sa’yo ang bago. Gusto mo ang pagtuklas — at malamang mas adventurous ka rin kumain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouveauté t'attire, même à table. Tu aimes découvrir, et tu goûtes sûrement plus volontiers à l'inconnu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חידוש מרגש אותך, גם כשזה מגיע לאוכל. הגילוי הוא חלק מהכיף — וכנראה שגם בצלחת יש לך נטייה להרפתקאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाने में भी नयापन आपको रोमांचित करता है। नई चीज़ें खोजने में आपको मज़ा आता है — और शायद नए स्वाद आज़माने का शौक़ भी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téged még az étkezésben is az újdonság lelkesít. Élvezed a felfedezést – és valószínűleg bátrabban is kóstolsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal baru selalu seru buatmu, bahkan soal makan. Kamu suka sensasi menemukan sesuatu — dan mungkin kamu juga lebih berani mencoba makanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novità ti entusiasma anche a tavola. Ami scoprire — e probabilmente mangi in modo più avventuroso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事にも新しさとワクワクを求めるタイプです。発見そのものを楽しめるので、きっと食べ物にも冒険心があるはず。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사에서도 새로움이 설레는 타입이에요. 발견하는 즐거움을 좋아하고, 음식도 아마 과감하게 도전하는 편일 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benda baharu mengujakan anda, walaupun soal makan. Anda suka meneroka — dan mungkin lebih berani mencuba makanan juga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye ting frister deg, også når du skal spise ute. Du elsker å oppdage – og er nok litt mer eventyrlysten på menyen også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwigheid maakt je blij, zelfs als het om eten gaat. Je geniet van het ontdekken – en je eet vast ook avontuurlijker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowości ekscytują cię nawet przy stole. Lubisz odkrywać – i pewnie jesz też odważniej niż inni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até na hora de comer, a novidade te empolga. Você curte descobrir — e provavelmente topa pratos mais ousados também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noutatea te entuziasmează chiar și la masă. Îți place să descoperi — și probabil mănânci și mai aventuros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна волнует тебя даже в еде. Тебе нравится открывать новое — и, скорее всего, в выборе блюд ты тоже смелее других."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lockas av det nya, även när det gäller mat. Du älskar att upptäcka – och du är nog lite modigare än de flesta när du beställer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความแปลกใหม่ทำให้คุณตื่นเต้น แม้แต่เรื่องกิน คุณสนุกกับการค้นพบ และน่าจะกล้าลองอาหารแปลกๆ มากกว่าคนอื่นด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemekte bile yenilik seni heyecanlandırıyor. Keşfetmenin tadını çıkarıyorsun ve muhtemelen yemek konusunda da maceracısın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе захоплює новизна навіть у виборі ресторанів. Тобі до вподоби відкриття — і в їжі ти, мабуть, теж любиш експерименти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngay cả chuyện ăn uống, cái mới cũng khiến bạn hào hứng. Bạn mê cảm giác khám phá — và chắc cũng ăn uống phiêu lưu hơn người khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连吃饭你都喜欢新鲜感。你享受发现的过程，口味大概也更敢尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連吃飯你都喜歡新鮮感。你享受探索的過程，口味大概也比較敢嘗試。"
          }
        }
      }
    },
    "Novelty is the fuel. New experiences together keep you from going stale. You need to keep exploring as a couple." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجديد هو الوقود. التجارب الجديدة معًا تحميكما من الرتابة، وتحتاجان إلى مواصلة الاستكشاف كثنائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palivem jsou novinky. Nové společné zážitky vám nedovolí zevšednět. Jako pár potřebujete pořád objevovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye er brændstoffet. Nye oplevelser sammen forhindrer, at det bliver kedeligt. I skal blive ved med at udforske som par."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues ist der Treibstoff. Gemeinsame neue Erlebnisse schützen euch vor dem Alltagstrott. Als Paar solltet ihr immer weiter auf Entdeckungstour gehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καινούργιο είναι το καύσιμο. Οι νέες εμπειρίες μαζί δεν σας αφήνουν να μπαγιατέψετε. Χρειάζεται να εξερευνάτε συνέχεια ως ζευγάρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novedad es el combustible. Vivir experiencias nuevas juntos evita que la relación se estanque. Necesitas seguir explorando en pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutuus on polttoaine. Yhteiset uudet kokemukset estävät teitä urautumasta. Teidän pitää jatkaa uuden löytämistä yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bago ang gasolina. Pinipigilan kayo ng mga bagong karanasan na maging matabang. Kailangan ninyong patuloy na mag-explore bilang magkapareha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouveauté, c'est le carburant. Les expériences inédites à deux vous évitent de tomber dans la routine. Vous avez besoin de continuer à explorer en couple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החידוש הוא הדלק. חוויות חדשות ביחד שומרות עליכם רעננים. חשוב לך להמשיך לגלות ביחד כזוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नयापन ही ईंधन है। साथ में नए अनुभव रिश्ते को बासी होने से बचाते हैं। एक जोड़े के तौर पर आपको खोजते रहना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újdonság az üzemanyag. A közös új élmények nem hagyják, hogy belefásuljatok. Szükségetek van rá, hogy párként folyamatosan új dolgokat fedezzetek fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal baru adalah bahan bakarnya. Pengalaman baru bersama menjaga hubungan kalian tetap segar. Kalian perlu terus menjelajah sebagai pasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La novità è il carburante. Le esperienze nuove insieme vi impediscono di cadere nella monotonia. Avete bisogno di continuare a esplorare come coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しさが燃料です。ふたりでの新しい体験が、マンネリを防いでくれます。ふたりで新しいことを探し続けたいタイプです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로움이 연료예요. 함께하는 새로운 경험이 관계를 지루하지 않게 해 줘요. 커플로서 계속 탐험해야 하는 타입이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkara baharu ialah bahan bakarnya. Pengalaman baharu bersama menghalang hubungan anda daripada jadi hambar. Anda perlu terus meneroka sebagai pasangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye er drivstoffet. Nye opplevelser sammen hindrer at det blir stillestående. Dere må fortsette å utforske som par."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe dingen zijn de brandstof. Samen nieuwe ervaringen opdoen houdt het fris. Als stel moeten jullie blijven ontdekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowość to paliwo. Nowe wspólne przeżycia chronią was przed stagnacją. Wspólne odkrywanie świata to dla ciebie potrzeba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade é o combustível. Experiências novas juntos evitam que a relação caia na mesmice. Vocês precisam continuar explorando como casal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noutatea e combustibilul. Experiențele noi împreună vă feresc de monotonie. Aveți nevoie să explorați mereu, în doi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна — топливо. Новые впечатления вместе не дают вам заскучать. Вам нужно продолжать открывать мир вдвоём."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nya är bränslet. Nya upplevelser tillsammans hindrar er från att gå i stå. Ni behöver fortsätta upptäcka som par."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความแปลกใหม่คือเชื้อเพลิง ประสบการณ์ใหม่ๆ ด้วยกันช่วยไม่ให้ความสัมพันธ์จืดชืด คุณต้องออกสำรวจไปด้วยกันเรื่อยๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakıtın yenilik. Birlikte yaşanan yeni deneyimler sizi bayatlamaktan koruyor. Çift olarak keşfetmeye devam etmeniz gerek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новизна — це паливо. Нові спільні враження не дають вам застоюватися. Вам потрібно й далі досліджувати світ як пара."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự mới mẻ là nhiên liệu. Những trải nghiệm mới cùng nhau giúp hai bạn không nhàm chán. Hai bạn cần tiếp tục khám phá cùng nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鲜感就是燃料。一起经历新事物，能让感情不至于变得平淡。你们需要一直一起探索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鮮感就是燃料。一起體驗新事物，讓你們不會變得乏味。你們需要一起持續探索。"
          }
        }
      }
    },
    "Observational — I notice things others miss" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائم على الملاحظة: ألتقط ما يفوت الآخرين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observační – všímám si toho, co ostatní přehlédnou"
