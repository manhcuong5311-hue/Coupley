        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যিমান পাৰি ভ্ৰমণ কৰা — সকলো চোৱা"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkün qədər çox səyahət — hər yeri görmək"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падарожнічаць як мага больш — пабачыць усё"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да пътувам колкото може повече – да видя всичко"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যত পারি ঘুরব — সবকিছু দেখব"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putovati što više – vidjeti sve"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viatjar tant com pugui — veure-ho tot"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestovat, co to jde – vidět všechno"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teithio cymaint â phosib — gweld popeth"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejse så meget som muligt – se det hele"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viel reisen wie möglich – alles sehen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταξίδια όσο γίνεται — να τα δω όλα"
