        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संतुलित नज़रिया। काम पर गर्व है, पर उसमें ख़ुद को खोए बिना। इस मामले में आपके साथ रिश्ता निभाना शायद आसान है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravnoteža. Imaš profesionalni ponos, ali se u njemu ne gubiš. S tobom je vjerojatno lako biti u vezi kad je o ovome riječ."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekilibre. Ou gen fyète pwofesyonèl san ou pa pèdi tèt ou ladan l. Sou pwen sa a, ou pwobableman fasil pou viv avè ou nan yon relasyon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiegyensúlyozott vagy. Büszke vagy a munkádra, de nem veszel el benne. Ezen a téren valószínűleg könnyű veled kapcsolatban lenni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հավասարակշռված։ Ունես մասնագիտական հպարտություն՝ առանց քեզ կորցնելու դրա մեջ։ Այս հարցում հավանաբար քեզ հետ հեշտ է հարաբերություններ ունենալ։"
