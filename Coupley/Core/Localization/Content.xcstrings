    "Sad + not drained often wants to be heard, not managed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزن مع طاقة باقية غالبًا يريد أن يُسمَع، لا أن يُدار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smutek bez vyčerpání často chce být vyslyšen, ne řízen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når man er trist, men ikke drænet, vil man ofte høres, ikke håndteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traurig, aber nicht erschöpft heißt oft: gehört werden wollen, nicht gemanagt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν υπάρχει λύπη αλλά όχι εξάντληση, ο άλλος συνήθως θέλει να τον ακούσουν, όχι να τον διαχειριστούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hay tristeza pero no agotamiento, lo que suele hacer falta es que alguien escuche, no que lo gestione todo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surullinen mutta ei uupunut haluaa usein tulla kuulluksi, ei hoidetuksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag malungkot pero may lakas pa, kadalasan gusto niyang marinig, hindi asikasuhin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triste mais pas à plat, on a souvent besoin d'une oreille, pas d'un plan d'action."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצב בלי תשישות בדרך כלל רוצה הקשבה, לא ניהול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदासी हो पर थकान न हो, तो अक्सर सुने जाने की चाह होती है, संभाले जाने की नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aki szomorú, de nem kimerült, gyakran meghallgatásra vágyik, nem irányításra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat sedih tapi tidak lelah, orang sering ingin didengar, bukan diatur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tristezza senza stanchezza: spesso si vuole essere ascoltati, non gestiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悲しくてもまだ余力があるときは、なんとかしてもらうより、話を聴いてほしいことが多いものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬프지만 지치지 않았을 땐 관리받기보다 들어 주길 원할 때가 많아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila sedih tapi tidak letih, dia selalunya mahu didengari, bukan diuruskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som er trist, men ikke tom, vil ofte bli hørt, ikke håndtert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdrietig maar niet uitgeput wil vaak gehoord worden, niet bijgestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smutek przy zachowanej energii często potrzebuje wysłuchania, a nie ogarniania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tristeza sem cansaço muitas vezes quer ser ouvida, não gerenciada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tristețea fără epuizare vrea adesea să fie auzită, nu gestionată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда грустно, но силы есть, обычно хочется, чтобы услышали, а не взялись руководить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledsen men inte utmattad vill ofta bli hörd, inte hanterad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เศร้าแต่ยังมีแรง มักอยากให้มีคนฟัง ไม่ใช่ให้มีคนจัดการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüzünlü ama tükenmemiş biri çoğu zaman yönetilmek değil, duyulmak ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сумно, але сили є, хочеться, щоб тебе почули, а не керували тобою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buồn nhưng chưa kiệt sức thì thường muốn được lắng nghe, không muốn bị “xử lý”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "难过但还有精力时，往往更想被倾听，而不是被安排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難過但還有力氣時，通常是想被聽見，而不是被安排。"
          }
        }
      }
    },
    "Safety net first. This is one of the most loving things a couple can do for each other — removing financial anxiety." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبكة الأمان أولًا. التخلّص من القلق المالي من أصدق أشكال الحب التي يمكن أن يقدّمها الشريكان أحدهما للآخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív záchranná síť. Zbavit se finanční úzkosti je jedna z nejláskyplnějších věcí, které pro sebe pár může udělat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedsnettet først. At fjerne økonomisk bekymring er noget af det mest kærlige, et par kan gøre for hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst das Sicherheitsnetz. Eine der liebevollsten Sachen, die ein Paar füreinander tun kann – Geldsorgen aus dem Weg räumen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρώτα το δίχτυ ασφαλείας. Είναι από τα πιο τρυφερά πράγματα που μπορεί να κάνει ένα ζευγάρι ο ένας για τον άλλον — να διώξει το οικονομικό άγχος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero, la red de seguridad. Quitarse la ansiedad económica es una de las cosas más amorosas que una pareja puede hacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvaverkko ensin. Tämä on yksi rakastavimmista asioista, joita pari voi tehdä toisilleen – rahahuolten poistaminen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety net muna. Isa ito sa pinakamapagmahal na magagawa ng magkapareha para sa isa’t isa — ang alisin ang pag-aalala sa pera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filet de sécurité d'abord. C'est l'un des plus beaux cadeaux qu'un couple puisse se faire : se libérer de l'angoisse financière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודם רשת ביטחון. זו אחת המחוות הכי אוהבות שזוג יכול לתת זה לזה — להסיר את הדאגה הכלכלית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले सुरक्षा कवच। पैसों की चिंता दूर करना — यह उन सबसे प्यार भरे कामों में से एक है जो एक जोड़ा एक-दूसरे के लिए कर सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először a biztonsági háló. Ez az egyik legszeretetteljesebb dolog, amit egy pár egymásért tehet – elvenni a pénzügyi szorongást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring pengaman dulu. Ini salah satu bentuk kasih sayang terbesar yang bisa kalian berikan satu sama lain — menghapus kecemasan soal uang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima la rete di sicurezza. È uno dei gesti più amorevoli che una coppia possa fare: togliersi a vicenda l’ansia per i soldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずは安全網から。お金の不安を取り除くことは、ふたりがお互いにできる最も愛情深いことのひとつです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전망이 먼저예요. 돈 걱정을 덜어 주는 건 커플이 서로에게 해 줄 수 있는 가장 다정한 일 중 하나예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring keselamatan dulu. Ini salah satu perkara paling penyayang yang boleh dilakukan oleh pasangan untuk satu sama lain — menghilangkan kebimbangan kewangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetsnett først. Å fjerne økonomisk uro er noe av det mest kjærlige et par kan gjøre for hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst een vangnet. Financiële zorgen wegnemen is een van de liefdevolste dingen die een stel voor elkaar kan doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw siatka bezpieczeństwa. Zdjęcie z siebie nawzajem lęku o pieniądze to jedna z najczulszych rzeczy, jakie para może dla siebie zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro a rede de segurança. É uma das coisas mais amorosas que um casal pode fazer um pelo outro — tirar a ansiedade financeira da equação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întâi plasa de siguranță. E unul dintre cele mai frumoase lucruri pe care și le pot oferi doi parteneri — scăparea de grijile financiare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала страховка. Избавить друг друга от тревоги о деньгах — одно из самых заботливых дел, на которые способна пара."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyddsnätet först. Att ta bort ekonomisk oro är något av det mest kärleksfulla ett par kan göra för varandra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีตาข่ายรองรับไว้ก่อน นี่คือหนึ่งในสิ่งที่แสดงความรักที่สุดที่คู่รักทำให้กันได้ คือการขจัดความกังวลเรื่องเงิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce güvenlik ağı. Maddi kaygıyı ortadan kaldırmak, bir çiftin birbiri için yapabileceği en sevgi dolu şeylerden biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу — запас міцності. Позбавити одне одного фінансової тривоги — один із найтурботливіших кроків для пари."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưới an toàn trước đã. Đây là một trong những điều yêu thương nhất hai người có thể làm cho nhau — gỡ bỏ nỗi lo tiền bạc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先有安全网。帮彼此卸下经济上的焦虑，是情侣能为对方做的最有爱的事之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先有安全網。消除金錢焦慮，是兩人能為彼此做的最有愛的事之一。"
          }
        }
      }
    },
