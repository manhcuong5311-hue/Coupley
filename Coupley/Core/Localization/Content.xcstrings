        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubimci su dio tvog života i svakog budućeg zajedničkog doma. Voljenoj osobi koja ne voli životinje bit će teže."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mascotes formen part de la teva vida i de qualsevol convivència futura. Una parella a qui no agradin els animals ho tindrà més difícil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazlíčci patří k tvému životu i k jakémukoli budoucímu bydlení. Protějšek, který nemá rád zvířata, to bude mít těžší."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae anifeiliaid anwes yn rhan o dy fywyd ac o unrhyw drefniant byw yn y dyfodol. Bydd hi'n anoddach i bartner sydd ddim yn hoffi anifeiliaid."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kæledyr er en del af dit liv og enhver fremtidig bolig. En partner, der ikke kan lide dyr, får det svært."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haustiere gehören zu deinem Leben und zu jeder künftigen Wohnsituation. Wer Tiere nicht mag, wird es schwer haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κατοικίδια είναι κομμάτι της ζωής σου και κάθε μελλοντικού σπιτιού σου. Ένα ταίρι που δεν αγαπά τα ζώα θα δυσκολευτεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las mascotas forman parte de tu vida y de cualquier hogar futuro. A una pareja a la que no le gusten los animales le costará más."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemmikloomad on osa sinu elust ja igast tulevasest kodust. Partneril, kellele loomad ei meeldi, on raskem."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskotak zure bizitzaren eta etorkizuneko edozein etxeren parte dira. Animaliak gustuko ez dituen bikotekide batek zailagoa izango du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حیوان خانگی بخشی از زندگی تو و هر خانهٔ آینده‌ات است. پارتنری که حیوان‌ها را دوست ندارد، کارش سخت‌تر خواهد بود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemmikit kuuluvat elämääsi ja jokaiseen tulevaan asumisratkaisuun. Kumppanilla, joka ei pidä eläimistä, on tässä vaikeampaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahagi ng buhay mo ang mga alagang hayop at ng anumang magiging tirahan mo. Mahihirapan ang partner na hindi mahilig sa hayop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les animaux font partie de ta vie et de tout futur foyer. Quelqu'un qui n'aime pas les animaux aura plus de mal."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is cuid de do shaol iad peataí agus d'aon socrú maireachtála amach anseo. Ní bheidh sé éasca do pháirtí a sheachnaíonn ainmhithe."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mascotas forman parte da túa vida e de calquera convivencia futura. A unha parella á que non lle gusten os animais custaralle máis."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પાળતુ પ્રાણી તમારા જીવનનો અને ભવિષ્યના ઘરનો ભાગ છે. જેમને પ્રાણીઓ ન ગમતાં હોય એવા પાર્ટનર માટે આ અઘરું રહેશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabbobin gida ɓangare ne na rayuwarku da kowane irin zaman da za ku yi a gaba. Abokin zama da ba ya son dabbobi zai sha wahala."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיות מחמד הן חלק מהחיים שלך ומכל מגורים עתידיים. למי שלא אוהב חיות יהיה קשה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पालतू आपकी ज़िंदगी का हिस्सा हैं, और आगे जहाँ भी रहना हो, वहाँ भी होंगे। जानवर नापसंद करने वाले पार्टनर के लिए यह मुश्किल हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubimci su dio tvog života i svakog budućeg doma. Voljenoj osobi koja ne voli životinje bit će teže."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bèt yo fè pati lavi ou ak nenpòt fason nou ta viv ansanm. Yon patnè ki pa renmen bèt ap gen plis difikilte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háziállatok az életed részei, és minden jövőbeli otthonodé is. Annak, aki nem szereti az állatokat, nehezebb dolga lesz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտանի կենդանիները քո կյանքի ու ապագա ցանկացած բնակության մաս են։ Կենդանիներ չսիրող զուգընկերոջ համար ավելի դժվար կլինի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewan peliharaan adalah bagian dari hidupmu dan rencana tempat tinggalmu ke depan. Pasangan yang nggak suka hewan akan lebih kesulitan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anụ ụlọ bụ akụkụ ndụ gị na ebe ọ bụla unu ga-ebi n'ọdịnihu. Onye na-enweghị mmasị n'anụmanụ ga-ahụ ya ka ihe siri ike."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gæludýr eru hluti af lífi þínu og allri framtíðarbúsetu. Maki sem líkar ekki við dýr á eftir að eiga erfiðara uppdráttar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli animali fanno parte della tua vita e di qualsiasi futura casa. Chi non ama gli animali avrà qualche difficoltà in più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペットは生活の一部で、これからの住まいにも欠かせない存在です。動物が苦手なパートナーだと少し大変かもしれません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kewan ingon-ingon iku bageyan urip panjenengan lan panggonan manggon ing tembe mburi. Pasangan sing ora seneng kewan bakal luwih angel."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შინაური ცხოველები შენი ცხოვრებისა და ნებისმიერი მომავალი საცხოვრებლის ნაწილია. პარტნიორს, რომელსაც ცხოველები არ უყვარს, გაუჭირდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үй жануарлары — өміріңнің және болашақ тұрмысыңның бір бөлігі. Жануарларды ұнатпайтын серікке қиынырақ болады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សត្វចិញ្ចឹមជាផ្នែកមួយនៃជីវិតអ្នក និងការរស់នៅនាពេលអនាគត។ ដៃគូដែលមិនចូលចិត្តសត្វ នឹងពិបាកជាង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಾಕುಪ್ರಾಣಿಗಳು ನಿಮ್ಮ ಬದುಕಿನ ಮತ್ತು ಮುಂದಿನ ಯಾವುದೇ ವಾಸದ ಭಾಗ. ಪ್ರಾಣಿಗಳನ್ನು ಇಷ್ಟಪಡದ ಸಂಗಾತಿಗೆ ಇದು ಕಷ್ಟವಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물은 삶의 일부이고 앞으로 어디서 살든 함께예요. 동물을 좋아하지 않는 연인이라면 쉽지 않을 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heywanên malê beşek ji jiyana te û her rewşeke jiyanê ya pêşerojê ne. Ji bo hevjînek ku ji heywanan hez nake dê dijwartir be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үй жаныбарлары — жашооңдун жана келечектеги ар кандай турмушуңдун бир бөлүгү. Жаныбарларды жактырбаган сүйгөнүңө оор болот."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déieren gehéieren zu dengem Liewen an zu all zukünfteger Wunnsituatioun. E Schatz, deen Déieren net gär huet, hätt et méi schwéier."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສັດລ້ຽງຄືສ່ວນໜຶ່ງຂອງຊີວິດເຈົ້າ ແລະ ບ່ອນຢູ່ໃນອະນາຄົດ ຄູ່ທີ່ບໍ່ມັກສັດຈະລຳບາກກວ່າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augintiniai – tavo gyvenimo ir bet kokių ateities namų dalis. Gyvūnų nemėgstančiai antrajai pusei bus sunkiau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mājdzīvnieki ir daļa no tavas dzīves un jebkuras nākotnes mājas. Otrajai pusei, kurai nepatīk dzīvnieki, būs grūtāk."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ampahany amin'ny fiainanao sy ny trano rehetra hipetrahanao amin'ny ho avy ny biby fiompy. Ho sarotra kokoa ho an'ny olon-tiana tsy tia biby izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He wāhanga ngā mōkai o tō ora, o tō noho ā muri ake. Ka uaua ake mō tētahi hoa aroha kāore e pai ana ki ngā kararehe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Милениците се дел од твојот живот и од секој иден заеднички дом. На половинка што не сака животни ќе ѝ биде потешко."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വളർത്തുമൃഗങ്ങൾ നിങ്ങളുടെ ജീവിതത്തിന്റെയും ഭാവിയിലെ ഏത് താമസസാഹചര്യത്തിന്റെയും ഭാഗമാണ്. മൃഗങ്ങളെ ഇഷ്ടമില്ലാത്ത ഒരു പങ്കാളിക്ക് ഇത് ബുദ്ധിമുട്ടായേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэжээвэр амьтан бол чиний амьдрал, ирээдүйн аливаа гэрийн нэг хэсэг. Амьтанд дургүй хань хүндрэлтэй байх болно."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाळीव प्राणी तुमच्या आयुष्याचा आणि भविष्यातल्या कोणत्याही घराचा भाग आहेत. प्राणी न आवडणाऱ्या जोडीदाराला हे थोडे अवघड जाईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiwan peliharaan sebahagian daripada hidup anda dan tempat tinggal anda pada masa depan. Pasangan yang tidak suka haiwan akan lebih sukar menyesuaikan diri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-annimali huma parti minn ħajtek u minn kull fejn se tgħixu fil-futur. Partner li ma jħobbx l-annimali se jsibha aktar diffiċli."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အိမ်မွေးတိရစ္ဆာန်က သင့်ဘဝနဲ့ အနာဂတ် နေထိုင်မှုရဲ့ အစိတ်အပိုင်းပါ။ တိရစ္ဆာန် မကြိုက်တဲ့ ချစ်သူအတွက်တော့ ပိုခက်ခဲမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjæledyr er en del av livet ditt og av enhver framtidig bosituasjon. En partner som ikke liker dyr, vil få det tyngre."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घरपालुवा जनावर तपाईंको जीवन र भविष्यको कुनै पनि बसाइको हिस्सा हुन्। जनावर मन नपराउने पार्टनरलाई गाह्रो हुन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huisdieren horen bij je leven en bij elke toekomstige woonsituatie. Een partner die niet van dieren houdt, krijgt het lastiger."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziweto ndi gawo la moyo wanu ndi kumene mudzakhale m'tsogolo. Wokondedwa wosakonda nyama zingamuvute."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bineensonni manaa kutaa jireenya keetii fi haala jireenya gara fuulduraa kamiyyuu ti. Jaalallee bineensota hin jaallanneef ni ulfaata."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପୋଷା ଜୀବଜନ୍ତୁ ଆପଣଙ୍କ ଜୀବନ ଓ ଭବିଷ୍ୟତର ଯେକୌଣସି ରହଣିର ଅଂଶ। ଜୀବଜନ୍ତୁ ପସନ୍ଦ କରୁନଥିବା ସାଥୀଙ୍କ ପାଇଁ ଏହା କଷ୍ଟକର ହେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਾਲਤੂ ਜਾਨਵਰ ਤੁਹਾਡੀ ਜ਼ਿੰਦਗੀ ਅਤੇ ਭਵਿੱਖ ਦੇ ਕਿਸੇ ਵੀ ਘਰ ਦਾ ਹਿੱਸਾ ਹਨ। ਜਾਨਵਰ ਪਸੰਦ ਨਾ ਕਰਨ ਵਾਲੇ ਪਾਰਟਨਰ ਲਈ ਇਹ ਔਖਾ ਹੋਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwierzęta są częścią twojego życia i każdego przyszłego mieszkania. Komuś, kto nie lubi zwierząt, będzie trudniej."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کورني څاروي ستاسو د ژوند او هر راتلونکي ګډ کور برخه ده. هغه ملګری چې څاروي نه خوښوي، ستونزه به ولري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets fazem parte da sua vida e de qualquer casa futura. Alguém que não goste de animais vai ter mais dificuldade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os animais fazem parte da tua vida e de qualquer casa futura. Um par que não goste de animais vai ter mais dificuldade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animalele fac parte din viața ta și din orice cămin viitor. Un partener căruia nu-i plac animalele o va avea mai greu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питомцы — часть твоей жизни и любого будущего дома. Партнёру, который не любит животных, будет непросто."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amatungo ni igice cy'ubuzima bwawe n'aho uzaba hose mu gihe kizaza. Umukunzi udakunda inyamaswa bizamugora kurushaho."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සුරතල් සතුන් ඔබේ ජීවිතයේත් අනාගතයේ ජීවත් වෙන ඕනෑම තැනකත් කොටසක්. සතුන්ට අකමැති සහකරුවෙක්ට මේක අමාරු වෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvieratá sú súčasťou tvojho života aj každého budúceho bývania. Polovička, ktorá zvieratá nemá rada, to bude mať ťažšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljubljenčki so del tvojega življenja in vsakega prihodnjega doma. Partnerju, ki ne mara živali, bo težje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mhuka chikamu cheupenyu hwako uye chero kwaungagara mune ramangwana. Mudiwa asingadi mhuka zvichamunetsa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xayawaanka guriga waa qayb noloshaada ka mid ah iyo xaalad kasta oo nololeed oo mustaqbalka ah. Lammaane aan xayawaanka jeclayn way ku adkaan doontaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kafshët janë pjesë e jetës sate dhe e çdo situate të ardhshme banimi. Një partner që s’i do kafshët do ta ketë më të vështirë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Љубимци су део твог живота и сваког будућег заједничког дома. Половини која не воли животиње биће теже."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingon-ingon téh bagian tina kahirupan anjeun sareng kaayaan hirup naon waé ka hareupna. Pasangan anu teu resep sato bakal langkung hésé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husdjur är en del av ditt liv och av framtida boende. En partner som inte gillar djur får det svårare."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanyama vipenzi ni sehemu ya maisha yako na ya makazi yoyote ya baadaye. Mwenzi asiyependa wanyama atapata ugumu zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செல்லப்பிராணிகள் உங்கள் வாழ்க்கையின் ஒரு பகுதி, எதிர்கால வாழ்விடத்திலும் இருக்கும். விலங்குகளைப் பிடிக்காத துணைக்கு இது கடினமாக இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పెంపుడు జంతువులు మీ జీవితంలో, భవిష్యత్తులో మీరు ఉండే ఏ ఇంట్లోనైనా భాగమే. జంతువులు ఇష్టం లేని భాగస్వామికి ఇది కష్టంగా ఉంటుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳайвоноти хонагӣ қисми зиндагии ту ва ҳар гуна зиндагии ояндаанд. Ёре, ки ҳайвонотро дӯст намедорад, мушкилтар хоҳад дошт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัตว์เลี้ยงเป็นส่วนหนึ่งของชีวิตคุณและการอยู่อาศัยในอนาคตทุกรูปแบบ คนรักที่ไม่ชอบสัตว์จะลำบากกว่า"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዘቤታዊ እንስሳታት ክፋል ህይወትኩምን ዝኾነ ናይ መጻኢ ናብራኹምን እዮም። እንስሳ ዘይፈቱ መጻምዲ ዝያዳ ክኸብዶ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öý haýwanlary seniň durmuşyňyň we geljekki islendik öýüňiň bir bölegi. Haýwanlary halamaýan söýgüli üçin bu kyn bolar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evcil hayvanlar hayatının ve gelecekteki her yaşam düzeninin bir parçası. Hayvanları sevmeyen bir partner zorlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улюбленці — частина твого життя і будь-якого майбутнього дому. Половинці, яка не любить тварин, буде нелегко."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پالتو جانور آپ کی زندگی اور مستقبل کے ہر گھر کا حصہ ہیں۔ جانوروں کو ناپسند کرنے والے ساتھی کے لیے یہ مشکل ہوگا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uy hayvonlari — hayotingizning va kelajakdagi har qanday turar joyingizning bir qismi. Hayvonlarni yoqtirmaydigan sherikka qiyinroq boʻladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thú cưng là một phần cuộc sống của bạn và của mọi kế hoạch sống chung sau này. Người không thích động vật sẽ khó hòa hợp hơn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izilwanyana ziyinxalenye yobomi bakho nayo nayiphi na indlela yokuhlala kwixesha elizayo. Iqabane elingazithandiyo izilwanyana liya kuba nobunzima."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹranko ọ̀sìn jẹ́ apá kan ayé yín àti ibikíbi tí ẹ bá máa gbé lọ́jọ́ iwájú. Yóò ṣòro fún olólùfẹ́ tí kò fẹ́ràn ẹranko."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寵物是你生活的一部分，也會是將來任何居住安排的一部分。不喜歡動物的另一半會比較辛苦。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宠物是你生活的一部分，将来不管住在哪里，都少不了它。不喜欢动物的另一半可能会比较难适应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寵物是你生活的一部分，也會是未來居住安排的一部分。不喜歡動物的另一半可能會比較辛苦。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izilwane ezifuywayo ziyingxenye yempilo yakho nanoma yisiphi isimo sokuhlala esizayo. Umlingani ongazithandi izilwane uzothola kunzima."
          }
        }
      }
