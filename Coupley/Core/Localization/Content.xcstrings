        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сил немає, полегшення > запевнення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đã cạn năng lượng, được nhẹ gánh quý hơn lời trấn an."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力耗尽时，减负比安慰更管用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒力氣的時候，減輕負擔比安慰更有用。"
          }
        }
