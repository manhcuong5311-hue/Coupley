        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음에 걸리는 게 있을 때, 어떻게 꺼내나요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
