    "Say it or don't — but don't say it sideways. You'd rather hear something hard than feel tension you can't address." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sê dit of moenie – maar moenie dit skeef sê nie. Jy hoor liewer iets hards as om spanning te voel wat jy nie kan aanspreek nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወይ ይናገሩት ወይ ይተዉት — ግን በጎን አይናገሩት። መፍታት የማይችሉትን ውጥረት ከመሸከም ከባድ ነገር መስማት ይመርጣሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قولوها أو لا تقولوها، لكن لا تلمّحوا بها. تفضّلون سماع شيء صعب على الشعور بتوتر لا يمكنكم مواجهته."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কওক বা নকওক — কিন্তু ঘূৰাই-পকাই নকব। সামলাব নোৱৰা টানটোৰ অনুভৱ কৰাতকৈ আপুনি কঠিন কথা শুনিবলৈকে বেছি পছন্দ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya de, ya demə — amma eyhamla demə. Həll edə bilmədiyin gərginliyi hiss etməkdənsə, çətin bir sözü eşitməyi üstün tutursan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажы або не кажы — толькі не намёкамі. Табе лепш пачуць нешта цяжкае, чым адчуваць напружанне, з якім нічога не зробіш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажи го или недей – но не със заобикалки. Предпочиташ да чуеш нещо трудно, отколкото да усещаш напрежение, с което не можеш да се справиш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বললে সোজাসুজি বলো, নইলে বোলো না — কিন্তু বাঁকা করে নয়। যে চাপা টানাপোড়েন মেটানো যায় না, তার চেয়ে কঠিন কথা শোনাও তোমার কাছে ভালো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reci ili nemoj – ali ne okolišaj. Radije ćeš čuti nešto teško nego osjećati napetost koju ne možeš riješiti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digues-ho o no ho diguis — però no ho diguis de biaix. Prefereixes sentir una cosa dura que notar una tensió que no pots abordar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni to, nebo neříkej – ale ne oklikou. Raději uslyšíš něco tvrdého, než nést napětí, se kterým nejde nic dělat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dweud e neu beidio — ond paid â'i ddweud o'r ochr. Byddai'n well gen ti glywed rhywbeth anodd na theimlo tensiwn na elli di fynd i'r afael ag e."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig det, eller lad være – men sig det ikke ad omveje. Du vil hellere høre noget svært end mærke en spænding, du ikke kan tage fat på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag es oder lass es – aber nicht durch die Blume. Du hörst lieber etwas Unangenehmes, als eine Spannung zu spüren, die du nicht ansprechen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες το ή μην το πεις — αλλά όχι πλαγίως. Προτιμάς να ακούσεις κάτι δύσκολο παρά να νιώθεις μια ένταση που δεν μπορείς να συζητήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo o no lo digas, pero sin indirectas. Prefieres escuchar algo difícil antes que sentir una tensión que no puedes resolver."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ütle välja või ära ütle — aga ära ütle seda kõrvalt. Pigem kuuled midagi rasket, kui tunned pinget, millega ei saa midagi teha."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esan edo ez esan — baina ez esan zeharka. Nahiago duzu zerbait gogorra entzun, konpondu ezin duzun tentsioa sentitu baino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا بگو یا نگو — ولی با کنایه نگو. ترجیح می‌دهی حرف سختی بشنوی تا تنشی را حس کنی که نمی‌شود درباره‌اش حرف زد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano tai ole sanomatta – mutta älä sano kiertoteitse. Kuulet mieluummin jotain vaikeaa kuin tunnet jännitettä, johon et voi tarttua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabihin o huwag — pero huwag nang paikot-ikot. Mas gusto mo pang makarinig ng mabigat na bagay kaysa maramdaman ang tensyong hindi mo maharap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-le ou ne le dis pas, mais pas de biais. Tu préfères entendre une vérité difficile que sentir une tension impossible à aborder."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abair é nó ná habair — ach ná habair i gcúinne do bhéil é. B'fhearr leat rud crua a chloisteáil ná teannas a mhothú nach féidir leat dul i ngleic leis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dío ou non o digas, pero non o digas de esguello. Prefires escoitar algo duro a sentir unha tensión que non podes tratar."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કહેવું હોય તો કહો, નહીં તો નહીં — પણ આડકતરું ન કહો. જે તણાવ વિશે તમે કશું કરી ન શકો એ અનુભવવા કરતાં તમને કંઈક અઘરું સાંભળવું વધુ પસંદ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko a faɗa, ko a bari — amma ba a faɗa a fakaice ba. Gara ku ji abu mai wuya da ku ji tashin hankalin da ba za ku iya magancewa ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להגיד או לא להגיד — אבל לא מהצד. עדיף לך לשמוע משהו קשה מאשר להרגיש מתח שאי אפשר לגעת בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहना है तो साफ़ कहिए, वरना नहीं — पर घुमा-फिराकर नहीं। जिस तनाव पर बात ही न हो सके, उसे झेलने से अच्छा आपको कोई कड़वी बात सीधे सुन लेना लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reci ili nemoj – ali ne zaobilaznim putem. Radije čuješ nešto teško nego da osjećaš napetost koju ne možeš riješiti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di l oswa pa di l — men pa di l an kachèt. Ou pito tande yon bagay ki di pase santi yon tansyon ou pa ka abòde."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd ki, vagy ne mondd – de ne kerülőúton. Inkább hallasz valami nehezet, mint hogy olyan feszültséget érezz, amit nem tudsz kezelni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կամ ասա, կամ մի՛ ասա — բայց ոչ ակնարկներով։ Նախընտրում ես դառը բան լսել, քան զգալ լարվածություն, որի մասին չես կարող խոսել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilang atau jangan sama sekali — tapi jangan menyindir. Kamu lebih suka mendengar hal yang berat daripada merasakan ketegangan yang tak bisa dibahas."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwuo ya ma ọ bụ ahapụ — mana ekwula ya n'akụkụ. Ọ ka mma gị ịnụ ihe siri ike karịa inwe mmetụta esemokwu ị na-enweghị ike ịkpọ aha."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segðu það eða slepptu því – en ekki undir rós. Þú vilt frekar heyra eitthvað erfitt en finna spennu sem ekki er hægt að ræða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dillo o non dirlo — ma non dirlo di traverso. Preferisci sentire una cosa difficile piuttosto che percepire una tensione che non puoi affrontare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言うなら言う、言わないなら言わない。遠回しなのが苦手なタイプです。どうにもできない空気より、つらいことでもはっきり聞きたいのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omongna utawa aja — nanging aja muter-muter. Panjenengan luwih seneng krungu bab sing abot tinimbang ngrasakake ketegangan sing ora bisa dirembug."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ან თქვი, ან არა — ოღონდ ირიბად ნუ იტყვი. გირჩევნია, რამე მძიმე მოისმინო, ვიდრე იგრძნო დაძაბულობა, რომელსაც ვერ შეეხები."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Айт немесе айтпа — бірақ жанамалап айтпа. Шешуге болмайтын шиеленісті сезгеннен гөрі ауыр сөзді естігенді жөн көресің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "និយាយ ឬមិននិយាយ — តែកុំនិយាយវៀចវេរ។ អ្នកសុខចិត្តឮរឿងពិបាក ជាជាងមានអារម្មណ៍តានតឹងដែលមិនអាចដោះស្រាយបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೇಳಿ, ಇಲ್ಲವೇ ಬಿಡಿ — ಆದರೆ ಸುತ್ತಿ ಬಳಸಿ ಹೇಳಬೇಡಿ. ಬಗೆಹರಿಸಲಾಗದ ಉದ್ವಿಗ್ನತೆ ಅನುಭವಿಸುವುದಕ್ಕಿಂತ ಕಠಿಣ ಮಾತನ್ನು ಕೇಳುವುದೇ ನಿಮಗಿಷ್ಟ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말을 하든 안 하든, 돌려 말하는 건 싫은 타입이에요. 풀 수 없는 긴장감보다 차라리 듣기 힘든 말이 나아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An bibêje an nebêje — lê bi alî ve nebêje. Tu tercîh dikî tiştekî dijwar bibihîzî ji hîskirina tengezariyeke ku tu nikarî behs bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Айт же айтпа — бирок кыйыр айтпа. Чечүүгө мүмкүн болбогон чыңалууну сезгенден көрө, оор сөздү уккан жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sot et oder sot et net — mee net hannerriks. Du héiers léiwer eppes Schwéieres, wéi eng Spannung ze spieren, déi s du net uschwätze kanns."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຈະເວົ້າກໍເວົ້າ — ແຕ່ຢ່າເວົ້າອ້ອມໆ ເຈົ້າຍອມຟັງເລື່ອງຍາກໆ ດີກວ່າຮູ້ສຶກເຖິງຄວາມເຄັ່ງຕຶງທີ່ແກ້ບໍ່ໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arba pasakyk, arba ne – tik ne užuominomis. Mieliau išgirsi ką nors sunkaus, nei jausi įtampą, kurios negali įvardyti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saki vai nesaki – bet nesaki ar zemtekstu. Tu labāk dzirdētu ko grūtu, nekā justu spriedzi, ko nevar atrisināt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lazao na aza lazaina — fa aza lazaina amin'ny fomba ankolaka. Aleonao mandre zavatra sarotra toy izay mahatsapa fihenjanana tsy azonao resahina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kōrerotia, kaua rānei — engari kaua e kōrero hipa. He pai ake ki a koe te rongo i tētahi mea uaua i te rongo i te taumaha kāore e taea te whakatika."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажи или немој — но не околу-околу. Повеќе сакаш да слушнеш нешто тешко отколку да чувствуваш напнатост за која не можеш да зборуваш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പറയുന്നെങ്കിൽ നേരെ പറയുക — വളച്ചുകെട്ടി വേണ്ട. പരിഹരിക്കാനാവാത്ത ഒരു പിരിമുറുക്കം അനുഭവിക്കുന്നതിനെക്കാൾ, കടുപ്പമുള്ള ഒരു കാര്യം കേൾക്കാനാണ് നിങ്ങൾക്കിഷ്ടം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэл эсвэл бүү хэл — гэхдээ тойруулж бүү хэл. Чи шийдэж чадахгүй хурцадмал байдлыг мэдрэхээс хэцүү үнэнийг сонссоныг илүүд үздэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलायचे तर सरळ बोला, नाहीतर नको — पण आडून नको. सोडवता न येणाऱ्या ताणापेक्षा कठोर गोष्ट ऐकणे तुम्हाला जास्त बरे वाटते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cakap terus atau jangan cakap langsung — tetapi jangan berkias. Anda lebih rela mendengar sesuatu yang pahit daripada merasai ketegangan yang tidak dapat ditangani."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għidha jew tgħidhiex — imma tgħidhiex bil-ġenb. Tippreferi tisma' xi ħaġa iebsa milli tħoss tensjoni li ma tistax tindirizza."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပြောမယ်ဆို ပြော၊ မပြောလည်း နေ — ဒါပေမဲ့ ဘေးတိုက် မပြောပါနဲ့။ ဖြေရှင်းလို့မရတဲ့ တင်းမာမှုကို ခံစားနေရတာထက် ခက်ခဲတဲ့စကားကို ကြားရတာကို သင် ပိုကြိုက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det eller la være – men ikke kom med stikk. Du hører heller noe vanskelig enn å kjenne på en spenning du ikke kan ta tak i."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भन्ने भए भन्नुहोस्, नभए नभन्नुहोस् — तर घुमाएर नभन्नुहोस्। सामना गर्न नसकिने तनाव महसुस गर्नुभन्दा तपाईं कडा कुरा सुन्न रुचाउनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het of zeg het niet – maar niet via een omweg. Je hoort liever iets moeilijks dan dat je spanning voelt waar je niets mee kunt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenani kapena musanene — koma musanene mozungulira. Mumakonda kumva chinthu chovuta kuposa kumva mkangano wobisika womwe simungaukambirane."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbadhu ykn dhiisi — garuu dhokataan hin dubbatin. Dhiphina furuu hin dandeenye dhaga'uu mannaa waan ulfaataa dhaga'uu filatta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କହିବାର ଥିଲେ କୁହନ୍ତୁ, ନହେଲେ ନାହିଁ — କିନ୍ତୁ ଘୁରାଇ କୁହନ୍ତୁ ନାହିଁ। ସମାଧାନ କରିହେଉନଥିବା ଟେନସନ୍ ଅନୁଭବ କରିବାଠୁ ଆପଣ କଠିନ କଥା ଶୁଣିବା ପସନ୍ଦ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਹਿਣਾ ਹੈ ਤਾਂ ਕਹੋ — ਪਰ ਘੁਮਾ-ਫਿਰਾ ਕੇ ਨਹੀਂ। ਅਜਿਹਾ ਤਣਾਅ ਝੱਲਣ ਨਾਲੋਂ ਜਿਸ ਬਾਰੇ ਗੱਲ ਹੀ ਨਾ ਹੋ ਸਕੇ, ਤੁਹਾਨੂੰ ਕੋਈ ਕੌੜੀ ਗੱਲ ਸੁਣਨਾ ਬਿਹਤਰ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz albo nie mów – tylko nie półsłówkami. Wolisz usłyszeć coś trudnego niż czuć napięcie, z którym nic nie możesz zrobić."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا یې ووایئ یا یې مه وایئ — خو په کنایه نه. تاسو غوره ګڼئ چې سخته خبره واورئ، نه دا چې داسې کړکېچ احساس کړئ چې حل یې نشئ کولی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale ou não fale — mas não pelas beiradas. Você prefere ouvir algo difícil a sentir uma tensão que não dá para resolver."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz ou não digas — mas não por meias palavras. Preferes ouvir algo difícil a sentir uma tensão que não consegues resolver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ori o spui, ori nu — dar nu pe ocolite. Preferi să auzi ceva greu decât să simți o tensiune pe care n-o poți aborda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи прямо или промолчи, но не намёками. Тебе легче услышать что-то тяжёлое, чем чувствовать напряжение, с которым ничего не сделать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bivuge cyangwa ubireke — ariko ntubivuge uca ku ruhande. Wahitamo kumva ikintu gikomeye kuruta kumva umwuka mubi udashobora gukemura."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කියනවා නම් කෙළින්ම කියන්න — වටේ යවලා කියන්න එපා. කතා කරන්න බැරි ආතතියක් විඳිනවාට වඩා අමාරු දෙයක් අහන්න ඔබ කැමතියි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povedz to, alebo nepovedz – ale nie oklikou. Radšej počuť niečo ťažké, než cítiť napätie, s ktorým sa nedá nič robiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povej ali ne povej – a ne po ovinkih. Raje slišiš nekaj težkega, kot da čutiš napetost, ki je ne moreš nasloviti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvitaure kana kuti usazvitaure — asi usazvitaura nekupoterera. Unoda kunzwa chinhu chakaoma pane kunzwa kunetsana kwausingagoni kugadzirisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheeg ama ha sheegin — laakiin ha u sheegin si dadban. Waxaad door bidaysaa inaad maqasho wax adag intaad dareemi lahayd xiisad aadan wax ka qaban karin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ose thuaje, ose mos e thuaj – por jo tërthorazi. Preferon të dëgjosh diçka të vështirë sesa të ndiesh një tension që s’mund ta trajtosh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реци или немој — али немој заобилазно. Радије ћеш чути нешто тешко него осећати напетост коју не можеш да решиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carioskeun atanapi ulah — tapi ulah nyarios bari nyindiran. Anjeun langkung resep ngadangu hal anu beurat tibatan ngaraos tegang anu teu tiasa dibahas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg det eller låt bli – men inte genom pikar och antydningar. Du hör hellre något jobbigt än känner en spänning du inte kan ta tag i."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sema au usiseme — lakini usiseme kwa kuzunguka. Ungependa kusikia jambo gumu kuliko kuhisi mvutano usioweza kuushughulikia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சொல்வதானால் நேராகச் சொல்லுங்கள் — சுற்றி வளைத்து அல்ல. பேசித் தீர்க்க முடியாத இறுக்கத்தை உணர்வதை விட, கடினமான ஒன்றைக் கேட்பதையே விரும்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చెప్పండి లేదా చెప్పకండి — కానీ వంకరగా చెప్పకండి. పరిష్కరించలేని ఉద్రిక్తత కంటే కఠినమైన మాట వినడమే మీకు నయం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ё бигӯ, ё нагӯ — вале бо кинояву пичинг не. Ту беҳтар гапи сахтро мешунавӣ, аз он ки ташаннуҷеро ҳис кунӣ, ки ҳалаш карда наметавонӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะพูดก็พูด ไม่พูดก็ไม่ต้อง แต่อย่าพูดอ้อมๆ คุณยอมฟังเรื่องที่ยากดีกว่ารู้สึกถึงความตึงเครียดที่แก้ไม่ได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተዛረቡ ወይ ኣይትዛረቡ — ብተዘዋዋሪ ግን ኣይኮነን። ክትፈትሕዎ ዘይትኽእሉ ወጥሪ ካብ ምስማዕ፣ ከቢድ ነገር ምስማዕ ትመርጹ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýa aýt, ýa aýtma — ýöne gytaklaýyn aýtma. Sen çözüp bilmeýän dartgynlylygy duýmakdan, agyr bir zady eşitmegi makul bilýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya söyle ya söyleme ama lafı dolandırma. Konuşamadığın bir gerginliği hissetmektense zor bir şey duymayı tercih edersin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи прямо або не кажи взагалі — тільки не натяками. Тобі краще почути щось важке, ніж відчувати напругу, з якою нічого не вдієш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کہنا ہے تو کہیں، ورنہ نہیں — مگر گھما پھرا کر نہیں۔ ایسے تناؤ سے، جس پر بات نہ ہو سکے، کوئی کڑوی بات سن لینا آپ کو زیادہ بہتر لگتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayting yoki aytmang — faqat qiyshiq gapirmang. Hal qilib boʻlmaydigan taranglikni his qilgandan koʻra, ogʻir gapni eshitishni afzal koʻrasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói hoặc đừng nói — nhưng đừng nói vòng vo. Bạn thà nghe điều khó nghe còn hơn cảm thấy căng thẳng mà không biết giải quyết thế nào."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yithethe okanye ungayithethi — kodwa musa ukuyithetha ngecala. Ukhetha ukuva into enzima kunokuziva uxinzelelo ongakwaziyo ukujongana nalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kí a sọ ọ́ tàbí kí a má sọ ọ́ — ṣùgbọ́n kí a má fi ọ̀rọ̀ gúnni lẹ́gbẹ̀ẹ́. Ẹ fẹ́ràn láti gbọ́ ohun tó le ju kí ẹ máa ní ìdààmú tí ẹ kò lè kojú."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要說就直說，別拐彎抹角。你寧願聽到難聽的真話，也不想感受那種無從處理的緊張。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要说就直说，别拐弯抹角。比起无从化解的紧张气氛，你宁愿听到难听的真话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要說就直說，別拐彎抹角。你寧願聽到難聽的真話，也不想感受那種說不出口的緊繃。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusho noma ungakusho — kodwa ungakusho ngokuzungeza. Ungathanda ukuzwa into enzima kunokuzwa ukungezwani ongakwazi ukukuxazulula."
          }
        }
      }
    },
    "Saying it out loud — 'I love you', compliments" : {
      "extractionState" : "manual",
      "localizations" : {
