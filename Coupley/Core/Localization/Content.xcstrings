        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagi anda, ganjaran setelah sepanjang hayat bekerja ialah melihat dunia. Anda mungkin sedang menyimpan untuk satu bentuk kebebasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belønningen for et langt arbeidsliv er å se verden. Du sparer nok mot din versjon av frihet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beloning voor een werkzaam leven is de wereld zien. Je spaart vast voor jouw versie van vrijheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrodą za życie pełne pracy jest poznawanie świata. Pewnie odkładasz na swoją wersję wolności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recompensa por uma vida de trabalho é conhecer o mundo. Você provavelmente está juntando dinheiro para ter a sua versão de liberdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răsplata pentru o viață de muncă e să vezi lumea. Probabil pui deoparte pentru o anumită formă de libertate."
