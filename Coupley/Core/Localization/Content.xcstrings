        }
      }
    },
    "The thing we make together that's bigger than either of us." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشيء الذي نصنعه معًا، وهو أكبر من كلٍّ منا وحده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco, co spolu vytvoříme a co bude větší než každý z nás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, vi skaber sammen, som er større end os hver især."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das wir zusammen erschaffen und das größer ist als jeder von uns allein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό που φτιάχνουμε μαζί και είναι μεγαλύτερο από τον καθένα μας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso que creamos juntos y que es más grande que cada uno de nosotros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, minkä luomme yhdessä ja mikä on suurempi kuin kumpikaan meistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bagay na sabay nating binubuo na mas malaki kaysa sa sinuman sa atin."
