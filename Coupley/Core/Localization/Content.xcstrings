        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વ્યવહારુ. તમારી ખરી જિંદગી કામની બહાર જીવાય છે. નોકરી તો મોટા સપનાને સાથ આપવાનું સાધન છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna duban abu a zahiri. Ainihin rayuwarku na wajen aiki ne. Aiki hanya ce ta cimma burinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישה פרגמטית. החיים האמיתיים שלך קורים מחוץ לעבודה. העבודה משרתת את החזון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यावहारिक सोच। आपकी असली ज़िंदगी काम के बाहर है। नौकरी तो बस उस सपने तक पहुँचने का ज़रिया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatičnost. Pravi život ti se događa izvan posla. Posao služi viziji."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratik. Vrè lavi ou pase andeyò travay la. Djòb la sèvi vizyon an."
