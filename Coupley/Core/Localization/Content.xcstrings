    "Accommodating and willing. Just make sure you genuinely mean it — pets are a long commitment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقبّل واستعداد. فقط تأكدوا أنكم تعنون ذلك فعلًا، فالحيوان الأليف التزام طويل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstřícný a ochotný postoj. Jen se ujisti, že to myslíš vážně – mazlíček je závazek na dlouho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imødekommende og villig. Sørg bare for, at du virkelig mener det – kæledyr er en lang forpligtelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entgegenkommend und bereit. Stell nur sicher, dass du es wirklich so meinst – Haustiere sind eine lange Verpflichtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάθεση για συμβιβασμό. Απλώς βεβαιώσου ότι το εννοείς πραγματικά — ένα κατοικίδιο είναι μακροχρόνια δέσμευση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad y buena disposición. Solo asegúrate de que lo dices en serio — una mascota es un compromiso largo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautuvaa ja halukasta. Varmista vain, että tarkoitat sitä oikeasti – lemmikki on pitkä sitoumus."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maunawain at handa. Siguraduhin lang na totoo ito sa’yo — matagal na commitment ang alagang hayop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la souplesse et de la bonne volonté. Assure-toi juste de le penser vraiment : un animal, c'est un engagement sur le long terme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות ונכונות. רק חשוב שזה יבוא מהלב — חיות מחמד הן מחויבות ארוכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढलने और अपनाने को तैयार। बस पक्का कर लें कि यह बात दिल से है — पालतू एक लंबी ज़िम्मेदारी हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmazkodó és nyitott vagy. Csak legyél biztos benne, hogy komolyan gondolod – egy háziállat hosszú elköteleződés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akomodatif dan bersedia. Pastikan saja kamu sungguh-sungguh — hewan peliharaan itu komitmen jangka panjang."
