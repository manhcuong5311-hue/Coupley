        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hantar satu ayat: “tak perlu balas — teringat anda.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibgħat linja waħda: “m'hemmx bżonn twieġeb — qed naħseb fik.”"
