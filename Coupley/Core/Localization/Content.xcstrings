        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በእውነት ተለዋዋጭ። በዕረፍት ጊዜ ግጭት የሚፈጥሩት እርስዎ አይሆኑም — የሚያለዝቡት እርስዎ ነዎት።"
