        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዝቅተኛ ጉልበት ውስጥ ያለ እርካታ መነቃቃትን ሳይሆን አብሮነትን ብቻ ይፈልጋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
