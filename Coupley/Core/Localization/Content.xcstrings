        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אוכל הוא אחת הדרכים הכי פשוטות להראות אכפתיות — חשוב לדעת מה הצד השני הכי אוהב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना परवाह जताने के सबसे आसान तरीक़ों में से एक है — यह जानना ज़रूरी है कि आपके पार्टनर को क्या पसंद है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az étel az egyik legkönnyebb módja a törődés kimutatásának – fontos tudni, mit szeret a párod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan adalah salah satu cara termudah menunjukkan perhatian — tahu apa yang disukai pasanganmu itu penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cibo è uno dei modi più semplici per dimostrare cura — sapere cosa ama il tuo partner conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食べものは思いやりを伝えるいちばん簡単な方法のひとつ。パートナーの好物を知っておくことが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식은 마음을 전하는 가장 쉬운 방법 중 하나예요. 연인이 좋아하는 걸 아는 게 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makanan ialah salah satu cara paling mudah untuk menunjukkan rasa sayang — mengetahui kegemaran pasangan anda sangat penting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat er en av de enkleste måtene å vise omsorg på – det er verdifullt å vite hva partneren din elsker."
