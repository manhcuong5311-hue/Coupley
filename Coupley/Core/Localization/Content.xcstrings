            "value" : "Ngobrol sareng pasangan — ngabahas dinten"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratar med min partner om dagen"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuzungumza na mwenzi wangu — kuitafakari siku"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என் துணையுடன் பேசுவது — அன்றைய நாளைப் பற்றி"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "భాగస్వామితో మాట్లాడటం — ఆ రోజు ఎలా గడిచిందో"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо ёрам гап задан — ҷамъбасти рӯз"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุยกับคนรัก ทบทวนวันที่ผ่านมา"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስ መጻምደይ ምዝርራብ — ብዛዕባ እታ መዓልቲ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söýgülim bilen gürleşmek — günüň jemi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partnerimle konuşmak, günün özeti"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмова з половинкою — підсумки дня"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساتھی سے بات — دن بھر کا احوال"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sherigim bilan gaplashish — kunni sarhisob qilish"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trò chuyện với người ấy — kể lại một ngày"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndincokola neqabane lam — sijonga usuku"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíbá olólùfẹ́ mi sọ̀rọ̀ — àtúnwò ọjọ́ náà"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和另一半聊聊，回顧一天"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和另一半聊聊今天"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和另一半聊聊今天"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukhuluma nomlingani wami — sibuyekeza usuku"
          }
        }
      }
    },
    "Tangible support. You show love through action when someone's struggling — not just words." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasbare ondersteuning. Jy wys liefde deur dade wanneer iemand swaarkry – nie net met woorde nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተጨባጭ ድጋፍ። አንድ ሰው ሲቸገር ፍቅርን በቃል ብቻ ሳይሆን በተግባር ያሳያሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعم ملموس. تعبّرون عن الحب بالأفعال حين يمرّ أحدهم بوقت صعب، لا بالكلمات وحدها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হাতে-কামে সমৰ্থন। কোনোবাই কষ্টত থাকিলে আপুনি কেৱল কথাৰে নহয়, কামেৰে মৰম দেখুৱায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiss olunan dəstək. Kimsə çətinlik çəkəndə sevgini təkcə sözlə yox, əməllə göstərirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адчувальная падтрымка. Калі камусьці цяжка, ты паказваеш любоў справамі, а не толькі словамі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осезаема подкрепа. Показваш любов с действия, когато някой е в трудност – не само с думи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চোখে দেখা যায় এমন সাপোর্ট। কেউ কষ্টে থাকলে তুমি ভালোবাসা দেখাও কাজে — শুধু কথায় নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opipljiva podrška. Ljubav pokazuješ djelima kad je nekome teško – ne samo riječima."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suport tangible. Demostres l'amor amb fets quan algú ho passa malament — no només amb paraules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmatatelná podpora. Když má někdo těžké chvíle, projevuješ lásku činy – nejen slovy."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cefnogaeth go iawn. Rwyt ti'n dangos cariad drwy weithredu pan fydd rhywun yn cael trafferth — nid geiriau'n unig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndgribelig støtte. Når nogen har det svært, viser du kærlighed med handling – ikke kun med ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greifbare Unterstützung. Wenn es jemandem schlecht geht, zeigst du Liebe durch Taten – nicht nur mit Worten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στήριξη που πιάνεται. Όταν κάποιος περνάει δύσκολα, δείχνεις την αγάπη σου με πράξεις — όχι μόνο με λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoyo tangible. Cuando alguien lo pasa mal, demuestras tu amor con hechos, no solo con palabras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käegakatsutav tugi. Näitad armastust tegudega, kui kellelgi on raske — mitte ainult sõnadega."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laguntza nabaria. Norbait gaizki dagoenean, ekintzen bidez erakusten duzu maitasuna, ez hitzekin soilik."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حمایت ملموس. وقتی کسی در سختی است، عشقت را با عمل نشان می‌دهی — نه فقط با حرف."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkreettista tukea. Kun joku on ahdingossa, näytät rakkautesi teoilla etkä pelkillä sanoilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportang nahahawakan. Ipinapakita mo ang pagmamahal sa gawa kapag may nahihirapan — hindi lang sa salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un soutien tangible. Quand quelqu'un traverse une passe difficile, tu montres ton amour par des actes, pas seulement par des mots."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tacaíocht inláimhsithe. Léiríonn tú grá trí ghníomh nuair a bhíonn duine i sáinn — ní le focail amháin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoio tanxible. Cando alguén o pasa mal, demostras amor con feitos, non só con palabras."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નક્કર સાથ. કોઈ મુશ્કેલીમાં હોય ત્યારે તમે ફક્ત શબ્દોથી નહીં, કામથી પ્રેમ બતાવો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallafi na zahiri. Kuna nuna soyayya ta aiki idan wani na cikin wahala — ba da baki kawai ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמיכה מוחשית. כשלמישהו קשה, האהבה שלך מתבטאת במעשים — לא רק במילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठोस मदद। जब कोई परेशान हो, तो आपका प्यार सिर्फ़ बातों में नहीं, काम में दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opipljiva podrška. Ljubav pokazuješ djelima kad je nekome teško – ne samo riječima."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sipò konkrè. Ou montre lanmou ak aksyon lè yon moun nan difikilte — pa sèlman ak pawòl."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kézzelfogható támogatás. Ha valaki nehéz helyzetben van, tettekkel mutatod ki a szereteted – nem csak szavakkal."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շոշափելի աջակցություն։ Երբ մեկը դժվարանում է, սերդ ցույց ես տալիս գործով, ոչ միայն խոսքերով։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan yang nyata. Kamu menunjukkan cinta lewat tindakan saat seseorang sedang kesulitan — bukan cuma kata-kata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nkwado a na-ahụ anya. Ị na-eji omume egosi ịhụnanya mgbe mmadụ nọ ná nsogbu — ọ bụghị naanị okwu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áþreifanlegur stuðningur. Þú sýnir ást með verkum þegar einhver á erfitt – ekki bara orðum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sostegno concreto. Quando qualcuno è in difficoltà, dimostri amore con i fatti, non solo con le parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形のあるサポート。相手が苦しいとき、言葉だけでなく行動で愛情を示します。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitulungan nyata. Panjenengan nuduhake tresna liwat tumindak nalika ana wong sing lagi rekasa — ora mung liwat tembung."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხელშესახები მხარდაჭერა. როცა ვინმეს უჭირს, სიყვარულს საქმით გამოხატავ — და არა მხოლოდ სიტყვებით."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нақты қолдау. Біреу қиналғанда сен махаббатыңды сөзбен ғана емес, іспен көрсетесің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការគាំទ្រជាក់ស្ដែង។ អ្នកបង្ហាញក្ដីស្រឡាញ់តាមរយៈសកម្មភាព ពេលនរណាម្នាក់កំពុងជួបការលំបាក — មិនមែនត្រឹមតែពាក្យសម្ដីទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಣ್ಣಿಗೆ ಕಾಣುವ ಬೆಂಬಲ. ಯಾರಾದರೂ ಕಷ್ಟದಲ್ಲಿದ್ದಾಗ ನೀವು ಮಾತಿನಿಂದ ಮಾತ್ರವಲ್ಲ, ಕೆಲಸದಿಂದ ಪ್ರೀತಿ ತೋರಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손에 잡히는 도움을 줘요. 누군가 힘들어할 때 말뿐 아니라 행동으로 사랑을 보여 주죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piştgiriya berçav. Dema kesek zehmetiyê dikişîne, tu evîna xwe bi kirinê nîşan didî — ne tenê bi gotinan."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иш жүзүндөгү колдоо. Бирөө кыйналганда сүйүүңдү сөз менен эле эмес, иш менен көрсөтөсүң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret Ënnerstëtzung. Wann et engem schlecht geet, weis du Léift duerch Doen — net just mat Wierder."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຊ່ວຍທີ່ຈັບຕ້ອງໄດ້ ເຈົ້າສະແດງຄວາມຮັກດ້ວຍການກະທຳເວລາໃຜຜູ້ໜຶ່ງລຳບາກ — ບໍ່ແມ່ນແຄ່ຄຳເວົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apčiuopiama pagalba. Kai kam nors sunku, meilę rodai darbais – ne tik žodžiais."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustāms atbalsts. Kad kādam ir grūti, tu mīlestību parādi darbos – ne tikai vārdos."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanohanana azo tsapain-tanana. Amin'ny asa no anehoanao fitiavana rehefa sahirana ny olona — fa tsy amin'ny teny fotsiny."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tautoko kitea. Ka whakaatu koe i te aroha mā te mahi ina raru tētahi — kaua mā te kupu anake."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиплива поддршка. Покажуваш љубов преку дела кога некому му е тешко — не само со зборови."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കൺമുന്നിൽ കാണാവുന്ന പിന്തുണ. ഒരാൾ പ്രയാസപ്പെടുമ്പോൾ വാക്കുകളിലൂടെ മാത്രമല്ല, പ്രവൃത്തിയിലൂടെയാണ് നിങ്ങൾ സ്നേഹം കാണിക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бодит дэмжлэг. Хэн нэгэн хэцүүдэж байхад чи зөвхөн үгээр биш, үйлдлээр хайраа харуулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्यक्ष आधार. कुणी अडचणीत असले की तुम्ही फक्त शब्दांतून नाही, तर कृतीतून प्रेम दाखवता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokongan yang nyata. Anda tunjukkan kasih sayang melalui tindakan bila seseorang sedang susah — bukan sekadar kata-kata."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoġġ konkret. Turi l-imħabba bl-azzjoni meta xi ħadd ikun għaddej minn żmien diffiċli — mhux biss bil-kliem."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်တွေ့ကျတဲ့ အားပေးမှု။ တစ်ယောက်ယောက် ရုန်းကန်နေချိန် စကားနဲ့တင် မဟုတ်ဘဲ လုပ်ရပ်နဲ့ အချစ်ကို ပြတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndfast støtte. Du viser kjærlighet gjennom handling når noen har det tungt – ikke bare med ord."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठोस सहयोग। कोही संघर्षमा हुँदा तपाईं शब्दले मात्र होइन, कामले माया देखाउनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastbare steun. Als iemand het zwaar heeft, laat je je liefde zien in daden – niet alleen in woorden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thandizo looneka. Mumaonetsa chikondi pochitapo kanthu munthu akavutika — osati ndi mawu okha."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deeggarsa qabatamaa. Yeroo namni rakkatu jaalala gochaan agarsiifta — jechaan qofa miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ହାତେହାତେ ସାହାଯ୍ୟ। କେହି କଷ୍ଟରେ ଥିଲେ ଆପଣ କେବଳ କଥାରେ ନୁହେଁ, କାମରେ ଭଲପାଇବା ଦେଖାନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਠੋਸ ਸਾਥ। ਜਦੋਂ ਕੋਈ ਮੁਸ਼ਕਲ ਵਿੱਚ ਹੋਵੇ, ਤੁਸੀਂ ਸਿਰਫ਼ ਲਫ਼ਜ਼ਾਂ ਨਾਲ ਨਹੀਂ, ਕੰਮ ਨਾਲ ਪਿਆਰ ਦਿਖਾਉਂਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretne wsparcie. Gdy ktoś ma trudny czas, okazujesz miłość czynami – nie tylko słowami."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملي ملاتړ. کله چې څوک په سختۍ کې وي، تاسو مینه په عمل ښیئ — نه یوازې په خبرو."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoio concreto. Quando alguém está mal, você demonstra amor com atitudes — não só com palavras."
