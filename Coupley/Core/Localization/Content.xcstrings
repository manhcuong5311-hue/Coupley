        }
      }
    },
    "Movement and fresh air clear your head. Being side by side, not face to face, makes it easier to open up." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركة والهواء الطلق يصفّيان أذهانكم. السير جنبًا إلى جنب، لا وجهًا لوجه، يجعل البوح أسهل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb a čerstvý vzduch ti vyčistí hlavu. Když jdete bok po boku, ne tváří v tvář, snáz se otevřeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse og frisk luft klarer dit hoved. Når I går side om side i stedet for ansigt til ansigt, er det lettere at åbne op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung und frische Luft machen deinen Kopf frei. Nebeneinander statt gegenüber fällt es dir leichter, dich zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση και ο καθαρός αέρας σού καθαρίζουν το μυαλό. Δίπλα δίπλα κι όχι πρόσωπο με πρόσωπο, ανοίγεσαι πιο εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moverte y tomar aire te despeja la mente. Caminar lado a lado, no cara a cara, hace que sea más fácil abrirse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liike ja raitis ilma selkeyttävät ajatuksia. Kun kuljette rinnakkain eikä kasvokkain, on helpompi avautua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nililinaw ng paggalaw at sariwang hangin ang isip mo. Mas madali kang magbukas kapag magkatabi kayo, hindi magkaharap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouger et prendre l'air t'aident à y voir clair. Marcher côte à côte plutôt que face à face rend la confidence plus facile."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה ואוויר צח מנקים לך את הראש. כשהולכים זה לצד זה ולא פנים מול פנים, קל יותר להיפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलना-फिरना और ताज़ी हवा आपका मन साफ़ कर देते हैं। आमने-सामने नहीं, कंधे से कंधा मिलाकर चलते हुए दिल की बात कहना आसान हो जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozgás és a friss levegő kitisztítja a fejed. Egymás mellett, nem szemtől szemben könnyebb megnyílni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak dan udara segar menjernihkan pikiranmu. Berjalan berdampingan, bukan berhadapan, membuatmu lebih mudah terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoverti e prendere aria ti schiarisce le idee. Stare fianco a fianco, invece che faccia a faccia, rende più facile aprirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を動かし外の空気を吸うと、頭がすっきりします。向かい合うより並んで歩くほうが、素直に話しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸을 움직이고 바람을 쐬면 머리가 맑아져요. 마주 보기보다 나란히 걸을 때 마음을 열기가 더 쉬워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak dan udara segar menjernihkan fikiran anda. Berjalan bersebelahan, bukan bertentang muka, memudahkan anda untuk meluahkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse og frisk luft klarner hodet. Når dere går side om side i stedet for ansikt til ansikt, er det lettere å åpne seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging en frisse lucht maken je hoofd leeg. Naast elkaar lopen in plaats van tegenover elkaar zitten maakt het makkelijker om je open te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch i świeże powietrze oczyszczają ci głowę. Łatwiej się otworzyć, idąc ramię w ramię, a nie twarzą w twarz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento e ar fresco clareiam sua mente. Lado a lado, e não frente a frente, fica mais fácil se abrir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcarea și aerul curat îți limpezesc mintea. Umăr lângă umăr, nu față în față, îți vine mai ușor să te deschizi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение и свежий воздух проясняют голову. Когда вы идёте бок о бок, а не сидите лицом к лицу, открыться проще."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse och frisk luft rensar huvudet. Att gå sida vid sida, inte ansikte mot ansikte, gör det lättare att öppna sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขยับตัวและอากาศบริสุทธิ์ช่วยให้หัวโล่ง การเดินเคียงข้างกันแทนการนั่งหันหน้าเข้าหากันทำให้เปิดใจได้ง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket ve temiz hava kafanı açıyor. Karşı karşıya değil yan yana olmak, içini açmayı kolaylaştırıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух і свіже повітря прочищають голову. Коли ви йдете пліч-о-пліч, а не сидите віч-на-віч, легше відкритися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động và không khí trong lành giúp đầu óc bạn thông thoáng. Đi cạnh nhau thay vì đối diện khiến việc mở lòng dễ dàng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走走路、吹吹风，脑子就清醒了。肩并肩而不是面对面，更容易敞开心扉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走走路、吹吹風，讓你腦袋清醒。肩並肩而不是面對面，反而更容易敞開心。"
          }
        }
      }
    },
    "Movement as medicine. Your mood, energy, and stress are closely tied to whether you've moved your body. A partner should know this." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركة دواء. مزاجك وطاقتك وتوترك مرتبطة جدًا بتحريك جسدك، ومن المفيد أن يعرف الشريك ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb jako lék. Tvoje nálada, energie i stres úzce souvisí s tím, jestli se hýbeš. Protějšek by to měl vědět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse som medicin. Dit humør, din energi og dit stressniveau hænger tæt sammen med, om du har rørt dig. Det bør en partner vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung als Medizin. Deine Stimmung, Energie und dein Stresslevel hängen eng davon ab, ob du dich bewegt hast. Das sollte dein Schatz wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση ως φάρμακο. Η διάθεση, η ενέργεια και το άγχος σου εξαρτώνται πολύ από το αν έχεις κινηθεί. Καλό είναι να το ξέρει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento como medicina. Tu ánimo, tu energía y tu estrés dependen mucho de si te has movido. Tu pareja debería saberlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liike on lääkettä. Mielialasi, energiasi ja stressisi riippuvat paljon siitä, oletko liikkunut. Kumppanin kannattaa tietää tämä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galaw bilang gamot. Malaki ang epekto sa mood, lakas, at stress mo kung nakagalaw ka ba o hindi. Dapat itong malaman ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement comme remède. Ton humeur, ton énergie et ton stress dépendent beaucoup du fait d'avoir bougé ou non. L'autre devrait le savoir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה כתרופה. מצב הרוח, האנרגיה והלחץ שלך קשורים מאוד לשאלה אם הזזת את הגוף. כדאי שהצד השני ידע את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिलना-डुलना ही दवा है। आपका मूड, ऊर्जा और तनाव इस बात से गहराई से जुड़े हैं कि शरीर को कितना चलाया। पार्टनर को यह पता होना चाहिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozgás a gyógyszered. A hangulatod, az energiád és a stressz-szinted szorosan összefügg azzal, hogy mozogtál-e. Ezt a párodnak tudnia kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak adalah obat. Mood, energi, dan stresmu sangat bergantung pada apakah kamu sudah menggerakkan badan. Pasanganmu perlu tahu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il movimento come medicina. Umore, energia e stress dipendono molto da quanto movimento hai fatto. Il tuo partner dovrebbe saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を動かすことが薬になる人です。気分も元気もストレスも、体を動かしたかどうかに大きく左右されます。パートナーに知っておいてもらいましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸을 움직이는 게 약이에요. 기분과 에너지, 스트레스가 몸을 움직였느냐에 크게 좌우돼요. 연인이 알아 두면 좋아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergerakan sebagai ubat. Perasaan, tenaga dan tekanan anda berkait rapat dengan sama ada anda sudah menggerakkan badan. Pasangan anda patut tahu hal ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse som medisin. Humøret, energien og stresset ditt henger tett sammen med om du har rørt på deg. Det bør en partner vite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen als medicijn. Je stemming, energie en stress hangen sterk af van of je in beweging bent geweest. Goed als je partner dat weet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch jako lekarstwo. Twój nastrój, energia i stres mocno zależą od tego, czy się poruszasz. Druga połówka powinna o tym wiedzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento como remédio. Seu humor, sua energia e seu estresse dependem muito de ter mexido o corpo. Seu amor deveria saber disso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcarea ca medicament. Starea, energia și stresul tău depind mult de cât te-ai mișcat. Un partener ar trebui să știe asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение как лекарство. Твоё настроение, энергия и уровень стресса сильно зависят от того, было ли сегодня движение. Партнёру стоит это знать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse som medicin. Ditt humör, din energi och din stress hänger tätt ihop med om du har rört på dig. Det bör en partner veta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขยับร่างกายคือยา อารมณ์ พลังงาน และความเครียดของคุณขึ้นอยู่กับว่าวันนั้นได้ขยับร่างกายหรือเปล่า คนรักควรรู้เรื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket senin ilacın. Ruh halin, enerjin ve stresin, bedenini hareket ettirip ettirmediğinle yakından ilgili. Partnerin bunu bilmeli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух як ліки. Твій настрій, енергія й стрес тісно залежать від того, чи був сьогодні рух. Половинці варто це знати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động là liều thuốc. Tâm trạng, năng lượng và căng thẳng của bạn gắn chặt với việc hôm đó có vận động hay không. Người ấy nên biết điều này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动就是良药。你的心情、精力和压力，和有没有动起来紧密相关。另一半应该知道这一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動就是你的良藥。你的心情、精力和壓力，和有沒有動一動身體息息相關。另一半應該要知道這點。"
          }
        }
      }
    },
    "Movement without intensity. You value feeling good over performance. Great for someone who can match that pace." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة بلا إجهاد. تقدّرون الشعور الجيد أكثر من الأداء. مثالي مع شريك يجاريكم في هذا الإيقاع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb bez intenzity. Důležitější je pro tebe dobrý pocit než výkon. Ideální s někým, kdo udrží stejné tempo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse uden intensitet. Du sætter det at have det godt over præstationen. Perfekt med en, der kan følge det tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung ohne Leistungsdruck. Sich gut zu fühlen zählt für dich mehr als jede Bestleistung. Perfekt mit jemandem, der dieses Tempo mitgeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κίνηση χωρίς ένταση. Σε ενδιαφέρει να νιώθεις καλά, όχι οι επιδόσεις. Ιδανικό με κάποιον που μπορεί να ακολουθήσει αυτόν τον ρυθμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimiento sin intensidad. Valoras sentirte bien más que el rendimiento. Ideal con alguien que pueda seguir ese ritmo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikettä ilman tehoja. Hyvä olo on sinulle tärkeämpi kuin suoritus. Sopii hyvin yhteen jonkun kanssa, joka liikkuu samaan tahtiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paggalaw nang walang tindi. Mas mahalaga sa’yo ang gumaan ang pakiramdam kaysa sa performance. Bagay sa taong kayang sumabay sa bilis na iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouger sans intensité. Tu privilégies le bien-être plutôt que la performance. Idéal avec quelqu'un qui peut suivre ce rythme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה בלי עצימות. להרגיש טוב חשוב לך יותר מביצועים. מושלם עם מי שמתאים את עצמו לקצב הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना ज़ोर-ज़बरदस्ती के चलना-फिरना। आपके लिए प्रदर्शन से ज़्यादा अच्छा महसूस करना अहम है। उसी रफ़्तार से चल सकने वाले साथी के लिए बढ़िया।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgás intenzitás nélkül. Neked a jó közérzet fontosabb a teljesítménynél. Ideális, ha a párod is hasonló tempóban mozog."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak tanpa intensitas tinggi. Kamu lebih mementingkan rasa nyaman daripada performa. Cocok dengan seseorang yang bisa mengikuti ritme itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento senza intensità. Per te conta sentirti bene, non la prestazione. Perfetto con chi sa tenere lo stesso ritmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "激しさより、気持ちよく体を動かしたいタイプです。結果より心地よさを大切にしています。同じペースで楽しめる人とぴったりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강도보다 꾸준한 움직임이에요. 기록보다 기분 좋은 게 중요하죠. 이 속도에 맞춰 줄 수 있는 사람과 잘 맞아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak tanpa intensiti. Anda mengutamakan rasa sihat berbanding prestasi. Sesuai dengan seseorang yang boleh mengikut rentak itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse uten intensitet. Det viktigste for deg er å føle deg bra, ikke å prestere. Perfekt med noen som kan holde samme tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen zonder intensiteit. Je voelt je liever goed dan dat je presteert. Fijn met iemand die hetzelfde tempo heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch bez intensywności. Liczy się dla ciebie dobre samopoczucie, a nie wyniki. Idealne z kimś, kto lubi podobne tempo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento sem intensidade. Você valoriza se sentir bem mais do que o desempenho. Perfeito com alguém que acompanhe esse ritmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcare fără intensitate. Pentru tine contează să te simți bine, nu performanța. Ideal alături de cineva care poate ține același ritm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение без надрыва. Тебе важнее хорошее самочувствие, чем результат. Отлично, если партнёру подходит такой же темп."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse utan intensitet. Att må bra är viktigare för dig än att prestera. Perfekt med någon som håller samma tempo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขยับตัวแบบไม่หักโหม คุณให้ความสำคัญกับความรู้สึกดีมากกว่าผลลัพธ์ เหมาะกับคนที่ไปจังหวะเดียวกันได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoğunluk olmadan hareket. Performanstan çok iyi hissetmeye değer veriyorsun. Bu tempoya ayak uydurabilen biri için harika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух без інтенсивності. Для тебе важливіше добре почуватися, ніж ставити рекорди. Чудово, якщо поруч хтось у такому ж темпі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động không cần cường độ. Bạn coi trọng cảm giác dễ chịu hơn thành tích. Rất hợp với người theo kịp nhịp đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动但不追求强度。比起成绩，你更看重身体舒服。和节奏相近的人在一起会很合拍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動一動，但不求強度。你重視舒服的感覺勝過表現，很適合能配合這個步調的人。"
          }
        }
      }
    },
