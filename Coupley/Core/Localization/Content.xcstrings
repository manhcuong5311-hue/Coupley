        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ہر چیز پر اثر ڈال رہا ہے: آپ کا موڈ، صبر، اور جڑنے کی صلاحیت۔ اسے ترجیح دینا بہتر ہو گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hamma narsaga taʼsir qilyapti — kayfiyatingizga, sabr-toqatingizga, yaqinlik uchun kuchingizga. Buni ustuvor masala sifatida koʻrishga arziydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này đang ảnh hưởng đến mọi thứ — tâm trạng, sự kiên nhẫn, khả năng kết nối của bạn. Nên coi đó là ưu tiên."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oku kuchaphazela yonke into — imo yakho, umonde wakho, amandla akho okunxibelelana. Kufanelekile ukukuthatha njengento ephambili."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Èyí ń nípa lórí ohun gbogbo — ìṣesí yín, sùúrù yín, agbára yín láti sún mọ́ ẹlòmíì. Ó yẹ kí ẹ fi í ṣe ohun àkọ́kọ́."
