        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjarvinna er orðin hluti af lífinu. Almennilegt vinnurými skiptir máli fyrir afköstin og geðheilsuna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavorare da casa ormai è la normalità. Avere uno spazio adatto conta per la tua produttività e la tua serenità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在宅勤務は今や日常です。ちゃんとした仕事場があることは、生産性にも心の安定にも大切です。"
