        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhar baixa o cortisol, e lado a lado é melhor que frente a frente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mersul scade cortizolul, iar umăr la umăr e mai ușor decât față în față."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогулка снижает кортизол, а говорить бок о бок легче, чем лицом к лицу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promenader sänker kortisolet, och sida vid sida slår ansikte mot ansikte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเดินช่วยลดฮอร์โมนความเครียด และการเดินเคียงข้างกันดีกว่านั่งจ้องหน้ากัน"
