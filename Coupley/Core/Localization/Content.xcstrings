    "Environment as lifestyle. You want to wake up to green, not concrete. That usually means committing to a location." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgewing as leefstyl. Jy wil wakker word met groen, nie beton nie. Dit beteken gewoonlik dat jy jou aan ’n plek verbind."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አካባቢ እንደ አኗኗር። ከኮንክሪት ይልቅ አረንጓዴ እያዩ መንቃት ይፈልጋሉ። ይህ አብዛኛውን ጊዜ አንድ ቦታ መምረጥን ይጠይቃል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيئة أسلوب حياة. الاستيقاظ على الخضرة لا على الإسمنت، وهذا يعني غالبًا الالتزام بمكان معين."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিৱেশেই জীৱনশৈলী। আপুনি কংক্ৰিট নহয়, সেউজীয়া দেখি সাৰ পাব বিচাৰে। তাৰ মানে সাধাৰণতে এটা ঠাইত থিতাপি লোৱা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həyat tərzi kimi mühit. Betona yox, yaşıllığa oyanmaq istəyirsən. Bu, adətən müəyyən bir yerə bağlanmaq deməkdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Асяроддзе як лад жыцця. Табе хочацца прачынацца сярод зеляніны, а не бетону. Звычайна гэта значыць — выбраць месца надоўга."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средата като начин на живот. Искаш да се събуждаш сред зеленина, не сред бетон. Това обикновено означава да избереш конкретно място."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রকৃতিই তোমার জীবনধারা। কংক্রিট নয়, সবুজ দেখে ঘুম ভাঙতে চাও। এর মানে সাধারণত নির্দিষ্ট একটা জায়গা বেছে নেওয়া।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okruženje kao stil života. Želiš se buditi uz zelenilo, a ne beton. To obično znači vezati se za određeno mjesto."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entorn com a estil de vida. Vols despertar-te amb verd, no amb formigó. Normalment això vol dir comprometre's amb un lloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostředí jako životní styl. Chceš se probouzet do zeleně, ne do betonu. To obvykle znamená zavázat se k jednomu místu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgylchedd fel ffordd o fyw. Rwyt ti eisiau deffro i wyrddni, nid concrit. Mae hynny fel arfer yn golygu ymrwymo i un lle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgivelser som livsstil. Du vil vågne op til grønt, ikke beton. Det betyder som regel, at du binder dig til et bestemt sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgebung als Lebensstil. Du willst morgens Grün sehen, keinen Beton. Das heißt meist, sich auf einen Ort festzulegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το περιβάλλον ως τρόπος ζωής. Θες να ξυπνάς με πράσινο, όχι με τσιμέντο. Αυτό συνήθως σημαίνει δέσμευση σε έναν τόπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno como estilo de vida. Quieres despertarte con verde a tu alrededor, no cemento. Eso suele implicar comprometerse con un lugar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskkond kui elustiil. Tahad ärgata rohelusse, mitte betooni. See tähendab tavaliselt end kindla kohaga siduda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingurunea bizimodu gisa. Berdea ikusiz esnatu nahi duzu, ez hormigoia. Horrek normalean leku jakin bat aukeratzea dakar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طبیعت به‌عنوان سبک زندگی. می‌خواهی صبح‌ها با سبزه بیدار شوی، نه بتن. این معمولاً یعنی متعهد شدن به یک مکان."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ympäristö elämäntapana. Haluat herätä vehreyteen etkä betoniin. Se tarkoittaa yleensä sitoutumista tiettyyn paikkaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapaligiran bilang pamumuhay. Gusto mong gumising sa luntian, hindi sa semento. Kadalasan, ibig sabihin nito ay pagpili ng isang lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'environnement comme mode de vie. Tu veux te réveiller face à la verdure, pas au béton. Ça implique souvent de s'ancrer quelque part."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpeallacht mar stíl mhaireachtála. Ba mhaith leat dúiseacht le glas, ní le coincréit. De ghnáth ciallaíonn sé sin tiomantas d’áit ar leith."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contorna como estilo de vida. Queres espertar co verde, non co formigón. Iso adoita implicar comprometerte cun lugar."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાતાવરણ જ જીવનશૈલી. તમારે કૉંક્રીટ નહીં, હરિયાળી જોઈને જાગવું છે. એનો અર્થ સામાન્ય રીતે કોઈ એક જગ્યા પસંદ કરી લેવી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhalli a matsayin salon rayuwa. Kuna son ku tashi ku ga ciyayi, ba siminti ba. Wannan galibi na nufin sadaukar da kai ga wani wuri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סביבה כאורח חיים. בא לך להתעורר לירוק, לא לבטון. בדרך כלל זה אומר להתחייב למקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माहौल ही लाइफ़स्टाइल। आपको कंक्रीट नहीं, हरियाली देखकर जागना है। इसका मतलब अक्सर किसी एक जगह को चुनना होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okolina kao stil života. Želiš se buditi uz zelenilo, a ne beton. To obično znači vezati se uz jedno mjesto."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anviwònman an se yon fason pou viv. Ou vle leve wè vèt, pa beton. Anjeneral sa mande pou angaje ou nan yon kote presi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A környezet mint életmód. Zöldre akarsz ébredni, nem betonra. Ez általában azt jelenti, hogy elköteleződsz egy hely mellett."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միջավայրը՝ որպես ապրելակերպ։ Ուզում ես արթնանալ կանաչի, ոչ թե բետոնի մեջ։ Դա սովորաբար նշանակում է կապվել որոշակի վայրի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan sebagai gaya hidup. Kamu ingin bangun disambut hijau, bukan beton. Biasanya itu berarti berkomitmen pada satu lokasi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gburugburu dịka ụzọ ndụ. Ị chọrọ iteta ụra hụ akwụkwọ ndụ, ọ bụghị nkume. Nke ahụ na-apụtakarị ikwenye n'otu ebe."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umhverfið sem lífsstíll. Þú vilt vakna við grænt, ekki steypu. Það þýðir yfirleitt að skuldbinda sig ákveðnum stað."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente come stile di vita. Vuoi svegliarti nel verde, non nel cemento. Di solito significa scegliere un luogo e restarci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境がライフスタイルそのもの。コンクリートではなく緑の中で目覚めたい人です。たいていは住む場所を決めることにもつながります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan minangka gaya urip. Panjenengan pengin tangi lan ndeleng ijo, dudu beton. Biasane iku tegese kudu mantep milih panggonan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გარემო, როგორც ცხოვრების წესი. გინდა, სიმწვანეს გაეღვიძო და არა ბეტონს. ეს, ჩვეულებრივ, ერთი ადგილის არჩევას და იქ დამკვიდრებას ნიშნავს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табиғат — өмір салтың. Таңертең бетонды емес, жасыл желекті көргің келеді. Бұл әдетте белгілі бір жерге біржола байлануды білдіреді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បរិស្ថានជារបៀបរស់នៅ។ អ្នកចង់ភ្ញាក់ពីគេងឃើញពណ៌បៃតង មិនមែនបេតុងទេ។ ជាធម្មតាវាមានន័យថាត្រូវប្ដេជ្ញាចិត្តលើទីតាំងមួយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪರಿಸರವೇ ಜೀವನಶೈಲಿ. ಕಾಂಕ್ರೀಟ್ ಅಲ್ಲ, ಹಸಿರಿನ ನಡುವೆ ಎಚ್ಚರಗೊಳ್ಳಲು ನೀವು ಬಯಸುತ್ತೀರಿ. ಅದಕ್ಕೆ ಸಾಮಾನ್ಯವಾಗಿ ಒಂದು ಸ್ಥಳಕ್ಕೆ ಬದ್ಧರಾಗಬೇಕಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환경이 곧 라이프스타일이에요. 콘크리트가 아니라 초록을 보며 일어나고 싶어 해요. 보통 그러려면 살 곳을 확실히 정해야 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xweza wekî şêwaza jiyanê. Tu dixwazî bi keskahiyê şiyar bibî, ne bi betonê. Ev bi gelemperî tê wateya ku tu xwe bi cihekî ve girê bidî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаратылыш — жашоо образы. Бетондун ордуна жашылдыкка ойгонгуң келет. Бул көбүнчө белгилүү бир жерди тандоону билдирет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ëmfeld als Liewensstil. Du wëlls mueres Gréngs gesinn, kee Beton. Dat heescht meeschtens, dech op eng Plaz festzeleeën."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສິ່ງແວດລ້ອມຄືວິຖີຊີວິດ ເຈົ້າຢາກຕື່ນມາເຫັນສີຂຽວ ບໍ່ແມ່ນຊີມັງ ເຊິ່ງມັກໝາຍເຖິງການຕັດສິນໃຈປັກຫຼັກຢູ່ບ່ອນໃດບ່ອນໜຶ່ງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplinka kaip gyvenimo būdas. Nori pabusti tarp žalumos, o ne tarp betono. Tai paprastai reiškia apsisprendimą dėl konkrečios vietos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide kā dzīvesveids. Tu gribi mosties zaļumos, nevis betonā. Tas parasti nozīmē uzticēties vienai vietai."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny tontolo manodidina ho fomba fiaina. Te hifoha ka hahita maitso ianao, fa tsy simenitra. Matetika midika ho fifidianana toerana iray izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te taiao he āhua noho. Ko tāu kia oho ake ki te kākāriki, kaua ki te raima. Ko te tikanga, me whakapūmau koe ki tētahi wāhi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Околината како начин на живот. Сакаш да се будиш со зеленило, не со бетон. Тоа обично значи да се обврзеш на одредено место."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ജീവിതശൈലിയായി ചുറ്റുപാട്. കോൺക്രീറ്റല്ല, പച്ചപ്പ് കണ്ടുണരാനാണ് നിങ്ങൾക്കിഷ്ടം. അതിന് സാധാരണ ഒരു പ്രത്യേക സ്ഥലം ഉറപ്പിക്കേണ്ടിവരും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орчин бол амьдралын хэв маяг. Бетон биш, ногоон өнгө хараад сэрэхийг хүсдэг. Энэ нь ихэвчлэн нэг газар тогтохыг шаарддаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निसर्ग हीच जीवनशैली. तुम्हाला काँक्रीट नाही, तर हिरवळ पाहत जागे व्हायचे आहे. त्यासाठी सहसा एका ठिकाणाशी बांधिलकी स्वीकारावी लागते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alam sekitar sebagai gaya hidup. Anda mahu bangun melihat kehijauan, bukan konkrit. Itu biasanya bermakna komited pada satu lokasi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ambjent bħala stil ta' ħajja. Trid tqum għall-ħdura, mhux għall-konkrit. Dan normalment ifisser li torbot ruħek ma' post wieħed."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပတ်ဝန်းကျင်ကို ဘဝပုံစံအဖြစ် မြင်တယ်။ ကွန်ကရစ်ကို မဟုတ်ဘဲ စိမ်းစိမ်းစိုစိုကို မြင်ပြီး နိုးထချင်တယ်။ ဒါဟာ များသောအားဖြင့် နေရာတစ်ခုကို သေချာ ရွေးချယ်ဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgivelser som livsstil. Du vil våkne til grønt, ikke betong. Det betyr ofte å binde seg til ett sted."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वातावरण नै जीवनशैली। तपाईं कंक्रिट होइन, हरियाली हेर्दै उठ्न चाहनुहुन्छ। यसको अर्थ प्रायः एउटा ठाउँमा टिक्ने निर्णय हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgeving als levensstijl. Je wilt wakker worden met groen, niet met beton. Dat betekent meestal kiezen voor één plek."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chilengedwe ngati moyo wanu. Mukufuna kudzuka ndikuona zobiriwira, osati konkire. Nthawi zambiri izi zimatanthauza kudzipereka ku malo enaake."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naannoo akka akkaataa jireenyaatti. Siminti osoo hin taane magariisatti dammaquu barbaadda. Kun yeroo baay'ee iddoo tokkotti of murteessuu jechuu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିବେଶ ହିଁ ଜୀବନଶୈଳୀ। ଆପଣ କଂକ୍ରିଟ୍ ନୁହେଁ, ସବୁଜ ଦେଖି ଉଠିବାକୁ ଚାହାନ୍ତି। ସାଧାରଣତଃ ଏହା ମାନେ କୌଣସି ଏକ ସ୍ଥାନକୁ ବାଛିନେବା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਾਹੌਲ ਹੀ ਜੀਵਨ-ਸ਼ੈਲੀ। ਤੁਸੀਂ ਕੰਕਰੀਟ ਨਹੀਂ, ਹਰਿਆਲੀ ਦੇਖ ਕੇ ਜਾਗਣਾ ਚਾਹੁੰਦੇ ਹੋ। ਇਸ ਦਾ ਮਤਲਬ ਅਕਸਰ ਕਿਸੇ ਇੱਕ ਥਾਂ ਨਾਲ ਪੱਕਾ ਜੁੜਨਾ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otoczenie jako styl życia. Chcesz budzić się wśród zieleni, nie betonu. To zwykle oznacza związanie się z konkretnym miejscem."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چاپېریال د ژوند د طرز په توګه. غواړئ له شنو سره راویښ شئ، نه له کانکرېټو سره. دا معمولاً د یو ځانګړي ځای ټاکل غواړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ambiente como estilo de vida. Você quer acordar vendo verde, não concreto. Isso costuma exigir se comprometer com um lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ambiente como estilo de vida. Queres acordar com verde, não com betão. Isso costuma implicar escolher bem o lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natura ca stil de viață. Vrei să te trezești cu verde, nu cu beton. De obicei asta înseamnă să te legi de un loc anume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Природа как образ жизни. Тебе хочется просыпаться среди зелени, а не бетона. Обычно это значит, что придётся выбрать место надолго."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibidukikije nk'uburyo bw'imibereho. Ushaka kubyuka ureba icyatsi, si sima. Ibyo akenshi bisaba kwiyemeza ahantu runaka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පරිසරයම ජීවන රටාවක් විදිහට. ඔබට ඇහැරෙන්න ඕනේ කොන්ක්‍රීට් වලට නෙවෙයි, කොළ පාටට. ඒ කියන්නේ සාමාන්‍යයෙන් එක තැනකට කැප වෙන එක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostredie ako životný štýl. Chceš sa budiť do zelene, nie do betónu. To zvyčajne znamená zaviazať sa ku konkrétnemu miestu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okolje kot način življenja. Želiš se zbujati ob zelenju, ne betonu. To navadno pomeni, da se zavežeš določenemu kraju."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakatipoteredza semararamiro. Unoda kumuka uchiona miti yakasvibira, kwete kongiri. Izvi kazhinji zvinoreva kuzvipira kunzvimbo imwe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deegaanku waa hab-nololeed kuu ah. Waxaad rabtaa inaad u soo toosto cagaar, ma aha shub. Taasi inta badan waxay ka dhigan tahay inaad meel gaar ah go'aansato."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjedisi si stil jete. Do të zgjohesh mes gjelbërimit, jo betonit. Kjo zakonisht do të thotë të lidhesh me një vend."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окружење као начин живота. Желиш да се будиш уз зеленило, а не бетон. То обично значи да се везујеш за одређено место."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan salaku gaya hirup. Anjeun hoyong hudang ningali héjo, sanés beton. Éta biasana hartosna kedah milih hiji tempat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miljön som livsstil. Du vill vakna till grönska, inte betong. Det innebär oftast att binda sig till en plats."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazingira kama mtindo wa maisha. Unataka kuamka ukiona kijani, si saruji. Kwa kawaida hilo linamaanisha kujifunga na mahali fulani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சூழலே வாழ்க்கை முறை. கான்கிரீட் அல்ல, பசுமையைப் பார்த்து விழிக்க விரும்புகிறீர்கள். அதற்குப் பொதுவாக ஓர் இடத்தில் நிலைக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పరిసరాలే జీవనశైలి. కాంక్రీటు కాదు, పచ్చదనం చూస్తూ నిద్రలేవాలని మీ కోరిక. దానికి సాధారణంగా ఒక ప్రత్యేక ప్రదేశానికి కట్టుబడాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табиат ҳамчун тарзи зиндагӣ. Ту мехоҳӣ субҳ сабзаро бинӣ, на бетонро. Одатан ин маънои ба як ҷой вобаста шуданро дорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งแวดล้อมคือไลฟ์สไตล์ คุณอยากตื่นมาเจอสีเขียว ไม่ใช่คอนกรีต ซึ่งมักหมายถึงต้องเลือกทำเลอย่างจริงจัง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከባቢ ከም ኣገባብ ህይወት። ኮንክሪት ዘይኮነ ልምዑ ተፈጥሮ ርእዮም ክትነቕሑ ትደልዩ። እዚ መብዛሕትኡ ግዜ ኣብ ሓደ ቦታ ምጽናዕ ይሓትት።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daş-töwerek — durmuş ýörelgesi. Betona däl, gök öwüsýän tebigata oýanmak isleýärsiň. Bu, adatça, belli bir ýeri saýlamagy aňladýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşam tarzı olarak çevre. Betona değil, yeşile uyanmak istiyorsun. Bu genellikle bir yere bağlanmak demek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Природа як спосіб життя. Тобі хочеться прокидатися серед зелені, а не бетону. Зазвичай це означає прив’язку до певного місця."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماحول ہی طرزِ زندگی۔ آپ کو کنکریٹ نہیں، ہریالی میں آنکھ کھولنی ہے۔ اس کا مطلب عموماً کسی ایک جگہ کا پکا فیصلہ ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabiat — turmush tarzi sifatida. Beton emas, yashillikka qarab uygʻonishni xohlaysiz. Bu odatda muayyan joyni tanlashni anglatadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môi trường là lối sống. Bạn muốn thức dậy giữa màu xanh, không phải bê tông. Thường điều đó nghĩa là phải gắn bó với một nơi."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indalo njengendlela yokuphila. Ufuna ukuvukela eluhlaza, hayi kwikhonkrithi. Oko kudla ngokuthetha ukuzinikela kwindawo ethile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àyíká bí ọ̀nà ìgbésí ayé. Ẹ fẹ́ jí sí ewé tútù, kì í ṣe sí kọnkéré. Èyí sábà máa ń túmọ̀ sí fífi ara jì ibì kan pàtó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把環境當成生活方式。你想醒來看到綠色，而不是石屎。這通常代表要在某個地方落地生根。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境就是生活方式。你想醒来看到绿色，而不是水泥。这通常意味着要选定一个地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境就是生活方式。你想醒來看到的是綠意，不是水泥。這通常意味著要選定一個地方落腳。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imvelo njengendlela yokuphila. Ufuna ukuvuka ubona okuluhlaza, hhayi ukhonkolo. Lokho kuvame ukusho ukuzibophezela endaweni ethile."
          }
        }
      }
    },
    "Escape before engagement. You need to lower the volume before you can face it. Just don't use distraction to avoid indefinitely." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontsnap eers, pak dan aan. Jy moet die volume eers afdraai voordat jy dit kan aandurf. Moet net nie afleiding gebruik om dit vir altyd te vermy nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከመጋፈጥ በፊት ማምለጥ። ጉዳዩን ከመጋፈጥዎ በፊት ድምፁን መቀነስ ያስፈልግዎታል። ብቻ ሀሳብን ማስቀየርን ለዘለቄታው ለመሸሽ አይጠቀሙበት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهروب قبل المواجهة. خفض الضجيج يسبق قدرتك على مواجهة الأمر. فقط لا تجعلوا الإلهاء وسيلة للتهرّب إلى ما لا نهاية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখামুখি হোৱাৰ আগতে পলায়ন। সমস্যাৰ সন্মুখীন হোৱাৰ আগতে আপুনি মাতটো অলপ কমাব লাগে। মাথোঁ মন আঁতৰোৱাটোক চিৰদিন এৰাই চলাৰ উপায় নকৰিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üzləşməzdən əvvəl qaçış. Problemlə üz-üzə gəlməzdən əvvəl səsi azaltmalısan. Sadəcə diqqəti yayındırmağı sonsuza qədər qaçmaq üçün istifadə etmə."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спачатку ўцячы, потым разбірацца. Табе трэба прыцішыць гук, перш чым сустрэцца з праблемай тварам да твару. Толькі не хавайся ў адцягненнях бясконца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първо бягство, после сблъсък. Трябва ти да намалиш звука, преди да се изправиш срещу проблема. Само не използвай разсейването, за да го отлагаш безкрай."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখোমুখি হওয়ার আগে একটু পালানো। সামলানোর আগে তোমার ভেতরের আওয়াজটা কমাতে হয়। শুধু খেয়াল রেখো, মন সরানোটা যেন চিরকাল এড়িয়ে চলার উপায় না হয়ে যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo bijeg, onda suočavanje. Treba ti da stišaš buku prije nego što se suočiš s problemom. Samo nemoj da odvlačenje pažnje postane trajno izbjegavanje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer evadir-te, després afrontar-ho. Necessites abaixar el volum abans de plantar-hi cara. Només vigila que la distracció no et serveixi per evitar-ho sempre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív únik, pak řešení. Potřebuješ ztlumit hluk, než tomu můžeš čelit. Jen ať se z rozptýlení nestane věčné vyhýbání."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dianc cyn wynebu. Mae angen i ti droi'r sain i lawr cyn y gelli di wynebu'r peth. Ond paid â defnyddio'r dianc i'w osgoi am byth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flugt før konfrontation. Du skal skrue ned for lyden, før du kan tage fat. Brug bare ikke distraktion til at undgå det for evigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst abschalten, dann anpacken. Du musst die Lautstärke runterdrehen, bevor du dich dem stellen kannst. Nur nicht ewig ausweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρώτα απόδραση, μετά αντιμετώπιση. Χρειάζεσαι να χαμηλώσεις την ένταση πριν το αντιμετωπίσεις. Απλώς μη χρησιμοποιείς την απόσπαση για να το αποφεύγεις επ' αόριστον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero evadirte, luego afrontarlo. Necesitas bajar el volumen antes de enfrentarte a ello. Eso sí, no uses la distracción para evitarlo indefinidamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõigepealt põgenemine, siis tegelemine. Sul on vaja helitugevus alla keerata, enne kui suudad asjale otsa vaadata. Lihtsalt ära kasuta seda lõputult vältimiseks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehenik ihes, gero aurre. Bolumena jaitsi behar duzu aurre egin aurretik. Baina ez erabili distrakzioa gaia betiko saihesteko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اول فرار، بعد رویارویی. باید اول صدایش را کم کنی تا بتوانی با آن روبه‌رو شوی. فقط حواس‌پرتی را بهانهٔ فرار همیشگی نکن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensin pako, sitten kohtaaminen. Sinun pitää ensin hiljentää hälyä, ennen kuin pystyt kohtaamaan asian. Älä vain käytä ajanvietettä loputtomaan välttelyyn."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumatakas muna bago humarap. Kailangan mo munang hinaan ang ingay bago mo ito harapin. Huwag lang gamitin ang libangan para iwasan ito nang tuluyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'abord l'évasion, ensuite l'affrontement. Tu dois baisser le volume avant de pouvoir y faire face. Évite juste de t'en servir pour fuir indéfiniment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éalú roimh dhul i ngleic. Ní mór duit an fhuaim a ísliú sula dtig leat aghaidh a thabhairt air. Ná húsáid seachrán mar bhealach chun é a sheachaint go deo."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro evadirte, despois enfrontalo. Necesitas baixar o volume antes de poder encaralo. Só non uses a distracción para evitalo sen fin."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સામનો કરતાં પહેલાં થોડું દૂર જવું. એનો સામનો કરતાં પહેલાં તમારે અવાજ થોડો ધીમો કરવો પડે છે. બસ, ધ્યાન બીજે વાળીને કાયમ ટાળતા ન રહેતા."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gujewa kafin fuskanta. Kuna buƙatar rage zafin abin kafin ku iya fuskantarsa. Kawai kada ku yi amfani da ɗauke hankali wajen gujewa har abada."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בריחה לפני התמודדות. קודם צריך להנמיך את הווליום, ורק אז אפשר להתמודד. רק לא להשתמש בהסחות כדי להתחמק לנצח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामना करने से पहले थोड़ा फ़ासला। उससे जूझने से पहले आपको शोर कम करना होता है। बस ध्यान रखें कि यह टालने का स्थायी तरीक़ा न बन जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo bijeg, onda suočavanje. Trebaš malo stišati glasnoću prije nego što se s tim suočiš. Samo nemoj zauvijek bježati u ometanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chape anvan ou fè fas. Ou bezwen bese volim nan anvan ou ka gade l an fas. Sèlman, pa sèvi ak distraksyon pou evite l pou tout tan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Előbb menekülés, aztán szembenézés. Le kell halkítanod a zajt, mielőtt foglalkozni tudnál vele. Csak ne a végtelenségig kerülgesd."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նախ փախուստ, հետո առերեսում։ Պետք է նախ իջեցնես «ձայնը», որ կարողանաս դիմակայել։ Պարզապես մի՛ օգտագործիր շեղումը՝ անվերջ խուսափելու համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabur dulu sebelum menghadapi. Kamu perlu menurunkan volumenya sebelum bisa menghadapinya. Asal jangan jadikan pelarian untuk menghindar terus."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịgbapụ tupu ihu ya. Ị chọrọ ibelata ụda ya tupu ị nwee ike ihu ya. Naanị ejila ihe ntụgharị uche zere ya ruo mgbe ebighị ebi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flótti fyrst, svo glíman. Þú þarft að lækka hljóðið áður en þú getur tekist á við málið. Bara ekki nota afþreyinguna til að forðast það endalaust."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima evadere, poi affrontare. Hai bisogno di abbassare il volume prima di guardare le cose in faccia. Basta non usare la distrazione per rimandare all’infinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向き合う前に、まず逃げるタイプ。立ち向かうには、いったん気持ちのボリュームを下げる必要があります。ただ、ずっと避け続ける口実にはしないように。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyingkir dhisik sadurunge ngadhepi. Panjenengan butuh ngendhokake rasa dhisik sadurunge bisa ngadhepi. Mung aja nganti ngalihake pikiran dadi cara nyingkiri terus-terusan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჯერ გაქცევა, მერე პირისპირ შეხვედრა. სანამ პრობლემას შეხედავ, ხმას უნდა დაუწიო. ოღონდ ყურადღების გაფანტვას უსასრულოდ თავის არიდებისთვის ნუ გამოიყენებ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алдымен қашу, сосын бетпе-бет келу. Мәселеге қарау үшін алдымен дыбысын бәсеңдетуің керек. Тек алаңдауды мәселеден мәңгі қашу үшін пайдаланба."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គេចសិន ទើបប្រឈម។ អ្នកត្រូវបន្ថយសំឡេងរំខានក្នុងចិត្តសិន ទើបអាចប្រឈមមុខនឹងវាបាន។ គ្រាន់តែកុំប្រើការបង្វែរចិត្តដើម្បីគេចវេសរហូត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎದುರಿಸುವ ಮೊದಲು ತಪ್ಪಿಸಿಕೊಳ್ಳುವಿಕೆ. ಅದನ್ನು ಎದುರಿಸುವ ಮೊದಲು ನೀವು ಗದ್ದಲವನ್ನು ಸ್ವಲ್ಪ ತಗ್ಗಿಸಬೇಕು. ಆದರೆ ಗಮನ ಬೇರೆಡೆ ಹರಿಸುವುದನ್ನು ಶಾಶ್ವತವಾಗಿ ತಪ್ಪಿಸಿಕೊಳ್ಳುವ ದಾರಿಯಾಗಿಸಬೇಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마주하기 전에 먼저 벗어나요. 문제를 마주할 수 있으려면 볼륨을 낮춰야 해요. 다만 끝없이 피하는 수단이 되지 않게 해 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêşî revîn, paşê rûbirûbûn. Berî ku tu pê re rû bi rû bibî, divê tu dengê wê nizm bikî. Tenê bi rêya bala xwe kişandinê ji bo her û her jê nereve."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адегенде качуу, анан чечүү. Аны менен бетме-бет келүүдөн мурун «үнүн басаңдатышың» керек. Болгону алаксууну түбөлүк качуунун жолуна айлантпа."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flucht virun Ausernanersetzung. Du muss d'Lautstäerkt als éischt erofdréinen, éiers de der Saach entgéintgoe kanns. Benotz Oflenkung just net, fir alles éiweg ewechzeschieben."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໜີກ່ອນຈະເຜີຊີນໜ້າ ເຈົ້າຕ້ອງຫຼຸດຄວາມວຸ່ນວາຍໃນໃຈລົງກ່ອນ ຈຶ່ງຈະຮັບມືກັບມັນໄດ້ ພຽງແຕ່ຢ່າໃຊ້ສິ່ງອື່ນມາບັງ ເພື່ອຫຼີກໜີໄປເລື້ອຍໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirma pabėgti, paskui spręsti. Tau reikia pritildyti garsą, kad galėtum su tuo susidurti. Tik neleisk blaškymuisi tapti amžinu vengimu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vispirms bēgšana, tad saskarsme. Tev jānoklusina troksnis, pirms vari tam stāties pretī. Tikai neizmanto to, lai izvairītos bezgalīgi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandositra aloha vao miatrika. Mila mampihena ny tabataba ianao vao afaka miatrika azy. Aza ampiasaina hialana mandrakizay fotsiny ny fivilian-tsaina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka oma i te tuatahi, kātahi ka anga atu. Me whakaiti koe i te turituri i mua i tō anga atu. Kaua noa e whakamahi i te kume aro hei karo mō ake tonu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прво бегство, па соочување. Мораш да го намалиш звукот пред да се соочиш со тоа. Само не користи го одвлекувањето за да избегнуваш до бесконечност."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നേരിടുംമുമ്പ് ഒന്ന് മാറിനിൽക്കൽ. അതിനെ നേരിടാൻ ആദ്യം ഉള്ളിലെ ഒച്ച കുറയ്ക്കണം. ശ്രദ്ധ മാറ്റൽ എന്നെന്നേക്കുമായി ഒഴിഞ്ഞുമാറാനുള്ള വഴിയാക്കരുതെന്ന് മാത്രം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нүүр тулахаасаа өмнө зугтдаг. Асуудалтай тулгарахаасаа өмнө дууг нь багасгах хэрэгтэй. Гэхдээ анхаарал сарниулахыг үүрд зайлсхийх арга болгож болохгүй шүү."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामोरे जाण्याआधी थोडे दूर जाणे. त्याला तोंड देण्याआधी तुम्हाला मनातला आवाज थोडा कमी करावा लागतो. फक्त विरंगुळ्याचा वापर कायमचे टाळण्यासाठी करू नका."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lari dahulu sebelum berdepan. Anda perlu meredakan keadaan dulu sebelum mampu menghadapinya. Cuma jangan jadikan hiburan cara untuk terus mengelak."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taħrab qabel tiffaċċja. Għandek bżonn tbaxxi l-volum qabel tkun tista' tiffaċċjaha. Biss tużax id-distrazzjoni biex tevitaha għal dejjem."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရင်မဆိုင်ခင် ခဏ ရှောင်ထွက်တယ်။ ရင်ဆိုင်နိုင်ဖို့ အရင် စိတ်ကို အေးအောင် လုပ်ဖို့ လိုတယ်။ စိတ်လွှဲတာကို အဆုံးမရှိ ရှောင်ပြေးဖို့ မသုံးမိပါစေနဲ့။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flukt før du tar tak. Du må skru ned volumet før du kan møte det. Bare ikke bruk distraksjon for å unngå det i det uendelige."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामना गर्नुअघि अलि पर सर्नु। सामना गर्न सक्नुअघि तपाईंलाई मनको आवाज अलि मधुरो पार्नु पर्छ। बस, ध्यान मोड्ने कुरालाई सधैँ टार्ने बहाना नबनाउनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst ontsnappen, dan aanpakken. Je moet het volume omlaag draaien voordat je het onder ogen kunt zien. Gebruik afleiding alleen niet om het eindeloos te ontlopen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuthawa kaye musanakumane nazo. Mumafunika kuchepetsa phokoso musanakwanitse kukumana nazo. Koma musagwiritse ntchito zosokoneza kuti mupewe nkhaniyo mpaka kalekale."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura baqachuu, booda fuuluu. Dura sagalee isaa gad buusuu barbaadda, booda itti dhihaatta. Garuu bashannanaan yeroo dheeraaf irraa hin baqatin."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସାମ୍ନା କରିବା ଆଗରୁ ଟିକେ ପଳାୟନ। ମୁହାଁମୁହିଁ ହେବା ଆଗରୁ ଆପଣଙ୍କୁ ଚାପର ସ୍ୱର ଟିକେ କମାଇବା ଦରକାର। କେବଳ ଧ୍ୟାନ ଅନ୍ୟଆଡ଼େ ନେଇ ସବୁଦିନ ପାଇଁ ଏଡ଼ାଇଯାଆନ୍ତୁ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਹਿਲਾਂ ਥੋੜ੍ਹਾ ਬਚਾਅ, ਫਿਰ ਸਾਹਮਣਾ। ਗੱਲ ਦਾ ਸਾਹਮਣਾ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਤੁਹਾਨੂੰ ਅੰਦਰਲਾ ਸ਼ੋਰ ਘਟਾਉਣਾ ਪੈਂਦਾ ਹੈ। ਬੱਸ ਧਿਆਨ ਹਟਾਉਣ ਨੂੰ ਹਮੇਸ਼ਾ ਲਈ ਟਾਲਣ ਦਾ ਬਹਾਨਾ ਨਾ ਬਣਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw ucieczka, potem zmierzenie się z problemem. Musisz przyciszyć emocje, zanim stawisz im czoła. Tylko nie odkładaj tego w nieskończoność."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له مخامخ کېدو مخکې تېښته. مخکې له دې چې ورسره مخ شئ، باید د هغې غږ ټیټ کړئ. خو پام وکړئ چې بوختیا د تل لپاره د تېښتې لاره ونه ګرځي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fugir antes de encarar. Você precisa baixar o volume antes de lidar com aquilo. Só não use a distração para adiar para sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fugir antes de enfrentar. Precisas de baixar o volume antes de lidar com o assunto. Só não uses a distração para o adiar para sempre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadare înainte de confruntare. Ai nevoie să dai volumul mai încet înainte să poți face față. Doar să nu folosești distragerea ca să amâni la nesfârșit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала побег, потом решение. Тебе нужно убавить громкость, чтобы встретиться с проблемой. Только не превращай отвлечение в бесконечное избегание."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhunga mbere yo guhangana. Ukeneye kubanza kugabanya ubukana mbere yo kubyitegereza. Gusa ntukoreshe kwirangaza ngo uhunge iteka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මුහුණ දෙන්න කලින් පැනයාම. ප්‍රශ්නයට මුහුණ දෙන්න කලින් ඔබට ඒකේ හඬ ටිකක් අඩු කරගන්න ඕනේ. හැබැයි හිත වෙන පැත්තකට ගැනීම ප්‍රශ්නය සදහටම මඟහරින්න පාවිච්චි කරන්න එපා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv únik, potom riešenie. Musíš stlmiť hlasitosť, kým sa tomu dokážeš postaviť. Len nech ti rozptýlenie neslúži na nekonečné odkladanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej pobeg, potem soočenje. Preden se lahko s čim spoprimeš, moraš utišati hrup. Le ne uporabljaj zamotitve za izogibanje v nedogled."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutiza usati watarisana nazvo. Unoda kuderedza ruzha usati wazvitarisa. Chete usashandise kuvaraidzwa kuti uzvidzivise zvachose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka baxsasho ka hor wajahaadda. Waxaad u baahan tahay inaad codka hoos u dhigto ka hor intaadan wajihin. Balse ha u isticmaalin mashquulka inaad weligaa ka cararto."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arratisje para përballjes. Të duhet ta ulësh volumin para se ta përballosh. Vetëm mos e përdor shpërqendrimin për ta shmangur pafundësisht."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прво бег, па суочавање. Мораш да утишаш звук пре него што се суочиш с тим. Само немој да одвраћање пажње постане бесконачно избегавање."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabur heula, nembé nyanghareupan. Anjeun peryogi ngirangan sorana heula sateuacan tiasa nyanghareupanana. Ngan ulah dugi ka nyumput salamina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Först en paus, sen tag i saken. Du behöver sänka volymen innan du orkar möta det. Använd bara inte distraktion för att skjuta upp det i all oändlighet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukwepa kwanza, kukabili baadaye. Unahitaji kupunguza kelele kabla ya kulikabili. Ila usitumie kujisahaulisha kulikwepa milele."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எதிர்கொள்ளும் முன் சற்று விலகல். அதைச் சந்திக்கும் முன் சத்தத்தைக் குறைக்க வேண்டும். ஆனால் கவனச்சிதறலை வைத்து எப்போதும் தவிர்த்துவிடாதீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎదుర్కొనే ముందు కాస్త దూరం. సమస్యను ఎదుర్కొనే ముందు దాని హోరు తగ్గాలి. కానీ దాన్ని ఎప్పటికీ తప్పించుకోవడానికి దృష్టి మళ్లింపును వాడకండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аввал гурез, баъд рӯ ба рӯ. Ба ту лозим аст, ки пеш аз рӯ ба рӯ шудан садоро паст кунӣ. Танҳо бо парешонӣ ҳамеша аз мушкил гурез накун."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนีก่อนแล้วค่อยเผชิญ คุณต้องลดเสียงในหัวลงก่อนจึงจะรับมือได้ แค่อย่าใช้การหาอะไรทำเพื่อหลบเลี่ยงไปตลอด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅድሚ ምግጣም ምህዳም። ቅድሚ ምግጣምኩም ነቲ ድምጺ ክትቕንሱዎ የድልየኩም። ጥራይ ንዘለኣለም ንምህዳም ምዝንጋዕ ኣይትጠቐሙሉ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilki gaçmak, soň ýüzbe-ýüz bolmak. Oňa garşy durmazdan öň sesini peseltmeli. Diňe ünsüňi sowmagy hemişelik gaçmak üçin ulanma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzleşmeden önce kaçış. Sorunla yüzleşebilmek için önce sesi kısman gerekiyor. Yeter ki oyalanmayı sonsuza dek kaçmak için kullanma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу втеча, потім справи. Тобі треба трохи стишити шум, перш ніж дивитися проблемі в очі. Тільки не ховайся у відволіканні безкінечно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سامنا کرنے سے پہلے فرار۔ مقابلہ کرنے سے پہلے آپ کو شور ذرا دھیما کرنا ہوتا ہے۔ بس دھیان بٹانے کو ہمیشہ کے لیے ٹالنے کا ذریعہ نہ بنائیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avval qochish, keyin yuzlashish. Muammoga qarashdan oldin uning ovozini pasaytirishingiz kerak. Faqat chalgʻishni cheksiz qochish vositasiga aylantirmang."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát ra trước, đối mặt sau. Bạn cần vặn nhỏ âm lượng trước khi đối diện. Chỉ đừng dùng nó để né tránh mãi."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubaleka phambi kokujongana nayo. Kufuneka uthulise ingxolo phambi kokuba ukwazi ukujongana nayo. Kodwa ungasebenzisi ukuziphazamisa ukuze uyiphephe ngonaphakade."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sísá kí ẹ tó dojú kọ ọ́. Ẹ nílò láti dín ariwo rẹ̀ kù kí ẹ tó lè kojú rẹ̀. Ẹ ṣáà má fi ìpínyà ọkàn sá fún un títí láé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先逃離，再面對。你要先把音量調低，才能正視問題。只是別把分散注意力變成無限期的逃避。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先逃离，再面对。你得先给情绪降降温，才能正视问题。只是别一直靠分心来逃避。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先逃離、再面對。你需要先讓腦袋安靜一點，才有辦法處理。只是別用分心來無限期逃避。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubalekela kuqala, bese ubhekana nakho. Udinga ukwehlisa umsindo ngaphambi kokuthi ubhekane nakho. Nje ungasebenzisi ukuziphazamisa ukuze ukugweme unomphela."
          }
        }
      }
    },
    "Escape is your recovery mechanism. Getting out of your head with something enjoyable is more restorative than talking it through." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontsnapping is hoe jy herstel. Om met iets lekkers uit jou kop te kom, help jou meer as om alles deur te praat."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማምለጥ የማገገሚያ መንገድዎ ነው። በሚያስደስት ነገር ከሀሳብዎ መውጣት ስለ ጉዳዩ ከማውራት በላይ ያሳርፍዎታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهروب طريقتك في التعافي. الخروج من دوامة الأفكار بشيء ممتع يريحك أكثر من الحديث عن المشكلة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পলায়নেই আপোনাৰ জিৰণি। কথা পাতি থকাতকৈ ভাল লগা কিবা এটাৰে মূৰৰ পৰা ওলাই অহাটোৱে আপোনাক বেছি সতেজ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qaçış sənin bərpa yolundur. Xoşuna gələn bir şeylə fikirlərindən uzaqlaşmaq səni hər şeyi danışıb-müzakirə etməkdən daha çox dincəldir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пераключыцца — твой спосаб аднавіцца. Выкінуць думкі з галавы праз штосьці прыемнае дапамагае табе больш, чым доўгая размова."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бягството е начинът ти да се възстановиш. Да излезеш от главата си с нещо приятно те зарежда повече, отколкото да го обсъждаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পালিয়ে যাওয়াই তোমার সেরে ওঠার উপায়। কথা বলে খুঁটিয়ে দেখার চেয়ে ভালো লাগার কিছুতে মাথা থেকে বেরিয়ে আসাটাই তোমাকে বেশি চাঙ্গা করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijeg je tvoj način oporavka. Kad izađeš iz svoje glave uz nešto lijepo, to te više obnovi nego razgovor o problemu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadir-te és la teva manera de recuperar-te. Sortir del teu cap amb alguna cosa que t'agradi et reconforta més que no pas parlar-ne."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únik je tvůj způsob, jak se zotavit. Vypnout hlavu u něčeho příjemného ti pomůže víc než to rozebírat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dianc yw dy ffordd o adfer. Mae dod allan o dy ben gyda rhywbeth braf yn fwy llesol na siarad y peth drwodd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flugt er din måde at komme dig på. At komme ud af hovedet med noget, du nyder, giver mere ro end at snakke det igennem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschalten ist deine Art, dich zu erholen. Mit etwas Schönem den Kopf freizubekommen, bringt dir mehr, als alles durchzusprechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόδραση είναι ο τρόπος σου να ανακάμπτεις. Το να ξεφεύγεις από τις σκέψεις σου με κάτι ευχάριστο σε ξεκουράζει περισσότερο από το να το αναλύεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadirte es tu forma de recuperarte. Salir de tu cabeza con algo que disfrutes te repara más que darle vueltas hablando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põgenemine on sinu viis taastuda. Millegi toredaga oma peast välja saamine annab rohkem jõudu kui asja läbiarutamine."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihes egitea da zure berreskuratzeko modua. Gozatzeko zerbaitekin burutik ateratzeak gehiago lasaitzen zaitu horretaz hitz egiteak baino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرار، راه بازیابی توست. بیرون آمدن از فکر و خیال با یک کار لذت‌بخش بیشتر از حرف زدن حالت را جا می‌آورد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pako on tapasi palautua. Kun saat ajatukset muualle jollain mukavalla, se elvyttää enemmän kuin asian puiminen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagtakas ang paraan mo ng pagbawi. Mas nakakagaan sa’yo ang makalimot sandali sa tulong ng masayang bagay kaysa pag-usapan ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'évasion, c'est ta façon de récupérer. Te vider la tête avec quelque chose d'agréable te ressource plus que d'en parler."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é éalú an chaoi a dtagann tú chugat féin. Is mó a dhéanann rud taitneamhach duit ná labhairt faoi go mion."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadirte é a túa forma de recuperarte. Saír da túa cabeza con algo agradable repárate máis ca falalo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "થોડું દૂર જવું એ જ તમારી ફરી તાજા થવાની રીત છે. વાત કરતાં રહેવા કરતાં કંઈક ગમતું કરીને મગજમાંથી બહાર નીકળવું તમને વધુ રાહત આપે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gujewa ita ce hanyarku ta murmurewa. Fita daga cikin tunani da wani abin jin daɗi ya fi muku hutawa fiye da tattaunawa a kai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בריחה היא הדרך שלך להתאושש. לצאת מהראש עם משהו מהנה ממלא אותך יותר מלדבר על זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए राहत का रास्ता है थोड़ी देर का ब्रेक। किसी मज़ेदार चीज़ से दिमाग़ को छुट्टी देना, बात करके सुलझाने से ज़्यादा सुकून देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijeg je tvoj način oporavka. Kad izađeš iz svoje glave uz nešto ugodno, to te više okrijepi nego razgovor."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chape kò ou se fason ou refè fòs. Sòti nan tèt ou ak yon bagay ki fè ou plezi repoze ou plis pase pale sou sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked a menekülés hozza el a feltöltődést. Ha valami élvezetes kiránt a gondolataidból, az jobban regenerál, mint az átbeszélés."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փախուստը քո վերականգնվելու ձևն է։ Հաճելի բանով մտքերից կտրվելը քեզ ավելի է օգնում, քան խնդիրը քննարկելը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabur sejenak adalah caramu pulih. Keluar dari pikiranmu lewat hal yang menyenangkan lebih memulihkan daripada membahasnya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịgbapụ bụ ụzọ i si ezu ike. Iji ihe na-atọ gị ụtọ wepụ uche gị na ya na-eweghachi ike karịa ikwu banyere ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flóttinn er leiðin þín til að ná þér. Að komast út úr eigin höfði með einhverju skemmtilegu gerir þér meira gott en að ræða málin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadere è il tuo modo di ricaricarti. Uscire dalla tua testa con qualcosa di piacevole ti rigenera più che parlarne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逃げることが回復の手段です。話し合うより、楽しいことで頭を切り替える方が元気を取り戻せます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyingkir sedhela iku cara panjenengan pulih. Metu saka pikiran dhewe liwat sing nyenengake luwih nyegerake tinimbang ngrembug."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გაქცევა შენი აღდგენის გზაა. როცა ფიქრებს რაღაც სასიამოვნოთი იშორებ, ეს უფრო გასვენებს, ვიდრე ბოლომდე განხილვა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен қашып алып қалпына келесің. Ойдан шығып, ұнайтын бір іспен айналысу саған сөйлесуден гөрі көбірек күш береді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការគេចចេញមួយភ្លែត ជាមធ្យោបាយស្ដារកម្លាំងរបស់អ្នក។ ការចេញពីគំនិតខ្លួនឯងដោយធ្វើអ្វីដែលរីករាយ ជួយឲ្យអ្នកធូរស្រាលជាងការនិយាយរៀបរាប់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದೇ ನಿಮ್ಮ ಚೇತರಿಕೆಯ ದಾರಿ. ಮಾತಾಡಿ ಬಗೆಹರಿಸುವುದಕ್ಕಿಂತ, ಖುಷಿ ಕೊಡುವ ಏನಾದರೂ ಮಾಡಿ ಯೋಚನೆಗಳಿಂದ ಹೊರಬರುವುದು ನಿಮಗೆ ಹೆಚ್ಚು ಚೈತನ್ಯ ನೀಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벗어나는 게 회복하는 방법이에요. 이야기로 풀기보다 즐거운 일로 머릿속을 비우는 게 훨씬 힘이 돼요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revîn rêya te ya başbûnê ye. Bi tiştekî xweş ji ramanên xwe dûr ketin, ji axaftina li ser wê bêtir hêz dide te."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен алаксуу аркылуу эс аласың. Жагымдуу бир нерсе менен ойлордон чыгуу сага сүйлөшүүдөн көбүрөөк күч берет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flucht ass däi Wee, fir erëm op d'Bee ze kommen. Mat eppes Schéinem aus dem Kapp erauszekommen, deet dir méi gutt wéi alles duerchzeschwätzen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການໜີໄປພັກໃຈແມ່ນວິທີຟື້ນຕົວຂອງເຈົ້າ ການໄດ້ອອກຈາກຄວາມຄິດໃນຫົວດ້ວຍສິ່ງທີ່ມ່ວນ ຊ່ວຍໃຫ້ເຈົ້າຮູ້ສຶກດີຂຶ້ນຫຼາຍກວ່າການນັ່ງລົມກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pabėgimas – tavo būdas atsigauti. Atitrūkti nuo minčių per kažką malonaus tau padeda labiau nei viską aptarti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu atgūsties, aizbēgot no ikdienas. Iziet no savām domām ar kaut ko patīkamu tev palīdz vairāk nekā visu izrunāt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fandosirana no fomba hamerenanao hery. Ny fialana amin'ny eritreritrao amin'ny zavatra mahafinaritra dia mamelombelona kokoa noho ny firesahana momba izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te puta atu tō huarahi whakaora. Ko te wehe i ō whakaaro mā tētahi mea pārekareka, he whakaora ake i te kōrero roa mō taua mea."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бегството е твојот начин да се опоравиш. Да излезеш од својата глава со нешто пријатно те обновува повеќе од долг разговор."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒന്ന് മാറിനിൽക്കലാണ് നിങ്ങളുടെ ആശ്വാസവഴി. സംസാരിച്ച് തീർക്കുന്നതിനേക്കാൾ, ഇഷ്ടമുള്ള എന്തെങ്കിലും ചെയ്ത് ചിന്തകളിൽ നിന്ന് പുറത്തുകടക്കുന്നതാണ് നിങ്ങൾക്ക് കൂടുതൽ ഉന്മേഷം നൽകുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зугтах нь чиний сэргэх арга. Ярилцахаас илүү таатай зүйлээр толгойгоо сэргээх нь чамайг илүү тэнхрүүлдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विरंगुळा हीच तुमची सावरण्याची पद्धत आहे. बोलत बसण्यापेक्षा काहीतरी आनंददायी करून डोक्यातून बाहेर पडणे तुम्हाला जास्त ताजेतवाने करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melarikan diri seketika ialah cara anda pulih. Keluar dari fikiran sendiri dengan sesuatu yang menyeronokkan lebih memulihkan daripada membincangkannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ħarba hija l-mod kif terġa' tieħu n-nifs. Li toħroġ minn rasek b'xi ħaġa li tgawdi jserrħek aktar milli titkellem dwarha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခဏ ရှောင်ထွက်တာက သင့်ရဲ့ အားပြန်ဖြည့်နည်းပါ။ ပျော်စရာတစ်ခုခုနဲ့ ခေါင်းထဲက အတွေးတွေကနေ ခဏ ထွက်လိုက်တာက အကြောင်းအရာကို ပြောဆိုဆွေးနွေးတာထက် ပိုပြီး အားပြန်ပြည့်စေတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flukt er måten du henter deg inn på. Å komme deg ut av ditt eget hode med noe hyggelig gir mer påfyll enn å snakke det gjennom."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंका लागि ध्यान मोड्नु नै तनावबाट उठ्ने उपाय हो। कुरा गरेर सुल्झाउनुभन्दा रमाइलो कुरामा रमाएर दिमागबाट बाहिर निस्कनुले तपाईंलाई बढी ताजा बनाउँछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontsnappen is hoe jij herstelt. Even uit je hoofd met iets leuks helpt je meer dan erover praten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuthawa pang'ono ndi njira yanu yopezera mphamvu. Kutuluka m'maganizo mwanu ndi chinthu chosangalatsa kumakubwezeretsani kuposa kukambirana nkhaniyo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baqachuun karaa ati itti haaromfattu dha. Waan si gammachiisuun yaada keessaa ba'uun, waa'ee isaa haasa'uu caalaa si haaromsa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପଳାୟନ ହିଁ ଆପଣଙ୍କ ସୁସ୍ଥ ହେବାର ଉପାୟ। କଥା ହୋଇ ସମାଧାନ କରିବା ଅପେକ୍ଷା ଆନନ୍ଦଦାୟକ କିଛି କରି ଚିନ୍ତାରୁ ବାହାରିଆସିବା ଆପଣଙ୍କୁ ଅଧିକ ସତେଜ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਥੋੜ੍ਹਾ ਦੂਰ ਨਿਕਲ ਜਾਣਾ ਹੀ ਤੁਹਾਡਾ ਆਰਾਮ ਹੈ। ਕਿਸੇ ਮਨਪਸੰਦ ਚੀਜ਼ ਨਾਲ ਸੋਚਾਂ ਵਿੱਚੋਂ ਬਾਹਰ ਆਉਣਾ ਤੁਹਾਨੂੰ ਗੱਲ ਕਰਨ ਨਾਲੋਂ ਵੱਧ ਤਾਜ਼ਾ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucieczka to twój sposób na regenerację. Wyjście z własnej głowy dzięki czemuś przyjemnemu daje ci więcej niż rozmowa o problemie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تېښته ستاسو د بیا رغېدو لاره ده. په یو خوندور کار له فکرونو وتل، تر اوږدو خبرو ډېر تاسو بیا تازه کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fugir um pouco é como você se recupera. Sair da própria cabeça com algo gostoso restaura mais do que falar sobre o assunto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fugir um pouco é a tua forma de recuperar. Sair da tua cabeça com algo de que gostas restaura-te mais do que falar sobre o assunto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evadarea e felul tău de a te reface. Să-ți iei gândul de la toate cu ceva plăcut te încarcă mai mult decât să discuți problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключение — твой способ восстановиться. Выбраться из своих мыслей с помощью чего-то приятного помогает больше, чем долгие разговоры."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhunga gato ni bwo buryo bwawe bwo kwisubiza. Kuva mu bitekerezo byawe ukoresheje ikintu gishimishije bikuruhura kurusha kubiganiraho."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පැනයාම තමයි ඔබ යළි ප්‍රකෘතිමත් වන ක්‍රමය. ප්‍රශ්නය ගැන කතා කරනවාට වඩා, සතුටු දෙයකින් ඔළුවෙන් එළියට එන එක ඔබට වැඩි සහනයක් දෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únik je tvoj spôsob, ako sa zotaviť. Vypnúť hlavu pri niečom príjemnom ti pomôže viac než všetko rozoberať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobeg je tvoj način okrevanja. Ko se s čim prijetnim umakneš iz svojih misli, si opomoreš bolj kot s pogovorom."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutiza kwechinguva ndiko kunokuzorodza. Kubuda mupfungwa dzako nechinhu chinonakidza kunokuzorodza kupfuura kuzvitaura."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka baxsashadu waa sida aad ku soo kabato. Inaad maskaxdaada ka nasato adigoo wax ku raaxeysiiya samaynaya ayaa kaaga caafimaad badan ka hadalka arrinta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arratisja është mënyra jote për t’u rikuperuar. Të dalësh nga mendimet me diçka të këndshme të çlodh më shumë se ta bisedosh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бег је твој начин опоравка. Кад изађеш из своје главе уз нешто пријатно, то те више обнови него разговор."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabur sakedap téh cara anjeun pulih. Kaluar tina pikiran ku hal anu matak resep langkung nyegerkeun tibatan nyarioskeunana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flykt är ditt sätt att återhämta dig. Att komma ur huvudet med något roligt ger dig mer än att prata igenom det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujiepusha kidogo ndiko kunakokurejeshea nguvu. Kutoka kwenye mawazo yako kwa kitu cha kufurahisha kunakupumzisha kuliko kulizungumza."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தப்பித்தல்தான் உங்கள் மீட்சி வழி. பேசித் தீர்ப்பதைவிட, மகிழ்ச்சியான ஒன்றில் மூழ்கி மனதை விடுவிப்பதுதான் உங்களுக்கு அதிகப் புத்துணர்ச்சி தரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తప్పించుకోవడమే మీరు కోలుకునే మార్గం. దాని గురించి మాట్లాడటం కన్నా, మీకు నచ్చిన పనిలో మునిగిపోవడమే మీకు ఎక్కువ ఊరటనిస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гурехтан роҳи барқароршавии туст. Бо чизи дилкаш аз фикрҳо берун шудан ба ту аз гап задан бештар қувват мебахшад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การได้หลีกหนีชั่วคราวคือวิธีฟื้นพลังของคุณ การได้หลุดจากความคิดวนในหัวด้วยเรื่องสนุกๆ ช่วยเติมพลังได้มากกว่าการนั่งคุยถึงปัญหา"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምህዳም መንገዲ ምሕዋይኩም እዩ። ብዘሐጕስ ነገር ካብ ሓሳባትኩም ምውጻእ፣ ብዛዕባኡ ካብ ምዝራብ ንላዕሊ የሐድሰኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaçmak — seniň dikeliş usulyň. Hoşuňa gelýän bir zat bilen kelläňi boşatmak gürrüň etmekden has köp güýç berýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaçış, toparlanma yolun. Keyifli bir şeyle kafanı dağıtmak, konuyu konuşmaktan daha çok iyi gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Втеча — твій спосіб відновитися. Вибратися з власних думок завдяки чомусь приємному відновлює краще, ніж розмови."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرار ہی آپ کا سنبھلنے کا طریقہ ہے۔ کسی خوشگوار چیز میں کھو کر خیالوں سے نکلنا، بات کر کے سلجھانے سے زیادہ تازگی دیتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chalgʻish — sizning tiklanish usulingiz. Yoqimli mashgʻulot bilan xayollardan uzilish siz uchun gaplashib olishdan koʻra koʻproq kuch beradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát ra là cách bạn hồi phục. Rời khỏi mớ suy nghĩ bằng điều gì đó vui vẻ giúp bạn hồi sức hơn là ngồi phân tích."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubaleka yindlela yakho yokuchacha. Ukuphuma ezingcingeni ngento oyonwabelayo kukuhlaziya ngaphezu kokuthetha ngayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sísá kúrò níbẹ̀ fún ìgbà díẹ̀ ni ọ̀nà tí ara fi ń tù yín. Fífi nǹkan ìgbádùn gbé ọkàn yín kúrò níbẹ̀ máa ń tù yín lára ju sísọ̀rọ̀ nípa rẹ̀ lọ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逃離一下，就是你回復元氣的方法。用開心的事讓自己跳出思緒，比反覆討論更能讓你恢復過來。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逃离是你恢复的方式。做点开心的事跳出思绪，比把事情聊透更能让你缓过来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逃離一下就是你的充電方式。做點開心的事跳出思緒，比把事情聊透更能讓你恢復。"
