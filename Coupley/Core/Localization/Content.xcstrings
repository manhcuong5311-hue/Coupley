        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝጭበጥ ደገፍ። ሰብ ክጽገም ከሎ ብቓላት ጥራይ ዘይኮነ ብተግባር ፍቕርኹም ተርእዩ።"
