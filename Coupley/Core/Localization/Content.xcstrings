        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າໃຫ້ຄູ່ຢູ່ໃນຊີວິດປະຈຳວັນສະເໝີ ກິດຈະວັດ ແລະ ສິ່ງທີ່ເຊື່ອມໂຍງກັນມີຄວາມໝາຍກັບເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu išlaikai antrąją pusę savo kasdienybėje. Bendri ritualai ir asociacijos tau daug reiškia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ļauj otrajai pusei būt klātesošai savā ikdienā. Kopīgi rituāli un asociācijas tev ir nozīmīgas."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ataonao eo foana izy amin'ny fiainanao andavanandro. Manan-danja aminao ireo fanao iraisana sy ireo zavatra mampahatsiahy azy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka noho tonu ia i tō ao o ia rā. He whai tikanga ki a koe ngā tikanga me ngā hononga e tiritiri ana kōrua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ја држиш половинката присутна во секојдневието. Заедничките ритуали и асоцијации ти значат многу."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ദൈനംദിന ജീവിതത്തിൽ നിങ്ങൾ പങ്കാളിയെ ചേർത്തുനിർത്തുന്നു. പങ്കിട്ട ശീലങ്ങളും ഓർമകളുമായുള്ള ബന്ധങ്ങളും നിങ്ങൾക്ക് അർഥവത്താണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи ханиа өдөр тутмын амьдралдаа дэргэдээ байлгадаг. Хамтын зан үйл, холбоо бүхий зүйлс чамд утга учиртай."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोजच्या आयुष्यातही तुम्ही जोडीदाराला सोबत ठेवता. एकत्र जपलेल्या सवयी आणि आठवणींशी जोडलेल्या गोष्टी तुमच्यासाठी अर्थपूर्ण आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda membawa pasangan anda dalam kehidupan seharian. Rutin dan kenangan bersama sangat bermakna bagi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iżżomm lill-partner tiegħek preżenti fil-ħajja ta' kuljum. Ir-ritwali u l-assoċjazzjonijiet komuni jfissru ħafna għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေ့စဉ်ဘဝထဲမှာ ချစ်သူကို အမြဲ ရှိနေစေတယ်။ အတူ မျှဝေခဲ့တဲ့ ဓလေ့လေးတွေနဲ့ ဆက်စပ်အရာတွေက သင့်အတွက် အဓိပ္ပာယ်ရှိတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du holder partneren din nær i hverdagen. Felles ritualer og assosiasjoner betyr mye for deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं उहाँलाई आफ्नो दैनिक जीवनमा उपस्थित राख्नुहुन्छ। साझा रीत र याद दिलाउने कुराहरू तपाईंका लागि अर्थपूर्ण छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt je partner aanwezig in je dagelijks leven. Gedeelde rituelen en associaties betekenen veel voor je."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumawasunga pafupi pa moyo wanu watsiku ndi tsiku. Zizolowezi ndi zinthu zomwe mumagawana nzofunika kwa inu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jireenya kee guyyaa guyyaa keessatti jaalallee kee ni argamsiifta. Aadaawwan waliinii fi waan isin walitti hidhu hiika guddaa siif qabu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ସେମାନଙ୍କୁ ନିଜ ଦୈନନ୍ଦିନ ଜୀବନରେ ସାଙ୍ଗରେ ରଖନ୍ତି। ମିଳିତ ଅଭ୍ୟାସ ଓ ସ୍ମୃତି ଜଡ଼ିତ ଜିନିଷ ଆପଣଙ୍କ ପାଇଁ ଅର୍ଥପୂର୍ଣ୍ଣ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਨੂੰ ਆਪਣੀ ਰੋਜ਼ਮੱਰਾ ਜ਼ਿੰਦਗੀ ਵਿੱਚ ਨਾਲ ਰੱਖਦੇ ਹੋ। ਸਾਂਝੀਆਂ ਆਦਤਾਂ ਅਤੇ ਉਨ੍ਹਾਂ ਨਾਲ ਜੁੜੀਆਂ ਚੀਜ਼ਾਂ ਤੁਹਾਡੇ ਲਈ ਬਹੁਤ ਮਾਇਨੇ ਰੱਖਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dbasz o to, by druga połówka była obecna w twojej codzienności. Wspólne rytuały i skojarzenia mają dla ciebie znaczenie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو خپل ملګری په ورځني ژوند کې له ځان سره ساتئ. ګډ عادتونه او یادونه ستاسو لپاره ژوره معنا لري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você mantém seu amor presente no dia a dia. Rituais e associações compartilhadas têm muito significado para você."
