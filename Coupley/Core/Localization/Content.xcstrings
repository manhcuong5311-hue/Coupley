    "Couple time vs social time is one of the most negotiated parts of a relationship." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوازن بين الوقت الثنائي والوقت الاجتماعي من أكثر ما يتفاوض عليه الشريكان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas jen pro vás versus čas s ostatními – o tomhle se ve vztazích vyjednává nejčastěji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid for jer to over for tid med andre er en af de ting, der forhandles mest om i et forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit zu zweit oder mit anderen – darüber wird in Beziehungen mit am meisten verhandelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρόνος για τους δυο σας απέναντι στον χρόνο με άλλους είναι από τα πιο πολυσυζητημένα θέματα σε μια σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio entre el tiempo en pareja y el tiempo con otras personas es uno de los aspectos que más se negocian en una relación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahdenkeskisen ja sosiaalisen ajan tasapaino on yksi parisuhteen eniten neuvotelluista asioista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang oras para sa isa’t isa vs oras kasama ang iba ay isa sa mga pinakamadalas pagkasunduan sa isang relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps à deux face au temps entre amis, c'est l'un des sujets les plus négociés dans un couple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמן זוגי מול זמן חברתי הוא אחד הנושאים שהכי הרבה מתנהל עליהם משא ומתן בזוגיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना साथ बनाम दोस्तों-परिवार का साथ — यह रिश्ते में सबसे ज़्यादा तय की जाने वाली बातों में से एक है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kettesben töltött és a társaságban töltött idő aránya az egyik legtöbbet egyeztetett téma egy kapcsolatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu berdua vs waktu sosial adalah salah satu hal yang paling sering dirundingkan dalam hubungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come dividere il tempo tra la coppia e gli altri è uno degli aspetti più negoziati di una relazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの時間と、人と会う時間のバランスは、カップルがいちばん話し合うテーマのひとつです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘만의 시간과 사람들과의 시간은 연애에서 가장 많이 조율하는 부분 중 하나예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masa berdua berbanding masa bersosial ialah salah satu perkara yang paling kerap dirunding dalam hubungan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid for dere to kontra tid med andre er noe av det par forhandler mest om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijd met z’n tweeën versus tijd met anderen is een van de onderdelen van een relatie waar het meest over onderhandeld wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas we dwoje kontra czas ze znajomymi to jeden z najczęściej negocjowanych tematów w związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a dois versus tempo com os outros é uma das coisas mais negociadas numa relação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpul în doi versus timpul cu alții e una dintre cele mai negociate părți ale unei relații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс между временем вдвоём и временем с другими — одна из самых обсуждаемых тем в отношениях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid för två kontra tid med andra är en av de saker par förhandlar mest om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาส่วนตัวของคู่รักกับเวลาเข้าสังคมเป็นเรื่องที่ต้องต่อรองกันบ่อยที่สุดเรื่องหนึ่งในความสัมพันธ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baş başa zaman ile sosyal zaman, bir ilişkide en çok pazarlık edilen konulardan biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час для двох проти часу з іншими — одна з тем, про яку в стосунках домовляються найчастіше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian riêng của hai người và thời gian cho bạn bè là một trong những điều hay phải thương lượng nhất trong một mối quan hệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两人时光和社交时间，是感情里最常需要商量的部分之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩人時光和社交時光怎麼分配，是感情中最常需要協調的事之一。"
          }
        }
      }
    },
