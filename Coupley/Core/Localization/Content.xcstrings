        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan pengin nyawiji kanthi wutuh. Kulawarga pasangan iku uga kulawarga panjenengan — panjenengan saestu ngrumat sesambungan kuwi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სრული ინტეგრაცია გინდა. პარტნიორის ოჯახიც შენი ოჯახია — ამ ურთიერთობებში გულწრფელად დებ ძალას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық араласқың келеді. Серігіңнің туыстары — сенің де отбасың, сол қатынастарға шын көңілмен үлес қосасың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកចង់ចូលរួមទាំងស្រុង។ គ្រួសារខាងដៃគូក៏ជាគ្រួសាររបស់អ្នកដែរ — អ្នកយកចិត្តទុកដាក់លើទំនាក់ទំនងទាំងនោះដោយស្មោះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ಸಂಪೂರ್ಣ ಒಂದಾಗುವಿಕೆ ಬೇಕು. ಸಂಗಾತಿಯ ಮನೆಯವರೂ ನಿಮ್ಮ ಕುಟುಂಬವೇ — ಆ ಸಂಬಂಧಗಳಲ್ಲಿ ನೀವು ಮನಸಾರೆ ತೊಡಗಿಸಿಕೊಳ್ಳುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전히 하나가 되고 싶어 해요. 연인의 가족도 내 가족이고, 그 관계에 진심으로 마음을 쏟아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tevlîbûna tam dixwazî. Malbata hevjînê te jî malbata te ye — tu ji dil di wan têkiliyan de veberhênan dikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толук аралашууну каалайсың. Сүйгөнүңдүн туугандары да сенин үй-бүлөң — ал мамилелерге чын дилден убакыт бөлөсүң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wëlls, datt alles zesummewiisst. D'Famill vun dengem Schatz ass och deng — an du investéiers wierklech an déi Bezéiungen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຢາກເປັນອັນໜຶ່ງອັນດຽວກັນເຕັມທີ່ ຄອບຄົວຂອງຄູ່ກໍຄືຄອບຄົວຂອງເຈົ້າ — ເຈົ້າລົງແຮງໃນຄວາມສຳພັນເຫຼົ່ານັ້ນຢ່າງຈິງໃຈ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nori visiško susiliejimo. Antrosios pusės artimieji – irgi tavo šeima, ir į tuos santykius nuoširdžiai investuoji."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gribi pilnīgu iekļaušanos. Otrās puses tuvinieki ir arī tava ģimene – šajās attiecībās tu ieguldi no sirds."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fampidirana tanteraka no tadiavinao. Fianakavianao koa ny fianakavian'ny olon-tianao — ampiasainao tokoa ny ezaka amin'ireo fifandraisana ireo."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E hiahia ana koe kia hono katoa. Ko ngā hungawai he whānau anō mōu — ka whakapau kaha pono koe ki aua hononga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сакаш целосно вклучување. Семејството на половинката е и твое семејство — искрено вложуваш во тие односи."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പൂർണമായ ഒത്തുചേരലാണ് നിങ്ങൾ ആഗ്രഹിക്കുന്നത്. പങ്കാളിയുടെ കുടുംബവും നിങ്ങളുടെ കുടുംബമാണ് — ആ ബന്ധങ്ങളിൽ നിങ്ങൾ ആത്മാർഥമായി മനസ്സർപ്പിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи бүрэн нэгдэхийг хүсдэг. Ханийнхаа гэр бүл бас чиний гэр бүл — чи тэр харилцаанд чин сэтгэлээсээ хөрөнгө оруулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला पूर्ण एकरूपता हवी. सासरची मंडळीही तुमचे कुटुंबच — त्या नात्यांमध्ये तुम्ही मनापासून गुंतवणूक करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mahu bersatu sepenuhnya. Keluarga mentua juga keluarga anda — anda ikhlas memupuk hubungan itu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trid integrazzjoni sħiħa. Il-familja tal-partner hija l-familja tiegħek ukoll — u tinvesti f'dawk ir-relazzjonijiet b'mod ġenwin."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပြည့်အဝ ပေါင်းစည်းချင်တယ်။ ချစ်သူရဲ့ မိသားစုက သင့်မိသားစုလည်း ဖြစ်တယ် — အဲဒီ ဆက်ဆံရေးတွေမှာ စိတ်ရင်းနဲ့ ရင်းနှီးမြှုပ်နှံတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil at alt skal henge sammen. Svigerfamilien er din familie også – du legger oppriktig innsats i de relasjonene."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं पूरा घुलमिल चाहनुहुन्छ। पार्टनरको परिवार पनि तपाईंकै परिवार हो — ती सम्बन्धमा तपाईं मनैदेखि लगानी गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt er helemaal bij horen. Schoonfamilie is ook jouw familie – je investeert oprecht in die banden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumafuna kulumikizana kwathunthu. Apongozi ndi achibale ndi banja lanunso — mumayika khama lenileni m'maubale amenewo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guutummaatti walitti makamuu barbaadda. Maatiin jaalallee keetiis maatii kee ti — hariiroo sana keessatti dhugumaan carraaqxa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ପୂରା ମିଶିଯିବାକୁ ଚାହାଁନ୍ତି। ସାଥୀଙ୍କ ପରିବାର ବି ଆପଣଙ୍କ ପରିବାର — ସେହି ସମ୍ପର୍କରେ ଆପଣ ସତରେ ମନ ଦିଅନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਪੂਰਾ ਮੇਲ-ਜੋਲ ਚਾਹੁੰਦੇ ਹੋ। ਪਾਰਟਨਰ ਦਾ ਪਰਿਵਾਰ ਵੀ ਤੁਹਾਡਾ ਪਰਿਵਾਰ ਹੈ — ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਰਿਸ਼ਤਿਆਂ ਵਿੱਚ ਦਿਲੋਂ ਸਮਾਂ ਅਤੇ ਪਿਆਰ ਲਾਉਂਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz pełnej integracji. Teściowie to też twoja rodzina – naprawdę inwestujesz w te relacje."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو بشپړ یوځای کېدل غواړئ. د ملګري کورنۍ هم ستاسو کورنۍ ده — تاسو په رښتیا په دې اړیکو کې پانګونه کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você quer integração total. A família do seu amor também é sua — e você investe nessas relações de verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queres integração total. A família do teu par também é tua — e investes nessas relações a sério."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrei integrare completă. Familia partenerului e și familia ta — investești sincer în aceste relații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе важно полное единство. Родные партнёра — и твоя семья тоже, и ты искренне вкладываешься в эти отношения."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushaka kwinjira mu muryango wose. Abo mu muryango w'umukunzi wawe na bo ni abawe — wita kuri iyo mibanire ubikuye ku mutima."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබට සම්පූර්ණ ඒකාබද්ධ වීමක් ඕනේ. නෑදෑයොත් ඔබේ පවුලේ අය — ඔබ ඒ සබඳතාවලට ඇත්තටම කැප වෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš úplné prepojenie. Svokrovci sú aj tvoja rodina – do týchto vzťahov úprimne investuješ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želiš si popolne povezanosti. Partnerjeva družina je tudi tvoja – v te odnose iskreno vlagaš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda kubatana kwakazara. Vatezvara nevamwe vemhuri yemudiwa wako imhuri yako futi — unoisa simba muukama ihwohwo nemwoyo wose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad rabtaa isku dhafnaan buuxda. Qoyska lammaanahaaguna waa qoyskaaga — xiriirradaas si dhab ah ayaad u maalgelisaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do integrim të plotë. Familja e partnerit është edhe familja jote – investon sinqerisht në ato marrëdhënie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Желиш потпуно повезивање. Породица твоје половине је и твоја породица — у те односе искрено улажеш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun hoyong ngahiji pinuh. Kulawarga pasangan ogé kulawarga anjeun — anjeun leres-leres ngurus hubungan éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill att allt flyter ihop. Svärfamiljen är också din familj – du lägger verklig energi på de relationerna."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unataka muungano kamili. Wakwe ni familia yako pia — unawekeza katika mahusiano hayo kwa dhati."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழுமையான இணைப்பை விரும்புகிறீர்கள். துணையின் குடும்பமும் உங்கள் குடும்பம்தான் — அந்த உறவுகளில் உண்மையாக முதலீடு செய்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు పూర్తి కలయిక కావాలి. భాగస్వామి కుటుంబం కూడా మీ కుటుంబమే — ఆ బంధాల్లో మీరు మనస్ఫూర్తిగా శ్రద్ధ పెడతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ҳамроҳшавии пурра мехоҳӣ. Хешовандони ёрат низ оилаи туанд — ту ба он муносибатҳо самимона саҳм мегузорӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากหลอมรวมเป็นหนึ่งเดียว ครอบครัวของคนรักก็คือครอบครัวของคุณ คุณทุ่มเทใจให้ความสัมพันธ์เหล่านั้นอย่างจริงใจ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምሉእ ምትእኽኻብ ትደልዩ። ስድራ መጻምድኹም ስድራኹም እዮም — ኣብቲ ርክብ ብሓቂ ትውፍሩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen doly birleşmegi isleýärsiň. Söýgüliňiň maşgalasy hem seniň maşgalaň — sen ol gatnaşyklara ýürekden goşant goşýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir kaynaşma istiyorsun. Partnerinin ailesi senin de ailen; bu ilişkilere içtenlikle emek veriyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі хочеться повної інтеграції. Родина половинки — і твоя родина теж, і ти щиро вкладаєшся в ці стосунки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو مکمل اپنائیت چاہیے۔ سسرال والے بھی آپ کا خاندان ہیں — ان رشتوں میں آپ کی محنت سچی ہوتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz toʻliq birlashishni xohlaysiz. Sherigingizning oilasi — sizning ham oilangiz, bu munosabatlarga chin dildan eʼtibor berasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn muốn hòa nhập trọn vẹn. Gia đình người ấy cũng là gia đình bạn — bạn vun đắp những mối quan hệ đó bằng cả tấm lòng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufuna ukudibana ngokupheleleyo. Izizalwane zeqabane zingusapho lwakho nawe — uzinikela ngokwenene kobo budlelwane."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ ìṣọ̀kan pátápátá. Àna yín jẹ́ ẹbí yín náà — ẹ ń fi tọkàntọkàn ṣe ìdókòwò sínú àjọṣe yẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想要完全融入。對方的家人也是你的家人，你真心投入這些關係。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你希望完全融入。对方的家人也是你的家人，你会真心经营这些关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你希望完全融入。對方的家人也是你的家人，你會真心經營這些關係。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufuna ukuhlanganiswa ngokuphelele. Abomndeni womlingani wakho bangumndeni wakho nawe — utshala kulobo budlelwano ngempela."
          }
        }
      }
    },
    "You'd rather address it head-on than let it sit. Be mindful — your partner might need space before they can engage productively." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy pak dit liewer kop-aan as om dit te laat lê. Hou in gedagte – jou maat het dalk eers ruimte nodig voordat julle sinvol kan praat."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነገሩን ከማቆየት ፊት ለፊት መጋፈጥ ይመርጣሉ። ይጠንቀቁ — አጋርዎ በአግባቡ ከመወያየታቸው በፊት ቦታ ሊያስፈልጋቸው ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفضّلون المواجهة المباشرة على ترك الأمر معلّقًا. انتبهوا إلى أن شريكك قد يحتاج إلى مساحة قبل أن يتمكن من النقاش بشكل مثمر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথা ফেলাই ৰখাতকৈ আপুনি পোনপটীয়াকৈ সমাধান কৰিব বিচাৰে। মন কৰিব — ফলপ্ৰসূভাৱে কথা পাতিব পৰাৰ আগতে আপোনাৰ সংগীক হয়তো অলপ সময় লাগে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyi yubatmaqdansa, birbaşa üzləşməyi üstün tutursan. Diqqətli ol — partnyorunun səmərəli danışmazdan əvvəl bir az məkana ehtiyacı ola bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе лепш разабрацца адразу, чым адкладаць. Але памятай: палавінцы можа спатрэбіцца час, каб размова была плённай."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочиташ да посрещнеш нещата директно, вместо да ги оставиш да висят. Имай предвид – половинката ти може да има нужда от пространство, преди да може да говори градивно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাপারটা ফেলে রাখার চেয়ে তুমি সরাসরি মোকাবিলা করতে চাও। একটু খেয়াল রেখো — ভালোভাবে কথা বলার আগে তোমার পার্টনারের হয়তো কিছুটা সময় দরকার।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije se odmah suočiš sa stvari nego da je ostaviš. Imaj na umu – voljenoj osobi možda treba prostora prije nego što može konstruktivno razgovarati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefereixes encarar-ho directament que deixar-ho estar. Tingues en compte que la teva parella pot necessitar espai abans de poder parlar-ne de manera constructiva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raději věci řešíš přímo, než je nechat ležet. Jen pozor – tvůj protějšek může potřebovat prostor, než se dokáže zapojit konstruktivně."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byddai'n well gen ti fynd i'r afael â'r peth yn uniongyrchol na'i adael. Bydd yn ystyriol — efallai bod angen lle ar dy bartner cyn gallu ymateb yn adeiladol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tager det hellere op med det samme end at lade det ligge. Vær opmærksom på, at din partner måske har brug for plads, før I kan få en god snak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sprichst Dinge lieber direkt an, statt sie liegen zu lassen. Denk daran: Dein Schatz braucht vielleicht erst etwas Abstand, um konstruktiv reden zu können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτιμάς να το αντιμετωπίσεις κατά μέτωπο παρά να το αφήσεις να σέρνεται. Έχε στο μυαλό σου ότι το ταίρι σου ίσως χρειάζεται χώρο πριν μπορέσει να το συζητήσει εποικοδομητικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefieres afrontarlo de frente antes que dejarlo estar. Tenlo en cuenta: puede que tu pareja necesite espacio antes de poder hablar de forma constructiva."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa võtad asja pigem kohe käsile, kui lased sel seista. Pea meeles — partner võib vajada ruumi, enne kui suudab asjalikult kaasa rääkida."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahiago duzu gaiari zuzenean heldu, bere horretan utzi baino. Kontuz — zure bikotekideak tartea behar izan dezake modu lasaian hitz egin aurretik."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجیح می‌دهی رک سراغش بروی تا اینکه بماند. حواست باشد — شاید پارتنرت قبل از یک گفتگوی سازنده به کمی فضا نیاز داشته باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartut asiaan mieluummin suoraan kuin annat sen hautua. Muista kuitenkin, että kumppanisi saattaa tarvita tilaa ennen kuin pystyy keskustelemaan rakentavasti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas gusto mong harapin ito agad kaysa patagalin. Tandaan lang — baka kailangan muna ng partner mo ng espasyo bago siya makapag-usap nang maayos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu préfères affronter le problème de face plutôt que le laisser traîner. Attention : l'autre a peut-être besoin d'espace avant de pouvoir en discuter sereinement."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B'fhearr leat dul i ngleic leis go díreach ná é a fhágáil ina luí. Bí aireach — b'fhéidir go mbeadh spás de dhíth ar do pháirtí sular féidir comhrá fiúntach a bheith agaibh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefires afrontalo de cara a deixalo estar. Pero ten en conta que a túa parella pode precisar espazo antes de poder falar de forma construtiva."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાતને પડી રહેવા દેવા કરતાં તમે સીધો સામનો કરવાનું પસંદ કરો છો. ધ્યાન રાખજો — સારી રીતે વાત કરી શકે એ પહેલાં તમારા પાર્ટનરને થોડી મોકળાશ જોઈતી હોય."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gara ku fuskanci lamarin kai tsaye da ku bar shi. Ku yi hankali — ƙila abokin zamanku na buƙatar sarari kafin a iya tattaunawa mai amfani."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיף לך להתמודד עם זה חזיתית מאשר להשאיר את זה באוויר. רק כדאי לשים לב — ייתכן שהצד השני צריך מרחב לפני שאפשר לנהל שיחה טובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात को टालने के बजाय आप उसका सीधे सामना करना पसंद करते हैं। बस ध्यान रखें — हो सकता है कि अच्छे से बात करने से पहले पार्टनर को थोड़ी जगह चाहिए हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije se s tim suočiš odmah nego da stvar čeka. Imaj na umu – voljenoj osobi možda treba prostora prije nego što može konstruktivno razgovarati."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pito fè fas ak sa dirèkteman pase kite l trennen. Men fè atansyon — patnè ou ka bezwen espas anvan li ka pale nan yon fason ki itil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább szembenézel vele, mint hogy hagyd ülepedni. Csak figyelj – lehet, hogy a párodnak előbb térre van szüksége, hogy építően tudjon beszélni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նախընտրում ես խնդրին դեմ առ դեմ նայել, քան թողնել, որ ձգձգվի։ Ուշադիր եղիր՝ զուգընկերոջդ գուցե ժամանակ պետք լինի, որ կարողանա արդյունավետ զրուցել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lebih suka menghadapinya langsung daripada membiarkannya. Tapi ingat — pasanganmu mungkin butuh ruang dulu sebelum bisa ngobrol dengan baik."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ ka mma gị ịchọ ya ihu na ihu karịa ịhapụ ya. Kpachara anya — onye gị nwere ike ịchọ oghere tupu o nwee ike ikwu okwu nke ọma."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú vilt frekar takast á við málið beint en láta það liggja. Hafðu í huga að makinn þinn gæti þurft rými áður en hægt er að ræða málin á uppbyggilegan hátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci affrontare le cose di petto piuttosto che lasciarle in sospeso. Ricorda però che il tuo partner potrebbe aver bisogno di spazio prima di riuscire a confrontarsi in modo costruttivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放っておくより、正面から向き合いたいタイプです。ただ、パートナーは前向きに話せるようになるまで時間が必要かもしれません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan luwih seneng ngadhepi langsung tinimbang ngendhapake. Elinga — pasangan bisa uga butuh wektu dhisik sadurunge bisa ngrembug kanthi apik."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გირჩევნია, საკითხს პირდაპირ შეხვდე, ვიდრე გადადო. გაითვალისწინე — პარტნიორს შეიძლება სივრცე სჭირდებოდეს, სანამ ნაყოფიერად ჩაერთვება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іште сақтағаннан гөрі тура айтқанды жөн көресің. Абай бол — серігің сындарлы сөйлесу үшін алдымен оңаша қалуы керек болуы мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកចូលចិត្តដោះស្រាយត្រង់ៗ ជាជាងទុកវាចោល។ គួរប្រុងប្រយ័ត្ន — ដៃគូរបស់អ្នកប្រហែលត្រូវការពេលខ្លះ មុននឹងអាចនិយាយគ្នាបានល្អ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಿಷಯವನ್ನು ಹಾಗೇ ಬಿಡುವ ಬದಲು ನೇರವಾಗಿ ಎದುರಿಸುವುದು ನಿಮಗಿಷ್ಟ. ಗಮನವಿರಲಿ — ಸರಿಯಾಗಿ ಮಾತನಾಡಲು ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ಮೊದಲು ಸ್ವಲ್ಪ ಸಮಯ ಬೇಕಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "묵혀 두기보다 정면으로 마주하는 편이에요. 다만 연인은 차분하게 대화하기 전에 시간이 필요할 수도 있다는 걸 기억해 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tercîh dikî rasterast pê re mijûl bibî, ne ku wê bihêlî. Hişyar be — dibe ku hevjînê te berî ku bi awayekî berhemdar beşdar bibe, hewceyî cih be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маселени созбой, түз эле чечкенди артык көрөсүң. Бирок эсиңде болсун — сүйгөнүңө пайдалуу сүйлөшүүдөн мурун бир аз убакыт керек болушу мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du packs et léiwer direkt un, wéi et leien ze loossen. Pass awer op — däi Schatz brauch vläicht fir d'éischt Raum, éier e gutt Gespréich méiglech ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຢາກປະເຊີນໜ້າກັບບັນຫາຫຼາຍກວ່າປ່ອຍມັນຄ້າງໄວ້ ແຕ່ລະວັງ — ຄູ່ຂອງເຈົ້າອາດຕ້ອງການເວລາກ່ອນຈະລົມກັນໄດ້ຢ່າງສ້າງສັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mieliau spręsti iškart, nei leisti reikalui tįsti. Tik atmink – antrajai pusei gali prireikti erdvės, kad galėtų kalbėtis konstruktyviai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu labāk risini lietas tieši, nekā ļauj tām gulēt. Tikai paturi prātā – otrajai pusei var vajadzēt laiku, pirms saruna kļūst auglīga."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleonao miatrika izany mivantana toy izay avela hipetraka. Mitandrema — mety mila fotoana kely ny olon-tianao vao afaka miresaka amin'ny fomba mahasoa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pai ake ki a koe te whakatika hāngai i te waiho. Kia mataara — tērā pea me whai wā tō hoa aroha i mua i te kōrero whai hua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повеќе сакаш да се соочиш директно отколку да оставиш да виси. Внимавај — на половинката можеби ѝ треба простор пред да може конструктивно да разговара."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കാര്യം നീട്ടിവെക്കുന്നതിനെക്കാൾ നേരിട്ട് കൈകാര്യം ചെയ്യാനാണ് നിങ്ങൾക്കിഷ്ടം. ഒന്ന് ശ്രദ്ധിക്കൂ — നല്ല രീതിയിൽ സംസാരിക്കാൻ കഴിയും മുമ്പ് പങ്കാളിക്ക് അൽപം ഇടം വേണ്ടിവന്നേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи асуудлыг орхихоос илүү шууд нүүр тулахыг илүүд үздэг. Анхаараарай — хань чинь үр дүнтэй ярилцахаасаа өмнө зай хэрэгтэй байж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गोष्ट रेंगाळू देण्यापेक्षा तुम्हाला ती थेट हाताळायला आवडते. फक्त लक्षात ठेवा — नीट बोलू शकण्याआधी जोडीदाराला थोडी जागा हवी असू शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda lebih suka menghadapinya terus daripada membiarkannya. Berhati-hati — pasangan anda mungkin perlukan ruang sebelum boleh berbincang dengan baik."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippreferi tħabbat wiċċek magħha milli tħalliha għaddejja. Iżda ftakar — il-partner tiegħek jista' jkollu bżonn ftit spazju qabel konversazzjoni produttiva."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပစ်ထားတာထက် တိုက်ရိုက် ရင်ဆိုင်ဖြေရှင်းတာကို သင် ပိုကြိုက်တယ်။ သတိထားပါ — ချစ်သူက အကျိုးရှိရှိ ပြောဆိုနိုင်ဖို့ အရင် အချိန်ယူဖို့ လိုနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar det heller opp direkte enn å la det ligge. Vær obs – partneren din kan trenge litt rom før samtalen blir konstruktiv."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुरा थाती राख्नुभन्दा तपाईं सिधै सामना गर्न रुचाउनुहुन्छ। ख्याल राख्नुहोस् — राम्रोसँग कुरा गर्नुअघि तपाईंको पार्टनरलाई केही समय चाहिन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij pakt het liever direct aan dan dat je het laat liggen. Let wel op – je partner heeft misschien eerst ruimte nodig om er constructief over te kunnen praten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakonda kulimbana nazo maso ndi maso kuposa kuzisiya. Samalani — wokondedwa wanu angafunike mpata asanakambirane bwino."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhimma dhiisuu mannaa fuula itti kennitee furuu filatta. Of eeggadhu — bu'a qabeessaan haasa'uu dura jaalallee keetiif yeroon barbaachisuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଥାକୁ ପଡ଼ି ରହିବାକୁ ନ ଦେଇ ଆପଣ ସିଧା ସାମ୍ନା କରିବାକୁ ଚାହାଁନ୍ତି। ଧ୍ୟାନ ରଖନ୍ତୁ — ଭଲ ଭାବେ କଥା ହେବା ଆଗରୁ ଆପଣଙ୍କ ସାଥୀଙ୍କୁ ହୁଏତ ଟିକେ ସମୟ ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਗੱਲ ਨੂੰ ਲਟਕਾਉਣ ਦੀ ਥਾਂ ਸਿੱਧਾ ਸਾਹਮਣਾ ਕਰਨਾ ਪਸੰਦ ਕਰਦੇ ਹੋ। ਧਿਆਨ ਰੱਖੋ — ਹੋ ਸਕਦਾ ਹੈ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾਂ ਗੱਲ ਕਰ ਸਕਣ ਤੋਂ ਪਹਿਲਾਂ ਥੋੜ੍ਹੀ ਥਾਂ ਚਾਹੀਦੀ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolisz zmierzyć się z problemem od razu, niż go odkładać. Pamiętaj tylko, że druga połówka może potrzebować chwili, zanim będzie w stanie konstruktywnie rozmawiać."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو غوره ګڼئ چې ستونزې ته مخامخ ورشئ، نه دا چې پرېږدئ یې. پام کوئ — ښايي ستاسو ملګری له ګټورو خبرو مخکې لږ ځای ته اړتیا ولري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você prefere encarar de frente a deixar para depois. Só tenha cuidado — seu amor pode precisar de um tempo antes de conseguir conversar bem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferes enfrentar a questão de frente a deixá-la arrastar-se. Atenção — o teu par pode precisar de espaço antes de conseguir conversar de forma construtiva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferi să iei problema în piept decât s-o lași să stagneze. Ai grijă însă — partenerul tău ar putea avea nevoie de spațiu înainte să poată discuta constructiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе проще решить вопрос в лоб, чем откладывать. Но помни: партнёру может понадобиться пауза, прежде чем разговор станет конструктивным."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahitamo guhangana n'ikibazo imbonankubone aho kukireka. Gusa witonde — umukunzi wawe ashobora gukenera umwanya mbere yo kuganira neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දේවල් එහෙමම තියනවාට වඩා කෙළින්ම මුහුණ දෙන්න ඔබ කැමතියි. ඒත් සැලකිලිමත් වෙන්න — හොඳින් කතා කරන්න කලින් ඔබේ සහකරුට ඉඩක් ඕනේ වෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radšej to riešiš priamo, než to nechať tak. Len pamätaj – tvoja polovička môže potrebovať priestor, než bude schopná rozumne debatovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raje se stvari lotiš naravnost, kot da jih pustiš čakati. Pazi – tvoj partner morda potrebuje prostor, preden se lahko pogovarja konstruktivno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda kubata nyaya zvakananga pane kuirega yakamira. Chenjera — mudiwa wako angada nguva asati akwanisa kutaura zvinobatsira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad door bidaysaa inaad si toos ah wax uga qabato intaad iska dayn lahayd. Feejignow — lammaanahaagu waxa laga yaabaa inuu u baahdo meel ka hor intaanu si wax ku ool ah u hadlin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferon ta trajtosh ballazi sesa ta lësh pezull. Ki parasysh – partneri yt mund të ketë nevojë për hapësirë para se të përfshihet në mënyrë të frytshme."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радије ћеш се суочити одмах него оставити да стоји. Само имај на уму — твојој половини можда треба простора пре него што може конструктивно да разговара."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun langkung milih nyanghareupan langsung tibatan ngantep ngendap. Émut — pasangan anjeun panginten peryogi rohangan heula sateuacan tiasa ngobrol kalayan saé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar hellre tag i det direkt än låter det ligga. Tänk på att din partner kanske behöver utrymme innan ni kan prata konstruktivt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungependa kulikabili jambo moja kwa moja kuliko kuliacha likae. Kuwa makini — huenda mwenzi wako anahitaji nafasi kabla ya kuweza kuzungumza kwa tija."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விஷயத்தைக் கிடப்பில் போடாமல் நேரடியாக எதிர்கொள்ள விரும்புகிறீர்கள். கவனமாக இருங்கள் — பயனுள்ள விதத்தில் பேசுவதற்கு முன் உங்கள் துணைக்குச் சற்று இடம் தேவைப்படலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విషయాన్ని నానబెట్టడం కంటే నేరుగా ఎదుర్కోవడమే మీకు ఇష్టం. ఒక్క విషయం గుర్తుంచుకోండి — మీ భాగస్వామి సరిగ్గా మాట్లాడే ముందు వారికి కాస్త సమయం కావాలేమో."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту беҳтар мешуморӣ, ки масъаларо рӯирост ҳал кунӣ, на он ки бимонад. Эҳтиёт бош — шояд ёрат пеш аз сӯҳбати созанда ба фазо ниёз дошта бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากเผชิญหน้ากับปัญหามากกว่าปล่อยค้างไว้ แต่ลองนึกด้วยว่าคนรักอาจต้องการพื้นที่ก่อนจะคุยกันได้อย่างสร้างสรรค์"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ገዲፍኩም ካብ ምጽናሕ ብቐጥታ ክትገጥምዎ ትመርጹ። ተጠንቀቑ — መጻምድኹም ብጽቡቕ ክሳተፉ ቅድሚኡ ቦታ የድልዮም ይኸውን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen meseläni goýup goýmakdan, gönüden-göni çözmegi makul bilýärsiň. Ünsli bol — peýdaly gürleşmek üçin söýgüliňe ilki rahatlanmak gerek bolup biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyi bekletmek yerine doğrudan ele almayı tercih ediyorsun. Dikkat et; partnerinin verimli konuşabilmek için önce alana ihtiyacı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі краще розібратися прямо, ніж відкладати. Але зважай: половинці може знадобитися час, щоб говорити конструктивно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بات کو لٹکانے کے بجائے سیدھا سامنے لانا آپ کو زیادہ ٹھیک لگتا ہے۔ دھیان رکھیں — ہو سکتا ہے آپ کے ساتھی کو اچھی بات چیت سے پہلے کچھ وقت درکار ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muammoni kechiktirmay, yuzma-yuz hal qilishni afzal koʻrasiz. Ehtiyot boʻling — samarali suhbatdan oldin sherigingizga biroz vaqt kerak boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thích đối mặt trực tiếp hơn là để mọi chuyện treo đó. Nhưng hãy lưu ý — người ấy có thể cần chút không gian trước khi trò chuyện một cách xây dựng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhetha ukujongana nayo ngqo kunokuyiyeka ihlale. Lumka — iqabane lakho linokudinga isithuba phambi kokuba likwazi ukuthetha ngendlela eyakhayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ràn láti kojú rẹ̀ ní tààrà ju kí ẹ fi sílẹ̀ lọ. Ẹ ṣọ́ra — olólùfẹ́ yín lè nílò àyè kí ó tó lè sọ̀rọ̀ lọ́nà tó wúlò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願正面處理，也不想把事情擱著。不過要留意，另一半可能需要一點空間，才能好好溝通。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起放着不管，你更愿意直面问题。但要留意——另一半可能需要先冷静一下，才能好好沟通。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願正面處理，也不想把事情擱著。不過要留意，另一半可能需要一點空間，才能好好溝通。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungathanda ukubhekana nakho ngqo kunokukuyeka kuhlale. Qaphela — umlingani wakho angadinga isikhala ngaphambi kokuthi akwazi ukukhuluma kahle."
          }
        }
      }
    },
    "You'd rather hear something hard than be managed with comfortable half-truths. Radical honesty is both your standard and your offer." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy hoor eerder iets moeiliks as om met gemaklike halwe waarhede hanteer te word. Radikale eerlikheid is jou standaard én wat jy self bied."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሚመቹ ግማሽ እውነቶች ከመያዝ ከባድ ነገር መስማትን ይመርጣሉ። ሙሉ ታማኝነት የሚጠብቁትም የሚሰጡትም ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سماع الحقيقة الصعبة أفضل عندك من أنصاف الحقائق المريحة. الصدق التام معيارك وما تقدّمه أيضًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আৰামদায়ক আধা-সত্যৰে আপোনাক ভুলাই ৰখাতকৈ আপুনি কঠিন কথা শুনিবলৈ বেছি পছন্দ কৰে। সম্পূৰ্ণ সততা আপোনাৰ মাপকাঠি আৰু আপোনাৰ দানো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat yarımhəqiqətlərlə idarə olunmaqdansa, çətin bir şeyi eşitməyi üstün tutursan. Tam dürüstlük həm sənin standartın, həm də təklifindir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе лепш пачуць нешта цяжкае, чым каб цябе суцяшалі зручнай паўпраўдай. Радыкальная шчырасць — і тваё патрабаванне, і тое, што ты прапануеш у адказ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочиташ да чуеш нещо трудно, отколкото да те успокояват с удобни полуистини. Пълната честност е и твоят стандарт, и това, което предлагаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরামদায়ক আধা-সত্য দিয়ে সামলানোর চেয়ে তুমি কঠিন কথা শুনতে বেশি পছন্দ করো। পুরোপুরি সততা তোমার চাওয়া, আর তোমার দেওয়াও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije ćeš čuti nešto teško nego da te tješe ugodnim poluistinama. Potpuna iskrenost ti je i mjerilo i ono što nudiš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefereixes sentir una cosa dura que no pas que et gestionin amb mitges veritats còmodes. La sinceritat radical és alhora el que demanes i el que ofereixes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radši slyšíš něco těžkého, než aby tě někdo konejšil pohodlnými polopravdami. Radikální upřímnost je tvůj standard i to, co nabízíš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byddai'n well gen ti glywed rhywbeth anodd na chael dy drin â hanner gwirioneddau cyfforddus. Gonestrwydd llwyr yw dy safon a'r hyn rwyt ti'n ei gynnig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil hellere høre noget svært end blive håndteret med behagelige halve sandheder. Radikal ærlighed er både dit krav og dit tilbud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hörst lieber etwas Schweres, als mit bequemen Halbwahrheiten abgespeist zu werden. Radikale Ehrlichkeit ist dein Anspruch und dein Angebot."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτιμάς να ακούσεις κάτι δύσκολο παρά να σε χειρίζονται με βολικές μισές αλήθειες. Η απόλυτη ειλικρίνεια είναι και το μέτρο σου και αυτό που προσφέρεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefieres oír algo duro a que te manejen con medias verdades cómodas. La sinceridad total es lo que exiges y lo que ofreces."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pigem kuuled midagi rasket, kui et sind mugavate pooltõdedega ohjatakse. Täielik ausus on nii sinu nõudmine kui ka pakkumine."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahiago duzu zerbait gogorra entzun, egia-erdi erosoekin manipulatua izan baino. Zintzotasun erradikala da zure exijentzia, eta baita zure eskaintza ere."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجیح می‌دهی حرف سختی بشنوی تا اینکه با نیمه‌حقیقت‌های راحت سرت را گرم کنند. صداقت کامل، هم معیار توست و هم چیزی که می‌دهی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulet mieluummin jotain vaikeaa kuin että sinua hoidellaan mukavilla puolitotuuksilla. Ehdoton rehellisyys on sekä vaatimuksesi että lupauksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas gusto mong marinig ang masakit kaysa aluin ng komportableng kalahating-totoo. Ang buong katapatan ang pamantayan mo at ang iniaalok mo rin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu préfères entendre quelque chose de dur plutôt qu'on te ménage avec des demi-vérités confortables. L'honnêteté totale, c'est à la fois ton exigence et ce que tu offres."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B’fhearr leat rud crua a chloisteáil ná go ndéileálfaí leat le leathfhírinní compordacha. Is é an t-ionracas iomlán an caighdeán atá agat agus an rud a thairgeann tú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefires escoitar algo duro a que te xestionen con medias verdades cómodas. A sinceridade radical é á vez o que esixes e o que ofreces."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આરામદાયક અડધાં સત્યોથી બહેલાવવામાં આવે એના કરતાં તમને કડવું સાંભળવું વધુ ગમે. પૂરી પ્રામાણિકતા તમારો માપદંડ પણ છે અને તમારું વચન પણ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gara ku ji abu mai wuya da a lallaɓa ku da rabin gaskiya mai daɗi. Cikakkiyar gaskiya ita ce mizaninku kuma ita ce abin da kuke bayarwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיף לך לשמוע משהו קשה מאשר שינהלו אותך בחצאי אמיתות נוחות. כנות רדיקלית היא גם הסטנדרט שלך וגם מה שיש לך להציע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरामदेह आधे-सच से बेहतर आपके लिए कोई कड़वी बात सुनना है। पूरी ईमानदारी आपका पैमाना भी है और आपका वादा भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije ćeš čuti nešto teško nego da te netko smiruje ugodnim poluistinama. Potpuna iskrenost i tvoj je standard i tvoja ponuda."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pito tande yon bagay ki di pase pou yo jere ou ak demi-verite ki konfòtab. Onètete total se nòm ou ak sa ou ofri."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkább hallasz valami nehezet, mint hogy kényelmes féligazságokkal kezeljenek. A teljes őszinteség a mércéd, és ezt is kínálod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նախընտրում ես լսել դժվար ճշմարտությունը, քան հարմար կիսաճշմարտություններ։ Կատարյալ ազնվությունը և՛ քո պահանջն է, և՛ քո խոստումը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lebih memilih mendengar hal pahit daripada dihibur dengan setengah kebenaran yang nyaman. Kejujuran total adalah standarmu sekaligus yang kamu berikan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ ka mma gị ịnụ ihe siri ike karịa ka e jiri ọkara eziokwu na-atọ ụtọ jikwaa gị. Eziokwu zuru oke bụ ihe ị chọrọ na ihe ị na-enye."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú vilt frekar heyra eitthvað erfitt en að fá þægilegan hálfsannleika. Algjör heiðarleiki er bæði krafan þín og það sem þú býður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci sentirti dire una cosa dura piuttosto che ricevere comode mezze verità. L’onestà totale è la tua regola e la tua promessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳ざわりのいい中途半端な真実でごまかされるより、つらいことでもはっきり聞きたい人です。とことん正直であることは、相手に求めることであり、自分が差し出すものでもあります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan luwih seneng krungu sing abot tinimbang dilipur nganggo setengah bebener sing kepenak. Jujur tenan iku ukuran sing panjenengan jaluk lan uga sing panjenengan wenehake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გირჩევნია, რთული რამ მოისმინო, ვიდრე კომფორტული ნახევარსიმართლეებით დაგამშვიდონ. რადიკალური გულწრფელობა შენი სტანდარტიცაა და შენი შეთავაზებაც."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жайлы жарты шындықпен алдарқатқаннан гөрі ауыр нәрсені естігенді жөн көресің. Түбегейлі адалдық — сенің де талабың, сенің де ұсынысың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកសុខចិត្តឮរឿងពិបាក ជាជាងត្រូវគេលួងលោមដោយការពិតពាក់កណ្ដាលដែលស្ដាប់ទៅស្រួល។ ភាពស្មោះត្រង់ទាំងស្រុងគឺជាស្តង់ដាររបស់អ្នក និងជាអ្វីដែលអ្នកផ្ដល់ឲ្យ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಮಾಧಾನಕ್ಕಾಗಿ ಹೇಳುವ ಅರ್ಧಸತ್ಯಗಳಿಗಿಂತ ಕಹಿಯಾದ ಸತ್ಯ ಕೇಳುವುದೇ ನಿಮಗಿಷ್ಟ. ಸಂಪೂರ್ಣ ಪ್ರಾಮಾಣಿಕತೆಯೇ ನೀವು ಬಯಸುವುದು, ಮತ್ತು ನೀವು ಕೊಡುವುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 좋은 반쪽짜리 진실보다 힘든 말을 듣는 게 나아요. 철저한 정직함은 상대에게 바라는 기준이자 스스로 지키는 약속이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tercîh dikî ku tiştekî zor bibihîzî, ne ku bi nîvrastiyên rehet were birêvebirin. Rastgoyiya bê şert hem pîvana te ye hem jî ya ku tu pêşkêş dikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жагымдуу жарым-жартылай чындыктар менен «башкарылгандан» көрө оор нерсени уккуң келет. Толук чынчылдык — сенин талабың да, сунушуң да."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du héiers léiwer eppes Schwéieres, wéi mat bequeemen Hallefwourechten ofgespeist ze ginn. Radikal Éierlechkeet ass däi Moossstaf an däin Ugebuet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຍອມຟັງຄວາມຈິງທີ່ເຈັບ ດີກວ່າຖືກປອບດ້ວຍຄວາມຈິງເຄິ່ງດຽວ ຄວາມຊື່ສັດແບບເຕັມຮ້ອຍເປັນທັງມາດຕະຖານຂອງເຈົ້າ ແລະ ສິ່ງທີ່ເຈົ້າມອບໃຫ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verčiau išgirsti sunkią tiesą nei patogias pustiesas. Visiškas atvirumas – ir tavo reikalavimas, ir tavo pasiūlymas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu labāk dzirdi kaut ko grūtu, nekā saņem ērtas puspatiesības. Radikāls godīgums ir gan tava prasība, gan tavs piedāvājums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleonao mandre zavatra sarotra toy izay ho voafehy amin'ny antsasa-pahamarinana mampionona. Ny fahatsorana tanteraka no fenitrao sady tolotrao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pai ake ki a koe te rongo i tētahi mea uaua i te whakahaerehia ki ngā hāwhe-pono whakamāmā. Ko te pono tūturu tō paerewa, ko tāu hoki e tuku ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повеќе сакаш да слушнеш нешто тешко отколку да те смируваат со удобни полувистини. Радикалната искреност е и твој стандард и твоја понуда."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സുഖകരമായ അർധസത്യങ്ങൾ കൊണ്ട് കൈകാര്യം ചെയ്യപ്പെടുന്നതിനേക്കാൾ, കഠിനമായ ഒരു സത്യം കേൾക്കാനാണ് നിങ്ങൾക്കിഷ്ടം. പൂർണ സത്യസന്ധത നിങ്ങളുടെ നിലവാരവും നിങ്ങൾ നൽകുന്ന വാഗ്ദാനവുമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тухтай хагас үнэнээр зохицуулуулснаас хэцүү зүйл сонссон нь дээр. Туйлын шударга байдал бол чиний шаардлага ч, санал болгох зүйл ч."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोयीच्या अर्धसत्यांनी सांभाळले जाण्यापेक्षा कठीण सत्य ऐकणे तुम्हाला पसंत आहे. पूर्ण प्रामाणिकपणा ही तुमची अपेक्षाही आहे आणि तुमची देणगीही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda lebih rela mendengar sesuatu yang pahit daripada dipujuk dengan separuh kebenaran yang menyenangkan. Kejujuran sepenuhnya ialah apa yang anda tuntut dan juga apa yang anda berikan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippreferi tisma' xi ħaġa iebsa milli jimmaniġġjawk b'nofs veritajiet komdi. L-onestà radikali hija kemm l-istandard tiegħek kif ukoll dak li toffri."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နားထောင်ကောင်းတဲ့ အမှန်တစ်ဝက်တွေနဲ့ ချော့မော့ခံရတာထက် ခက်ခဲတဲ့ အမှန်ကို ကြားရတာ ပိုကောင်းတယ်။ အပြည့်အဝ ရိုးသားမှုက သင့်စံနှုန်းလည်း ဖြစ်သလို သင်ပေးတဲ့ ကတိလည်း ဖြစ်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil heller høre noe vondt enn å bli håndtert med behagelige halvsannheter. Full ærlighet er både det du krever og det du gir."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सजिलो लाग्ने आधा सत्यले बहलाइनुभन्दा कडा कुरा सुन्नु तपाईंलाई ठिक लाग्छ। पूर्ण इमानदारी तपाईंको मापदण्ड पनि हो, र तपाईंले दिने कुरा पनि।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoort liever iets moeilijks dan dat je gesust wordt met fijne halve waarheden. Radicale eerlijkheid is zowel wat je verwacht als wat je biedt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mungakonde kumva chinthu chovuta kuposa kusangalatsidwa ndi theka la choonadi. Kuona mtima kwathunthu ndi muyeso wanu komanso zomwe mumapereka."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walakkaa dhugaa mijataadhaan to'atamuu caalaa waan ulfaataa dhaga'uu filatta. Dhugummaan guutuun ulaagaa kee fi kennaa kee lamaan isaanii ti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆରାମଦାୟକ ଅଧା-ସତ୍ୟରେ ଭୁଲାଇ ରଖିବା ଅପେକ୍ଷା ଆପଣ କଠିନ କଥା ଶୁଣିବାକୁ ପସନ୍ଦ କରନ୍ତି। ପୂରା ସଚ୍ଚୋଟତା ଆପଣଙ୍କ ମାପକାଠି ବି, ଆଉ ଆପଣଙ୍କ ଦେବାର କଥା ବି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਮਿੱਠੇ ਅੱਧ-ਸੱਚਾਂ ਨਾਲ ਪਰਚਾਏ ਜਾਣ ਨਾਲੋਂ ਔਖੀ ਗੱਲ ਸੁਣਨਾ ਪਸੰਦ ਕਰਦੇ ਹੋ। ਪੂਰੀ ਇਮਾਨਦਾਰੀ ਤੁਹਾਡਾ ਮਿਆਰ ਵੀ ਹੈ ਅਤੇ ਤੁਹਾਡਾ ਵਾਅਦਾ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolisz usłyszeć coś trudnego niż wygodne półprawdy. Radykalna szczerość to twój standard i to, co dajesz w zamian."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو غوره ګڼئ چې سخته خبره واورئ، نه دا چې په خوږو نیمګړو رښتیاوو اداره شئ. بشپړ صداقت ستاسو معیار هم دی او ستاسو وړاندیز هم."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você prefere ouvir algo difícil a receber meias-verdades confortáveis. Sinceridade total é o que você exige e o que oferece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferes ouvir algo difícil a ser gerido com meias-verdades confortáveis. A honestidade total é a tua exigência e a tua oferta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferi să auzi ceva greu decât să te menajeze cineva cu jumătăți de adevăr comode. Sinceritatea radicală e atât standardul tău, cât și ce oferi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе лучше услышать что-то тяжёлое, чем утешительную полуправду. Полная честность — и твоё требование, и то, что ты даёшь взамен."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahitamo kumva ikintu kigoye aho kugushukisha ukuri kw'igice koroshye. Ukuri kuzuye ni cyo usaba kandi ni cyo utanga."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැනසිලිදායක අර්ධ සත්‍යවලින් ඔබව හසුරුවනවාට වඩා, අමාරු දෙයක් අහන්න ඔබ කැමතියි. මුළුමනින්ම අවංක වීම ඔබේ ප්‍රමිතියත් ඔබ දෙන දෙයත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radšej počuješ niečo ťažké, než aby ťa niekto chlácholil pohodlnými polopravdami. Absolútna úprimnosť je tvoj štandard aj tvoja ponuka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raje slišiš nekaj težkega, kot da te kdo miri s prijetnimi polresnicami. Radikalna iskrenost je tvoje merilo in tvoja ponudba."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda kunzwa chinhu chakaoma pane kunyaradzwa nehafu dzechokwadi. Kutendeka kwakazara ndiko kwaunotarisira uye ndiko kwaunopa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad door bidaysaa inaad maqasho wax adag intii lagugu maarayn lahaa runo badh ah oo raaxo leh. Daacadnimo buuxda waa heerka aad rabto iyo waxa aad bixisoba."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më mirë dëgjon diçka të vështirë sesa të trajtojnë me gjysmë të vërteta të rehatshme. Sinqeriteti i plotë është edhe standardi yt, edhe ajo që ofron."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радије ћеш чути нешто тешко него да те неко умирује удобним полуистинама. Потпуна искреност је и твој стандард и оно што нудиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun langkung resep ngadangu hal anu hésé tibatan dibéré satengah kaleresan anu ngeunah. Kajujuran pinuh téh standar anjeun sareng ogé anu ku anjeun dipasihkeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill hellre höra något jobbigt än bli hanterad med bekväma halvsanningar. Total ärlighet är både vad du kräver och vad du erbjuder."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungependa kusikia jambo gumu kuliko kubembelezwa kwa nusu-ukweli wa kufariji. Ukweli kamili ndio kiwango chako na ndicho unachotoa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வசதியான அரை உண்மைகளால் சமாளிக்கப்படுவதைவிட, கடினமானதைக் கேட்பதையே விரும்புவீர்கள். முழுமையான நேர்மை உங்கள் தரமும், நீங்கள் தருவதும் கூட."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సౌకర్యవంతమైన అర్ధసత్యాలతో మిమ్మల్ని సముదాయించడం కన్నా, కఠినమైన నిజం వినడమే మీకు ఇష్టం. పూర్తి నిజాయితీ మీరు కోరేదీ, మీరు ఇచ్చేదీ."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту беҳтар чизи душворро мешунавӣ, то ки туро бо нимҳақиқатҳои роҳат идора кунанд. Ростқавлии комил ҳам талаби ту ва ҳам пешниҳоди туст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยากได้ยินความจริงที่ฟังยาก มากกว่าถูกปลอบด้วยความจริงครึ่งๆ กลางๆ ความจริงใจแบบสุดทางคือทั้งมาตรฐานและสิ่งที่คุณมอบให้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብምቹእ ፍርቂ-ሓቅታት ካብ እትምርሑ፣ ከቢድ ነገር ምስማዕ ትመርጹ። ምሉእ ቅንዕና ደረጃኹምን እትህብዎን እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýakymly ýarym hakykatlar bilen köşeşdirilenden, kyn bir zady eşitmegi gowy görýärsiň. Doly dogruçyllyk hem seniň talabyň, hem seniň berýän zadyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatlatıcı yarım gerçeklerle idare edilmektense zor bir şey duymayı tercih edersin. Sonuna kadar dürüstlük hem beklediğin hem de verdiğin şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі краще почути щось важке, ніж отримувати зручні напівправди. Радикальна чесність — і твій стандарт, і те, що ти пропонуєш натомість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آرام دہ آدھے سچ سے بہلائے جانے سے بہتر آپ کے لیے کڑوی بات سننا ہے۔ کھری سچائی آپ کا معیار بھی ہے اور آپ کی پیشکش بھی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qulay yarim haqiqatlardan koʻra ogʻir haqiqatni eshitishni afzal koʻrasiz. Mutlaq halollik — ham talabingiz, ham vaʼdangiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thà nghe điều khó nghe còn hơn được xoa dịu bằng những nửa sự thật dễ chịu. Trung thực tuyệt đối vừa là tiêu chuẩn vừa là điều bạn trao đi."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungakhetha ukuva into enzima kunokuba ulawulwe ngeenyaniso-nxenye ezithuthuzelayo. Ukunyaniseka okupheleleyo ngumgangatho wakho kwaye yinto oyinikayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ràn láti gbọ́ ohun tó le ju kí wọ́n fi ààbọ̀ òtítọ́ tó rọrùn tù yín lójú. Òtítọ́ pátápátá ni ìlànà yín, òun náà sì ni ẹ̀bùn yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願聽難聽的真話，也不要被舒服的半真半假敷衍。徹底的誠實，既是你的標準，也是你的承諾。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你宁愿听到难听的真话，也不想被舒服的半真半假敷衍。彻底的诚实，是你的标准，也是你的承诺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寧願聽到難聽的真話，也不想被舒服的半真半假安撫。徹底的誠實，是你的標準，也是你給出的承諾。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungancamela ukuzwa okuthile okunzima kunokuphathwa ngamaqiniso angaphelele aduduzayo. Ukwethembeka okuphelele kuyizinga lakho futhi yilokho okunikezayo."
          }
        }
      }
    },
    "You're adaptive and mood-driven. That flexibility is a strength as long as you can communicate when you're 'off'." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy’s aanpasbaar en jou bui stuur jou. Daardie buigsaamheid is ’n sterkpunt, solank jy kan sê wanneer jy “af” is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተላማጅና በስሜት የሚመሩ ነዎት። «ጥሩ ቀን ላይ» እንዳልሆኑ መናገር እስከቻሉ ድረስ ይህ ተለዋዋጭነት ጥንካሬ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتكيّفون حسب المزاج. هذه المرونة نقطة قوة، ما دمتم قادرين على التعبير حين لا تكونون في أفضل حالاتكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি খাপ খুৱাব পৰা আৰু মনৰ ভাব অনুসৰি চলা। আপোনাৰ মন ভাল নথকাৰ সময়ত সেয়া জনাব পাৰিলে এই নমনীয়তা এক শক্তি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyğunlaşansan və əhvalına görə hərəkət edirsən. Özünü “yaxşı olmayan” günlərində bunu deyə bildikcə bu çeviklik güclü cəhətdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты падладжваешся і жывеш настроем. Гэтая гнуткасць — моцны бок, калі ты ўмееш сказаць, што сёння «не ў форме»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адаптираш се и се водиш от настроението. Тази гъвкавост е сила, стига да можеш да кажеш, когато не ти е денят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি মানিয়ে নাও, মুডের সাথে চলো। এই নমনীয়তা একটা শক্তি, যতক্ষণ তুমি জানাতে পারো কখন তোমার “মুড নেই”।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođavaš se i vode te raspoloženja. Ta fleksibilnost je snaga, dok god možeš reći kad ti „nije dan”."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'adaptes i et deixes portar per l'estat d'ànim. Aquesta flexibilitat és un punt fort sempre que sàpigues avisar quan no tens el dia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobuješ se a řídíš se náladou. Ta flexibilita je síla, pokud dokážeš říct, kdy zrovna nejsi ve své kůži."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n addasu ac yn dilyn dy hwyliau. Mae'r hyblygrwydd yna'n gryfder, cyn belled â dy fod yn gallu dweud pan nad wyt ti ‘ar dy orau’."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er omstillingsparat og styret af dit humør. Den fleksibilitet er en styrke, så længe du kan sige til, når du ikke er helt på toppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist anpassungsfähig und stimmungsgesteuert. Diese Flexibilität ist eine Stärke, solange du sagen kannst, wenn du mal „neben der Spur“ bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόζεσαι και σε οδηγεί η διάθεση. Αυτή η ευελιξία είναι δύναμη, αρκεί να μπορείς να λες πότε δεν είσαι στα καλά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te adaptas y te guías por tu estado de ánimo. Esa flexibilidad es una fortaleza, siempre que puedas avisar cuando no estás en tu mejor día."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa oled kohanemisvõimeline ja meeleolust juhitud. See paindlikkus on tugevus, kui suudad öelda, millal sul on „halb päev“."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moldakorra zara eta aldarteak gidatzen zaitu. Malgutasun hori indargunea da, «gaizki» zaudenean esateko gai bazara."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منعطفی و حال‌وهوایت تعیین می‌کند. این انعطاف نقطهٔ قوت است، به شرطی که بتوانی بگویی کی «رو به راه نیستی»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet sopeutuvainen ja mielialan mukaan menevä. Joustavuus on vahvuus, kunhan osaat kertoa, milloin et ole vireessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madali kang umangkop at sumusunod ka sa mood mo. Lakas ang ganyang flexibility basta nasasabi mo kapag “wala ka sa mood”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'adaptes et tu suis ton humeur. Cette souplesse est une force, tant que tu sais dire quand tu n'es « pas dans ton assiette »."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá tú inoiriúnaithe agus faoi stiúir an ghiúmair. Is láidreacht í an tsolúbthacht sin, fad is gur féidir leat a chur in iúl nuair nach bhfuil tú ar do sheanléim."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adáptaste e diríxete o estado de ánimo. Esa flexibilidade é unha fortaleza sempre que saibas dicir cando non estás no teu día."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે અનુકૂળ થઈ જાઓ છો અને મૂડ મુજબ ચાલો છો. આ લવચીકતા તાકાત છે, બસ તમારો મૂડ “ઠીક ન હોય” ત્યારે એ જણાવી શકો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna daidaitawa kuma yanayi ne ke jagorantar ku. Wannan sassauci ƙarfi ne matuƙar kuna iya sanarwa idan ba ku cikin yanayi mai kyau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך יכולת הסתגלות, והכול לפי מצב הרוח. הגמישות הזאת היא חוזקה, כל עוד יודעים לומר כשהיום פחות טוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ढल जाते हैं और मूड के हिसाब से चलते हैं। यह लचीलापन एक ताक़त है, बशर्ते आप बता सकें कि कब आपका दिन “ठीक नहीं” है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođavaš se i vodi te raspoloženje. Ta fleksibilnost je snaga, dok god možeš reći kad nisi „u formi”."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou adapte w e ou swiv imè ou. Fleksibilite sa a se yon fòs toutotan ou ka di lè ou pa “nan bon jou ou”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmazkodó vagy, és sokat számít a hangulatod. Ez a rugalmasság erősség, amíg jelezni tudod, ha épp „nem vagy formában”."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու հարմարվող ես ու ապրում ես տրամադրությամբ։ Այդ ճկունությունն ուժ է, եթե կարողանում ես ասել, երբ «ձևի մեջ չես»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu adaptif dan mengikuti mood. Fleksibilitas itu kekuatan, asal kamu bisa bilang saat sedang “nggak on”."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-agbanwe agbanwe ma na-eso ọnọdụ obi gị. Nnwere onwe ahụ bụ ike ma ọ bụrụhaala na ị nwere ike ikwu mgbe ahụ na-adịghị gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú lagar þig að aðstæðum og ferð eftir skapinu. Sá sveigjanleiki er styrkur svo lengi sem þú getur látið vita þegar þú ert ekki í stuði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti adatti e segui l’umore. Questa flessibilità è un punto di forza, purché tu sappia dire quando sei «fuori fase»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分に合わせて順応するタイプです。調子が「イマイチ」なときにそれを伝えられれば、その柔軟さは強みになります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan gampang nyetel lan manut swasana ati. Keluwesan iki dadi kekuwatan anggere panjenengan bisa ngomong yen lagi “ora mood”."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოქნილი ხარ და ხასიათს მიჰყვები. ეს ძალაა, თუკი შეგიძლია თქვა, როცა „ფორმაში არ ხარ“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен бейімделгішсің әрі көңіл-күйге қарайсың. Бұл икемділік — күш, тек «Бүгін күйім жоқ» дегенді айта біл."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកចេះសម្របខ្លួន ហើយធ្វើតាមអារម្មណ៍។ ភាពបត់បែននេះជាចំណុចខ្លាំង ឲ្យតែអ្នកអាចប្រាប់បានពេលអ្នក “មិនស្រួល”។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಹೊಂದಿಕೊಳ್ಳುವವರು, ಮೂಡ್‌ಗೆ ತಕ್ಕಂತೆ ನಡೆಯುವವರು. ನೀವು “ಸರಿ ಇಲ್ಲದಾಗ” ಅದನ್ನು ತಿಳಿಸಬಲ್ಲಿರಾದರೆ, ಈ ಹೊಂದಿಕೊಳ್ಳುವಿಕೆ ಒಂದು ಶಕ್ತಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분 따라 유연하게 맞추는 타입이에요. 컨디션이 ‘별로’일 때 그걸 말할 수만 있다면 그 유연함은 장점이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu xwe diguncînî û li gorî halê xwe tevdigerî. Ev nermbûn hêzek e, bi şertê ku tu karibî bibêjî kengê tu “ne baş” î."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен ыңгайлашкыч жана маанайыңа жараша жашайсың. Бул ийкемдүүлүк — күч, болгону «бүгүн мен өзүмдө эмесмин» деп айта алсаң болду."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bass flexibel a gees no denger Stëmmung. Dat ass eng Stäerkt, soulaang s du soe kanns, wann s du net gutt drop bass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າປັບຕົວໄດ້ ແລະ ໄປຕາມອາລົມ ຄວາມຍືດຫຍຸ່ນນີ້ເປັນຈຸດແຂງ ຂໍພຽງໃຫ້ບອກໄດ້ເມື່ອເຈົ້າ ‘ບໍ່ຄ່ອຍໄຫວ’"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisitaikai ir vadovaujiesi nuotaika. Toks lankstumas – stiprybė, jei tik moki pasakyti, kai esi „ne savo vėžėse“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pielāgojies un vadies pēc noskaņojuma. Šī elastība ir stiprā puse, ja vien vari pateikt, kad tev ir „ne tā diena”."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahay mifanaraka ianao ary arahinao ny toe-ponao. Tanjaka izany fahamoram-pihetsika izany raha mbola afaka milaza ianao rehefa “tsy mety” ny ao aminao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He urutau koe, ā, ka whai koe i tō wairua. He kaha tēnā ngāwaritanga, mēnā ka taea e koe te kī atu ina “kāore koe i te pai”."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Се прилагодуваш и се водиш по расположението. Таа флексибилност е сила, сè додека можеш да кажеш кога не ти е ден."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ മൂഡ് അനുസരിച്ച് മാറുന്നവരാണ്. നിങ്ങൾ “ശരിയല്ലാത്ത” അവസ്ഥയിലായിരിക്കുമ്പോൾ അത് പറയാൻ കഴിയുന്നിടത്തോളം, ആ വഴക്കം ഒരു കരുത്താണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи дасан зохицдог, сэтгэл санаагаа дагадаг. «Тааруу» байгаа үедээ хэлж чаддаг л бол энэ уян хатан байдал давуу тал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही जुळवून घेणारे आणि मूडनुसार चालणारे आहात. तुमचा मूड “ठीक नाही” तेव्हा ते सांगू शकलात, तर ही लवचीकता तुमची ताकद ठरते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mudah menyesuaikan diri dan mengikut perasaan. Kefleksibelan itu satu kekuatan asalkan anda boleh memberitahu apabila anda ‘tidak berapa okey’."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadatta ruħek u timxi skont il-burdata. Dik il-flessibbiltà hija saħħa sakemm tgħid meta ma tkunx f'formik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် လိုက်လျောညီထွေရှိပြီး စိတ်ခံစားမှုအတိုင်း သွားတယ်။ ကိုယ် “မကောင်းတဲ့နေ့” ဖြစ်နေရင် ပြောပြနိုင်သရွေ့ ဒီပြောင်းလွယ်ပြင်လွယ်ရှိမှုက အားသာချက်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er tilpasningsdyktig og styres av humøret. Den fleksibiliteten er en styrke, så lenge du kan si fra når du har en dårlig dag."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं अनुकूल हुनुहुन्छ र मुडअनुसार चल्नुहुन्छ। आफ्नो मुड ‘ठिक छैन’ भएको बेला भन्न सक्नुहुन्छ भने यो लचिलोपन शक्ति हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij past je aan en volgt je gevoel. Die flexibiliteit is een kracht, zolang je kunt laten weten wanneer je ‘off’ bent."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumasinthasintha malinga ndi mmene mukumvera. Kusinthasintha kumeneko ndi mphamvu, bola mutha kunena pamene simuli bwino."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haala wajjin walsimta, miiraan socho'ta. Jijjiiramni kun cimina dha, hamma yeroo “gaarii hin taane” itti himuu dandeessutti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଖାପଖୁଆଇ ଚଳନ୍ତି ଓ ମନ ଅନୁସାରେ ଚାଲନ୍ତି। ଆପଣ ‘ମନ ଭଲ ନାହିଁ’ ବୋଲି ଜଣାଇପାରିଲେ ଏହି ନମନୀୟତା ଏକ ଶକ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਹਾਲਾਤ ਮੁਤਾਬਕ ਢਲਦੇ ਹੋ ਅਤੇ ਮੂਡ ਨਾਲ ਚੱਲਦੇ ਹੋ। ਇਹ ਲਚਕ ਇੱਕ ਤਾਕਤ ਹੈ, ਬਸ਼ਰਤੇ ਤੁਸੀਂ ਦੱਸ ਸਕੋ ਕਿ ਕਦੋਂ ਤੁਹਾਡਾ ਦਿਨ “ਠੀਕ ਨਹੀਂ”।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowujesz się i kierujesz nastrojem. Ta elastyczność to atut, o ile umiesz powiedzieć, kiedy masz gorszy dzień."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو د حالاتو او مزاج سره سم بدلېږئ. دا انعطاف یو ځواک دی، په دې شرط چې کله مو حال «ښه نه وي»، ویلی یې شئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se adapta e se guia pelo humor. Essa flexibilidade é uma força, desde que você consiga avisar quando não está num bom dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptas-te e guias-te pelo humor. Essa flexibilidade é uma força, desde que consigas dizer quando estás num dia «não»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te adaptezi și te iei după starea de moment. Flexibilitatea asta e un atu, atâta timp cât poți spune când nu ești în apele tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты подстраиваешься и живёшь по настроению. Эта гибкость — сила, если ты умеешь сказать, когда ты «не в ресурсе»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wihuza n'ibihe kandi ugendera ku marangamutima. Uko koroshya ni imbaraga igihe cyose ushobora kuvuga igihe utameze neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ හැඩගැසෙනවා, මනෝභාවය අනුව යනවා. ඔබ “හරි නැති” වෙලාවට ඒක කියන්න පුළුවන් නම්, ඒ නම්‍යශීලීබව ශක්තියක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prispôsobuješ sa a riadiš sa náladou. Tá flexibilita je sila, pokiaľ vieš povedať, keď nemáš svoj deň."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagajaš se in te vodi razpoloženje. Ta prožnost je prednost, dokler znaš povedati, kdaj nisi „pri sebi“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unochinjika uye unotungamirwa nemanzwiro. Kuchinjika ikoko isimba chero uchikwanisa kutaura kana usiri “pamuviri”."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waad la qabsataa oo niyaddaada ayaa ku hagta. Dabacsanaantaasi waa xoog, inta aad sheegi karto marka aadan fiicnayn."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përshtatesh dhe të udhëheq humori. Ky fleksibilitet është një forcë, për sa kohë mund ta thuash kur s’je „në formë“."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагођаваш се и водиш расположењем. Та флексибилност је снага, све док можеш да кажеш кад ти „није дан“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun gampil nyaluyukeun sareng nuturkeun wanda. Kaluwesan éta téh kakuatan, salami anjeun tiasa nyarioskeun nalika anjeun nuju “teu ngeunah”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är anpassningsbar och styrs av humöret. Den flexibiliteten är en styrka, så länge du kan säga till när du inte är i form."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabadilika na kuongozwa na hisia. Unyumbufu huo ni nguvu ilimradi unaweza kusema siku ambayo “hauko sawa”."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சூழலுக்கு ஏற்ப மாறுபவர், மனநிலையைப் பொறுத்து இயங்குபவர். நீங்கள் சரியில்லாத நாட்களைத் தெரியப்படுத்த முடிந்தால், அந்த நெகிழ்வு ஒரு பலம்தான்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు సర్దుకుపోతారు, మూడ్‌ను బట్టి నడుస్తారు. మీకు బాగోలేనప్పుడు చెప్పగలిగినంత వరకు, ఆ వెసులుబాటు ఒక బలం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту мутобиқшаванда ва вобаста ба кайфият ҳастӣ. Ин чандирӣ қувват аст, ба шарте ки гуфта тавонӣ, кай «дар ҳолат нестӣ»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณปรับตัวได้และเป็นไปตามอารมณ์ ความยืดหยุ่นนี้เป็นจุดแข็ง ขอแค่บอกให้รู้ได้เมื่อวันไหนคุณ “ไม่ค่อยไหว”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተላመድትን ብስምዒት ዝኸዱን ኢኹም። እዚ ተጣጣፍነት ሓይሊ እዩ፣ ደኺምኩም ከለኹም ክትገልጹ እንተ ክኢልኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen uýgunlaşýan we keýpe görä hereket edýän. Bu çeýelik güýç, diňe özüňi “gowy däl” duýýan wagtyňy aýdyp bilseň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyum sağlıyorsun ve ruh haline göre hareket ediyorsun. “Havanda olmadığın” zamanları söyleyebildiğin sürece bu esneklik bir güç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти підлаштовуєшся й зважаєш на настрій. Ця гнучкість — сила, якщо ти вмієш сказати, коли ти «не у формі»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انداز موڈ کے ساتھ بدلتا ہے۔ یہ لچک ایک خوبی ہے، بشرطیکہ آپ بتا سکیں کہ کب آپ کا دن “ٹھیک نہیں”۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz moslashuvchansiz va kayfiyatga qarab yashaysiz. Bu moslashuvchanlik kuchli tomoningiz, faqat «holsiz» paytingizni bildira olsangiz boʻlgani."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn linh hoạt và theo cảm xúc. Sự linh hoạt đó là điểm mạnh, miễn là bạn nói ra được khi mình đang “lệch nhịp”."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaziqhelanisa kwaye uqhutywa yimo. Oko kuguquguquka ngamandla, nje ukuba uyakwazi ukuxela xa ungaziva kakuhle."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń yí padà pẹ̀lú ìṣesí yín. Ìrọ̀rùn yẹn jẹ́ agbára, bí ẹ bá ṣáà lè sọ fúnni nígbà tí ara yín “kò yá”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你隨機應變，跟著心情走。這份彈性是優點，只要你能在狀態不好時說出來。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你灵活多变、跟着感觉走。只要能在状态不好时说出来，这份灵活就是优点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你很能隨機應變，跟著心情走。只要能讓對方知道自己狀態「不太對」的時候，這份彈性就是優點。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazivumelanisa futhi ulawulwa yimizwa. Lokho kuguquguquka kungamandla inqobo nje uma ukwazi ukusho lapho “ungekho kahle”."
          }
        }
      }
    },
    "You're moving toward no, even if you haven't fully committed to that position yet. Worth being transparent with a partner who feels strongly." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy beweeg na nee, al het jy jou nog nie heeltemal daaraan verbind nie. Die moeite werd om deursigtig te wees met ’n maat wat sterk voel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙሉ በሙሉ ባይወስኑም ወደ «አይ» እየሄዱ ነው። ይህን በጥብቅ የሚፈልጉ አጋር ካሉዎት ግልጽ መሆን ይጠቅማል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميل نحو الرفض، حتى لو لم يكن قرارًا نهائيًا بعد. من الأفضل الشفافية مع شريك يتمسك بالأمر بقوة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি নহয়ৰ ফালে আগবাঢ়িছে, যদিও সেই অৱস্থানত এতিয়াও সম্পূৰ্ণ থিৰ হোৱা নাই। এই বিষয়ে দৃঢ় মত থকা সংগীৰ লগত স্বচ্ছ হোৱাটো ভাল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hələ tam qərar verməsən də, “yox”a doğru gedirsən. Bu barədə güclü fikri olan partnyorla açıq olmağa dəyər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты схіляешся да «не», хоць канчатковага рашэння яшчэ няма. Варта шчыра сказаць пра гэта палавінцы, для якой гэта важна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клониш към „не“, дори позицията ти още да не е окончателна. Струва си да говориш открито с половинка, за която темата е много важна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি না-এর দিকে এগোচ্ছ, যদিও পুরোপুরি সিদ্ধান্ত নাওনি। এ নিয়ে যার জোরালো মত আছে, এমন পার্টনারের সাথে খোলাখুলি থাকা ভালো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naginješ ka ne, čak i ako to još nije konačan stav. Vrijedi otvoreno razgovarati s voljenom osobom kojoj je to jako važno."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tires cap al no, encara que no t'hi hagis compromès del tot. Val la pena ser transparent amb una parella que ho té molt clar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Směřuješ k ne, i když v tom ještě nemáš úplně jasno. Mluv o tom otevřeně s protějškem, pro kterého je to důležité."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n symud tuag at na, hyd yn oed os nad wyt ti wedi penderfynu'n llwyr eto. Mae'n werth bod yn agored gyda phartner sy'n teimlo'n gryf am y peth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bevæger dig mod et nej, selvom du ikke har lagt dig helt fast endnu. Vær åben om det over for en partner, der har en stærk holdning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bewegst dich Richtung Nein, auch wenn du dich noch nicht ganz festgelegt hast. Sei offen damit, falls es deinem Schatz sehr wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πηγαίνεις προς το όχι, ακόμα κι αν δεν το έχεις αποφασίσει οριστικά. Αξίζει να μιλήσεις ανοιχτά σε ένα ταίρι που το νιώθει έντονα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vas acercando al no, aunque todavía no lo tengas del todo decidido. Conviene ser transparente con una pareja que lo tenga muy claro."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liigud ei suunas, isegi kui pole veel lõplikult otsustanud. Tasub olla aus partneriga, kellel on selles tugev seisukoht."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezezkora zoaz, jarrera hori guztiz hartu ez baduzu ere. Merezi du gardena izatea iritzi sendoa duen bikotekide batekin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داری به سمت نه می‌روی، حتی اگر هنوز کاملاً پایش نایستاده‌ای. ارزش دارد با پارتنری که نظر محکمی دارد شفاف باشی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet kallistumassa kieltävään, vaikket ole vielä täysin lukinnut kantaasi. Kannattaa olla avoin kumppanille, jolle asia on tärkeä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papunta ka na sa hindi, kahit hindi mo pa ito tuluyang pinaninindigan. Magandang maging bukas dito sa partner na may matibay na pananaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'orientes vers le non, même si ta décision n'est pas encore définitive. Mieux vaut jouer la transparence avec quelqu'un qui y tient beaucoup."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá tú ag bogadh i dtreo “ní hea”, fiú mura bhfuil tú tar éis socrú go hiomlán air fós. Is fiú a bheith oscailte le páirtí a mhothaíonn go láidir faoi."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas cara ao non, aínda que non o teñas decidido do todo. Convén ser transparente cunha parella que o sinta con forza."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે ના તરફ જઈ રહ્યા છો, ભલે હજુ એ નિર્ણય પર પૂરેપૂરા પાક્કા ન હો. જે પાર્ટનરની આ વિશે મજબૂત લાગણી હોય, એમની સાથે પારદર્શક રહેવું સારું."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna kusantar a'a, ko da ba ku gama tsayawa kan wannan matsayi ba tukuna. Ya dace ku bayyana gaskiya ga abokin zama mai ra'ayi mai ƙarfi a kai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכיוון שלך הוא \"לא\", גם אם עוד לא סגרת על זה סופית. כדאי לדבר על זה בגלוי, במיוחד אם לצד השני זה חשוב מאוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका झुकाव ना की तरफ़ है, भले ही अभी पूरी तरह तय न हो। जिस पार्टनर की इस पर पक्की राय हो, उनसे खुलकर बात करना अच्छा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krećeš se prema „ne”, iako taj stav još nije konačan. Vrijedi otvoreno razgovarati s voljenom osobom kojoj je to jako važno."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ap mache bò kote non, menm si ou poko pran pozisyon sa a nèt. Li bon pou ou transparan ak yon patnè ki santi l fò sou sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nem felé tartasz, még ha nem is döntöttél véglegesen. Érdemes nyíltan beszélni róla, ha a párodnak ez nagyon fontos."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու շարժվում ես դեպի «ոչ», նույնիսկ եթե վերջնականապես չես որոշել։ Արժե անկեղծ լինել այն զուգընկերոջ հետ, ում համար սա շատ կարևոր է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu condong ke arah tidak, meski belum sepenuhnya memutuskan. Sebaiknya terbuka pada pasangan yang punya keinginan kuat soal ini."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-aga n'ebe mba, ọbụlagodi na ị kpebisighị ike na ya. Ọ bara uru ikwu eziokwu nye onye gị nke nwere mmetụta siri ike gbasara ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú stefnir í átt að nei, jafnvel þótt þú hafir ekki tekið endanlega afstöðu enn. Gott að tala hreint út við maka sem hefur sterka skoðun á þessu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti stai orientando verso il no, anche se non hai ancora preso una posizione definitiva. Meglio essere trasparenti con un partner che ci tiene molto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ完全に決めてはいなくても、気持ちはノーに傾いています。強い思いを持つパートナーには、正直に伝えておくのがいいでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan luwih condhong menyang ora, senajan durung mantep tenan. Pantes terbuka karo pasangan sing nduweni panemu kuwat."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„არასკენ“ მიდიხარ, თუნდაც ბოლომდე ჯერ არ გადაგიწყვეტია. ღირს, გულახდილი იყო პარტნიორთან, ვისთვისაც ეს ძალიან მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл ұстанымға әлі толық бекімесең де, «жоққа» қарай бет алып келесің. Бұған қатты мән беретін серікке ашық айтқан жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកកំពុងទំនងទៅរកការមិនចង់ ទោះបីមិនទាន់សម្រេចចិត្តទាំងស្រុងក៏ដោយ។ គួរនិយាយឲ្យច្បាស់ជាមួយដៃគូដែលមានអារម្មណ៍ខ្លាំងលើរឿងនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ ನಿಲುವಿಗೆ ಸಂಪೂರ್ಣ ಬದ್ಧರಾಗದಿದ್ದರೂ, ನೀವು “ಬೇಡ” ಎನ್ನುವತ್ತ ಸಾಗುತ್ತಿದ್ದೀರಿ. ಈ ಬಗ್ಗೆ ಬಲವಾದ ಭಾವನೆ ಇರುವ ಸಂಗಾತಿಯೊಂದಿಗೆ ಪಾರದರ್ಶಕವಾಗಿರುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전히 마음을 정하진 않았어도 ‘아니요’ 쪽으로 기울고 있어요. 이 문제에 강한 생각을 가진 연인에게는 솔직하게 말해 두는 게 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ber bi na ve diçî, heta heke te hîn bi tevahî biryar nedabe jî. Heke hestên hevjînê te li ser vê xurt in, hêja ye ku tu pê re vekirî bî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ал позицияга толук бекем болбосоң да, «жок» дегенге жакындап жатасың. Буга катуу маани берген сүйгөнүң менен ачык болгон жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gees a Richtung Nee, och wann s du dech nach net ganz festgeluecht hues. Sief transparent mat engem Schatz, deem dat ganz wichteg ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າກຳລັງໄປທາງບໍ່ມີ ເຖິງຍັງບໍ່ໄດ້ຕັດສິນໃຈເດັດຂາດ ຄວນເປີດເຜີຍກັບຄູ່ທີ່ຮູ້ສຶກຈິງຈັງກັບເລື່ອງນີ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypsti link „ne“, net jei dar galutinai neapsisprendei. Verta būti atviriems, jei antrajai pusei tai labai svarbu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sliecies uz „nē”, pat ja galīgais lēmums vēl nav pieņemts. Vērts to atklāti pateikt otrai pusei, kurai šis jautājums ir ļoti svarīgs."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirona amin'ny tsia ianao, na dia mbola tsy nanapa-kevitra tanteraka aza. Mendrika ny hangarahara amin'ny olon-tiana manana fihetseham-po mafy momba izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei te neke koe ki te kāo, ahakoa kāore anō koe kia tino whakatau. He pai kia mārama ki tētahi hoa aroha he kaha ōna whakaaro."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Се движиш кон не, иако можеби сè уште немаш донесено конечна одлука. Вреди отворено да зборуваш со половинка на која ова многу ѝ значи."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആ നിലപാട് പൂർണമായി ഉറപ്പിച്ചിട്ടില്ലെങ്കിലും, നിങ്ങൾ ഇല്ല എന്നതിലേക്കാണ് നീങ്ങുന്നത്. ഇക്കാര്യത്തിൽ ശക്തമായ അഭിപ്രായമുള്ള ഒരു പങ്കാളിയോട് സുതാര്യമായിരിക്കുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ байр сууриа бүрэн тогтоогоогүй ч чи «үгүй» тал руу хандаж байна. Энэ талаар хатуу байр суурьтай ханьтайгаа ил тод байх нь зүйтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्णपणे ठरवले नसले तरी तुमचा कल नकाराकडे आहे. याबाबत ठाम भावना असलेल्या जोडीदाराशी मोकळेपणाने बोलणे चांगले."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda semakin condong kepada tidak, walaupun belum benar-benar muktamad. Elok berterus terang dengan pasangan yang sangat menginginkannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qed timxi lejn le, anke jekk għadek ma ddeċidejtx għal kollox. Ta' min tkun trasparenti ma' partner li jħossha bis-saħħa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အဲဒီ ရပ်တည်ချက်ကို အပြည့်အဝ မဆုံးဖြတ်ရသေးပေမဲ့ မယူဘက်ကို ဦးတည်နေတယ်။ ဒီကိစ္စကို ပြင်းပြင်းထန်ထန် ခံစားရတဲ့ ချစ်သူနဲ့ ပွင့်ပွင့်လင်းလင်း ပြောသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du heller mot nei, selv om du ikke har bestemt deg helt. Vær åpen med en partner som har sterke meninger om dette."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरै निर्णय नगरिसक्नुभए पनि तपाईं ‘होइन’ तिर बढ्दै हुनुहुन्छ। यसबारे कडा भावना राख्ने पार्टनरसँग पारदर्शी हुनु राम्रो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beweegt richting nee, ook al heb je dat standpunt nog niet helemaal ingenomen. Wees daar open over, zeker als het voor je partner zwaar weegt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukupita ku ayi, ngakhale simunatsimikize kwathunthu. Ndi bwino kukhala woonekera kwa wokondedwa amene ali ndi maganizo amphamvu pa izi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gara lakkiitti deemaa jirta, ammallee guutummaatti osoo hin murteessin illee. Jaalallee kana irratti yaada cimaa qabu wajjin iftoomina qabaachuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପୂରାପୂରି ସ୍ଥିର ନ କରିଥିଲେ ବି ଆପଣ ନା ଆଡ଼କୁ ଯାଉଛନ୍ତି। ଏ ବିଷୟରେ ଦୃଢ଼ ଭାବନା ଥିବା ସାଥୀଙ୍କ ସହ ସ୍ୱଚ୍ଛ ରହିବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਨਾਂਹ ਵੱਲ ਵਧ ਰਹੇ ਹੋ, ਭਾਵੇਂ ਅਜੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਪੱਕਾ ਫ਼ੈਸਲਾ ਨਹੀਂ ਕੀਤਾ। ਜੇ ਪਾਰਟਨਰ ਇਸ ਬਾਰੇ ਪੱਕੀ ਰਾਇ ਰੱਖਦੇ ਹਨ ਤਾਂ ਉਨ੍ਹਾਂ ਨਾਲ ਸਾਫ਼ ਗੱਲ ਕਰਨੀ ਚੰਗੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmierzasz w stronę „nie”, nawet jeśli to jeszcze nie jest ostateczna decyzja. Warto otwarcie rozmawiać o tym z drugą połówką, dla której to ważne."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستاسو میلان «نه» ته دی، که څه هم لا مو بشپړه پرېکړه نه ده کړې. ښه به وي له هغه ملګري سره رڼې خبرې وکړئ چې په دې اړه ټینګ احساس لري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está indo em direção ao não, mesmo sem ter batido o martelo. Vale ser transparente com um amor que tenha uma opinião forte sobre isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a caminhar para o não, mesmo que ainda não tenhas assumido totalmente essa posição. Vale a pena ser transparente com um par que tenha uma opinião forte sobre isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te îndrepți spre un nu, chiar dacă nu ți-ai asumat încă pe deplin această poziție. Merită să vorbești deschis cu un partener care ține mult la asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты склоняешься к «нет», даже если окончательного решения пока нет. С партнёром, для которого это важно, стоит говорить откровенно."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugana ku oya, n'iyo utaremeza neza icyo cyemezo. Ni byiza kubivugisha ukuri umukunzi ubifiteho ibyiyumvo bikomeye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඒ ස්ථාවරයට සම්පූර්ණයෙන්ම කැප වෙලා නැති වුණත්, ඔබ නැහැ පැත්තට යනවා. මේ ගැන දැඩි හැඟීමක් තියෙන සහකරුවෙක් එක්ක විවෘතව ඉන්න වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smeruješ k nie, aj keď to ešte nemáš definitívne rozhodnuté. Oplatí sa to úprimne povedať polovičke, ktorá to cíti silno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagibaš se k ne, četudi to stališče še ni dokončno. Vredno je odkrito govoriti s partnerjem, ki ima o tem močno mnenje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uri kuenda kukwete, kunyange usati wanyatsozvisarudza. Zvakakodzera kuva pachena nemudiwa ane manzwiro akasimba pazviri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad u socotaa maya, xitaa haddii aadan weli si buuxda u go'aamin. Waa mudan tahay inaad daacad u ahaato lammaane si xoog leh u dareemaya."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po shkon drejt një jo-je, edhe pse ende s’e ke vendosur plotësisht. Vlen të flasësh hapur me një partner që e ndien fort këtë çështje."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крећеш се ка не, чак и ако то још није коначан став. Вреди бити отворено искрен с половином којој је ово веома важно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun condong ka henteu, sanajan teu acan pinuh yakin kana sikep éta. Patut kabuka ka pasangan anu gaduh pamanggih anu kuat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du rör dig mot ett nej, även om du inte bestämt dig helt än. Var öppen med det mot en partner som har starka känslor i frågan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaelekea kwenye hapana, hata kama bado hujaamua kabisa. Ni vyema kuwa wazi na mwenzi anayehisi kwa nguvu kuhusu jambo hili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்த நிலைப்பாட்டை முழுமையாக எடுக்காவிட்டாலும், நீங்கள் “வேண்டாம்” என்ற பக்கம் நகர்கிறீர்கள். இதில் வலுவான உணர்வு கொண்ட துணையிடம் வெளிப்படையாக இருப்பது நல்லது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంకా పూర్తిగా నిర్ణయించుకోకపోయినా, మీరు వద్దు వైపే వెళ్తున్నారు. దీనిపై గట్టి అభిప్రాయం ఉన్న భాగస్వామితో పారదర్శకంగా ఉండటం మంచిది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ба сӯи «не» ҳаракат мекунӣ, ҳарчанд ҳанӯз пурра қарор надодаӣ. Бо ёре, ки дар ин бора ҳисси қавӣ дорад, ошкоро будан арзанда аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกำลังเอนไปทางไม่มี แม้จะยังไม่ได้ตัดสินใจเด็ดขาด ควรเปิดใจคุยตรงๆ กับคนรักที่รู้สึกหนักแน่นในเรื่องนี้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነቲ መርገጺ ብምሉኡ እንተ ዘይወሰድኩምዎ እውን ናብ ኣይፋል ትኸዱ ኣለኹም። ብርቱዕ ስምዒት ምስ ዘለዎ መጻምዲ ግሉጻት ምዃን ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen “ýok” tarapa barýarsyň, hatda bu karara heniz doly gelmedik bolsaň-da. Bu barada güýçli pikirli söýgüliň bilen açyk bolmaga degýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz kesin karar vermemiş olsan da hayıra doğru gidiyorsun. Bu konuda güçlü hisleri olan bir partnere karşı açık olmaya değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти схиляєшся до «ні», навіть якщо остаточно ще не вирішено. Варто відверто сказати про це половинці, для якої це дуже важливо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا جھکاؤ انکار کی طرف ہے، چاہے ابھی آپ نے اس پر پختہ فیصلہ نہ کیا ہو۔ جس ساتھی کی اس بارے میں پکی رائے ہو، اس سے صاف بات کرنا بہتر ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz «yoʻq» tomonga yaqinlashyapsiz, garchi bu qarorga toʻliq kelmagan boʻlsangiz ham. Bu masalada qatʼiy fikrdagi sherik bilan ochiq boʻlishga arziydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang nghiêng về “không”, dù chưa hoàn toàn chốt. Nên thẳng thắn với người ấy nếu người ấy có mong muốn mạnh mẽ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uya ngakwicala lokuthi hayi, nokuba awukazimiseli ngokupheleleyo kweso simo. Kufanelekile ukunyaniseka neqabane elinoluvo olunamandla ngale nto."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń lọ sí ọ̀nà rárá, kódà bí ẹ kò bá tíì pinnu pátápátá. Ó yẹ kí ẹ ṣí ọkàn payá fún olólùfẹ́ tí ọ̀rọ̀ náà jẹ lógún gan-an."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使還未完全確定，你正走向「不要」。對於在這點上很有主見的另一半，值得坦白相告。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在往“不要”的方向走，即使还没完全下定决心。如果另一半在这件事上态度很坚定，最好坦诚相告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你傾向不生，雖然還沒完全確定。如果另一半對這件事很堅持，坦白說清楚很重要。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uya ngasekuthini cha, ngisho noma ungakazibophezeli ngokuphelele kulowo mbono. Kufanele wethembeke kumlingani onemizwa eqinile ngakho."
          }
        }
      }
    },
    "You're playing the long game. Future-you will thank both of you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
