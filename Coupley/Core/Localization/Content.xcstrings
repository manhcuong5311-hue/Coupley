        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lausnamiðuð nálgun. Þú lítur svo á að sambandið sé stærra en ágreiningurinn. Það er raunverulegur styrkur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti alla soluzione. Per te la relazione è più grande del disaccordo. È un vero punto di forza."
