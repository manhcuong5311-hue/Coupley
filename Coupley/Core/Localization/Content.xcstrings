        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጉዳዩ ዋጋው አይደለም — እርስዎ በሌሉበት አንድ ሰው እንዳሰበዎት ማረጋገጫ ነው። ዋናው ነገር አሳቢነቱ ነው።"
