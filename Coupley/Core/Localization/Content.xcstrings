        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív silná vlastní identita, pak to společné"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stærk egen identitet først, så det fælles"
          }
        },
        "de" : {
          "stringUnit" : {
