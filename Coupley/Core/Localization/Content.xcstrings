        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ̀nà yìí ni ẹ fi ń gba ìfẹ́ jù lọ — olólùfẹ́ yín ní láti mọ èyí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
