    "Very close — we talk all the time and see each other often" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baie na – ons praat heeltyd en sien mekaar gereeld"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በጣም ቅርብ — ሁልጊዜ እናወራለን፣ ብዙ ጊዜም እንገናኛለን"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قريبون جدًا: نتحدث دائمًا ونلتقي كثيرًا"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অতি ঘনিষ্ঠ — আমি সদায় কথা পাতোঁ আৰু সঘনাই লগ পাওঁ"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çox yaxın — daim danışırıq və tez-tez görüşürük"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вельмі — увесь час размаўляем і часта бачымся"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Много сме близки – чуваме се постоянно и се виждаме често"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খুব ঘনিষ্ঠ — সবসময় কথা হয়, প্রায়ই দেখা হয়"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako bliski – stalno se čujemo i često viđamo"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molt propera — parlem sovint i ens veiem molt"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velmi blízko – mluvíme spolu pořád a často se vídáme"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agos iawn — rydyn ni'n siarad drwy'r amser ac yn gweld ein gilydd yn aml"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meget tæt – vi snakker hele tiden og ses tit"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr eng – wir reden ständig und sehen uns oft"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ — μιλάμε συνέχεια και βλεπόμαστε συχνά"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucho — hablamos todo el tiempo y nos vemos a menudo"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väga lähedane — räägime pidevalt ja näeme tihti"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oso handia — etengabe hitz egiten dugu eta maiz elkar ikusten dugu"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خیلی نزدیک — مدام با هم حرف می‌زنیم و زیاد همدیگر را می‌بینیم"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tosi läheinen – juttelemme ja näemme usein"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrang lapit — lagi kaming nag-uusap at madalas magkita"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très proche : on se parle tout le temps et on se voit souvent"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An-ghar — bímid ag caint an t-am ar fad agus feicimid a chéile go minic"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moi estreita: falamos todo o tempo e vémonos a miúdo"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ખૂબ નજીક — અમે સતત વાત કરીએ અને વારંવાર મળીએ"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusa sosai — muna magana koyaushe kuma muna ganin juna akai-akai"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרובים מאוד — מדברים כל הזמן ונפגשים הרבה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत क़रीब — हमेशा बात होती है, अक्सर मिलना होता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako – stalno se čujemo i često viđamo"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre anpil — nou pale toutan e nou wè souvan"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyon közel – folyton beszélünk, és gyakran találkozunk"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շատ մտերիմ — անընդհատ խոսում ենք ու հաճախ ենք հանդիպում"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat dekat — sering ngobrol dan sering ketemu"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nso nke ukwuu — anyị na-akparịta ụka mgbe niile, na-ahụkarịkwa ibe anyị"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjög náin – við tölum saman stöðugt og hittumst oft"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strettissimo — ci sentiamo sempre e ci vediamo spesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても仲良し。よく話すし、よく会う"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cedhak banget — kita kerep ngobrol lan ketemu"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ძალიან ახლოს — სულ ვსაუბრობთ და ხშირად ვხვდებით"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өте жақынбыз — үнемі сөйлесіп, жиі көрісеміз"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជិតស្និទ្ធណាស់ — យើងនិយាយគ្នារហូត ហើយជួបគ្នាញឹកញាប់"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತುಂಬಾ ಹತ್ತಿರ — ಯಾವಾಗಲೂ ಮಾತನಾಡುತ್ತೇವೆ, ಆಗಾಗ ಭೇಟಿಯಾಗುತ್ತೇವೆ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
