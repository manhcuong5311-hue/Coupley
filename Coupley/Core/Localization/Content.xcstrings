    "Tiny 'I saw this and thought of you' signals compound." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشارات «رأيت هذا فتذكرتك» الصغيرة يتراكم أثرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drobné signály „tohle mi tě připomnělo“ se sčítají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små »jeg så det her og tænkte på dig«-signaler hober sig op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
