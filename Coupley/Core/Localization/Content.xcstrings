        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det påvirker fælles måltider, indkøb og restaurantbesøg – godt at vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das betrifft gemeinsame Mahlzeiten, den Einkauf und das Essengehen – gut zu wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επηρεάζει τα κοινά γεύματα, τα ψώνια και τις εξόδους για φαγητό — καλό είναι να το ξέρετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Influye en las comidas compartidas, la compra y las salidas a comer — conviene saberlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See mõjutab ühiseid toidukordi, poeskäike ja väljas söömist — tasub teada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honek eragina du otordu partekatuetan, erosketetan eta kanpoan jatean — merezi du jakitea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این روی وعده‌های مشترک، خرید خانه و بیرون غذا خوردن اثر می‌گذارد — ارزش دانستن دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vaikuttavat yhteisiin aterioihin, kauppareissuihin ja ulkona syömiseen – hyvä tietää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apektado nito ang sabay na pagkain, pamamalengke, at pagkain sa labas — magandang malaman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça compte pour les repas partagés, les courses et les sorties au resto : bon à savoir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téann sé seo i bhfeidhm ar bhéilí comhroinnte, ar shiopadóireacht bia agus ar ithe amuigh — is fiú é a bheith ar eolas."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto afecta ás comidas compartidas, á compra e a cando comedes fóra: paga a pena sabelo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આની અસર સાથે જમવા, કરિયાણાની ખરીદી અને બહાર જમવા પર પડે છે — જાણવા જેવું."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan na shafar abincin tare, sayayyar kayan abinci, da cin abinci a waje — ya dace a sani."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה משפיע על ארוחות משותפות, על הקניות ועל יציאות למסעדות — שווה לדעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका असर साथ के खाने, राशन की ख़रीदारी और बाहर खाने पर पड़ता है — जानना अच्छा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To utječe na zajedničke obroke, kupovinu namirnica i izlaske u restorane – vrijedi znati."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa afekte repa nou pataje, makèt, ak sòti al manje — li bon pou konnen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez hatással van a közös étkezésekre, a bevásárlásra és az étteremválasztásra is – jó tudni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա ազդում է համատեղ ճաշերի, գնումների ու դրսում ուտելու վրա — արժե իմանալ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memengaruhi makan bareng, belanja bahan makanan, dan makan di luar — penting untuk diketahui."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nke a na-emetụta nri unu na-eri ọnụ, ịzụ ihe oriri na iri nri n'èzí — ọ bara uru ịma ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta hefur áhrif á sameiginlegar máltíðir, matarinnkaup og út að borða – gott að vita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Influiscono sui pasti insieme, sulla spesa e sulle cene fuori — meglio saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒の食事や買い物、外食にも関わること。知っておくと役立ちます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iki mangaruhi mangan bareng, blanja, lan mangan ing njaba — pantes dimangerteni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს გავლენას ახდენს საერთო ჭამაზე, საყიდლებზე და რესტორანში სიარულზე — ღირს, იცოდეთ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл бірге тамақтануға, азық-түлік алуға және сыртта тамақтануға әсер етеді — білген жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រឿងនេះប៉ះពាល់ដល់អាហាររួម ការទិញគ្រឿងទេស និងការចេញទៅញ៉ាំក្រៅ — គួរដឹង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಜೊತೆಯ ಊಟ, ದಿನಸಿ ಖರೀದಿ ಮತ್ತು ಹೊರಗೆ ತಿನ್ನುವುದರ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ — ತಿಳಿದಿರುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께하는 식사, 장보기, 외식에 다 영향을 주니 알아 두면 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev bandorê li xwarinên hevpar, kirîna ji bazarê û xwarina li derve dike — hêjayî zanînê ye."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул бирге тамактанууга, азык-түлүк сатып алууга жана сыртта тамактанууга таасир этет — билип койгон жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat beaflosst gemeinsam Iessen, d'Akafen an d'Erausiessen — gutt ze wëssen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເລື່ອງນີ້ມີຜົນຕໍ່ການກິນເຂົ້ານຳກັນ, ການຊື້ຂອງ ແລະ ການອອກໄປກິນນອກ — ຄວນຮູ້ໄວ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai veikia bendrus valgius, apsipirkimą ir vakarienes ne namie – verta žinoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ietekmē kopīgas maltītes, iepirkšanos un ēšanu ārpus mājas – vērts zināt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misy fiantraikany amin'ny sakafo iraisana, ny fiantsenana ary ny fisakafoanana any ivelany izany — mendrika ho fantatra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka pā tēnei ki ngā kai tahi, te hoko kai me te kai i waho — he pai kia mōhiotia."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова влијае на заедничките оброци, купувањето намирници и излегувањата — вреди да се знае."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരുമിച്ചുള്ള ഭക്ഷണത്തെയും പലചരക്ക് വാങ്ങലിനെയും പുറത്ത് കഴിക്കുന്നതിനെയും ഇത് ബാധിക്കും — അറിഞ്ഞിരിക്കുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ хамтын хоол, хүнсний дэлгүүр хэсэх, гадуур хооллоход нөлөөлдөг — мэдэх нь зүйтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "याचा परिणाम एकत्र जेवणावर, किराणा खरेदीवर आणि बाहेर जेवायला जाण्यावर होतो — हे माहीत असलेले बरे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mempengaruhi makan bersama, membeli barang dapur dan makan di luar — elok diketahui."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan jaffettwa l-ikliet flimkien, ix-xiri tal-ikel u l-ħruġ biex tieklu — ta' min tkun taf."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒါက အတူစားတဲ့ ထမင်းဝိုင်း၊ ဈေးဝယ်တာနဲ့ အပြင်စားတာတွေကို သက်ရောက်တယ် — သိထားသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette påvirker felles måltider, handling og restaurantbesøk – greit å vite."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले सँगै खाने, किनमेल गर्ने र बाहिर खाने कुरामा असर गर्छ — जान्नलायक कुरा।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit speelt mee bij samen eten, boodschappen doen en uit eten gaan – goed om te weten."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izi zimakhudza chakudya chogawana, kugula zakudya, ndi kudyera kunja — ndi bwino kudziwa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun nyaata waliinii, meeshaa bituu fi ala nyaachuu irratti dhiibbaa qaba — beekuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଏକାଠି ଖାଇବା, ବଜାର କରିବା ଓ ବାହାରେ ଖାଇବା ଉପରେ ପ୍ରଭାବ ପକାଏ — ଜାଣିବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਦਾ ਅਸਰ ਸਾਂਝੇ ਖਾਣਿਆਂ, ਰਾਸ਼ਨ ਦੀ ਖ਼ਰੀਦਦਾਰੀ ਅਤੇ ਬਾਹਰ ਖਾਣ ਉੱਤੇ ਪੈਂਦਾ ਹੈ — ਜਾਣ ਲੈਣਾ ਚੰਗਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wpływa na wspólne posiłki, zakupy i wyjścia do restauracji – warto wiedzieć."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا پر ګډو خوړو، سودا اخیستو او بهر ډوډۍ خوړلو اغېز کوي — د پوهېدو وړ ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso pesa nas refeições a dois, nas compras do mercado e nos restaurantes — vale saber."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto afeta as refeições a dois, as compras e as idas a restaurantes — vale a pena saber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contează la mesele împreună, la cumpărături și când ieșiți în oraș — e bine de știut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От этого зависят совместные обеды, походы за продуктами и рестораны — это стоит знать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibi bigira ingaruka ku mafunguro musangiye, guhaha no gusohokera kurya — ni byiza kubimenya."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මේක එක්ව කන කෑමට, බඩු මිලදී ගැනීමට, එළියේ කෑමට බලපානවා — දැනගන්න වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovplyvňuje to spoločné jedlá, nákupy aj chodenie do reštaurácií – oplatí sa to vedieť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To vpliva na skupne obroke, nakupovanje živil in obiske restavracij – vredno je vedeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvi zvinobata zvikafu zvamunodya pamwe chete, kutenga zvekudya, nekudyira kunze — zvakakodzera kuziva."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tani waxay saameysaa cuntada la wadaago, iibsashada raashinka iyo cunidda bannaanka — waa mudan tahay in la ogaado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo ndikon te vaktet e përbashkëta, pazari dhe daljet për të ngrënë – vlen ta dini."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово утиче на заједничке оброке, куповину намирница и изласке — вреди знати."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieu mangaruhan tuang babarengan, balanja, sareng tuang di luar — patut dipikanyaho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det påverkar gemensamma måltider, matinköp och restaurangbesök – bra att veta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hili linaathiri milo ya pamoja, ununuzi wa vyakula, na kula nje — ni vyema kujua."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது ஒன்றாகச் சாப்பிடுவது, மளிகை வாங்குவது, வெளியே சாப்பிடுவது எல்லாவற்றையும் பாதிக்கும் — தெரிந்துகொள்வது நல்லது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది కలిసి తినే భోజనాలు, సరుకుల షాపింగ్, బయట తినడంపై ప్రభావం చూపుతుంది — తెలుసుకోవడం మంచిది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин ба таомҳои муштарак, харидҳо ва дар берун хӯрдан таъсир мекунад — донистанаш арзанда аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรื่องนี้ส่งผลต่อการกินด้วยกัน การซื้อของเข้าบ้าน และการออกไปกินข้างนอก จึงควรรู้ไว้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እዚ ኣብ ናይ ሓባር መግቢ፣ ዕዳጋን ኣብ ደገ ምምጋብን ጽልዋ ኣለዎ — ምፍላጡ ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bile naharlanmaga, azyk satyn almaga we daşarda naharlanmaga täsir edýär — bilmäge degýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak yemekleri, market alışverişini ve dışarıda yemeyi etkiler; bilmeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від цього залежать спільні трапези, покупки продуктів і походи в кафе — варто знати."
          }
