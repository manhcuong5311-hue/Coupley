        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgbalị mgbe ụfọdụ karịa nlekọta kwa ụbọchị. Ma ọ bụrụhaala na ihe unu na-atụ anya kwekọrọ, nke a na-arụ ọrụ nke ọma."
