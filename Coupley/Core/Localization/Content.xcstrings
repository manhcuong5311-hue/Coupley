          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquelas comidas que fazem você se sentir em casa — sem julgamentos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As comidas que te fazem sentir em casa — sem julgamentos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncărurile care te fac să te simți ca acasă — fără judecăți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блюда, с которыми ты чувствуешь себя как дома, — без осуждения."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibiryo bigutera kumva uri mu rugo — nta guca urubanza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගෙදර ඉන්නවා වගේ හැඟීමක් දෙන කෑම — කිසිම විනිශ්චයක් නැහැ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedlá, pri ktorých sa cítiš ako doma – bez súdenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedi, ob katerih se počutiš kot doma – brez obsojanja."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvikafu zvinoita kuti unzwe uri kumba — pasina kutongwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuntooyinka kaa dareensiiya inaad guriga joogto — xukun la'aan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushqimet që të bëjnë të ndihesh si në shtëpi – pa gjykime."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храна уз коју се осећаш као код куће — без осуђивања."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadaharan anu ngajantenkeun anjeun ngaraos siga di bumi — teu aya anu nangtoskeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maten som får dig att känna dig hemma – inga pekpinnar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyakula vinavyokufanya ujisikie nyumbani — hakuna hukumu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீட்டில் இருப்பது போல உணர வைக்கும் உணவுகள் — எந்த மதிப்பீடும் இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంట్లో ఉన్నట్టు అనిపించే ఆహారాలు — ఎలాంటి తీర్పు లేదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таомҳое, ки ба ту ҳисси хона медиҳанд — бе доварӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาหารที่ทำให้คุณรู้สึกเหมือนอยู่บ้าน ไม่มีการตัดสิน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከም ኣብ ገዛ ዘለኹም ዘስምዑኹም መግብታት — ብዘይ ፍርዲ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özüňi öýdäki ýaly duýdurýan tagamlar — hiç hili ýazgarma ýok."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana kendini evinde hissettiren yemekler; yargı yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страви, з якими почуваєшся як удома, — без засуджень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ کھانے جو گھر جیسا احساس دیں — کوئی فیصلہ نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻzingizni uydagidek his qildiradigan taomlar — hech qanday hukmsiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những món khiến bạn thấy như ở nhà — không phán xét."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukutya okukwenza uzive usekhaya — akukho kugweba."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn oúnjẹ tó ń jẹ́ kí ẹ rí bí ẹni pé ẹ wà nílé — kò sí ìdájọ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓你有家的感覺的食物，不作評判。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那些让你有家的感觉的食物——不评判。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那些讓你有家的感覺的食物，想到什麼都可以說。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukudla okukwenza uzizwe usekhaya — akukho ukwahlulela."
          }
        }
      }
    },
    "The gift of being heard. You know how to hold space — and you resist the urge to fix. That's rare." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geskenk om gehoor te word. Jy weet hoe om ruimte te hou – en jy weerstaan die drang om dinge reg te maak. Dis skaars."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የመደመጥ ስጦታ። ለሌላው ሰው ቦታ መስጠትን ያውቃሉ — ለማስተካከል ያለውን ፍላጎትም ይቋቋማሉ። ይህ ብርቅ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدية أن يُسمَع المرء. تعرفون كيف تحتوون الآخر وتقاومون الرغبة في إصلاح كل شيء، وهذا نادر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুনা যোৱাৰ উপহাৰ। কাৰোবাক নিজৰ কথা ক'বলৈ ঠাই দিব আপুনি জানে — আৰু ঠিক কৰি দিয়াৰ লোভ সামৰি ৰাখে। এয়া বিৰল।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşidilmək hədiyyəsi. Dinləməyi bacarırsan — və hər şeyi düzəltmək istəyinə qalib gəlirsən. Bu, nadir haldır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты даеш іншым адчуванне, што іх чуюць. Ты ўмееш проста быць побач — і стрымліваеш жаданне ўсё выправіць. Гэта рэдкасць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дарът да бъдеш чут. Умееш да даваш пространство – и устояваш на желанието да поправяш. Това е рядкост."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুনতে পাওয়ার উপহার। তুমি জানো কীভাবে কাউকে মন খুলে বলার জায়গা দিতে হয় — আর ঠিক করে দেওয়ার ইচ্ছেটা সামলে রাখো। এটা বিরল।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar slušanja. Znaš pružiti prostor – i odoljeti porivu da sve popraviš. To je rijetkost."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El regal de l'escolta. Saps acompanyar — i resisteixes les ganes d'arreglar-ho. Això és poc habitual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar naslouchání. Umíš druhému dát prostor – a odoláš nutkání všechno hned řešit. To je vzácné."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y rhodd o wrando go iawn. Rwyt ti'n gwybod sut i greu lle diogel — ac rwyt ti'n gwrthsefyll yr ysfa i drwsio. Mae hynny'n brin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du giver andre følelsen af at blive hørt. Du kan rumme det, der bliver sagt, og modstå trangen til at løse det. Det er sjældent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geschenk, gehört zu werden. Du kannst einfach da sein und zuhören – und widerstehst dem Drang, alles zu lösen. Das ist selten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δώρο του να νιώθει κάποιος ότι τον ακούνε. Ξέρεις να δίνεις χώρο — και αντιστέκεσαι στην παρόρμηση να διορθώσεις. Σπάνιο αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El regalo de la escucha. Sabes acompañar sin querer arreglarlo todo, y eso es poco común."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ärakuulamise kingitus. Oskad teisele ruumi hoida — ja hoiad end tagasi, et mitte kohe parandada. See on haruldane."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entzuna izatearen oparia. Badakizu besteari lekua egiten, eta konpontzeko gogoari eusten diozu. Hori ez da ohikoa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدیهٔ شنیده شدن. بلدی فضا را برای دیگری نگه داری — و جلوی وسوسهٔ درست کردن را می‌گیری. این کمیاب است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulluksi tulemisen lahja. Osaat antaa tilaa ja vastustat halua korjata asioita. Se on harvinaista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang regalo ng pakikinig. Marunong kang magbigay ng espasyo — at pinipigilan mo ang tuksong ayusin agad. Bihira iyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadeau d'une vraie écoute. Tu sais accueillir ce que l'autre vit, sans chercher à tout réparer. C'est rare."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronntanas na héisteachta. Tá a fhios agat conas spás a choinneáil — agus seasann tú in aghaidh an fhonn rudaí a dheisiú. Is annamh é sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agasallo da escoita. Sabes acompañar sen invadir e resistes as ganas de arranxar. Iso é pouco común."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈને સાંભળવાની ભેટ. તમને જગ્યા આપતાં આવડે છે — અને સુધારવાની ઇચ્છાને તમે રોકી શકો છો. એ દુર્લભ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyautar a ji mutum. Kun san yadda ake ba da sarari — kuma kuna danne sha'awar gyarawa. Wannan ba kasafai ake samu ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המתנה של להרגיש מוקשבים. יש לך יכולת להכיל — ולהתאפק מהדחף לתקן. זה נדיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुने जाने का तोहफ़ा। किसी को अपनी बात कहने की जगह देना आपको आता है — और तुरंत हल बताने की इच्छा पर आपका क़ाबू रहता है। यह कम ही देखने को मिलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar da te netko čuje. Znaš pružiti prostor – i odoljeti porivu da popravljaš. To je rijetkost."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kado pou yo tande ou. Ou konnen kijan pou ou bay moun espas — e ou reziste anvi repare a. Sa ra."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az odafigyelés ajándéka. Tudsz teret tartani – és ellenállsz a késztetésnek, hogy megjavítsd a dolgokat. Ez ritka."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լսված լինելու նվերը։ Գիտես՝ ինչպես տարածք տալ, և զսպում ես ամեն ինչ «ուղղելու» ցանկությունը։ Դա հազվադեպ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memberi hadiah berupa rasa didengar. Kamu tahu cara menemani — dan menahan dorongan untuk langsung memperbaiki. Itu langka."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onyinye nke ịnụ olu mmadụ. Ị ma otu e si enye mmadụ ohere — ị na-ejidekwa onwe gị ka ị ghara ịrụzi ihe. Nke ahụ dị ụkọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sú gjöf að fá áheyrn. Þú kannt að skapa rými – og stenst freistinguna að laga. Það er sjaldgæft."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dono di sentirsi ascoltati. Sai fare spazio all’altro e resisti alla tentazione di aggiustare tutto. È raro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ちゃんと聴いてもらえた」と感じさせられる人。解決したくなる気持ちをこらえて、ただ受け止められるのは、なかなかできないことです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peparing bisa dirungokake. Panjenengan ngerti carane menehi ruang — lan bisa nahan kepinginan kanggo ndandani. Iku langka."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოსმენის საჩუქარი. იცი, როგორ შექმნა სივრცე სხვისთვის — და თავს იკავებ, რომ ყველაფერი გამოასწორო. ეს იშვიათია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тыңдалу деген сый. Сен адамға орын бере білесің, әрі түзетуге құмартуды тежей аласың. Бұл сирек кездеседі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អំណោយនៃការត្រូវបានស្ដាប់។ អ្នកដឹងពីរបៀបផ្ដល់ចន្លោះឲ្យគេ — ហើយទប់ចិត្តមិនប្រញាប់ដោះស្រាយ។ នោះជារឿងកម្រ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೇಳಿಸಿಕೊಳ್ಳುವುದೇ ಉಡುಗೊರೆ. ಇನ್ನೊಬ್ಬರಿಗೆ ಮನಬಿಚ್ಚಲು ಜಾಗ ಕೊಡುವುದು ನಿಮಗೆ ಗೊತ್ತು — ಸರಿಪಡಿಸುವ ತುಡಿತವನ್ನು ತಡೆಯುತ್ತೀರಿ. ಅದು ಅಪರೂಪ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들어 주는 것도 큰 선물이에요. 상대가 마음 놓고 털어놓을 수 있게 곁을 지키고, 고쳐 주고 싶은 마음을 참을 줄 알죠. 흔치 않은 능력이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diyariya hatin bihîstinê. Tu dizanî çawa cih ji kesekî re vekî — û tu li ber xwesteka çareserkirinê radiwestî. Ev kêm tê dîtin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Угулуу — чоң белек. Сен адамга орун бере аласың — жана оңдогуң келген каалоону токтото аласың. Бул сейрек кездешет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'Geschenk, gehéiert ze ginn. Du weess, wéi een engem Raum gëtt — an du widderstees dem Drang, alles ze léisen. Dat ass rar."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂອງຂວັນແຫ່ງການຖືກຮັບຟັງ ເຈົ້າຮູ້ວິທີໃຫ້ພື້ນທີ່ — ແລະ ອົດໃຈບໍ່ຮີບແກ້ໄຂ ເຊິ່ງຫາຍາກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išklausymo dovana. Moki sukurti erdvę jausmams ir susilaikai nuo noro viską pataisyti. Tai retas dalykas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzklausīšanas dāvana. Tu proti dot vietu otra jūtām un atturies no vēlmes visu salabot. Tas ir reti."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fanomezana ho re. Mahay manome toerana ianao — ary manohitra ny faniriana hanamboatra. Tsy fahita izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te koha o te rongohia. E mōhio ana koe ki te whakarato wāhi — ā, ka pupuri koe i te hiahia ki te whakatika. He mea onge tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарокот на вистинско слушање. Знаеш да создадеш простор за другиот — и го задржуваш поривот да поправаш. Тоа е ретко."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കേൾക്കപ്പെടുന്നതിന്റെ സമ്മാനം. ഒരാൾക്ക് ഇടം നൽകി കൂടെയിരിക്കാൻ നിങ്ങൾക്കറിയാം — എല്ലാം ശരിയാക്കാനുള്ള ത്വര നിങ്ങൾ അടക്കിനിർത്തുന്നു. അത് അപൂർവമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сонсогдох бэлэг. Чи хүнд орон зай гаргаж өгөхийг мэддэг — засах гэсэн хүслээ дардаг. Энэ ховор."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐकले जाण्याची देणगी. समोरच्याला मोकळी जागा कशी द्यायची हे तुम्हाला माहीत आहे — आणि सगळे लगेच दुरुस्त करण्याचा मोह तुम्ही टाळता. हे दुर्मीळ आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memberi sesuatu yang berharga: rasa didengari. Anda tahu cara memberi ruang — dan anda menahan diri daripada terus menyelesaikan masalah. Itu jarang ditemui."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-rigal li tinstema'. Taf kif tagħti spazju — u tirreżisti t-tentazzjoni li ssewwi. Dan rari."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နားထောင်ပေးခြင်းဆိုတဲ့ လက်ဆောင်။ တစ်ယောက်ယောက်အတွက် နေရာပေးထားတတ်တယ် — ပြင်ပေးချင်စိတ်ကိုလည်း ထိန်းနိုင်တယ်။ ဒါ ရှားပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaven det er å bli hørt. Du vet hvordan du gir rom – og du motstår trangen til å fikse. Det er sjeldent."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनिनुको उपहार। तपाईंलाई अरूको भावनालाई ठाउँ दिन आउँछ — र तुरुन्तै सुधार्ने इच्छालाई रोक्नुहुन्छ। यो दुर्लभ गुण हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het cadeau van gehoord worden. Je weet hoe je ruimte geeft – en je weerstaat de neiging om het op te lossen. Dat is zeldzaam."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mphatso yomveredwa. Mukudziwa kupatsa munthu malo — ndipo mumapewa kufuna kukonza. Zimenezo ndi zosowa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennaa dhaga'amuu. Iddoo nagaa akkamitti akka kennitu ni beekta — fedhii sirreessuus ni dandamatta. Kun baay'ee hin argamu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶୁଣାଯିବାର ଉପହାର। ଆପଣ ଜାଣନ୍ତି କିପରି ଧୈର୍ଯ୍ୟର ସହ ପାଖରେ ରହିବେ — ଆଉ ସବୁ ଠିକ୍ କରିଦେବାର ଇଚ୍ଛାକୁ ରୋକନ୍ତି। ଏହା ବିରଳ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੁਣੇ ਜਾਣ ਦਾ ਤੋਹਫ਼ਾ। ਤੁਹਾਨੂੰ ਕਿਸੇ ਲਈ ਥਾਂ ਬਣਾਉਣੀ ਆਉਂਦੀ ਹੈ — ਅਤੇ ਤੁਸੀਂ ਸਭ ਕੁਝ ਠੀਕ ਕਰਨ ਦੀ ਕਾਹਲ ਨੂੰ ਰੋਕ ਲੈਂਦੇ ਹੋ। ਇਹ ਘੱਟ ਹੀ ਦੇਖਣ ਨੂੰ ਮਿਲਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar wysłuchania. Umiesz po prostu być obok i słuchać – i powstrzymujesz się przed naprawianiem. To rzadkie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د اورېدل کېدو ډالۍ. تاسو پوهېږئ چې څنګه د بل لپاره ځای جوړ کړئ — او د سمولو له لېوالتیا ځان ساتئ. دا نادره ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O presente de ouvir de verdade. Você sabe acolher — e resiste à vontade de consertar. Isso é raro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dom de fazer alguém sentir-se ouvido. Sabes dar espaço — e resistes à vontade de resolver. Isso é raro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul de a fi auzit. Știi să faci loc celuilalt — și reziști tentației de a repara totul. E rar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты даришь другим ощущение, что их слышат. Ты умеешь просто быть рядом и не спешишь всё исправлять. Это редкость."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impano yo kumvwa. Uzi guha umuntu umwanya — kandi wirinda gushaka gukosora. Ibyo ni gake."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අහගෙන ඉන්න කෙනෙක් ලැබීමේ තෑග්ග. ඉඩ දෙන්න ඔබ දන්නවා — දේවල් හදන්න යන ආසාවත් ඔබ නවත්වාගන්නවා. ඒක දුර්ලභයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar načúvania. Vieš vytvoriť priestor – a odolať nutkaniu všetko opravovať. To je vzácne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar, da te nekdo sliši. Znaš ustvariti prostor – in se upreti želji po popravljanju. To je redkost."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chipo chekunzwika. Unoziva kupa munhu nzvimbo — uye unodzivisa kuda kugadzirisa. Izvozvo hazviwanzo kuwanikwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadiyadda ah in la maqlo. Waad taqaan sida qof meel loogu banneeyo — waadna iska celisaa rabitaanka inaad wax hagaajiso. Taasi waa wax naadir ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhurata e dëgjimit të vërtetë. Di të krijosh hapësirë – dhe i reziston dëshirës për të rregulluar. Kjo është e rrallë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дар да неко буде саслушан. Умеш да створиш простор — и одолеваш пориву да поправљаш. То је ретко."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kado dina bentuk didangukeun. Anjeun terang carana nyayogikeun rohangan, sareng anjeun nahan kahayang pikeun ngabenerkeun. Éta jarang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gåvan att bli hörd. Du kan ge någon utrymme – och motstå frestelsen att fixa. Det är sällsynt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawadi ya kusikilizwa. Unajua jinsi ya kumpa mtu nafasi — na unajizuia kutaka kurekebisha. Hilo ni nadra."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேட்கப்படுவது என்ற பரிசு. மற்றவருக்கு இடம் கொடுக்கத் தெரியும் — சரிசெய்யும் ஆசையையும் கட்டுப்படுத்துவீர்கள். இது அரிது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వినబడటమే ఒక కానుక. ఎదుటివారికి చోటు ఇవ్వడం మీకు తెలుసు — సరిదిద్దాలనే ఆతృతను ఆపుకుంటారు. అది అరుదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тӯҳфаи шунида шудан. Ту медонӣ, ки чӣ тавр барои касе ҷой нигоҳ дорӣ — ва ба хоҳиши «ислоҳ кардан» тан намедиҳӣ. Ин нодир аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมอบของขวัญแห่งการรับฟัง คุณรู้วิธีเปิดพื้นที่ให้อีกฝ่าย และอดใจไม่รีบแก้ปัญหาให้ ซึ่งหาได้ยากมาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ውህበት ምስማዕ። ቦታ ምሃብ ትፈልጡ — ንምዕራይ ዘሎ ድሌት ድማ ትቋወምዎ። እዚ ሳሕቲ እዩ ዝርከብ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diňlenmek — sowgat. Adamyň duýgularyna ýer berip bilýärsiň — we düzetmek islegiňi saklaýarsyň. Bu seýrek zat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duyulmanın armağanı. Alan açmayı biliyorsun ve her şeyi düzeltme isteğine direniyorsun. Bu nadir bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти даруєш людям відчуття, що їх чують. Ти вмієш просто бути поруч і стримуєш бажання все виправити. Це рідкість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنے جانے کا تحفہ۔ دوسروں کو اپنی بات کہنے کی جگہ دینا آپ کو آتا ہے، اور سب ٹھیک کر دینے کی خواہش پر قابو بھی۔ یہ نایاب ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eshitilish inʼomi. Siz tinglashni bilasiz — va tuzatishga boʻlgan istakni tiyib turasiz. Bu kamdan-kam uchraydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món quà được lắng nghe. Bạn biết cách ở bên — và kìm được mong muốn sửa chữa mọi thứ. Điều đó hiếm lắm."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isipho sokuviwa. Uyakwazi ukunika umntu isithuba — kwaye uyakuxhathisa ukufuna ukulungisa. Oko kunqabile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ̀bùn kí a gbọ́ ẹni. Ẹ mọ bí a ṣe ń fún ẹlòmíì ní àyè — ẹ sì ń kọ ìfẹ́ láti tún nǹkan ṣe. Ìyẹn ṣọ̀wọ́n."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓人感到被聆聽是一份禮物。你懂得留出空間，也忍得住想解決問題的衝動。這很難得。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让对方被听见，是一份礼物。你懂得给对方空间，也忍得住不急着去“解决”，这很难得。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓人被聽見，是一份禮物。你懂得接住對方的情緒，也忍得住想解決問題的衝動，這很難得。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isipho sokuzwakala. Uyakwazi ukunika umuntu isikhala — futhi uyakumelana nesifiso sokulungisa. Lokho akuvamile."
          }
        }
      }
    },
    "The last thing you touched before this." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die laaste ding wat jy voor dit aangeraak het."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከዚህ በፊት የነኩት የመጨረሻ ነገር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر شيء لمستموه قبل هذا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইয়াৰ আগতে আপুনি শেষত চুই থকা বস্তুটো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundan əvvəl toxunduğun son şey."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Апошняе, што было ў тваіх руках перад гэтым."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последното нещо, което докосна преди това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর আগে শেষ যে জিনিসটা ছুঁয়েছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ono što ti je bilo u rukama prije ovoga."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'última cosa que has tocat abans d'això."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslední věc, která ti před tímhle prošla rukama."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y peth olaf i ti ei gyffwrdd cyn hyn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sidste, du rørte ved før det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Letzte, was du davor angefasst hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τελευταίο πράγμα που άγγιξες πριν από αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo último que tocaste antes de esto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimane asi, mida enne seda puudutasid."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honen aurretik ukitu duzun azken gauza."
          }
        },
        "fa" : {
