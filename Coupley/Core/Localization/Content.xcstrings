    "Being chosen, consistently. Not just at the beginning — but every day after that too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن يقع عليك الاختيار دائمًا. ليس في البداية فقط، بل في كل يوم بعدها أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vědět, že si tě ten druhý vybírá, pořád znovu. Nejen na začátku – ale i každý další den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At blive valgt, igen og igen. Ikke kun i starten – men også hver eneste dag derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer wieder gewählt werden. Nicht nur am Anfang – sondern auch an jedem Tag danach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να σε επιλέγουν σταθερά. Όχι μόνο στην αρχή — αλλά και κάθε μέρα μετά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir que te eligen, siempre. No solo al principio — también cada día después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulla valituksi yhä uudelleen. Ei vain alussa – vaan joka ikinen päivä sen jälkeenkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mapili, palagi. Hindi lang sa simula — kundi araw-araw pagkatapos noon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que l'autre te choisisse, encore et encore. Pas seulement au début — mais chaque jour qui suit aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיבחרו בך, שוב ושוב. לא רק בהתחלה — אלא גם כל יום אחרי זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बार चुना जाना। सिर्फ़ शुरुआत में नहीं — उसके बाद हर दिन भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy következetesen téged válasszanak. Nem csak az elején – hanem utána minden egyes nap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih, terus-menerus. Bukan cuma di awal — tapi juga setiap hari setelahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essere la sua scelta, ogni volta. Non solo all’inizio — ma anche ogni giorno a seguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも選ばれ続けること。最初だけでなく、そのあとも毎日。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변함없이 선택받는 것이에요. 처음에만이 아니라, 그 후로도 매일매일요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih, secara konsisten. Bukan hanya di awal — tetapi setiap hari selepas itu juga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å bli valgt, hver gang. Ikke bare i starten – men hver eneste dag etterpå også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steeds opnieuw gekozen worden. Niet alleen in het begin – maar ook elke dag daarna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadomość, że ktoś wybiera cię konsekwentnie. Nie tylko na początku – ale też każdego kolejnego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser a escolha, sempre. Não só no começo — mas todos os dias depois também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să te aleagă, constant. Nu doar la început — ci și în fiecare zi de după."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда тебя выбирают — снова и снова. Не только в начале, но и каждый день после."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att bli vald, gång på gång. Inte bara i början – utan varje dag efter det också."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความภักดีและความมั่นคงต่อกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her seferinde seçilmek. Sadece başta değil, sonraki her gün de."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли тебе обирають — постійно. Не лише на початку, а й щодня після того."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn được chọn. Không chỉ lúc ban đầu — mà cả mỗi ngày sau đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终被坚定地选择。不只是在开始的时候，之后的每一天也是。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一直被堅定地選擇。不只是剛開始的時候，而是之後的每一天。"
          }
        }
      }
    },
