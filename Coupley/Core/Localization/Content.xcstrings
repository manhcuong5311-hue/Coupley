        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuvinte sincere, spuse direct"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искренние слова в лицо"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppriktiga ord, sagda direkt till mig"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำพูดจริงใจที่พูดกับฉันตรงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzüme söylenen içten sözler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щирі слова віч-на-віч"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời chân thành nói trực tiếp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当面真诚地说出来"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當面真誠地說出來"
          }
        }
      }
    },
    "Sit beside them without talking. Let the silence do the work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلسوا بجانب شريكك دون كلام. دعوا الصمت يقوم بالمهمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedni si vedle protějšku a nic neříkej. Nech ticho pracovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt dig ved siden af din partner uden at sige noget. Lad stilheden gøre arbejdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich still dazu. Lass die Stille wirken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτσε δίπλα στο ταίρι σου χωρίς να μιλάς. Άσε τη σιωπή να κάνει τη δουλειά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate a su lado sin hablar. Deja que el silencio haga su trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istu hänen vierelleen puhumatta. Anna hiljaisuuden tehdä työnsä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umupo sa tabi niya nang walang imik. Hayaang ang katahimikan ang kumilos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi à côté sans parler. Laisse le silence faire son œuvre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשבת ליד, בלי לדבר. לתת לשקט לעשות את העבודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना कुछ कहे उनके पास बैठ जाएँ। ख़ामोशी को अपना काम करने दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülj le mellé szó nélkül. Hagyd, hogy a csend tegye a dolgát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk di sampingnya tanpa bicara. Biarkan hening yang bekerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti accanto al tuo partner senza parlare. Lascia che sia il silenzio a fare il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も話さず、隣に座りましょう。沈黙にまかせて大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 말 없이 곁에 앉아 있어 주세요. 침묵이 대신 위로해 줄 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk di sisinya tanpa bercakap. Biar kesunyian yang berbicara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett deg ved siden av partneren din uten å si noe. La stillheten gjøre jobben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga naast je partner zitten zonder te praten. Laat de stilte het werk doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiądź obok bez słów. Niech cisza zrobi swoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente ao lado do seu amor sem falar nada. Deixe o silêncio agir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai lângă partenerul tău fără să vorbești. Lasă tăcerea să lucreze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посиди рядом молча. Пусть тишина сделает своё дело."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätt dig bredvid din partner utan att prata. Låt tystnaden göra jobbet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นั่งข้างๆ โดยไม่ต้องพูดอะไร ปล่อยให้ความเงียบทำหน้าที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmadan yanına otur. Bırak sessizlik işini yapsın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посидь поруч без слів. Нехай тиша зробить своє."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngồi cạnh người ấy mà không cần nói gì. Để sự im lặng làm phần còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静地坐在另一半身边，不用说话，让沉默来陪伴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安靜坐在另一半身旁，什麼都不用說，讓沉默發揮作用。"
          }
        }
      }
    },
    "Sit close. Say less. Let them lean if they want to." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقتربوا. قلّلوا الكلام. اسمحوا لشريكك بالاتكاء عليكم إن أراد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedni si blízko. Mluv méně. Když bude chtít, ať se o tebe opře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt dig tæt på. Sig mindre. Lad din partner læne sig ind, hvis lysten er der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich nah dazu. Sag wenig. Biete eine Schulter zum Anlehnen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτσε κοντά. Μίλα λιγότερο. Άσε το ταίρι σου να γείρει πάνω σου, αν θέλει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate cerca. Habla poco. Deja que se apoye en ti si quiere."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istu lähellä. Puhu vähemmän. Anna hänen nojata, jos hän haluaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umupo nang malapit. Bawasan ang salita. Hayaan siyang sumandal kung gusto niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapproche-toi. Parle moins. Laisse l'autre s'appuyer sur toi si l'envie est là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשבת קרוב. לדבר פחות. לתת להישען, אם רוצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पास बैठें। कम बोलें। चाहें तो उन्हें अपने कंधे पर टिकने दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülj közel. Beszélj kevesebbet. Hagyd, hogy hozzád bújjon, ha szeretne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk dekat. Sedikit bicara. Biarkan dia bersandar kalau mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai vicino. Parla poco. Lascia che si appoggi a te, se vuole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そばに座って、言葉は少なめに。寄りかかりたければ、そうさせてあげましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까이 앉아 말은 아끼세요. 원하면 기댈 수 있게요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk dekat. Kurangkan bercakap. Biar dia bersandar jika dia mahu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitt tett. Si lite. La partneren din lene seg inntil hvis det kjennes riktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga dichtbij zitten. Zeg weinig. Laat je partner tegen je aan leunen als dat fijn is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiądź blisko. Mów mniej. Pozwól się oprzeć, jeśli druga połówka zechce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique perto. Fale menos. Deixe seu amor se apoiar em você, se quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai aproape. Vorbește puțin. Lasă-i loc să se sprijine de tine, dacă vrea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь поближе. Говори меньше. Дай партнёру опереться, если захочется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitt nära. Säg mindre. Låt din partner luta sig mot dig om det känns rätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นั่งใกล้ๆ พูดให้น้อย ปล่อยให้คนรักพิงถ้าอยากพิง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınına otur. Az konuş. İsterse sana yaslansın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь ближче. Говори менше. Дай прихилитися, якщо захочеться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngồi gần. Nói ít thôi. Để người ấy tựa vào nếu muốn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐近一点，少说几句。如果另一半想靠过来，就让对方靠着。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐近一點，少說一點。對方想靠過來，就讓對方靠著。"
          }
        }
      }
    },
