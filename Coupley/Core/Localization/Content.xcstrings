    "A growing skill you're investing in. This is a great shared activity — especially if your partner can teach you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مهارة تنمو باستثمارك فيها. نشاط رائع لتتشاركاه، خاصة إن كان شريكك قادرًا على تعليمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovednost, do které investuješ. Skvělá společná aktivita – zvlášť když tě tvůj protějšek může něco naučit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En færdighed i vækst, som du investerer i. Det er en skøn fælles aktivitet – især hvis din partner kan lære dig noget."
