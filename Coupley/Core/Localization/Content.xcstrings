        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan urip ing saiki. Anggaran bareng bisa uga rumangsa ngiket ing wiwitan, nanging sabenere bisa menehi luwih akeh kamardikan ing tembe mburi."
