    "Curiosity > routine. Bypass the 'how was work.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفضول قبل الروتين. تجاوزوا سؤال «كيف كان العمل؟»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvědavost > rutina. Přeskoč „jak bylo v práci“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nysgerrighed slår rutine. Spring »hvordan var arbejdet?« over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neugier schlägt Routine. Lass das „Wie war die Arbeit?“ weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η περιέργεια νικάει τη ρουτίνα. Παράκαμψε το «πώς ήταν η δουλειά»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosidad antes que rutina. Sáltate el “¿qué tal el trabajo?”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uteliaisuus voittaa rutiinin. Ohita ”miten töissä meni”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas mahalaga ang curiosity kaysa routine. Lampasan ang “kumusta ang trabaho.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La curiosité avant la routine. Oublie le « ta journée s'est bien passée ? »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סקרנות > שגרה. לדלג על \"איך היה בעבודה\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रूटीन से ज़्यादा जिज्ञासा। “काम कैसा रहा” से आगे बढ़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kíváncsiság a rutin helyett. Hagyd ki a „milyen volt a munka?” kérdést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa ingin tahu mengalahkan rutinitas. Lewati “gimana kerjaan tadi.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La curiosità batte la routine. Salta il «com’è andata al lavoro»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの決まり文句より好奇心を。「仕事どうだった？」はひと休み。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뻔한 질문보다 호기심이에요. “일은 어땠어요?”는 건너뛰세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa ingin tahu mengatasi rutin. Langkau soalan “kerja macam mana tadi.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nysgjerrighet slår rutine. Hopp over «hvordan var jobben»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwsgierigheid wint van routine. Sla het “hoe was je werk?” over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciekawość wygrywa z rutyną. Pomiń „jak było w pracy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosidade acima da rotina. Fuja do “como foi o trabalho”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiozitatea bate rutina. Sari peste „cum a fost la muncă”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любопытство важнее рутины. Обойдись без «как работа?»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyfikenhet > rutin. Hoppa över ”hur var jobbet”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความอยากรู้ชนะความเคยชิน ข้ามคำถาม “งานเป็นไงบ้าง” ไปเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merak, rutinden iyidir. “İş nasıldı?” sorusunu atla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цікавість > рутина. Обійдися без «як на роботі»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tò mò hơn thói quen. Bỏ qua câu “đi làm thế nào”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好奇胜过例行公事。跳过“今天工作怎么样”。"
          }
