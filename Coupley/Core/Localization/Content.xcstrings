          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drömjobbet, helt utan begränsningar. Även om det känns utom räckhåll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานในฝันแบบไม่มีข้อจำกัดใดๆ ถึงจะรู้สึกว่าไกลเกินเอื้อมก็ตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir sınırı olmayan hayalindeki iş. Ulaşılmaz gibi görünse bile."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота мрії без жодних обмежень. Навіть якщо здається недосяжною."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc mơ ước, không chút giới hạn. Dù nó có vẻ xa vời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全不受限制的梦想职业，哪怕感觉遥不可及。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全不設限的夢想工作，就算感覺遙不可及也沒關係。"
