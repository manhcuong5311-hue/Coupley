        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itanong: “gusto mo bang maglabas ng sama ng loob, humanap ng solusyon, o malibang?”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande : « tu veux vider ton sac, chercher une solution ou te changer les idées ? »"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשאול: \"בא לך לפרוק, לפתור או להתנתק קצת?\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूछें: “मन हल्का करना है, हल ढूँढना है, या ध्यान बँटाना है?”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezd meg: „Kiadnád magadból, megoldanád, vagy elterelnéd a figyelmed?”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan: “mau curhat, cari solusi, atau dialihkan?”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi: «Vuoi sfogarti, trovare una soluzione o distrarti?»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「吐き出したい？一緒に解決したい？気をまぎらわせたい？」と聞いてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“털어놓고 싶어요, 같이 해결하고 싶어요, 아니면 다른 데 신경 돌리고 싶어요?” 하고 물어보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya: “Nak luahkan, cari penyelesaian atau nak lupakan sekejap?”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør: «Vil du lufte det, løse det eller tenke på noe annet?»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag: “Wil je stoom afblazen, het oplossen of afgeleid worden?”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj: „Chcesz się wygadać, poszukać rozwiązania czy oderwać myśli?”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte: “quer desabafar, resolver ou se distrair?”"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreabă: „vrei să te descarci, să găsim o soluție sau să te distrag puțin?”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спроси: «Хочешь выговориться, найти решение или отвлечься?»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga: ”Vill du ventilera, lösa problemet eller tänka på annat?”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองถามว่า “อยากระบาย อยากหาทางออก หรืออยากลืมเรื่องนี้ไปสักพัก”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sor: “İçini dökmek mi, çözüm bulmak mı, yoksa kafanı dağıtmak mı istersin?”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спитай: «Хочеш виговоритися, знайти рішення чи відволіктися?»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi: “bạn muốn trút hết ra, cùng tìm cách giải quyết, hay muốn quên đi một lúc?”"
