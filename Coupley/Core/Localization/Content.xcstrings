        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उम्र भर की मेहनत का इनाम है दुनिया देखना। शायद आपकी बचत आज़ादी के उसी रूप के लिए है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy élet munkájának jutalma, hogy bejárhatod a világot. Valószínűleg a szabadság egy formájára gyűjtesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadiah dari hidup penuh kerja adalah melihat dunia. Kamu mungkin sedang menabung untuk versi kebebasanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricompensa per una vita di lavoro è vedere il mondo. Probabilmente stai risparmiando per una tua idea di libertà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "働いてきたご褒美は、世界を見ること。きっと自分なりの自由に向けて貯めているのでしょう。"
