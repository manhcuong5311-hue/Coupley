            "value" : "တစ်ကြောင်းပဲ ပို့ပါ: “ပြန်စာ မလိုပါဘူး — သတိရနေတယ်။”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send én linje: «Du trenger ikke svare – tenker på deg.»"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक लाइन पठाउनुहोस्: ‘जवाफ दिनुपर्दैन — तपाईंको याद आइरहेको छ।’"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur één zinnetje: “Je hoeft niet te reageren – ik denk aan je.”"
          }
        },
        "ny" : {
