          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri masa dan biarkan ia reda sendiri"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi det tid og la det roe seg av seg selv"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijd geven en het vanzelf laten zakken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daję temu czas, niech samo się ułoży"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar tempo ao tempo"
          }
        },
        "ro" : {
          "stringUnit" : {
