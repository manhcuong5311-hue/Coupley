        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሚዛን። ክትቆጻጸሩ ኣይትደልዩን፣ ግን ሓደ ሰብ ፍርቁ ጥራይ ኣብኡ ምስ ዝህሉ ተስተብህሉ።"
