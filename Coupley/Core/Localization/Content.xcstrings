        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngamanye amaxesha olona thandano lungcono lolo kungekho mntu kufuneka anxibe izihlangu. Intuthuzelo nokukhululeka ngaphezu kwemekobume."
