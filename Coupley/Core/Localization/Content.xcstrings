          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జీవిత చివరి దశను మీరు ఎలా ఊహించుకుంటారన్నది, ఇప్పుడు మీరు దేనికి విలువ ఇస్తారో చాలా చెబుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он ки охири роҳро чӣ тавр тасаввур мекунӣ, бисёр чизро дар бораи арзишҳои имрӯзаат нишон медиҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพบั้นปลายชีวิตที่คุณวาดไว้บอกได้มากว่าตอนนี้คุณให้คุณค่ากับอะไร"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነቲ መወዳእታ ከመይ ከም እትርእይዎ፣ ሕጂ ንእትሰልጥዎ ብዙሕ ይገልጽ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahyrky maksady nähili göz öňüne getirýäniň, häzir nämä gymmat berýändigiň hakda köp zat aýdýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son durağı nasıl hayal ettiğin, şu an neye değer verdiğin hakkında çok şey söyler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, як ти уявляєш фінал, багато говорить про те, що ти цінуєш зараз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری منزل کا آپ کا تصور بتاتا ہے کہ آج آپ کے لیے کیا اہم ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayotning yakuniy bosqichini qanday tasavvur qilishingiz hozir nimani qadrlashingiz haqida koʻp narsa aytadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách bạn hình dung chặng cuối cho thấy nhiều điều về những gì bạn coi trọng lúc này."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlela obona ngayo isiphelo ibonisa okuninzi malunga noko ukuxabisayo ngoku."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bí ẹ ṣe ń wo òpin ìrìn àjò ń fi púpọ̀ hàn nípa ohun tí ẹ mọyì báyìí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你怎樣想像人生的終章，很能反映你現在重視甚麼。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你怎么想象人生的终章，很能说明你现在看重什么。"
          }
