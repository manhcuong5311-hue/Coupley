        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cydweithio fel rhamant. Mae'r gegin yn troi'n amser gwerthfawr ynddi'i hun — ac rydych chi'n cael pryd o fwyd ar y diwedd."
