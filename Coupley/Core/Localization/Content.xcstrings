          "stringUnit" : {
            "state" : "translated",
            "value" : "वह शौक़ अब भी अंदर है। बस ज़िंदगी की भागदौड़ में पीछे छूट गया। किताबें सुझाने वाला पार्टनर शायद वही हल्का-सा धक्का हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még benned van. Az élet kiszorította. Egy könyveket ajánlgató társ lehet a lökés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minatnya masih ada. Hanya tergeser kesibukan. Pasangan yang suka merekomendasikan buku mungkin bisa jadi pendorongnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passione c’è ancora. La vita le ha tolto spazio. Un partner che ti consiglia libri potrebbe essere la spinta giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その気持ちはまだ残っています。忙しさに押し出されただけ。本をすすめてくれるパートナーが、きっかけになるかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음은 여전히 남아 있어요. 바쁜 삶에 밀려났을 뿐이죠. 책을 추천해 주는 연인이 계기가 될지도 몰라요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minat itu masih ada. Kesibukan hidup menenggelamkannya. Pasangan yang suka mencadangkan buku mungkin jadi pendorongnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er der fortsatt. Livet presset det bort. En partner som anbefaler bøker, kan være dultet du trenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zit er nog in. Het leven drong het naar de achtergrond. Een partner die boeken aanraadt, kan het seintje zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wciąż w tobie jest. Życie po prostu to wyparło. Druga połówka, która poleca książki, może być tym impulsem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso ainda está aí. A vida foi ocupando o espaço. Um amor que indica livros pode ser o empurrãozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă e acolo. Viața doar l-a împins pe plan secundar. Un partener care recomandă cărți ar putea fi imboldul de care ai nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любовь к чтению никуда не делась — её просто вытеснила жизнь. Партнёр, который советует книги, может стать тем самым толчком."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns kvar där inne. Livet trängde undan det. En partner som tipsar om böcker kan vara knuffen du behöver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความชอบนั้นยังอยู่ แค่ชีวิตเบียดมันออกไป คนรักที่ชอบแนะนำหนังสืออาจเป็นแรงกระตุ้นที่ใช่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O istek hâlâ orada. Hayatın yoğunluğu onu geri plana itti. Kitap öneren bir partner o küçük itici güç olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любов до читання нікуди не ділася — просто життя її витіснило. Половинка, яка радить книжки, може стати тим поштовхом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niềm yêu sách vẫn còn đó. Cuộc sống chỉ lấn mất chỗ của nó. Nếu người ấy hay giới thiệu sách, đó có thể là cú hích bạn cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它还在那儿，只是被生活挤掉了。一个爱推荐书的另一半，也许就是那个小提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份興趣還在，只是被生活擠掉了。愛推薦書的另一半，也許就是那個小推力。"
          }
        }
      }
    },
