    "Travel as experience and challenge. You want to come back having done something you couldn't do at home." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السفر عندكم تجربة وتحدٍّ. تريدون العودة وقد فعلتم شيئًا لا يمكن فعله في حياتكم اليومية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestování jako zážitek a výzva. Chceš se vrátit s něčím, co doma zažít nejde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejser som oplevelse og udfordring. Du vil komme hjem efter at have gjort noget, du ikke kunne gøre derhjemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen als Erlebnis und Herausforderung. Du willst mit etwas zurückkommen, das du zu Hause nie hättest tun können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ταξίδι ως εμπειρία και πρόκληση. Θέλεις να γυρίσεις έχοντας κάνει κάτι που δεν θα μπορούσες να κάνεις στο σπίτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajar como experiencia y como reto. Quieres volver habiendo hecho algo que no podrías hacer en casa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matkailu kokemuksena ja haasteena. Haluat palata kotiin tehtyäsi jotain, mihin et kotona pystyisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang biyahe ay karanasan at hamon. Gusto mong umuwi nang may nagawang hindi mo magagawa sa bahay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voyage comme expérience et comme défi. Tu veux revenir en ayant fait quelque chose d'impossible chez toi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיול כחוויה וכאתגר. המטרה שלך היא לחזור אחרי שעשית משהו שאי אפשר לעשות בבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए सफ़र अनुभव और चुनौती है। आप कुछ ऐसा करके लौटना चाहते हैं जो घर पर मुमकिन न हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utazás élmény és kihívás. Úgy akarsz hazajönni, hogy olyat csináltál, amit otthon nem tudtál volna."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traveling sebagai pengalaman dan tantangan. Kamu ingin pulang setelah melakukan sesuatu yang nggak bisa kamu lakukan di rumah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il viaggio come esperienza e sfida. Vuoi tornare dopo aver fatto qualcosa che a casa non potresti fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅は体験であり挑戦。ふだんの生活ではできないことをやり遂げて帰ってきたいタイプです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행은 경험이자 도전이에요. 집에서는 못 할 무언가를 해내고 돌아오고 싶어 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melancong sebagai pengalaman dan cabaran. Anda mahu pulang setelah melakukan sesuatu yang tidak dapat dilakukan di rumah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reise som opplevelse og utfordring. Du vil komme hjem etter å ha gjort noe du ikke kunne gjort hjemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizen als beleving en uitdaging. Je wilt terugkomen met iets wat je thuis nooit had kunnen doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podróż jako przeżycie i wyzwanie. Chcesz wrócić z czymś, czego nie da się przeżyć w domu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viagem como experiência e desafio. Você quer voltar tendo feito algo que não daria para fazer em casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călătoria ca experiență și provocare. Vrei să te întorci după ce ai făcut ceva ce n-ai putea face acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приключения на природе — испытать себя"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resor som upplevelse och utmaning. Du vill komma hem efter att ha gjort något du inte kunde göra hemma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเที่ยวคือประสบการณ์และความท้าทาย คุณอยากกลับมาโดยได้ทำสิ่งที่ไม่มีทางทำได้ที่บ้าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin için seyahat, deneyim ve meydan okuma demek. Evde yapamayacağın bir şeyi yapmış olarak dönmek istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подорож як досвід і виклик. Тобі хочеться повернутися з чимось, чого вдома не зробиш."
          }
        },
        "vi" : {
          "stringUnit" : {
