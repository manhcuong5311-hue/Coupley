        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isimo sibalulekile. Uhambo lwempelasonto edolobheni kanye nohambo lwasemshadweni kudinga izabelomali ezihlukene. Uyakuqonda okwenzekayo."
