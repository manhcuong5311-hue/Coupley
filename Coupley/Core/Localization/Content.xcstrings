        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آگے کی طرف دیکھنے والے سوال تعلق کو گہرا کرتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelajakka qaratilgan savollar bogʻliqlikni chuqurlashtiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những câu hỏi hướng về phía trước giúp gắn kết sâu hơn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imibuzo ejonge phambili yenza unxibelelwano lube nzulu."
