        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị nwere ike ime ihe ndị ahụ mana ọ na-ewe gị ike. Oge izu ike mgbe mmemme gasịrị dị mkpa n'ezie nye gị."
