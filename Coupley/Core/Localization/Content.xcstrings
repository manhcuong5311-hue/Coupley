        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbéèrè nípa ọjọ́ iwájú ń mú ìsopọ̀ jinlẹ̀ sí i."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展望將來的問題，能加深彼此的連結。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊聊未来的问题，能让彼此更靠近。"
