    "Travel as experience and challenge. You want to come back having done something you couldn't do at home." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reis as ervaring en uitdaging. Jy wil terugkom en iets gedoen hê wat jy nie by die huis kon doen nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጉዞ እንደ ልምድና ፈተና። በቤት ውስጥ ማድረግ የማይችሉትን ነገር አድርገው መመለስ ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السفر عندكم تجربة وتحدٍّ. تريدون العودة وقد فعلتم شيئًا لا يمكن فعله في حياتكم اليومية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অভিজ্ঞতা আৰু প্ৰত্যাহ্বান হিচাপে ভ্ৰমণ। ঘৰত কৰিব নোৱৰা কিবা এটা কৰি আপুনি উভতি আহিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səyahət təcrübə və sınaqdır. Evdə edə bilməyəcəyin bir şeyi edib qayıtmaq istəyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падарожжа як вопыт і выклік. Табе хочацца вярнуцца, зрабіўшы тое, што немагчыма дома."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пътуването като преживяване и предизвикателство. Искаш да се върнеш с нещо, което у дома е невъзможно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণ মানে অভিজ্ঞতা আর চ্যালেঞ্জ। তুমি এমন কিছু করে ফিরতে চাও, যা বাড়িতে বসে করা যেত না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putovanje kao iskustvo i izazov. Želiš se vratiti s doživljajem kakav kod kuće nije moguć."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viatjar com a experiència i repte. Vols tornar havent fet alguna cosa que no podries fer a casa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestování jako zážitek a výzva. Chceš se vrátit s něčím, co doma zažít nejde."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teithio fel profiad a her. Rwyt ti eisiau dod adref ar ôl gwneud rhywbeth na allet ti ei wneud gartref."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejser som oplevelse og udfordring. Du vil komme hjem efter at have gjort noget, du ikke kunne gøre derhjemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen als Erlebnis und Herausforderung. Du willst mit etwas zurückkommen, das du zu Hause nie hättest tun können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ταξίδι ως εμπειρία και πρόκληση. Θέλεις να γυρίσεις έχοντας κάνει κάτι που δεν θα μπορούσες να κάνεις στο σπίτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajar como experiencia y como reto. Quieres volver habiendo hecho algo que no podrías hacer en casa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reis kui kogemus ja väljakutse. Tahad tagasi tulla, olles teinud midagi, mida kodus teha ei saaks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidaia, esperientzia eta erronka gisa. Etxean egin ezin zenuen zerbait eginda itzuli nahi duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر به‌عنوان تجربه و چالش. می‌خواهی وقتی برمی‌گردی کاری کرده باشی که در خانه نمی‌شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matkailu kokemuksena ja haasteena. Haluat palata kotiin tehtyäsi jotain, mihin et kotona pystyisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang biyahe ay karanasan at hamon. Gusto mong umuwi nang may nagawang hindi mo magagawa sa bahay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voyage comme expérience et comme défi. Tu veux revenir en ayant fait quelque chose d'impossible chez toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisteal mar eispéireas agus dúshlán. Ba mhaith leat teacht abhaile tar éis rud a dhéanamh nach bhféadfá a dhéanamh sa bhaile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaxar como experiencia e reto. Queres volver tendo feito algo que non poderías facer na casa."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મુસાફરી એટલે અનુભવ અને પડકાર. તમારે ઘરે ન થઈ શકે એવું કંઈક કરીને પાછા આવવું છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tafiya a matsayin gogewa da ƙalubale. Kuna son ku dawo bayan kun yi abin da ba za ku iya yi a gida ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיול כחוויה וכאתגר. המטרה שלך היא לחזור אחרי שעשית משהו שאי אפשר לעשות בבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए सफ़र अनुभव और चुनौती है। आप कुछ ऐसा करके लौटना चाहते हैं जो घर पर मुमकिन न हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putovanje kao iskustvo i izazov. Želiš se vratiti s iskustvom koje kod kuće nije moguće."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vwayaj kòm eksperyans ak defi. Ou vle tounen apre ou fin fè yon bagay ou pa t ka fè lakay."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utazás élmény és kihívás. Úgy akarsz hazajönni, hogy olyat csináltál, amit otthon nem tudtál volna."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճամփորդությունը որպես փորձառություն ու մարտահրավեր։ Ուզում ես վերադառնալ՝ արած լինելով մի բան, որ տանը չէիր կարող։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traveling sebagai pengalaman dan tantangan. Kamu ingin pulang setelah melakukan sesuatu yang nggak bisa kamu lakukan di rumah."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njem dịka ahụmahụ na ihe ịma aka. Ị chọrọ ịlọta ebe i mere ihe ị na-enweghị ike ime n'ụlọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferðalög sem upplifun og áskorun. Þú vilt koma heim eftir að hafa gert eitthvað sem þú gætir ekki gert heima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il viaggio come esperienza e sfida. Vuoi tornare dopo aver fatto qualcosa che a casa non potresti fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅は体験であり挑戦。ふだんの生活ではできないことをやり遂げて帰ってきたいタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lelungan minangka pengalaman lan tantangan. Panjenengan pengin bali sawise nglakoni bab sing ora bisa dilakoni ing omah."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოგზაურობა, როგორც გამოცდილება და გამოწვევა. გინდა, დაბრუნდე ისეთი რამის გაკეთების შემდეგ, რასაც სახლში ვერ გააკეთებდი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапар — әсер әрі сынақ. Үйде істей алмайтын бір нәрсені жасап қайтқың келеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការធ្វើដំណើរជាបទពិសោធន៍ និងបញ្ហាប្រឈម។ អ្នកចង់ត្រឡប់មកវិញ ក្រោយបានធ្វើអ្វីមួយដែលមិនអាចធ្វើនៅផ្ទះបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರವಾಸ ಎಂದರೆ ಅನುಭವ ಮತ್ತು ಸವಾಲು. ಮನೆಯಲ್ಲಿ ಮಾಡಲಾಗದ ಏನನ್ನಾದರೂ ಮಾಡಿ ಮರಳಬೇಕು ನಿಮಗೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행은 경험이자 도전이에요. 집에서는 못 할 무언가를 해내고 돌아오고 싶어 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ger wekî ezmûn û ceribandin. Tu dixwazî vegerî û te tiştek kiribe ku li malê nedikarî bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саякат — тажрыйба жана сыноо. Үйдө кыла албаган бир нерсени жасап кайткың келет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reesen als Erliefnes an Erausfuerderung. Du wëlls heemkommen an eppes gemaach hunn, wat doheem net méiglech wier."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການທ່ຽວຄືປະສົບການ ແລະ ການທ້າທາຍ ເຈົ້າຢາກກັບມາພ້ອມກັບສິ່ງທີ່ເຮັດບໍ່ໄດ້ຢູ່ເຮືອນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelionė kaip patirtis ir iššūkis. Nori grįžti padarius tai, ko namie padaryti negalėtum."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceļojums kā piedzīvojums un izaicinājums. Tu gribi atgriezties ar kaut ko paveiktu, ko mājās nevarētu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny dia ho traikefa sy fanamby. Te hiverina ianao rehefa nanao zavatra tsy azonao atao tany an-trano."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te haere he wheako, he wero. E hiahia ana koe kia hoki mai me te mōhio kua mahi koe i tētahi mea kāore e taea ki te kāinga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Патувањето како доживување и предизвик. Сакаш да се вратиш откако ќе направиш нешто што дома не можеш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "യാത്ര ഒരു അനുഭവവും വെല്ലുവിളിയുമാണ് നിങ്ങൾക്ക്. വീട്ടിലിരുന്ന് ചെയ്യാനാവാത്ത എന്തെങ്കിലും ചെയ്തിട്ടാകണം തിരിച്ചുവരവ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аялал бол туршлага, сорилт. Чи гэртээ хийж чадахгүй зүйл хийгээд буцаж ирэхийг хүсдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रवास म्हणजे अनुभव आणि आव्हान. घरी करता येणार नाही असे काहीतरी करून तुम्हाला परत यायचे असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melancong sebagai pengalaman dan cabaran. Anda mahu pulang setelah melakukan sesuatu yang tidak dapat dilakukan di rumah."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-vjaġġ bħala esperjenza u sfida. Trid terġa' lura wara li għamilt xi ħaġa li d-dar ma tistax tagħmilha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခရီးဆိုတာ အတွေ့အကြုံနဲ့ စိန်ခေါ်မှုပါ။ အိမ်မှာ မလုပ်နိုင်တဲ့ တစ်ခုခုကို လုပ်ပြီးမှ ပြန်လာချင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reise som opplevelse og utfordring. Du vil komme hjem etter å ha gjort noe du ikke kunne gjort hjemme."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा भनेको अनुभव र चुनौती। घरमा गर्न नसकिने केही गरेर फर्कन चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizen als beleving en uitdaging. Je wilt terugkomen met iets wat je thuis nooit had kunnen doen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulendo ngati chochitika ndi chovuta. Mumafuna kubwerera mutachita chinthu chomwe simukanatha kuchita kunyumba."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imala akka muuxannoo fi qormaataatti. Waan mana keessatti gochuu hin dandeenye raawwattee deebi'uu barbaadda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାତ୍ରା ମାନେ ଅନୁଭୂତି ଓ ଚ୍ୟାଲେଞ୍ଜ। ଘରେ କରିପାରୁନଥିବା କିଛି କରି ଆପଣ ଫେରିବାକୁ ଚାହାଁନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਯਾਤਰਾ ਇੱਕ ਤਜਰਬਾ ਅਤੇ ਚੁਣੌਤੀ ਹੈ। ਤੁਸੀਂ ਕੁਝ ਅਜਿਹਾ ਕਰ ਕੇ ਮੁੜਨਾ ਚਾਹੁੰਦੇ ਹੋ ਜੋ ਘਰ ਰਹਿ ਕੇ ਨਹੀਂ ਕਰ ਸਕਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podróż jako przeżycie i wyzwanie. Chcesz wrócić z czymś, czego nie da się przeżyć w domu."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر د تجربې او ننګونې په توګه. غواړئ داسې بېرته راشئ چې یو داسې کار مو کړی وي چې په کور کې نه کېده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viagem como experiência e desafio. Você quer voltar tendo feito algo que não daria para fazer em casa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajar como experiência e desafio. Queres voltar depois de fazer algo que não conseguias fazer em casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călătoria ca experiență și provocare. Vrei să te întorci după ce ai făcut ceva ce n-ai putea face acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приключения на природе — испытать себя"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urugendo ni ukwibonera no kwigerageza. Ushaka kugaruka warakoze ikintu utashoboraga gukorera mu rugo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අත්දැකීමක් සහ අභියෝගයක් විදිහට ගමන. ගෙදරදී කරන්න බැරි දෙයක් කරලා ආපසු එන්න ඔබට ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestovanie ako zážitok a výzva. Chceš sa vrátiť s tým, že máš za sebou niečo, čo sa doma urobiť nedá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potovanje kot doživetje in izziv. Domov se želiš vrniti z nečim, česar doma ni mogoče doživeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufamba sechiitiko nemuedzo. Unoda kudzoka waita chimwe chinhu chausingagoni kuita kumba."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safar sida waayo-aragnimo iyo tijaabo. Waxaad rabtaa inaad soo noqoto adigoo sameeyay wax aadan guriga ka samayn karin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udhëtimi si përvojë dhe sfidë. Do të kthehesh duke pasur bërë diçka që s’mund ta bëje në shtëpi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путовање као доживљај и изазов. Хоћеш да се вратиш с нечим што код куће не би могло да се уради."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngumbara salaku pangalaman sareng tangtangan. Anjeun hoyong mulang saparantos ngalakukeun hal anu teu tiasa dilakukeun di bumi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resor som upplevelse och utmaning. Du vill komma hem efter att ha gjort något du inte kunde göra hemma."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari kama uzoefu na changamoto. Unataka kurudi ukiwa umefanya kitu usichoweza kufanya nyumbani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயணம் என்பது அனுபவமும் சவாலும். வீட்டில் செய்ய முடியாத ஒன்றைச் செய்துவிட்டுத் திரும்ப வேண்டும் என்று விரும்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రయాణమంటే అనుభవం, సవాలు. ఇంట్లో చేయలేనిదేదో చేసి తిరిగి రావాలని మీకు ఉంటుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сафар ҳамчун таҷриба ва озмоиш. Ту мехоҳӣ бо ҳисси он баргардӣ, ки коре кардӣ, ки дар хона карда наметавонистӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเที่ยวคือประสบการณ์และความท้าทาย คุณอยากกลับมาโดยได้ทำสิ่งที่ไม่มีทางทำได้ที่บ้าน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መገሻ ከም ተሞክሮን ብድሆን። ኣብ ገዛ ክትገብርዎ ዘይትኽእሉ ነገር ገይርኩም ክትምለሱ ትደልዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syýahat täsir we synag hökmünde. Sen öýde edip bilmejek bir zadyňy edip gaýdyp gelmek isleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin için seyahat, deneyim ve meydan okuma demek. Evde yapamayacağın bir şeyi yapmış olarak dönmek istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подорож як досвід і виклик. Тобі хочеться повернутися з чимось, чого вдома не зробиш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر بطور تجربہ اور چیلنج۔ آپ کی خواہش ہوتی ہے کہ کچھ ایسا کر کے لوٹیں جو گھر پر ممکن نہ تھا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayohat — bu tajriba va sinov. Uyda qila olmaydigan biror ishni qilib qaytishni xohlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lịch là trải nghiệm và thử thách. Bạn muốn trở về sau khi đã làm được điều không thể làm ở nhà."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhambo njengamava nomceli mngeni. Ufuna ukubuya wenze into obungenakuyenza ekhaya."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrìn-àjò bí ìrírí àti ìpèníjà. Ẹ fẹ́ padà wálé lẹ́yìn tí ẹ ti ṣe ohun tí ẹ kò lè ṣe nílé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行就是體驗和挑戰。你希望回來時，做過一些在家做不到的事。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行就是体验和挑战。你希望回来时，已经做过在家做不到的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行是體驗也是挑戰。你希望回來時，完成了一件在家做不到的事。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuhamba njengokuhlangenwe nakho nenselelo. Ufuna ukubuya usenze okuthile obungeke ukwazi ukukwenza ekhaya."
          }
        }
      }
    },
    "Travel as much as possible — see everything" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
