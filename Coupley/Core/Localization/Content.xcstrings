        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalantza zintzoa. Ondo dago, batez ere aldaketa-garai batean bazaude. Babesa ematen duen bikotekide bat aingura izan daiteke."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تردیدی صادقانه. اشکالی ندارد — به‌خصوص اگر در دورهٔ گذار باشی. یک پارتنر حامی می‌تواند لنگرگاهت باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehellistä epävarmuutta. Se on ihan okei – etenkin jos elät siirtymävaihetta. Tukeva kumppani voi olla ankkurisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapat na pag-aalinlangan. Ayos lang ’yan — lalo na kung nasa transition phase ka. Puwedeng maging sandalan mo ang supportive na partner."
