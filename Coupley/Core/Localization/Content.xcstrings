        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とことん柔軟、あるいは本当に未定。どちらにしても、特定の場所に縛られていないのは大きな自由です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebas banget — utawa pancen durung mesthi. Apa wae, panjenengan ora kaiket ing panggonan tartamtu, lan iku kebebasan sing nyata."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქსიმალური მოქნილობა — ან ნამდვილი გაურკვევლობა. ასეა თუ ისე, კონკრეტულ ადგილს არ ხარ მიბმული, და ეს ნამდვილი თავისუფლებაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барынша икемділік не шынайы белгісіздік. Қалай болғанда да, сен бір жерге байланып қалмағансың, бұл нағыз еркіндік."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បត់បែនបំផុត — ឬមិនច្បាស់ពិតប្រាកដ។ ទោះយ៉ាងណាក៏ដោយ អ្នកមិនជាប់នឹងទីកន្លែងជាក់លាក់ណាមួយទេ ដែលជាសេរីភាពពិតប្រាកដ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಪೂರ್ಣ ಹೊಂದಿಕೊಳ್ಳುವಿಕೆ — ಅಥವಾ ನಿಜವಾದ ಅನಿಶ್ಚಿತತೆ. ಏನೇ ಇರಲಿ, ನೀವು ಒಂದು ನಿರ್ದಿಷ್ಟ ಸ್ಥಳಕ್ಕೆ ಕಟ್ಟುಬಿದ್ದಿಲ್ಲ, ಅದು ನಿಜವಾದ ಸ್ವಾತಂತ್ರ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고의 유연함이거나 진짜 고민 중이거나요. 어느 쪽이든 특정한 곳에 묶여 있지 않다는 건 진짜 자유예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nermbûna herî zêde — an nezelaliyeke rastîn. Çi dibe bila bibe, tu bi cihekî taybet ve girêdayî nînî, û ev azadiyeke rastîn e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толук ийкемдүүлүк — же чыныгы белгисиздик. Кандай болсо да, белгилүү бир жерге байланган эмессиң, бул чыныгы эркиндик."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal flexibel — oder wierklech onsécher. Esou oder esou bass du net un eng Plaz gebonnen, an dat ass eng richteg Fräiheet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຢືດຢຸ່ນທີ່ສຸດ — ຫຼື ບໍ່ແນ່ນອນແທ້ໆ ບໍ່ວ່າແບບໃດ ເຈົ້າກໍບໍ່ໄດ້ຜູກມັດກັບບ່ອນໃດບ່ອນໜຶ່ງ ເຊິ່ງເປັນອິດສະລະພາບແທ້ໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visiškas lankstumas – arba tikras netikrumas. Bet kuriuo atveju tavęs nesieja konkreti vieta, o tai – tikra laisvė."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimāla elastība – vai patiesa nenoteiktība. Jebkurā gadījumā tevi nesaista konkrēta vieta, un tā ir īsta brīvība."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahafahana tanteraka — na tsy fahazoana antoka tena izy. Na izany na tsy izany, tsy mifatotra amin'ny toerana iray ianao, ary fahafahana tena izy izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tino ngāwari — he rangirua pono rānei. Ahakoa he aha, kāore koe i te here ki tētahi wāhi motuhake, ā, he herekoretanga tūturu tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимална флексибилност — или вистинска неизвесност. Како и да е, не те врзува ниту едно место, а тоа е вистинска слобода."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരമാവധി വഴക്കം — അല്ലെങ്കിൽ യഥാർഥ അനിശ്ചിതത്വം. ഏതായാലും, ഒരു പ്രത്യേക സ്ഥലവുമായി നിങ്ങൾ കെട്ടപ്പെട്ടിട്ടില്ല, അതൊരു യഥാർഥ സ്വാതന്ത്ര്യമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хамгийн их уян хатан — эсвэл жинхэнэ тодорхойгүй байдал. Ямар ч байсан чи тодорхой газарт уягдаагүй, энэ бол жинхэнэ эрх чөлөө."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण लवचीकता — किंवा खरी अनिश्चितता. काहीही असो, तुम्ही कोणत्याही एका ठिकाणाशी बांधलेले नाही, आणि हे खरे स्वातंत्र्य आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat fleksibel — atau memang belum pasti. Apa pun, anda tidak terikat pada satu tempat, dan itu satu kebebasan sebenar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibbiltà massima — jew inċertezza ġenwina. Kif inhu jkun, m'hemm l-ebda post speċifiku li jorbtok, u dik hija libertà vera."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပြည့်အဝ လိုက်လျောညီထွေ ရှိခြင်း — ဒါမှမဟုတ် တကယ့် မသေချာမှု။ ဘယ်လိုပဲဖြစ်ဖြစ် သတ်မှတ်ထားတဲ့ နေရာတစ်ခုနဲ့ မချည်နှောင်ထားဘူး၊ ဒါဟာ တကယ့် လွတ်လပ်မှုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full fleksibilitet – eller reell usikkerhet. Uansett er du ikke bundet til ett sted, og det er en stor frihet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण लचिलोपन — वा साँचो अनिश्चितता। जे भए पनि, तपाईं कुनै एउटै ठाउँमा बाँधिनुभएको छैन, जुन साँच्चै स्वतन्त्रता हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal flexibel – of oprecht onzeker. Hoe dan ook ben je niet aan één plek gebonden, en dat is echte vrijheid."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusinthasintha kwathunthu — kapena kusatsimikiza kwenikweni. Mulimonse, simunamangiriridwe ku malo amodzi, ndipo umenewo ndi ufulu weniweni."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of madaqsuu guutuu — ykn shakkii dhugaa. Kamiyyuu yoo ta'e, iddoo murtaa'e tokkotti hin hidhamtu, kunis bilisummaa dhugaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପୂରା ନମନୀୟତା — କିମ୍ବା ପ୍ରକୃତ ଅନିଶ୍ଚିତତା। ଯାହା ବି ହେଉ, ଆପଣ କୌଣସି ନିର୍ଦ୍ଦିଷ୍ଟ ସ୍ଥାନରେ ବାନ୍ଧି ହୋଇନାହାଁନ୍ତି, ଯାହା ଏକ ପ୍ରକୃତ ସ୍ୱାଧୀନତା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੂਰੀ ਲਚਕ — ਜਾਂ ਸੱਚੀ ਦੁਚਿੱਤੀ। ਜੋ ਵੀ ਹੋਵੇ, ਤੁਸੀਂ ਕਿਸੇ ਇੱਕ ਥਾਂ ਨਾਲ ਬੱਝੇ ਨਹੀਂ, ਅਤੇ ਇਹ ਅਸਲ ਆਜ਼ਾਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełna elastyczność – albo szczera niepewność. Tak czy inaczej, nie trzyma cię konkretne miejsce, a to prawdziwa wolność."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بشپړ انعطاف — یا رښتینې ناڅرګندتیا. په هر حال، هېڅ ځانګړی ځای ستاسو پښې نه تړي، چې دا یوه رښتینې ازادي ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade máxima — ou incerteza sincera. De um jeito ou de outro, nenhum lugar te prende, e isso é uma liberdade real."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade total — ou incerteza genuína. Seja como for, nenhum lugar te prende, o que é uma verdadeira liberdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate maximă — sau nesiguranță reală. Oricum ar fi, nu te leagă un loc anume, și asta e o libertate adevărată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полная гибкость — или искренняя неопределённость. В любом случае тебя не держит конкретное место, и это настоящая свобода."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubwisanzure busesuye — cyangwa gushidikanya nyako. Uko biri kose, ntuboshywe n'ahantu runaka, kandi ubwo ni ubwisanzure nyabwo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "උපරිම නම්‍යශීලීබව — නැත්නම් සැබෑ අවිනිශ්චිතතාව. කොහොම වුණත් ඔබ එක තැනකට බැඳිලා නැහැ, ඒක සැබෑ නිදහසක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximálna flexibilita – alebo úprimná neistota. Tak či tak ťa nič neviaže na konkrétne miesto, a to je skutočná sloboda."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največja prilagodljivost – ali iskrena negotovost. Kakorkoli že, ne veže te noben določen kraj, in to je prava svoboda."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuchinjika kwakazara — kana kusava nechokwadi chaiko. Chero zvakadaro, hauna kusungirirwa kunzvimbo imwe chete, uye urwu rusununguko chairwo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabacsanaan buuxda — ama hubanti la'aan dhab ah. Si kastaba ha ahaatee, meel gaar ah kuma xidhnid, taasina waa xorriyad dhab ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilitet maksimal – ose pasiguri e vërtetë. Sido që të jetë, nuk të lidh asnjë vend i caktuar, dhe kjo është liri e vërtetë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Највећа флексибилност — или права неизвесност. Било како било, ниједно место те не везује, а то је права слобода."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléksibel pisan, atanapi leres-leres teu acan pasti. Kumaha waé ogé, anjeun teu kabeungkeut ku hiji tempat, sareng éta kabébasan anu nyata."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal flexibilitet – eller verklig osäkerhet. Hur som helst är du inte bunden till en viss plats, och det är en verklig frihet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unyumbufu kamili — au kutokuwa na uhakika kwa kweli. Vyovyote vile, hujafungwa mahali maalum, na huo ni uhuru wa kweli."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழுமையான நெகிழ்வு — அல்லது உண்மையான நிச்சயமின்மை. எப்படியிருந்தாலும், நீங்கள் ஓர் இடத்தோடு கட்டுப்படவில்லை, அது உண்மையான சுதந்திரம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పూర్తి సౌలభ్యం — లేదా నిజమైన అనిశ్చితి. ఏదైనా సరే, మీరు ఒక ప్రత్యేక చోటుకు కట్టుబడి లేరు, అది నిజమైన స్వేచ్ఛ."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ё чандирии комил — ё номуайянии воқеӣ. Дар ҳар сурат, ту ба ягон ҷои муайян баста нестӣ, ва ин озодии ҳақиқист."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นสุดๆ หรือไม่แน่ใจจริงๆ ไม่ว่าแบบไหน คุณก็ไม่ได้ผูกติดกับที่ใดที่หนึ่ง ซึ่งเป็นอิสระที่แท้จริง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝለዓለ ተዓጻጻፍነት — ወይ ናይ ሓቂ ዘይርጉእነት። ብዝኾነ፣ ምስ ሓደ ፍሉይ ቦታ ኣይተኣሰርኩምን፣ እዚ ድማ ናይ ሓቂ ናጽነት እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iň ýokary çeýelik — ýa-da hakyky näbellilik. Nähili bolsa-da, belli bir ýere bagly dälsiň, bu hakyky azatlyk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tam esneklik ya da gerçek bir belirsizlik. Her iki durumda da belli bir yere bağlı değilsin ve bu gerçek bir özgürlük."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальна гнучкість — або справжня невизначеність. Так чи інакше, тебе не тримає конкретне місце, і це справжня свобода."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوری لچک، یا سچی بے یقینی۔ دونوں صورتوں میں آپ کسی خاص جگہ کے پابند نہیں، اور یہ ایک حقیقی آزادی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal moslashuvchanlik — yoki chinakam noaniqlik. Har holda, siz biror joyga bogʻlanib qolmagansiz va bu haqiqiy erkinlik."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cực kỳ linh hoạt — hoặc thật sự phân vân. Dù sao, bạn không bị buộc vào một nơi cụ thể, và đó là một sự tự do thật sự."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuguquguquka okupheleleyo — okanye ukungaqiniseki okunyanisekileyo. Nokuba yeyiphi, awubotshelelwanga kwindawo ethile, nto leyo iyinkululeko yokwenyani."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìrọ̀rùn tó ga jù — tàbí àìdánilójú tòótọ́. Ọ̀nàkọnà, ẹ kò so mọ́ ibì kan pàtó, òmìnira gidi sì nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
