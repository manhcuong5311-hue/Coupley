        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uha agaciro ubwigenge mu by'amafaranga. Ibi bigenda neza iyo hari amasezerano asobanutse ku buryo amafaranga y'ibyo musangiye acungwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ මූල්‍ය ස්වාධීනත්වය අගය කරනවා. පොදු වියදම් හසුරුවන්නේ කොහොමද කියලා පැහැදිලි එකඟතා තියෙනවා නම් මේක හොඳට වැඩ කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceníš si finančnú nezávislosť. Funguje to dobre, keď máte jasne dohodnuté, ako riešite spoločné výdavky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceniš finančno neodvisnost. To deluje dobro z jasnimi dogovori o tem, kako krijeta skupne stroške."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unokoshesa kuzvimiririra pamari. Izvi zvinoshanda zvakanaka kana paine zvibvumirano zvakajeka pamashandisirwo emari yamunogovana."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad qiimaysaa madax-bannaanida lacageed. Tani si fiican ayay u shaqaysaa marka heshiisyo cad laga yeesho sida kharashka guud loo maareeyo."
