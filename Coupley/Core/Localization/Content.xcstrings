        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žaidimai – tikra tavo socialinio gyvenimo ir laisvalaikio dalis. Antroji pusė turi suprasti, kiek laiko tai užima ir kokia bendruomenė su tuo susijusi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spēles ir īsta daļa no tavas sabiedriskās dzīves un brīvā laika. Otrajai pusei jāsaprot, cik daudz laika tās prasa un kāda kopiena tām līdzi nāk."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ampahany tena izy amin'ny fiainanao sosialy sy ny fialam-bolinao ny lalao. Tokony hahatakatra ny fotoana sy ny vondron'olona miaraka amin'izany ny olon-tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He wāhanga tūturu ngā kēmu o tō ao pāpori me ō wā ngahau. Me mārama tō hoa aroha ki te wā me te hapori e haere tahi ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игрите се вистински дел од твојот друштвен живот и одмор. Половинката треба да го разбере времето и заедницата што одат со тоа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഗെയിമിങ് നിങ്ങളുടെ സൗഹൃദങ്ങളുടെയും വിനോദത്തിന്റെയും യഥാർഥ ഭാഗമാണ്. അതിന് വേണ്ട സമയവും അതിനൊപ്പമുള്ള കൂട്ടായ്മയും പങ്കാളി മനസ്സിലാക്കണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоглоом бол чиний нийгмийн болон чөлөөт цагийн бодит хэсэг. Хань чинь үүнд зарцуулах цаг, дагалдах нөхөрлөлийг ойлгох хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गेमिंग हा तुमच्या सामाजिक आणि विरंगुळ्याच्या आयुष्याचा खरा भाग आहे. त्यासाठी लागणारा वेळ आणि त्यासोबत येणारा समुदाय जोडीदाराने समजून घ्यायला हवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan video memang sebahagian daripada kehidupan sosial dan masa lapang anda. Pasangan perlu memahami masa dan komuniti yang terlibat."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-gaming huwa parti vera mill-ħajja soċjali u mill-ħin liberu tiegħek. Ta' min tispjega lill-partner tiegħek il-ħin u l-komunità li ġġib magħha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂိမ်းက သင့်လူမှုဘဝနဲ့ အပန်းဖြေမှုရဲ့ တကယ့်အစိတ်အပိုင်းပါ။ အဲဒီနဲ့အတူ ပါလာတဲ့ အချိန်နဲ့ အသိုင်းအဝိုင်းကို ချစ်သူက နားလည်ဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaming er en viktig del av det sosiale livet og fritiden din. En partner må forstå tiden det tar og fellesskapet som følger med."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गेमिङ तपाईंको सामाजिक जीवन र फुर्सदको वास्तविक हिस्सा हो। यसमा लाग्ने समय र यससँग जोडिएको समुदायलाई पार्टनरले बुझ्नुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamen is een echt deel van je sociale leven en je vrije tijd. Je partner moet de tijd en de community die erbij horen begrijpen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masewera ndi mbali yeniyeni ya moyo wanu wocheza ndi wopuma. Wokondedwa wanu ayenera kumvetsa nthawi ndi anthu omwe amabwera nawo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taphoonni jireenya hawaasummaa fi bashannana kee keessatti iddoo dhugaa qabu. Yeroo fi hawaasni isaan wajjin dhufu jaalallee keetiin hubatamuu qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗେମିଂ ଆପଣଙ୍କ ସାମାଜିକ ଓ ଅବସର ଜୀବନର ପ୍ରକୃତ ଅଂଶ। ଏଥିରେ ଲାଗୁଥିବା ସମୟ ଓ ଏହା ସହ ଯୋଡ଼ା ସାଙ୍ଗସାଥୀଙ୍କୁ ସାଥୀ ବୁଝିବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੇਮਿੰਗ ਤੁਹਾਡੇ ਮੇਲ-ਜੋਲ ਅਤੇ ਵਿਹਲੇ ਸਮੇਂ ਦਾ ਅਸਲ ਹਿੱਸਾ ਹੈ। ਪਾਰਟਨਰ ਨੂੰ ਇਸ ਵਿੱਚ ਲੱਗਦੇ ਸਮੇਂ ਅਤੇ ਇਸ ਨਾਲ ਜੁੜੇ ਲੋਕਾਂ ਨੂੰ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granie to ważna część twojego życia towarzyskiego i wolnego czasu. Druga połówka musi rozumieć, ile czasu to zajmuje i jaka społeczność się z tym wiąże."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوبې ستاسو د ټولنیز او تفریحي ژوند رښتینې برخه ده. ملګری باید هغه وخت او ټولنه درک کړي چې ورسره مل دي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os games fazem parte de verdade do seu lazer e da sua vida social. Seu amor precisa entender o tempo e a comunidade que vêm junto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogos fazem mesmo parte da tua vida social e do teu lazer. O teu par precisa de perceber o tempo e a comunidade que vêm com isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jocurile fac cu adevărat parte din viața ta socială și din timpul tău liber. Un partener trebuie să înțeleagă timpul și comunitatea care vin la pachet cu ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игры — настоящая часть твоего общения и досуга. Партнёру важно понимать, сколько времени это занимает и какое сообщество с этим связано."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imikino ni igice nyacyo cy'ubuzima bwawe bwo gusabana n'ubw'ikiruhuko. Umukunzi wawe akwiye gusobanukirwa igihe bitwara n'abantu mubisangiye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගේම් ගැසීම ඔබේ සමාජ සහ විවේක ජීවිතයේ සැබෑ කොටසක්. ඒ සමඟ එන කාලය සහ ප්‍රජාව ඔබේ සහකරු තේරුම් ගන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hranie je skutočnou súčasťou tvojho spoločenského života aj oddychu. Tvoja polovička musí rozumieť času aj komunite, ktoré k tomu patria."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igranje je resničen del tvojega družabnega življenja in prostega časa. Partner mora razumeti čas in skupnost, ki pridejo zraven."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitambo chikamu chaicho chehupenyu hwako hwekushamwaridzana nekuzorora. Mudiwa anofanira kunzwisisa nguva neshamwari zvinouya nazvo."
