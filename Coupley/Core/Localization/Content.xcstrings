    "Cooking is a love language in its own right. A partner who appreciates a home-cooked meal is your ideal audience." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطبخ لغة حب قائمة بذاتها. والشريك الذي يقدّر وجبة منزلية هو جمهورك المثالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaření je samo o sobě jazyk lásky. Protějšek, který ocení domácí jídlo, je tvoje ideální publikum."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madlavning er et kærlighedssprog i sig selv. En partner, der sætter pris på hjemmelavet mad, er dit perfekte publikum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen ist eine ganz eigene Liebessprache. Jemand, der ein selbst gekochtes Essen zu schätzen weiß, ist dein ideales Publikum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μαγειρική είναι από μόνη της μια γλώσσα αγάπης. Ένα ταίρι που εκτιμά το σπιτικό φαγητό είναι το ιδανικό σου κοινό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocinar es un lenguaje del amor en sí mismo. Una pareja que valore la comida casera es tu público ideal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruoanlaitto on oma rakkauden kielensä. Kotiruokaa arvostava kumppani on juuri oikeaa yleisöä sinulle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagluluto ay sarili nitong love language. Ang partner na nagpapahalaga sa lutong-bahay ang perpektong audience mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisiner est un langage de l'amour à part entière. Quelqu'un qui savoure un bon petit plat maison est ton public idéal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בישול הוא שפת אהבה בפני עצמה. מי שמעריך ארוחה ביתית הוא הקהל האידיאלי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना बनाना अपने आप में प्यार जताने का एक तरीक़ा है। जो पार्टनर घर के बने खाने की क़द्र करे, वही आपका सबसे अच्छा दर्शक है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A főzés önmagában is szeretetnyelv. Ha a párod értékeli a házikosztot, ő a tökéletes közönséged."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasak adalah bahasa cinta tersendiri. Pasangan yang menghargai masakan rumahan adalah penikmat idealmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cucinare è un linguaggio dell’amore a tutti gli effetti. Chi apprezza un piatto fatto in casa è il tuo pubblico ideale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料理はそれだけでひとつの愛の言語です。手料理を喜んでくれるパートナーこそ、理想のお客さんです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요리는 그 자체로 하나의 사랑의 언어예요. 집밥을 소중히 여기는 연인이 최고의 관객이 되어 줄 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasak itu sendiri satu bahasa cinta. Pasangan yang menghargai masakan rumah ialah penikmat yang ideal bagi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matlaging er et kjærlighetsspråk i seg selv. En partner som setter pris på hjemmelaget mat, er ditt drømmepublikum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koken is een liefdestaal op zich. Een partner die een huisgemaakte maaltijd waardeert, is jouw ideale publiek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotowanie to pełnoprawny język miłości. Ktoś, kto docenia domowy obiad, to twoja idealna publiczność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cozinhar é uma linguagem do amor por si só. Quem valoriza uma comidinha caseira é o seu público ideal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gătitul e un limbaj al iubirii în sine. Un partener care apreciază o masă gătită acasă e publicul tău ideal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовка — это отдельный язык любви. Партнёр, который ценит домашнюю еду, — твоя идеальная публика."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matlagning är ett kärleksspråk i sig. En partner som uppskattar hemlagat är din perfekta publik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทำอาหารคือภาษารักแบบหนึ่ง คนรักที่ชื่นชมอาหารฝีมือที่บ้านคือคนชิมที่ใช่ที่สุดของคุณ"
