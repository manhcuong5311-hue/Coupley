        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি ক'ৰ পৰা আহিছে সেই বিষয়ে সচেতন। আপোনাৰ কাহিনীৰ ভাল আৰু কঠিন দুয়োটা অংশই আপুনি দেখা পায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haradan gəldiyini dərk edirsən. Hekayənin həm yaxşı, həm də çətin tərəfləri sənə aydındır."
