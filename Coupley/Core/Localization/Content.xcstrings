    "Show them your view." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أروا شريكك ما ترونه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaž protějšku svůj výhled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis din partner din udsigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig deinem Schatz deine Aussicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείξε στο ταίρι σου τη θέα σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muéstrale a tu pareja lo que ves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä kumppanillesi, mitä näet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipakita sa kanya ang tanaw mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre-lui ta vue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנוף שלך, כרגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें अपना नज़ारा दिखाएँ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutasd meg a párodnak, mit látsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan pemandanganmu padanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra al tuo partner cosa vedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今見えている景色を見せてあげましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 보고 있는 풍경을 보여 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan pemandangan anda kepadanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis partneren din utsikten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je partner je uitzicht zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż drugiej połówce swój widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre a vista daí."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arată-i partenerului tău ce vezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажи партнёру свой вид."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa din partner din utsikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้คนรักดูวิวของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona manzaranı göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажи половинці, що ти бачиш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho người ấy xem khung cảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让另一半看看你眼前的风景。"
