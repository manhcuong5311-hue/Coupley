        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şatlyksyz gatnaşyk uzaga çekmeýär. Saňa durmuş kyn wagtynda hem gülkünç, oýunjaň we ýeňil bolup bilýän biri gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
