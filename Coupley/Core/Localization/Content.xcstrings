        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοιχτότητα στην αλλαγή, αλλά σε οικείο πολιτισμικό περιβάλλον. Θες μια νέα αρχή χωρίς την αβεβαιότητα μιας μετεγκατάστασης στο εξωτερικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te abres al cambio, pero dentro de una cultura conocida. Quieres empezar de cero sin la incertidumbre de mudarte del todo."
