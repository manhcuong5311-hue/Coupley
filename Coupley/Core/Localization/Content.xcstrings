          "stringUnit" : {
            "state" : "translated",
            "value" : "Maagang umaga — doon ako pinakamalakas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôt le matin : je suis au top"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוקדם בבוקר — אז אני בשיא"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह-सुबह — मेरा सबसे अच्छा वक़्त"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kora reggel – akkor vagyok csúcson"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi-pagi — saat aku paling prima"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di prima mattina — è il mio momento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早朝。いちばん冴えている"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이른 아침, 컨디션 최고예요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awal pagi — waktu terbaik saya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidlig morgen – da er jeg i toppform"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroeg in de ochtend – dan ben ik op mijn best"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczesny ranek – wtedy mam szczyt formy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem cedo — é meu auge"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimineața devreme — atunci sunt în formă maximă"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раннее утро — мой пик"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidigt på morgonen – då är jag på topp"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช้าตรู่ ช่วงพีกของฉัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabah erken, en formdayım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рано-вранці — це мій пік"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáng sớm — lúc mình sung nhất"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清晨——状态最佳"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一大早，我精神最好"
          }
        }
      }
    },
    "Eat or drink something comforting" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آكل أو أشرب شيئًا مريحًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dám si něco dobrého k jídlu nebo pití"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spise eller drikke noget trøstende"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "esse oder trinke ich etwas Tröstliches"
          }
        },
        "el" : {
