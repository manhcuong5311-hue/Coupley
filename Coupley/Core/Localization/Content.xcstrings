        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անկեղծ է։ Մարդկանց մեծ մասն էլ այդպես է։ Ամենակարևորը դա ուսումնասիրելու պատրաստակամությունն է։"
