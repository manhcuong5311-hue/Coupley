        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घूमने से बढ़कर गहराई। आप किसी जगह को समझना चाहते हैं, सिर्फ़ उसकी फ़ोटो लेना नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélység a turistáskodás helyett. Meg akarod érteni a helyet, nem csak lefényképezni."
