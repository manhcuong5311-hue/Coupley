        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őszinte bizonytalanság. Ez rendben van – főleg, ha épp átmeneti időszakban vagy. Egy támogató társ ilyenkor horgony lehet."
