        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rashin tabbas na gaskiya. Babu laifi — musamman idan kuna cikin lokacin sauyi. Abokin zama mai goyon baya na iya zama ginshiƙinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוסר ודאות כן. וזה בסדר — במיוחד בתקופת מעבר. תמיכה מהצד השני יכולה להיות עוגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमानदार अनिश्चितता। इसमें कोई बुराई नहीं — ख़ासकर बदलाव के दौर में। ऐसे में पार्टनर का साथ आपका सहारा बन सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskrena nesigurnost. To je u redu – pogotovo ako prolaziš kroz razdoblje promjena. Voljena osoba koja te podržava može biti sidro."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon ensètitid ki onèt. Sa pa gen pwoblèm — sitou si w ap travèse yon peryòd tranzisyon. Yon patnè ki soutni ou ka yon pwen apui."
