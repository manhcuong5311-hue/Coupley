        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជាក់ស្ដែង។ ជីវិតពិតរបស់អ្នកកើតឡើងនៅក្រៅការងារ។ ការងារគ្រាន់តែបម្រើចក្ខុវិស័យរបស់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಾಸ್ತವವಾದಿ. ನಿಮ್ಮ ನಿಜವಾದ ಬದುಕು ಕೆಲಸದ ಹೊರಗೆ ನಡೆಯುತ್ತದೆ. ಕೆಲಸ ನಿಮ್ಮ ಕನಸಿನ ಬದುಕಿಗೆ ದಾರಿ ಮಾಡಿಕೊಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실용적이에요. 진짜 삶은 일 밖에서 펼쳐지고, 일은 그리는 삶을 위해 존재해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatîk. Jiyana te ya rastîn li derveyî kar derbas dibe. Kar ji xeyala te re xizmetê dike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прагматикалык көз караш. Чыныгы жашооң иштен тышкары өтөт. Иш болсо ошол максатка кызмат кылат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatesch. Däi richtegt Liewen spillt sech ausserhalb vun der Aarbecht of. De Job déngt dem gréissere Bild."
