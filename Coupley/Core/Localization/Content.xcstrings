        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedzenie to jeden z najprostszych sposobów okazania troski – warto wiedzieć, co uwielbia twoja druga połówka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comida é um dos jeitos mais fáceis de demonstrar carinho — saber o que seu amor adora faz diferença."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncarea e unul dintre cele mai simple moduri de a arăta grijă — contează să știi ce îi place partenerului tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еда — один из самых простых способов проявить заботу. Важно знать, что любит партнёр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat är ett av de enklaste sätten att visa omtanke – att veta vad din partner älskar betyder mycket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาหารเป็นหนึ่งในวิธีแสดงความใส่ใจที่ง่ายที่สุด การรู้ว่าคนรักชอบอะไรจึงสำคัญ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemek, özen göstermenin en kolay yollarından biri; partnerinin neyi sevdiğini bilmek önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Їжа — один із найпростіших способів виявити турботу. Важливо знати, що любить твоя половинка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồ ăn là một trong những cách dễ nhất để thể hiện sự quan tâm — biết người ấy thích gì là điều quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食物是表达关心最简单的方式之一——知道另一半爱吃什么很重要。"
