        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սթրեսին քո արձագանքը ցույց է տալիս, թե ինչպես է աշխատում նյարդային համակարգդ, և ինչպես կարող է զուգընկերդ օգնել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responsmu terhadap stres menunjukkan cara kerja sistem sarafmu — dan bagaimana pasanganmu bisa membantu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otu i si emeghachi omume na nrụgide na-egosi otu akwara gị si arụ ọrụ — na otu onye gị ga-esi nyere gị aka."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðbrögð þín við stressi sýna hvernig taugakerfið þitt virkar – og hvernig makinn þinn getur hjálpað."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modo in cui reagisci allo stress rivela come funziona il tuo sistema nervoso — e come il tuo partner può aiutarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレスへの反応から、心と体の仕組みと、パートナーにできる助け方が見えてきます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara panjenengan nanggepi stres nuduhake carane sistem saraf panjenengan makarya — lan carane pasangan bisa mbantu."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სტრესზე შენი რეაქცია აჩვენებს, როგორ მუშაობს შენი ნერვული სისტემა — და როგორ შეუძლია პარტნიორს დაგეხმაროს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стреске қалай жауап беретінің жүйкеңнің қалай жұмыс істейтінін және серігіңнің қалай көмектесе алатынын көрсетеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "របៀបដែលអ្នកឆ្លើយតបនឹងភាពតានតឹង បង្ហាញពីរបៀបដែលប្រព័ន្ធប្រសាទរបស់អ្នកដំណើរការ — និងរបៀបដែលដៃគូរបស់អ្នកអាចជួយបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒತ್ತಡಕ್ಕೆ ನೀವು ಪ್ರತಿಕ್ರಿಯಿಸುವ ರೀತಿ ನಿಮ್ಮ ನರವ್ಯೂಹ ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ ಎಂದು ತೋರಿಸುತ್ತದೆ — ಮತ್ತು ನಿಮ್ಮ ಸಂಗಾತಿ ಹೇಗೆ ಸಹಾಯ ಮಾಡಬಹುದು ಎಂಬುದನ್ನೂ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트레스 반응을 보면 마음이 어떻게 움직이는지, 그리고 연인이 어떻게 도울 수 있는지 알 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersiva te ya li hember stresê nîşan dide ka pergala te ya demarî çawa dixebite — û hevjînê te çawa dikare alîkariyê bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стресске кандай жооп берериң нерв системаңдын кантип иштээрин — жана сүйгөнүң сага кантип жардам бере аларын көрсөтөт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wéi s de op Stress reagéiers, weist, wéi däin Nervesystem funktionéiert — a wéi däi Schatz dir hëllefe kann."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ວິທີທີ່ເຈົ້າຮັບມືກັບຄວາມຄຽດ ບອກໃຫ້ຮູ້ວ່າລະບົບປະສາດຂອງເຈົ້າເຮັດວຽກແນວໃດ — ແລະ ຄູ່ຂອງເຈົ້າຈະຊ່ວຍໄດ້ແນວໃດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo reakcija į stresą atskleidžia, kaip veikia tavo nervų sistema – ir kaip antroji pusė gali padėti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas, kā tu reaģē uz stresu, parāda, kā strādā tava nervu sistēma – un kā otrā puse var palīdzēt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fihetsikao manoloana ny adin-tsaina dia mampiseho ny fiasan'ny vatanao sy ny sainao — sy ny fomba hanampian'ny olon-tianao anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā tō whakautu ki te taumaha e whakaatu te mahi a tō pūnaha io — me te āwhina ka taea e tō hoa aroha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реакцијата на стрес покажува како функционира твојот нервен систем — и како половинката може да ти помогне."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സമ്മർദത്തോടുള്ള നിങ്ങളുടെ പ്രതികരണം നിങ്ങളുടെ നാഡീവ്യവസ്ഥ എങ്ങനെ പ്രവർത്തിക്കുന്നുവെന്നും പങ്കാളിക്ക് എങ്ങനെ സഹായിക്കാമെന്നും കാണിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стресст хэрхэн хариу үйлдэл үзүүлдэг чинь мэдрэлийн систем чинь хэрхэн ажилладаг, хань чинь яаж тусалж болохыг харуулдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताणाला तुम्ही कसा प्रतिसाद देता, यावरून तुमची मज्जासंस्था कशी काम करते — आणि जोडीदार तुम्हाला कशी मदत करू शकेल — हे कळते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara anda bertindak balas terhadap tekanan menunjukkan cara sistem saraf anda berfungsi — dan bagaimana pasangan anda boleh membantu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-reazzjoni tiegħek għall-istress turi kif taħdem is-sistema nervuża tiegħek — u kif jista' jgħinek il-partner tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဖိစီးမှုကို တုံ့ပြန်ပုံက သင့်အာရုံကြောစနစ် ဘယ်လို အလုပ်လုပ်လဲ — ချစ်သူက ဘယ်လို ကူညီနိုင်လဲဆိုတာ ပြသတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du reagerer på stress, viser hvordan nervesystemet ditt fungerer – og hvordan partneren din kan hjelpe."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तनावमा तपाईं कस्तो प्रतिक्रिया दिनुहुन्छ भन्नेले तपाईंको स्नायु प्रणाली कसरी चल्छ — र पार्टनरले कसरी मद्दत गर्न सक्नुहुन्छ भन्ने देखाउँछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe je op stress reageert, laat zien hoe je zenuwstelsel werkt – en hoe je partner kan helpen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmene mumachitira mukapanikizika zimaonetsa mmene minyewa yanu imagwirira ntchito — ndi mmene wokondedwa wanu angakuthandizireni."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkaataan ati dhiphinaaf itti deebiftu, sirni narvii kee akkamitti akka hojjetu agarsiisa — akkasumas gargaarsi jaalallee kee maal fakkaachuu akka qabu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚାପରେ ଆପଣ କିପରି ପ୍ରତିକ୍ରିୟା କରନ୍ତି, ତାହା ଦେଖାଏ ଆପଣଙ୍କ ସ୍ନାୟୁତନ୍ତ୍ର କିପରି କାମ କରେ — ଏବଂ ଆପଣଙ୍କ ସାଥୀ କିପରି ସାହାଯ୍ୟ କରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤਣਾਅ ਵਿੱਚ ਤੁਹਾਡਾ ਵਤੀਰਾ ਦੱਸਦਾ ਹੈ ਕਿ ਤੁਹਾਡਾ ਮਨ ਅਤੇ ਸਰੀਰ ਕਿਵੇਂ ਕੰਮ ਕਰਦੇ ਹਨ — ਅਤੇ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਕਿਵੇਂ ਮਦਦ ਕਰ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja reakcja na stres pokazuje, jak działa twój układ nerwowy – i jak druga połówka może pomóc."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشار ته ستاسو غبرګون ښيي چې عصبي سیسټم مو څنګه کار کوي — او ملګری مو څنګه مرسته کولای شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua reação ao estresse mostra como seu sistema nervoso funciona — e como seu amor pode ajudar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua reação ao stress mostra como funciona o teu sistema nervoso — e como o teu par te pode ajudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felul în care reacționezi la stres arată cum funcționează sistemul tău nervos — și cum te poate ajuta partenerul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя реакция на стресс показывает, как работает твоя нервная система, — и как партнёр может помочь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uko witwara mu gihe cy'umunaniro bigaragaza uko imitsi yawe ikora — n'uko umukunzi wawe yagufasha."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ආතතියට ඔබ ප්‍රතිචාර දක්වන හැටියෙන් ඔබේ ස්නායු පද්ධතිය වැඩ කරන හැටි — සහ ඔබේ සහකරුට උදව් කරන්න පුළුවන් හැටි — පෙන්නනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja reakcia na stres prezrádza, ako funguje tvoj nervový systém – a ako ti môže pomôcť tvoja polovička."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj odziv na stres razkrije, kako deluje tvoj živčni sistem – in kako ti partner lahko pomaga."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maitiro aunoita kana wakamanikidzwa anoratidza mashandiro anoita tsinga dzako — uye mabatsiriro angaita mudiwa wako."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sida aad uga jawaabto walbahaarka ayaa muujisa sida dareemayaashaadu u shaqeeyaan — iyo sida lagaa caawin karo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mënyra si reagon ndaj stresit tregon si funksionon sistemi yt nervor – dhe si mund të të ndihmojë partneri yt."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начин на који реагујеш на стрес открива како ради твој нервни систем — и како твоја половина може да помогне."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réspon anjeun kana setrés nembongkeun kumaha sistem saraf anjeun dianggo, sareng kumaha pasangan tiasa ngabantosan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur du reagerar på stress visar hur ditt nervsystem fungerar – och hur din partner kan hjälpa."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jinsi unavyoitikia msongo huonyesha jinsi mfumo wako wa neva unavyofanya kazi — na jinsi mwenzi wako anavyoweza kusaidia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அழுத்தத்தில் நீங்கள் எப்படி நடந்துகொள்கிறீர்கள் என்பது உங்கள் நரம்பு மண்டலம் எப்படி இயங்குகிறது என்பதையும், உங்கள் துணை எப்படி உதவலாம் என்பதையும் காட்டுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒత్తిడికి మీరు స్పందించే తీరు మీ నాడీ వ్యవస్థ ఎలా పనిచేస్తుందో — మీ భాగస్వామి ఎలా సాయపడగలరో చెబుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вокуниши ту ба стресс нишон медиҳад, ки системаи асабат чӣ тавр кор мекунад — ва ёрат чӣ тавр кӯмак карда метавонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิธีรับมือความเครียดบอกว่าระบบประสาทของคุณทำงานอย่างไร และคนรักจะช่วยได้อย่างไร"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንጸቕጢ እትህብዎ ግብረ-መልሲ፣ ስርዓት ነርቭኩም ከመይ ከም ዝሰርሕን ካብ መጻምድኹም ዝበለጸ ሓገዝ እንታይ ከም ዝኾነን ይገልጽ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strese beren jogabyň nerw ulgamyňyň nähili işleýändigini — we söýgüliňiň saňa nädip kömek edip biljekdigini görkezýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strese verdiğin tepki, sinir sisteminin nasıl çalıştığını ve partnerinin sana nasıl yardım edebileceğini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реакція на стрес показує, як працює твоя нервова система — і як половинка може допомогти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دباؤ پر آپ کا ردِعمل بتاتا ہے کہ آپ کا اعصابی نظام کیسے کام کرتا ہے، اور آپ کے ساتھی کی مدد کس طرح کام آ سکتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stressga munosabatingiz asab tizimingiz qanday ishlashini — va sherigingiz qanday yordam bera olishini koʻrsatadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách bạn phản ứng với căng thẳng cho thấy hệ thần kinh của bạn vận hành ra sao — và người ấy có thể giúp thế nào."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlela osabela ngayo kuxinezelelo ibonisa indlela imithambo-luvo yakho esebenza ngayo — nendlela iqabane lakho elinokunceda ngayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bí ẹ ṣe ń dáhùn sí wàhálà ń fi bí ara yín ṣe ń ṣiṣẹ́ hàn — àti bí olólùfẹ́ yín ṣe lè ràn yín lọ́wọ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你面對壓力的反應，反映了你的神經系統如何運作，也反映了另一半可以怎樣幫你。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你应对压力的方式，体现了你的神经系统如何运作，也体现了另一半可以怎么帮你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你面對壓力的反應，透露了你的身心怎麼運作，也讓另一半知道怎麼幫你。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlela osabela ngayo engcindezini iveza ukuthi isimiso sakho sezinzwa sisebenza kanjani — nokuthi umlingani wakho angasiza kanjani."
          }
        }
      }
    }
  },
  "version" : "1.0"
