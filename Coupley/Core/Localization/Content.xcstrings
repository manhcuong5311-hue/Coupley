        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essere la sua scelta, ogni volta. Non solo all’inizio — ma anche ogni giorno a seguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも選ばれ続けること。最初だけでなく、そのあとも毎日。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih, terus-terusan. Ora mung ing wiwitan — nanging uga saben dina sakwise iku."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გინდა, რომ მუდმივად შენ გირჩევდნენ. არა მხოლოდ დასაწყისში — არამედ ყოველდღე, მის შემდეგაც."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тұрақты түрде таңдалу. Тек басында ғана емес, одан кейінгі әр күні де."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ត្រូវបានជ្រើសរើសជាប់ជានិច្ច។ មិនមែនត្រឹមតែនៅពេលដំបូងទេ — ប៉ុន្តែរៀងរាល់ថ្ងៃបន្ទាប់ពីនោះផងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸದಾ ನಿಮ್ಮನ್ನೇ ಆರಿಸಿಕೊಳ್ಳುವುದು. ಆರಂಭದಲ್ಲಿ ಮಾತ್ರವಲ್ಲ — ಅದರ ನಂತರದ ಪ್ರತಿದಿನವೂ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변함없이 선택받는 것이에요. 처음에만이 아니라, 그 후로도 매일매일요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dem hatin hilbijartin. Ne tenê di destpêkê de — her roja piştî wê jî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сени туруктуу тандап турушу. Башында эле эмес — андан кийинки ар бир күнү да."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ëmmer erëm ausgewielt ginn. Net just am Ufank — mee och all Dag duerno."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຖືກເລືອກຢູ່ສະເໝີ ບໍ່ແມ່ນແຄ່ຕອນເລີ່ມຕົ້ນ — ແຕ່ທຸກໆມື້ຫຼັງຈາກນັ້ນນຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad tave rinktųsi nuolat. Ne tik pradžioje – bet ir kiekvieną dieną po to."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka tevi izvēlas – atkal un atkal. Ne tikai sākumā, bet arī katru dienu pēc tam."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny hofidiana, tsy tapaka. Tsy amin'ny voalohany ihany — fa isan'andro aorian'izany koa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kia kōwhiria, i ngā wā katoa. Kaua i te tīmatanga anake — engari i ia rā i muri mai hoki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да знаеш дека те избираат, постојано. Не само на почетокот — туку и секој ден потоа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്ഥിരമായി തിരഞ്ഞെടുക്കപ്പെടൽ. തുടക്കത്തിൽ മാത്രമല്ല — അതിനുശേഷമുള്ള എല്ലാ ദിവസവും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогтмол сонгогдох. Зөвхөн эхэндээ биш — түүнээс хойшхи өдөр бүр."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सातत्याने निवडले जाणे. फक्त सुरुवातीलाच नाही — तर त्यानंतरच्या प्रत्येक दिवशीही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih, secara konsisten. Bukan hanya di awal — tetapi setiap hari selepas itu juga."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li jagħżluk, b'mod konsistenti. Mhux biss fil-bidu — imma kull jum wara wkoll."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အမြဲတမ်း ရွေးချယ်ခံရခြင်း။ အစမှာတင် မဟုတ်ဘဲ — အဲဒီနောက် နေ့တိုင်းလည်းပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å bli valgt, hver gang. Ikke bare i starten – men hver eneste dag etterpå også."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निरन्तर रोजिनु। सुरुमा मात्र होइन — त्यसपछिको हरेक दिन पनि।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steeds opnieuw gekozen worden. Niet alleen in het begin – maar ook elke dag daarna."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusankhidwa, nthawi zonse. Osati kumayambiriro kokha — koma tsiku lililonse pambuyo pake."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo hunda filatamuu. Jalqaba qofa miti — guyyaa sana booda dhufu hundas."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବାରମ୍ବାର ବଛାଯିବା। କେବଳ ଆରମ୍ଭରେ ନୁହେଁ — ତା’ ପରେ ବି ପ୍ରତିଦିନ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਵਾਰ ਚੁਣੇ ਜਾਣਾ। ਸਿਰਫ਼ ਸ਼ੁਰੂਆਤ ਵਿੱਚ ਨਹੀਂ — ਉਸ ਤੋਂ ਬਾਅਦ ਹਰ ਦਿਨ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadomość, że ktoś wybiera cię konsekwentnie. Nie tylko na początku – ale też każdego kolejnego dnia."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په دوامداره توګه غوره کېدل. نه یوازې په پیل کې — بلکې له هغې وروسته هره ورځ هم."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser a escolha, sempre. Não só no começo — mas todos os dias depois também."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser a escolha, sempre. Não só no início — mas todos os dias a seguir também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să te aleagă, constant. Nu doar la început — ci și în fiecare zi de după."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда тебя выбирают — снова и снова. Не только в начале, но и каждый день после."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhitwamo, buri gihe. Si mu ntangiriro gusa — ahubwo na buri munsi ukurikiraho."
