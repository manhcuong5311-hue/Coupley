        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjalan menurunkan kortisol, dan berdampingan lebih nyaman daripada berhadapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camminare abbassa il cortisolo, e fianco a fianco è meglio che faccia a faccia."
