        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ខិតខំម្ដងម្កាល ជាជាងថែរក្សារាល់ថ្ងៃ។ ឲ្យតែការរំពឹងទុកត្រូវគ្នា វិធីនេះដំណើរការល្អ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದಿನನಿತ್ಯದ ನಿರ್ವಹಣೆಗಿಂತ ಆಗಾಗದ ಪ್ರಯತ್ನ. ನಿರೀಕ್ಷೆಗಳು ಹೊಂದಿಕೆಯಾದರೆ, ಇದು ಚೆನ್ನಾಗಿಯೇ ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 관리보다 가끔 몰아서 하는 편이에요. 서로 기대치만 맞으면 괜찮은 방식이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewla demdemî li şûna lênêrîna rojane. Heta ku hêvî li hev bin, ev baş dixebite."
