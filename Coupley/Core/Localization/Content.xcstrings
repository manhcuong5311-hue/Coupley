    "Passive relaxation works for you. This can be a great shared couple ritual — or totally individual, depending on the show." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiewe ontspanning werk vir jou. Dit kan ’n heerlike gedeelde ritueel wees – of heeltemal individueel, afhangend van die reeks."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝም ብሎ ዘና ማለት ይሠራልዎታል። ይህ ምርጥ የጥንዶች የጋራ ልማድ ሊሆን ይችላል — ወይም እንደ ፕሮግራሙ ሙሉ በሙሉ ግላዊ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسترخاء الهادئ يناسبكم. قد يكون هذا طقسًا ثنائيًا رائعًا، أو وقتًا فرديًا تمامًا، حسب ما تشاهدونه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিষ্ক্ৰিয় জিৰণি আপোনাৰ বাবে কামত আহে। এয়া দুয়োৰে বাবে এক সুন্দৰ অভ্যাস হ'ব পাৰে — বা সম্পূৰ্ণ ব্যক্তিগত, কি চাইছে তাৰ ওপৰত নিৰ্ভৰ কৰি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv istirahət sənə yaxşı gəlir. Bu, gözəl bir ortaq ritual ola bilər — ya da seriala görə tamamilə fərdi."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе падыходзіць пасіўны адпачынак. Гэта можа стаць выдатным рытуалам для пары — ці зусім асабістым, залежна ад серыяла."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пасивната почивка ти действа добре. Това може да е чудесен общ ритуал – или изцяло личен, зависи от сериала."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরাম করে কিছু দেখাতেই তোমার বিশ্রাম। এটা দুজনের দারুণ একটা অভ্যাস হতে পারে — অথবা পুরোপুরি নিজের, শো-টার ওপর নির্ভর করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasivno opuštanje ti odgovara. To može biti divan ritual za vas dvoje – ili potpuno lična stvar, zavisno od serije."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et funciona el relax passiu. Pot ser un ritual de parella genial — o del tot individual, segons la sèrie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje na tebe pasivní relax. Může to být skvělý společný rituál – nebo úplně tvoje věc, podle toho, na co se koukáš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae ymlacio goddefol yn gweithio i ti. Gall hyn fod yn ddefod wych i chi fel cwpl — neu'n gwbl unigol, yn dibynnu ar y rhaglen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv afslapning virker for dig. Det kan være et dejligt fælles ritual – eller helt individuelt, alt efter serien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passive Entspannung tut dir gut. Das kann ein schönes gemeinsames Ritual sein – oder ganz deins, je nach Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε χαλαρώνει να παρακολουθείς κάτι. Μπορεί να γίνει υπέροχη τελετουργία για τους δυο σας — ή εντελώς προσωπική, ανάλογα με τη σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajarte sin hacer nada te funciona. Puede ser un gran ritual en pareja, o algo totalmente individual, según la serie."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulle sobib passiivne lõõgastus. See võib olla tore ühine rituaal — või täiesti isiklik, olenevalt sarjast."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atseden pasiboa ondo dator zuretzat. Bikote-erritu polita izan daiteke — edo guztiz bakarkakoa, saioaren arabera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استراحت بی‌دردسر برایت جواب می‌دهد. می‌تواند یک آیین دونفرهٔ عالی باشد — یا کاملاً شخصی، بسته به سریال."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiivinen rentoutuminen toimii sinulle. Siitä voi tulla upea yhteinen rituaali – tai täysin oma juttu, sarjasta riippuen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana sa’yo ang chill na pagpapahinga. Puwede itong maging magandang ritwal ninyong dalawa — o sarili mong oras, depende sa palabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détente passive te réussit. Ça peut devenir un super rituel de couple, ou rester un moment perso, selon la série."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oibríonn scíth éighníomhach duit. Is féidir leis seo a bheith ina ghnás álainn don bheirt agaibh — nó go hiomlán aonair, ag brath ar an seó."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciónache o descanso pasivo. Pode ser un ritual de parella xenial ou algo totalmente individual, segundo a serie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિરાંતે બેસીને આરામ તમને ફાવે છે. આ કપલની સરસ સહિયારી આદત બની શકે — કે સાવ અંગત પણ, શો પર આધાર."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hutu ba tare da wahala ba na yi muku aiki. Wannan zai iya zama kyakkyawar al'adar ku biyu — ko ta kowa daban gaba ɗaya, ya danganta da shirin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רגיעה פסיבית עובדת בשבילך. זה יכול להיות טקס זוגי נהדר — או משהו אישי לגמרי, תלוי בסדרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आराम से कुछ देखना आपको सुकून देता है। यह एक प्यारी साझा रस्म बन सकती है — या पूरी तरह निजी, शो पर निर्भर करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasivno opuštanje ti odgovara. To može biti divan zajednički ritual – ili posve osobna stvar, ovisno o seriji."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detant pasif mache pou ou. Sa ka yon bèl abitid pou nou de a — oswa yon bagay pèsonèl nèt, selon emisyon an."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked a passzív kikapcsolódás válik be. Ez lehet remek közös rituálé – vagy teljesen egyéni, a sorozattól függően."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պասիվ հանգիստը քեզ համար է։ Սա կարող է հրաշալի զույգային ծես լինել — կամ լիովին անհատական, կախված սերիալից։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaksasi pasif cocok untukmu. Ini bisa jadi ritual berdua yang menyenangkan — atau sepenuhnya pribadi, tergantung tontonannya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izu ike dị mfe na-arụ ọrụ nye gị. Nke a nwere ike ịbụ ezigbo omenala unu abụọ — ma ọ bụ nke onwe kpamkpam, dabere na ihe a na-ekiri."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Óvirk slökun hentar þér. Þetta getur verið frábær sameiginleg venja – eða alveg þín eigin, eftir því hvaða þáttur er í gangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relax passivo fa per te. Può diventare un bellissimo rituale di coppia — o un momento tutto tuo, dipende dalla serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け身でリラックスできるタイプです。観るもの次第で、ふたりの素敵な習慣にも、完全にひとりの時間にもなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santai kanthi ayem cocog kanggo panjenengan. Iki bisa dadi pakulinan bareng sing apik banget — utawa dhewe-dhewe babar pisan, gumantung tontonane."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პასიური დასვენება გიხდება. ეს შეიძლება წყვილის მშვენიერი საერთო რიტუალი იყოს — ან სრულიად ინდივიდუალური, იმის მიხედვით, რას უყურებთ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саған жайбарақат демалыс жарасады. Бұл жұптың тамаша ортақ рәсімі бола алады — не толықтай жеке, қандай шоу екеніне байланысты."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការសម្រាកបែបស្ងប់ស្ងាត់សមនឹងអ្នក។ នេះអាចជាទម្លាប់រួមដ៏ល្អសម្រាប់គូ — ឬជារឿងផ្ទាល់ខ្លួនទាំងស្រុង អាស្រ័យលើកម្មវិធីដែលមើល។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸುಮ್ಮನೆ ಕುಳಿತು ವಿಶ್ರಮಿಸುವುದು ನಿಮಗೆ ಸರಿಹೊಂದುತ್ತದೆ. ಇದು ಜೋಡಿಯ ಸುಂದರ ರೂಢಿಯಾಗಬಹುದು — ಅಥವಾ ಸಂಪೂರ್ಣ ವೈಯಕ್ತಿಕ, ಕಾರ್ಯಕ್ರಮದ ಮೇಲೆ ಅವಲಂಬಿತ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편하게 늘어지는 휴식이 잘 맞아요. 무엇을 보느냐에 따라 멋진 커플 의식이 될 수도, 완전히 혼자만의 시간이 될 수도 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bêhnvedana pasîf ji te re dixebite. Ev dikare bibe rîtuelek xweş a hevpar ji bo cotê — an jî bi tevahî kesane, li gorî rêzefîlmê."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сага пассивдүү эс алуу туура келет. Бул жуп үчүн сонун жалпы ырым болушу мүмкүн — же сериалга жараша толугу менен жеке."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entspaans dech gutt beim Kucken. Dat kann e schéint Ritual zu zweet sinn — oder ganz eleng, jee no Serie."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການພັກຜ່ອນແບບສະບາຍໆເໝາະກັບເຈົ້າ ມັນອາດເປັນກິດຈະວັດຄູ່ທີ່ດີ — ຫຼື ເປັນເລື່ອງສ່ວນຕົວໄປເລີຍ ຂຶ້ນຢູ່ກັບລາຍການ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau tinka pasyvus poilsis. Tai gali būti puikus bendras poros ritualas – arba visai asmeninis, priklausomai nuo serialo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev der pasīva atpūta. Tas var būt lielisks kopīgs rituāls – vai pilnīgi individuāls, atkarībā no seriāla."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mety aminao ny fialan-tsasatra tsy mila ezaka. Mety ho fanao tsara iarahan'ny mpifankatia izany — na manokana tanteraka, arakaraka ny zavatra jerena."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pai ki a koe te whakatā ngāwari. Ka taea tēnei hei tikanga tokorua pai — hei mea takitahi rānei, kei te whakaaturanga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пасивното опуштање ти одговара. Ова може да биде одличен заеднички ритуал — или сосема индивидуален, зависно од серијата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വെറുതെയിരുന്നുള്ള വിശ്രമമാണ് നിങ്ങൾക്ക് ചേരുന്നത്. ഷോ അനുസരിച്ച്, ഇത് ജോഡിയായുള്ള മനോഹരമായ ഒരു ശീലമാകാം — അല്ലെങ്കിൽ പൂർണമായും വ്യക്തിപരവും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идэвхгүй амралт чамд тохирдог. Энэ хосын гайхалтай зан үйл болж чадна — эсвэл цувралаасаа хамаараад бүрэн ганцаарчилсан."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निवांत बसून विश्रांती तुमच्यासाठी उपयोगी ठरते. हा दोघांचा छान विधी होऊ शकतो — किंवा कार्यक्रमानुसार पूर्णपणे वैयक्तिकही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersantai secara pasif sesuai untuk anda. Ia boleh menjadi rutin pasangan yang hebat — atau aktiviti sendiri, bergantung pada rancangannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-rilassament passiv jaħdem għalik. Dan jista' jkun ritwal sabiħ ta' koppja — jew għal kollox individwali, skont is-serje."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ငြိမ်ငြိမ်လေး အနားယူတာ သင့်အတွက် အဆင်ပြေတယ်။ ဒါက စုံတွဲ ဓလေ့ကောင်း ဖြစ်နိုင်သလို — ဇာတ်လမ်းပေါ် မူတည်ပြီး လုံးဝ တစ်ယောက်တည်းလည်း ဖြစ်နိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv avkobling fungerer for deg. Det kan bli et fint ritual for dere to – eller helt ditt eget, alt etter serien."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निष्क्रिय आराम तपाईंलाई सुहाउँछ। यो जोडीको राम्रो साझा रीत बन्न सक्छ — वा कार्यक्रमअनुसार पूरै व्यक्तिगत पनि।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passief ontspannen werkt voor jou. Dat kan een heerlijk ritueel voor jullie samen zijn – of helemaal iets voor jezelf, afhankelijk van de serie."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupumula mosachita khama kumakuthandizani. Uwu ukhoza kukhala mwambo wabwino wa inu awiri — kapena wa munthu payekha, kutengera pulogalamuyo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boqonnaan salphaan siif tola. Kun sirna jaalallee lamaanii bareedaa ta'uu danda'a — ykn guutummaatti dhuunfaa, akka sagantaa sanaatti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆରାମରେ ବସି ଦେଖିବା ଆପଣଙ୍କ ପାଇଁ କାମ କରେ। ଶୋ' ଅନୁସାରେ, ଏହା ଦୁହିଁଙ୍କ ପାଇଁ ଏକ ସୁନ୍ଦର ଅଭ୍ୟାସ ହୋଇପାରେ — ବା ପୂରାପୂରି ନିଜସ୍ୱ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬੈਠ ਕੇ ਆਰਾਮ ਕਰਨਾ ਤੁਹਾਡੇ ਲਈ ਕੰਮ ਕਰਦਾ ਹੈ। ਇਹ ਜੋੜੇ ਦੀ ਵਧੀਆ ਸਾਂਝੀ ਰਸਮ ਬਣ ਸਕਦੀ ਹੈ — ਜਾਂ ਪੂਰੀ ਤਰ੍ਹਾਂ ਨਿੱਜੀ, ਇਹ ਸ਼ੋਅ ਉੱਤੇ ਨਿਰਭਰ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bierny relaks ci służy. To może być świetny wspólny rytuał – albo zupełnie osobny, zależnie od serialu."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غیر فعاله آرامي ستاسو لپاره ګټوره ده. دا کولی شي د جوړې یو ښه ګډ عادت وي — یا بشپړ شخصي، د خپرونې پورې اړه لري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxar sem esforço funciona para você. Pode ser um ótimo ritual do casal — ou algo totalmente individual, dependendo da série."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relaxamento passivo resulta contigo. Pode ser um ótimo ritual a dois — ou algo totalmente individual, conforme a série."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxarea pasivă funcționează pentru tine. Poate fi un ritual frumos în doi — sau ceva complet individual, în funcție de serial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе подходит пассивный отдых. Это может стать отличным ритуалом для двоих — или чем-то совсем личным, смотря что за сериал."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuruhuka utuje biragukundira. Bishobora kuba umugenzo mwiza musangiye — cyangwa ukaba uwawe bwite, bitewe n'icyo ureba."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නිකන් ඉඳන් විවේක ගැනීම ඔබට ගැළපෙනවා. මේක ලස්සන යුවළ පුරුද්දක් වෙන්න පුළුවන් — නැත්නම් බලන දේ අනුව සම්පූර්ණයෙන්ම පුද්ගලික එකක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasívny oddych ti vyhovuje. Môže to byť skvelý spoločný rituál – alebo úplne osobný, podľa toho, čo práve pozeráš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebi ustreza pasivna sprostitev. To je lahko lep skupni ritual – ali povsem osebna stvar, odvisno od serije."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuzorora wakagara kunokushandira. Iyi inogona kuva tsika yakanaka yenyu vaviri — kana yako woga zvachose, zvichienderana nechirongwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasasho fudud ayaa kuu shaqaysa. Tani waxay noqon kartaa caado wadajir ah oo qurux badan — ama mid gebi ahaan shakhsi ah, iyadoo ku xiran barnaamijka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çlodhja pasive të bën mirë. Kjo mund të jetë një ritual i bukur për ju të dy – ose krejt individual, varet nga seriali."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пасивно опуштање ти прија. То може бити диван заједнички ритуал — или потпуно лична ствар, зависно од серије."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santai anu pasif cocog pikeun anjeun. Ieu tiasa janten kabiasaan babarengan anu saé — atanapi pinuh pribadi, gumantung kana tontonanana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv avkoppling funkar för dig. Det kan bli en fin gemensam ritual – eller något helt eget, beroende på serien."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupumzika bila juhudi kunakufaa. Hili linaweza kuwa desturi nzuri ya wenzi wawili — au la mtu binafsi kabisa, kulingana na kipindi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எளிய ஓய்வு உங்களுக்குப் பொருந்துகிறது. இது ஜோடியாகப் பகிரும் அருமையான சடங்காகலாம் — அல்லது நிகழ்ச்சியைப் பொறுத்து முழுக்கத் தனிப்பட்டதாகவும் இருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "హాయిగా కూర్చుని చూడటం మీకు విశ్రాంతి. ఏ షో అన్నదాన్ని బట్టి, ఇది జంటగా అద్భుతమైన అలవాటు కావచ్చు — లేదా పూర్తిగా వ్యక్తిగతం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истироҳати ғайрифаъол ба ту мувофиқ аст. Ин метавонад анъанаи зебои муштарак бошад — ё комилан шахсӣ, вобаста ба филм."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การพักผ่อนแบบสบายๆ ได้ผลกับคุณ อาจเป็นกิจวัตรคู่รักที่ดีมาก หรือเป็นเวลาส่วนตัวล้วนๆ ก็ได้ แล้วแต่ว่าดูเรื่องอะไร"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ህዱእ ዕረፍቲ ይሰርሓልኩም። እዚ ጽቡቕ ናይ ሓባር ልምዲ ክኸውን ይኽእል — ወይ ከም እቲ መደብ ብምሉኡ ውልቃዊ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saňa ýuwaş dynç alyş ýaraýar. Bu ajaýyp umumy däp bolup biler — ýa-da görýän zadyňyza görä, doly şahsy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasif dinlenme sana iyi geliyor. Diziye göre harika bir çift ritüeli de olabilir, tamamen bireysel bir an da."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі допомагає пасивний відпочинок. Це може бути чудовий спільний ритуал — або цілком особистий, залежно від серіалу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آرام سے بیٹھ کر سکون لینا آپ کے لیے کارگر ہے۔ یہ جوڑے کا ایک زبردست مشترکہ معمول بن سکتا ہے — یا پوری طرح انفرادی، شو پر منحصر ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizga sokin dam olish mos. Bu ajoyib umumiy juftlik odati boʻlishi mumkin — yoki serialga qarab, butunlay shaxsiy."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư giãn nhẹ nhàng hợp với bạn. Đây có thể là nghi thức tuyệt vời của hai bạn — hoặc hoàn toàn riêng tư, tùy bộ phim."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuphumla ngokuhlala nje kuyakusebenzela. Oku kunokuba lisiko elihle lesibini — okanye kube kokwakho wedwa, kuxhomekeke kumboniso."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìsinmi láìṣe nǹkan kan ń ṣiṣẹ́ fún yín. Èyí lè jẹ́ àṣà àjọṣe tó dára fún ẹ̀yin méjèèjì — tàbí ti ara ẹni pátápátá, ó dá lórí ètò tí ẹ ń wò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆地看看東西就能讓你放鬆。這可以是很好的兩人小儀式，也可以完全是個人時間，視乎看甚麼節目。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被动放松很适合你。这可以是很棒的两人仪式，也可以完全各看各的，看剧而定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆放空對你很有用。這可以是很棒的兩人小儀式，也可以完全是個人時間，看是什麼節目。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuphumula ungenzi lutho kuyasebenza kuwe. Lokhu kungaba umkhuba omuhle wombhangqwana — noma kube okwakho wedwa, kuya ngohlelo."
          }
        }
      }
    },
    "Patience has limits, and bottling things leads to bigger blow-ups. Small, early conversations are usually gentler for everyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld het perke, en opgekropte dinge lei tot groter uitbarstings. Klein, vroeë gesprekke is gewoonlik sagter vir almal."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትዕግሥት ገደብ አለው፤ ነገሮችን አፍኖ መያዝ ወደ ትልቅ ፍንዳታ ይመራል። ትናንሽና ቀደም ያሉ ውይይቶች ብዙውን ጊዜ ለሁሉም የዋህ ናቸው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للصبر حدود، وكتمان الأمور يقود إلى انفجارات أكبر. الأحاديث الصغيرة المبكرة عادةً ألطف على الجميع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধৈৰ্যৰো সীমা আছে, আৰু কথা মনত হেঁচি ৰাখিলে পিছত ডাঙৰ বিস্ফোৰণ হয়। আগতীয়াকৈ পতা সৰু সৰু কথা-বতৰা সকলোৰে বাবে সাধাৰণতে কোমল হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səbrin də həddi var, içində yığılanlar isə daha böyük partlayışlara gətirib çıxarır. Erkən, kiçik söhbətlər adətən hamı üçün daha yumşaq keçir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цярпенне не бясконцае, а стрыманыя пачуцці ўрэшце выбухаюць мацней. Невялікія своечасовыя размовы звычайна мякчэйшыя для ўсіх."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търпението има граници, а насъбраното води до по-големи изблици. Малките разговори навреме обикновено са по-нежни за всички."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধৈর্যেরও সীমা আছে, আর চেপে রাখলে পরে বড় বিস্ফোরণ হয়। ছোট থাকতেই আগেভাগে কথা বললে সাধারণত সবার জন্যই তা নরম হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strpljenje ima granice, a potisnute stvari vode do većih eksplozija. Mali, rani razgovori obično su blaži za sve."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paciència té límits, i aguantar-s'ho tot porta a explosions més grosses. Les converses petites i a temps solen ser més suaus per a tothom."
