          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دورهمی‌های بزرگ و پرسروصدای خانوادگی — هر چه شلوغ‌تر بهتر"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isoja, äänekkäitä sukujuhlia – mitä enemmän, sen parempi"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malalaki at maiingay na salo-salo ng pamilya — mas marami, mas masaya"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grandes tablées bruyantes, plus on est de fous…"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruinnithe móra, glórmhara teaghlaigh — dá mhéad is ea is fearr"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes reunións familiares con barullo: canto máis, mellor"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મોટા, ધમાલિયા પારિવારિક મેળાવડા — જેટલા વધુ એટલી મજા"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manyan taruka masu hayaniya na iyali — yawan mutane, yawan daɗi"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפגשים משפחתיים גדולים ורועשים — כמה שיותר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े, चहल-पहल वाले पारिवारिक जमावड़े — जितने ज़्यादा, उतना अच्छा"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velika, glasna obiteljska okupljanja – što više, to bolje"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwo reyinyon fanmi ak anpil bri — plis moun, pi bon"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagy, hangos családi összejövetelek – minél többen, annál jobb"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեծ, աղմկոտ ընտանեկան հավաքույթներ՝ որքան շատ, այնքան լավ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul keluarga besar yang ramai — makin banyak makin seru"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nnọkọ ezinụlọ buru ibu, nwere mkpọtụ — ka ọ na-aba, ka ọ na-adị mma"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stór og hávær fjölskylduboð – því fleiri, því betra"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandi riunioni di famiglia — più siamo, meglio è"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大勢でにぎやかに。多いほど楽しい"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul kulawarga gedhe lan rame — saya akeh saya apik"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დიდი, ხმაურიანი ოჯახური შეკრებები — რაც მეტი, მით უკეთესი"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үлкен, шулы отбасылық жиындар, неғұрлым көп болса, соғұрлым жақсы"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការជួបជុំគ្រួសារធំ អ៊ូអរ — កាន់តែច្រើនកាន់តែល្អ"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೊಡ್ಡ, ಗದ್ದಲದ ಕುಟುಂಬ ಕೂಟಗಳು — ಹೆಚ್ಚು ಜನ, ಹೆಚ್ಚು ಮಜಾ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북적북적 대가족 모임, 많을수록 좋아요"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civînên malbatê yên mezin û bi deng — çiqas zêde, ewqas baş"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чоң, ызы-чуулуу үй-бүлөлүк жыйындар — канча көп болсо, ошончо жакшы"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grouss, haart Familljefester — wat méi, wat besser"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ງານຄອບຄົວໃຫຍ່ ມ່ວນຊື່ນ — ຍິ່ງຫຼາຍຍິ່ງດີ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dideli, triukšmingi giminės susibūrimai – kuo daugiau, tuo geriau"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieli, skaļi ģimenes saieti – jo vairāk, jo labāk"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivoriam-pianakaviana lehibe sy mitabataba — arakaraka ny maro no tsara"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He huihuinga whānau nui, turituri — ko te nui te pai"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Големи, бучни семејни собири — колку повеќе, толку подобро"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വലിയ, ബഹളമുള്ള കുടുംബസംഗമങ്ങൾ — എത്ര കൂടുതലോ അത്രയും നല്ലത്"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Том, шуугиантай гэр бүлийн цугларалт — олон байх тусам сайн"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोठे, गजबजलेले कौटुंबिक मेळावे — जितके जास्त तितके छान"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul keluarga besar yang meriah — makin ramai makin seronok"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laqgħat kbar u storbjużi tal-familja — aktar ma jkun hemm, aħjar"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စည်စည်ကားကား မိသားစု ဆုံဆည်းပွဲကြီး — များလေ ကောင်းလေ"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store, høylytte familieselskaper – jo flere, jo bedre"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठुलो, हल्लाखल्लायुक्त पारिवारिक जमघट — जति धेरै उति रमाइलो"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote, luidruchtige familiefeesten – hoe meer zielen…"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misonkhano ikuluikulu ya banja yaphokoso — ochuluka bwino"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walga'ii maatii gurguddaa fi sagalee qabu — baay'inni caalaa gaarii dha"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବଡ଼, ଚହଳପୂର୍ଣ୍ଣ ପାରିବାରିକ ଜମାଟ — ଯେତେ ଅଧିକ ସେତେ ଭଲ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਡੇ, ਰੌਣਕ ਭਰੇ ਪਰਿਵਾਰਕ ਇਕੱਠ — ਜਿੰਨੇ ਵੱਧ, ਓਨਾ ਵਧੀਆ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duże, głośne zjazdy rodzinne – im więcej, tym lepiej"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لویې او شور لرونکې کورنۍ غونډې — هر څومره ډېر، هومره ښه"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes festas em família — quanto mais, melhor"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes reuniões de família barulhentas — quanto mais, melhor"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reuniuni mari de familie, gălăgioase — cu cât mai mulți, cu atât mai bine"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шумные семейные застолья — чем больше, тем лучше"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amateraniro manini y'umuryango arimo urusaku — uko ari benshi ni ko biryoha"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ලොකු, ඝෝෂාකාරී පවුලේ එකතුවීම් — වැඩි වෙන තරමට හොඳයි"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľké, hlučné rodinné stretnutia – čím viac, tým lepšie"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velika, glasna družinska srečanja – več ko nas je, bolje je"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuungana kukuru kwemhuri kune ruzha — vazhinji zviri nani"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulamo qoys oo waaweyn oo buuq leh — inta badan ayaa fiican"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbledhje të mëdha e të zhurmshme familjare – sa më shumë, aq më mirë"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Велика, гласна породична окупљања — што више, то боље"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul kulawarga anu ageung sareng ramé, langkung seueur langkung saé"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stora, högljudda släktträffar – ju fler desto bättre"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikusanyiko mikubwa ya familia yenye kelele — wengi ndivyo bora"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெரிய, கலகலப்பான குடும்பக் கூட்டங்கள் — எவ்வளவு பேரோ அவ்வளவு நல்லது"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పెద్ద, సందడిగా కుటుంబ సమావేశాలు — ఎంత మంది ఉంటే అంత బాగు"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҷамъомадҳои калону пурсадои оилавӣ — ҳар чӣ бештар, беҳтар"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมญาติครึกครื้น ยิ่งเยอะยิ่งดี"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዓበይቲ ዕግርግር ዘለዎም ናይ ስድራ ኣኼባታት — ዝበዝሑ ዝሓሹ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uly, şowhunly maşgala ýygnanyşyklary — näçe köp bolsa, şonça gowy"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalabalık, gürültülü aile buluşmaları: ne kadar çok, o kadar iyi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великі гучні родинні застілля — що більше, то краще"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بڑے، رونق بھرے خاندانی اجتماعات، جتنے زیادہ اتنا اچھا"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katta, shovqinli oilaviy yigʻinlar — qancha koʻp boʻlsa, shuncha yaxshi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia đình tụ họp đông vui — càng đông càng tốt"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iindibano ezinkulu nezinengxolo zosapho — kokukhona sisininzi, kokukhona kumnandi"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àpèjọ ẹbí ńlá, aláriwo — bí ó ti pọ̀ tó ló dára tó"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱鬧的大家庭聚會——人越多越好"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热闹的大家庭聚会，人越多越好"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱鬧的大家族聚會，人越多越好"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imibuthano emikhulu yomndeni enomsindo — uma beningi kungcono"
          }
        }
      }
    },
