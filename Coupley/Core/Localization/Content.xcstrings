        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুটোই সমান — একসাথেও বাড়ি, আলাদাও বাড়ি"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oboje podjednako – rastete i zajedno i odvojeno"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dues coses per igual — es creix plegats i per separat"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obojí stejně – růst spolu i každý zvlášť"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y ddau yr un fath — rydyn ni'n tyfu gyda'n gilydd ac ar wahân"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lige meget af begge – sammen og hver for sig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides gleich – zusammen und jeder für sich"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τα δύο εξίσου — εξελισσόμαστε μαζί και χωριστά"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas cosas: crecer juntos y por separado"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõlemat võrdselt — kasvate koos ja eraldi"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biak neurri berean: elkarrekin eta bakoitza bere aldetik hazten gara"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر دو به یک اندازه — هم با هم رشد می‌کنید، هم جدا"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molemmat yhtä paljon – kasvamme yhdessä ja erikseen"
          }
        },
        "fil" : {
