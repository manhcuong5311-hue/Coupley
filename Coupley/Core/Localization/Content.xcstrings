        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyakorlatias egyensúly. Közös felelősség és személyes önállóság. A legtöbb párnak ez hosszú távon is működik."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գործնական հավասարակշռություն։ Ընդհանուր պատասխանատվություն գումարած անձնական ինքնավարություն։ Զույգերի մեծ մասը սա երկար ժամանակ հարմար է համարում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keseimbangan yang praktis. Tanggung jawab bersama plus kebebasan pribadi. Kebanyakan pasangan merasa ini bisa bertahan lama."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguzozi bara uru. Ọrụ unu na-ekerịta na nnwere onwe nke onwe. Ọtụtụ ndị nọ na mmekọrịta na-ahụ na nke a na-adịgide n'ogologo oge."
