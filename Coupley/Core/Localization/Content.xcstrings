        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténs o teu par presente no dia a dia. Os rituais e as associações partilhadas têm significado para ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți păstrezi partenerul aproape în viața de zi cu zi. Ritualurile și lucrurile care vă leagă înseamnă mult pentru tine."
