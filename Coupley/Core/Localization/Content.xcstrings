    "Embodied learning. Getting better at something physical is uniquely satisfying — and often social." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلّم بالجسد. التحسّن في شيء بدني يمنح رضا فريدًا، وغالبًا ما يكون اجتماعيًا أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učení tělem. Zlepšovat se v něčem fyzickém přináší zvláštní uspokojení – a často je to i společenská záležitost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læring med kroppen. At blive bedre til noget fysisk er helt særligt tilfredsstillende – og ofte socialt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen mit dem Körper. Bei etwas Körperlichem besser zu werden, ist besonders befriedigend – und oft gesellig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθηση μέσα από το σώμα. Το να βελτιώνεσαι σε κάτι σωματικό δίνει μοναδική ικανοποίηση — και συχνά είναι και κοινωνικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender con el cuerpo. Mejorar en algo físico es especialmente satisfactorio — y muchas veces, social."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehollista oppimista. Fyysisessä kehittymisessä on ainutlaatuista tyydytystä – ja usein se on myös sosiaalista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkatutong ramdam ng katawan. Kakaibang kasiyahan ang gumaling sa isang pisikal na bagay — at madalas, sosyal pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendre par le corps. Progresser dans quelque chose de physique procure une satisfaction unique — et c'est souvent social."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למידה דרך הגוף. להשתפר במשהו פיזי זה סיפוק מיוחד — ולעיתים קרובות גם חברתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीर से सीखना। किसी शारीरिक चीज़ में बेहतर होना अनोखा सुकून देता है — और अक्सर लोगों से जोड़ता भी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanulás a testeddel. Ha egy mozgásos dologban fejlődsz, az egészen különleges elégedettséget ad – és gyakran közösségi élmény is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belajar lewat tubuh. Makin jago dalam hal fisik itu memuaskan dengan cara yang unik — dan sering kali jadi ajang bersosialisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imparare con il corpo. Migliorare in qualcosa di fisico dà una soddisfazione unica — e spesso si fa in compagnia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体で覚える学びです。体を使うことが上達する喜びは格別で、人とのつながりも生まれやすいものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸으로 배우는 즐거움이에요. 몸 쓰는 실력이 느는 건 특별한 만족감을 주고, 사람들과 함께하게 될 때도 많아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belajar melalui tubuh. Menjadi lebih baik dalam sesuatu yang fizikal sangat memuaskan — dan selalunya melibatkan orang lain juga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læring med kroppen. Å bli bedre på noe fysisk gir en helt egen tilfredsstillelse – og er ofte sosialt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leren met je lijf. Beter worden in iets fysieks geeft een unieke voldoening – en is vaak ook sociaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauka ciałem. Postępy w czymś fizycznym dają wyjątkową satysfakcję – i często łączą ludzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender com o corpo. Evoluir em algo físico é especialmente gratificante — e muitas vezes social."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învățare prin corp. Să progresezi la ceva fizic e o satisfacție aparte — și adesea una socială."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обучение через тело. Прогресс в чём-то физическом приносит особое удовольствие — и часто новые знакомства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lärande genom kroppen. Att bli bättre på något fysiskt ger en alldeles speciell tillfredsställelse – och är ofta socialt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียนรู้ผ่านร่างกาย การเก่งขึ้นในเรื่องทางกายให้ความพอใจที่ไม่เหมือนใคร และมักได้เพื่อนใหม่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedenle öğrenmek. Fiziksel bir şeyde gelişmek eşsiz bir tatmin verir ve çoğu zaman sosyaldir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчання через тіло. Прогрес у чомусь фізичному дає особливе задоволення — і часто нові знайомства."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Học bằng cơ thể. Tiến bộ ở một điều gì đó thể chất mang lại sự thỏa mãn rất riêng — và thường gắn với bạn bè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用身体去学习。在身体技能上进步，有种独特的满足感，而且常常能结识朋友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用身體學習。在體能上進步有種獨特的滿足感，而且常常是和別人一起進行的。"
          }
        }
      }
    },
