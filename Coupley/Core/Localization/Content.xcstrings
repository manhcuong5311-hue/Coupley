        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo utiče na zajedničke obroke, kupovinu namirnica i izlaske u restorane – vrijedi znati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afecta els àpats compartits, la compra i els sopars fora — val la pena saber-ho."
