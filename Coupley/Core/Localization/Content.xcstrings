        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipò ṣe pàtàkì. Ìrìn sí ìlú ní òpin ọ̀sẹ̀ àti ìrìn-àjò ìgbéyàwó yẹ fún ìnáwó tó yàtọ̀. Ọgbọ́n ìlò nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看情況而定。週末城市短遊和蜜月旅行，值得不同的預算。很務實。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看场合。周末城市游和蜜月旅行，预算当然不一样。很务实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看情況而定。週末城市小旅行和蜜月旅行，本來就該有不同預算。很務實。"
