    "Night owl who would sleep better if I went to bed earlier" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من عشاق السهر، وسأنام أفضل لو بكّرت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noční sova, která by spala líp, kdyby chodila spát dřív"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natteravn, der ville sove bedre, hvis jeg gik tidligere i seng"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachteule – früher ins Bett würde mir guttun"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νυχτοπούλι — θα κοιμόμουν καλύτερα αν έπεφτα νωρίτερα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soy de noche — dormiría mejor si me acostara antes"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yökyöpeli – nukkuisin paremmin, jos menisin aiemmin nukkumaan"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night owl na mas makakatulog nang maayos kung maagang hihiga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oiseau de nuit qui dormirait mieux en se couchant plus tôt"
