        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለእርስዎ የውጥረት ምክንያት አይደለም። ለአጋርዎ ግን ሊሆን ስለሚችል ቢያካፍሏቸው ይጠቅማል።"
