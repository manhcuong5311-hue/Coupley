        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нәзік жауап, көбіне ең сау жауап. Маңызды жерде бірге, қажет жерде тәуелсіз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចម្លើយដែលល្អិតល្អន់ — ហើយជារឿយៗក៏ល្អបំផុតសម្រាប់ទំនាក់ទំនង។ នៅជាមួយគ្នាពេលដែលសំខាន់ ឯករាជ្យពេលដែលចាំបាច់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೂಕ್ಷ್ಮವಾದ ಉತ್ತರ — ಹಲವು ಬಾರಿ ಅತ್ಯಂತ ಆರೋಗ್ಯಕರವಾದದ್ದೂ ಹೌದು. ಬೇಕಾದಲ್ಲಿ ಜೊತೆಯಾಗಿ, ಮುಖ್ಯವಾದಲ್ಲಿ ಸ್ವತಂತ್ರವಾಗಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "섬세한 답이고, 대개 가장 건강한 답이에요. 중요한 곳에선 함께, 필요한 곳에선 따로."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersiva bi hûrgilî — û gelek caran ya herî saxlem. Li cihê ku pêwîst e bi hev re, li cihê ku girîng e serbixwe."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойлонулган жооп — жана көбүнчө эң дени сак жооп. Керек жерде бирге, маанилүү жерде өз алдынча."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déi nuancéiert Äntwert — an dacks déi gesondst. Zesummen, wou et zielt, onofhängeg, wou et wichteg ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄຳຕອບທີ່ລະອຽດອ່ອນ — ແລະ ມັກເປັນຄຳຕອບທີ່ດີທີ່ສຸດ ໄປນຳກັນໃນເລື່ອງທີ່ສຳຄັນຕໍ່ທັງສອງ ເປັນອິດສະລະໃນເລື່ອງທີ່ສຳຄັນຕໍ່ຕົວເອງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niuansuotas atsakymas – ir dažnai sveikiausias. Kartu ten, kur svarbu, savarankiškai ten, kur reikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niansēta atbilde – un bieži visveselīgākā. Kopā tur, kur tas ir būtiski, neatkarīgi tur, kur tas ir svarīgi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valiny voalanjalanja — ary matetika ny salama indrindra. Miaraka amin'izay ilaina, mahaleo tena amin'izay manan-danja."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te whakautu hōhonu — ā, ko te mea hauora rawa i te nuinga o te wā. Ngātahi ki ngā wāhi tika, motuhake ki ngā wāhi e hira ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нијансиран одговор — и често најздравиот. Заедно таму каде што е важно, независно таму каде што има значење."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സൂക്ഷ്മതയുള്ള ഉത്തരം — പലപ്പോഴും ഏറ്റവും ആരോഗ്യകരമായതും. വേണ്ടിടത്ത് ഒരുമിച്ച്, പ്രധാനമുള്ളിടത്ത് സ്വതന്ത്രമായി."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарийн хариулт — ихэвчлэн хамгийн эрүүл нь. Чухал газар хамтдаа, хэрэгтэй газар бие даасан."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकावे जाणणारे उत्तर — आणि बऱ्याचदा सर्वात निरोगी. जिथे गरज तिथे एकत्र, जिथे महत्त्वाचे तिथे स्वतंत्र."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawapan yang bernuansa — dan selalunya yang paling sihat. Bersama dalam perkara yang penting, bebas dalam hal yang bermakna bagi diri sendiri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It-tweġiba bl-isfumaturi — u spiss l-aktar waħda b'saħħitha. Flimkien fejn jgħodd, indipendenti fejn hu importanti."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သေချာ စဉ်းစားထားတဲ့ အဖြေပါ — များသောအားဖြင့် အကျန်းမာဆုံးလည်း ဖြစ်တယ်။ အရေးကြီးတဲ့နေရာမှာ အတူ၊ လိုအပ်တဲ့နေရာမှာ လွတ်လပ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nyanserte svaret – og ofte det sunneste. Sammen der det teller, selvstendig der det betyr noe."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूक्ष्म जवाफ — र प्रायः सबैभन्दा स्वस्थ पनि। जहाँ आवश्यक छ त्यहाँ सँगै, जहाँ महत्त्वपूर्ण छ त्यहाँ स्वतन्त्र।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het genuanceerde antwoord – en vaak het gezondste. Samen waar het telt, onafhankelijk waar het ertoe doet."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yankho lozama — ndipo nthawi zambiri ndilo labwino kwambiri. Limodzi pamene kuli kofunika, padera pamene kuli koyenera."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deebii xiinxalame — yeroo baay'ees isa fayya qabeessa. Bakka barbaachisutti waliin, bakka murteessaa ta'etti walaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସୂକ୍ଷ୍ମ ଉତ୍ତର — ଆଉ ପ୍ରାୟତଃ ସବୁଠାରୁ ସୁସ୍ଥ। ଯେଉଁଠି ଦରକାର ସେଠି ଏକାଠି, ଯେଉଁଠି ଗୁରୁତ୍ୱପୂର୍ଣ୍ଣ ସେଠି ସ୍ୱାଧୀନ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੋਚਿਆ-ਸਮਝਿਆ ਜਵਾਬ — ਅਤੇ ਅਕਸਰ ਸਭ ਤੋਂ ਤੰਦਰੁਸਤ ਵੀ। ਜਿੱਥੇ ਲੋੜ ਹੋਵੇ ਇਕੱਠੇ, ਜਿੱਥੇ ਮਾਇਨੇ ਰੱਖੇ ਆਜ਼ਾਦ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź pełna niuansów – i często najzdrowsza. Razem tam, gdzie to ważne, osobno tam, gdzie to potrzebne."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظریف ځواب — او اکثره تر ټولو روغ. هلته یوځای چې ارزښت لري، هلته خپلواک چې مهم وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta cheia de nuances — e muitas vezes a mais saudável. Juntos onde conta, independentes onde importa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta cheia de nuances — e muitas vezes a mais saudável. Juntos onde conta, independentes onde importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răspunsul nuanțat — și adesea cel mai sănătos. Împreună unde contează, independent unde e important."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонкий ответ — и часто самый здоровый. Вместе там, где это важно, и независимо там, где это нужно."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igisubizo cyitondewe — kandi akenshi ni cyo cyiza kurusha ibindi. Hamwe aho bikenewe, buri wese ukwe aho ari ngombwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සියුම් පිළිතුර — බොහෝ විට වඩාත්ම සෞඛ්‍ය සම්පන්න එකත්. වැදගත් තැන් වලදී එකට, අවශ්‍ය තැන් වලදී ස්වාධීනව."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premyslená odpoveď – a často tá najzdravšia. Spolu tam, kde to má význam, samostatne tam, kde na tom záleží."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premišljen odgovor – in pogosto najbolj zdrav. Skupaj tam, kjer šteje, neodvisno tam, kjer je pomembno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mhinduro yakadzama — uye kazhinji ine hutano kupfuura dzose. Pamwe chete pazvinokosha, wakazvimiririra pazvinodiwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaabta faahfaahsan — inta badanna midda ugu caafimaadka badan. Wadajir meesha ay muhiim tahay, madax-bannaan meesha ay qiimo leedahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përgjigjja me nuanca – dhe shpesh më e shëndetshmja. Bashkë aty ku ka vlerë, të pavarur aty ku ka rëndësi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нијансиран одговор — и често најздравији. Заједно где се рачуна, независно где је важно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban anu lengkep, sareng sering anu paling séhat. Babarengan dina hal anu penting, mandiri dina hal anu ageung hartosna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nyanserade svaret – och ofta det sundaste. Tillsammans där det räknas, självständiga där det spelar roll."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jibu lenye uwiano — na mara nyingi lenye afya zaidi. Pamoja panapohitajika, huru panapostahili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நுணுக்கமான பதில் — பெரும்பாலும் மிக ஆரோக்கியமானதும் கூட. தேவையான இடத்தில் சேர்ந்து, முக்கியமான இடத்தில் தனியாக."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లోతైన సమాధానం — తరచుగా అత్యంత ఆరోగ్యకరమైనది కూడా. అవసరమైన చోట కలిసి, ముఖ్యమైన చోట స్వతంత్రంగా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҷавоби нозук — ва аксар вақт солимтаринаш. Якҷоя дар он ҷое, ки лозим аст, мустақил дар он ҷое, ки муҳим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบที่ละเอียดอ่อน และมักเป็นแบบที่ดีต่อใจที่สุด อยู่ด้วยกันในเรื่องที่สำคัญ และเป็นอิสระในเรื่องที่ควรเป็น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እቲ ዝተመጠነ መልሲ — መብዛሕትኡ ግዜ ድማ እቲ ዝጥዕየ። ኣብ ዝቑጸረሉ ብሓባር፣ ኣብ ዘገድሰሉ ናጻ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inçe jogap — we köplenç iň sagdyny. Möhüm ýerde bile, gerek ýerde garaşsyz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnce ayarlı cevap ve çoğu zaman en sağlıklısı. Önemli yerde birlikte, gereken yerde bağımsız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонка відповідь — і часто найздоровіша. Разом — у головному, окремо — там, де це важливо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوچا سمجھا جواب، اور اکثر سب سے صحت مند بھی۔ جہاں ضروری ہو وہاں ساتھ، جہاں اہم ہو وہاں آزاد۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nozik javob — va koʻpincha eng sogʻlomi. Muhim joyda birga, kerakli joyda mustaqil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời tinh tế — và thường là lành mạnh nhất. Cùng nhau ở những điều đáng kể, độc lập ở những điều quan trọng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impendulo enobunzulu — kwaye idla ngokuba yeyona isempilweni. Kunye apho kubalulekileyo khona, ngokuzimela apho kufunekayo khona."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdáhùn tó jinlẹ̀ — tó sì sábà jẹ́ èyí tó ní ìlera jù. Papọ̀ níbi tó yẹ, lọ́tọ̀ níbi tó ṣe pàtàkì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有層次的答案，往往也是最健康的。在重要的事上同步，在需要的地方獨立。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有分寸的答案，往往也是最健康的。重要的事一起面对，在意的地方保持独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細膩的答案，往往也是最健康的。該一起的地方一起，該獨立的地方獨立。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impendulo ecabangisisiwe — futhi ngokuvamile enempilo kakhulu. Ndawonye lapho kubalulekile khona, nizimele lapho kufanele khona."
          }
        }
      }
    },
    "The relationship is your sanctuary. Too many external commitments can feel like they dilute the intimacy you value." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verhouding is jou toevlug. Te veel verpligtinge van buite kan voel of dit die intimiteit verwater wat jy so waardeer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ግንኙነቱ መጠጊያዎ ነው። ብዙ የውጭ ግዴታዎች የሚወዱትን መቀራረብ የሚያቀልሉ ሆኖ ሊሰማዎት ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العلاقة ملاذكم. كثرة الالتزامات الخارجية قد تبدو لكم كأنها تُضعف الحميمية التي تقدّرونها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পৰ্কটোৱেই আপোনাৰ আশ্ৰয়স্থল। বাহিৰৰ বেছি দায়বদ্ধতাই আপুনি মূল্য দিয়া ঘনিষ্ঠতা পাতল কৰি দিয়া যেন লাগিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münasibət sənin sığınacağındır. Kənardan gələn çoxlu öhdəlik dəyər verdiyin yaxınlığı sulandırırmış kimi gəlir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адносіны — твой прытулак. Калі вонкавых абавязкаў зашмат, здаецца, што яны размываюць блізкасць, якую ты цэніш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката е твоето убежище. Твърде много външни ангажименти могат да разводнят близостта, която цениш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পর্কটাই তোমার আশ্রয়। বাইরের অনেক ব্যস্ততা তোমার কাছে প্রিয় ঘনিষ্ঠতাকে ফিকে করে দেয় বলে মনে হতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza je tvoje utočište. Previše vanjskih obaveza može razvodniti bliskost koju cijeniš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relació és el teu refugi. Tenir massa compromisos fora et pot fer sentir que es dilueix la intimitat que valores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vztah je tvoje útočiště. Máš pocit, že příliš mnoho závazků navenek ředí intimitu, které si ceníš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y berthynas yw dy noddfa. Gall gormod o ymrwymiadau allanol deimlo fel eu bod yn gwanhau'r agosatrwydd rwyt ti'n ei werthfawrogi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet er dit fristed. For mange forpligtelser udefra kan føles, som om de udvander den intimitet, du sætter pris på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Beziehung ist dein Rückzugsort. Zu viele Verpflichtungen nach außen fühlen sich an, als würden sie die Nähe verwässern, die dir so wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σχέση είναι το καταφύγιό σου. Οι πολλές εξωτερικές υποχρεώσεις σού μοιάζουν να αραιώνουν την οικειότητα που εκτιμάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relación es tu refugio. Demasiados compromisos externos pueden dar la sensación de diluir la intimidad que valoras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suhe on sinu pelgupaik. Liiga paljud välised kohustused võivad tunduda, nagu lahjendaksid need lähedust, mida hindad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harremana da zure babeslekua. Kanpoko konpromiso gehiegik baloratzen duzun intimitatea urtzen dutela iruditzen zaizu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابطه پناهگاه توست. تعهدهای بیرونی زیاد ممکن است حس کنی صمیمیتی را که برایت عزیز است کم‌رنگ می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parisuhde on turvapaikkasi. Liian monet ulkoiset menot voivat tuntua laimentavan läheisyyttä, jota arvostat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang relasyon ang santuwaryo mo. Pakiramdam mo, napapalabnaw ng sobrang daming lakad sa labas ang lapit na pinahahalagahan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre couple est ton refuge. Trop d'engagements extérieurs, et tu as l'impression que l'intimité à laquelle tu tiens se dilue."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an caidreamh do thearmann. Má bhíonn an iomarca gealltanas lasmuigh ann, braitheann tú go laghdaíonn siad an dlúthchaidreamh is mór agat."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relación é o teu refuxio. Demasiados compromisos externos poden parecer que diluén a intimidade que tanto valoras."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંબંધ તમારું આશ્રયસ્થાન છે. બહારની વધારે પડતી જવાબદારીઓ તમને ગમતી આત્મીયતાને પાતળી કરી નાખે એવું લાગી શકે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dangantakarku ita ce mafakarku. Yawan alƙawura na waje na iya zama kamar suna rage kusancin da kuke daraja."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזוגיות היא המקלט שלך. יותר מדי התחייבויות מבחוץ עלולות להרגיש כאילו הן מדללות את האינטימיות שחשובה לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिश्ता आपकी पनाह है। बाहर की बहुत सारी ज़िम्मेदारियाँ आपको उस नज़दीकी को फीका करती लगती हैं, जिसे आप संजोते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza je tvoje utočište. Previše vanjskih obveza može razvodniti intimnost koju cijeniš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relasyon an se refij ou. Twòp angajman deyò ka sanble yo dilye entimite ou bay valè a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat a menedéked. A túl sok külső program mintha felhígítaná a bensőségességet, amelyet annyira értékelsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հարաբերությունները քո ապաստանն են։ Շատ արտաքին պարտավորությունները կարող են թվալ, թե նոսրացնում են այն մտերմությունը, որ դու այդքան գնահատում ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan adalah tempat berlindungmu. Terlalu banyak komitmen di luar bisa terasa mengencerkan keintiman yang kamu hargai."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmekọrịta unu bụ ebe nchekwa gị. Ọtụtụ ihe n'èzí nwere ike ịdị ka ha na-ebelata mmekọ ị na-akpọ ihe."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambandið er griðastaðurinn þinn. Of margar skuldbindingar utan þess geta virst þynna út nándina sem þú metur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relazione è il tuo rifugio. Troppi impegni esterni rischiano di annacquare l’intimità a cui tieni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの関係が心の避難所です。外の予定が多すぎると、大切にしている親密さが薄まる気がしてしまいます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesambungan iku papan perlindungan panjenengan. Kakehan urusan ing njaba bisa rumangsa ngurangi rasa cedhak sing panjenengan ajeni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ურთიერთობა შენი თავშესაფარია. ზედმეტი გარე ვალდებულებები შეიძლება გეჩვენოს, რომ იმ სიახლოვეს ასუსტებს, რომელსაც აფასებ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қарым-қатынас — сенің панаң. Сырттағы міндеттер тым көп болса, сен бағалайтын жақындықты сұйылтатындай көрінеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទំនាក់ទំនងគឺជាជម្រកសុខរបស់អ្នក។ ការជាប់រវល់ខាងក្រៅច្រើនពេក អាចធ្វើឲ្យភាពស្និទ្ធស្នាលដែលអ្នកឲ្យតម្លៃ ស្រាកស្រាន់ទៅ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಬಂಧವೇ ನಿಮ್ಮ ಆಶ್ರಯತಾಣ. ಹೊರಗಿನ ಹೆಚ್ಚು ಬದ್ಧತೆಗಳು ನೀವು ಮೆಚ್ಚುವ ಆತ್ಮೀಯತೆಯನ್ನು ತೆಳುವಾಗಿಸುತ್ತವೆ ಅನಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연애는 나만의 안식처예요. 바깥 약속이 너무 많으면 소중한 친밀함이 옅어지는 것처럼 느껴져요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Têkilî penageha te ye. Gelek erkên derve dikarin wisa xuya bikin ku nêzîkiya ku tu qîmetê didiyê sist dikin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мамиле — сенин башпаанегиң. Сырттагы милдеттер көбөйсө, сен баалаган жакындык суюлуп калгандай сезилет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är Bezéiung ass däi Réckzuchsuert. Ze vill Verflichtungen dobausse kënnen sech ufillen, wéi wa se déi Noperschaft verwässeren, déi s du esou schätz."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມສຳພັນຄືບ່ອນພັກໃຈຂອງເຈົ້າ ນັດໝາຍພາຍນອກທີ່ຫຼາຍເກີນໄປອາດຮູ້ສຶກຄືມັນເຈືອຈາງຄວາມໃກ້ຊິດທີ່ເຈົ້າໃຫ້ຄຸນຄ່າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santykiai – tavo prieglobstis. Per daug išorinių įsipareigojimų gali atrodyti lyg skiedžiantys tau brangų artumą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiecības ir tavs patvērums. Pārāk daudz ārēju saistību tev šķiet atšķaidām tuvību, ko tu tik ļoti vērtē."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fialofanao ny fifandraisana. Mety ho toa manalefaka ny fifanakaikezana sarobidy aminao ny andraikitra ivelany be loatra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te hononga tō piringa. Ko ngā here nui o waho, ka rongo pea koe e whakangoikore ana i te tata e whakanuia ana e koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Врската е твое засолниште. Премногу надворешни обврски може да ти изгледаат како да ја разредуваат блискоста што ја цениш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബന്ധമാണ് നിങ്ങളുടെ അഭയസ്ഥാനം. പുറത്തുള്ള തിരക്കുകൾ കൂടിയാൽ, നിങ്ങൾ വിലമതിക്കുന്ന അടുപ്പം നേർത്തുപോകുന്നതായി തോന്നിയേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Харилцаа бол чиний ариун орон. Гадны хэт олон амлалт чиний эрхэмлэдэг дотно байдлыг сулруулах мэт санагддаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे नाते तुमचे हक्काचे आश्रयस्थान आहे. बाहेरच्या जास्त जबाबदाऱ्यांमुळे तुम्हाला प्रिय असलेली जवळीक कमी होते असे वाटू शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan ialah tempat perlindungan anda. Terlalu banyak komitmen luar boleh terasa seperti mencairkan keintiman yang anda hargai."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-relazzjoni hija l-kenn tiegħek. Wisq impenji minn barra jistgħu jidhrulek li qed inaqqsu l-intimità li tapprezza."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်ဆံရေးက သင့်ရဲ့ ခိုလှုံရာပါ။ ပြင်ပ တာဝန်တွေ များလွန်းရင် သင်တန်ဖိုးထားတဲ့ ရင်းနှီးမှုကို ပါးလျသွားစေသလို ခံစားရနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet er fristedet ditt. For mange forpliktelser utenfra kan føles som om de vanner ut nærheten du setter pris på."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सम्बन्ध तपाईंको शान्त आश्रय हो। बाहिरी प्रतिबद्धता धेरै हुँदा तपाईंले कदर गर्ने आत्मीयता पातलिएजस्तो लाग्न सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De relatie is je veilige haven. Te veel verplichtingen buitenaf voelen alsof ze de intimiteit verwateren die je zo waardeert."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubale wanu ndi pothawirapo panu. Zochita zambiri za kunja zingaoneke ngati zikuchepetsa kuyandikana komwe mumakuyamikira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hariiroon iddoo boqonnaa keeti. Dirqamni alaa baay'een walitti dhiyeenya ati jaallattu kan laaffisu sitti fakkaachuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସମ୍ପର୍କ ହିଁ ଆପଣଙ୍କ ଆଶ୍ରୟସ୍ଥଳ। ବାହାରର ବେଶି ବ୍ୟସ୍ତତା ଆପଣ ମୂଲ୍ୟ ଦେଉଥିବା ଆତ୍ମୀୟତାକୁ ପତଳା କରିଦେଲା ଭଳି ଲାଗିପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰਿਸ਼ਤਾ ਤੁਹਾਡੀ ਪਨਾਹ ਹੈ। ਬਹੁਤੀਆਂ ਬਾਹਰੀ ਜ਼ਿੰਮੇਵਾਰੀਆਂ ਤੁਹਾਨੂੰ ਉਸ ਨੇੜਤਾ ਨੂੰ ਫਿੱਕਾ ਕਰਦੀਆਂ ਲੱਗ ਸਕਦੀਆਂ ਹਨ ਜਿਸ ਦੀ ਤੁਸੀਂ ਕਦਰ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Związek to twoja przystań. Zbyt wiele zobowiązań na zewnątrz może rozmywać bliskość, którą tak cenisz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اړیکه ستاسو پناه‌ځای دی. ډېرې بهرنۍ ژمنې ښايي داسې ښکاره شي لکه هغه نږدېوالی کمزوری کوي چې تاسو یې ارزښت ګڼئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relação é seu refúgio. Compromissos demais lá fora podem diluir a intimidade que você valoriza."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relação é o teu refúgio. Demasiados compromissos externos podem parecer diluir a intimidade que valorizas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relația e refugiul tău. Prea multe obligații din afară îți dau senzația că diluează intimitatea pe care o prețuiești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отношения — твоё убежище. Слишком много внешних обязательств словно размывает близость, которую ты ценишь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umubano wanyu ni ubuhungiro bwawe. Gahunda nyinshi zo hanze zishobora kumvikana nk'izigabanya ubucuti bwimbitse uha agaciro."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සබඳතාව ඔබේ රැකවරණයයි. පිටතින් එන බැඳීම් ගොඩක් වුණොත් ඔබ අගය කරන සමීපත්වය දියාරු වෙනවා වගේ දැනෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzťah je tvoje útočisko. Priveľa záväzkov navonok ti môže pripadať, akoby riedili blízkosť, ktorú si ceníš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnos je tvoje zatočišče. Preveč zunanjih obveznosti lahko razredči intimnost, ki jo ceniš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukama ndiyo nzvimbo yako yerugare. Zvisungo zvakawandisa zvekunze zvinogona kunzwika sezvinoderedza kuswedera kwaunokoshesa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriirku waa magangalkaaga. Ballamo badan oo dibadda ah waxay kula ekaan karaan inay qasayaan dhawaanshaha aad qiimayso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marrëdhënia është streha jote. Shumë angazhime nga jashtë mund të duken sikur e hollojnë intimitetin që vlerëson."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веза је твоје уточиште. Превише спољних обавеза може да ти делује као да разблажује блискост коју цениш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan téh tempat panyalindungan anjeun. Seueur teuing kawajiban di luar tiasa karaos ngirangan kadeukeutan anu anjeun hargaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationen är din fristad. För många åtaganden utanför kan kännas som att de urvattnar närheten du värdesätter."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhusiano ndio kimbilio lako. Ahadi nyingi za nje zinaweza kuhisi kama zinapunguza ukaribu unaouthamini."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உறவே உங்கள் புகலிடம். வெளி ஈடுபாடுகள் அதிகமானால், நீங்கள் மதிக்கும் நெருக்கம் நீர்த்துப் போவதாக உணரலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బంధమే మీ ఆశ్రయం. బయటి బాధ్యతలు ఎక్కువైతే, మీరు విలువిచ్చే సాన్నిహిత్యం పలచబడుతున్నట్టు అనిపిస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муносибат паноҳгоҳи туст. Ӯҳдадориҳои берунии аз ҳад зиёд метавонанд наздикиеро, ки ту қадр мекунӣ, суст кунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสัมพันธ์คือที่พักใจของคุณ นัดข้างนอกที่มากเกินไปอาจทำให้ความใกล้ชิดที่คุณให้คุณค่าดูเจือจางลง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ርክብኩም መዕቆቢኹም እዩ። ብዙሕ ናይ ደገ ዕማማት ነቲ እተኽብሩዎ ቅርበት ከም ዘዳኽሞ ይስምዓኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatnaşygyňyz seniň gaçybatalgaň. Daşky borçlaryň köp bolmagy seniň gymmatlandyrýan ýakynlygyňy gowşadýan ýaly duýulyp biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişki senin sığınağın. Dışarıdaki fazla meşguliyet, değer verdiğin yakınlığı sulandırıyormuş gibi gelebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стосунки — твій прихисток. Забагато зовнішніх зобов’язань ніби розмивають ту близькість, яку ти цінуєш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رشتہ آپ کی پناہ گاہ ہے۔ بہت زیادہ باہر کی مصروفیات اُس قربت کو پھیکا کرتی محسوس ہوتی ہیں جو آپ کے لیے قیمتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munosabatlaringiz — sizning panohingiz. Tashqi majburiyatlar koʻpayib ketsa, siz qadrlaydigan yaqinlikni suyultirib yuborgandek tuyuladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
