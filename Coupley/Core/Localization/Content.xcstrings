    "Emergency presence is your love language of support. You show up fully when it matters most." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحضور وقت الشدة هو لغة الدعم عندكم. تحضرون بكل كيانكم حين يكون الأمر مهمًا حقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Být po ruce v krizi – to je tvůj jazyk podpory. Když na tom nejvíc záleží, jsi tu naplno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du viser din støtte ved at rykke ud, når det brænder på. Når det virkelig gælder, er du der helt og fuldt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Notfall bist du voll da – so zeigst du Liebe. Wenn es wirklich zählt, bist du ganz präsent."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παρουσία στα δύσκολα είναι ο δικός σου τρόπος στήριξης. Όταν μετράει πραγματικά, είσαι εκεί με όλη σου την ψυχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente en las urgencias es tu forma de apoyar. Cuando más importa, apareces por completo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hätähetken läsnäolo on sinun tapasi tukea. Olet täysillä paikalla silloin, kun sillä on eniten väliä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang presensya sa oras ng kagipitan ang paraan mo ng pagsuporta. Buong-buo kang dumarating kapag pinakakailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton soutien, c'est la présence dans l'urgence. Quand ça compte vraiment, tu es là à cent pour cent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נוכחות ברגעי חירום היא שפת התמיכה שלך. כשזה הכי חשוב, יש שם מאה אחוז ממך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुश्किल घड़ी में मौजूद रहना ही आपके साथ देने का तरीक़ा है। जब सबसे ज़्यादा ज़रूरत हो, तब आपका पूरा साथ मिलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha baj van, azonnal ott termsz – így támogatsz. Amikor a legnagyobb szükség van rád, teljes szívvel jelen vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadir saat genting adalah bahasa cintamu dalam mendukung. Kamu datang sepenuhnya di saat paling penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esserci nelle emergenze è il tuo modo di sostenere. Quando conta davvero, ci sei al cento per cento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いざというときに駆けつけるのが、あなたなりの支え方。いちばん大事な場面で、全力でそばにいられる人です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위기의 순간에 곁을 지키는 게 사랑을 표현하는 방식이에요. 가장 중요할 때 온전히 함께해 주죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadir ketika kecemasan ialah bahasa cinta sokongan anda. Anda hadir sepenuhnya saat ia paling penting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å stille opp når det brenner, er ditt støttespråk. Du er der helt og fullt når det betyr mest."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn als het erop aankomt, dat is jouw manier van steunen. Op de momenten die er het meest toe doen, ben je er helemaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecność w kryzysie to twój język wsparcia. Gdy naprawdę trzeba, jesteś w stu procentach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente na hora do aperto é o seu jeito de apoiar. Você aparece por inteiro quando mais importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezența în momentele grele e felul tău de a sprijini. Când contează cel mai mult, ești acolo cu totul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой язык поддержки — быть рядом в трудную минуту. Когда это важнее всего, ты отдаёшься полностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ställa upp när det krisar är ditt sätt att stötta. Du finns där helt och fullt när det verkligen gäller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การมาหาทันทียามฉุกเฉินคือภาษารักในแบบของคุณ คุณพร้อมอยู่ตรงนั้นเต็มที่ในวันที่สำคัญที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin destek dilin, zor anda orada olmak. En önemli anda tüm benliğinle yanındasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя мова підтримки — бути поруч у критичну мить. Коли це найважливіше, ти віддаєшся повністю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có mặt lúc khẩn cấp là cách bạn yêu thương và nâng đỡ. Bạn dốc hết lòng vào những lúc quan trọng nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急时刻的陪伴，就是你表达支持的方式。越是关键时刻，你越会全心全意地出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關鍵時刻的陪伴，就是你表達支持的方式。最重要的時候，你會全心全意出現。"
          }
        }
      }
    },
