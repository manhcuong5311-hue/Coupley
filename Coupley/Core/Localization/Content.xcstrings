        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ආදරය හොඳින්ම භාර ගන්නේ මෙහෙමයි — ඔබේ සහකරු මෙය දැනගත යුතුයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takto lásku prijímaš najlepšie – tvoja polovička by to mala vedieť."
