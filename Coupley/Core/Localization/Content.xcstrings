    "Put a hand on their back or shoulder, no words needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضعوا يدًا على ظهر شريكك أو كتفه، بلا حاجة إلى كلمات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polož protějšku ruku na záda nebo na rameno, slova nejsou potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg en hånd på ryggen eller skulderen – der er ikke brug for ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg eine Hand auf Rücken oder Schulter – Worte braucht es nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακούμπησε το χέρι σου στην πλάτη ή στον ώμο του ταιριού σου, χωρίς λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una mano en su espalda o su hombro, sin necesidad de palabras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita käsi hänen selälleen tai olalleen, sanoja ei tarvita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipatong ang kamay sa likod o balikat niya, hindi kailangan ng salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose une main sur son dos ou son épaule, sans un mot."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להניח יד על הגב או על הכתף, בלי צורך במילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी पीठ या कंधे पर हाथ रखें, शब्दों की ज़रूरत नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd a kezed a hátára vagy a vállára, szavak nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan tangan di punggung atau bahunya, tanpa kata-kata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoggia una mano sulla sua schiena o sulla spalla, senza bisogno di parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背中や肩にそっと手を置きましょう。言葉はいりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말없이 등이나 어깨에 손을 얹어 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan tangan di belakang atau bahunya, tanpa perlu berkata apa-apa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg en hånd på ryggen eller skulderen til partneren din, uten ord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg een hand op de rug of schouder van je partner, woorden zijn niet nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż dłoń na plecach albo ramieniu drugiej połówki – słowa niepotrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponha a mão nas costas ou no ombro do seu amor, sem precisar dizer nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune-i o mână pe spate sau pe umăr, fără cuvinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положи руку партнёру на спину или плечо — слова не нужны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg en hand på din partners rygg eller axel, inga ord behövs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางมือบนหลังหรือไหล่ของคนรัก ไม่ต้องพูดอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elini sırtına ya da omzuna koy; söze gerek yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поклади руку на спину чи плече — слова не потрібні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt tay lên lưng hoặc vai người ấy, không cần lời nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手轻轻放在另一半的背上或肩上，不用说话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手輕放在對方的背或肩上，不需要說話。"
          }
        }
      }
