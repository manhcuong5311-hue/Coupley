        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad y buena disposición. Solo asegúrate de que lo dices en serio — una mascota es un compromiso largo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastutulelik ja valmis. Vaata vaid, et mõtled seda päriselt — lemmikloom on pikk kohustus."
