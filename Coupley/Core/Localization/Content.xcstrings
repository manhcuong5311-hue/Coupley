    "When they take on your burden without being asked, it says 'I see how much you're carrying'. That's love." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين يحمل شريكك عبئك دون أن تطلبوا، فهو يقول «أرى ثقل ما على كتفيك». هذا هو الحب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když tvůj protějšek sám od sebe vezme na sebe tvoje břemeno, říká tím: „Vidím, kolik toho neseš.“ To je láska."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når din partner tager en byrde fra dig uden at blive spurgt, siger det »jeg kan se, hvor meget du bærer på«. Det er kærlighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir jemand ungefragt eine Last abnimmt, heißt das: „Ich sehe, wie viel du trägst.“ Das ist Liebe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν το ταίρι σου παίρνει πάνω του το βάρος σου χωρίς να του το ζητήσεις, λέει «βλέπω πόσα κουβαλάς». Αυτό είναι αγάπη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando tu pareja asume tu carga sin que se lo pidas, te está diciendo “veo todo lo que llevas encima”. Eso es amor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun toinen ottaa taakkasi kantaakseen pyytämättä, se kertoo: ”näen, kuinka paljon kannat”. Se on rakkautta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag inako niya ang pasanin mo nang hindi mo hinihingi, parang sinasabi niyang “nakikita ko kung gaano kabigat ang dala mo”. Iyan ang pagmamahal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l'autre porte ton fardeau sans que tu le demandes, ça dit « je vois tout ce que tu portes ». C'est ça, l'amour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמישהו לוקח ממך עומס בלי שביקשת, זה אומר 'אני רואה כמה זה כבד לך'. זו אהבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब पार्टनर बिना कहे आपका बोझ उठा लें, तो यह कहता है कि “मुझे दिखता है आप पर कितना कुछ है”। यही प्यार है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor kérés nélkül átveszi a terhedet, azt üzeni: „látom, mennyi minden van a válladon”. Ez a szeretet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat dia mengambil alih bebanmu tanpa diminta, seolah dia berkata “aku lihat betapa beratnya yang kamu pikul”. Itulah cinta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l’altra persona si fa carico di un tuo peso senza che tu lo chieda, ti sta dicendo «vedo quanto stai portando». Questo è amore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頼まなくても重荷を引き受けてくれると、「たくさん抱えているのをわかっているよ」と伝わります。それこそが愛です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부탁하지 않아도 내 짐을 대신 들어 줄 때, “네가 얼마나 힘든지 알아”라는 마음이 전해져요. 그게 사랑이죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila pasangan anda memikul beban anda tanpa diminta, ia menyampaikan ‘Saya nampak betapa beratnya beban anda’. Itulah cinta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når noen bærer byrden din uten at du ber om det, sier det «jeg ser hvor mye du bærer på». Det er kjærlighet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je partner ongevraagd een last van je overneemt, zegt dat: ‘ik zie hoeveel je draagt’. Dat is liefde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ktoś bierze na siebie twój ciężar bez proszenia, mówi tym: „widzę, ile dźwigasz”. To jest miłość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando seu amor assume um peso seu sem você pedir, é um jeito de dizer “eu vejo o quanto você carrega”. Isso é amor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când partenerul tău îți preia o povară fără să i-o ceri, spune „văd cât de mult duci”. Asta e iubire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда партнёр без просьб берёт твою ношу на себя, это значит «я вижу, как много ты несёшь». Это и есть любовь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När din partner tar över en börda utan att du ber om det säger det ”jag ser hur mycket du bär på”. Det är kärlek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคนรักรับภาระของคุณไปโดยไม่ต้องขอ มันบอกว่า “ฉันเห็นว่าคุณแบกอะไรไว้มากแค่ไหน” นั่นแหละคือความรัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen istemeden yükünü üstlendiğinde “Ne kadar çok şey taşıdığını görüyorum” demiş oluyor. İşte sevgi bu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли половинка без прохань бере твій тягар на себе, це означає: «Я бачу, скільки ти несеш». Це і є любов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi người ấy gánh giúp bạn mà không cần nhờ, điều đó nói lên “mình thấy bạn đang mang nhiều thế nào”. Đó là yêu thương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方没等你开口就替你分担，等于在说“我看到你扛了多少”。这就是爱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方不用你開口就幫你扛下重擔，等於在說「我看見你承受了多少」。這就是愛。"
          }
        }
      }
    },
    "When we're ready. Whatever shape that takes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين نكون مستعدين، أيًّا كان الشكل الذي يأخذه ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až přijde ten správný čas. Ať to bude vypadat jakkoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når vi er klar. Uanset hvilken form det tager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn wir bereit sind. Wie auch immer das aussieht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν νιώσουμε ότι ήρθε η ώρα. Όποια μορφή κι αν πάρει αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llegue el momento. Sea de la forma que sea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olemme valmiita. Missä muodossa tahansa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag handa na tayo. Anuman ang anyo nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand ce sera le bon moment. Quelle que soit la forme que ça prendra."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשנהיה מוכנים. איך שזה לא ייראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब हम तैयार हों। जिस भी रूप में हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor készen állunk. Bármilyen formában is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat kita siap. Dalam bentuk apa pun nantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando saremo pronti. In qualunque forma arrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたときに。どんなかたちでも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비가 되었을 때, 어떤 모습이든."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila kita sudah bersedia. Dalam apa jua bentuknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når vi er klare. Uansett hvilken form det tar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als we er klaar voor zijn. In welke vorm dan ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy przyjdzie na to czas. W jakiejkolwiek formie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando for a hora. Do jeito que for."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când va veni momentul. Indiferent ce formă ar lua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда будем готовы. Как бы это ни сложилось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När vi är redo. Hur det än blir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเราพร้อม ไม่ว่าจะออกมาในรูปแบบไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
