        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibiryo ni bumwe mu buryo bworoshye bwo kugaragaza ko witaye ku muntu — kumenya ibyo umukunzi wawe akunda bifite agaciro."
