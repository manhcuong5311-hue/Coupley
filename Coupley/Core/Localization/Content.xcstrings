        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observerende – jeg ser det, andre overser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachtend – mir fällt auf, was andere übersehen"
