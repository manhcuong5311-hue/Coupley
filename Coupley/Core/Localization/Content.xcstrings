        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іс жүзіндегі өсу. Әрі қарай жалғастырғың келмейтін нәрселерді анықтап, олардың үстінде жұмыс істеп жатырсың. Бұл маңызды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការរីកចម្រើនក្នុងសកម្មភាព។ អ្នកបានកំណត់ឃើញអ្វីដែលអ្នកមិនចង់បន្តទៅមុខ — ហើយអ្នកកំពុងខិតខំធ្វើ។ នោះជារឿងសំខាន់ណាស់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಣ್ಣೆದುರಿನ ಬೆಳವಣಿಗೆ. ಮುಂದಿನವರಿಗೆ ದಾಟಿಸಬಾರದ ವಿಷಯಗಳನ್ನು ನೀವು ಗುರುತಿಸಿದ್ದೀರಿ — ಮತ್ತು ಅದಕ್ಕಾಗಿ ಶ್ರಮಿಸುತ್ತಿದ್ದೀರಿ. ಅದು ದೊಡ್ಡ ವಿಷಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성장하고 있는 중이에요. 물려주고 싶지 않은 걸 알아차리고 직접 노력하고 있죠. 정말 의미 있는 일이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezinbûn di çalakiyê de. Te tiştên ku naxwazî derbasî pêşerojê bikî nas kirine — û tu li ser wan dixebitî. Ev girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иш жүзүндөгү өсүү. Андан ары бергиң келбеген нерселерди аныктап, алардын үстүндө иштеп жатасың. Бул чоң нерсе."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuesstem a Beweegung. Du hues erkannt, wat s de net weiderginn wëlls — an du packs et un. Dat ass vill wäert."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເຕີບໂຕທີ່ລົງມືເຮັດຈິງ ເຈົ້າຮູ້ວ່າມີຫຍັງທີ່ບໍ່ຢາກສົ່ງຕໍ່ — ແລະ ເຈົ້າກຳລັງພະຍາຍາມ ນັ້ນເປັນເລື່ອງທີ່ສຳຄັນຫຼາຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augimas veiksme. Atpažinai, ko nenori perduoti toliau, – ir dirbi su tuo. Tai daug reiškia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaugsme darbībā. Tu zini, ko negribi nodot tālāk – un pie tā strādā. Tas ir nozīmīgi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitomboana am-pihetsika. Fantatrao ny zavatra tsy tianao handova — ary miezaka ianao. Zava-dehibe izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tipu e mahia ana. Kua kitea e koe ngā mea kāore koe e hiahia ki te tuku iho — ā, kei te mahi koe i te mahi. He mea nui tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раст на дело. Ги препознаваш работите што не сакаш да ги пренесеш понатаму — и работиш на тоа. Тоа е значајно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വളർച്ച പ്രവൃത്തിയിൽ. മുന്നോട്ട് കൊണ്ടുപോകേണ്ടെന്ന് തോന്നുന്ന കാര്യങ്ങൾ നിങ്ങൾ തിരിച്ചറിഞ്ഞിട്ടുണ്ട് — അതിനായി പരിശ്രമിക്കുന്നുമുണ്ട്. അത് വലിയ കാര്യമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өсөлт үйл явц дээрээ. Цаашаа дамжуулахыг хүсэхгүй зүйлсээ тодорхойлж, түүн дээрээ ажиллаж байна. Энэ чухал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्यक्ष घडणारी वाढ. पुढे नेऊ नयेत अशा गोष्टी तुम्ही ओळखल्या आहेत — आणि त्यावर काम करत आहात. हे खूप मोठे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertumbuhan yang nyata. Anda sudah kenal pasti perkara yang tidak mahu diwariskan — dan anda sedang berusaha. Itu sangat bermakna."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tkabbir fl-azzjoni. Identifikajt affarijiet li ma tridx tgħaddi lil ħaddieħor — u qed tagħmel ix-xogħol. Dan sinifikanti."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်တွေ့ ကြီးထွားနေခြင်း။ ဆက်မလွှဲပေးချင်တဲ့ အရာတွေကို ဖော်ထုတ်ပြီး ကြိုးစားနေတယ်။ ဒါ အရေးပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vekst i praksis. Du har funnet ting du ikke vil føre videre – og du gjør jobben. Det er stort."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यवहारमा विकास। अर्को पुस्तामा नसार्ने कुराहरू तपाईंले पहिचान गर्नुभएको छ — र त्यसमा काम गर्दै हुनुहुन्छ। यो ठुलो कुरा हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groei in actie. Je weet wat je niet wilt doorgeven – en je werkt eraan. Dat is niet niks."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukula kukuchitika. Mwazindikira zinthu zomwe simukufuna kupatsira ena — ndipo mukuchitapo kanthu. Zimenezo ndi zazikulu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guddina hojii irra jiru. Waan dabarsuu hin barbaanne adda baafatteerta — irrattis hojjechaa jirta. Kun waan guddaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କାମରେ ବିକାଶ। ଆପଣ ଚିହ୍ନିଛନ୍ତି କେଉଁ କଥା ଆଗକୁ ବଢ଼ାଇବାକୁ ଚାହାନ୍ତି ନାହିଁ — ଆଉ ସେଥିପାଇଁ କାମ କରୁଛନ୍ତି। ଏହା ବଡ଼ କଥା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਮਲ ਵਿੱਚ ਤਰੱਕੀ। ਤੁਸੀਂ ਪਛਾਣ ਲਿਆ ਹੈ ਕਿ ਕੀ ਅੱਗੇ ਨਹੀਂ ਤੋਰਨਾ — ਅਤੇ ਤੁਸੀਂ ਉਸ ਉੱਤੇ ਮਿਹਨਤ ਕਰ ਰਹੇ ਹੋ। ਇਹ ਵੱਡੀ ਗੱਲ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozwój w praktyce. Wiesz, czego nie chcesz przekazywać dalej – i pracujesz nad tym. To dużo znaczy."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په عمل کې وده. تاسو هغه شیان پېژندلي چې نه غواړئ نورو ته یې ولېږدوئ — او پرې کار کوئ. دا ډېر مهم دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crescimento na prática. Você identificou o que não quer passar adiante — e está fazendo esse trabalho. Isso tem muito valor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crescimento em ação. Identificaste o que não queres passar adiante — e estás a fazer o trabalho. Isso é importante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creștere în acțiune. Ai identificat ce nu vrei să transmiți mai departe — și chiar lucrezi la asta. Contează enorm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рост в действии. Ты понимаешь, что не хочешь передавать дальше, и работаешь над этим. Это многое значит."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukura mu bikorwa. Wamenye ibintu udashaka kuraga abandi — kandi urimo kubikoraho. Ibyo ni ingenzi cyane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ක්‍රියාවෙන් පෙන්නන වර්ධනය. ඊළඟට දෙන්න ඕනේ නැති දේවල් ඔබ හඳුනාගෙන — ඒ වෙනුවෙන් වැඩ කරනවා. ඒක වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast v praxi. Vieš, čo nechceš odovzdať ďalej – a pracuješ na tom. To je veľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast v praksi. Prepoznaš stvari, ki jih ne želiš predati naprej – in delaš na tem. To veliko pomeni."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukura kuri kuitika. Wakaona zvinhu zvausingadi kupa vanotevera — uye uri kuzvishandira. Izvozvo zvinokosha."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korriin ficil ah. Waxaad aqoonsatay waxyaabo aadan rabin inaad gudbiso — waadna ka shaqaynaysaa. Taasi waa wax weyn."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rritje në veprim. Ke dalluar gjëra që nuk do t’i trashëgosh më tej – dhe po punon për to. Kjo është shumë domethënëse."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раст на делу. Уочаваш шта не желиш да пренесеш даље — и радиш на томе. То је велика ствар."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamekaran anu nyata. Anjeun parantos terang naon anu teu hoyong diwariskeun, sareng anjeun nuju ngusahakeunana. Éta penting pisan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utveckling i praktiken. Du har sett vad du inte vill föra vidare – och du gör jobbet. Det är stort."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuaji kwa vitendo. Umetambua mambo usiyotaka kuyarithisha — na unafanya kazi hiyo. Hilo ni jambo kubwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயலில் வளர்ச்சி. அடுத்தவருக்குக் கடத்த விரும்பாதவற்றை அடையாளம் கண்டு, அதற்காக உழைக்கிறீர்கள். அது பெரிய விஷயம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆచరణలో ఎదుగుదల. తర్వాతి తరానికి అందించకూడదనుకునే విషయాలను మీరు గుర్తించారు — వాటిపై పని చేస్తున్నారు. అది చాలా గొప్ప విషయం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рушд дар амал. Ту чизҳоеро ёфтаӣ, ки намехоҳӣ ба дигарон гузаронӣ — ва дар болояшон кор мекунӣ. Ин хеле муҳим аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเติบโตที่จับต้องได้ คุณรู้ว่ามีอะไรที่ไม่อยากส่งต่อ และกำลังลงมือแก้ไข นั่นสำคัญมาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዕቤት ብተግባር። ከተሕልፍዎ ዘይትደልዩ ነገራት ለሊኹም — ድማ ትሰርሕሉ ኣለኹም። እዚ ዓቢ ነገር እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hereketdäki ösüş. Indiki nesle geçirmek islemeýän zatlaryňy anykladyň — we üstünde işleýärsiň. Bu uly zat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşte gerçek gelişim. Aktarmak istemediğin şeyleri fark ettin ve bunun için emek veriyorsun. Bu çok önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зростання в дії. Ти бачиш, чого не хочеш передавати далі, — і працюєш над цим. Це багато важить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترقی کا عمل۔ آپ نے پہچان لیا ہے کہ کیا آگے منتقل نہیں کرنا، اور اس پر کام جاری ہے۔ یہ بڑی بات ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaldagi oʻsish. Keyingilarga oʻtkazishni xohlamagan narsalaringizni aniqlagansiz — va ustida ishlayapsiz. Bu katta gap."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trưởng thành bằng hành động. Bạn đã nhận ra những điều không muốn truyền lại — và đang nỗ lực thay đổi. Điều đó rất đáng kể."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukhula okwenzekayo. Uzibonile izinto ongafuni ukuzidlulisela — kwaye uyasebenza kuzo. Oko kubalulekile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìdàgbàsókè ní ìṣe. Ẹ ti dá àwọn nǹkan tí ẹ kò fẹ́ fi lé àwọn tó ń bọ̀ lọ́wọ́ mọ̀ — ẹ sì ń ṣiṣẹ́ lé e lórí. Ìyẹn ṣe pàtàkì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長正在發生。你看清了不想傳承下去的東西，而且正在努力改變。這很了不起。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成长正在发生。你看清了哪些东西不想传下去，并且正在努力。这很了不起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在實踐的成長。你看清了哪些東西不想傳下去，也正在努力，這很了不起。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukhula kusebenza. Ubone izinto ongafuni ukuzidlulisela — futhi uyawenza umsebenzi. Lokho kubalulekile."
          }
        }
      }
    },
