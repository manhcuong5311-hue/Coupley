        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso que, si falta, hace que la relación no pueda funcionar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se asia, jonka puuttuessa suhde ei voi toimia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bagay na kapag wala, hindi gagana ang relasyon para sa’yo."
