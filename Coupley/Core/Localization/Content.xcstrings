          "stringUnit" : {
            "state" : "translated",
            "value" : "സന്തുലിതവും യാഥാർഥ്യബോധമുള്ളതും. നിങ്ങൾ അതിരുകടക്കുന്നില്ല — ഭക്ഷണം ആസ്വദിക്കുന്നു, ഒപ്പം സ്വയം ശ്രദ്ധിക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэнцвэртэй, бодитой. Чи туйлшрахгүй — хоолонд дуртай ч өөрийгөө ч бас арчилдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संतुलित आणि वास्तववादी. तुम्ही टोकाचे नाही — खाण्याचा आनंदही घेता आणि स्वतःची काळजीही घेता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang dan realistik. Anda tidak ekstrem — anda menikmati makanan tetapi juga menjaga diri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilanċ u realiżmu. M'intix tal-estremi — tgawdi l-ikel imma tieħu ħsieb ta' saħħtek ukoll."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မျှတပြီး လက်တွေ့ကျတယ်။ အစွန်းမရောက်ဘူး — စားရတာ ပျော်ပေမဲ့ ကိုယ့်ကိုယ်ကိုလည်း ဂရုစိုက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balansert og realistisk. Du går ikke til ytterligheter – du liker mat, men tar også vare på deg selv."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सन्तुलित र यथार्थवादी। तपाईं अति गर्नुहुन्न — खानामा रमाउनुहुन्छ तर आफ्नो ख्याल पनि राख्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenwichtig en realistisch. Je bent niet extreem – je houdt van eten, maar je zorgt ook goed voor jezelf."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolinganiza ndi wozindikira. Simupitirira malire — mumasangalala ndi chakudya koma mumadzisamaliranso."
