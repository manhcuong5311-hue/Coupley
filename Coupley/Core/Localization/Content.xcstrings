    "Fear, logistics, self-doubt — whatever it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوف، ظروف، شك في النفس — أيًا كان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strach, logistika, pochybnosti o sobě – ať je to cokoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frygt, logistik, selvtvivl – hvad end det er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angst, Organisation, Selbstzweifel – was auch immer es ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φόβος, πρακτικά θέματα, αμφιβολίες για τον εαυτό σου — ό,τι κι αν είναι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miedo, logística, inseguridad — lo que sea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelko, käytännön asiat, epäusko itseen – mitä tahansa se onkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takot, logistics, pagdududa sa sarili — kahit ano pa ’yan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
