        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなお茶や食べものを用意して、手の届くところに置いておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인이 좋아하는 차나 음식을 만들어 손 닿는 곳에 두세요."
