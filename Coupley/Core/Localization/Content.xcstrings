        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il preciso batte il generico. «Sei speciale» non lascia il segno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありきたりより具体的に。「すごいね」だけでは響きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뻔한 말보다 구체적인 말이에요. “정말 멋져요”는 밋밋하게 들려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khusus lebih baik daripada umum. “Anda hebat” terasa hambar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret slår generelt. «Du er fantastisk» faller flatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreet wint van algemeen. “Je bent geweldig” komt niet echt aan."
