        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ike na ịnweta ihe ngwa ngwa. Ị chọrọ ịga ije ebe niile, mkpọtụ, ihe dị nso. Obodo mepere emepe bụ ebe obibi gị."
