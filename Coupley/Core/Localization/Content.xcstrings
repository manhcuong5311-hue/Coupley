        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமநிலை. உங்களால் இரண்டையும் செய்ய முடியும் — ஆனால் உங்கள் இருவருக்குமான உலகைக் காப்பதில் கவனமாகவும் இருக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమతుల్యత. మీరు రెండూ చేయగలరు — కానీ మీ ఇద్దరి ప్రపంచాన్ని కాపాడుకోవడంలో కూడా శ్రద్ధగా ఉంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мувозин. Ту ҳардуро метавонӣ — вале огоҳона фазои муносибатро ҳифз мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมดุล คุณทำได้ทั้งสองอย่าง แต่ก็ตั้งใจปกป้องพื้นที่ส่วนตัวของความสัมพันธ์ไว้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሚዛናዊ። ክልቲኡ ትኽእሉ — ግን ናይ ርክብኩም ፍሉይ ዓለም ብንቕሓት ትሕልዉ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deňagramly. Sen ikisini hem başarýarsyň — ýöne gatnaşygyňyzyň aýratyn dünýäsini hem aňly goraýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengelisin. İkisini de yapabiliyorsun ama ilişkinizin kendine ait alanını korumaya da özen gösteriyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс. Ти вмієш і те, й інше — але свідомо бережеш вашу спільну бульбашку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوازن۔ دونوں چیزیں آپ کے لیے ممکن ہیں — مگر رشتے کی اپنی چھوٹی سی دنیا کی حفاظت پر بھی آپ کا پورا دھیان ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muvozanatli. Ikkalasini ham uddalaysiz — lekin ikkovingizning shaxsiy dunyongizni ham ongli ravishda asraysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng. Bạn làm được cả hai — nhưng cũng có ý thức giữ gìn thế giới riêng của hai bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulinganisela. Ungakwenza zombini — kodwa ukwazimisele nokukhusela ihlabathi lenu lobabini."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwọ̀ntúnwọ̀nsì. Ẹ lè ṣe méjèèjì — ṣùgbọ́n ẹ tún máa ń mọ̀ọ́mọ̀ dáàbò bo àyè ìfẹ́ ẹ̀yin méjèèjì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很平衡。兩樣你都可以，但你也會用心守護兩人的小世界。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很平衡。两种你都可以——但你也会有意守护属于你们的小世界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你很平衡，兩邊都能兼顧，同時也會刻意守護兩人的小天地。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulinganisela. Ungakwenza kokubili — kodwa futhi uyaqikelela ukuvikela isikhala sobudlelwano benu."
          }
        }
      }
    },
    "Balanced. You have professional pride without losing yourself in it. You're probably easy to be in a relationship with around this." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebalanseerd. Jy het professionele trots sonder om jouself daarin te verloor. Jy’s waarskynlik maklik om mee in ’n verhouding te wees wat dit betref."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሚዛናዊ። ራስዎን ሳያጡ በሙያዎ ይኮራሉ። በዚህ ረገድ ከእርስዎ ጋር ግንኙነት ውስጥ መሆን ቀላል ሳይሆን አይቀርም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توازن. اعتزاز مهني من دون الذوبان فيه، وهذا يجعل العلاقة معك سهلة في هذا الجانب."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাৰসাম্যপূৰ্ণ। নিজকে হেৰুৱাই নেপেলোৱাকৈ আপোনাৰ পেছাদাৰী গৌৰৱ আছে। এই বিষয়ত আপোনাৰ লগত সম্পৰ্কত থকাটো হয়তো সহজ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanslı. Peşəkar qürurun var, amma onda özünü itirmirsən. Yəqin ki, bu məsələdə səninlə münasibət qurmaq asandır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансавана. У цябе ёсць прафесійная годнасць, але ты не губляеш сябе ў ёй. З табой, напэўна, лёгка быць у адносінах у гэтым плане."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балансирано. Имаш професионална гордост, без да се губиш в нея. С теб вероятно е лесно да се живее в това отношение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভারসাম্য। পেশাগত গর্ব আছে, কিন্তু তাতে নিজেকে হারাও না। এ ব্যাপারে তোমার সাথে সম্পর্কে থাকা হয়তো বেশ সহজ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravnoteža. Imaš profesionalni ponos, a da se ne gubiš u njemu. Po tom pitanju s tobom je vjerovatno lako biti u vezi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibri. Tens orgull professional sense perdre't en la feina. Segurament és fàcil tenir una relació amb tu en aquest aspecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyváženě. Máš profesní hrdost, ale neztrácíš se v ní. V tomhle s tebou nejspíš bude snadné žít."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cytbwys. Mae gen ti falchder proffesiynol heb golli dy hun ynddo. Mae'n siŵr dy fod yn hawdd bod mewn perthynas â ti o ran hyn."
