        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie a kuerz Weeër. Du wëlls alles zu Fouss, Liewen ronderëm, Komfort. D'Stad ass däin natierleche Liewensraum."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ພະລັງ ແລະ ຄວາມສະດວກ ເຈົ້າຢາກຍ່າງໄປໃສມາໃສໄດ້ ມີສີສັນ ມີທຸກຢ່າງໃກ້ມື ເມືອງຄືບ້ານທີ່ແທ້ຈິງຂອງເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energija ir pasiekiamumas. Nori viską pasiekti pėsčiomis, nori šurmulio ir patogumo. Miestas – tavo natūrali aplinka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerģija un pieejamība. Tu gribi visu sasniegt kājām, troksni, ērtības. Pilsēta ir tava dabiskā vide."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hery sy fahafahana mandeha. Tianao ny azo aleha an-tongotra, ny feo, ny mora. Ny tanàna no tontolonao voajanahary."
