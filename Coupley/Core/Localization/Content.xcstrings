        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncărurile care te fac să te simți ca acasă — fără judecăți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блюда, с которыми ты чувствуешь себя как дома, — без осуждения."
