        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Էներգիա և հասանելիություն։ Ուզում ես ամեն ինչ ոտքով հասանելի լինի, աղմուկ, հարմարություն։ Քաղաքը քո բնական միջավայրն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi dan akses. Kamu ingin semuanya bisa dijangkau jalan kaki, ramai, dan praktis. Kota adalah habitat alamimu."
