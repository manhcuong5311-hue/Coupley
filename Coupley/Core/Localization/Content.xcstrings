          "stringUnit" : {
            "state" : "translated",
            "value" : "ทั้งหมดแรงและเศร้า คือช่วงเวลาที่ขอแค่มีใครอยู่ข้างๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük enerji ve hüzün, sadece yanında olma anıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мало сил і сумно — момент, коли досить просто бути поруч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mệt và buồn là lúc chỉ cần có mặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又累又难过时，只需要陪伴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低落又難過的時候，陪著就好。"
          }
        }
      }
    },
    "Low energy doesn't want performance." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطاقة المنخفضة لا تريد أداءً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Málo energie nechce žádné výkony."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav energi har ikke brug for en forestilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenig Energie heißt: keine Show nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χαμηλή ενέργεια δεν θέλει παραστάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con poca energía, nadie quiere tener que actuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähäinen energia ei kaipaa esittämistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag ubos ang enerhiya, ayaw nang magkunwari o mag-perform."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l'énergie est basse, on n'a pas envie de faire bonne figure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנרגיה נמוכה לא רוצה הופעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम ऊर्जा में दिखावा नहीं चाहिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alacsony energiánál nem kell szerepelni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi rendah tidak butuh pertunjukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con poche energie, nessuno ha voglia di doversi sforzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元気がないときは、無理に明るくふるまう必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기운 없을 땐 애써 밝은 척하고 싶지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila tenaga rendah, dia tak mahu perlu berpura-pura."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med lite energi orker man ikke å prestere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weinig energie heeft, wil niet hoeven presteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niska energia nie chce występów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouca energia não quer plateia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia scăzută nu vrea spectacol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда сил мало, не до выступлений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har låg energi orkar inte prestera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนพลังน้อย ไม่มีใครอยากต้องแสดงอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük enerji performans istemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сил мало, не до вистав."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ít năng lượng, người ta không muốn phải gồng lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没精力的时候，不想被要求表现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒力氣的時候，不想還得打起精神應對。"
          }
        }
      }
    },
    "Low sensitivity to clutter. You'll want to actively meet a tidier partner's needs — because you genuinely won't see what bothers them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساسيتكم للفوضى منخفضة. ستحتاجون إلى السعي بوعي لتلبية احتياجات شريك أكثر ترتيبًا، لأنكم فعلًا لن تروا ما يزعجه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepořádek tě moc netrápí. Potřeby pořádkumilovnějšího protějšku je dobré vědomě respektovat – protože to, co mu vadí, prostě neuvidíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er ikke så følsom over for rod. Du skal aktivt imødekomme en mere ordenselskende partner – for du ser faktisk ikke det, der generer vedkommende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unordnung stört dich kaum. Ist dein Schatz ordentlicher als du, geh bewusst darauf ein – denn du siehst wirklich nicht, was dabei stört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ακαταστασία δεν σε πολυαγγίζει. Καλό είναι να καλύπτεις ενεργά τις ανάγκες ενός πιο τακτικού ταιριού — γιατί πραγματικά δεν θα βλέπεις αυτό που το ενοχλεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desorden apenas te afecta. Te conviene esforzarte por atender las necesidades de una pareja más ordenada, porque de verdad no verás lo que le molesta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotku ei juuri häiritse sinua. Kannattaa aktiivisesti huomioida siistimmän kumppanin tarpeet – koska et oikeasti näe sitä, mikä häntä häiritsee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ka gaanong sensitibo sa kalat. Kailangan mong sadyang tugunan ang pangangailangan ng mas malinis na partner — dahil talagang hindi mo makikita ang nakakaabala sa kanya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le désordre te dérange peu. Si l'autre aime l'ordre, fais l'effort d'aller au-devant de ses besoins, car tu ne verras vraiment pas ce qui pose problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלגן לא ממש מפריע לך. כדאי לעשות מאמץ פעיל לענות על הצרכים של מי שמסודר יותר — כי מה שמפריע לצד השני פשוט לא יבלוט לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिखराव पर आपका ध्यान कम जाता है। ज़्यादा सफ़ाई-पसंद पार्टनर की ज़रूरतों का आपको जानबूझकर ख़याल रखना होगा — क्योंकि जो उन्हें खटकता है, वह आपको सच में दिखेगा ही नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem zavar a rendetlenség. Ha a párod rendszeretőbb, érdemes tudatosan figyelned az igényeire – mert tényleg nem fogod látni, ami őt zavarja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu nggak terlalu peka pada barang berserakan. Kamu perlu aktif memenuhi kebutuhan pasangan yang lebih rapi — karena kamu benar-benar nggak akan melihat apa yang mengganggunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disordine ti tocca poco. Con un partner più ordinato dovrai venirgli incontro attivamente — perché davvero non vedrai ciò che dà fastidio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散らかりにあまり敏感ではないタイプです。きれい好きなパートナーが何を気にしているか本当に見えていないので、意識して歩み寄りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어수선함에 둔감한 편이에요. 깔끔한 연인의 기준에 먼저 맞추려고 노력해 보세요. 연인이 신경 쓰는 게 정말 눈에 안 보일 테니까요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak begitu peka dengan sepah. Anda perlu berusaha memenuhi keperluan pasangan yang lebih kemas — kerana anda memang tidak nampak apa yang mengganggu dia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du reagerer lite på rot. Du må aktivt møte behovene til en ryddigere partner – for du ser rett og slett ikke det som plager den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rommel valt jou nauwelijks op. Kom een nettere partner dus bewust tegemoet – want je ziet echt niet wat de ander stoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bałagan mało ci przeszkadza. Warto aktywnie wychodzić naprzeciw potrzebom bardziej porządnej drugiej połówki – bo naprawdę nie zobaczysz tego, co jej przeszkadza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouca sensibilidade à bagunça. Vale se esforçar para atender um amor mais organizado — porque você realmente não vai ver o que incomoda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezordinea nu prea te deranjează. Va trebui să răspunzi activ nevoilor unui partener mai ordonat — pentru că, sincer, nu vei vedea ce îl deranjează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Беспорядок тебя почти не трогает. Если партнёр аккуратнее, стоит сознательно это учитывать — ведь то, что мешает партнёру, ты можешь просто не заметить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du störs inte så lätt av stök. Om din partner vill ha mer ordning får du vara aktiv och möta det behovet – för du kommer verkligen inte att se det som stör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ค่อยรู้สึกกับความรก จึงควรตั้งใจใส่ใจความต้องการของคนรักที่ชอบความเรียบร้อยมากกว่า เพราะคุณอาจมองไม่เห็นจริงๆ ว่าอะไรกวนใจอีกฝ่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dağınıklığa pek duyarlı değilsin. Daha düzenli bir partnerin ihtiyaçlarını bilerek karşılaman gerekecek, çünkü onu rahatsız eden şeyleri gerçekten görmeyeceksin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безлад тебе мало зачіпає. Варто свідомо зважати на потреби охайнішої половинки — бо ти справді не бачиш того, що її турбує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn ít nhạy cảm với sự bừa bộn. Bạn sẽ cần chủ động đáp ứng nhu cầu của người ấy nếu người ấy ngăn nắp hơn — vì bạn thật sự không thấy điều khiến người ấy khó chịu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对杂乱不太敏感。面对更爱整洁的另一半，你需要主动去照顾对方的需求——因为让对方介意的东西，你是真的看不见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你對雜亂不太敏感。面對比較愛整齊的另一半，你得主動顧及對方的需求，因為你真的看不到讓對方在意的地方。"
          }
        }
      }
    },
    "Low-demand signals don't tax a drained battery." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشارات الخفيفة لا تستهلك بطارية فارغة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signály, které nic nežádají, nevybíjejí prázdnou baterku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler uden krav dræner ikke et fladt batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen ohne Erwartung belasten einen leeren Akku nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μηνύματα που δεν ζητούν τίποτα δεν κουράζουν μια άδεια μπαταρία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las señales que no piden nada no gastan una batería agotada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestit, jotka eivät vaadi mitään, eivät kuormita tyhjää akkua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakakapagod sa ubos na baterya ang mga senyales na walang hinihingi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un signe qui ne demande rien ne pèse pas sur des batteries vides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סימנים שלא דורשים כלום לא מרוקנים סוללה שכבר ריקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन इशारों में जवाब की उम्मीद न हो, वे थकी हुई बैटरी पर बोझ नहीं डालते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kis elvárással járó jelzések nem terhelik a lemerült akkut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan yang tak menuntut tidak menguras baterai yang sudah lemah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un segnale che non chiede nulla non scarica chi è già senza energie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負担にならないメッセージなら、消耗した心にも重くありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부담 없는 신호는 방전된 배터리를 더 닳게 하지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isyarat yang tidak menuntut apa-apa tidak membebankan bateri yang sudah lemah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler som ikke krever noe, tapper ikke et tomt batteri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een seintje zonder verwachtingen kost een lege batterij niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sygnały, które niczego nie wymagają, nie obciążają wyczerpanej baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinais que não exigem nada não gastam uma bateria já fraca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semnalele care nu cer nimic nu consumă o baterie descărcată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы, которые ничего не требуют, не тратят последние силы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler som inte kräver något tär inte på ett tomt batteri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัญญาณที่ไม่เรียกร้องอะไร ไม่ทำให้แบตที่หมดอยู่แล้วหมดเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşılık beklemeyen işaretler boşalmış bir pili yormaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигнали без вимог не розряджають і так порожню батарейку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những tín hiệu không đòi hỏi gì sẽ không làm hao thêm viên pin đã cạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要回应的信号，不会消耗所剩无几的电量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要回應的訊息，不會消耗已經沒電的人。"
          }
        }
      }
    },
    "Low-effort choice, high-effort care." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختيار بلا جهد، واهتمام بكل جهد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum námahy, maximum péče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lille indsats, stor omsorg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenig Aufwand bei der Wahl, viel Fürsorge dahinter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλογή χωρίς κόπο, φροντίδα με πολύ νοιάξιμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poco esfuerzo al elegir, mucho cariño en el gesto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänelle vaivaton valinta, sinulta suurta välittämistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaunting effort sa pagpili, malaking effort sa pag-aalaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un choix facile, une vraie attention."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירה שלא דורשת מאמץ, אכפתיות שדורשת הרבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके लिए कम मेहनत, आपकी तरफ़ से ज़्यादा परवाह।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kis erőfeszítést igénylő választás, nagy gondoskodás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan yang ringan, perhatian yang besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scelta che costa poco, un’attenzione che vale tanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選ぶのは楽に、気づかいはたっぷりと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고르는 건 가볍게, 마음은 깊게."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan yang mudah, keprihatinan yang besar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite å velge, mye omsorg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weinig moeite voor de ander, veel zorg van jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mało wysiłku przy wyborze, dużo troski w geście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha que não pede esforço, cuidado que pede muito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegere fără efort, grijă cu tot efortul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никаких усилий с выбором — и много заботы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkelt val, stor omtanke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีกฝ่ายไม่ต้องออกแรง แต่เต็มไปด้วยความใส่ใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az çaba isteyen bir seçim, çok emek isteyen bir ilgi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибір без зусиль, турбота — на повну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lựa chọn nhẹ nhàng, quan tâm trọn vẹn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择很省力，关心很用心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不費力的選擇，滿滿的心意。"
          }
        }
      }
    },
    "Low-maintenance and adaptable. Just make sure you actually speak up when something matters to you — being 'easy' can leave you resentful." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سهلو المعشر ومرنون. فقط تأكدوا أن تعبّروا فعلًا حين يهمكم أمر ما، فالتساهل الدائم قد يترككم مستائين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenáročnost a přizpůsobivost. Jen se opravdu ozvi, když ti na něčem záleží – být pořád „v pohodě“ může skončit tichou hořkostí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem at have med at gøre og omstillingsparat. Sørg bare for at sige fra, når noget betyder noget for dig – at være »nem« kan ende med at gøre dig bitter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unkompliziert und anpassungsfähig. Sag aber wirklich etwas, wenn dir etwas wichtig ist – wer immer „easy“ ist, staut leicht Groll an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς απαιτήσεις και με προσαρμοστικότητα. Απλώς φρόντισε να μιλάς όταν κάτι μετράει για σένα — το να συμφωνείς με όλα μπορεί να σου αφήσει πίκρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te adaptas sin complicaciones. Solo asegúrate de hablar cuando algo te importa de verdad: ceder siempre puede acabar generando resentimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaivaton ja sopeutuvainen. Muista kuitenkin sanoa ääneen, kun jokin on sinulle tärkeää – jatkuva myötäily voi jättää sinut katkeraksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madaling kasama at madaling umangkop. Siguraduhin lang na nagsasalita ka kapag may mahalaga sa’yo — puwedeng mauwi sa sama ng loob ang pagiging “madali”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facile à vivre et adaptable. Veille juste à vraiment t'exprimer quand quelque chose compte pour toi : toujours dire « comme tu veux » peut finir par te laisser de la rancœur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלילות וגמישות. רק כדאי באמת להשמיע את הקול כשמשהו חשוב לך — לזרום עם הכול עלול להשאיר אצלך טינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आसान और ढल जाने वाले। बस ध्यान रखें कि जब कोई बात आपके लिए मायने रखे, तो आप सच में बोलें — हमेशा “कोई दिक़्क़त नहीं” कहना मन में नाराज़गी छोड़ सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Könnyen alkalmazkodsz, és nem vagy nehéz eset. Csak szólalj meg, ha valami fontos neked – a „nekem minden jó” hozzáállásból könnyen sérelem lesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak ribet dan mudah beradaptasi. Pastikan saja kamu tetap bersuara saat ada yang penting bagimu — terlalu “ikut saja” bisa bikin kamu memendam kesal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti accontenti facilmente e ti adatti. Assicurati solo di farti sentire quando qualcosa conta per te — adattarti sempre può lasciarti del risentimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手がかからず、順応性のあるタイプです。ただ、大事なことはちゃんと口に出しましょう。「何でもいい」が続くと、不満がたまることもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무던하고 잘 맞춰 줘요. 다만 정말 중요한 게 있을 땐 꼭 말해 주세요. 늘 ‘다 좋아’라고 하다 보면 서운함이 쌓일 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudah dilayan dan pandai menyesuaikan diri. Cuma pastikan anda bersuara apabila sesuatu penting bagi anda — terlalu ‘ikut sahaja’ boleh membuatkan anda terkilan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite krevende og tilpasningsdyktig. Bare pass på at du faktisk sier fra når noe betyr noe for deg – å alltid være «grei» kan gjøre deg bitter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makkelijk en flexibel. Zorg wel dat je echt iets zegt als iets belangrijk voor je is – altijd ‘makkelijk’ zijn kan wrok opleveren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezproblemowo i elastycznie. Pamiętaj tylko, by odezwać się, gdy coś jest dla ciebie ważne – ciągłe ustępowanie może zostawić w tobie żal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranquilidade e adaptação. Só garanta que você fale quando algo importa — ser a pessoa que “topa tudo” pode acabar gerando ressentimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ești ușor de mulțumit și te adaptezi. Ai grijă doar să vorbești când ceva contează pentru tine — să tot cedezi poate lăsa în urmă resentimente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неприхотливо и гибко. Только не молчи, когда для тебя что-то важно: привычка со всем соглашаться может обернуться обидой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okomplicerad och anpassningsbar. Se bara till att du faktiskt säger till när något är viktigt för dig – att alltid ”hänga med” kan leda till bitterhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอาใจง่ายและปรับตัวเก่ง แค่อย่าลืมพูดออกมาเมื่อมีอะไรสำคัญกับคุณ การเป็นคน “ไปได้หมด” อาจทำให้คุณเก็บความขุ่นเคืองไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahmetsiz ve uyumlusun. Sadece bir şey senin için önemli olduğunda gerçekten sesini çıkardığından emin ol; hep “bana uyar” demek içinde kırgınlık bırakabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невибагливо й гнучко. Лише не забувай говорити, коли щось для тебе важливо, — бо через «мені все підходить» може накопичуватися образа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dễ chiều và dễ thích nghi. Chỉ cần nhớ lên tiếng khi có điều quan trọng với bạn — “dễ tính” quá có thể khiến bạn ấm ức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好相处又能适应。只是遇到在意的事时，一定要说出来——一味“都行”可能会让你心里憋屈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好相處又能適應。只是有在意的事時，記得真的說出來，一直當「都可以」的那個人，可能會讓你心裡不平衡。"
          }
        }
      }
    },
    "Low-stakes openness invites the same back." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانفتاح البسيط يدعو إلى انفتاح مماثل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenáročná otevřenost vybízí k otevřenosti i na druhé straně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbenhed om små ting inviterer til det samme tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer sich locker öffnet, bekommt Offenheit zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανοιχτότητα χωρίς ρίσκο φέρνει το ίδιο και από την άλλη πλευρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrirte sin presión invita a que tu pareja haga lo mismo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevyt avautuminen saa toisenkin avautumaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag nagbukas ka nang magaan, mas madali rin siyang magbukas sa’yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ouvrir sur des petites choses invite l'autre à en faire autant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחות בלי סיכון מזמינה את אותו הדבר בחזרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्के-फुल्के ढंग से मन खोलने पर सामने से भी वैसा ही खुलापन मिलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tét nélküli nyitottság nyitottságot hív elő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterbukaan yang ringan mengundang keterbukaan balik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprirsi su cose leggere invita l’altro a fare lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気軽に心を開くと、相手も同じように開いてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부담 없이 마음을 열면 상대도 마음을 열어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterbukaan yang santai mengundang keterbukaan yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpenhet om små ting inviterer den andre til å gjøre det samme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een beetje openheid nodigt de ander uit hetzelfde te doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swobodna otwartość zachęca do tego samego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abrir sem grandes riscos convida o outro a fazer o mesmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O deschidere fără mize invită aceeași deschidere înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытость без высоких ставок приглашает к открытости в ответ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lättsam öppenhet smittar av sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปิดใจแบบสบายๆ ชวนให้อีกฝ่ายเปิดใจกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risksiz bir açıklık, onun da açılmasını kolaylaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкритість без ризику запрошує до такої ж відповіді."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cởi mở nhẹ nhàng sẽ nhận lại sự cởi mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻松的坦诚，也会换来对方的坦诚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆地敞開自己，對方也會跟著敞開。"
          }
        }
      }
    },
    "Low-stakes relationship with games. You enjoy it without it being a significant time investment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علاقة خفيفة بالألعاب. استمتاع بها من دون أن تستهلك وقتًا كبيرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hry bereš s nadhledem. Baví tě, ale nezabírají ti moc času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et afslappet forhold til spil. Du nyder det, uden at det tager en masse tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entspanntes Verhältnis zu Spielen. Du hast Spaß daran, ohne viel Zeit hineinzustecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαλαρή σχέση με τα παιχνίδια. Το απολαμβάνεις χωρίς να σου τρώει πολύ χρόνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una relación relajada con los juegos. Los disfrutas sin que te quiten mucho tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rento suhde peleihin. Nautit niistä ilman, että ne vievät paljon aikaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relax lang ang relasyon mo sa laro. Nag-e-enjoy ka nang hindi ito kumakain ng malaking oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport détendu au jeu. Tu en profites sans y consacrer beaucoup de temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קשר קליל למשחקים. זה מהנה לך, בלי שזה גוזל הרבה זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गेम्स से हल्का-फुल्का रिश्ता। मज़ा पूरा, पर समय ज़्यादा नहीं जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lazán kezeled a játékot. Élvezed, de nem visz el sok időt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubunganmu dengan game santai saja. Kamu menikmatinya tanpa harus menyita banyak waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapporto rilassato con i giochi. Ti divertono senza richiedere un grande investimento di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームとは気楽な付き合い方。大きな時間をかけるわけではなく、ほどよく楽しんでいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임과는 부담 없는 사이예요. 시간을 크게 쏟지 않고도 즐겨요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan yang santai dengan permainan. Anda menikmatinya tanpa ia mengambil banyak masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et avslappet forhold til spill. Du liker det uten at det tar mye tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Games zijn voor jou ontspannen. Je geniet ervan zonder dat het veel tijd kost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luźna relacja z grami. Sprawiają ci frajdę, ale nie pochłaniają dużo czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma relação leve com os jogos. Você curte sem que isso tome muito do seu tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relație relaxată cu jocurile. Îți plac fără să-ți ocupe mult timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкие отношения с играми. Тебе нравится играть, но много времени это не отнимает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avslappnad relation till spel. Du gillar det, utan att det tar en massa tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกับเกมเป็นความสัมพันธ์แบบสบายๆ สนุกได้โดยไม่ต้องทุ่มเวลามากมาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunlarla rahat bir ilişkin var. Çok zaman ayırmadan keyif alıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легкі стосунки з іграми. Тобі подобається грати, але це не забирає багато часу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đến với game nhẹ nhàng. Bạn thích chơi mà không phải dành quá nhiều thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和游戏的关系很轻松。你享受它，但不会花太多时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和遊戲的關係很隨興。你喜歡玩，但不會投入太多時間。"
          }
        }
      }
    },
