          "stringUnit" : {
            "state" : "translated",
            "value" : "सहजताभन्दा गहिराइ। अरू जोडीले टार्ने कुराबारे कुरा गर्दा नै साँचो निकटता आउँछ भन्ने तपाईं विश्वास गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diepgang boven comfort. Jij gelooft dat echte nabijheid ontstaat door te praten over dingen die andere stellen uit de weg gaan."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuzama kuposa kumasuka. Mumakhulupirira kuti kuyandikana kwenikweni kumachokera pakukambirana zinthu zomwe okondana ena amapewa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijataa caalaa gadi fagoo. Walitti dhiyeenyi dhugaan waan jaalalleewwan biroo dhiisan irratti haasa'uu irraa akka dhufu amanta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆରାମଠୁ ଗଭୀରତା ବଡ଼। ଆପଣ ବିଶ୍ୱାସ କରନ୍ତି, ଅନ୍ୟ ଯୁଗଳ ଏଡ଼ାଉଥିବା କଥା ହେବାରୁ ହିଁ ପ୍ରକୃତ ଘନିଷ୍ଠତା ଆସେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੁਖ ਨਾਲੋਂ ਡੂੰਘਾਈ। ਤੁਹਾਡਾ ਮੰਨਣਾ ਹੈ ਕਿ ਅਸਲ ਨੇੜਤਾ ਉਨ੍ਹਾਂ ਗੱਲਾਂ ਨਾਲ ਆਉਂਦੀ ਹੈ ਜਿਨ੍ਹਾਂ ਤੋਂ ਦੂਜੇ ਜੋੜੇ ਬਚਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębia ponad komfort. Wierzysz, że prawdziwa bliskość rodzi się z rozmów o tym, czego inne pary unikają."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ژوروالی له آرامۍ غوره. تاسو باور لرئ چې رښتینی نږدېوالی د هغو خبرو له لارې راځي چې نورې جوړې ترې ډډه کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade mais que conforto. Para você, a proximidade real vem de falar sobre o que outros casais evitam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade acima de conforto. Acreditas que a verdadeira proximidade vem de falar sobre aquilo que outros casais evitam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profunzime, nu confort. Crezi că apropierea adevărată vine din a vorbi despre lucrurile pe care alte cupluri le evită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубина важнее комфорта. Ты веришь, что настоящая близость рождается в разговорах, которых другие пары избегают."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubwimbitse buruta kwiyoroshya. Wizera ko kwegerana nyako guturuka ku kuganira ibintu abandi bakundana birinda."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පහසුවට වඩා ගැඹුර. වෙනත් යුවළයන් මඟ හරින දේවල් ගැන කතා කිරීමෙන් තමයි ඇත්ත සමීපත්වය එන්නේ කියලා ඔබ විශ්වාස කරනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hĺbka pred pohodlím. Veríš, že skutočná blízkosť vzniká z rozhovorov o veciach, ktorým sa iné páry vyhýbajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globina pred udobjem. Verjameš, da prava bližina izvira iz pogovorov o stvareh, ki se jim drugi pari izogibajo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudzama pane kusununguka. Unotenda kuti kuswedera chaiko kunobva mukutaura nezvezvinhu zvinonzvengwa nevamwe vadiwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoto-dheeri, ma aha raaxo. Waxaad rumaysan tahay in dhawaanshaha dhabta ahi ka yimaado ka hadalka waxyaabaha lammaanayaasha kale ka cararaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thellësia mbi rehatinë. Ti beson se afërsia e vërtetë vjen kur flisni për gjërat që çiftet e tjera i shmangin."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дубина пре удобности. Верујеш да права блискост долази из разговора о стварима које други парови избегавају."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kajeroan langkung ti kanyamanan. Anjeun percanten yén kadeukeutan saleresna asalna tina ngobrolkeun hal-hal anu dijauhan ku pasangan sanés."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djup före bekvämlighet. Du tror att verklig närhet kommer av att prata om sådant andra par undviker."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kina kuliko starehe. Unaamini ukaribu wa kweli hutokana na kuzungumzia mambo ambayo wenzi wengine huyakwepa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சௌகரியத்தை விட ஆழம். மற்ற ஜோடிகள் தவிர்க்கும் விஷயங்களைப் பேசுவதிலிருந்துதான் உண்மையான நெருக்கம் வருகிறது என்று நம்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సౌకర్యం కంటే లోతు. ఇతర జంటలు తప్పించుకునే విషయాల గురించి మాట్లాడటం వల్లే నిజమైన సాన్నిహిత్యం వస్తుందని మీరు నమ్ముతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амиқӣ аз осудагӣ болотар. Ту бовар дорӣ, ки наздикии ҳақиқӣ аз гап задан дар бораи чизҳое меояд, ки ҷуфтҳои дигар аз онҳо канорагирӣ мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความลึกซึ้งสำคัญกว่าความสบายใจ คุณเชื่อว่าความใกล้ชิดที่แท้จริงมาจากการคุยเรื่องที่คู่อื่นหลีกเลี่ยง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ምቾት ዕምቆት። ሓቀኛ ቅርበት ካልኦት ጽምዲ ዝሃድምዎ ነገራት ብምዝርራብ ከም ዝመጽእ ትኣምኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatlykdan çuňluk öňde. Sen hakyky ýakynlygyň beýleki jübütleriň gaça durýan zatlary barada gürleşmekden döreýändigine ynanýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatlıktan çok derinlik. Gerçek yakınlığın, başka çiftlerin kaçındığı konuları konuşmaktan doğduğuna inanıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибина важливіша за комфорт. Ти віриш, що справжня близькість народжується з розмов про те, чого інші пари уникають."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آرام سے زیادہ گہرائی۔ آپ کے خیال میں اصل قربت اُن باتوں پر بات کرنے سے آتی ہے جن سے دوسرے جوڑے کتراتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qulaylikdan koʻra chuqurlik. Siz chinakam yaqinlik boshqa juftliklar qochadigan mavzularda gaplashishdan tugʻiladi, deb ishonasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều sâu hơn sự dễ chịu. Bạn tin sự gần gũi thật sự đến từ việc nói về những điều nhiều cặp đôi né tránh."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubunzulu ngaphezu kokukhululeka. Ukholelwa ukuba ukusondelelana kokwenyani kuvela ekuthetheni ngezinto ezinye izibini eziziphephayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jíjinlẹ̀ ju ìrọ̀rùn lọ. Ẹ gbà pé ìsúnmọ́ra gidi ń wá láti sísọ̀rọ̀ nípa ohun tí àwọn olólùfẹ́ mìíràn ń yẹra fún."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度勝過舒適。你相信真正的親近，來自談論其他情侶會迴避的事。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度胜过舒适。你相信真正的亲近，来自聊那些别的情侣会回避的话题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度比舒適更重要。你相信真正的親近，來自聊那些別的情侶都避開的話題。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukujula kunokukhululeka. Ukholelwa ukuthi ukusondelana kwangempela kuvela ekukhulumeni ngezinto eminye imibhangqwana ezigwemayo."
          }
        }
      }
    },
    "Depth over tourism. You want to understand a place, not just photograph it." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diepte bo toerisme. Jy wil ’n plek verstaan, nie net afneem nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከጉብኝት ጥልቀት። አንድን ቦታ ፎቶ ማንሳት ብቻ ሳይሆን መረዳት ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمق قبل السياحة. تريدون فهم المكان، لا مجرد تصويره."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰ্যটনতকৈ গভীৰতা। আপুনি এখন ঠাইৰ কেৱল ফটো তুলিব নিবিচাৰে, বুজিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turizmdən çox dərinlik. Bir yerin sadəcə şəklini çəkmək yox, onu anlamaq istəyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глыбіня замест турызму. Табе хочацца зразумець месца, а не толькі сфатаграфаваць яго."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дълбочина пред туризъм. Искаш да разбереш мястото, не просто да го снимаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পর্যটনের চেয়ে গভীরতা। তুমি একটা জায়গাকে বুঝতে চাও, শুধু ছবি তুলতে নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubina prije turizma. Želiš razumjeti mjesto, a ne samo ga fotografisati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profunditat per sobre de turisme. Vols entendre un lloc, no només fotografiar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hloubka místo turistiky. Chceš místo pochopit, ne ho jen nafotit."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyfnder yn hytrach na thwristiaeth. Rwyt ti eisiau deall lle, nid dim ond tynnu lluniau ohono."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dybde frem for turisme. Du vil forstå et sted, ikke bare fotografere det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe statt Tourismus. Du willst einen Ort verstehen, nicht nur fotografieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάθος αντί για τουρισμό. Θέλεις να καταλάβεις έναν τόπο, όχι απλώς να τον φωτογραφίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidad antes que turismo. Quieres entender un lugar, no solo fotografiarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sügavus enne turismi. Sa tahad kohta mõista, mitte ainult pildistada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakontasuna, turismoa baino gehiago. Leku bat ulertu nahi duzu, ez argazkia atera bakarrik."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمق مهم‌تر از توریست‌بازی. می‌خواهی یک مکان را بفهمی، نه فقط از آن عکس بگیری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvyyttä turismin sijaan. Haluat ymmärtää paikan, et vain valokuvata sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalim kaysa pamamasyal. Gusto mong maintindihan ang isang lugar, hindi lang kunan ng litrato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur plutôt que le tourisme. Tu veux comprendre un lieu, pas seulement le prendre en photo."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doimhneacht thar thurasóireacht. Ba mhaith leat áit a thuiscint, ní grianghraf a thógáil di amháin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade mellor ca turismo. Queres entender un lugar, non só fotografalo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પર્યટન કરતાં ઊંડાણ. તમારે કોઈ જગ્યાને ફક્ત ફોટામાં નહીં, સમજીને માણવી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurfi ya fi yawon buɗe ido. Kuna son fahimtar wuri, ba ɗaukar hotonsa kawai ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עומק על פני תיירות. המטרה שלך היא להבין מקום, לא רק לצלם אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घूमने से बढ़कर गहराई। आप किसी जगह को समझना चाहते हैं, सिर्फ़ उसकी फ़ोटो लेना नहीं।"
