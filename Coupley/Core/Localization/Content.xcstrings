        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្ដាប់ដូចមិត្តភក្តិ មិនមែនដូចអ្នកជួសជុលទេ។ និយាយឡើងវិញនូវអ្វីដែលគាត់កំពុងមានអារម្មណ៍។"
