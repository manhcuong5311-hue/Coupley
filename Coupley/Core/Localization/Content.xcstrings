        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne postoji univerzalno točan odgovor – ali usklađenost ovdje sprječava ozbiljne trzavice."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa gen yon sèl bon repons pou tout moun — men lè nou dakò sou sa, sa evite gwo friksyon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mindenkinek jó válasz – de ha itt egy hullámhosszon vagytok, sok komoly súrlódást elkerültök."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Համընդհանուր ճիշտ պատասխան չկա — բայց այստեղ համաձայնությունը լուրջ լարվածությունից է փրկում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak ada jawaban yang benar untuk semua orang — tapi sepaham di sini mencegah gesekan serius."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ dịghị azịza ziri ezi nye onye ọ bụla — mana ikwekọ n'ebe a na-egbochi nnukwu esemokwu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það er ekkert eitt rétt svar – en ef þið eruð samstíga hér kemur það í veg fyrir alvarlegan núning."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esiste una risposta giusta per tutti — ma essere d’accordo su questo evita attriti seri."
