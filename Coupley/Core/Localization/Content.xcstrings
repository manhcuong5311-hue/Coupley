    "Cleanliness expectations are quietly one of the biggest lived-in relationship flashpoints." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwagtinge oor netheid is stilletjies een van die grootste brandpunte as julle saamwoon."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስለ ንጽሕና ያሉ ጥበቃዎች በአብሮ መኖር ውስጥ በዝምታ ትልቅ የግጭት ምንጭ ከሚሆኑት አንዱ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقعات النظافة من أكبر نقاط الاحتكاك الصامتة في الحياة اليومية المشتركة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাফ-চিকুণতাৰ প্ৰত্যাশা একেলগে থকা সম্পৰ্কত নীৰৱে আটাইতকৈ ডাঙৰ মনোমালিন্যৰ কাৰণবোৰৰ এটা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təmizlik gözləntiləri birgə həyatın səssizcə ən çox gərginlik yaradan mövzularından biridir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаканні наконт чысціні — ціхая, але адна з самых гарачых тэм у сумесным жыцці."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очакванията за чистота тихомълком са един от най-честите поводи за спорове в общия дом."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিচ্ছন্নতা নিয়ে প্রত্যাশা চুপচাপ একসাথে থাকার সবচেয়ে বড় ঝামেলার কারণগুলোর একটা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očekivanja o urednosti tiho su jedan od najvećih izvora sukoba u zajedničkom životu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les expectatives de neteja són, sense fer soroll, un dels grans focus de conflicte quan es conviu."
          }
        },
