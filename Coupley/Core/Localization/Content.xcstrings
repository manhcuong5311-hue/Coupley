        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kì í ṣòro, ẹ sì lè yí padà. Ṣáà rí i dájú pé ẹ ń sọ̀rọ̀ nígbà tí nǹkan bá ṣe pàtàkì sí yín — jíjẹ́ ẹni “tí kò ṣòro” lè fi ìbínú sínú yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
