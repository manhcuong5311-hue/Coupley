        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาหารที่ทำให้คุณรู้สึกเหมือนอยู่บ้าน ไม่มีการตัดสิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana kendini evinde hissettiren yemekler; yargı yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страви, з якими почуваєшся як удома, — без засуджень."
