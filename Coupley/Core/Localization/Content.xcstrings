    },
    "Walking lowers cortisol and side-by-side beats face-to-face." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المشي يخفض هرمون التوتر، والسير جنبًا إلى جنب أسهل من الجلوس وجهًا لوجه."
          }
        },
        "cs" : {
          "stringUnit" : {
