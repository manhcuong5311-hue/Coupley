        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ልምድን ጻዕርን። እቲ ሃልሃልታ ብቀጻሊ ኣቓልቦ እምበር ብዕድል ከም ዘይሕሎ ትኣምኑ።"
