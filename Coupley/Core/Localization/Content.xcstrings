        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສົ່ງຂໍ້ຄວາມສັ້ນໆ: “ບໍ່ຕ້ອງຕອບກໍໄດ້ — ຄິດຮອດເຈົ້າ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parašyk vieną eilutę: „atsakyti nebūtina – galvoju apie tave“."
          }
        },
        "lv" : {
          "stringUnit" : {
