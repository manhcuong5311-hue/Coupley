          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် ရေရှည်ကို ကြည့်ပြီး ကစားနေတယ်။ နောင်တချိန်မှာ နှစ်ယောက်စလုံး ကိုယ့်ကိုယ်ကို ကျေးဇူးတင်ကြမှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tenker langsiktig. Det kommer dere begge til å takke dere selv for senere."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं लामो खेल खेल्दै हुनुहुन्छ। भविष्यका तपाईं दुवैले आजलाई धन्यवाद दिनुहुनेछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij denkt op de lange termijn. Later zijn jullie jezelf daar allebei dankbaar voor."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukuganizira za kutsogolo. Inu a m'tsogolo mudzakuthokozani nonse awiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapha yeroo dheeraa taphachaa jirta. Gara fuulduraatti lamaan keessanuu ofii keessan ni galateeffattu."
