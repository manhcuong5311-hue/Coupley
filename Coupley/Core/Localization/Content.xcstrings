        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вогні Токіо. Ранки в Кіото. Цвітіння сакури з тобою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh đèn Tokyo. Những buổi sáng Kyoto. Ngắm hoa anh đào cùng nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "东京的灯火，京都的清晨，和你一起看樱花。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "東京的燈火，京都的早晨，和你一起看櫻花。"
          }
        }
      }
    },
    "Total partnership. This builds deep trust and makes planning easy — it also requires real vulnerability about spending." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شراكة كاملة. هذا يبني ثقة عميقة ويسهّل التخطيط، لكنه يتطلب انفتاحًا حقيقيًا بشأن الإنفاق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprosté partnerství. Buduje hlubokou důvěru a usnadňuje plánování – vyžaduje ale opravdovou otevřenost ohledně utrácení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuldt partnerskab. Det skaber dyb tillid og gør det let at planlægge – men det kræver også, at man er ærlig og sårbar om sit forbrug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echte Partnerschaft. Das schafft tiefes Vertrauen und macht Planung leicht – verlangt aber auch viel Offenheit beim Ausgeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόλυτη συνεργασία. Χτίζει βαθιά εμπιστοσύνη και κάνει τον σχεδιασμό εύκολο — αλλά θέλει και πραγματικό άνοιγμα για τα έξοδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equipo total. Crea una confianza profunda y facilita la planificación, aunque también exige abrirse de verdad sobre los gastos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysi kumppanuus. Se rakentaa syvää luottamusta ja helpottaa suunnittelua – mutta vaatii myös todellista avoimuutta rahankäytöstä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buong partnership. Bumubuo ito ng malalim na tiwala at pinadadali ang pagpaplano — pero kailangan din ng tunay na pagiging bukas tungkol sa paggastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un partenariat total. Ça crée une confiance profonde et facilite les projets, mais ça demande une vraie transparence sur ses dépenses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שותפות מלאה. זה בונה אמון עמוק ומקל על התכנון — וגם דורש פתיחות אמיתית לגבי הוצאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी साझेदारी। इससे गहरा भरोसा बनता है और प्लानिंग आसान होती है — पर ख़र्च को लेकर सच में खुलना भी पड़ता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes partnerség. Ez mély bizalmat épít és megkönnyíti a tervezést – de igazi nyitottságot is kíván a költésekkel kapcsolatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemitraan total. Ini membangun kepercayaan yang dalam dan memudahkan perencanaan — tapi juga menuntut keterbukaan soal pengeluaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una collaborazione totale. Crea una fiducia profonda e rende facile pianificare — ma richiede anche di mettersi a nudo sulle proprie spese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全なパートナーシップ。深い信頼が育ち、計画も立てやすくなります。そのぶん、お金の使い方をさらけ出す覚悟も必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전한 파트너십이에요. 깊은 신뢰가 쌓이고 계획 세우기도 쉬워요. 대신 소비 습관을 솔직하게 드러낼 용기가 필요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkongsian sepenuhnya. Ini membina kepercayaan yang mendalam dan memudahkan perancangan — tetapi ia juga memerlukan keterbukaan tentang perbelanjaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullt partnerskap. Det bygger dyp tillit og gjør planlegging enkelt – men krever også ekte åpenhet om pengebruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig partnerschap. Dit bouwt diep vertrouwen op en maakt plannen makkelijk – maar vraagt ook dat je echt open bent over je uitgaven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełne partnerstwo. To buduje głębokie zaufanie i ułatwia planowanie – wymaga też prawdziwej otwartości co do wydatków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parceria total. Isso gera muita confiança e facilita o planejamento — mas também exige se abrir de verdade sobre os gastos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parteneriat total. Construiește o încredere profundă și ușurează planificarea — dar cere și multă deschidere în privința cheltuielilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полное партнёрство. Это рождает глубокое доверие и упрощает планирование, но требует открытости в том, как ты тратишь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullt partnerskap. Det bygger djup tillit och gör planering enkel – men kräver också verklig öppenhet kring utgifter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นหุ้นส่วนกันเต็มตัว วิธีนี้สร้างความเชื่อใจที่ลึกซึ้งและวางแผนง่าย แต่ก็ต้องกล้าเปิดเผยเรื่องการใช้จ่ายอย่างแท้จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam ortaklık. Derin güven inşa eder ve plan yapmayı kolaylaştırır; ama harcamalar konusunda gerçek bir açıklık da gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повне партнерство. Це будує глибоку довіру й спрощує планування — але вимагає справжньої відкритості щодо витрат."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng hành trọn vẹn. Cách này xây dựng niềm tin sâu sắc và giúp lên kế hoạch dễ dàng — nhưng cũng đòi hỏi sự cởi mở thật sự về chi tiêu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彻底的伙伴关系。这能建立深厚的信任，规划也很容易——但也需要在花钱这件事上真正坦诚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全然的夥伴關係。這能建立深厚的信任，讓規劃更容易，但也需要在花費上坦誠相見。"
          }
        }
      }
    },
    "Touch as connection — not necessarily sexual. Just being near each other, body language saying 'I'm here'." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة وسيلة للتواصل، وليست بالضرورة جنسية. مجرد القرب من بعضكما، ولغة الجسد تقول «أنا هنا»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotek jako spojení – nemusí jít o sex. Prostě být si nablízku a řečí těla říkat: „Jsem tu.“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring som forbindelse – ikke nødvendigvis seksuelt. Bare at være tæt på hinanden, med et kropssprog, der siger »jeg er her«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung als Verbindung – nicht unbedingt sexuell. Einfach nah beieinander sein, die Körpersprache sagt: „Ich bin da.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα ως σύνδεση — όχι απαραίτητα ερωτικό. Απλώς να είστε κοντά, με το σώμα να λέει «είμαι εδώ»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto como conexión, no necesariamente sexual. Simplemente estar cerca, con el cuerpo diciendo “aquí estoy”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus yhteytenä – ei välttämättä seksuaalisena. Vain toistenne lähellä olemista, kehonkieli sanoo: ”olen tässä”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haplos bilang koneksyon — hindi kailangang sekswal. Basta magkalapit kayo, sinasabi ng katawan na “nandito ako”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le toucher comme lien, pas forcément sexuel. Juste être près l'un de l'autre, le corps qui dit « je suis là »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע כחיבור — לא בהכרח מיני. פשוט להיות קרובים, כשהגוף אומר 'אני כאן'."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुड़ाव के रूप में स्पर्श — ज़रूरी नहीं कि रोमांटिक हो। बस एक-दूसरे के पास होना, जहाँ हाव-भाव कहें “मैं यहाँ हूँ”।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érintés mint kapcsolódás – nem feltétlenül szexuális. Csak egymás közelében lenni, és a testbeszéd azt mondja: „itt vagyok”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan sebagai kedekatan — tidak harus seksual. Sekadar berada di dekat satu sama lain, bahasa tubuh yang bilang “aku di sini”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto come legame — non per forza sessuale. Solo stare vicini, con il corpo che dice «sono qui»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れ合いは、つながりそのもの。必ずしも性的なものではなく、ただそばにいて、体で「ここにいるよ」と伝え合うことです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꼭 성적인 의미가 아닌, 연결로서의 스킨십이에요. 그냥 곁에 붙어서 몸으로 “나 여기 있어”라고 말하는 것."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan sebagai penghubung — tidak semestinya seksual. Sekadar berada dekat, bahasa badan yang menyampaikan ‘Saya ada di sini’."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring som kontakt – ikke nødvendigvis seksuell. Bare å være nær hverandre, med et kroppsspråk som sier «jeg er her»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking als verbinding – niet per se seksueel. Gewoon dicht bij elkaar zijn, met een lichaamstaal die zegt: ‘ik ben er’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk jako więź – niekoniecznie seksualny. Po prostu bycie blisko siebie, mowa ciała, która mówi „jestem tu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque como conexão — não necessariamente sexual. Só estar perto, com o corpo dizendo “estou aqui”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea ca legătură — nu neapărat sexuală. Doar să fiți unul lângă altul, cu un limbaj al trupului care spune „sunt aici”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновение как связь, и не обязательно о сексе. Просто быть рядом, когда само тело говорит «я здесь»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring som kontakt – inte nödvändigtvis sexuell. Att bara vara nära varandra, med ett kroppsspråk som säger ”jag är här”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสคือการเชื่อมถึงกัน ไม่จำเป็นต้องเป็นเรื่องทางเพศ แค่ได้อยู่ใกล้กัน ให้ภาษากายบอกว่า “ฉันอยู่ตรงนี้”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağ kurmanın yolu olarak dokunmak; illa cinsel değil. Sadece birbirinize yakın olmak, beden dilinin “Buradayım” demesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик як зв’язок — не обов’язково сексуальний. Просто бути поруч, коли тіло каже: «Я тут»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm như sự kết nối — không nhất thiết là chuyện ân ái. Chỉ cần ở gần nhau, cử chỉ nói lên “mình ở đây”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用触碰传递亲近，不一定与性有关。只是挨在一起，用身体语言说“我在”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是一種連結，不一定和性有關。就只是待在彼此身邊，用肢體語言說「我在這裡」。"
          }
        }
      }
    },
    "Touch is instinctive for you. You reach out physically when you care — and you probably notice when that diminishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة غريزية لديكم. تقتربون جسديًا حين تهتمون، وعلى الأرجح تلاحظون حين يقلّ ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotek je pro tebe instinktivní. Když ti na někom záleží, natáhneš ruku – a nejspíš si všimneš, když toho ubývá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er instinktiv for dig. Du rækker ud fysisk, når du holder af nogen – og du mærker sikkert, når den bliver mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung ist für dich instinktiv. Wenn dir jemand wichtig ist, suchst du Körperkontakt – und merkst wohl auch, wenn er weniger wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα είναι ενστικτώδες για σένα. Όταν νοιάζεσαι, απλώνεις το χέρι — και μάλλον το προσέχεις όταν αυτό λιγοστεύει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto te sale por instinto. Cuando te importa alguien, lo buscas físicamente, y seguramente notas cuando eso disminuye."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus on sinulle vaistonvaraista. Hakeudut fyysisesti lähelle, kun välität – ja huomaat luultavasti, jos se vähenee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likas sa’yo ang haplos. Pisikal kang lumalapit kapag nagmamalasakit ka — at malamang napapansin mo kapag nababawasan iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le toucher est instinctif chez toi. Quand quelqu'un compte pour toi, tu vas vers l'autre physiquement, et tu remarques sûrement quand ça diminue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע הוא אינסטינקט אצלך. כשאכפת לך, היד נשלחת מעצמה — וכנראה שזה בולט לך כשיש פחות מזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श आपके लिए सहज है। परवाह होने पर आप छूकर जताते हैं — और जब यह कम होता है, तो शायद आपको महसूस भी होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad az érintés ösztönös. Ha törődsz valakivel, fizikailag is közeledsz – és valószínűleg észreveszed, ha ez megfogyatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan itu naluriahmu. Kamu menyentuh saat peduli — dan kamu mungkin sadar saat itu mulai berkurang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto per te è istintivo. Quando tieni a qualcuno lo cerchi fisicamente — e probabilmente ti accorgi quando diminuisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れることが本能的なタイプです。大切に思うと自然に手が伸び、それが減るとすぐに気づくでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킨십이 본능적이에요. 아끼는 마음이 들면 몸이 먼저 다가가죠. 그게 줄어들면 아마 바로 알아챌 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan datang secara naluri bagi anda. Apabila sayang, anda spontan menghulurkan sentuhan — dan anda mungkin perasan apabila ia berkurangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er instinktivt for deg. Du søker fysisk kontakt når du bryr deg – og du merker nok når det blir mindre av det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is voor jou instinctief. Als je om iemand geeft, zoek je fysiek contact – en je merkt het waarschijnlijk als dat minder wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk jest u ciebie instynktowny. Gdy ci zależy, sięgasz po kontakt fizyczny – i pewnie zauważasz, gdy go ubywa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é instintivo para você. Quando se importa, você busca contato — e provavelmente percebe quando isso diminui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea e instinctivă pentru tine. Când îți pasă, cauți apropierea fizică — și probabil observi când ea scade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновения для тебя инстинктивны. Когда тебе не всё равно, хочется прикоснуться — и ты наверняка замечаешь, когда этого становится меньше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring är instinktivt för dig. Du söker fysisk kontakt när du bryr dig – och märker nog när den minskar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสเป็นสัญชาตญาณของคุณ เมื่อใส่ใจใครคุณจะเข้าไปใกล้ชิด และคุณคงสังเกตได้เมื่อสิ่งนั้นลดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunmak senin için içgüdüsel. Birini önemsediğinde ona dokunarak yaklaşıyorsun ve bu azaldığında muhtemelen hemen fark ediyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик для тебе інстинктивний. Коли тобі хтось дорогий, ти шукаєш дотику — і, мабуть, помічаєш, коли їх стає менше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm là bản năng của bạn. Bạn chạm vào người mình thương — và chắc hẳn bạn nhận ra khi điều đó vơi đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触碰对你来说是本能。在乎一个人时，你会自然地靠近——一旦变少，你多半也会察觉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的本能。在乎一個人時，你會自然地靠近，而這份親近變少時，你大概也會察覺。"
          }
        }
      }
    },
    "Touch is your anchor. A hand on your back, a hug that lasts — it communicates care on a level words can't always reach." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة هي مرساتكم. يد على الظهر أو عناق يطول، كلها تنقل اهتمامًا يتجاوز ما تبلغه الكلمات أحيانًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotek je tvoje kotva. Ruka na zádech, objetí, které chvíli trvá – vyjádří péči tam, kam slova ne vždycky dosáhnou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er dit anker. En hånd på ryggen, et kram, der varer ved – det viser omsorg på et plan, ord ikke altid kan nå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung ist dein Anker. Eine Hand auf deinem Rücken, eine lange Umarmung – das zeigt Fürsorge auf einer Ebene, die Worte nicht immer erreichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα είναι το λιμάνι σου. Ένα χέρι στην πλάτη, μια αγκαλιά που κρατάει — μιλάει για φροντίδα εκεί που οι λέξεις δεν φτάνουν πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto es tu ancla. Una mano en la espalda, un abrazo largo… Eso transmite cariño a un nivel al que las palabras no siempre llegan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus on sinun ankkurisi. Käsi selälläsi, pitkä halaus – ne kertovat välittämisestä tavalla, johon sanat eivät aina yllä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang haplos ang sandigan mo. Kamay sa likod mo, yakap na matagal — naipaparating nito ang malasakit sa paraang hindi laging kaya ng salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contact physique, c'est ton point d'ancrage. Une main dans le dos, un câlin qui dure : ça exprime une tendresse que les mots n'atteignent pas toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע הוא העוגן שלך. יד על הגב, חיבוק שנמשך — הם מעבירים אכפתיות למקום שמילים לא תמיד מגיעות אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पर्श आपका सहारा है। पीठ पर रखा हाथ, देर तक चलने वाला गले लगना — यह उस गहराई तक परवाह पहुँचाता है जहाँ शब्द हमेशा नहीं पहुँच पाते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érintés a horgonyod. Egy kéz a hátadon, egy hosszú ölelés – olyan szinten fejezi ki a törődést, ahová a szavak nem mindig érnek el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan adalah jangkarmu. Tangan di punggungmu, pelukan yang lama — itu menyampaikan kepedulian yang kadang tak terjangkau kata-kata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto è la tua àncora. Una mano sulla schiena, un abbraccio che dura — trasmette cura là dove le parole non sempre arrivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れ合いが心のよりどころです。背中に添えられた手、長めのハグ。言葉だけでは届かないところまで、思いやりが伝わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킨십은 마음의 닻이에요. 등을 감싸는 손길, 오래 머무는 포옹은 말로 다 전하지 못하는 마음까지 전해 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan ialah sauh anda. Tangan di belakang anda, pelukan yang lama — ia menyampaikan rasa sayang pada tahap yang tidak selalu dapat dicapai oleh kata-kata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring er ankeret ditt. En hånd på ryggen, en klem som varer – det viser omsorg på et nivå ord ikke alltid når fram til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking is je anker. Een hand op je rug, een knuffel die blijft duren – het brengt zorg over op een niveau waar woorden niet altijd bij kunnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk to twoja kotwica. Dłoń na plecach, długi uścisk – przekazują troskę tam, dokąd słowa nie zawsze sięgają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque é seu porto seguro. Uma mão nas costas, um abraço demorado — isso fala de cuidado num nível que as palavras nem sempre alcançam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea e ancora ta. O mână pe spate, o îmbrățișare care durează — transmit grijă acolo unde cuvintele nu ajung mereu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновения — твоя опора. Ладонь на спине, долгие объятия — они говорят о заботе там, где слов не всегда хватает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring är ditt ankare. En hand på ryggen, en kram som dröjer sig kvar – den visar omtanke på ett sätt som ord inte alltid når."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสัมผัสคือที่ยึดเหนี่ยวของคุณ มือที่แตะหลังเบาๆ อ้อมกอดที่ยาวนาน สื่อถึงความห่วงใยได้ลึกซึ้งในแบบที่คำพูดอาจไปไม่ถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunuş sana en çok güven veren şey. Sırtına konan bir el, uzun süren bir sarılma… Sözlerin her zaman ulaşamadığı bir yerden şefkat anlatıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик — твоя опора. Рука на спині, довгі обійми — так турбота передається там, куди слова не завжди дістають."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm là điểm tựa của bạn. Một bàn tay đặt sau lưng, một cái ôm thật lâu — truyền tải sự quan tâm ở nơi lời nói không phải lúc nào cũng chạm tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触碰让你安心。手轻轻放在你背上，一个久久的拥抱——它传递的在乎，有时是语言到不了的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸碰是你的定心丸。輕放在背上的手、一個久久的擁抱，能傳達言語不一定到得了的關心。"
          }
        }
      }
    },
    "Touch speaks when energy is low but the mood is warm." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللمسة تتكلم حين تكون الطاقة منخفضة والمزاج دافئًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když chybí energie, ale nálada je vřelá, mluví dotek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring taler, når energien er lav, men stemningen er varm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berührung spricht, wenn die Energie niedrig, aber die Stimmung warm ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άγγιγμα μιλάει όταν η ενέργεια είναι χαμηλή αλλά η διάθεση ζεστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contacto habla cuando hay poca energía pero el ánimo es cálido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketus puhuu, kun energia on vähissä mutta tunnelma lämmin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagsasalita ang haplos kapag mababa ang enerhiya pero mainit ang mood."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le toucher parle quand l'énergie est basse mais que l'humeur est douce."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגע מדבר כשהאנרגיה נמוכה אבל מצב הרוח חם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब ऊर्जा कम हो पर मूड अच्छा, तब स्पर्श बोलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érintés beszél, amikor kevés az energia, de meleg a hangulat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan bicara saat energi rendah tapi suasana hati hangat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto parla quando le energie sono poche ma l’umore è dolce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元気はなくても気分が温かいときは、触れることが言葉の代わりになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기운은 없어도 기분이 따뜻할 땐 손길이 말을 대신해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuhan berbicara bila tenaga rendah tetapi perasaan hangat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøring snakker når energien er lav, men stemningen varm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanraking spreekt als de energie laag is maar de stemming warm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyk mówi, gdy energii jest mało, ale nastrój jest ciepły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toque fala quando a energia está baixa, mas o clima está gostoso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea vorbește când energia e scăzută, dar starea e caldă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикосновение говорит, когда сил мало, но настроение тёплое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beröring talar när energin är låg men stämningen är varm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อพลังน้อยแต่อารมณ์อบอุ่น สัมผัสจะพูดแทนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji düşük ama ruh hali sıcakken dokunuş konuşur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик говорить, коли сил мало, а настрій теплий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cái chạm biết nói khi năng lượng thấp nhưng tâm trạng vẫn ấm áp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力不足但心情温暖时，触碰会替你说话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力氣不多但心情溫暖時，觸碰就是語言。"
          }
        }
      }
    },
