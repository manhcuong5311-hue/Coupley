            "value" : "Skickar sms eller ringer direkt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทักหรือโทรหาทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen mesaj atar ya da ararım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одразу пишу чи дзвоню"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhắn tin hoặc gọi ngay"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马上发消息或打电话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "馬上傳訊息或打電話"
