    "Honest. Screen time before bed disrupts sleep quality — but many people do it. Worth working on together." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlik. Skermtyd voor slaaptyd versteur jou slaap – maar baie mense doen dit. Die moeite werd om saam aan te werk."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ታማኝ። ከመተኛት በፊት ስክሪን ማየት የእንቅልፍ ጥራትን ያውካል — ግን ብዙ ሰዎች ያደርጉታል። አብሮ ቢሠራበት ይጠቅማል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجابة صادقة. الشاشات قبل النوم تُضعف جودته، لكن كثيرين يفعلون ذلك. أمر يستحق أن تعملا عليه معًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ উত্তৰ। শোৱাৰ আগতে স্ক্ৰীণ চালে টোপনিৰ মান বেয়া হয় — কিন্তু বহুতেই এনে কৰে। একেলগে ইয়াৰ ওপৰত কাম কৰিব পাৰি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dürüstcəsinə. Yatmazdan əvvəl ekran qarşısında vaxt yuxunun keyfiyyətini pozur — amma çoxları belə edir. Birlikdə üzərində işləməyə dəyər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шчыра. Экраны перад сном пагаршаюць сон — але так робяць многія. Варта папрацаваць над гэтым разам."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честно. Екраните преди сън влошават качеството на съня – но много хора го правят. Струва си да поработите по това заедно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ উত্তর। ঘুমের আগে স্ক্রিন ঘুমের মান নষ্ট করে — কিন্তু অনেকেই এটা করে। দুজনে মিলে ঠিক করার চেষ্টা করা যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskreno. Ekrani prije spavanja kvare kvalitet sna – ali mnogi to rade. Vrijedi zajedno poraditi na tome."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceritat. Les pantalles abans de dormir empitjoren la qualitat del son — però molta gent ho fa. Val la pena treballar-ho junts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřímné. Obrazovky před spaním zhoršují kvalitu spánku – ale dělá to spousta lidí. Stojí za to na tom zapracovat spolu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gonest. Mae amser sgrin cyn gwely'n amharu ar ansawdd cwsg — ond mae llawer o bobl yn ei wneud. Mae'n werth gweithio arno gyda'ch gilydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærligt. Skærmtid før sengetid går ud over søvnkvaliteten – men det gør mange. Noget, I kan arbejde på sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehrlich. Bildschirmzeit vor dem Schlafen verschlechtert den Schlaf – aber viele machen es. Etwas, woran ihr gemeinsam arbeiten könnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειλικρινές. Η οθόνη πριν τον ύπνο χαλάει την ποιότητά του — αλλά πολλοί το κάνουν. Αξίζει να το δουλέψετε μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceridad ante todo. Las pantallas antes de dormir empeoran la calidad del sueño, pero mucha gente lo hace. Vale la pena trabajarlo juntos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Ekraaniaeg enne magamaminekut rikub une kvaliteeti — aga paljud teevad seda. Tasub koos sellega tegeleda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zintzoa. Oheratu aurretik pantailak loaren kalitatea kaltetzen du — baina askok egiten dute. Merezi du elkarrekin lantzea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادقانه. صفحه‌نمایش قبل از خواب کیفیت خواب را به هم می‌زند — ولی خیلی‌ها این کار را می‌کنند. ارزش دارد با هم رویش کار کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehellistä. Ruutuaika ennen nukkumaanmenoa heikentää unen laatua – mutta moni tekee niin. Kannattaa työstää yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapat. Nakakasira ng kalidad ng tulog ang screen time bago matulog — pero marami ang gumagawa nito. Sulit itong ayusin nang magkasama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honnête. Les écrans avant de dormir nuisent au sommeil, mais beaucoup de gens le font. Ça vaut le coup d'y travailler ensemble."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macánta. Cuireann am scáileáin roimh dhul a chodladh isteach ar cháilíocht an chodlata — ach déanann go leor daoine é. Is fiú oibriú air le chéile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceridade. As pantallas antes de durmir empeoran o sono, pero é algo moi común. Paga a pena traballalo xuntos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્રામાણિક. સૂતાં પહેલાં સ્ક્રીન જોવાથી ઊંઘ ખરાબ થાય છે — પણ ઘણા લોકો એમ કરે છે. સાથે મળીને સુધારવા જેવું."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaskiya. Kallon allo kafin barci na ɓata ingancin barci — amma mutane da yawa na yi. Ya dace ku yi aiki a kai tare."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשובה כנה. זמן מסך לפני השינה פוגע באיכות השינה — אבל הרבה עושים את זה. שווה לעבוד על זה ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमानदार जवाब। सोने से पहले स्क्रीन नींद बिगाड़ती है — पर बहुत से लोग ऐसा करते हैं। साथ मिलकर इस पर काम करना अच्छा रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskreno. Ekrani prije spavanja narušavaju kvalitetu sna – ali mnogi to rade. Vrijedi zajedno poraditi na tome."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onèt. Ekran anvan dòmi fè ou dòmi mal — men anpil moun fè l. Li ta bon pou nou travay sou sa ansanm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őszinte. A lefekvés előtti képernyőidő rontja az alvás minőségét – de sokan csinálják. Érdemes együtt dolgozni rajta."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անկեղծ է։ Քնելուց առաջ էկրանը վատացնում է քնի որակը — բայց շատերն են այդպես անում։ Արժե միասին աշխատել դրա վրա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jujur. Main HP sebelum tidur mengganggu kualitas tidur — tapi banyak orang melakukannya. Layak diperbaiki bersama."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eziokwu. Ihuenyo tupu ụra na-emebi ụra — mana ọtụtụ mmadụ na-eme ya. Ọ bara uru ka unu rụkọọ ọrụ na ya ọnụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiðarlegt. Skjátími fyrir svefninn skerðir svefngæðin – en margir gera þetta. Gott að vinna í því saman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincerità. Gli schermi prima di dormire peggiorano la qualità del sonno — ma lo fanno in tanti. Vale la pena lavorarci insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直な答えです。寝る前のスマホは睡眠の質を下げますが、多くの人がやっていること。ふたりで一緒に見直してみる価値があります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jujur. Ndeleng layar sadurunge turu ngganggu kualitas turu — nanging akeh wong nglakoni. Pantes didandani bareng."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გულწრფელია. ძილის წინ ეკრანი ძილის ხარისხს აუარესებს — მაგრამ ბევრი ასე იქცევა. ღირს, ამაზე ერთად იმუშაოთ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адал жауап. Ұйқы алдындағы экран ұйқы сапасын бұзады — бірақ көп адам солай істейді. Бірге түзеп көрген жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្មោះត្រង់។ ការមើលអេក្រង់មុនចូលគេង ធ្វើឲ្យគុណភាពដំណេកធ្លាក់ចុះ — ប៉ុន្តែមនុស្សជាច្រើនធ្វើដូច្នេះ។ គួរកែប្រែជាមួយគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಾಮಾಣಿಕ. ಮಲಗುವ ಮುನ್ನ ಸ್ಕ್ರೀನ್ ನೋಡುವುದು ನಿದ್ರೆಯ ಗುಣಮಟ್ಟ ಕೆಡಿಸುತ್ತದೆ — ಆದರೆ ಹಲವರು ಹಾಗೆ ಮಾಡುತ್ತಾರೆ. ಜೊತೆಯಾಗಿ ಇದರ ಮೇಲೆ ಕೆಲಸ ಮಾಡಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "솔직하네요. 자기 전 화면은 수면의 질을 떨어뜨리지만, 많은 사람이 그래요. 함께 고쳐 나가 봐도 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast. Dema li ber ekranê berî xewê kalîteya xewê xera dike — lê gelek kes vê dikin. Hêja ye ku hûn bi hev re li ser bixebitin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чынчыл. Уктаар алдында экран уйкунун сапатын бузат — бирок муну көп адамдар кылат. Бирге оңдоп көрсөңөр болот."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éierlech. Ecranzäit virum Schlofe mécht de Schlof méi schlecht — mee vill Leit maachen et. Et lount sech, zesummen drun ze schaffen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຈິງໃຈດີ ການເບິ່ງໜ້າຈໍກ່ອນນອນລົບກວນຄຸນນະພາບການນອນ — ແຕ່ຫຼາຍຄົນກໍເຮັດ ຄຸ້ມຄ່າທີ່ຈະປັບນຳກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuoširdu. Ekranas prieš miegą prastina miego kokybę – bet taip daro daugelis. Verta tai keisti kartu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godīgi. Ekrāni pirms gulētiešanas pasliktina miega kvalitāti – bet tā dara daudzi. Vērts pie tā strādāt kopā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marina. Manimba ny kalitaon'ny torimaso ny efijery alohan'ny hatory — nefa maro no manao izany. Mendrika hiarahana miasa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pono. Ka raru te kounga o te moe i te mata i mua i te moenga — engari he maha e pērā ana. He pai kia mahi tahi kōrua ki runga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искрено. Екраните пред спиење го нарушуваат квалитетот на сонот — но многумина го прават тоа. Вреди заедно да работите на тоа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സത്യസന്ധം. ഉറങ്ങും മുമ്പുള്ള സ്ക്രീൻ സമയം ഉറക്കത്തിന്റെ ഗുണം കുറയ്ക്കും — പക്ഷേ ഒരുപാടുപേർ അങ്ങനെ ചെയ്യുന്നു. ഒരുമിച്ച് ശ്രമിച്ച് മാറ്റാവുന്ന ഒന്ന്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шударга. Унтахын өмнө дэлгэц ширтэх нь нойрны чанарыг алдагдуулдаг — гэхдээ олон хүн ингэдэг. Хамтдаа засаж болох зүйл."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रामाणिक. झोपण्यापूर्वीचा स्क्रीन टाइम झोपेचा दर्जा बिघडवतो — पण अनेकजण असेच करतात. यावर एकत्र काम करणे चांगले."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jujur. Masa skrin sebelum tidur mengganggu kualiti tidur — tetapi ramai yang melakukannya. Elok diusahakan bersama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onestà. Il-ħin quddiem l-iskrin qabel l-irqad ifixkel il-kwalità tal-irqad — imma ħafna nies jagħmluh. Ta' min taħdmu fuqu flimkien."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရိုးသားတယ်။ အိပ်ခါနီး ဖန်သားပြင်ကြည့်တာက အိပ်စက်မှုကို ထိခိုက်စေတယ် — ဒါပေမဲ့ လူအများက လုပ်ကြတာပါ။ အတူ ပြင်ဆင်ကြည့်သင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærlig. Skjermtid før leggetid går ut over søvnkvaliteten – men mange gjør det. Verdt å jobbe med sammen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इमानदार। सुत्नुअघिको स्क्रिन समयले निद्राको गुणस्तर बिगार्छ — तर धेरैले यस्तै गर्छन्। सँगै सुधार्न लायक कुरा।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlijk. Schermtijd voor het slapen verstoort je slaap – maar veel mensen doen het. Iets om samen aan te werken."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moona mtima. Kuyang'ana zowonetsera musanagone kumasokoneza tulo — koma anthu ambiri amatero. Ndi bwino kuyesetsa nazo limodzi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhugaa. Yeroon iskiriinii hirriba dura qulqullina hirribaa jeeqa — garuu namoonni baay'een ni godhu. Waliin irratti hojjechuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଚ୍ଚା। ଶୋଇବା ଆଗରୁ ସ୍କ୍ରିନ୍ ନିଦର ଗୁଣ ନଷ୍ଟ କରେ — କିନ୍ତୁ ବହୁତ ଲୋକ ଏହା କରନ୍ତି। ଏକାଠି ଏଥିରେ କାମ କରିବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਈਮਾਨਦਾਰ ਜਵਾਬ। ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਸਕ੍ਰੀਨ ਨੀਂਦ ਨੂੰ ਖ਼ਰਾਬ ਕਰਦੀ ਹੈ — ਪਰ ਬਹੁਤ ਲੋਕ ਇਹ ਕਰਦੇ ਹਨ। ਇਸ ਉੱਤੇ ਇਕੱਠੇ ਕੰਮ ਕਰਨਾ ਚੰਗਾ ਰਹੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczerze. Ekran przed snem psuje jakość snu – ale wiele osób tak robi. Warto popracować nad tym razem."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رښتیا. له خوب مخکې سکرین ته کتل د خوب کیفیت خرابوي — خو ډېر خلک یې کوي. ښه به وي یوځای پرې کار وکړئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceridade. Tela antes de dormir atrapalha a qualidade do sono — mas muita gente faz isso. Vale trabalhar nisso juntos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestidade. Ecrãs antes de dormir prejudicam a qualidade do sono — mas muita gente faz isso. Vale a pena trabalharem nisso a dois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un răspuns sincer. Ecranele înainte de culcare strică somnul — dar mulți fac asta. Merită să lucrați împreună la asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честно. Экран перед сном портит качество сна — но так делают многие. Над этим стоит поработать вместе."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ukuri. Kureba muri telefoni mbere yo kuryama byangiza ireme ry'ibitotsi — ariko abantu benshi barabikora. Ni byiza kubikoraho muri kumwe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවංකයි. නින්දට කලින් තිරය බලන එක නින්දේ ගුණාත්මකභාවය නරක් කරනවා — ඒත් ගොඩදෙනෙක් ඒක කරනවා. එක්ව වෙනස් කරගන්න වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úprimné. Obrazovka pred spaním zhoršuje kvalitu spánku – no robí to veľa ľudí. Oplatí sa na tom zapracovať spolu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskreno. Zaslon pred spanjem slabša kakovost spanca – a to počne veliko ljudi. Vredno je skupaj delati na tem."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakatendeka. Kutarisa zvidzitiro usati warara kunokanganisa hope — asi vanhu vazhinji vanozviita. Zvakakodzera kuzvishandira pamwe chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daacad. Waqtiga shaashadda ee hurdada ka hor ayaa hurdada tayadeeda dhaawaca — laakiin dad badan ayaa sameeya. Waa mudan tahay inaad wadajir uga shaqaysaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinqeritet. Ekrani para gjumit e prish cilësinë e gjumit – por shumë njerëz e bëjnë. Vlen ta punoni bashkë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искрено. Екрани пред спавање кваре квалитет сна — али многи то раде. Вреди да на томе радите заједно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jujur. Ningali layar sateuacan saré ngaganggu kualitas saré — tapi seueur jalma anu ngalakukeunana. Patut dirobih babarengan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ärligt. Skärmtid före sänggåendet försämrar sömnen – men många gör det. Värt att jobba på tillsammans."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukweli. Muda wa skrini kabla ya kulala huharibu ubora wa usingizi — lakini watu wengi hufanya hivyo. Ni vyema kulifanyia kazi pamoja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேர்மை. தூங்கும் முன் திரையைப் பார்ப்பது தூக்கத்தின் தரத்தைக் கெடுக்கும் — ஆனால் பலரும் அப்படித்தான். ஒன்றாக முயன்று மாற்றலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిజాయితీ. పడుకునే ముందు స్క్రీన్ చూడటం నిద్ర నాణ్యతను దెబ్బతీస్తుంది — కానీ చాలా మంది చేస్తారు. కలిసి మార్చుకోవడానికి ప్రయత్నించండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ростқавлона. Экран пеш аз хоб сифати хобро вайрон мекунад — вале бисёриҳо ҳамин тавр мекунанд. Арзиш дорад, ки якҷоя дар ин бора кор кунед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จริงใจดี การดูจอก่อนนอนรบกวนคุณภาพการนอน แต่ก็มีคนทำแบบนี้เยอะ ลองช่วยกันปรับดู"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅኑዕ። ቅድሚ ድቃስ ስክሪን ምርኣይ ጽሬት ድቃስ ይዘርግ — ብዙሓት ግን ይገብርዎ። ብሓባር ክትሰርሑሉ ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dogruçyl. Ýatmazdan öň ekrana seretmek ukyňy bozýar — ýöne köp adam şeýle edýär. Bile üstünde işlemäge degýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dürüst bir cevap. Yatmadan önce ekrana bakmak uyku kalitesini bozuyor ama pek çok insan yapıyor. Birlikte üzerinde çalışmaya değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чесно. Екран перед сном погіршує якість сну — але так роблять дуже багато людей. Варто попрацювати над цим разом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سچا جواب۔ سونے سے پہلے اسکرین نیند کا معیار خراب کرتی ہے — مگر بہت سے لوگ ایسا کرتے ہیں۔ اس پر مل کر کام کرنا اچھا رہے گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samimiy. Uxlashdan oldin ekranga qarash uyqu sifatini buzadi — lekin koʻpchilik shunday qiladi. Buni birga oʻzgartirishga arziydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành thật đấy. Dùng màn hình trước khi ngủ làm giảm chất lượng giấc ngủ — nhưng nhiều người vẫn vậy. Đáng để hai bạn cùng cải thiện."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unyanisekile. Ixesha lesikrini phambi kokulala liphazamisa umgangatho wokulala — kodwa abantu abaninzi bayayenza. Kufanelekile ukusebenza kuyo kunye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Òótọ́ ni. Wíwo ẹ̀rọ kí a tó sùn ń ba oorun jẹ́ — ṣùgbọ́n ọ̀pọ̀ ènìyàn ló ń ṣe é. Ó yẹ kí ẹ jọ ṣiṣẹ́ lé e lórí."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很坦白。睡前看螢幕會影響睡眠質素，但很多人都會這樣。值得兩人一起改善。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很诚实。睡前看屏幕会影响睡眠质量，但很多人都这样。值得一起改一改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很誠實。睡前滑手機會影響睡眠品質，但很多人都這樣。值得兩人一起改善。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uqotho. Isikhathi sesikrini ngaphambi kokulala siphazamisa ubuthongo — kodwa abantu abaningi bakwenza. Kufanele nikusebenzele ndawonye."
          }
        }
      }
