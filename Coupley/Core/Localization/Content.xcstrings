    "Moving forward together, doing something light — that's how you reset the energy between you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المضي قدمًا معًا بشيء خفيف ومرح، هكذا تعيدون ضبط الطاقة بينكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jít spolu dál a dělat něco odlehčeného – takhle mezi sebou obnovujete energii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At komme videre sammen med noget let – det er sådan, du nulstiller stemningen mellem jer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsam weitergehen und etwas Leichtes unternehmen – so bringst du die Stimmung zwischen euch wieder ins Lot."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να προχωράτε μαζί, κάνοντας κάτι ανάλαφρο — έτσι ανανεώνεις την ενέργεια ανάμεσά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir adelante juntos haciendo algo ligero: así renuevas la energía entre los dos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eteenpäin yhdessä, jotain kevyttä tehden – niin nollaat tunnelman välillänne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabay na pagsulong, paggawa ng magaan na bagay — ganyan mo nire-reset ang enerhiya sa pagitan ninyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancer ensemble avec quelque chose de léger : c'est comme ça que tu changes l'énergie entre vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להמשיך הלאה יחד, לעשות משהו קליל — ככה מתאפסת אצלכם האנרגיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ आगे बढ़ना, कुछ हल्का-फुल्का करना — इसी तरह आप दोनों के बीच का माहौल फिर से ताज़ा होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Együtt továbblépni, valami könnyed dologgal – így frissíted fel a köztetek lévő energiát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melangkah bersama, melakukan sesuatu yang ringan — begitulah caramu menyegarkan suasana di antara kalian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andare avanti insieme, facendo qualcosa di leggero — è così che rimetti in circolo la giusta energia tra voi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで気軽に楽しめることをして、一緒に前へ進む。それがふたりの空気をリセットする方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가벼운 일을 함께하며 앞으로 나아가는 것. 그게 두 사람 사이의 분위기를 되돌리는 방법이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melangkah ke hadapan bersama, melakukan sesuatu yang ringan — itulah cara anda menyegarkan semula suasana antara anda berdua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å gå videre sammen og gjøre noe lett – det er sånn du nullstiller energien mellom dere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samen verder, iets luchtigs doen – zo zet jij de energie tussen jullie weer goed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iść razem dalej, robiąc coś lekkiego – tak odświeżasz energię między wami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir em frente juntos, fazendo algo leve — é assim que você renova a energia entre vocês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să mergeți mai departe împreună, făcând ceva lejer — așa resetezi energia dintre voi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигаться дальше вместе, заняться чем-то лёгким — так ты обновляешь атмосферу между вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att gå vidare tillsammans med något lättsamt – det är så du nollställer energin mellan er."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก้าวต่อไปด้วยกันด้วยการทำอะไรเบาๆ สบายๆ นั่นคือวิธีที่คุณรีเซ็ตบรรยากาศระหว่างกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte ilerlemek, hafif bir şey yapmak; aranızdaki enerjiyi böyle tazeliyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухатися далі разом і зайнятися чимось легким — так ти оновлюєш енергію між вами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng nhau bước tiếp, làm điều gì đó nhẹ nhàng — đó là cách bạn làm mới bầu không khí giữa hai người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起往前走，做点轻松的事——这就是你让彼此气氛回暖的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起往前走、做點輕鬆的事，是你們重新調整氣氛的方式。"
          }
        }
      }
    },
