        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat dymmak we hiç hili meýilnama ýok. Biri bilen şeýle rahatlyk ýakynlygyň hakyky alamaty."
          }
        },
        "tr" : {
          "stringUnit" : {
