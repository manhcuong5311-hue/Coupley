            "state" : "translated",
            "value" : "สามสัปดาห์ของการเข้านอนก่อนห้าทุ่ม แล้วคุณจะรู้สึกได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç hafta boyunca en geç 11'de yatakta olun. Farkı hissedeceksiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три тижні — у ліжку до 23:00. Ви відчуєте різницю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba tuần đi ngủ trước 11 giờ. Bạn sẽ cảm nhận được sự khác biệt."
          }
        },
        "zh-Hans" : {
