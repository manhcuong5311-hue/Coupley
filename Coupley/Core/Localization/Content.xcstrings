    "Ask about something they're working on — specific, not 'how's work.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vra oor iets waaraan jou maat werk – spesifiek, nie “hoe gaan dit by die werk?” nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እየሠሩበት ስላለው አንድ ነገር ይጠይቁ — «ሥራ እንዴት ነው?» ሳይሆን የተወሰነ ነገር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا عن شيء يعمل عليه شريكك، بشكل محدد، لا «كيف العمل؟»."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তেওঁ কাম কৰি থকা কিবা এটাৰ বিষয়ে সুধক — নিৰ্দিষ্টকৈ, “কাম কেনে চলিছে” নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onun üzərində işlədiyi bir şey barədə soruş — konkret, “iş necədir?” yox."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спытай пра тое, над чым палавінка працуе, — канкрэтна, а не «як праца»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попитай за нещо, по което работи – конкретно, не „Как е работата?“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ও যা নিয়ে কাজ করছে, সেটা নিয়ে জিজ্ঞেস করো — নির্দিষ্ট করে, শুধু “কাজ কেমন চলছে” নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitaj o nečemu na čemu voljena osoba radi – konkretno, ne „kako je na poslu”."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta-li per alguna cosa en què estigui treballant — concreta, no «com va la feina»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se na něco, na čem právě pracuje – konkrétně, ne „jak bylo v práci“."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gofynna am rywbeth mae dy bartner yn gweithio arno — penodol, nid ‘sut mae'r gwaith?’"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg ind til noget, din partner arbejder på – konkret, ikke bare »hvordan går det på arbejdet?«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nach etwas, woran dein Schatz gerade arbeitet – konkret, nicht „Wie war die Arbeit?“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα για κάτι συγκεκριμένο που δουλεύει το ταίρι σου — όχι ένα «πώς πάει η δουλειά»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale por algo en lo que esté trabajando: algo concreto, no “¿qué tal el trabajo?”."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küsi millegi kohta, mille kallal ta töötab — konkreetselt, mitte „kuidas tööl läheb“."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galdetu esku artean duen zerbaiti buruz: zehatz, ez «zer moduz lanean»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دربارهٔ کاری که رویش کار می‌کند بپرس — دقیق، نه «کار چطور بود؟»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy jostain, minkä parissa hän työskentelee – jotain tarkkaa, ei pelkkää ”miten töissä”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magtanong tungkol sa isang bagay na ginagawa niya — tiyak, hindi lang “kumusta ang trabaho.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose une question sur un projet en cours, précise, pas juste « ça va le boulot ? »."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiafraigh faoi rud atá idir lámha ag do pháirtí — go sonrach, ní “conas atá an obair”."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntalle por algo concreto no que estea traballando, non un «que tal o traballo?»."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ જેના પર કામ કરે છે એ વિશે પૂછો — ચોક્કસ, “કામ કેવું ચાલે છે” નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku tambayi abokin zamanku game da wani abu da ake kan aiki a kai — takamaimai, ba “yaya aiki?” ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשאול על משהו ספציפי שהצד השני עובד עליו — לא \"מה בעבודה\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके किसी चल रहे काम के बारे में पूछें — कुछ ख़ास, सिर्फ़ “काम कैसा है” नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitaj o nečemu na čemu voljena osoba radi – konkretno, ne „kako je na poslu”."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poze l kesyon sou yon bagay l ap travay sou li — presi, pa “kijan travay la?”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezz rá valamire, amin éppen dolgozik – konkrétan, ne csak „milyen volt a munka”."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հարցրու մի բանի մասին, որի վրա նա աշխատում է՝ կոնկրետ, ոչ թե «ինչպե՞ս է աշխատանքը»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan sesuatu yang sedang dia kerjakan — spesifik, bukan “gimana kerjaan.”"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jụọ maka ihe ọ na-arụ — nke a kapịrị ọnụ, ọ bụghị ‘kedụ maka ọrụ.’"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spurðu um eitthvað sem makinn þinn er að vinna að – nákvæmlega, ekki bara „hvernig er í vinnunni“."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi di qualcosa a cui sta lavorando — una cosa precisa, non «come va il lavoro»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「仕事どう？」ではなく、取り組んでいることについて具体的に聞いてみましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takon bab sing lagi digarap pasangan — sing tartamtu, dudu “kepiye gaweyane”."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჰკითხე იმაზე, რაზეც ახლა მუშაობს — კონკრეტულად და არა „როგორ არის საქმეები სამსახურში“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оның қазір айналысып жүрген ісі туралы нақты сұра, «жұмыс қалай» емес."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សួរពីអ្វីដែលគាត់កំពុងធ្វើ — ឲ្យជាក់លាក់ មិនមែន “ការងារយ៉ាងម៉េចហើយ” ទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅವರು ಕೆಲಸ ಮಾಡುತ್ತಿರುವ ಯಾವುದಾದರೂ ವಿಷಯದ ಬಗ್ಗೆ ಕೇಳಿ — ನಿರ್ದಿಷ್ಟವಾಗಿ, “ಕೆಲಸ ಹೇಗಿದೆ” ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“일은 어때요?” 말고, 연인이 하고 있는 일에 대해 구체적으로 물어보세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li ser tiştekî ku ew li ser dixebite bipirse — bi taybetî, ne “kar çawa ye”."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ал азыр алектенип жаткан бир иш тууралуу сура — «иш кандай» эмес, конкреттүү."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fro no eppes, un deem däi Schatz grad schafft — konkret, net „Wéi ass et op der Aarbecht?“"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຖາມເລື່ອງທີ່ລາວກຳລັງເຮັດຢູ່ — ໃຫ້ເຈາະຈົງ ບໍ່ແມ່ນ “ວຽກເປັນແນວໃດ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paklausk apie tai, ką antroji pusė dabar daro, – konkrečiai, ne „kaip darbe“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pajautā par kaut ko, pie kā otrs strādā – konkrēti, nevis ‚kā darbā?’."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anontanio momba ny zavatra iray ataony — voafaritra, fa tsy hoe “nanao ahoana ny asa.”"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pātai mō tētahi mea e mahi ana ia — kia motuhake, kaua ko “kei te pēhea te mahi.”"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прашај ја за нешто на што работи — конкретно, не „Како е на работа?“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവർ ചെയ്തുകൊണ്ടിരിക്കുന്ന ഒരു കാര്യത്തെക്കുറിച്ച് ചോദിക്കൂ — കൃത്യമായി, “ജോലി എങ്ങനെ?” എന്നല്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хийж буй ажлынх нь талаар асуу — «ажил ямар байна» биш, тодорхой."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ते ज्यावर काम करत आहेत त्याबद्दल विचारा — नेमके, फक्त “काम कसे चालले आहे?” नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya tentang sesuatu yang sedang dia usahakan — khusus, bukan “kerja macam mana.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staqsi dwar proġett jew ħidma li għaddejja bħalissa — b'mod speċifiku, mhux “kif sejjer ix-xogħol.”"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချစ်သူ လုပ်နေတဲ့ အရာတစ်ခုအကြောင်း မေးပါ — “အလုပ် ဘယ်လိုလဲ” မဟုတ်ဘဲ အတိအကျ မေးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør om noe partneren din jobber med – konkret, ikke «hvordan går det på jobb»."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उहाँले गरिरहेको कुनै कामबारे सोध्नुहोस् — ‘काम कस्तो छ’ होइन, खास कुरा।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag naar iets waar je partner mee bezig is – concreet, niet “hoe was je werk?”."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afunseni za chinthu chomwe akugwira — chenicheni, osati “ntchito ili bwanji.”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waa'ee hojii jaalallee kee murtaa'aa tokko gaafadhu — “hojiin akkam?” miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେ ଯେଉଁ କାମ କରୁଛନ୍ତି, ସେ ବିଷୟରେ ପଚାରନ୍ତୁ — ନିର୍ଦ୍ଦିଷ୍ଟ ଭାବେ, କେବଳ “କାମ କେମିତି ଚାଲିଛି” ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਨ੍ਹਾਂ ਦੇ ਕਿਸੇ ਚੱਲ ਰਹੇ ਕੰਮ ਬਾਰੇ ਪੁੱਛੋ — ਖ਼ਾਸ ਗੱਲ, ਸਿਰਫ਼ “ਕੰਮ ਕਿਵੇਂ ਹੈ” ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj o coś, nad czym druga połówka teraz pracuje – konkretnie, nie „jak w pracy”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د هغه څه په اړه وپوښتئ چې پرې کار کوي — مشخص، نه «کار دې څنګه دی؟»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte sobre algo em que seu amor está trabalhando — específico, não “como foi o trabalho”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta por algo em que o teu par esteja a trabalhar — em concreto, não «como vai o trabalho»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreabă de ceva la care lucrează — concret, nu „cum e la muncă”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спроси о том, над чем партнёр сейчас работает, — конкретно, а не «как работа?»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mubaze ku kintu arimo gukoraho — cyihariye, si “akazi kameze gate?”"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔවුන් කරමින් ඉන්න දෙයක් ගැන අහන්න — නිශ්චිතව, “වැඩ කොහොමද” නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spýtaj sa na niečo, na čom práve pracuje – konkrétne, nie „ako v práci“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vprašaj o nečem, na čemer partner dela – konkretno, ne „kako je v službi“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bvunza nezvechimwe chinhu chaari kushanda pachiri — chaicho, kwete ‘basa riri sei.’"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wax ka weydii shaqo hadda lagu jiro — si gaar ah, ma aha “shaqadu sidee tahay”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyet për diçka konkrete me të cilën po merret – jo „si është puna“."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питај за нешто конкретно на чему твоја половина ради — не само „како посао“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taroskeun hal anu nuju digarap ku anjeunna: anu husus, sanés “kumaha padamelan?”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga om något din partner jobbar med – konkret, inte ”hur är det på jobbet”."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muulize kuhusu kitu anachokifanyia kazi — mahususi, si “kazi inaendaje.”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவர் செய்துகொண்டிருக்கும் ஒரு விஷயத்தைப் பற்றிக் கேளுங்கள் — “வேலை எப்படி” என்று அல்ல, குறிப்பாக."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వారు చేస్తున్న ఒక పని గురించి అడగండి — “పని ఎలా ఉంది?” అని కాదు, నిర్దిష్టంగా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дар бораи коре, ки ёрат ҳоло мекунад, бипурс — мушаххас, на «кор чӣ хел?»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามถึงสิ่งที่คนรักกำลังทำอยู่แบบเจาะจง ไม่ใช่แค่ “งานเป็นไง”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዛዕባ ዝሰርሕዎ ዘለዉ ነገር ሕተቱ — ፍሉይ፣ «ስራሕ ከመይ ኣሎ» ዘይኮነ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onuň häzir meşgul bolýan bir işi barada sora — “işler nähili” däl, anyk bir zat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uğraştığı bir şeyi sor; “iş nasıl” değil, belirli bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
