        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himlen där du är."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anga ulipo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் இருக்கும் இடத்தின் வானம்."
