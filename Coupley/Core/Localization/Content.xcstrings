    },
    "As short as possible — I'm not a morning person" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقصر ما يمكن، لست شخصًا صباحيًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co nejkratší – ráno není můj čas"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så kort som muligt – jeg er ikke et morgenmenneske"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So kurz wie möglich – kein Morgenmensch"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο πιο σύντομη γίνεται — τα πρωινά δεν είναι για μένα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más corta posible: las mañanas no son lo mío"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahdollisimman lyhyt – en ole aamuihminen"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maikli hangga’t maaari — hindi ako morning person"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plus courte possible, je ne suis pas du matin"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה שיותר קצר — הבוקר זה לא הזמן שלי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जितनी छोटी, उतना अच्छा — सुबह मेरी नहीं"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minél rövidebb – nem vagyok reggeli ember"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesingkat mungkin — aku bukan orang pagi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più breve possibile — il mattino non fa per me"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できるだけ短く。朝は苦手"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대한 짧게, 아침형 인간이 아니에요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesingkat mungkin — saya bukan orang pagi"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så kort som mulig – jeg er ikke et morgenmenneske"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo kort mogelijk – ik ben geen ochtendmens"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak najkrótszy – nie jestem rannym ptaszkiem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mais curta possível — não sou pessoa da manhã"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât mai scurtă — diminețile nu sunt pentru mine"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покороче — я не жаворонок"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så kort som möjligt – jag är ingen morgonmänniska"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งสั้นยิ่งดี ฉันไม่ใช่คนตื่นเช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olabildiğince kısa, sabah insanı değilim"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якомога коротше — я не ранкова людина"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng ngắn càng tốt — mình không phải người của buổi sáng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越短越好——我不是早起的人"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越短越好，我不是晨型人"
          }
        }
      }
    },
    "Ask about something they're working on — specific, not 'how's work.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا عن شيء يعمل عليه شريكك، بشكل محدد، لا «كيف العمل؟»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se na něco, na čem právě pracuje – konkrétně, ne „jak bylo v práci“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg ind til noget, din partner arbejder på – konkret, ikke bare »hvordan går det på arbejdet?«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nach etwas, woran dein Schatz gerade arbeitet – konkret, nicht „Wie war die Arbeit?“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα για κάτι συγκεκριμένο που δουλεύει το ταίρι σου — όχι ένα «πώς πάει η δουλειά»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale por algo en lo que esté trabajando: algo concreto, no “¿qué tal el trabajo?”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy jostain, minkä parissa hän työskentelee – jotain tarkkaa, ei pelkkää ”miten töissä”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magtanong tungkol sa isang bagay na ginagawa niya — tiyak, hindi lang “kumusta ang trabaho.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose une question sur un projet en cours, précise, pas juste « ça va le boulot ? »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשאול על משהו ספציפי שהצד השני עובד עליו — לא \"מה בעבודה\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके किसी चल रहे काम के बारे में पूछें — कुछ ख़ास, सिर्फ़ “काम कैसा है” नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezz rá valamire, amin éppen dolgozik – konkrétan, ne csak „milyen volt a munka”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan sesuatu yang sedang dia kerjakan — spesifik, bukan “gimana kerjaan.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi di qualcosa a cui sta lavorando — una cosa precisa, non «come va il lavoro»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「仕事どう？」ではなく、取り組んでいることについて具体的に聞いてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“일은 어때요?” 말고, 연인이 하고 있는 일에 대해 구체적으로 물어보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya tentang sesuatu yang sedang dia usahakan — khusus, bukan “kerja macam mana.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør om noe partneren din jobber med – konkret, ikke «hvordan går det på jobb»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag naar iets waar je partner mee bezig is – concreet, niet “hoe was je werk?”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj o coś, nad czym druga połówka teraz pracuje – konkretnie, nie „jak w pracy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte sobre algo em que seu amor está trabalhando — específico, não “como foi o trabalho”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreabă de ceva la care lucrează — concret, nu „cum e la muncă”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спроси о том, над чем партнёр сейчас работает, — конкретно, а не «как работа?»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga om något din partner jobbar med – konkret, inte ”hur är det på jobbet”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามถึงสิ่งที่คนรักกำลังทำอยู่แบบเจาะจง ไม่ใช่แค่ “งานเป็นไง”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uğraştığı bir şeyi sor; “iş nasıl” değil, belirli bir şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спитай про те, над чим зараз працює половинка, — конкретно, а не «як робота»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi về việc người ấy đang làm — cụ thể, đừng chỉ “công việc sao rồi”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问问另一半正在忙的某件具体的事，而不是“工作怎么样”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問問對方正在忙的事，要具體，不是只問「工作怎樣」。"
          }
        }
      }
    },
    "Ask about the best part of their day — get specific." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا عن أجمل ما في يوم شريكك، وادخلوا في التفاصيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se protějšku na nejlepší část dne – a jdi do detailů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg, hvad der var det bedste ved dagen – og gå i detaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nach dem schönsten Moment des Tages – und zwar konkret."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα το ταίρι σου ποιο ήταν το καλύτερο κομμάτι της μέρας του — μπες σε λεπτομέρειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale por lo mejor de su día, con detalle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy hänen päivänsä parhaasta hetkestä – mene yksityiskohtiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itanong ang pinakamagandang bahagi ng araw niya — maging tiyak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande-lui le meilleur moment de sa journée, avec des détails."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשאול מה היה הרגע הכי טוב ביום — ולהיכנס לפרטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूछें कि उनके दिन का सबसे अच्छा हिस्सा क्या रहा — बारीकी से।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezd meg, mi volt a napja legjobb része – konkrétan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan bagian terbaik dari harinya — yang spesifik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi qual è stata la parte migliore della sua giornata — nei dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日いちばんよかったことを、具体的に聞いてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 가장 좋았던 순간이 뭐였는지 구체적으로 물어보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya bahagian terbaik harinya — tanya secara khusus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør om det beste med dagen – bli konkret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag wat het leukste moment van de dag was – en vraag door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj o najlepszy moment dnia – i dopytaj o szczegóły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte qual foi a melhor parte do dia — e peça detalhes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreabă care a fost cea mai bună parte a zilei — intră în detalii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спроси о лучшем моменте дня — с подробностями."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga om det bästa med din partners dag – gå in på detaljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามถึงช่วงที่ดีที่สุดของวัน ถามให้เจาะจง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gününün en güzel kısmını sor; ayrıntıya in."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спитай про найкращу мить дня — і про подробиці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi về khoảnh khắc tuyệt nhất trong ngày của người ấy — hỏi thật cụ thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问问另一半今天最开心的部分，问具体一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問問對方今天最開心的是什麼，問得具體一點。"
          }
        }
      }
    },
    "Ask something you don't already know the answer to." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا عن شيء لا تعرفون إجابته مسبقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se na něco, na co ještě neznáš odpověď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg om noget, du ikke allerede kender svaret på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag etwas, dessen Antwort du noch nicht kennst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα κάτι που δεν ξέρεις ήδη την απάντησή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale algo cuya respuesta aún no sepas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy jotain, mihin et vielä tiedä vastausta."
          }
        },
        "fil" : {
