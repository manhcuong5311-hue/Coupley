    "Playfulness — not taking everything too seriously" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المرح وعدم أخذ كل شيء بجدية مفرطة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hravost – nebrat všechno vážně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg – ikke at tage alting så alvorligt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verspieltheit – nicht alles so ernst nehmen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παιχνιδιάρικη διάθεση — να μην τα παίρνουμε όλα στα σοβαρά"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego: no tomarse todo tan en serio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikkisyys – kaikkea ei tarvitse ottaa liian vakavasti"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulitan — hindi sineseryoso ang lahat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La légèreté : ne pas tout prendre au sérieux"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שובבות — לא לקחת הכול ברצינות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मस्ती — हर बात को ज़्यादा गंभीरता से न लेना"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Játékosság – nem venni mindent túl komolyan"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bercanda — nggak terlalu serius soal semua hal"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggerezza — non prendere tutto troppo sul serio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊び心。何でも深刻にとらえすぎない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장난기, 너무 진지하지 않기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keceriaan — tidak terlalu serius tentang segalanya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lek – ikke ta alt så høytidelig"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelsheid – niet alles te serieus nemen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabawa – bez brania wszystkiego zbyt serio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leveza — não levar tudo tão a sério"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joaca — să nu luăm totul prea în serios"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкость — не воспринимать всё всерьёз"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekfullhet – att inte ta allt på så stort allvar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความขี้เล่น ไม่จริงจังกับทุกเรื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunbazlık, her şeyi fazla ciddiye almamak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грайливість — не сприймати все надто серйозно"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinh nghịch — không quá nghiêm túc"
          }
        },
        "zh-Hans" : {
