    "Knowing this helps them support you the right way — not just how they'd want to be supported." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As jou maat dit weet, kan jy op die regte manier ondersteun word – nie net soos jou maat self ondersteun sou wou word nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን ማወቅ አጋርዎ እርስዎን በትክክለኛው መንገድ እንዲደግፉ ይረዳቸዋል — ራሳቸው በሚፈልጉት መንገድ ብቻ ሳይሆን።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة ذلك تساعد شريكك على دعمك بالطريقة الصحيحة، لا بالطريقة التي يفضّلها لنفسه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এইটো জানিলে আপোনাৰ সংগীয়ে আপোনাক সঠিক ধৰণে সহায় কৰিব পাৰিব — কেৱল নিজে যিদৰে সহায় বিচাৰে তেনেদৰে নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu bilmək partnyoruna səni öz istədiyi kimi yox, düzgün şəkildə dəstəkləməyə kömək edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі палавінка гэта ведае, яна можа падтрымаць цябе так, як трэба менавіта табе, а не так, як хацелася б ёй самой."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Така половинката ти ще знае как да те подкрепи по правилния начин – не просто както би искала да подкрепят нея."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা জানলে ও তোমার পাশে ঠিকভাবে দাঁড়াতে পারবে — শুধু নিজে যেভাবে সাপোর্ট চাইত, সেভাবে নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad to zna, voljena osoba ti može pružiti podršku na pravi način – a ne samo onako kako bi njoj prijalo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber-ho l'ajuda a donar-te suport com cal — no només com li agradaria que li donessin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díky tomu tě tvůj protějšek může podpořit tak, jak to potřebuješ ty – ne tak, jak by to chtěl sám."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae gwybod hyn yn helpu dy bartner i dy gefnogi di yn y ffordd iawn — nid dim ond yn y ffordd y byddai'n hoffi cael cefnogaeth ei hun."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjælper din partner med at støtte dig på den rigtige måde – ikke bare på den måde, vedkommende selv gerne vil støttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So weiß dein Schatz, welche Unterstützung du wirklich brauchst – und nicht nur die, die man sich selbst wünschen würde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το ξέρει, μπορεί να σε στηρίξει όπως χρειάζεσαι εσύ — όχι όπως θα ήθελε να στηριχτεί το ίδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saberlo le ayuda a apoyarte como tú lo necesitas, no como le gustaría que la apoyaran a ella."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui partner seda teab, oskab ta sind õigesti toetada — mitte nii, nagu tema ise toetust tahaks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hau jakinda, zure bikotekideak behar duzun moduan lagun zaitzake — ez berari gustatuko litzaiokeen moduan bakarrik."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دانستن این کمک می‌کند پارتنرت همان‌طور که تو نیاز داری حمایتت کند — نه آن‌طور که خودش دوست دارد حمایت شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kumppanisi tietää tämän, hän osaa tukea sinua oikealla tavalla – eikä vain niin kuin itse haluaisi tulla tuetuksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag alam niya ito, masusuportahan ka niya sa tamang paraan — hindi lang sa paraang gusto niya para sa sarili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le savoir aide l'autre à te soutenir comme toi tu en as besoin, et pas selon ses propres besoins."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabhraíonn sé seo le do pháirtí tacú leat mar is ceart — ní hamháin ar an mbealach a dteastódh tacaíocht ó do pháirtí féin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabelo axúdalle a apoiarte como ti precisas, non só como querería recibir apoio."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ જાણવાથી તેઓ તમને સાચી રીતે સાથ આપી શકે છે — ફક્ત એ રીતે નહીં જે રીતે તેમને પોતાને સાથ જોઈતો હોય."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanin wannan na taimaka wa abokin zamanku ya tallafa muku yadda ya dace — ba lallai yadda abokin zamanku ke son a tallafa ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהצד השני יודע את זה, קל יותר לתמוך בך בדרך שנכונה לך — ולא רק בדרך שנכונה למי שתומך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जानकर पार्टनर आपको उसी तरह सहारा दे पाएँगे जैसा आपको चाहिए — न कि जैसा उन्हें ख़ुद के लिए चाहिए होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad to zna, voljena osoba ti može pružiti podršku na pravi način – a ne samo onako kako bi je sama htjela."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè yo konnen sa, yo ka soutni ou jan ou bezwen an — pa sèlman jan yo ta renmen yo soutni yo menm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ezt tudja, úgy tud támogatni, ahogy neked jó – nem csak úgy, ahogy ő szeretné, hogy őt támogassák."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա իմանալով՝ զուգընկերդ կկարողանա քեզ աջակցել ճիշտ ձևով — ոչ թե այնպես, ինչպես ինքը կուզեր, որ իրեն աջակցեին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan tahu ini, dia bisa mendukungmu dengan cara yang tepat — bukan sekadar cara yang dia sendiri suka."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịma nke a na-enyere ya aka ịkwado gị n'ụzọ kwesịrị ekwesị — ọ bụghị naanị otú ọ ga-achọ ka a kwado ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta hjálpar makanum þínum að styðja þig á réttan hátt – ekki bara eins og makinn sjálfur vildi fá stuðning."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saperlo aiuta il tuo partner a sostenerti nel modo giusto — non solo come vorrebbe essere sostenuto a sua volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを知っておくと、パートナーは自分がされたい支え方ではなく、本当に合った形で支えてくれるようになります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngerti iki mbantu pasangan nyengkuyung panjenengan kanthi cara sing pas — dudu mung cara sing dikarepake dhewe."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამის ცოდნა პარტნიორს დაეხმარება, სწორად დაგიჭიროს მხარი — და არა ისე, როგორც თავად ისურვებდა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мұны білсе, серігің саған өзіне ұнайтындай емес, дәл саған керектей қолдау көрсете алады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការដឹងរឿងនេះជួយឲ្យគាត់គាំទ្រអ្នកតាមរបៀបដែលត្រូវ — មិនមែនត្រឹមតែតាមរបៀបដែលគាត់ខ្លួនឯងចង់បាននោះទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ತಿಳಿದರೆ ಅವರು ನಿಮಗೆ ಸರಿಯಾದ ರೀತಿಯಲ್ಲಿ ಆಸರೆಯಾಗಬಹುದು — ತಮಗೆ ಬೇಕಾದ ರೀತಿಯಲ್ಲಿ ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이걸 알면 연인이 자기 방식이 아니라 내게 맞는 방식으로 힘이 되어 줄 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanîna vê dihêle ew bi awayê rast piştgiriya te bike — ne tenê bi awayê ku ew bixwe dixwaze piştgirî bistîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Муну билсе, ал сени туура колдой алат — өзүн кантип колдошсо жакшы көрөрүнө карап эмес."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat hëlleft dengem Schatz, dech esou z'ënnerstëtzen, wéi s du et brauchs — an net esou, wéi däi Schatz et selwer gär hätt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຮູ້ເລື່ອງນີ້ຊ່ວຍໃຫ້ຄູ່ຊ່ວຍເຈົ້າໄດ້ຖືກວິທີ — ບໍ່ແມ່ນແຕ່ແບບທີ່ລາວຢາກໄດ້ຮັບເອງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai žinodama antroji pusė galės tave palaikyti taip, kaip reikia tau, o ne taip, kaip norėtų ji pati."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinot to, otrā puse varēs tevi atbalstīt tā, kā vajag tieši tev, – nevis tā, kā gribētu pati."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fahafantarana izany dia manampy azy hanohana anao araka ny tokony ho izy — fa tsy araka ny fomba tiany hanohanana azy fotsiny."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te mōhio ki tēnei ka taea e ia te tautoko i a koe i te huarahi tika — kaua ko tāna ake e hiahia ai."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако го знае ова, половинката ќе те поддржи на вистинскиот начин — не само онака како таа би сакала да биде поддржана."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇതറിഞ്ഞാൽ, പങ്കാളിക്ക് സ്വന്തം ഇഷ്ടപ്രകാരമല്ല, നിങ്ങൾക്ക് വേണ്ട രീതിയിൽ നിങ്ങളെ പിന്തുണയ്ക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үүнийг мэдвэл хань чинь чамайг өөрийнх нь хүсдэг байдлаар биш, чамд хэрэгтэй байдлаар дэмжиж чадна."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे कळल्याने जोडीदार तुम्हाला योग्य प्रकारे आधार देऊ शकेल — स्वतःला जसा आधार हवा असतो तसा नव्हे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengetahui hal ini membantu pasangan anda menyokong anda dengan cara yang betul — bukan sekadar cara yang mereka sendiri mahukan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta l-partner tiegħek ikun jaf dan, l-appoġġ jasal bil-mod li għandek bżonn int — mhux bil-mod li jippreferi l-partner."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒါကို သိထားရင် ချစ်သူ ကိုယ်တိုင် အားပေးခံချင်တဲ့ပုံစံ မဟုတ်ဘဲ သင့်ကို မှန်ကန်တဲ့ပုံစံနဲ့ အားပေးနိုင်မှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når partneren din vet dette, kan du få støtte på din måte – ikke bare slik den andre selv ville ønsket det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो थाहा भए उहाँले तपाईंलाई सही तरिकाले साथ दिन सक्नुहुन्छ — आफूलाई चाहिने तरिकाले मात्र होइन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je partner dit weet, kan die je steunen zoals jij dat nodig hebt – niet zoals die zelf gesteund zou willen worden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudziwa izi kumawathandiza kukuthandizani m'njira yoyenera — osati mmene iwowo angafunire kuthandizidwa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kana beekuun deeggarsi siif kennamu karaa sirrii akka ta'u gargaara — akkaataa jaalallee keetiif tolu qofa osoo hin taane."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଜାଣିଲେ ସେମାନେ ଆପଣଙ୍କୁ ଠିକ୍ ଭାବରେ ସାହାଯ୍ୟ କରିପାରିବେ — କେବଳ ସେମାନଙ୍କ ନିଜ ପସନ୍ଦ ଅନୁସାରେ ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਜਾਣ ਕੇ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਤੁਹਾਡਾ ਸਾਥ ਸਹੀ ਢੰਗ ਨਾਲ ਦੇ ਸਕਦੇ ਹਨ — ਸਿਰਫ਼ ਉਸ ਢੰਗ ਨਾਲ ਨਹੀਂ ਜਿਵੇਂ ਉਹ ਖ਼ੁਦ ਸਾਥ ਚਾਹੁੰਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki temu druga połówka wesprze cię tak, jak tego potrzebujesz – a nie tak, jak sama by chciała."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په دې پوهېدل ستاسو له ملګري سره مرسته کوي چې ستاسو ملاتړ په سم ډول وکړي — نه یوازې هغسې چې پخپله یې غواړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber disso ajuda seu amor a apoiar você do jeito certo — e não só do jeito que gostaria de receber apoio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber isto ajuda o teu par a dar-te o apoio de que precisas — e não aquele que gostaria de receber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă știe asta, partenerul tău te poate sprijini cum ai tu nevoie — nu doar cum și-ar dori el să fie sprijinit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так партнёр поймёт, как поддержать именно тебя, а не так, как хотелось бы самому партнёру."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubimenya bimufasha kugushyigikira mu buryo bukwiye — atari uko we yakwifuza gushyigikirwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙය දැනගැනීමෙන් ඔබේ සහකරුට ඔබට ගැළපෙන විදිහට සහාය දෙන්න පුළුවන් — තමන්ට ඕනේ විදිහට විතරක් නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď to bude vedieť, môže ťa podporiť tak, ako potrebuješ ty – nielen tak, ako by to chcela ona."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tako te lahko partner podpre na pravi način – ne le tako, kot bi podporo želel zase."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuziva izvi kunomubatsira kukutsigira nenzira chaiyo — kwete nenzira yaangada kutsigirwa nayo iye."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan oo la ogaado waxay kaa caawinaysaa in si sax ah laguu taageero — ma aha sida lammaanahaagu jeclaan lahaa in loo taageero."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kur e di këtë, partneri yt mund të të mbështesë siç duhet – jo thjesht ashtu si do të donte vetë të mbështetej."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кад то зна, твоја половина може да те подржи на прави начин — а не онако како би сама волела подршку."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terang ieu ngabantos pasangan ngadukung anjeun kalayan cara anu pas — sanés ukur cara anu dipikahoyong ku anjeunna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Då kan din partner stötta dig på det sätt du behöver – inte bara på sitt eget sätt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujua hili kunamsaidia mwenzi wako akusaidie kwa njia sahihi — si kwa jinsi yeye angependa kusaidiwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதைத் தெரிந்துகொண்டால், உங்கள் துணை தனக்குப் பிடித்த விதத்தில் அல்ல, உங்களுக்குத் தேவையான விதத்தில் ஆதரவு தர முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది తెలిస్తే మీ భాగస్వామి మీకు సరైన విధంగా తోడుగా ఉండగలరు — వారికి కావాల్సిన విధంగా మాత్రమే కాదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Донистани ин ба ёрат кӯмак мекунад, ки туро дуруст дастгирӣ кунад — на он тавре, ки худаш мехоҳад дастгирӣ шавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรู้เรื่องนี้ช่วยให้คนรักดูแลคุณได้ถูกทาง ไม่ใช่แค่ในแบบที่ตัวเองอยากได้รับ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እዚ ምፍላጥ፣ ከምቲ ንሳቶም ዝደልይዎ ዘይኮነስ ከምቲ ንስኹም እትደልይዎ ክድግፉኹም ይሕግዝ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muny bilmek oňa seni dogry goldamaga kömek edýär — özi isleýşi ýaly däl-de, seniň isleýşiň ýaly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu bilmek, partnerinin sana kendi istediği gibi değil, senin ihtiyacın olan şekilde destek olmasını sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так половинка зможе підтримати тебе так, як потрібно саме тобі, а не так, як хотілося б їй."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ جان کر آپ کا ساتھی آپ کو صحیح طرح سہارا دے سکے گا — نہ کہ صرف اُس طرح جیسے اسے خود سہارا چاہیے ہوتا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buni bilsa, sherigingiz sizni toʻgʻri qoʻllab-quvvatlay oladi — oʻzi qanday qoʻllab-quvvatlanishni xohlasa, shunday emas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết điều này giúp người ấy nâng đỡ bạn đúng cách — chứ không chỉ theo cách người ấy muốn được nâng đỡ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukwazi oku kunceda iqabane lakho likuxhase ngendlela efanelekileyo — hayi nje ngendlela elinokuthanda ukuxhaswa ngayo lona."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mímọ èyí ń jẹ́ kí olólùfẹ́ yín lè tì yín lẹ́yìn lọ́nà tó yẹ — kì í ṣe bí òun fúnra rẹ̀ ṣe fẹ́ kí a tì òun lẹ́yìn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道這點，對方才能用你需要的方式支持你，而不只是用自己想被支持的方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道这一点，另一半才能用你需要的方式支持你，而不是用对方自己想要的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道這點，對方才能用你需要的方式支持你，而不只是用自己想被支持的方式。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukwazi lokhu kusiza umlingani wakho akweseke ngendlela efanele — hhayi nje ngendlela yena angathanda ukwesekwa ngayo."
          }
        }
      }
    },
    "Knowing when you're at your best matters for planning shared time — and giving each other space." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te weet wanneer jy op jou beste is, help om saamtyd te beplan – en om mekaar ruimte te gee."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምርጥ ጊዜዎ መቼ እንደሆነ ማወቅ የጋራ ጊዜን ለማቀድ ይረዳል — እርስ በርስ ቦታ ለመሰጣጠትም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة الوقت الذي تكونون فيه في أفضل حالاتكم تساعد على تنظيم الوقت المشترك، وعلى منح كل منكما مساحته."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি কেতিয়া আটাইতকৈ ভাল অৱস্থাত থাকে জানিলে একেলগে সময় কটোৱাৰ পৰিকল্পনাত সুবিধা হয় — আৰু ইজনে সিজনক নিজাকৈ সময় দিয়াতো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ən yaxşı halında olduğun vaxtı bilmək ortaq vaxtı planlaşdırmaq və bir-birinizə məkan vermək üçün önəmlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ведаеш, калі ты ў найлепшай форме, прасцей планаваць час разам — і даваць адно аднаму прастору."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да знаеш кога си в най-добрата си форма, помага да планирате общото време – и да си давате пространство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কখন তুমি সবচেয়ে ভালো থাকো, তা জানা থাকলে একসাথে সময়ের পরিকল্পনা করা যায় — আর একে অপরকে জায়গাও দেওয়া যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad znate kad ste u najboljoj formi, lakše planirate zajedničko vrijeme – i dajete jedno drugom prostora."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber quan estàs en el teu millor moment ajuda a planificar el temps compartit — i a donar-vos espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když víte, kdy je kdo v nejlepší formě, líp plánujete společný čas – a víte, kdy si dát prostor."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae gwybod pryd rwyt ti ar dy orau yn bwysig wrth gynllunio amser gyda'ch gilydd — ac wrth roi lle i'ch gilydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når I ved, hvornår I er bedst, er det lettere at planlægge tid sammen – og give hinanden plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu wissen, wann du in Bestform bist, hilft beim Planen gemeinsamer Zeit – und dabei, euch gegenseitig Raum zu lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να ξέρεις πότε είσαι στα καλύτερά σου βοηθά στον σχεδιασμό του κοινού σας χρόνου — και στο να δίνετε χώρο ο ένας στον άλλον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber cuándo das lo mejor de ti ayuda a planear el tiempo juntos y a darse espacio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui tead, millal oled oma parimas vormis, aitab see ühist aega planeerida — ja teineteisele ruumi anda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noiz zauden onenean jakiteak garrantzia du elkarrekin igarotzeko denbora antolatzeko — eta elkarri tartea emateko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دانستن اینکه کی در بهترین حالتت هستی، برای برنامه‌ریزی وقت مشترک — و فضا دادن به هم — مهم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tiedätte, milloin olette parhaimmillanne, on helpompi suunnitella yhteistä aikaa – ja antaa toisilleen tilaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahalagang alam mo kung kailan ka nasa pinakamaayos mong kondisyon para sa pagpaplano ng oras na magkasama — at sa pagbibigay ng espasyo sa isa’t isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savoir quand tu es au top aide à organiser vos moments à deux, et à vous laisser de l'espace."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má tá a fhios agaibh cathain is fearr atá sibh, is fusa am le chéile a phleanáil — agus spás a thabhairt dá chéile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber cando estás no teu mellor momento axuda a planificar o tempo xuntos e a darvos espazo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે ક્યારે સૌથી સારા ફોર્મમાં હો છો, એ જાણવું સાથેનો સમય પ્લાન કરવા માટે મહત્ત્વનું છે — અને એકબીજાને મોકળાશ આપવા માટે પણ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanin lokacin da kuka fi ƙwazo na da muhimmanci wajen tsara lokaci tare — da ba wa juna sarari."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשיודעים מתי כל אחד מכם בשיא, קל יותר לתכנן זמן משותף — וגם לתת זה לזה מרחב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप कब अपने सबसे अच्छे रूप में होते हैं, यह जानना साथ का वक़्त प्लान करने में — और एक-दूसरे को जगह देने में मदद करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad znaš kada si u najboljem izdanju, lakše je planirati zajedničko vrijeme – i dati jedno drugome prostora."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè ou konnen ki lè ou nan pi bon fòm ou, sa ede planifye tan ansanm — e bay youn lòt espas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha tudjátok, mikor vagytok a legjobb formában, könnyebb megtervezni a közös időt – és teret adni egymásnak."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Իմանալը, թե երբ ես քո լավագույն վիճակում, կարևոր է միասին ժամանակ պլանավորելու — և միմյանց տարածք տալու համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu kapan kamu dalam kondisi terbaik itu penting untuk merencanakan waktu bersama — dan memberi ruang satu sama lain."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịma mgbe ị kacha dị mma dị mkpa maka ịhazi oge unu ga-anọkọ — na inye ibe unu oghere."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að vita hvenær þú ert upp á þitt besta hjálpar ykkur að skipuleggja samverustundir – og gefa hvort öðru rými."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapere quando dai il meglio aiuta a organizzare il tempo insieme — e a lasciarvi i vostri spazi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん調子がいい時間帯を知っておくと、ふたりの時間もお互いのひとりの時間も計画しやすくなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngerti kapan panjenengan lagi paling apik iku wigati kanggo nata wektu bareng — lan kanggo menehi ruang siji lan sijine."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იმის ცოდნა, როდის ხარ საუკეთესო ფორმაში, საერთო დროის დაგეგმვაში გეხმარება — და ერთმანეთისთვის სივრცის დატოვებაშიც."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қай кезде ең жақсы күйде болатыныңды білу бірге уақыт жоспарлауға — әрі бір-біріңе еркіндік беруге көмектеседі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការដឹងថាពេលណាអ្នកស្ថិតក្នុងសភាពល្អបំផុត សំខាន់សម្រាប់ការរៀបចំពេលវេលារួម — និងការទុកចន្លោះឲ្យគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಯಾವಾಗ ಅತ್ಯುತ್ತಮವಾಗಿರುತ್ತೀರಿ ಎಂದು ತಿಳಿದರೆ ಜೊತೆಯ ಸಮಯವನ್ನು ಯೋಜಿಸಲು — ಮತ್ತು ಒಬ್ಬರಿಗೊಬ್ಬರು ಅವಕಾಶ ಕೊಡಲು — ಸಹಾಯವಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 가장 빛나는 때를 알면, 함께할 시간을 계획하고 서로에게 여유를 주기도 쉬워요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanîna kengê tu di rewşa xwe ya herî baş de yî, ji bo plankirina dema hevpar girîng e — û ji bo dayîna cih bi hev."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качан эң жакшы абалда экениңди билүү бирге убакытты пландоо үчүн маанилүү — бири-бириңе мейкиндик берүү үчүн да."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze wëssen, wéini s du am beschte drop bass, hëlleft beim Plange vu gemeinsamer Zäit — an doranner, eneen Raum ze loossen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຮູ້ວ່າເຈົ້າຢູ່ໃນຊ່ວງທີ່ດີທີ່ສຸດຕອນໃດ ສຳຄັນຕໍ່ການວາງແຜນເວລາຮ່ວມກັນ — ແລະ ການໃຫ້ພື້ນທີ່ແກ່ກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žinant, kada esi geriausios formos, lengviau planuoti bendrą laiką – ir duoti vienas kitam erdvės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinot, kad tu esi labākajā formā, ir vieglāk plānot kopīgo laiku – un dot viens otram telpu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fahafantarana ny fotoana tsara indrindra aminao dia manan-danja amin'ny fandaminana ny fotoana iarahana — sy ny fifanomezana malalaka."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te mōhio ki te wā e tino pai ai koe, ka māmā ake te whakarite wā tahi — me te hoatu wā ki a kōrua anō."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кога знаеш кога си во најдобра форма, полесно го планирате заедничкото време — и си давате простор еден на друг."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ഏറ്റവും നല്ല നിലയിൽ ഇരിക്കുന്നത് എപ്പോഴാണെന്ന് അറിയുന്നത്, ഒരുമിച്ചുള്ള സമയം പ്ലാൻ ചെയ്യാനും പരസ്പരം ഇടം നൽകാനും സഹായിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэзээ хамгийн сайн байдгаа мэдэх нь хамтын цагаа төлөвлөх, бие биедээ зай өгөхөд чухал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही सर्वात उत्तम स्थितीत कधी असता हे माहीत असणे, एकत्र वेळ आखण्यासाठी — आणि एकमेकांना जागा देण्यासाठी — महत्त्वाचे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengetahui bila anda berada pada tahap terbaik penting untuk merancang masa bersama — dan memberi ruang kepada satu sama lain."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li tkun taf meta tkun fl-aqwa tiegħek jgħin biex tippjanaw il-ħin flimkien — u biex tagħtu spazju lil xulxin."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ် ဘယ်အချိန်မှာ အကောင်းဆုံးလဲ သိထားတာက အတူရှိချိန်ကို စီစဉ်ဖို့နဲ့ တစ်ယောက်ကိုတစ်ယောက် နေရာပေးဖို့ အရေးကြီးတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å vite når du er på ditt beste, hjelper dere å planlegge tid sammen – og gi hverandre rom."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं कहिले आफ्नो सबैभन्दा राम्रो अवस्थामा हुनुहुन्छ भन्ने थाहा हुनु सँगैको समयको योजना बनाउन — र एकअर्कालाई ठाउँ दिन — महत्त्वपूर्ण छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weten wanneer je op je best bent helpt bij het plannen van tijd samen – en bij elkaar ruimte geven."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudziwa nthawi yomwe muli bwino kwambiri nkofunika pokonza nthawi yanu limodzi — ndi kupatsana mpata."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo ati caalaatti gaarii taatu beekuun yeroo waliinii karoorsuuf — akkasumas walii iddoo kennuuf — barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ କେବେ ସବୁଠୁ ଭଲ ଅବସ୍ଥାରେ ଥାଆନ୍ତି ଜାଣିଲେ ଏକାଠି ସମୟ ଯୋଜନା କରିବା — ଆଉ ପରସ୍ପରକୁ ସ୍ଥାନ ଦେବା — ସହଜ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਜਾਣਨਾ ਕਿ ਤੁਸੀਂ ਕਦੋਂ ਸਭ ਤੋਂ ਵਧੀਆ ਰੌਂ ਵਿੱਚ ਹੁੰਦੇ ਹੋ, ਸਾਂਝੇ ਸਮੇਂ ਦੀ ਯੋਜਨਾ ਬਣਾਉਣ — ਅਤੇ ਇੱਕ-ਦੂਜੇ ਨੂੰ ਥਾਂ ਦੇਣ — ਲਈ ਅਹਿਮ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedza o tym, kiedy jesteś w najlepszej formie, pomaga planować wspólny czas – i dawać sobie nawzajem przestrzeń."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا پوهېدل چې تاسو کله په خپل غوره حالت کې یاست، د ګډ وخت د پلان او یو بل ته د ځای ورکولو لپاره مهم دي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber quando você está no seu melhor ajuda a planejar o tempo a dois — e a dar espaço um ao outro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber quando estás no teu melhor ajuda a planear o tempo a dois — e a dar espaço a cada um."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să știi când dai ce e mai bun din tine contează când plănuiți timpul împreună — și spațiul fiecăruia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда знаешь, в какое время ты в лучшей форме, проще планировать время вместе — и давать друг другу пространство."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumenya igihe uba umeze neza kurusha ibindi bifasha gutegura igihe musangiye — no guhana umwanya."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ හොඳම තත්ත්වයෙන් ඉන්නේ කවදාද කියලා දැනගැනීම එක්ව ගත කරන කාලය සැලසුම් කරන්නත් — එකිනෙකාට ඉඩ දෙන්නත් වැදගත්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď viete, kedy ste vo forme, ľahšie si naplánujete spoločný čas – aj priestor jeden pre druhého."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko veš, kdaj si v najboljši formi, lažje načrtujeta skupni čas – in si dajeta prostor."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuziva kuti unenge wakasimba rini kunokosha pakuronga nguva yamunogovana — uye pakupana nzvimbo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogaanshaha goorta aad ugu fiican tahay ayaa muhiim u ah qorsheynta waqtiga la wadaago — iyo inaad isa siisaan meel."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kur e di kur je në formën më të mirë, ndihmon për të planifikuar kohën bashkë – dhe për t’i dhënë hapësirë njëri-tjetrit."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кад знате када сте у најбољем издању, лакше планирате заједничко време — и дајете једно другом простора."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terang iraha anjeun dina kaayaan pangsaéna penting kanggo ngarencanakeun waktos babarengan — sareng silih masihan rohangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att veta när ni är som bäst hjälper er att planera tid tillsammans – och att ge varandra utrymme."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujua ni lini uko katika ubora wako ni muhimu kwa kupanga muda wa pamoja — na kupeana nafasi."
