        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị dị njikere maka mgbanwe mana n'ime omenala ị maara. Ị chọrọ mmalite ọhụrụ n'enweghị nchegbu nke ịkwaga kpamkpam."
