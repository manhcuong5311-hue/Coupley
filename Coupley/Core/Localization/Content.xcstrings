        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nandiyan pa rin ’yan. Natabunan lang ng buhay. Baka ang partner na mahilig magrekomenda ng libro ang tulak na kailangan mo."
