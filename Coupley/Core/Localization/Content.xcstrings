        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መጀመሪያ የደህንነት መረብ። ይህ ጥንዶች አንዳቸው ለሌላው ከሚያደርጉት በጣም የፍቅር ተግባር አንዱ ነው — የገንዘብ ጭንቀትን ማስወገድ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبكة الأمان أولًا. التخلّص من القلق المالي من أصدق أشكال الحب التي يمكن أن يقدّمها الشريكان أحدهما للآخر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ৰথমে সুৰক্ষা। আৰ্থিক উদ্বেগ আঁতৰোৱাটো এটা যুগলে ইজনে সিজনৰ বাবে কৰিব পৰা আটাইতকৈ মৰমৰ কামবোৰৰ এটা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əvvəlcə təhlükəsizlik yastığı. Bu, cütlüyün bir-biri üçün edə biləcəyi ən sevgi dolu işlərdən biridir — maliyyə narahatlığını aradan qaldırmaq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спачатку падушка бяспекі. Гэта адзін з самых клапатлівых учынкаў, якія пара можа зрабіць адно для аднаго, — пазбавіцца трывогі за грошы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първо предпазна мрежа. Това е едно от най-грижовните неща, които двойка може да направи един за друг – да махне финансовата тревога."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগে নিরাপত্তার জাল। আর্থিক দুশ্চিন্তা দূর করা — একটা জুটি একে অপরের জন্য যা করতে পারে, তার মধ্যে এটা সবচেয়ে ভালোবাসার কাজগুলোর একটা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo sigurnosna mreža. Ovo je jedna od stvari koje par iz ljubavi može uraditi jedno za drugo – skinuti finansijsku brigu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer, la xarxa de seguretat. És una de les maneres més boniques de cuidar-vos — treure-us de sobre l'angoixa pels diners."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív záchranná síť. Zbavit se finanční úzkosti je jedna z nejláskyplnějších věcí, které pro sebe pár může udělat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhwyd ddiogelwch yn gyntaf. Dyma un o'r pethau mwyaf cariadus y gall cwpl ei wneud i'w gilydd — cael gwared ar bryder ariannol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedsnettet først. At fjerne økonomisk bekymring er noget af det mest kærlige, et par kan gøre for hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst das Sicherheitsnetz. Eine der liebevollsten Sachen, die ein Paar füreinander tun kann – Geldsorgen aus dem Weg räumen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρώτα το δίχτυ ασφαλείας. Είναι από τα πιο τρυφερά πράγματα που μπορεί να κάνει ένα ζευγάρι ο ένας για τον άλλον — να διώξει το οικονομικό άγχος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero, la red de seguridad. Quitarse la ansiedad económica es una de las cosas más amorosas que una pareja puede hacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõigepealt turvavõrk. See on üks hoolivamaid asju, mida paar teineteise heaks teha saab — rahamure eemaldamine."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehenik segurtasun-sarea. Bikote batek elkarri egin diezaiokeen gauzarik maitekorrenetako bat da — diru-antsietatea kentzea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اول تور ایمنی. این یکی از عاشقانه‌ترین کارهایی است که یک زوج می‌تواند برای هم بکند — برداشتن نگرانی مالی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvaverkko ensin. Tämä on yksi rakastavimmista asioista, joita pari voi tehdä toisilleen – rahahuolten poistaminen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety net muna. Isa ito sa pinakamapagmahal na magagawa ng magkapareha para sa isa’t isa — ang alisin ang pag-aalala sa pera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filet de sécurité d'abord. C'est l'un des plus beaux cadeaux qu'un couple puisse se faire : se libérer de l'angoisse financière."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líon sábhála ar dtús. Tá sé seo ar cheann de na rudaí is grámhaire is féidir le lánúin a dhéanamh dá chéile — imní airgid a bhaint as an áireamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro, a rede de seguridade. É unha das cousas máis amorosas que unha parella pode facer: quitar a ansiedade económica."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પહેલાં સલામતીની જાળ. પૈસાની ચિંતા દૂર કરવી — કપલ એકબીજા માટે કરી શકે એવી આ સૌથી પ્રેમભરી વાતોમાંની એક છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsaro da farko. Wannan na ɗaya daga cikin abubuwan ƙauna da masoya za su iya yi wa juna — kawar da damuwar kuɗi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודם רשת ביטחון. זו אחת המחוות הכי אוהבות שזוג יכול לתת זה לזה — להסיר את הדאגה הכלכלית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले सुरक्षा कवच। पैसों की चिंता दूर करना — यह उन सबसे प्यार भरे कामों में से एक है जो एक जोड़ा एक-दूसरे के लिए कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo sigurnosna mreža. Ovo je jedna od najbrižnijih stvari koje par može učiniti jedno za drugo – uklanja financijsku tjeskobu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filè sekirite anvan. Se youn nan pi bèl bagay yon koup ka fè youn pou lòt — retire enkyetid lajan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először a biztonsági háló. Ez az egyik legszeretetteljesebb dolog, amit egy pár egymásért tehet – elvenni a pénzügyi szorongást."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նախ՝ անվտանգության բարձիկը։ Սա ամենասիրառատ բաներից մեկն է, որ զույգը կարող է անել միմյանց համար՝ վերացնել ֆինանսական անհանգստությունը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring pengaman dulu. Ini salah satu bentuk kasih sayang terbesar yang bisa kalian berikan satu sama lain — menghapus kecemasan soal uang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nchekwa na-ebu ụzọ. Nke a bụ otu n'ime ihe ịhụnanya kacha ukwuu unu abụọ nwere ike imere ibe unu — iwepụ nchegbu ego."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öryggisnetið fyrst. Þetta er eitt það kærleiksríkasta sem par getur gert fyrir hvort annað – að losa sig við fjárhagsáhyggjur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima la rete di sicurezza. È uno dei gesti più amorevoli che una coppia possa fare: togliersi a vicenda l’ansia per i soldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずは安全網から。お金の不安を取り除くことは、ふたりがお互いにできる最も愛情深いことのひとつです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring pengaman dhisik. Iki salah siji bab paling nresnani sing bisa dilakoni pasangan kanggo siji lan sijine — ngilangi kuwatir bab dhuwit."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჯერ უსაფრთხოების ბადე. ეს ერთ-ერთი ყველაზე მზრუნველი რამაა, რაც წყვილს ერთმანეთისთვის შეუძლია — ფინანსური შფოთვის მოშორება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алдымен қауіпсіздік жастығы. Бұл — жұптың бір-біріне жасай алатын ең мейірімді істерінің бірі: қаржылық уайымды жою."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សំណាញ់សុវត្ថិភាពមុនគេ។ នេះជារឿងមួយដែលបង្ហាញក្ដីស្រឡាញ់បំផុតដែលគូស្នេហ៍អាចធ្វើឲ្យគ្នា — គឺដកការព្រួយបារម្ភពីលុយកាក់ចេញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೊದಲು ಸುರಕ್ಷತೆಯ ಬಲೆ. ಹಣಕಾಸಿನ ಆತಂಕವನ್ನು ದೂರ ಮಾಡುವುದು — ಒಂದು ಜೋಡಿ ಒಬ್ಬರಿಗೊಬ್ಬರು ಮಾಡಬಹುದಾದ ಅತ್ಯಂತ ಪ್ರೀತಿಯ ಕೆಲಸಗಳಲ್ಲಿ ಇದು ಒಂದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전망이 먼저예요. 돈 걱정을 덜어 주는 건 커플이 서로에게 해 줄 수 있는 가장 다정한 일 중 하나예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêşî tora ewlehiyê. Ev yek ji tiştên herî bi evîn e ku cotek dikare ji bo hev bike — rakirina fikarên darayî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адегенде коопсуздук жаздыгы. Бул жуптун бири-бирине кыла турган эң мээримдүү иштеринин бири — каржылык тынчсыздыкты алып салуу."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir d'éischt e Sécherheetsnetz. Dat ass eng vun de léifste Saachen, déi eng Koppel fireneen ka maachen — d'Geldsuergen ewechhuelen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຕາໜ່າງຄວາມປອດໄພມາກ່ອນ ນີ້ຄືໜຶ່ງໃນສິ່ງທີ່ຄູ່ຮັກເຮັດໃຫ້ກັນໄດ້ຢ່າງເປັນຫ່ວງເປັນໃຍທີ່ສຸດ — ການຂະຈັດຄວາມກັງວົນເລື່ອງເງິນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirmiausia apsauga. Tai vienas mieliausių dalykų, kuriuos pora gali padaryti vienas kitam, – nuimti finansinį nerimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vispirms drošības spilvens. Tā ir viena no gādīgākajām lietām, ko pāris var izdarīt viens otra labā, – atbrīvoties no finanšu trauksmes."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiarovana aloha. Iray amin'ireo zavatra feno fitiavana indrindra azon'ny mpifankatia atao ho an'ny tsirairay izany — manala ny ahiahy ara-bola."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te kupenga haumaru i te tuatahi. Ko tēnei tētahi o ngā mahi aroha nui rawa ka taea e te tokorua mō rāua anō — te tango i te māharahara moni."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прво сигурносна мрежа. Ова е едно од најљубовните нешта што двојката може да ги направи едно за друго — да ја тргне финансиската грижа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആദ്യം ഒരു സുരക്ഷാവല. സാമ്പത്തിക ആശങ്ക ഇല്ലാതാക്കുക എന്നത് ഒരു ജോഡിക്ക് പരസ്പരം ചെയ്യാവുന്ന ഏറ്റവും സ്നേഹമുള്ള കാര്യങ്ങളിൽ ഒന്നാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эхлээд аюулгүйн дэр. Санхүүгийн түгшүүрийг арилгах нь хосын бие биедээ хийж чадах хамгийн хайртай үйлсийн нэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आधी सुरक्षाकवच. आर्थिक चिंता दूर करणे — जोडपे एकमेकांसाठी करू शकेल अशा सर्वात प्रेमळ गोष्टींपैकी ही एक आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring keselamatan dulu. Ini salah satu perkara paling penyayang yang boleh dilakukan oleh pasangan untuk satu sama lain — menghilangkan kebimbangan kewangan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ewwel ix-xibka tas-sigurtà. Din hija waħda mill-aktar affarijiet ta' mħabba li koppja tista' tagħmel għal xulxin — tneħħi l-ansjetà finanzjarja."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အရံအကာ အရင်။ ငွေကြေးစိုးရိမ်မှုကို ဖယ်ရှားပေးတာက စုံတွဲတစ်တွဲ တစ်ယောက်ကိုတစ်ယောက် လုပ်ပေးနိုင်တဲ့ အချစ်အရှိဆုံး အရာတွေထဲက တစ်ခုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetsnett først. Å fjerne økonomisk uro er noe av det mest kjærlige et par kan gjøre for hverandre."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहिले सुरक्षा जाल। आर्थिक चिन्ता हटाउनु जोडीले एकअर्काका लागि गर्न सक्ने सबैभन्दा मायालु कामहरूमध्ये एक हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst een vangnet. Financiële zorgen wegnemen is een van de liefdevolste dingen die een stel voor elkaar kan doen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chitetezo choyamba. Ichi ndi chimodzi mwa zinthu zachikondi kwambiri zomwe inu awiri mungachitirane — kuchotsa nkhawa ya ndalama."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura gabatee nageenyaa. Kun waan jaalallee lamaan walii godhuu danda'an keessaa isa jaalalaan guutame tokko dha — yaaddoo maallaqaa balleessuu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଗେ ସୁରକ୍ଷା ଜାଲ। ଆର୍ଥିକ ଚିନ୍ତା ଦୂର କରିବା — ଯୁଗଳ ପରସ୍ପର ପାଇଁ କରିପାରୁଥିବା ସବୁଠୁ ସ୍ନେହପୂର୍ଣ୍ଣ କାମ ମଧ୍ୟରୁ ଏହା ଗୋଟିଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਹਿਲਾਂ ਸੁਰੱਖਿਆ ਦਾ ਜਾਲ। ਪੈਸੇ ਦੀ ਚਿੰਤਾ ਦੂਰ ਕਰਨਾ ਉਨ੍ਹਾਂ ਸਭ ਤੋਂ ਪਿਆਰ ਭਰੀਆਂ ਗੱਲਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ ਜੋ ਜੋੜਾ ਇੱਕ-ਦੂਜੇ ਲਈ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw siatka bezpieczeństwa. Zdjęcie z siebie nawzajem lęku o pieniądze to jedna z najczulszych rzeczy, jakie para może dla siebie zrobić."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لومړی د خوندیتوب جال. دا یو له هغو تر ټولو مینه‌ناکو کارونو دی چې یوه جوړه یې د یو بل لپاره کولی شي — د مالي اندېښنې لرې کول."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro a rede de segurança. É uma das coisas mais amorosas que um casal pode fazer um pelo outro — tirar a ansiedade financeira da equação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro a rede de segurança. É uma das coisas mais amorosas que um casal pode fazer — tirar a ansiedade financeira da equação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întâi plasa de siguranță. E unul dintre cele mai frumoase lucruri pe care și le pot oferi doi parteneri — scăparea de grijile financiare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала страховка. Избавить друг друга от тревоги о деньгах — одно из самых заботливых дел, на которые способна пара."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubwirinzi mbere. Iki ni kimwe mu bintu byuje urukundo abakundana bakorerana — kuvanaho impungenge z'amafaranga."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මුලින්ම ආරක්ෂක දැල. මූල්‍ය කනස්සල්ල ඉවත් කිරීම යුවළකට එකිනෙකා වෙනුවෙන් කරන්න පුළුවන් වඩාත්ම ආදරණීය දේවල්වලින් එකක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv záchranná sieť. Je to jedna z najláskavejších vecí, ktoré pre seba pár môže urobiť – zbaviť sa finančnej úzkosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej varnostna mreža. To je ena najbolj ljubečih stvari, ki jih par lahko naredi drug za drugega – odstrani finančno tesnobo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chekudzivirira kutanga. Ichi ndechimwe chezvinhu zvine rudo zvakanyanya zvingaitirana vadiwa vaviri — kubvisa kunetseka nezvemari."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shabag badbaado marka hore. Tani waa mid ka mid ah waxyaabaha ugu jacaylka badan ee lammaane is siin karo — walwalka lacagta oo meesha laga saaro."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fillimisht rrjeti i sigurisë. Kjo është një nga gjërat më të dashura që një çift mund të bëjë për njëri-tjetrin – heqja e ankthit financiar."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прво сигурносна мрежа. Ово је једна од најнежнијих ствари које пар може да уради једно за друго — скинути финансијску бригу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaring pangaman heula. Ieu salah sahiji hal anu paling nyaah anu tiasa dilakukeun ku pasangan pikeun silih — ngaleungitkeun kahariwang kauangan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyddsnätet först. Att ta bort ekonomisk oro är något av det mest kärleksfulla ett par kan göra för varandra."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinga kwanza. Hili ni mojawapo ya mambo ya upendo zaidi ambayo wenzi wanaweza kufanyiana — kuondoa wasiwasi wa kifedha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முதலில் பாதுகாப்பு வலை. நிதிக் கவலையை நீக்குவது, ஒரு ஜோடி ஒருவருக்கொருவர் செய்யக்கூடிய மிக அன்பான விஷயங்களில் ஒன்று."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ముందు భద్రత. ఆర్థిక ఆందోళనను తొలగించడం — ఒక జంట ఒకరికొకరు చేయగల అత్యంత ప్రేమపూర్వకమైన పనుల్లో ఇది ఒకటి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аввал шабакаи бехатарӣ. Ин яке аз пурмеҳртарин корҳоест, ки ҷуфт барои ҳамдигар карда метавонад — дур кардани ташвиши пулӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีตาข่ายรองรับไว้ก่อน นี่คือหนึ่งในสิ่งที่แสดงความรักที่สุดที่คู่รักทำให้กันได้ คือการขจัดความกังวลเรื่องเงิน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅድም መከላኸሊ። ፋይናንሳዊ ጭንቀት ምእላይ ሓደ ካብቶም ጽምዲ ንሓድሕዱ ዝገብሮም ዝበለጹ ናይ ፍቕሪ ተግባራት እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilki howpsuzlyk ýassygy. Bu jübütiň biri-biri üçin edip biljek iň mähirli zatlarynyň biri — maddy aladany aýyrmak."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce güvenlik ağı. Maddi kaygıyı ortadan kaldırmak, bir çiftin birbiri için yapabileceği en sevgi dolu şeylerden biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу — запас міцності. Позбавити одне одного фінансової тривоги — один із найтурботливіших кроків для пари."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے حفاظتی جال۔ مالی پریشانی دور کرنا ان سب سے محبت بھرے کاموں میں سے ہے جو ایک جوڑا ایک دوسرے کے لیے کر سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avval xavfsizlik yostigʻi. Bu juftlik bir-biri uchun qila oladigan eng mehrli ishlardan biri — moliyaviy xavotirni yoʻqotish."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưới an toàn trước đã. Đây là một trong những điều yêu thương nhất hai người có thể làm cho nhau — gỡ bỏ nỗi lo tiền bạc."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhuseleko kuqala. Le yenye yezona zinto zothando isibini esinokuzenzelana zona — ukususa uxinzelelo lwemali."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ààbò lákọ̀ọ́kọ́. Èyí jẹ́ ọ̀kan lára àwọn ohun ìfẹ́ jù tí olólùfẹ́ méjì lè ṣe fún ara wọn — mímú àníyàn owó kúrò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先有安全網。消除金錢上的焦慮，是兩人能為彼此做的最有愛的事之一。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先有安全网。帮彼此卸下经济上的焦虑，是情侣能为对方做的最有爱的事之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先有安全網。消除金錢焦慮，是兩人能為彼此做的最有愛的事之一。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inethi yokuphepha kuqala. Lena ngenye yezinto ezinothando kakhulu umbhangqwana ongazenzela zona — ukususa ukukhathazeka ngemali."
          }
        }
      }
    },
