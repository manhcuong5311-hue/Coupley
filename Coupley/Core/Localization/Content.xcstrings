        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պարբերական ջանք՝ ամենօրյա խնամքի փոխարեն։ Եթե սպասումները համընկնում են, սա լավ է աշխատում։"
