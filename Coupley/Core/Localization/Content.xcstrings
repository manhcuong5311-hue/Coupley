        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी पसंद की चाय या खाना बनाएँ। उनके पास रख दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Főzz neki teát vagy valamit, amit szeret. Tedd a keze ügyébe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
