    "Contentment at low energy just wants company, not stimulation." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرضا مع طاقة منخفضة يريد رفقة، لا إثارة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klidná spokojenost bez energie chce společnost, ne podněty."
