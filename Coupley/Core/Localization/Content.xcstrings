        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा लचीलापन — या सच्ची अनिश्चितता। जो भी हो, आप पर किसी एक जगह का बंधन नहीं है, और यह एक असली आज़ादी है।"
