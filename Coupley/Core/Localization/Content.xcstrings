          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな仕事でもできるとしたら、何をしたいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 일이든 할 수 있다면, 뭘 하고 싶어요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika boleh buat apa saja sebagai kerja, apa pilihan anda?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du kunne jobbe med hva som helst, hva ville det vært?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
