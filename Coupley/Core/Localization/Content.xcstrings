        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምቹእ ስቕታን ብዘይ መደብን። ምስ ሓደ ሰብ ከምዚ ዝበለ ቅሳነት ሓቀኛ ምልክት ቅርበት እዩ።"
