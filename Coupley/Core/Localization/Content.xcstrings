    "Action alongside words proves it's real. Saying sorry while doing something kind shows they mean it." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dade saam met woorde bewys dis eg. Om jammer te sê terwyl jy iets gaafs doen, wys jy bedoel dit."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከቃላት ጋር የሚሄድ ተግባር እውነት መሆኑን ያረጋግጣል። ይቅርታ እያሉ ደግ ነገር ማድረግ ከልብ መሆኑን ያሳያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفعل مع الكلمات يُثبت الصدق. قول «آسف» مع لفتة لطيفة يُظهر أن شريكك يعني ما يقول."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দৰ লগত কামে প্ৰমাণ কৰে যে ই সঁচা। ক্ষমা বিচৰাৰ লগতে কিবা মৰমৰ কাম কৰিলে বুজা যায় যে সংগীয়ে মনৰ পৰাই কৈছে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlərin yanında edilən əməl bunun həqiqi olduğunu sübut edir. Üzr istəyib xoş bir şey etmək onun ciddi olduğunu göstərir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учынак разам са словамі даказвае, што ўсё па-сапраўднаму. Калі «прабач» гучыць разам з добрай справай, відаць, што гэта шчыра."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действието до думите доказва, че е истинско. Извинение, придружено с мил жест, показва, че е от сърце."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথার পাশাপাশি কাজ প্রমাণ করে যে এটা সত্যি। দুঃখিত বলার সাথে ভালো কিছু করলে বোঝা যায় ও মন থেকেই বলছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djelo uz riječi dokazuje da je iskreno. Izvinjenje uz nešto lijepo pokazuje da se to ozbiljno misli."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els fets al costat de les paraules ho fan real. Demanar perdó amb un gest amable demostra que ho diu de debò."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čin spolu se slovy dokazuje, že je to myšleno vážně. Omluva doprovázená něčím laskavým ukazuje, že je upřímná."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae gweithredu ochr yn ochr â geiriau'n profi ei fod yn go iawn. Mae dweud sori wrth wneud rhywbeth caredig yn dangos bod dy bartner o ddifri."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling sammen med ord beviser, at det er ægte. At sige undskyld og samtidig gøre noget sødt viser, at det er ment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taten zu den Worten beweisen, dass es echt ist. Sich zu entschuldigen und dabei etwas Liebes zu tun, zeigt, dass es ernst gemeint ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πράξη δίπλα στα λόγια αποδεικνύει ότι είναι αληθινό. Μια συγγνώμη μαζί με κάτι καλό δείχνει ότι το εννοεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hechos junto a las palabras demuestran que es de verdad. Pedir perdón con un gesto amable muestra que lo dicen en serio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teod koos sõnadega tõestavad, et see on päris. Vabandus koos heateoga näitab, et ta mõtleb seda tõsiselt."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitzekin batera egindako ekintzak frogatzen du benetakoa dela. Barkamena eskatu eta zerbait atsegina egiteak erakusten du benetan esaten duela."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل در کنار حرف ثابت می‌کند واقعی است. عذرخواهی همراه با یک کار مهربان نشان می‌دهد از ته دل است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teot sanojen rinnalla todistavat, että se on totta. Anteeksipyyntö yhdessä ystävällisen teon kanssa näyttää, että toinen tarkoittaa sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napapatunayan ng gawa kasabay ng salita na totoo ito. Kapag nag-sorry siya habang may ginagawang mabuti, ramdam mong seryoso siya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des actes en plus des mots prouvent que c'est sincère. S'excuser en faisant quelque chose de gentil montre qu'on le pense vraiment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruthaíonn gníomh in éineacht le focail gur fíor é. Nuair a ghabhtar leithscéal agus rud cineálta á dhéanamh, léiríonn sé go bhfuil sé i gceist."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os feitos xunto ás palabras demostran que vai en serio. Pedir perdón mentres fai algo bonito amosa que o sente de verdade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શબ્દો સાથેનું કામ સાબિત કરે છે કે એ સાચું છે. સૉરી કહેતાં કંઈક સારું કરવું બતાવે છે કે તેઓ દિલથી કહે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiki tare da kalmomi na tabbatar da gaskiya. Neman gafara tare da yin wani abin kirki na nuna cewa da gaske ake yi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעשה לצד המילים מוכיח שזה אמיתי. סליחה יחד עם משהו טוב מראה שהכוונה רצינית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों के साथ किया गया काम साबित करता है कि बात सच्ची है। सॉरी कहते हुए कुछ अच्छा करना दिखाता है कि पार्टनर दिल से कह रहे हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djelo uz riječi dokazuje da je iskreno. Isprika praćena nečim lijepim pokazuje da je ozbiljna."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksyon ak pawòl ansanm pwouve se vre. Di “Padon” pandan y ap fè yon bagay janti montre yo vle di l."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szavak mellett a tettek bizonyítják, hogy őszinte. Ha a bocsánatkérés mellé valami kedveset is tesz, látod, hogy komolyan gondolja."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խոսքերին ուղեկցող արարքն ապացուցում է, որ դա իրական է։ Ներողություն խնդրելն ու միաժամանակ ինչ-որ բարի բան անելը ցույց է տալիս, որ զուգընկերդ լուրջ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan yang menyertai kata-kata membuktikan ketulusannya. Minta maaf sambil melakukan hal baik menunjukkan dia sungguh-sungguh."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omume ya na okwu na-egosi na ọ bụ eziokwu. Ịrịọ mgbaghara ma mee ihe ọma na-egosi na o si ya n'obi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verk ásamt orðum sanna að þetta er einlægt. Að biðjast afsökunar og gera um leið eitthvað fallegt sýnir að hugur fylgir máli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni accanto alle parole dimostrano che è vero. Chiedere scusa mentre si fa qualcosa di gentile mostra che lo si pensa davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉に行動が伴ってこそ本物。謝りながら何かやさしいことをしてくれると、本気だと伝わります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumindak sing ngiringi tembung mbuktekake yen kuwi temenan. Njaluk ngapura karo nglakoni bab sing apik nuduhake yen pancen saka ati."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიტყვასთან ერთად საქმე ამტკიცებს, რომ ეს ნამდვილია. ბოდიში და თან რამე კეთილი ჟესტი აჩვენებს, რომ გულით ამბობენ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөзбен қатар жасалған іс оның шын екенін дәлелдейді. Кешірім сұрап, бір жақсылық жасау — шын ниетін көрсетеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សកម្មភាពរួមជាមួយពាក្យសម្ដី បញ្ជាក់ថាវាពិត។ ការសុំទោសព្រមទាំងធ្វើអ្វីមួយល្អៗ បង្ហាញថាគាត់ស្មោះមែន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತಿನ ಜೊತೆಗಿನ ಕೃತಿ ಅದು ನಿಜ ಎಂದು ಸಾಬೀತುಪಡಿಸುತ್ತದೆ. ಕ್ಷಮೆ ಕೇಳುತ್ತಾ ಏನಾದರೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದರೆ ಅವರು ಮನಸಾರೆ ಹೇಳುತ್ತಿದ್ದಾರೆ ಎಂದು ತಿಳಿಯುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말에 행동이 더해져야 진심이 느껴져요. 미안하다고 하면서 다정한 무언가를 해 주면 진심이라는 게 전해지죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirin digel gotinan nîşan dide ku rast e. Gotina “bibore” digel kirina tiştekî xweş nîşan dide ku ew ji dil e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөз менен кошо иш анын чын экенин далилдейт. Кечирим сурап, жанынан бир жакшылык кылса, чын дилден айтканы көрүнөт."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlungen nieft de Wierder beweisen, datt et echt ass. Pardon soen an dobäi eppes Léifes maachen weist, datt et eescht gemengt ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການກະທຳຄຽງຄູ່ກັບຄຳເວົ້າພິສູດວ່າມັນເປັນເລື່ອງຈິງ ການຂໍໂທດພ້ອມເຮັດສິ່ງດີໆໃຫ້ ສະແດງວ່າຄູ່ໝາຍຄວາມແທ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veiksmai šalia žodžių įrodo, kad tai tikra. Atsiprašymas kartu su geru darbu parodo, kad tai nuoširdu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbi kopā ar vārdiem pierāda, ka tas ir pa īstam. Atvainoties un vienlaikus izdarīt ko labu – tā otrā puse parāda, ka domā to nopietni."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny asa miaraka amin'ny teny no manaporofo fa marina izany. Ny miala tsiny sady manao zavatra tsara dia mampiseho fa tena izy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te mahi i te taha o te kupu e kitea ai he pono. Ko te whakapāha me te mahi atawhai e whakaatu ana he tika tāna."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дело покрај зборовите докажува дека е вистинско. „Извини“ проследено со нешто убаво покажува дека е искрено."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാക്കുകൾക്കൊപ്പമുള്ള പ്രവൃത്തി അത് സത്യമാണെന്ന് തെളിയിക്കുന്നു. സോറി പറയുമ്പോൾ നല്ലൊരു കാര്യം കൂടി ചെയ്യുന്നത്, പങ്കാളി അത് ഉള്ളിൽത്തട്ടി പറയുന്നതാണെന്ന് കാണിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үгийг дагасан үйлдэл жинхэнэ гэдгийг батална. Уучлалт гуйхын зэрэгцээ сайхан зүйл хийх нь чин сэтгэлээсээ гэдгийг харуулна."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दांसोबत कृती असली की ते खरे असल्याचे सिद्ध होते. माफी मागताना काहीतरी प्रेमाने केले, तर ती मनापासून मागितल्याचे दिसते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan bersama kata-kata membuktikan ia ikhlas. Meminta maaf sambil melakukan sesuatu yang baik menunjukkan dia bersungguh-sungguh."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-azzjoni flimkien mal-kliem turi li hija vera. Li tgħid “jiddispjaċini” waqt li tagħmel xi ħaġa sabiħa turi li tfissirha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားနဲ့အတူ လုပ်ဆောင်ချက်က တကယ်ဖြစ်ကြောင်း သက်သေပြတယ်။ တောင်းပန်ရင်း ကြင်နာတဲ့အရာ တစ်ခုခု လုပ်ပေးတာက စိတ်ရင်းနဲ့ ပြောနေတာကို ပြသတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling sammen med ord viser at det er ekte. Å si unnskyld og samtidig gjøre noe fint viser at det er oppriktig ment."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दसँगै काम हुँदा त्यो साँचो हो भन्ने प्रमाणित हुन्छ। माफी माग्दै केही दयालु काम गर्नुले उहाँ मनैदेखि भन्दै हुनुहुन्छ भन्ने देखाउँछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daden naast woorden bewijzen dat het echt is. Sorry zeggen en tegelijk iets liefs doen laat zien dat het gemeend is."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zochita pamodzi ndi mawu zimatsimikizira kuti nzenizeni. Kupepesa uku akuchita chinthu chabwino kumasonyeza kuti akutanthauza."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jechoota waliin gochi dhugaa ta'uu isaa mirkaneessa. Dhiifama gaafachaa waan gaarii gochuun akka dhugaan jedhame agarsiisa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଥା ସହ କାମ ପ୍ରମାଣ କରେ ଏହା ସଚ୍ଚା। ‘ସରି’ କହିବା ସହ କିଛି ଭଲ କାମ କଲେ ଜଣାପଡ଼େ ସେମାନେ ମନରୁ କହୁଛନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਬਦਾਂ ਦੇ ਨਾਲ ਅਮਲ ਸਾਬਤ ਕਰਦਾ ਹੈ ਕਿ ਗੱਲ ਸੱਚੀ ਹੈ। ਮਾਫ਼ੀ ਮੰਗਦਿਆਂ ਕੁਝ ਚੰਗਾ ਕਰਨਾ ਦਿਖਾਉਂਦਾ ਹੈ ਕਿ ਉਹ ਦਿਲੋਂ ਕਹਿ ਰਹੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyn obok słów dowodzi, że to szczere. Przeprosiny połączone z miłym gestem pokazują, że ktoś mówi poważnie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د خبرو ترڅنګ عمل ثابتوي چې رښتیا ده. له بښنې سره یو مهربانه کار ښيي چې ستاسو ملګری یې په رښتیا وايي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atitude junto com palavras prova que é real. Pedir desculpas fazendo algo gentil mostra que é de coração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações a par das palavras provam que é verdade. Pedir desculpa enquanto se faz algo gentil mostra que é sincero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fapta alături de vorbe dovedește că scuza e sinceră. Să-ți ceară scuze făcând ceva frumos arată că partenerul tău chiar vorbește serios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие вместе со словами доказывает, что всё всерьёз. Извинение плюс доброе дело показывает, что партнёр говорит искренне."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igikorwa giherekeje amagambo kigaragaza ko ari ukuri. Gusaba imbabazi ukora n'ikintu cyiza byerekana ko abivuga abikuye ku mutima."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වචන සමඟ ක්‍රියාවත් තියෙනකොට ඒක ඇත්ත බව ඔප්පු වෙනවා. සමාව ඉල්ලන ගමන් කාරුණික දෙයක් කරන එකෙන් ඒක හදවතින්ම කියන බව පෙනෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čin popri slovách dokazuje, že je to myslené vážne. Ospravedlnenie spojené s milým skutkom ukazuje úprimnosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejanje ob besedah dokaže, da je zares. Opravičilo skupaj z nečim prijaznim pokaže, da je mišljeno resno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zviito zviri pamwe nemazwi zvinoratidza kuti ndezvechokwadi. Kukumbira ruregerero uchiita chimwe chinhu chakanaka kunoratidza kuti anoreva."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficil erayada la socda ayaa caddeeya inay run tahay. “Waan ka xumahay” oo lala socodsiiyo wax naxariis leh ayaa muujinaya in si dhab ah loola jeedo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veprimi krahas fjalëve provon që është e vërtetë. Kur partneri yt kërkon falje duke bërë diçka të mirë, tregon se e ka seriozisht."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дело уз речи доказује да је искрено. Кад неко каже „извини“ и уз то уради нешто лепо, видиш да то стварно мисли."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laku dibarengan kecap ngabuktikeun yén éta leres. Nyuhunkeun hapunten bari ngalakukeun hal anu saé nunjukkeun yén anjeunna sungguh-sungguh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling och ord tillsammans visar att det är på riktigt. Att säga förlåt och samtidigt göra något fint visar att din partner menar det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitendo pamoja na maneno huthibitisha ni kweli. Kusema samahani huku ukifanya jambo jema huonyesha unamaanisha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வார்த்தைகளுடன் வரும் செயல், அது உண்மை என்பதை நிரூபிக்கிறது. மன்னிப்புக் கேட்டுக்கொண்டே அன்பான ஒன்றைச் செய்வது, அவர் மனதார சொல்கிறார் என்பதைக் காட்டுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మాటలతో పాటు చేతలు అది నిజమని రుజువు చేస్తాయి. సారీ చెబుతూ ఏదో మంచి పని చేస్తే, వారు నిజంగా అంటున్నారని తెలుస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амал дар баробари сухан нишон медиҳад, ки ин воқеист. Узр пурсидан ҳамроҳи кори нек нишон медиҳад, ки ёрат ҷиддӣ аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำที่มาพร้อมคำพูดพิสูจน์ว่าจริงใจ การขอโทษพร้อมทำสิ่งดีๆ ให้แสดงว่าตั้งใจจริง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምስ ቃላት ዝኸይድ ተግባር ሓቂ ምዃኑ የርኢ። ይቕሬታ እናሓተቱ ሕያዋይ ነገር ምግባር ብሓቂ ከም ዝኣመንሉ የርኢ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söz bilen bile edilen iş onuň çyndygyny subut edýär. Ötünç sorap, bir ýagşy iş etmek onuň ýürekdendigini görkezýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlere eşlik eden davranış, özrün gerçek olduğunu kanıtlıyor. Özür dilerken güzel bir şey yapmak, ciddi olduğunu gösteriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дії разом зі словами доводять, що це щиро. Коли вибачення супроводжує щось добре, видно, що половинка справді так думає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفاظ کے ساتھ عمل ثابت کرتا ہے کہ بات سچی ہے۔ معافی مانگتے ہوئے کوئی مہربانی کرنا دکھاتا ہے کہ معافی دل سے ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soʻz bilan birga qilingan ish uning chinligini isbotlaydi. Uzr soʻrab, yaxshi bir ish qilish chin dildan ekanini koʻrsatadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hành động đi kèm lời nói chứng minh đó là thật. Vừa xin lỗi vừa làm điều tử tế cho thấy người ấy thật lòng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isenzo esihamba namazwi singqina ukuba yinyani. Ukuthi uxolo ngelixa usenza into enobubele kubonisa ukuba umntu uthetha inyani."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìṣe pẹ̀lú ọ̀rọ̀ ń fi hàn pé òótọ́ ni. Títọrọ àforíjìn nígbà tí a ń ṣe nǹkan rere ń fi hàn pé láti ọkàn ló ti wá."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言行配合，才證明是真心。一邊道歉一邊做件貼心的事，代表對方是認真的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "话语加上行动才显得真。一边道歉一边做点暖心的事，说明对方是认真的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有行動搭配言語，才證明是真的。一邊道歉一邊做件貼心的事，代表對方是認真的。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isenzo esihambisana namazwi sifakazela ukuthi kuyiqiniso. Ukuxolisa ngenkathi wenza okuthile okunomusa kukhombisa ukuthi uqotho."
          }
        }
      }
    },
    "Action over words. You say 'I'm sorry' by showing it — and you receive apologies the same way." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dade bo woorde. Jy sê “Ek is jammer” deur dit te wys – en jy ontvang verskonings op dieselfde manier."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከቃል ይልቅ ተግባር። «ይቅርታ» የሚሉት በማሳየት ነው — ይቅርታንም በዚያው መንገድ ይቀበላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفعل قبل الكلام. تقولون «آسف» بالأفعال، وتتلقون الاعتذار بالطريقة نفسها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দতকৈ কাম। আপুনি দেখুৱাইহে “মোক ক্ষমা কৰা” কয় — আৰু ক্ষমা প্ৰাৰ্থনাও একেদৰেই গ্ৰহণ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözdən çox əməl. “Bağışla”nı göstərərək deyirsən — və üzrxahlığı da elə qəbul edirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справы важнейшыя за словы. Ты кажаш «прабач» учынкамі — і прабачэнні прымаеш гэтак жа."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия вместо думи. Казваш „Съжалявам“, като го показваш – и по същия начин приемаш извиненията."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথার চেয়ে কাজ। তুমি “দুঃখিত” বলো করে দেখিয়ে — আর ক্ষমাও তুমি সেভাবেই গ্রহণ করো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djela prije riječi. „Žao mi je” kažeš tako što to pokažeš – i izvinjenja primaš na isti način."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fets més que paraules. Dius «ho sento» demostrant-ho — i reps les disculpes de la mateixa manera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Činy víc než slova. „Promiň“ říkáš tím, že to ukážeš – a stejně tak přijímáš i omluvy."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gweithredu yn hytrach na geiriau. Rwyt ti'n dweud ‘sori’ drwy ei ddangos — ac rwyt ti'n derbyn ymddiheuriadau yn yr un ffordd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling frem for ord. Du siger undskyld ved at vise det – og du tager imod undskyldninger på samme måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taten statt Worte. Du sagst „Es tut mir leid“, indem du es zeigst – und so nimmst du Entschuldigungen auch an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πράξεις αντί για λόγια. Λες «συγγνώμη» δείχνοντάς το — και δέχεσαι τις συγγνώμες με τον ίδιο τρόπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hechos antes que palabras. Dices “lo siento” demostrándolo, y recibes las disculpas de la misma manera."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teod enne sõnu. Sa ütled „vabandust“ tegudega — ja võtad vabandusi vastu samamoodi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekintzak hitzak baino gehiago. «Barkatu» erakutsiz esaten duzu — eta barkamenak ere horrela jasotzen dituzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل مهم‌تر از حرف. «ببخشید» را با نشان دادن می‌گویی — و عذرخواهی را هم همین‌طور می‌پذیری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teot ennen sanoja. Sanot ”anteeksi” näyttämällä sen – ja otat anteeksipyynnöt vastaan samalla tavalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gawa kaysa salita. Sinasabi mo ang “sorry” sa pamamagitan ng pagpapakita — at ganoon mo rin tinatanggap ang paghingi ng tawad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actes plutôt que les mots. Tu dis « pardon » en le montrant, et tu reçois les excuses de la même façon."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gníomh seachas focail. Deir tú “Tá brón orm” trína thaispeáint — agus glacann tú le leithscéalta ar an mbealach céanna."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feitos mellor ca palabras. Dis «síntoo» demostrándoo, e recibes as desculpas da mesma maneira."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શબ્દો કરતાં કામ. તમે “સૉરી” કરીને બતાવો છો — અને માફી પણ એ જ રીતે સ્વીકારો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiki ya fi magana. Kuna cewa “Ku yi haƙuri” ta hanyar nunawa — kuma haka kuke karɓar neman gafara."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעשים במקום מילים. אצלך 'סליחה' נאמרת דרך מעשים — וככה גם התנצלויות מתקבלות אצלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों से बढ़कर काम। आप “सॉरी” करके दिखाते हैं — और माफ़ी भी इसी तरह स्वीकार करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djela umjesto riječi. „Oprosti” kažeš tako da to pokažeš – i isprike primaš na isti način."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksyon pi fò pase pawòl. Ou di “Padon” lè ou montre l — e ou resevwa eskiz menm jan an."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tettek a szavak helyett. Nem kimondod, hanem megmutatod, hogy sajnálod – és a bocsánatkérést is így fogadod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արարքներ՝ խոսքերի փոխարեն։ Դու «Ներիր» ես ասում՝ ցույց տալով, և ներողությունն էլ նույն կերպ ես ընդունում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan lebih dari kata-kata. Kamu bilang “maaf” dengan menunjukkannya — dan kamu menerima maaf dengan cara yang sama."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omume karịa okwu. Ị na-ekwu “Ndo” site n'igosi ya — ị na-anabatakwa mgbaghara n'otu ụzọ ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verk frekar en orð. Þú segir „fyrirgefðu“ með því að sýna það – og tekur við afsökunarbeiðnum á sama hátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fatti prima delle parole. Chiedi scusa dimostrandolo — e accogli le scuse allo stesso modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉より行動。「ごめんね」を態度で示し、謝罪も同じように受け取るタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumindak luwih saka tembung. Panjenengan ngucap “Ngapura ya” kanthi nuduhake — lan panjenengan uga nampa njaluk ngapura kanthi cara sing padha."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საქმე სიტყვაზე მეტია. „ბოდიშს“ ქმედებით ამბობ — და ბოდიშსაც ასევე იღებ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөзден гөрі іс. Сен «Кешір» дегенді іспен көрсетесің — кешірімді де солай қабылдайсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សកម្មភាពលើសពាក្យសម្ដី។ អ្នកនិយាយថា “សុំទោស” ដោយការបង្ហាញ — ហើយអ្នកក៏ទទួលការសុំទោសតាមរបៀបដូចគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತಿಗಿಂತ ಕೃತಿ. ನೀವು “ಕ್ಷಮಿಸು” ಎಂದು ಮಾಡಿ ತೋರಿಸುತ್ತೀರಿ — ಮತ್ತು ಕ್ಷಮೆಯನ್ನೂ ಅದೇ ರೀತಿ ಸ್ವೀಕರಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말보다 행동이에요. “미안해”를 행동으로 보여 주고, 사과도 같은 방식으로 받는 걸 좋아해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirin ji gotinan bêtir. Tu “bibore” bi nîşandanê dibêjî — û tu lêborînan jî bi heman awayî distînî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөздөн көрө иш. «Кечир» дегениңди иш менен көрсөтөсүң — кечиримди да ошондой кабыл аласың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlunge virun Wierder. Du sees „Et deet mer leed“, andeems s du et weis — an esou kriss du Entschëllegungen och am léifsten."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການກະທຳສຳຄັນກວ່າຄຳເວົ້າ ເຈົ້າບອກວ່າ ‘ຂໍໂທດ’ ດ້ວຍການສະແດງອອກ — ແລະ ເຈົ້າກໍຮັບຄຳຂໍໂທດແບບດຽວກັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veiksmai svarbiau už žodžius. „Atsiprašau“ parodai darbais – ir atsiprašymus priimi taip pat."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbi pār vārdiem. Tu saki „Piedod”, to parādot, – un atvainošanos pieņem tāpat."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asa toy izay teny. Lazainao amin'ny fanehoana ny hoe “Miala tsiny aho” — ary toy izany koa no handraisanao fialan-tsiny."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te mahi i mua i te kupu. Ka kī koe “Aroha mai” mā te whakaatu — ā, he pērā anō tō whakawhiwhi i te whakapāha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дела наместо зборови. „Извини“ го кажуваш со покажување — и извинувањата ги примаш на ист начин."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാക്കുകളെക്കാൾ പ്രവൃത്തി. നിങ്ങൾ “സോറി” പറയുന്നത് ചെയ്തുകാണിച്ചാണ് — ക്ഷമാപണങ്ങൾ സ്വീകരിക്കുന്നതും അങ്ങനെതന്നെ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үгээс илүү үйлдэл. Чи «Уучлаарай» гэдгийг харуулж хэлдэг — уучлалтыг ч мөн адил хүлээж авдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दांपेक्षा कृती. तुम्ही “सॉरी” करून दाखवता — आणि माफीही तशीच स्वीकारता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan mengatasi kata-kata. Anda meminta maaf dengan menunjukkannya — dan anda menerima permohonan maaf dengan cara yang sama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-azzjoni qabel il-kliem. Tgħid “jiddispjaċini” billi turih — u tilqa' l-apoloġiji bl-istess mod."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားထက် လုပ်ဆောင်ချက်။ သင် “တောင်းပန်ပါတယ်” ကို လုပ်ပြခြင်းနဲ့ ပြောတယ် — တောင်းပန်မှုကိုလည်း ဒီလိုပဲ လက်ခံတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling framfor ord. Du sier «unnskyld» ved å vise det – og du tar imot unnskyldninger på samme måte."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दभन्दा काम। तपाईं ‘मलाई माफ गर्नुहोस्’ गरेर देखाउनुहुन्छ — र माफी पनि त्यसैगरी स्वीकार गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daden boven woorden. Jij zegt ‘sorry’ door het te laten zien – en zo ontvang je excuses ook het liefst."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zochita kuposa mawu. Mumanena kuti “Pepani” posonyeza — ndipo mumalandira kupepesa chimodzimodzi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jecha caalaa gocha. “Dhiifama” jechuu agarsiisuudhaan dubbatta — dhiifamas akkasuma fudhatta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଥାଠୁ କାମ ବଡ଼। ଆପଣ କରି ଦେଖାଇ ‘ସରି’ କୁହନ୍ତି — ଆଉ କ୍ଷମାପ୍ରାର୍ଥନା ବି ସେହିପରି ଗ୍ରହଣ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਬਦਾਂ ਨਾਲੋਂ ਅਮਲ। ਤੁਸੀਂ “ਮਾਫ਼ ਕਰਨਾ” ਕਰ ਕੇ ਦਿਖਾਉਂਦੇ ਹੋ — ਅਤੇ ਮਾਫ਼ੀ ਵੀ ਇਸੇ ਤਰ੍ਹਾਂ ਕਬੂਲਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyny ponad słowa. Mówisz „przepraszam”, pokazując to – i tak samo przyjmujesz przeprosiny."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل له خبرو غوره. تاسو «بښنه غواړم» په ښودلو وایئ — او بښنه هم همداسې منئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atitude mais que palavras. Você pede desculpas mostrando — e recebe desculpas do mesmo jeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações acima de palavras. Dizes «desculpa» a mostrar — e recebes pedidos de desculpa da mesma forma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fapte, nu vorbe. Spui „îmi pare rău” prin fapte — și primești scuzele la fel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дела важнее слов. Ты говоришь «прости» поступками — и извинения принимаешь так же."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibikorwa biruta amagambo. Uvuga ngo “Mbabarira” ubigaragaza — kandi nawe wakira imbabazi gutyo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වචනවලට වඩා ක්‍රියාව. ඔබ “සමාවෙන්න” කියන්නේ පෙන්නලා — සමාව ඉල්ලීම් භාර ගන්නෙත් එහෙමමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Činy namiesto slov. „Prepáč“ povieš tak, že to ukážeš – a ospravedlnenia prijímaš rovnako."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejanja pred besedami. „Oprosti“ poveš tako, da to pokažeš – in opravičila sprejemaš na enak način."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zviito pane mazwi. Unoti “Ndine urombo” nekuzviratidza — uye unogamuchira ruregerero nenzira imwe chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficil, ma aha erayo. “Waan ka xumahay” waxaad ku tidhaahdaa adigoo muujinaya — raalli-gelintana sidaas oo kale ayaad u aqbashaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veprime, jo fjalë. Ti thua „Më vjen keq“ duke e treguar – dhe faljet i pranon në të njëjtën mënyrë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дела пре речи. „Извини“ кажеш тако што покажеш — и извињења примаш на исти начин."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laku langkung ti kecap. Anjeun nyarios “hapunten” ku cara nunjukkeunana — sareng anjeun nampi hapunten kalayan cara anu sami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling före ord. Du säger förlåt genom att visa det – och du tar emot ursäkter på samma sätt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitendo kuliko maneno. Unasema “samahani” kwa kuonyesha — na unapokea msamaha kwa njia hiyo hiyo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வார்த்தைகளை விட செயல். “மன்னிக்கவும்” என்பதைச் செய்து காட்டுகிறீர்கள் — மன்னிப்பையும் அதே விதத்தில் பெற்றுக்கொள்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మాటల కంటే చేతలు. మీరు “సారీ” చేసి చూపిస్తారు — క్షమాపణలను కూడా అలాగే అందుకుంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амал аз сухан болотар. Ту «бубахш»-ро бо нишон додан мегӯӣ — ва узрҳоро низ ҳамин тавр қабул мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำสำคัญกว่าคำพูด คุณบอก “ขอโทษนะ” ด้วยการแสดงออก และก็รับคำขอโทษในแบบเดียวกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ቃላት ተግባር። «ይቕሬታ» ብተግባር ትብሉ — ይቕሬታ እውን ብተመሳሳሊ መንገዲ ትቕበሉ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözden iş öňde. Sen “Bagyşla” diýmegi hereket bilen görkezýärsiň — ötünji hem şeýle kabul edýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözden çok davranış. “Özür dilerim”i göstererek söylüyorsun ve özürleri de aynı şekilde alıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дії замість слів. Ти кажеш «вибач», показуючи це, — і вибачення приймаєш так само."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفاظ سے زیادہ عمل۔ آپ کا “معاف کر دیں” کہنے کا طریقہ کر کے دکھانا ہے — اور آپ تک معافی بھی اسی طرح پہنچتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soʻzdan koʻra amal. Siz «Kechir» degan gapni amalda koʻrsatasiz — uzrni ham xuddi shunday qabul qilasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hành động hơn lời nói. Bạn nói “xin lỗi” bằng cách thể hiện — và bạn cũng đón nhận lời xin lỗi theo cách đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isenzo ngaphezu kwamazwi. Uthi “Uxolo” ngokukubonisa — kwaye wamkela uxolo ngendlela efanayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìṣe ju ọ̀rọ̀ lọ. Ẹ ń sọ “Má bínú” nípa fífi hàn — ẹ sì ń gba àforíjìn lọ́nà kan náà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動勝於言語。你用行動說「對不起」，也用同樣的方式接受道歉。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行动胜过语言。你用行动说“对不起”，也用同样的方式接受道歉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動勝於言語。你用行動說「對不起」，也用同樣的方式接受道歉。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izenzo kunamazwi. Uthi “Ngiyaxolisa” ngokukukhombisa — futhi wamukela ukuxolisa ngendlela efanayo."
          }
        }
      }
    },
    "Action-oriented. You feel better when you're doing something about it — even if there's nothing to do. Channel that well." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksiegerig. Jy voel beter as jy iets daaraan doen – selfs as daar niks is om te doen nie. Kanaliseer dit goed."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተግባር ተኮር። ስለ ጉዳዩ አንድ ነገር ሲያደርጉ ይሻልዎታል — ምንም የሚደረግ ነገር ባይኖርም እንኳ። ያንን ጉልበት በደንብ ይጠቀሙበት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميل إلى الفعل. يتحسن حالك عند فعل شيء حيال الأمر، حتى لو لم يكن هناك ما يُفعل. وجّهوا هذه الطاقة جيدًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কৰ্মমুখী। কিবা এটা কৰি থাকিলে আপোনাৰ ভাল লাগে — একো কৰিবলগীয়া নাথাকিলেও। সেই শক্তি ভালকৈ ব্যৱহাৰ কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hərəkətə yönəlmisən. Nəsə edəndə özünü daha yaxşı hiss edirsən — ediləcək bir şey olmasa belə. Bu enerjini düzgün yönəlt."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арыентацыя на дзеянне. Табе лягчэй, калі робіш з гэтым хоць штосьці, — нават калі рабіць няма чаго. Накіруй гэтую энергію з карысцю."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насоченост към действие. Чувстваш се по-добре, когато правиш нещо по въпроса – дори да няма какво да се направи. Насочи тази енергия добре."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজে বিশ্বাসী। কিছু একটা করতে পারলেই তোমার ভালো লাগে — করার কিছু না থাকলেও। এই শক্তিটা ঠিক পথে লাগাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okrenutost akciji. Bolje se osjećaš kad nešto poduzimaš – čak i kad nema šta da se uradi. Samo tu energiju dobro usmjeri."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientació a l'acció. Et sents millor quan fas alguna cosa al respecte — encara que no hi hagi res a fer. Canalitza-ho bé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaměření na činy. Je ti líp, když s tím něco děláš – i když vlastně není co dělat. Hlavně tu energii dobře nasměruj."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gweithredu. Rwyt ti'n teimlo'n well pan fyddi di'n gwneud rhywbeth am y peth — hyd yn oed os nad oes dim i'w wneud. Sianela hynny'n dda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingsorienteret. Du har det bedre, når du gør noget ved det – også når der ikke er noget at gøre. Brug den energi klogt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatkräftig. Dir geht es besser, wenn du etwas tust – selbst wenn es nichts zu tun gibt. Nutz diese Energie gut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσανατολισμός στη δράση. Νιώθεις καλύτερα όταν κάνεις κάτι γι' αυτό — ακόμα κι αν δεν υπάρχει κάτι να γίνει. Διοχέτευσέ το σωστά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación a la acción. Te sientes mejor cuando haces algo al respecto — aunque no haya nada que hacer. Canaliza bien esa energía."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegutsemisele suunatud. Tunned end paremini, kui saad asjaga midagi ette võtta — isegi kui midagi teha pole. Suuna see energia hästi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekintzara bideratua. Hobeto sentitzen zara zerbait egiten ari zarenean, egiteko ezer ez badago ere. Bideratu ondo indar hori."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اهل عمل. وقتی کاری برایش می‌کنی حالت بهتر می‌شود — حتی اگر کاری از دستت برنیاید. این انرژی را درست به کار بگیر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toimintaan suuntautunut. Olosi paranee, kun teet asialle jotain – vaikkei mitään olisi tehtävissä. Suuntaa se energia viisaasti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakatuon sa aksyon. Gumagaan ang loob mo kapag may ginagawa ka tungkol dito — kahit wala namang magagawa. Gamitin ’yan nang tama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place à l'action. Tu te sens mieux quand tu agis — même s'il n'y a rien à faire. Canalise bien cette énergie."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dírithe ar ghníomh. Mothaíonn tú níos fearr nuair atá tú ag déanamh rud éigin faoi — fiú mura bhfuil aon rud le déanamh. Úsáid an fuinneamh sin go maith."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación á acción. Séntesche mellor cando fas algo ao respecto, aínda que non haxa nada que facer. Canaliza ben esa enerxía."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કામ કરવામાં માનનારા. કંઈક કરતા હો ત્યારે તમને સારું લાગે છે — ભલે કરવા જેવું કંઈ ન હોય. એ શક્તિને સાચી દિશામાં વાળો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu son aiki. Kuna jin sauƙi idan kuna yin wani abu a kai — ko da babu abin yi. Ku yi amfani da hakan da kyau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכוונות לפעולה. הכי טוב לך כשמשהו נעשה בעניין — גם כשאין מה לעשות. כדאי לתעל את זה נכון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कर्म पर भरोसा। उस बारे में कुछ करने से आपको बेहतर लगता है — भले ही असल में करने को कुछ न हो। इस ऊर्जा को सही दिशा दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmjerenost na akciju. Bolje ti je kad nešto poduzimaš – čak i kad se nema što učiniti. Usmjeri to dobro."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oryante sou aksyon. Ou santi ou pi byen lè w ap fè yon bagay pou sa — menm si pa gen anyen pou fè. Itilize fòs sa a byen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cselekvő típus vagy. Jobban érzed magad, ha teszel valamit – akkor is, ha nincs mit tenni. Csak jó irányba tereld."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գործողության մարդ։ Ավելի լավ ես զգում, երբ ինչ-որ բան ես անում, նույնիսկ եթե անելու բան չկա։ Ճիշտ ուղղորդիր այդ էներգիան։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berorientasi aksi. Kamu merasa lebih baik saat melakukan sesuatu — meski sebenarnya nggak ada yang bisa dilakukan. Salurkan dengan baik."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eme ihe. Obi na-adị gị mma mgbe ị na-eme ihe banyere ya — ọbụlagodị ma ọ dịghị ihe a ga-eme. Duzie ike ahụ nke ọma."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athafnasemi. Þér líður betur þegar þú ert að gera eitthvað í málinu – jafnvel þótt ekkert sé hægt að gera. Beindu því í góðan farveg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientamento all’azione. Ti senti meglio quando fai qualcosa — anche se non c’è niente da fare. Incanala bene questa energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動派です。できることがなくても、何かしていると気持ちが楽になります。そのエネルギーを上手に使いましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneng tumindak. Panjenengan krasa luwih kepenak yen lagi nindakake apa-apa — senajan sejatine ora ana sing bisa ditindakake. Salurna kanthi becik."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოქმედებაზე ორიენტირებული. უკეთ გრძნობ თავს, როცა რაღაცას აკეთებ — თუნდაც გასაკეთებელი არაფერი იყოს. ეს ენერგია სწორად მიმართე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әрекетке бағытталған жансың. Бір нәрсе істеп жатқанда жеңілдейсің, тіпті істейтін ештеңе болмаса да. Сол қуатты дұрыс арнаға бұр."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ដោតលើសកម្មភាព។ អ្នកមានអារម្មណ៍ល្អជាង ពេលអ្នកកំពុងធ្វើអ្វីមួយដើម្បីដោះស្រាយ — ទោះបីគ្មានអ្វីត្រូវធ្វើក៏ដោយ។ ប្រើកម្លាំងនោះឲ្យបានល្អ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕ್ರಿಯಾಶೀಲರು. ಅದರ ಬಗ್ಗೆ ಏನಾದರೂ ಮಾಡುತ್ತಿರುವಾಗ ನಿಮಗೆ ಸಮಾಧಾನ — ಮಾಡಲು ಏನೂ ಇಲ್ಲದಿದ್ದರೂ ಸಹ. ಆ ಶಕ್ತಿಯನ್ನು ಸರಿಯಾಗಿ ಬಳಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동파예요. 할 수 있는 게 없더라도 뭔가를 하고 있을 때 기분이 나아져요. 그 에너지를 잘 써 보세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalakîxwaz. Dema tu tiştekî jê re dikî, tu xwe çêtir hîs dikî — heta eger tiştek tune be ku were kirin jî. Wê enerjiyê baş bi kar bîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иш-аракетке багытталгансың. Бир нерсе кылып жатканда жеңилдейсиң — кыла турган эч нерсе жок болсо да. Ошол күчтү туура жакка багытта."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlungsorientéiert. Du fills dech besser, wanns de eppes dogéint méchs — och wann et näischt ze maachen ass. Setz déi Energie gutt an."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສາຍລົງມືເຮັດ ເຈົ້າຮູ້ສຶກດີຂຶ້ນເມື່ອໄດ້ເຮັດບາງຢ່າງ — ເຖິງແມ່ນບໍ່ມີຫຍັງໃຫ້ເຮັດກໍຕາມ ຂໍໃຫ້ໃຊ້ພະລັງນີ້ໃຫ້ຖືກທາງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientacija į veiksmą. Tau geriau, kai kažką darai – net jei daryti nėra ko. Nukreipk tą energiją protingai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rīcība pirmajā vietā. Tev kļūst vieglāk, kad kaut ko dari – pat ja nekas nav darāms. Novirzi to labā virzienā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirona amin'ny asa. Mahatsiaro ho tsara kokoa ianao rehefa manao zavatra hiatrehana izany — na dia tsy misy azo atao aza. Ampiasao amin'ny lalana tsara io hery io."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tangata mahi koe. Ka pai ake koe ina mahi koe i tētahi mea mō taua take — ahakoa kāore he mahi e taea. Ārahina tēnā kaha kia pai."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насоченост кон акција. Се чувствуваш подобро кога правиш нешто во врска со тоа — дури и кога нема што да се направи. Насочи ја таа енергија мудро."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രവൃത്തിയിലൂന്നിയ രീതി. ചെയ്യാനൊന്നുമില്ലെങ്കിൽ പോലും, അതിനെക്കുറിച്ച് എന്തെങ്കിലും ചെയ്യുമ്പോഴാണ് നിങ്ങൾക്ക് ആശ്വാസം. ആ ഊർജം നല്ല വഴിക്ക് തിരിച്ചുവിടൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үйлдэлд чиглэсэн. Хийх юм байхгүй байсан ч ямар нэг юм хийж байхдаа илүү сайн мэдэрдэг. Үүнийгээ зөв чиглүүлээрэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृतीवर भर. काहीतरी करत राहिलात की तुम्हाला बरे वाटते — करण्यासारखे काही नसले तरी. ही ऊर्जा योग्य दिशेला वळवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berorientasikan tindakan. Anda rasa lebih baik bila melakukan sesuatu — walaupun tiada apa yang boleh dibuat. Salurkan tenaga itu dengan baik."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azzjoni l-ewwel. Tħossok aħjar meta tkun qed tagħmel xi ħaġa dwarha — anke jekk m'hemm xejn x'tagħmel. Uża dik l-enerġija tajjeb."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လုပ်ဆောင်ချက်ကို ဦးစားပေးသူပါ။ ဘာမှ လုပ်စရာ မရှိရင်တောင် တစ်ခုခု လုပ်နေရမှ စိတ်သက်သာတယ်။ ဒီအင်အားကို ကောင်းကောင်း အသုံးချပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingsorientert. Du får det bedre når du gjør noe med det – selv om det ikke er noe å gjøre. Bruk den energien godt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काममुखी। गर्नुपर्ने केही नभए पनि, त्यसबारे केही गरिरहँदा तपाईंलाई राम्रो लाग्छ। त्यो ऊर्जालाई सही दिशामा लगाउनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gericht op actie. Je voelt je beter als je er iets aan doet – ook als er niets te doen valt. Zet die energie goed in."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakonda kuchitapo kanthu. Mumamva bwino mukamachita kanthu pa nkhaniyo — ngakhale palibe choti nkuchita. Gwiritsani ntchito zimenezo bwino."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hojiitti amanta. Yeroo waan tokko irratti hojjettu sitti tola — yoo waan hojjetamu hin jirre illee. Humna sana karaa gaariitti oolchi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କାମ କରିବାରେ ବିଶ୍ୱାସୀ। ସେ ବିଷୟରେ କିଛି କରୁଥିବାବେଳେ ଆପଣ ଭଲ ଅନୁଭବ କରନ୍ତି — କରିବାକୁ କିଛି ନଥିଲେ ବି। ସେହି ଶକ୍ତିକୁ ଠିକ୍ ବାଟରେ ଲଗାନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਰ ਕੇ ਦਿਖਾਉਣ ਵਾਲਾ ਸੁਭਾਅ। ਜਦੋਂ ਤੁਸੀਂ ਇਸ ਬਾਰੇ ਕੁਝ ਕਰ ਰਹੇ ਹੁੰਦੇ ਹੋ ਤਾਂ ਚੰਗਾ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ — ਭਾਵੇਂ ਕਰਨ ਨੂੰ ਕੁਝ ਵੀ ਨਾ ਹੋਵੇ। ਇਸ ਊਰਜਾ ਨੂੰ ਸਹੀ ਪਾਸੇ ਲਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastawienie na działanie. Czujesz się lepiej, gdy coś z tym robisz – nawet jeśli nic nie da się zrobić. Wykorzystaj to mądrze."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل‌پالنه. کله چې د ستونزې لپاره څه کوئ، ښه احساس کوئ — حتی که د کولو لپاره هېڅ نه وي. دا انرژي په سمه لار کې وکاروئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco na ação. Você se sente melhor fazendo algo a respeito — mesmo quando não há nada a fazer. Canalize isso bem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco na ação. Sentes-te melhor quando estás a fazer alguma coisa — mesmo que não haja nada a fazer. Canaliza isso bem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientare spre acțiune. Te simți mai bine când faci ceva în privința problemei — chiar dacă nu e nimic de făcut. Canalizează bine energia asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты человек действия. Становится легче, когда что-то делаешь, — даже если сделать ничего нельзя. Направь эту энергию в хорошее русло."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uri umuntu w'ibikorwa. Wumva umeze neza iyo hari icyo urimo ukora — kabone n'iyo nta cyo wakora. Bikoreshe neza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ක්‍රියාව කේන්ද්‍ර කරගත්තා. ඒ ගැන යමක් කරද්දී ඔබට හොඳක් දැනෙනවා — කරන්න දෙයක් නැති වුණත්. ඒ ශක්තිය හොඳ පැත්තට යොමු කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zameranie na činy. Je ti lepšie, keď s tým niečo robíš – aj keď sa nedá robiť nič. Usmerni tú energiu dobre."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmerjenost v dejanja. Bolje ti je, ko lahko nekaj ukreneš – tudi če ni kaj narediti. To energijo usmeri pametno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda kuita. Unonzwa zviri nani kana uchiita chimwe chinhu pamusoro pazvo — kunyangwe pasina chekuita. Shandisa simba iroro zvakanaka."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficil baad jeceshahay. Waad ka fiicnaataa markaad wax ka qabanayso — xitaa haddii aan waxba la qaban karin. Tamartaas si fiican u isticmaal."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veprimi në plan të parë. Ndihesh më mirë kur bën diçka për të – edhe kur s’ka asgjë për të bërë. Përdore mirë këtë energji."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окренутост акцији. Боље ти је кад нешто предузимаш — чак и кад нема шта да се уради. Усмери то паметно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoyong langsung ngalakukeun. Anjeun ngaraos langkung saé upami nuju ngalakukeun hiji hal, sanaos sabenerna teu aya anu kedah dilakukeun. Salurkeun éta kalayan saé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingsinriktad. Du mår bättre när du gör något åt saken – även när det inte finns något att göra. Använd den energin klokt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mtu wa vitendo. Unajisikia vizuri zaidi unapolishughulikia — hata kama hakuna la kufanya. Elekeza nguvu hiyo vizuri."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயலில் நம்பிக்கை உள்ளவர். செய்வதற்கு எதுவும் இல்லாவிட்டாலும், அதைப் பற்றி ஏதாவது செய்யும்போது நீங்கள் நன்றாக உணர்கிறீர்கள். அந்த ஆற்றலைச் சரியாகப் பயன்படுத்துங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చేతలే మీ దారి. దాని గురించి ఏదైనా చేస్తున్నప్పుడే మీకు బాగుంటుంది — చేయడానికి ఏమీ లేకపోయినా. ఆ శక్తిని సరైన దిశలో పెట్టండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Майл ба амал. Вақте коре мекунӣ, худро беҳтар ҳис мекунӣ — ҳатто агар коре кардан лозим набошад. Ин қувватро ба ҷои дуруст равона кун."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเป็นสายลงมือทำ คุณรู้สึกดีขึ้นเมื่อได้ทำอะไรสักอย่าง แม้ไม่มีอะไรให้ทำจริงๆ ก็ตาม ใช้พลังนี้ให้ดี"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ናብ ተግባር ዘቕንዑ ኢኹም። ገለ ነገር ክትገብሩ ከለኹም ይሓይሸኩም — ዋላ ዝግበር ነገር እንተዘየለ። ነዚ ብጽቡቕ ኣቕንዕዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hereketçil. Bir zat edeňde — edere zat bolmasa-da — özüňi has gowy duýýarsyň. Şol güýji dogry ugra gönükdir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylem odaklısın. Yapacak bir şey olmasa bile bir şeyler yaptığında kendini daha iyi hissediyorsun. Bu enerjiyi iyi yönlendir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орієнтація на дію. Тобі легшає, коли щось робиш — навіть якщо робити нічого. Спрямовуй це з користю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل پسندی۔ کچھ کرنے سے ہی آپ کو بہتری محسوس ہوتی ہے، چاہے کرنے کو کچھ نہ ہو۔ اس توانائی کو اچھی سمت دیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harakatga yoʻnaltirilgan. Hech narsa qilib boʻlmasa ham, nimadir qilayotganingizda oʻzingizni yaxshiroq his qilasiz. Bu kuchni toʻgʻri yoʻnaltiring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiên về hành động. Bạn thấy khá hơn khi đang làm gì đó — kể cả khi chẳng có gì để làm. Hãy dồn năng lượng đó đúng chỗ."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda ukwenza. Uziva ungcono xa wenza into ngayo — nokuba akukho nto inokwenziwa. Loo mandla wasebenzise kakuhle."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ràn ìgbésẹ̀. Ara máa ń tù yín nígbà tí ẹ bá ń ṣe nǹkan kan nípa rẹ̀ — kódà tí kò bá sí nǹkan láti ṣe. Ẹ darí agbára yẹn dáadáa."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動派。為問題做點甚麼會讓你好過些，即使根本無事可做。好好運用這股力量。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋头做点有用的事"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是行動派。只要有在做點什麼，你就會好過一些，就算其實沒什麼能做。好好善用這股能量。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungumuntu wezenzo. Uzizwa ungcono uma wenza okuthile ngakho — noma ngabe akukho okungenziwa. Lawo mandla wasebenzise kahle."
          }
        }
      }
    },
