    "Match their energy. Send something playful — a voice note, a silly pic." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاروا طاقة شريكك. أرسلوا شيئًا مرحًا: رسالة صوتية أو صورة طريفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaď se na energii protějšku. Pošli něco hravého – hlasovku, praštěnou fotku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg din partners energi. Send noget legesygt – en talebesked, et fjollet billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steig auf die Energie deines Schatzes ein. Schick etwas Verspieltes – eine Sprachnachricht, ein albernes Foto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συντονίσου με την ενέργεια του ταιριού σου. Στείλε κάτι παιχνιδιάρικο — ένα φωνητικό, μια χαζή φωτογραφία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue su ritmo. Envíale algo divertido: una nota de voz, una foto tonta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mene samalle aallolle. Lähetä jotain leikkisää – ääniviesti tai hassu kuva."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapatan ang enerhiya niya. Magpadala ng makulit — voice note, nakakatawang litrato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suis son énergie. Envoie quelque chose de drôle : un vocal, une photo idiote."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתאים את האנרגיה. לשלוח משהו שובב — הודעה קולית, תמונה מטופשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी ऊर्जा से मेल खाएँ। कुछ मज़ेदार भेजें — कोई वॉइस नोट, कोई बेतुकी फ़ोटो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedd fel a ritmusát. Küldj valami játékosat – egy hangüzenetet, egy vicces képet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti energinya. Kirim sesuatu yang jenaka — pesan suara, foto konyol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui la sua energia. Manda qualcosa di giocoso — un vocale, una foto buffa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーのテンションに合わせて、ボイスメッセージやおもしろ写真など、遊び心のあるものを送りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인의 에너지에 맞춰 음성 메시지나 엉뚱한 사진처럼 장난스러운 걸 보내 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikut rentak tenaganya. Hantar sesuatu yang ceria — nota suara, gambar lucu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Møt partneren din med samme energi. Send noe lekent – en talemelding, et fjollete bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit aan bij de energie van je partner. Stuur iets speels – een spraakbericht, een gekke foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasuj się do tej energii. Wyślij coś zabawnego – wiadomość głosową, śmieszne zdjęcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe a energia. Mande algo divertido — um áudio, uma foto boba."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intră pe aceeași frecvență. Trimite ceva jucăuș — un mesaj vocal, o poză trăsnită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подстройся под энергию партнёра. Отправь что-нибудь игривое — голосовое, смешное фото."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcha energin. Skicka något lekfullt – ett röstmeddelande, en fånig bild."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นตามพลังของคนรัก ส่งอะไรขำๆ ไป ข้อความเสียงหรือรูปตลกๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerjisine eşlik et. Eğlenceli bir şey gönder: bir sesli mesaj, komik bir fotoğraf."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підхопи енергію. Надішли щось грайливе — голосове, кумедне фото."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hòa cùng năng lượng của người ấy. Gửi gì đó tinh nghịch — một tin nhắn thoại, một tấm ảnh ngộ nghĩnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟上另一半的节奏，发点好玩的：一段语音、一张搞怪照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟上對方的能量，傳點好玩的：一段語音、一張搞笑照片。"
          }
        }
      }
    },
    "Matching the mode they need avoids friction." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاراة ما يحتاجه شريكك تجنّب الاحتكاك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se trefíš do toho, co zrovna potřebuje, vyhnete se třenicím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du rammer det, der er brug for, undgår I gnidninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den richtigen Modus trifft, vermeidet Reibung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δώσεις αυτό που χρειάζεται εκείνη τη στιγμή, αποφεύγετε τις τριβές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptarte a lo que necesita evita roces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun osut siihen, mitä hän tarvitsee, vältätte kitkaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naiiwasan ang alitan kapag tinapatan mo ang kailangan niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'adapter à ce dont l'autre a besoin évite les frictions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמתאימים את הגישה למה שצריך, נמנע חיכוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें जिस तरह का साथ चाहिए, वही देने से टकराव नहीं होता।"
          }
        },
        "hu" : {
