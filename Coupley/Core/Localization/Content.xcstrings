        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najveća fleksibilnost – ili iskrena nesigurnost. Kako god, ne veže te nijedno mjesto, a to je prava sloboda."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon fleksibilite total — oswa yon vrè ensètitid. Kèlkeswa, ou pa mare ak yon kote presi, e se yon vrè libète."
