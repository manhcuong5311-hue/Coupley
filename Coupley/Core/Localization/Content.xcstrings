          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn cảnh quyết định. Một chuyến cuối tuần ở thành phố khác với tuần trăng mật, ngân sách cũng phải khác. Rất thực tế."
