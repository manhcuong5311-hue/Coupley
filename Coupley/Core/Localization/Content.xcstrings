        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az otthoni munka ma már a valóság. Egy rendes munkasarok számít a hatékonyságod és a lelki békéd szempontjából."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տնից աշխատելն այսօր իրականություն է։ Պատշաճ տարածք ունենալը կարևոր է և՛ արդյունավետությանդ, և՛ հոգեկան հանգստությանդ համար։"
