        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप आज में जीते हैं। साझा बजट शुरू में बंधन जैसा लग सकता है, पर लंबे समय में यह आपको और ज़्यादा आज़ादी दे सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živiš u sadašnjosti. Zajednički budžet u početku se može činiti ograničavajućim, ali dugoročno ti zapravo može dati više slobode."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou viv nan prezan. Yon bidjè an komen ka sanble twò sere okòmansman, men alontèm li ka ba ou plis libète."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenben élsz. A közös költségvetés elsőre korlátozónak tűnhet, de hosszú távon valójában több szabadságot adhat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու ապրում ես ներկայով։ Ընդհանուր բյուջեն սկզբում կարող է սահմանափակող թվալ, բայց երկար ժամկետում իրականում ավելի շատ ազատություն կտա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hidup di saat ini. Anggaran bersama mungkin terasa mengekang awalnya, tapi justru bisa memberimu lebih banyak kebebasan dalam jangka panjang."
