        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ታማኝ መልስ። ስለ ገንዘብ ማውራት ምቾት ባይሰጥም አስፈላጊ ነው — እያንዳንዳችሁ ስለሱ ምን *እንደሚሰማችሁ* በማውራት መጀመር ጥሩ የመጀመሪያ እርምጃ ነው።"
