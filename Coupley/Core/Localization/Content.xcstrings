        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ናብ መጻኢ ዝጥምቱ ሕቶታት ርክብ የዕምቑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geljege gönükdirilen soraglar ýakynlygy çuňlaşdyrýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleceğe dönük sorular bağı derinleştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питання про майбутнє поглиблюють зв’язок."
