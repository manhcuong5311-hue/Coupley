        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સમજદારીભર્યો જવાબ — અને ઘણી વાર સૌથી સ્વસ્થ. જ્યાં જરૂરી હોય ત્યાં સાથે, જ્યાં મહત્વનું હોય ત્યાં સ્વતંત્ર."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsa mai zurfi — kuma sau da yawa mafi lafiya. Tare inda ya dace, dabam inda ya fi muhimmanci."
