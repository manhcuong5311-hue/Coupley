          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvällä tuulella tehdyt suunnitelmat pitävät paremmin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag maganda ang mood, mas natutuloy ang mga plano."
