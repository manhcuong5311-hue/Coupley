    "It's still in there. Life crowded it out. A book-recommending partner might be the nudge." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis nog daar binne. Die lewe het dit net uitgedruk. ’n Maat wat boeke aanbeveel, kan dalk die stoot wees."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አሁንም በውስጥዎ አለ። የሕይወት ውጣ ውረድ ጊዜውን ወሰደበት። መጻሕፍትን የሚጠቁሙ አጋር ገፊ ኃይሉ ሊሆኑ ይችላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشغف ما زال موجودًا، لكن زحام الحياة أبعده. شريك يرشّح الكتب قد يكون الدفعة المطلوبة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অভ্যাসটো এতিয়াও আছে। জীৱনৰ ব্যস্ততাই তাক হেঁচি ধৰিছে। কিতাপৰ পৰামৰ্শ দিয়া সংগী এজনেই হয়তো সেই ঠেলাটো হ'ব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu həvəs hələ də içindədir. Sadəcə həyat onu sıxışdırıb. Kitab tövsiyə edən partnyor elə lazım olan təkan ola bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яно нікуды не дзелася. Проста жыццё яго выцесніла. Палавінка, якая раіць кнігі, можа стаць добрым штуршком."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Още е там. Животът просто го измести. Половинка, която препоръчва книги, може да е тласъкът."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভালোবাসাটা এখনো আছে। জীবনের ভিড়ে শুধু জায়গা হারিয়েছে। বই সাজেস্ট করা পার্টনারই হয়তো সেই আলতো ধাক্কা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još je to u tebi. Život je to samo potisnuo. Voljena osoba koja preporučuje knjige možda je baš potreban podsticaj."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara hi és. La vida l'ha arraconat. Una parella que et recomani llibres pot ser l'empenta que et falta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořád to v tobě je. Jen to život vytlačil. Protějšek, který doporučuje knihy, může být ten správný impuls."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae'r awydd yn dal yno. Mae bywyd wedi'i wthio o'r neilltu. Gallai partner sy'n argymell llyfrau fod yr hwb sydd ei angen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lysten er der stadig. Livet fyldte bare for meget. En partner, der anbefaler bøger, kan være det puf, du mangler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es steckt noch in dir. Das Leben hat es nur verdrängt. Wenn dein Schatz dir Bücher empfiehlt, könnte das der Anstoß sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι ακόμα εκεί. Η καθημερινότητα απλώς δεν του άφησε χώρο. Ένα ταίρι που προτείνει βιβλία ίσως είναι το σκουντηματάκι που χρειάζεσαι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue ahí. La vida lo fue desplazando. Una pareja que te recomiende libros podría ser el empujón."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See on sinus endiselt olemas. Elu lihtsalt tõrjus selle kõrvale. Raamatuid soovitav partner võib olla just see tõuge."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hor dago oraindik. Bizitzak baztertu egin du. Liburuak gomendatzen dituen bikotekide bat izan daiteke behar duzun bultzadatxoa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز در وجودت هست. زندگی جایش را تنگ کرده. پارتنری که کتاب پیشنهاد می‌دهد شاید همان تلنگر باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on yhä sinussa. Elämä vain tunki sen sivuun. Kirjoja suositteleva kumppani voi olla se tönäisy."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nandiyan pa rin ’yan. Natabunan lang ng buhay. Baka ang partner na mahilig magrekomenda ng libro ang tulak na kailangan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est toujours là. La vie a pris toute la place. Quelqu'un qui te conseille des livres pourrait être le petit coup de pouce."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá sé ann fós. Bhrúigh an saol amach é. B’fhéidir gurb é páirtí a mholann leabhair an sonc beag atá uait."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue aí. A vida foino desprazando. Unha parella que recomende libros pode ser o empurrón."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ હજી અંદર છે. જિંદગીની ભીડમાં બાજુએ રહી ગયું. પુસ્તકો સૂચવતા પાર્ટનર કદાચ એ જ હળવો ધક્કો બને."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har yanzu yana nan a cikinku. Rayuwa ce ta matse shi. Abokin zama mai ba da shawarar littattafai na iya zama ɗan turawar da kuke buƙata."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה עדיין שם. החיים פשוט דחקו את זה הצידה. מישהו שממליץ על ספרים אולי יהיה הדחיפה הקטנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह शौक़ अब भी अंदर है। बस ज़िंदगी की भागदौड़ में पीछे छूट गया। किताबें सुझाने वाला पार्टनर शायद वही हल्का-सा धक्का हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još je to u tebi. Život ga je samo potisnuo. Voljena osoba koja preporučuje knjige mogla bi biti taj poticaj."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li la toujou anndan ou. Lavi a jis pran tout plas la. Yon patnè ki rekòmande liv ka ba ou ti pouse a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még benned van. Az élet kiszorította. Egy könyveket ajánlgató társ lehet a lökés."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այն դեռ քո մեջ է, պարզապես կյանքը դուրս է մղել։ Գրքեր խորհուրդ տվող զուգընկերը կարող է լինել այն մղումը, որ պետք է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minatnya masih ada. Hanya tergeser kesibukan. Pasangan yang suka merekomendasikan buku mungkin bisa jadi pendorongnya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ ka dị n'ime gị. Ndụ juru ya. Onye gị na-atụ aro akwụkwọ nwere ike ịbụ mkpali ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það er enn til staðar. Lífið ýtti því bara til hliðar. Maki sem mælir með bókum gæti verið hvatningin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passione c’è ancora. La vita le ha tolto spazio. Un partner che ti consiglia libri potrebbe essere la spinta giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その気持ちはまだ残っています。忙しさに押し出されただけ。本をすすめてくれるパートナーが、きっかけになるかもしれません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isih ana ing njero. Mung kesurung karo kesibukan urip. Pasangan sing seneng menehi rekomendasi buku bisa dadi pangeling alus."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ჯერ კიდევ შენშია. უბრალოდ, ცხოვრებამ გამოდევნა. წიგნების მრჩეველი პარტნიორი შეიძლება სწორედ ის ბიძგი იყოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ол әлі де бойыңда бар. Жай ғана өмір оны ығыстырып жіберді. Кітап ұсынатын серік соған түрткі болуы мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "វានៅតែមាននៅក្នុងខ្លួនអ្នក។ ជីវិតរវល់ពេកធ្វើឲ្យវាបាត់ទៅ។ ដៃគូដែលចូលចិត្តណែនាំសៀវភៅ អាចជាកម្លាំងរុញដែលអ្នកត្រូវការ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅದು ಇನ್ನೂ ನಿಮ್ಮೊಳಗಿದೆ. ಬದುಕಿನ ಜಂಜಾಟ ಅದನ್ನು ಬದಿಗೆ ಸರಿಸಿದೆ. ಪುಸ್ತಕ ಸೂಚಿಸುವ ಸಂಗಾತಿಯೇ ಆ ಮೃದು ಜ್ಞಾಪನೆಯಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음은 여전히 남아 있어요. 바쁜 삶에 밀려났을 뿐이죠. 책을 추천해 주는 연인이 계기가 될지도 몰라요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hê jî di te de ye. Jiyanê ew paşve xist. Belkî hevjînek ku pirtûkan pêşniyar dike, dehfa ku hewce dikî be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ал сенде дагы эле бар. Жашоо аны четке сүрүп койду. Китеп сунуштаган сүйгөнүң ошол түрткү болушу мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ass nach ëmmer do. D'Liewen huet et just verdrängt. E Schatz, deen der Bicher recommandéiert, kéint de klenge Stupp sinn."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ມັນຍັງຢູ່ໃນຕົວເຈົ້າ ພຽງແຕ່ຊີວິດຫຍຸ້ງຈົນບໍ່ມີເວລາ ຄູ່ທີ່ມັກແນະນຳໜັງສືອາດເປັນແຮງຊຸກຍູ້ທີ່ເຈົ້າຕ້ອງການ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai vis dar tavyje. Tiesiog gyvenimas išstūmė. Knygas rekomenduojanti antroji pusė gali būti tas postūmis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas joprojām ir tevī. Dzīve to vienkārši izspieda. Otrā puse, kas iesaka grāmatas, varētu būt tas mudinājums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbola ao ihany izany. Ny fiainana no nanosika azy hiala. Mety ho olon-tiana manoro boky no hanosika anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei reira tonu. Nā te pukumahi o te oranga i pana atu. Mā tētahi hoa aroha e tūtohu pukapuka pea koe e akiaki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сè уште е тука. Животот само го истисна. Половинка што препорачува книги можеби е токму поттикот."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അത് ഇപ്പോഴും ഉള്ളിലുണ്ട്. ജീവിതത്തിരക്കിൽ മാറിപ്പോയെന്ന് മാത്രം. പുസ്തകങ്ങൾ നിർദേശിക്കുന്ന ഒരു പങ്കാളി ആ ചെറിയ തള്ളലാകാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ дотор чинь байсаар байна. Амьдрал л шахаж гаргачихсан. Ном санал болгодог хань түлхэц болж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ती आवड अजूनही तुमच्यात आहे. आयुष्याच्या गर्दीत ती मागे पडली. जोडीदाराने पुस्तके सुचवली, तर कदाचित तोच हलकासा धक्का ठरेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minat itu masih ada. Kesibukan hidup menenggelamkannya. Pasangan yang suka mencadangkan buku mungkin jadi pendorongnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għadu hemm ġewwa. Il-ħajja warrbitu. Partner li jirrakkomanda l-kotba jista' jkun l-imbotta li għandek bżonn."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အဲဒီဝါသနာ ရှိနေတုန်းပါ။ ဘဝရဲ့ အလုပ်များမှုက နေရာယူသွားတာပါ။ စာအုပ်အကြံပြုတတ်တဲ့ ချစ်သူက တွန်းအားလေး ဖြစ်လာနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er der fortsatt. Livet presset det bort. En partner som anbefaler bøker, kan være dultet du trenger."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्यो चाह अझै भित्र छ। जीवनको व्यस्तताले छेकिदियो। किताब सुझाउने पार्टनर नै त्यो हल्का धक्का बन्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zit er nog in. Het leven drong het naar de achtergrond. Een partner die boeken aanraadt, kan het seintje zijn."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chikondi chimenecho chidakalipo. Moyo unangochikankhira pambali. Wokondedwa wokonda kulangiza mabuku angakhale chokukumbutsani."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ammallee si keessa jira. Jireenyi iddoo dhabsiise malee. Kitaabni jaalallee kee irraa siif dhufu yaadachiisa laafaa ta'uu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଏବେ ବି ଭିତରେ ଅଛି। ଜୀବନର ବ୍ୟସ୍ତତା ଏହାକୁ ପଛରେ ପକାଇଦେଲା। ବହି ପରାମର୍ଶ ଦେଉଥିବା ସାଥୀ ହୁଏତ ସେହି ଛୋଟ ପ୍ରେରଣା ହୋଇପାରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ੌਕ ਹਾਲੇ ਵੀ ਅੰਦਰ ਹੈ, ਬੱਸ ਜ਼ਿੰਦਗੀ ਦੀ ਭੀੜ ਵਿੱਚ ਪਿੱਛੇ ਰਹਿ ਗਿਆ। ਜੇ ਪਾਰਟਨਰ ਕਿਤਾਬਾਂ ਸੁਝਾਉਂਦੇ ਹਨ, ਤਾਂ ਸ਼ਾਇਦ ਇਹੀ ਉਹ ਹਲਕਾ ਜਿਹਾ ਹੁਲਾਰਾ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wciąż w tobie jest. Życie po prostu to wyparło. Druga połówka, która poleca książki, może być tym impulsem."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لېوالتیا لا هم شته. ژوند یې ځای ونیو. هغه ملګری چې کتابونه وړاندیز کوي، کېدای شي همدا نرمه یادونه وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso ainda está aí. A vida foi ocupando o espaço. Um amor que indica livros pode ser o empurrãozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua aí dentro. A vida ocupou o espaço. Um par que recomende livros pode ser o empurrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă e acolo. Viața doar l-a împins pe plan secundar. Un partener care recomandă cărți ar putea fi imboldul de care ai nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любовь к чтению никуда не делась — её просто вытеснила жизнь. Партнёр, который советует книги, может стать тем самым толчком."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biracyakurimo. Ubuzima ni bwo bwabibujije umwanya. Umukunzi ukurangira ibitabo ashobora kuba ari we ugusunika."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඒ ආසාව තවමත් තියෙනවා. ජීවිතේ කාර්යබහුලකම ඒක යට කළා විතරයි. පොත් නිර්දේශ කරන සහකරුවෙක් ඒකට අවශ්‍ය තල්ලුව වෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále to v tebe je. Život to len vytlačil. Polovička, ktorá odporúča knihy, môže byť tým postrčením."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še vedno je v tebi. Življenje ga je le izrinilo. Partner, ki priporoča knjige, je morda ravno prava spodbuda."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvichiripo mauri. Hupenyu hwakazvisundira kure. Mudiwa anokurudzira mabhuku angava chiyeuchidzo chidiki chaunoda."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weli way kugu jirtaa. Noloshaa meesha ka saartay. Lammaane buugaag kuu soo jeediya ayaa noqon kara riixa aad u baahan tahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Është ende aty. Jeta thjesht e la mënjanë. Një partner që të rekomandon libra mund të jetë shtytja që të duhet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Још је ту. Живот га је потиснуо. Половина која препоручује књиге можда је баш подстрек који ти треба."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éta masih aya dina diri anjeun. Ngan kadedetkeun ku kasibukan. Pasangan anu resep ngarékoméndasikeun buku meureun tiasa janten pangdorongna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns kvar där inne. Livet trängde undan det. En partner som tipsar om böcker kan vara knuffen du behöver."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upendo huo bado upo ndani yako. Shughuli za maisha zimeusukuma kando. Mwenzi anayependekeza vitabu anaweza kuwa msukumo unaohitaji."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அது இன்னும் உங்களுக்குள் இருக்கிறது. வாழ்க்கை அதை ஒதுக்கிவிட்டது. புத்தகம் பரிந்துரைக்கும் துணை அந்தச் சிறு தூண்டுதலாக இருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆ ఇష్టం ఇంకా మీలోనే ఉంది. జీవితం దాన్ని పక్కకు నెట్టేసింది. పుస్తకాలు సూచించే భాగస్వామి ఆ చిన్న ప్రోత్సాహం కావచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он ҳанӯз дар туст. Зиндагӣ онро як сӯ тела дод. Ёре, ки китоб тавсия медиҳад, шояд ҳамон такони лозимӣ бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความชอบนั้นยังอยู่ แค่ชีวิตเบียดมันออกไป คนรักที่ชอบแนะนำหนังสืออาจเป็นแรงกระตุ้นที่ใช่"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ገና ኣብ ውሽጥኹም ኣሎ። ህይወት ጸቢባቶ እያ። መጻሕፍቲ ዝመኽር መጻምዲ እቲ ደረኽ ክኸውን ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ol entek seniň içiňde. Durmuş ony gysyp çykardy. Kitap maslahat berýän söýgüli şol ýatlatma bolup biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O istek hâlâ orada. Hayatın yoğunluğu onu geri plana itti. Kitap öneren bir partner o küçük itici güç olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любов до читання нікуди не ділася — просто життя її витіснило. Половинка, яка радить книжки, може стати тим поштовхом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ شوق ابھی بھی موجود ہے، بس زندگی کی مصروفیت نے اسے دبا دیا۔ ساتھی کی طرف سے کتابوں کی سفارش شاید وہی ہلکی سی یاد دہانی ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu qiziqish hali ham bor. Shunchaki hayot tashvishlari uni chetga surdi. Kitob tavsiya qiladigan sherik turtki boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niềm yêu sách vẫn còn đó. Cuộc sống chỉ lấn mất chỗ của nó. Nếu người ấy hay giới thiệu sách, đó có thể là cú hích bạn cần."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusekho ngaphakathi kuwe. Ubomi bukutyhalele ecaleni. Iqabane elicebisa iincwadi linokuba sisikhuthazo osidingayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó ṣì wà nínú yín. Ìgbésí ayé ló tì í sẹ́gbẹ̀ẹ́. Olólùfẹ́ tó ń dábàá ìwé lè jẹ́ ìránlétí kékeré tí ẹ nílò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它一直都在，只是被生活擠走了。一個愛推介書的另一半，或許就是那個推動力。"
          }
        },
        "zh-Hans" : {
