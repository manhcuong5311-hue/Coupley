        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähelepanelikkus on sinu armastuse keel. Sa tõestad, et oled kuulanud, reageerides väikestele detailidele — see on vaikselt võimas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arreta da zure maitasun-hizkuntza. Xehetasun txikiei erantzunez frogatzen duzu entzuten egon zarela — isila, baina indartsua."
