        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجتماعية واستراتيجية. ألعاب الطاولة تدور حول الناس بقدر ما تدور حول اللعبة. هواية مشتركة رائعة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সামাজিক আৰু কৌশলী। ব'ৰ্ড গেম খেলতকৈ মানুহবোৰৰ বিষয়েই বেছি। দুয়ো একেলগে কৰিব পৰা এটা সুন্দৰ চখ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosial və strateji. Stolüstü oyunlarda insanlar oyunun özü qədər önəmlidir. Əla ortaq hobbi."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зносіны і стратэгія. Настольныя гульні — гэта гэтак жа пра людзей, як і пра саму гульню. Выдатнае агульнае хобі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Социално и стратегически. При настолните игри хората са толкова важни, колкото и самата игра. Чудесно общо хоби."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আড্ডাবাজ আর কৌশলী। বোর্ড গেম যতটা খেলার, ততটাই মানুষের। দুজনের একসাথে করার মতো দারুণ শখ।"
