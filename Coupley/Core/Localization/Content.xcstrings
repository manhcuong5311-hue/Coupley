        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যৱহাৰিকভাৱে সহায় কৰাটো আপোনাৰ সহজাত প্ৰবৃত্তি। কেৱল নিশ্চিত হৈ লওক যে সংগীয়ে সমাধান বিচাৰিছে, কেৱল শুনিবলৈ কোনোবা নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnstinktin praktik kömək etməkdir. Sadəcə onun həll yolu istədiyinə, yoxsa dinlənmək istədiyinə əmin ol."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой інстынкт — дапамагчы справай. Толькі пераканайся, што палавінцы патрэбныя рашэнні, а не проста той, хто выслухае."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
