        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აწმყოთი ცხოვრობ. საერთო ბიუჯეტი თავიდან შეზღუდვად შეიძლება მოგეჩვენოს, მაგრამ დროთა განმავლობაში სინამდვილეში მეტ თავისუფლებას მოგცემს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен бүгінмен өмір сүресің. Ортақ бюджет алғашында тар көрінуі мүмкін, бірақ ұзақ мерзімде шын мәнінде көбірек еркіндік береді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នករស់នៅក្នុងបច្ចុប្បន្ន។ ថវិការួមអាចមានអារម្មណ៍ថាតឹងតែងនៅដំបូង ប៉ុន្តែតាមពិតវាអាចផ្ដល់សេរីភាពច្រើនជាងមុនក្នុងរយៈពេលវែង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ವರ್ತಮಾನದಲ್ಲಿ ಬದುಕುತ್ತೀರಿ. ಜಂಟಿ ಬಜೆಟ್ ಮೊದಮೊದಲು ಕಟ್ಟುಪಾಡಿನಂತೆ ಅನಿಸಬಹುದು, ಆದರೆ ದೀರ್ಘಾವಧಿಯಲ್ಲಿ ಅದು ನಿಮಗೆ ಹೆಚ್ಚು ಸ್ವಾತಂತ್ರ್ಯ ನೀಡಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금을 사는 타입이에요. 공동 예산이 처음엔 답답할 수 있지만, 길게 보면 오히려 더 많은 자유를 줄 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu di niha de dijî. Dibe ku budçeyeke hevpar di destpêkê de teng xuya bike, lê di demeke dirêj de dikare bêtir azadî bide te."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен бүгүнкү күн менен жашайсың. Жалпы бюджет башында тар сезилиши мүмкүн, бирок узак мөөнөттө ал сага көбүрөөк эркиндик берет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lieft am Moment. E gemeinsame Budget kann am Ufank streng wierken, mee op laang Siicht gëtt e dir souguer méi Fräiheet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າໃຊ້ຊີວິດກັບປັດຈຸບັນ ງົບປະມານຮ່ວມກັນອາດຮູ້ສຶກຈຳກັດໃນຕອນທຳອິດ ແຕ່ໃນໄລຍະຍາວມັນອາດໃຫ້ອິດສະຫຼະກັບເຈົ້າຫຼາຍຂຶ້ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gyveni dabartimi. Bendras biudžetas iš pradžių gali atrodyti ribojantis, bet ilgainiui jis gali suteikti daugiau laisvės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dzīvo tagadnē. Kopīgs budžets sākumā var šķist ierobežojošs, bet ilgtermiņā tas patiesībā var dot vairāk brīvības."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miaina ny ankehitriny ianao. Mety ho toa mamatotra amin'ny voalohany ny tetibola iraisana, nefa mety hanome fahalalahana bebe kokoa anao izany amin'ny fotoana maharitra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka noho koe i te wā o nāianei. Tērā pea ka rongo koe he here te mahere moni tahi i te tīmatanga, engari ka nui ake pea tō herekoretanga i te roanga atu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живееш во сегашноста. Заедничкиот буџет на почеток може да ти делува ограничувачки, но на долг рок всушност може да ти даде повеќе слобода."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ഈ നിമിഷത്തിൽ ജീവിക്കുന്നു. ഒരു പൊതു ബജറ്റ് ആദ്യം ഒരു കെട്ടുപാടായി തോന്നിയേക്കാം, പക്ഷേ ദീർഘകാലത്തിൽ അത് നിങ്ങൾക്ക് കൂടുതൽ സ്വാതന്ത്ര്യം നൽകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи одоо цагтаа амьдардаг. Хамтын төсөв эхэндээ хязгаарласан мэт санагдаж болох ч урт хугацаандаа илүү их эрх чөлөө өгч чадна."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही वर्तमानात जगता. सामायिक बजेट सुरुवातीला बंधनासारखे वाटेल, पण दीर्घकाळात ते तुम्हाला अधिक स्वातंत्र्य देऊ शकते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda hidup untuk masa kini. Bajet bersama mungkin terasa mengongkong pada mulanya, tetapi ia sebenarnya boleh memberi anda lebih kebebasan dalam jangka panjang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tgħix fil-preżent. Baġit komuni jista' jidher restrittiv għall-ewwel, imma fit-tul jista' fil-fatt jagħtik aktar libertà."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် ပစ္စုပ္ပန်မှာ နေတယ်။ ဘုံဘတ်ဂျက်က အစပိုင်းမှာ ချုပ်ချယ်သလို ခံစားရပေမဲ့ ရေရှည်မှာ တကယ်တော့ လွတ်လပ်မှု ပိုပေးနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lever i nået. Et felles budsjett kan føles begrensende i starten, men kan faktisk gi deg mer frihet på sikt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं वर्तमानमा बाँच्नुहुन्छ। साझा बजेट सुरुमा बन्धनजस्तो लाग्ला, तर लामो समयमा यसले तपाईंलाई झन् बढी स्वतन्त्रता दिन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij leeft in het nu. Een gezamenlijk budget voelt eerst misschien beperkend, maar kan je op de lange termijn juist meer vrijheid geven."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakhala ndi moyo wa pano. Bajeti yogawana ingaoneke ngati yokuletsani poyamba, koma ingakupatseni ufulu wochuluka m'kupita kwa nthawi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo ammaa keessa jiraatta. Baajanni waliinii jalqaba irratti si daangessuu fakkaata, garuu yeroo dheeraaf bilisummaa caalu siif kennuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ବର୍ତ୍ତମାନରେ ବଞ୍ଚନ୍ତି। ମିଳିତ ବଜେଟ୍ ପ୍ରଥମେ ବାନ୍ଧି ରଖିଲା ଭଳି ଲାଗିପାରେ, କିନ୍ତୁ ଲମ୍ବା ସମୟରେ ଏହା ଆପଣଙ୍କୁ ଅଧିକ ସ୍ୱାଧୀନତା ଦେଇପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਅੱਜ ਵਿੱਚ ਜਿਉਂਦੇ ਹੋ। ਸਾਂਝਾ ਬਜਟ ਸ਼ੁਰੂ ਵਿੱਚ ਬੰਦਸ਼ ਵਰਗਾ ਲੱਗ ਸਕਦਾ ਹੈ, ਪਰ ਲੰਮੇ ਸਮੇਂ ਵਿੱਚ ਇਹ ਅਸਲ ਵਿੱਚ ਤੁਹਾਨੂੰ ਵੱਧ ਆਜ਼ਾਦੀ ਦੇ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żyjesz chwilą. Wspólny budżet na początku może cię uwierać, ale na dłuższą metę może dać ci więcej swobody."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په اوسني وخت کې ژوند کوئ. ګډه بودیجه ښايي په پیل کې محدودوونکې ښکاره شي، خو په اوږد مهال کې تاسو ته ډېره ازادي درکولی شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vive o presente. Um orçamento a dois pode parecer limitante no começo, mas a longo prazo pode trazer mais liberdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vives o presente. Um orçamento a dois pode parecer limitador ao início, mas a longo prazo pode até dar-te mais liberdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trăiești în prezent. Un buget comun ți se poate părea restrictiv la început, dar pe termen lung îți poate da chiar mai multă libertate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты живёшь настоящим. Общий бюджет поначалу может казаться ограничением, но в долгую он даёт больше свободы."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubaho mu gihe cy'ubu. Ingengo y'imari musangiye ishobora kubanza kukubangamira, ariko mu by'ukuri ishobora kuguha ubwisanzure burenzeho mu gihe kirekire."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ජීවත් වෙන්නේ වර්තමානයේ. පොදු අයවැයක් මුලින් සීමා කරනවා වගේ දැනෙයි, ඒත් දිගුකාලීනව ඒකෙන් ඔබට ඇත්තටම වැඩි නිදහසක් ලැබෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiješ prítomnosťou. Spoločný rozpočet sa ti spočiatku môže zdať obmedzujúci, ale z dlhodobého hľadiska ti môže dať viac slobody."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živiš v sedanjosti. Skupni proračun se ti lahko sprva zdi omejujoč, dolgoročno pa ti lahko da več svobode."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unorarama zviripo. Hurongwa hwemari hwamunogovana hungaita sehunokusunga pakutanga, asi hunogona kukupa rusununguko rwakawanda munguva refu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad ku nooshahay xilligan. Miisaaniyad la wadaago waxay marka hore kula ekaan kartaa xannibaad, laakiin muddo dheer kadib waxay ku siin kartaa xorriyad badan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeton në të tashmen. Një buxhet i përbashkët mund të duket kufizues në fillim, por në afat të gjatë mund të të japë më shumë liri."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живиш у садашњости. Заједнички буџет у почетку може деловати као стега, али дугорочно ти заправо може дати више слободе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun hirup dina kiwari. Anggaran babarengan panginten karaos ngawatesan dina awalna, tapi saleresna tiasa masihan langkung seueur kabébasan dina jangka panjang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lever i nuet. En gemensam budget kan kännas begränsande först, men i längden kan den faktiskt ge dig mer frihet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaishi wakati wa sasa. Bajeti ya pamoja inaweza kuonekana kubana mwanzoni, lakini kwa muda mrefu inaweza kukupa uhuru zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் நிகழ்காலத்தில் வாழ்கிறீர்கள். பகிர்ந்த பட்ஜெட் முதலில் கட்டுப்பாடாகத் தோன்றலாம், ஆனால் நீண்ட காலத்தில் அது உங்களுக்கு அதிக சுதந்திரம் தரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు వర్తమానంలో జీవిస్తారు. కలిసి వేసే బడ్జెట్ మొదట్లో కట్టడిగా అనిపించవచ్చు, కానీ దీర్ఘకాలంలో అది మీకు ఎక్కువ స్వేచ్ఛనిస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар лаҳзаи ҳозира зиндагӣ мекунӣ. Буҷаи муштарак аввал маҳдудкунанда менамояд, вале дар дарозмуддат метавонад ба ту озодии бештар диҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณใช้ชีวิตกับปัจจุบัน งบร่วมกันอาจรู้สึกอึดอัดในช่วงแรก แต่ในระยะยาวกลับให้อิสระกับคุณมากขึ้น"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ህሉው ግዜ ትነብሩ። ናይ ሓባር በጀት ኣብ መጀመርታ ዝእስር ክመስል ይኽእል፣ ብነዊሕ ግዜ ግን ዝያዳ ናጽነት ክህበኩም ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen häzirki pursatda ýaşaýarsyň. Umumy býujet ilkibaşda gysyp duran ýaly duýulyp biler, ýöne uzak möhletde saňa has köp erkinlik berip biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdide yaşıyorsun. Ortak bir bütçe ilk başta kısıtlayıcı gelebilir ama uzun vadede sana aslında daha fazla özgürlük sağlayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти живеш теперішнім. Спільний бюджет спершу може здаватися обмеженням, але в довгій перспективі він дає більше свободи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے لیے حال ہی سب کچھ ہے۔ مشترکہ بجٹ شروع میں پابندی لگ سکتا ہے، مگر طویل مدت میں یہ دراصل آپ کو زیادہ آزادی دے سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz bugun bilan yashaysiz. Umumiy byudjet avvaliga cheklovdek tuyulishi mumkin, lekin uzoq muddatda aslida koʻproq erkinlik beradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sống cho hiện tại. Ngân sách chung lúc đầu có thể thấy gò bó, nhưng về lâu dài lại cho bạn nhiều tự do hơn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uphila ngoku. Ibhajethi enabelana ngayo inokuvakala ikuthintela ekuqaleni, kodwa inokukunika inkululeko engakumbi kwixesha elide."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìsinsìnyí lẹ ń gbé. Ètò ìnáwó àjọṣe lè dà bí ìdènà ní àkọ́kọ́, ṣùgbọ́n ó lè fún yín ní òmìnira púpọ̀ sí i ní ọjọ́ iwájú."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你活在當下。共同預算起初可能讓你覺得被綁住，但長遠來看，其實能給你更多自由。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你活在当下。共同预算起初可能让你觉得受限，但长远来看反而能给你更多自由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你活在當下。共同預算一開始可能讓你覺得被綁住，但長遠來看，其實能給你更多自由。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uphila manje. Isabelomali esabelwanayo singazwakala sikuvimba ekuqaleni, kodwa empeleni singakunika inkululeko eyengeziwe esikhathini eside."
          }
        }
      }
    },
    "You love language enough to play with it. Puns are dad jokes done with commitment — and that takes guts." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy is lief genoeg vir taal om daarmee te speel. Woordspelings is pa-grappe met oortuiging – en dit vra moed."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቋንቋን በጣም ስለሚወዱ ይጫወቱበታል። የቃላት ጨዋታ ቀዝቃዛ ቀልድ በሙሉ ልብ ሲቀርብ ነው — ይህም ድፍረት ይጠይቃል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحبون اللغة بما يكفي لتلعبوا بها. التورية نكتة ساذجة تُلقى بكل جدية، وهذا يتطلب جرأة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাষাক আপুনি ইমান ভাল পায় যে তাৰ লগত খেলে। শ্লেষ মানে পূৰ্ণ নিষ্ঠাৰে কোৱা পুৰণি ধৰণৰ ধেমালি — আৰু তাৰ বাবে সাহস লাগে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili onunla oynayacaq qədər sevirsən. Söz oyunu bütün qəlbinlə deyilmiş “ata zarafatı”dır — və bunun üçün cəsarət lazımdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты так любіш мову, што гуляеш з ёй. Каламбуры — гэта «бацькоўскія жарты», расказаныя ад душы, — і для гэтага патрэбна смеласць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обичаш езика достатъчно, за да си играеш с него. Каламбурите са като бащинските шеги, но с пълна отдаденост – а за това се иска кураж."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাষাকে তুমি এতটাই ভালোবাসো যে তা নিয়ে খেলো। শ্লেষ মানে পুরো নিষ্ঠায় বলা বাবা-মার্কা জোক — আর এর জন্য সাহস লাগে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toliko voliš jezik da se igraš s njim. Igre riječi su tatine fore izvedene s punom predanošću – a za to treba hrabrosti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimes prou la llengua per jugar-hi. Els jocs de paraules són acudits fàcils fets amb convicció — i això té mèrit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk tě baví natolik, že si s ním hraješ. Slovní hříčky jsou tátovské vtipy dotažené do konce – a to chce odvahu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n caru iaith ddigon i chwarae gyda hi. Jôcs tadau wedi'u gwneud ag ymroddiad yw chwarae ar eiriau — ac mae angen gyts i wneud hynny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du elsker sproget nok til at lege med det. Ordspil er farvitser leveret med overbevisning – og det kræver mod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du liebst Sprache so sehr, dass du mit ihr spielst. Wortspiele sind Flachwitze mit voller Hingabe – und das braucht Mut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγαπάς τη γλώσσα τόσο που παίζεις μαζί της. Τα λογοπαίγνια είναι μπαμπαδίστικα αστεία με πάθος — και αυτό θέλει θάρρος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te gusta tanto el lenguaje que juegas con él. Los juegos de palabras son chistes malos hechos con convicción, y eso tiene mérito."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armastad keelt piisavalt, et sellega mängida. Kalambuurid on isanaljad, mida tehakse täie pühendumusega — ja selleks on vaja julgust."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizkuntza nahikoa maite duzu harekin jolasteko. Hitz-jokoak aita-txisteak dira konpromisoz eginda, eta horrek kemena eskatzen du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن‌قدر عاشق زبانی که با آن بازی می‌کنی. جناس همان شوخی‌های بی‌مزهٔ پدرانه است که با تعهد کامل گفته می‌شود — و این جرئت می‌خواهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakastat kieltä niin paljon, että leikit sillä. Sanaleikit ovat isävitsejä täydellä antaumuksella – ja se vaatii rohkeutta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahal mo ang wika kaya pinaglalaruan mo ito. Ang puns ay dad jokes na ginagawa nang buong puso — at kailangan ng lakas ng loob diyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aimes assez la langue pour jouer avec. Un calembour, c'est une blague de tonton assumée jusqu'au bout, et il faut du cran."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá oiread grá agat don teanga gur mhaith leat spraoi a bhaint aisti. Is scigireacht thuismitheora iad punanna, ach le tiomantas — agus teastaíonn misneach chuige sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gústache tanto a lingua que xogas con ela. Os xogos de palabras son chistes de pai feitos con convicción, e iso require valor."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમને ભાષા એટલી ગમે છે કે તમે એની સાથે રમો છો. શ્લેષ એટલે પૂરા દિલથી કહેલા “ડૅડ જોક્સ” — અને એ માટે હિંમત જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna son harshe har kuna wasa da shi. Wasa da kalmomi barkwancin iyaye ne da aka yi da himma — kuma hakan na buƙatar ƙarfin hali."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האהבה שלך לשפה מספיק גדולה כדי לשחק בה. משחקי מילים הם בדיחות אבא עם מחויבות מלאה — וזה דורש אומץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाषा आपको इतनी पसंद है कि उससे खेलना आपका शौक़ है। पन पूरे जोश से सुनाए गए ‘डैड जोक्स’ हैं — और इसके लिए हिम्मत चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toliko voliš jezik da se igraš s njim. Dosjetke su tatini vicevi izvedeni s predanošću – a za to treba hrabrosti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou renmen lang nan ase pou ou jwe avè l. Jwe ak mo se blag papa fèt ak tout kè — e sa mande kouraj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annyira szereted a nyelvet, hogy játszol vele. A szóvicc elkötelezetten előadott apuka-poén – és ehhez bátorság kell."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու այնքան ես սիրում լեզուն, որ խաղում ես դրա հետ։ Բառախաղերը «հայրիկի կատակներ» են՝ ամբողջ նվիրումով, և դա համարձակություն է պահանջում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu cukup cinta bahasa sampai mau memainkannya. Plesetan itu lelucon bapak-bapak yang dilakukan dengan sepenuh hati — dan itu butuh nyali."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị hụrụ asụsụ n'anya nke ukwuu i ji egwu egwu na ya. Egwuregwu okwu bụ njakịrị nna e ji obi niile mee — nke ahụ chọrọ obi ike."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú elskar tungumálið nógu mikið til að leika þér að því. Orðaleikir eru pabbabrandarar sagðir af sannfæringu – og það þarf kjark til."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami la lingua al punto da giocarci. I giochi di parole sono freddure fatte con convinzione — e ci vuole coraggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉が好きだからこそ、言葉で遊べる人。ダジャレは全力で言い切ってこそ。それには度胸が要ります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan cukup tresna basa nganti seneng dolanan karo basa. Plesetan iku guyonan bapak-bapak sing ditindakake kanthi temenan — lan iku butuh kendel."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ენა იმდენად გიყვარს, რომ მასთან თამაშობ. კალამბურები ძველმოდური ხუმრობებია, მთელი გულით შესრულებული — და ამას გამბედაობა სჭირდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тілді онымен ойнайтындай жақсы көресің. Каламбур — шын ниетпен айтылған «әке әзілі», бұған батылдық керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកស្រឡាញ់ភាសាខ្លាំងរហូតចង់លេងជាមួយវា។ ការលេងពាក្យគឺជាការកំប្លែងបែបឪពុកដែលធ្វើដោយការប្ដេជ្ញាចិត្ត — ហើយវាទាមទារភាពក្លាហាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಭಾಷೆಯ ಜೊತೆ ಆಟವಾಡುವಷ್ಟು ನಿಮಗೆ ಭಾಷೆ ಇಷ್ಟ. ಶ್ಲೇಷೆಗಳು ಮನಃಪೂರ್ವಕವಾಗಿ ಹೇಳಿದ ಹಳೆಯ ಜೋಕ್‌ಗಳು — ಅದಕ್ಕೆ ಧೈರ್ಯ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말을 갖고 놀 만큼 언어를 사랑해요. 말장난은 진심을 다한 아재 개그고, 그러려면 용기가 필요하죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ewqas ji zimên hez dikî ku pê dilîzî. Lîstikên peyvan henekên bavan in ku bi dil û can tên kirin — û ev cesaretê dixwaze."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тилди аны менен ойногудай жакшы көрөсүң. Сөз оюну — бүт жүрөгү менен айтылган «атанын тамашасы» — бул үчүн кайрат керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hues d'Sprooch esou gär, dass de domat spills. Kalauer si Papp-Witzer mat voller Iwwerzeegung — an dat brauch Courage."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຮັກພາສາຫຼາຍພໍທີ່ຈະຫຼິ້ນກັບມັນ ມຸກຫຼິ້ນຄຳຄືມຸກແຫ້ງທີ່ເລົ່າຢ່າງໝັ້ນໃຈ — ແລະ ນັ້ນຕ້ອງໃຊ້ຄວາມກ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek myli kalbą, kad su ja žaidi. Kalambūrai – tai tėtiški juokeliai, pasakyti su visu atsidavimu, – ir tam reikia drąsos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tik ļoti mīli valodu, ka ar to spēlējies. Vārdu spēles ir tēta joki ar pilnu atdevi – un tam vajag drosmi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tia ny fiteny ianao ka milalao aminy. Vazivazy tsotra natao amin'ny fo manontolo ny kilalao teny — ary mila herim-po izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nui tō aroha ki te reo kia tākaro ai koe ki a ia. Ko ngā tākaro kupu he kata a te matua i mahia me te ngākau katoa — ā, me māia koe."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толку го сакаш јазикот што си играш со него. Играта на зборови е татковска шега со посветеност — а за тоа треба храброст."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഭാഷയോട് കളിക്കാൻ മാത്രം നിങ്ങൾ അതിനെ സ്നേഹിക്കുന്നു. മനസ്സറിഞ്ഞ് പറയുന്ന പഴഞ്ചൻ തമാശകളാണ് ശ്ലേഷങ്ങൾ — അതിന് ചങ്കൂറ്റം വേണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи хэлэнд тоглохоор дуртай. Үгээр тоглох нь бүх сэтгэлээ зориулсан аавын онигоо — үүнд зориг хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला भाषा इतकी आवडते की तुम्ही तिच्याशी खेळता. कोट्या म्हणजे पूर्ण निष्ठेने केलेले पांचट विनोद — आणि त्यासाठी धाडस लागते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda cukup cintakan bahasa sehingga suka bermain dengannya. Permainan kata ialah lawak bapak-bapak yang dibuat dengan penuh komitmen — dan itu perlukan keberanian."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tħobb il-lingwa biżżejjed biex tilgħab biha. Il-logħob bil-kliem huwa ċ-ċajt tal-missirijiet magħmul b'impenn — u dak jitlob il-kuraġġ."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘာသာစကားကို ကစားချင်လောက်အောင် ချစ်တယ်။ စကားလိမ်ဆိုတာ ဟာသအေးတွေကို စိတ်ပါလက်ပါ ပြောတာပါ — ဒါက သတ္တိ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er glad nok i språket til å leke med det. Ordspill er pappavitser med full innsats – og det krever mot."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंलाई भाषा यति मन पर्छ कि त्यससँग खेल्नुहुन्छ। श्लेष भनेको पूरै लगनले भनिएको बाबाहरूको जोक हो — र त्यसका लागि आँट चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt genoeg van taal om ermee te spelen. Woordgrapjes zijn vadergrappen met overtuiging – en daar is lef voor nodig."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakonda chilankhulo moti mumachisewera. Masewera a mawu ndi nthabwala zakale zochitidwa ndi mtima wonse — ndipo zimafuna kulimba mtima."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afaan hamma itti taphattuutti jaallatta. Taphni jechootaa qoosaa abbootii kan kutannoon dhiyaatu dha — kunis ija jabina gaafata."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଭାଷାକୁ ଆପଣ ଏତେ ଭଲପାଆନ୍ତି ଯେ ତା’ ସହ ଖେଳନ୍ତି। ଶ୍ଳେଷ ହେଲା ପୂରା ମନ ଦେଇ କୁହାଯାଇଥିବା ପୁରୁଣା ଢଙ୍ଗର ଥଟ୍ଟା — ଆଉ ସେଥିପାଇଁ ସାହସ ଲାଗେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਨੂੰ ਭਾਸ਼ਾ ਨਾਲ ਇੰਨਾ ਪਿਆਰ ਹੈ ਕਿ ਤੁਸੀਂ ਉਸ ਨਾਲ ਖੇਡਦੇ ਹੋ। ਸ਼ਬਦਾਂ ਦੀ ਖੇਡ ਪੂਰੇ ਯਕੀਨ ਨਾਲ ਸੁਣਾਏ ਪੁਰਾਣੇ ਚੁਟਕਲੇ ਹਨ — ਅਤੇ ਇਸ ਲਈ ਜਿਗਰਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochasz język na tyle, by się nim bawić. Gry słów to suchary opowiadane z pełnym przekonaniem – a to wymaga odwagi."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ژبه دومره خوښوئ چې ورسره لوبې کوئ. د ټکو لوبې هغه ساده ټوکې دي چې په بشپړ زړه ویل کېږي — او دا زړه غواړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ama tanto as palavras que brinca com elas. Trocadilho é piada de tiozão feita com convicção — e isso exige coragem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostas tanto da língua que brincas com ela. Os trocadilhos são piadas secas feitas com convicção — e isso exige coragem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iubești limba destul cât să te joci cu ea. Jocurile de cuvinte sunt glume de tată spuse cu convingere — și asta cere curaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты так любишь язык, что играешь с ним. Каламбуры — это «папины шутки», рассказанные с полной отдачей, а на это нужна смелость."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukunda ururimi ku buryo ukina na rwo. Gukina n'amagambo ni urwenya rw'ababyeyi rukoranywe ubwitange — kandi ibyo bisaba ubutwari."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වචන එක්ක සෙල්ලම් කරන්න තරම් ඔබ භාෂාවට ආදරෙයි. වචන සෙල්ලම් කියන්නේ මුළු හදවතින්ම කියන තාත්තාගේ විහිළු — ඒකට හිත හයිය ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk ťa baví natoľko, že sa s ním hráš. Slovné hračky sú otcovské vtipy s plným nasadením – a na to treba odvahu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik imaš dovolj rad, da se z njim igraš. Besedne igre so očetovske šale, izvedene s predanostjo – in za to je treba poguma."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoda mutauro zvekuti unotamba nawo. Kutamba nemashoko izvisetso zvababa zvakaitwa nekuzvipira — uye izvozvo zvinoda ushingi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luqadda ayaad u jeceshahay ilaa aad la ciyaarto. Ciyaar-erayadu waa kaftan aabbe oo si dhab ah loo sameeyay — taasina geesinimo ayay u baahan tahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E do gjuhën aq sa të luash me të. Lojërat e fjalëve janë shaka „babai“ të bëra me përkushtim – dhe kjo kërkon guxim."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толико волиш језик да се играш њиме. Игре речи су татине шале изведене с пуном посвећеношћу — а за то треба храбрости."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun cekap resep kana basa dugi ka ulin sareng éta. Plésétan téh bobodoran garing anu dilakukeun kalayan yakin, sareng éta peryogi kawani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du älskar språket så mycket att du leker med det. Ordvitsar är pappaskämt med full inlevelse – och det kräver mod."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unapenda lugha kiasi cha kucheza nayo. Michezo ya maneno ni vichekesho vya kizee vinavyofanywa kwa kujitolea — na hilo linahitaji ujasiri."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மொழியை விளையாடும் அளவுக்கு நேசிக்கிறீர்கள். சிலேடை என்பது முழு ஈடுபாட்டுடன் சொல்லப்படும் ‘மொக்கை ஜோக்’ — அதற்குத் துணிவு வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "భాషతో ఆడుకునేంతగా మీరు దాన్ని ప్రేమిస్తారు. శ్లేషలంటే పూర్తి నమ్మకంతో వేసే పాత జోకులు — దానికి ధైర్యం కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту забонро он қадар дӯст медорӣ, ки бо он бозӣ мекунӣ. Ҷинос — шӯхии падарона бо тамоми дил — ва ин ҷасорат мехоҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรักภาษามากพอจะเล่นกับมัน มุกเล่นคำคือมุกแป้กที่เล่นอย่างทุ่มเท และต้องใช้ความกล้า"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቋንቋ ክሳብ ክትጻወቱሉ ትፈትውዎ። ጸወታ ቃላት ብምሉእ ልቢ ዝቐረበ ናይ ኣቦ ዋዛ እዩ — እዚ ድማ ትብዓት ይሓትት።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili onuň bilen oýnamak derejesinde söýýärsiň. Söz oýunlary — bütin ýürek bilen aýdylýan köne degişmeler — we munuň üçin batyrlyk gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili onunla oynayacak kadar seviyorsun. Kelime oyunları, kararlılıkla yapılmış baba esprileridir ve cesaret ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти настільки любиш мову, що граєшся з нею. Каламбури — це жарти «в стилі тата», сказані з повною віддачею, а на це потрібна сміливість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان سے اتنی محبت کہ اس سے کھیلنا بھی آتا ہے۔ ذومعنی جملے پورے دل سے سنائے گئے پرانے لطیفے ہیں، اور اس کے لیے ہمت چاہیے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilni u bilan oʻynash darajasida sevasiz. Soʻz oʻyinlari — astoydil aytilgan sodda hazillar, va buning uchun jurʼat kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn yêu ngôn ngữ đến mức muốn đùa với nó. Chơi chữ là kiểu đùa nhạt được làm hết mình — và điều đó cần can đảm."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uluthanda ulwimi kangangokuba udlala ngalo. Ukudlala ngamagama ziziqhulo zikatata ezenziwa ngokuzimisela — kwaye oko kufuna isibindi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fẹ́ràn èdè débi pé ẹ ń fi ṣeré. Eré ọ̀rọ̀ jẹ́ àwàdà àgbà tí a ṣe tọkàntọkàn — ìyẹn sì ń béèrè ìgboyà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你愛語言愛得可以拿來玩。雙關語就是全情投入的爛gag，這需要勇氣。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你爱语言，爱到想玩转它。谐音梗是认真讲出来的冷笑话，这可需要勇气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你愛文字愛到想跟它玩。雙關就是全力以赴的冷笑話，這需要勇氣。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthanda ulimi kangangokuthi uyadlala ngalo. Ukudlala ngamagama kungamahlaya obaba enziwe ngokuzimisela — futhi lokho kudinga isibindi."
          }
        }
      }
    },
    "You make space. Being heard without someone jumping to solve it is often the most healing thing — and you provide that." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy maak plek. Om gehoor te word sonder dat iemand dadelik wil regmaak, is dikwels die mees helende ding – en dit gee jy."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቦታ ይሰጣሉ። አንድ ሰው ለመፍታት ሳይቸኩል መደመጥ ብዙ ጊዜ ከሁሉ የሚፈውስ ነገር ነው — እርስዎም ያንን ይሰጣሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفسحون المجال. أن يُسمَع المرء دون أن يسارع أحد إلى حل مشكلته هو غالبًا أكثر ما يشفي، وأنتم تمنحون ذلك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি ঠাই কৰি দিয়ে। কোনোবাই সমাধান দিবলৈ জাপ নিদিয়াকৈ শুনি থকাটো প্ৰায়ে আটাইতকৈ নিৰাময়কাৰী — আৰু আপুনি সেয়াই দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona yer açırsan. Kiminsə dərhal problemi həll etməyə tələsmədən dinləməsi çox vaxt ən şəfalı şeydir — sən də bunu verirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты даеш прастору. Калі цябе слухаюць і не кідаюцца адразу ўсё вырашаць, гэта часта лечыць лепш за ўсё — і ты гэта даеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даваш пространство. Да те чуят, без някой да бърза да решава проблема, често лекува най-много – и ти даваш точно това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি জায়গা করে দাও। কেউ সমাধান দিতে না ঝাঁপিয়ে শুধু শুনলে সেটাই প্রায়ই সবচেয়ে বড় আরাম — আর তুমি সেটাই দাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvaraš prostor. Kad te neko sasluša, a ne žuri da riješi problem, to često najviše liječi – a ti to pružaš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fas espai. Que t'escoltin sense que ningú corri a solucionar-ho sovint és el que més cura — i tu ho dones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáváš prostor. Když tě někdo vyslechne a nespěchá s řešením, často to léčí nejvíc – a ty to umíš dát."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n creu lle. Cael dy glywed heb i rywun neidio i ddatrys yw'r peth sy'n iacháu fwyaf yn aml — ac rwyt ti'n cynnig hynny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du giver plads. At blive hørt, uden at nogen straks vil løse det, er ofte det mest helende – og det giver du."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schaffst Raum. Gehört zu werden, ohne dass jemand gleich eine Lösung parat hat, heilt oft am meisten – und genau das gibst du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δίνεις χώρο. Το να σε ακούνε χωρίς να βιάζονται να το λύσουν είναι συχνά ό,τι πιο θεραπευτικό — κι εσύ το προσφέρεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das espacio. Que te escuchen sin que nadie salte a resolverlo suele ser lo que más sana, y eso es lo que tú ofreces."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa teed ruumi. Kui sind kuulatakse, ilma et keegi kohe lahendama tõttaks, on see sageli kõige tervendavam — ja sina pakud just seda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartea egiten duzu. Inor konpontzera jauzi egin gabe entzuna izatea da sarritan sendagarriena — eta zuk hori ematen duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضا می‌سازی. شنیده شدن بی‌آنکه کسی برای حل کردن بپرد، اغلب شفابخش‌ترین چیز است — و تو این را می‌دهی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annat tilaa. Kun saa tulla kuulluksi ilman, että joku hyppää heti ratkaisemaan, se eheyttää usein eniten – ja sinä tarjoat juuri sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbibigay ka ng espasyo. Ang mapakinggan nang walang nagmamadaling mag-ayos ay kadalasang pinakanakagagaling — at iyan ang ibinibigay mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu laisses de la place. Pouvoir parler sans que quelqu'un cherche aussitôt une solution, c'est souvent ce qui fait le plus de bien, et tu sais l'offrir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déanann tú spás. Éisteacht gan duine ag léim isteach chun é a réiteach — is minic gurb é sin an rud is mó leigheas, agus tugann tusa é."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti fas espazo. Sentir que te escoitan sen que ninguén corra a solucionalo é moitas veces o que máis cura, e ti ofréceslo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે મોકળાશ આપો છો. કોઈ તરત ઉકેલ શોધવા કૂદી ન પડે અને બસ સાંભળે — એ ઘણી વાર સૌથી વધુ રાહત આપે છે, અને તમે એ આપો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna ba da sarari. Jin ana sauraron mutum ba tare da wani ya yi gaggawar warware matsalar ba yawanci shi ne mafi warkarwa — kuma ku kuna bayar da hakan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך יכולת לפנות מקום. כשמקשיבים לך בלי לקפוץ ישר לפתרונות, זה לרוב הדבר הכי מרפא — וזה בדיוק מה שיש לך לתת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जगह देते हैं। बिना किसी के फ़ौरन हल सुझाए सुना जाना अक्सर सबसे बड़ा मरहम होता है — और यह आप देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daješ prostor. Kad te netko sasluša, a ne žuri s rješenjima, to često najviše liječi – a ti upravo to pružaš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou bay espas. Santi yo tande ou san yon moun pa prese rezoud pwoblèm nan, souvan se sa ki geri plis — e se sa ou bay."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teret adsz. Ha valakit úgy hallgatnak meg, hogy nem ugranak rögtön a megoldásra, az gyakran a leggyógyítóbb – és te ezt megadod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու տարածք ես ստեղծում։ Երբ քեզ լսում են, և ոչ ոք չի շտապում խնդիրը լուծել, դա հաճախ ամենաբուժիչն է — և դու հենց դա ես տալիս։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memberi ruang. Didengar tanpa langsung diberi solusi sering kali paling menyembuhkan — dan kamu memberikan itu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-enye oghere. Ka a nụ mmadụ n'enweghị onye na-agba ọsọ idozi ya bụ ọtụtụ mgbe ihe kacha agwọ obi — ma ị na-enye nke ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú býrð til rými. Að fá áheyrn án þess að einhver stökkvi til að leysa málið er oft það sem græðir mest – og það gefur þú."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai spazio. Sentirsi ascoltati senza che qualcuno corra a risolvere tutto è spesso ciò che fa più bene — e tu sai offrirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安心して話せる場をつくれるタイプです。すぐに解決しようとせず、ただ聞いてもらえることが、いちばんの癒やしになることも多いもの。それを自然にできています。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan menehi ruang. Dirungokake tanpa ana sing kesusu ngrampungi iku asring dadi tamba sing paling manjur — lan panjenengan menehi kuwi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სივრცეს უქმნი. როცა გისმენენ და გამოსავლის პოვნას არ ჩქარობენ, ეს ხშირად ყველაზე მეტად კურნავს — და შენ სწორედ ამას აძლევ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен орын бересің. Біреу бірден шешім іздемей тыңдағаны — көбіне ең емдік нәрсе. Ал сен дәл соны бере аласың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកផ្ដល់ចន្លោះឲ្យ។ ការត្រូវបានគេស្ដាប់ ដោយគ្មាននរណាប្រញាប់ដោះស្រាយភ្លាម ច្រើនតែជាអ្វីដែលព្យាបាលចិត្តបំផុត — ហើយអ្នកផ្ដល់វាឲ្យបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಅವಕಾಶ ಕೊಡುತ್ತೀರಿ. ತಕ್ಷಣ ಪರಿಹರಿಸಲು ಮುಂದಾಗದೆ ಯಾರಾದರೂ ಕೇಳಿಸಿಕೊಳ್ಳುವುದೇ ಹಲವು ಬಾರಿ ಅತ್ಯಂತ ಸಾಂತ್ವನ — ಅದನ್ನು ನೀವು ನೀಡುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음 놓고 말할 자리를 만들어 줘요. 섣불리 해결하려 들지 않고 들어 주는 것만큼 큰 위로는 드물어요. 그걸 해 주는 사람이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cih vedikî. Bihîstin bêyî ku kesek bilez çareseriyê bixwaze, gelek caran tiştê herî dermanker e — û tu vê didî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен орун бересиң. Бирөө дароо чечүүгө шашпай угуп турганы көбүнчө эң айыктыруучу нерсе — жана сен ошону бере аласың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du méchs Plaz. Gehéiert ze ginn, ouni datt een direkt eng Léisung sicht, ass dacks dat, wat am meeschten hëlleft — an dat gëss du."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເປີດພື້ນທີ່ໃຫ້ ການມີຄົນຟັງໂດຍບໍ່ຮີບແກ້ບັນຫາ ມັກເປັນສິ່ງທີ່ຊ່ວຍປິ່ນປົວໃຈທີ່ສຸດ — ແລະ ເຈົ້າໃຫ້ສິ່ງນັ້ນໄດ້"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suteiki erdvės. Kai išklauso ir niekas neskuba visko taisyti, tai dažnai labiausiai gydo – ir tu tai dovanoji."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dod vietu. Ja kāds uzklausa, nesteidzoties visu labot, tas bieži dziedē visvairāk – un tieši to tu dod."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manome toerana ianao. Ny hohenoina nefa tsy misy olona maika hamaha ny olana no matetika tena manasitrana indrindra — ary izany no omenao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka whakawātea koe i te wāhi. Ko te whakarongotia me te kore e peke tētahi ki te whakatika, he mea tino whakaora — ā, nāu tēnā e tuku."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвораш простор. Да бидеш сослушано без некој веднаш да брза со решенија често најмногу лечи — а ти токму тоа го даваш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ഇടം നൽകുന്നു. ആരും പരിഹാരവുമായി ചാടിവീഴാതെ കേൾക്കപ്പെടുന്നതാണ് പലപ്പോഴും ഏറ്റവും വലിയ ആശ്വാസം — അത് നിങ്ങൾ നൽകുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи зай гаргаж өгдөг. Шийдэл рүү яаралгүйгээр сонсогдох нь ихэвчлэн хамгийн их эдгээдэг — чи үүнийг өгч чаддаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही जागा देता. कोणी लगेच उपाय सुचवायला न धावता फक्त ऐकून घेणे — हेच अनेकदा सर्वात जास्त दिलासा देते, आणि तुम्ही ते देता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memberi ruang. Didengari tanpa seseorang tergesa-gesa mencari penyelesaian selalunya paling melegakan — dan anda memberikannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toħloq spazju. Li tinstema' mingħajr ma xi ħadd jaqbeż biex isolvi kollox spiss ifejjaq l-aktar — u int toffri dan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် နေရာပေးတတ်တယ်။ ဖြေရှင်းဖို့ ခုန်မဝင်ဘဲ နားထောင်ပေးခံရတာက အများအားဖြင့် စိတ်ဒဏ်ရာကို အကောင်းဆုံး ကုပေးတာပါ — အဲဒါကို သင် ပေးနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gir rom. Å bli hørt uten at noen hopper rett til løsninger, er ofte det som heler mest – og det gir du."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं ठाउँ दिनुहुन्छ। समाधान दिन हतार नगरी कसैले सुनिदिनु प्रायः सबैभन्दा ठूलो मलम हो — र तपाईं त्यही दिनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij maakt ruimte. Gehoord worden zonder dat iemand meteen iets wil oplossen, is vaak het meest helend – en dat geef jij."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumapereka mpata. Kumvedwa popanda wina kufulumira kuthetsa vuto nthawi zambiri ndi chinthu chochiritsa kwambiri — ndipo inu mumapereka zimenezo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iddoo ni kennita. Osoo namni furmaataaf hin ariifatin dhaga'amuun yeroo baay'ee waan caalaatti nama fayyisu dha — ati immoo kana ni kennita."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ସ୍ଥାନ ଦିଅନ୍ତି। କେହି ତୁରନ୍ତ ସମାଧାନ ନ ଖୋଜି କେବଳ ଶୁଣିବା ପ୍ରାୟତଃ ସବୁଠୁ ଆରୋଗ୍ୟକାରୀ — ଆଉ ଆପଣ ତାହା ଦିଅନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਥਾਂ ਦਿੰਦੇ ਹੋ। ਬਿਨਾਂ ਕਿਸੇ ਦੇ ਝੱਟ ਹੱਲ ਦੱਸੇ ਸੁਣੇ ਜਾਣਾ ਅਕਸਰ ਸਭ ਤੋਂ ਵੱਡੀ ਮੱਲ੍ਹਮ ਹੁੰਦਾ ਹੈ — ਅਤੇ ਤੁਸੀਂ ਇਹੀ ਦਿੰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajesz przestrzeń. Wysłuchanie bez pośpiechu z rozwiązaniami to często najlepsze lekarstwo – i ty je dajesz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو ځای ورکوئ. دا چې څوک واورېدل شي او بل سمدلاسه د حل پسې نه شي، اکثره تر ټولو شفا ورکوونکی شی دی — او تاسو همدا ورکوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você abre espaço. Ter alguém que escuta sem correr para resolver muitas vezes é o que mais cura — e você oferece isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abres espaço. Sentir que nos ouvem, sem que alguém salte logo para a solução, é muitas vezes o que mais cura — e tu dás isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lași loc emoțiilor. Să te asculte cineva fără să sară să rezolve problema e adesea cel mai vindecător lucru — iar tu oferi asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты даёшь выговориться. Когда тебя слушают и не бросаются всё решать, это часто исцеляет лучше всего — и ты это даришь."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utanga umwanya. Kumvwa nta muntu wihutira gukemura ikibazo akenshi ni byo bivura kurusha ibindi — kandi ibyo urabitanga."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ඉඩ හදලා දෙනවා. කවුරුහරි විසඳන්න පනින්නෙ නැතුව ඇහුම්කන් දෙන එක බොහෝ විට වඩාත්ම සුවදායකයි — ඔබ ඒක ලබා දෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dávaš priestor. Keď ťa niekto vypočuje a nehrnie sa hneď do riešenia, často to lieči najviac – a ty to dokážeš dať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvariš prostor. Ko te nekdo sliši, ne da bi takoj iskal rešitev, je to pogosto najbolj zdravilno – in ti to daješ."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unopa nzvimbo. Kunzwiwa pasina mumwe anokurumidza kugadzirisa kazhinji ndicho chinonyanya kuporesa — uye ndizvo zvaunopa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meel baad bixisaa. In lagu maqlo iyadoo aan qof isku deyin inuu xalliyo ayaa badanaa ah waxa ugu bogsiinta badan — adiguna taas waad bixisaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti krijon hapësirë. Të të dëgjojnë pa u nxituar dikush ta zgjidhë shpesh është gjëja më shëruese – dhe ti e jep këtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правиш простор. Кад те неко саслуша, а не јури да реши проблем, то често највише лечи — и ти то пружаш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun masihan rohangan. Didangukeun tanpa aya anu buru-buru méré solusi téh sering janten anu paling nyageurkeun — sareng anjeun nyayogikeun éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ger utrymme. Att bli hörd utan att någon genast vill lösa det är ofta det mest läkande – och det ger du."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unatoa nafasi. Kusikilizwa bila mtu kukimbilia kutatua mara nyingi ndicho kitu kinachoponya zaidi — na wewe unakitoa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் இடம் தருகிறீர்கள். உடனே தீர்வு சொல்ல யாரும் முந்தாமல் கேட்கப்படுவதே பெரும்பாலும் மிகப் பெரிய ஆறுதல் — அதை நீங்கள் தருகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు చోటిస్తారు. పరిష్కారానికి తొందరపడకుండా ఎవరైనా వినడమే చాలాసార్లు గొప్ప ఉపశమనం — అది మీరు అందిస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту фазо медиҳӣ. Шунида шудан бе он ки касе фавран ҳал ҷӯяд, аксар вақт аз ҳама шифобахш аст — ва ту инро медиҳӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเปิดพื้นที่ให้ การได้มีคนฟังโดยไม่รีบแก้ปัญหามักเป็นสิ่งที่เยียวยาที่สุด และคุณมอบสิ่งนั้นให้ได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቦታ ትህቡ። ሓደ ሰብ ፍታሕ ንምርካብ ከይተሃወኸ ምስማዕ ብዙሕ ግዜ ዝበለጸ ፈውሲ እዩ — ንስኹም ድማ ትህብዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen ýer açýarsyň. Hiç kim derrew çözmäge howlukmazdan diňlenmek köplenç iň köp ýarany bejerýän zat — sen muny berýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alan açıyorsun. Birinin hemen çözmeye atlamadan seni dinlemesi çoğu zaman en iyileştirici şeydir ve sen bunu sunuyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти даєш простір. Коли тебе вислуховують і ніхто не кидається одразу все вирішувати, — це часто найбільше зцілює. І ти даруєш саме це."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے پاس دوسروں کے لیے جگہ ہوتی ہے۔ اس طرح سنا جانا کہ کوئی فوراً حل کرنے نہ لگے، اکثر سب سے زیادہ مرہم کا کام کرتا ہے — اور یہی آپ کی دین ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz unga joy berasiz. Kimdir muammoni hal qilishga shoshmasdan tinglashi koʻpincha eng katta malham — siz aynan shuni berasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tạo không gian. Được lắng nghe mà không ai vội lao vào giải quyết thường là điều chữa lành nhất — và bạn mang lại điều đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyasenza isithuba. Ukuviwa ngaphandle kokuba umntu atsibele ekusombululeni ingxaki kuhlala kuyeyona nto iphilisayo — kwaye wena uyakunika oko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń fún un ní àyè. Kí a gbọ́ ẹni láìjẹ́ pé ẹnìkan sáré láti yanjú ọ̀rọ̀ náà sábà máa ń wo ọkàn sàn jù — ẹ sì ń pèsè ìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你懂得留出空間。被好好聽完、沒有人急著解決，往往最治癒，而你做得到。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会给对方空间。被倾听、而不是被急着解决，往往最能治愈人——而你做到了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你懂得留出空間。被好好聽完、沒有人急著解決，往往最療癒，而你做得到。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyamvulela isikhala. Ukulalelwa ngaphandle kokuthi othile agxumele ekuxazululeni kuvame ukuba yinto elapha kakhulu — futhi wena uyakunikeza lokho."
          }
        }
      }
    },
    "You manage your emotions through action. Missing someone is uncomfortable for you — you'd rather feel it when they're back." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy hanteer jou emosies deur te doen. Om iemand te mis is ongemaklik vir jou – jy voel dit liewer wanneer jou maat terug is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስሜትዎን የሚያስተናግዱት በተግባር ነው። አንድን ሰው መናፈቅ ምቾት አይሰጥዎትም — ሲመለሱ ቢሰማዎት ይመርጣሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعاملون مع مشاعركم من خلال الفعل. الاشتياق يزعجكم، وتفضّلون أن تعيشوا الشعور حين يعود شريكك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি কামৰ জৰিয়তে আৱেগ সামলায়। কাৰোবাক মনত পৰাটো আপোনাৰ বাবে অস্বস্তিকৰ — সংগী উভতি অহাৰ পিছতহে আপুনি সেয়া অনুভৱ কৰিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisslərinin öhdəsindən hərəkətlə gəlirsən. Darıxmaq sənə narahatlıq verir — bunu o qayıdanda hiss etməyi üstün tutursan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты спраўляешся з эмоцыямі праз дзеянне. Сумаваць для цябе няўтульна — лепш адчуць гэта, калі палавінка вернецца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справяш се с емоциите чрез действие. Да ти липсва някой е неприятно – предпочиташ да го усетиш, когато половинката ти се върне."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি কাজ দিয়ে আবেগ সামলাও। কাউকে মিস করাটা তোমার অস্বস্তি লাগে — তুমি বরং ও ফিরলে তবেই অনুভূতিটা টের পেতে চাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emocije rješavaš kroz akciju. Čežnja ti je neugodna – radije je osjetiš kad se ponovo vidite."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiones les emocions a través de l'acció. Enyorar algú et resulta incòmode — prefereixes sentir-ho quan torni."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoce zvládáš činy. Stesk je ti nepříjemný – raději ho prožiješ, až budete zase spolu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n delio â dy emosiynau drwy weithredu. Mae gweld eisiau rhywun yn anghyfforddus i ti — byddai'n well gen ti deimlo'r peth pan fydd dy bartner yn ôl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du håndterer dine følelser gennem handling. Savn er ubehageligt for dig – du vil hellere mærke det, når din partner er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verarbeitest Gefühle, indem du aktiv wirst. Vermissen ist für dich unangenehm – du fühlst es lieber, wenn ihr wieder zusammen seid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειρίζεσαι τα συναισθήματά σου με τη δράση. Το να σου λείπει κάποιος σε δυσκολεύει — προτιμάς να το νιώσεις όταν θα είστε πάλι μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestionas tus emociones a través de la acción. Echar de menos a alguien te resulta incómodo: prefieres sentirlo cuando vuelve."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa tuled oma tunnetega toime tegutsedes. Igatsemine on sulle ebamugav — pigem tunned seda siis, kui ta on tagasi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure emozioak ekintzaren bidez kudeatzen dituzu. Norbait faltan botatzea deserosoa da zuretzat — nahiago duzu itzultzen denean sentitu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احساساتت را با عمل مدیریت می‌کنی. دلتنگی برایت ناخوشایند است — ترجیح می‌دهی وقتی برگشت حسش کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsittelet tunteitasi tekemällä. Ikävä tuntuu sinusta epämukavalta – tunnet sen mieluummin vasta, kun toinen on taas luonasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinaharap mo ang emosyon mo sa pamamagitan ng pagkilos. Hindi komportable sa’yo ang pagka-miss — mas gusto mong maramdaman ito pagbalik niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gères tes émotions en agissant. Ressentir le manque te met mal à l'aise : tu préfères le vivre au moment des retrouvailles."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Láimhseálann tú do mhothúcháin trí ghníomh. Ní compordach duit duine a aireachtáil uait — b'fhearr leat é a mhothú nuair a bhíonn sibh le chéile arís."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xestionas as emocións actuando. Botar de menos a alguén incomódate: prefires sentilo cando volva."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે લાગણીઓને કામ દ્વારા સંભાળો છો. કોઈની યાદ આવવી તમને અસહજ લાગે છે — તેઓ પાછા આવે ત્યારે જ એ અનુભવવાનું તમને ગમે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna sarrafa ji ta hanyar aiki. Yin kewar wani ba ya muku daɗi — gara ku ji ta idan an dawo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצלך מתמודדים עם רגשות דרך עשייה. געגוע הוא תחושה לא נוחה בשבילך — עדיף לך להרגיש אותו כשאתם שוב ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपनी भावनाओं को काम के ज़रिए संभालते हैं। किसी की कमी महसूस करना आपको बेचैन करता है — आप चाहते हैं कि वह एहसास उनके लौटने पर हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emocijama upravljaš kroz djelovanje. Čežnja ti je neugodna – radije je osjetiš kad ste opet zajedno."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou jere emosyon ou nan aksyon. Lè yon moun manke ou, sa pa alèz pou ou — ou pito santi l lè li tounen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tettekkel kezeled az érzéseidet. A hiány kényelmetlen neked – inkább akkor éled meg, amikor a párod újra itt van."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու զգացմունքներդ կառավարում ես գործողությամբ։ Կարոտը քեզ համար անհարմար է — նախընտրում ես այն զգալ, երբ զուգընկերդ վերադառնա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mengelola emosi lewat tindakan. Rasa kangen bikin kamu nggak nyaman — kamu lebih memilih merasakannya saat dia sudah kembali."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ejikwa mmetụta gị site n'omume. Agụụ mmadụ na-agụ adịghị gị mma — ọ ka mma gị inwe mmetụta ahụ mgbe ọ lọtara."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú vinnur úr tilfinningum með athöfnum. Söknuður er óþægilegur fyrir þig – þú vilt frekar finna fyrir honum þegar þið hittist aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci le emozioni agendo. La mancanza ti mette a disagio — preferisci viverla quando l’altra persona è di nuovo con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動で気持ちをコントロールするタイプです。恋しさは少し苦手で、その気持ちは会えたときに味わいたいのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan ngatur rasa liwat tumindak. Kangen iku ora kepenak kanggo panjenengan — luwih seneng ngrasakake yen pasangan wis bali."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ემოციებს მოქმედებით მართავ. მონატრება შენთვის უხერხული გრძნობაა — გირჩევნია, ის მაშინ იგრძნო, როცა პარტნიორი დაბრუნდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сезімдеріңді іс арқылы басқарасың. Сағыныш саған жайсыз — оны серігің қайтып келгенде сезінгенді жөн көресің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកគ្រប់គ្រងអារម្មណ៍តាមរយៈសកម្មភាព។ ការនឹកនរណាម្នាក់ធ្វើឲ្យអ្នកមិនស្រួលចិត្ត — អ្នកចង់ទុកអារម្មណ៍នោះរហូតដល់គាត់ត្រឡប់មកវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಕೆಲಸದ ಮೂಲಕ ಭಾವನೆಗಳನ್ನು ನಿಭಾಯಿಸುತ್ತೀರಿ. ಯಾರನ್ನಾದರೂ ಕಳೆದುಕೊಂಡ ಭಾವ ನಿಮಗೆ ಕಸಿವಿಸಿ — ಅವರು ಮರಳಿದಾಗ ಅದನ್ನು ಅನುಭವಿಸುವುದೇ ನಿಮಗಿಷ್ಟ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동으로 감정을 다스리는 타입이에요. 그리움은 불편하게 느껴져서, 다시 만났을 때 마음껏 느끼고 싶어 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu hestên xwe bi kirinê birêve dibî. Bêrîkirina kesekî ji bo te ne rehet e — tu tercîh dikî vê hestê dema ew vegere bijî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сезимдериңди иш аркылуу башкарасың. Сагынуу сага ыңгайсыз — аны ал кайтканда сезгенди артык көрөсүң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verschaffs Gefiller, andeems s du eppes méchs. Een ze vermëssen ass dir onagenehm — du fills et léiwer, wann däi Schatz erëm do ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຈັດການອາລົມດ້ວຍການລົງມືເຮັດ ການຄິດຮອດໃຜຜູ້ໜຶ່ງເຮັດໃຫ້ເຈົ້າບໍ່ສະບາຍໃຈ — ເຈົ້າຢາກຮູ້ສຶກມັນຕອນທີ່ຄູ່ກັບມາແລ້ວຫຼາຍກວ່າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emocijas tvarkai per veiklą. Ilgesys tau nemalonus – mieliau jį pajusi, kai antroji pusė sugrįš."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar emocijām tu tiec galā, darbojoties. Ilgas tev ir neērtas – tu labāk tās izjustu, kad otrā puse ir atpakaļ."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amin'ny asa no itantananao ny fihetseham-ponao. Tsy mahazo aina ianao rehefa malahelo olona — aleonao tsapaina izany rehefa tafaverina izy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te mahi koe e whakahaere ai i ō kare ā-roto. He mea uaua ki a koe te mokemoke — he pai ake ki a koe kia rongo i te wā kua hoki mai ia."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со емоциите се справуваш преку дејствување. Недостигот на некого ти е непријатен — повеќе сакаш да го почувствуваш кога ќе бидете повторно заедно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രവൃത്തിയിലൂടെയാണ് നിങ്ങൾ വികാരങ്ങളെ കൈകാര്യം ചെയ്യുന്നത്. ആരെയെങ്കിലും മിസ് ചെയ്യുന്നത് നിങ്ങൾക്ക് അസ്വസ്ഥതയാണ് — അവർ തിരിച്ചെത്തുമ്പോൾ അത് അനുഭവിക്കാനാണ് നിങ്ങൾക്കിഷ്ടം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи сэтгэл хөдлөлөө үйлдлээр зохицуулдаг. Хэн нэгнийг санах нь чамд эвгүй — хань чинь эргэж ирэхэд мэдрэхийг илүүд үздэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही भावना कृतीतून सांभाळता. कोणाची आठवण येणे तुम्हाला अस्वस्थ करते — ती भावना जोडीदार परत आल्यावरच अनुभवणे तुम्हाला जास्त आवडते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mengurus emosi melalui tindakan. Rindu terasa tidak selesa bagi anda — anda lebih rela merasainya apabila pasangan anda sudah kembali."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timmaniġġja l-emozzjonijiet tiegħek bl-azzjoni. In-nuqqas ta' xi ħadd iqallqek — tippreferi tħossu meta terġgħu tkunu flimkien."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် ခံစားချက်တွေကို လုပ်ဆောင်ချက်နဲ့ ထိန်းတယ်။ လွမ်းရတာ သင့်အတွက် မသက်မသာ ဖြစ်တယ် — ချစ်သူ ပြန်ရောက်လာမှပဲ ခံစားချင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du håndterer følelser gjennom handling. Savn er ubehagelig for deg – du vil heller kjenne på det når dere er sammen igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं आफ्ना भावना काममार्फत सम्हाल्नुहुन्छ। कसैको याद आउनु तपाईंलाई असहज लाग्छ — उहाँ फर्कनुभएपछि नै त्यो महसुस गर्न रुचाउनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij gaat met je gevoelens om door in actie te komen. Iemand missen voelt ongemakkelijk – je voelt het liever als je partner er weer is."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumalamulira maganizo anu pochita zinthu. Kusowa munthu sikumakusangalatsani — mumakonda kudikira mpaka abwerere."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miira kee gochaan to'atta. Hawwuun siif hin mijatu — yeroo wal argitan sana miira sana dhaga'uu filatta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ କାମ କରି ନିଜ ଭାବନା ସମ୍ଭାଳନ୍ତି। କାହାକୁ ମନେ ପକାଇବା ଆପଣଙ୍କୁ ଅସ୍ୱସ୍ତି ଦିଏ — ସେମାନେ ଫେରିଲେ ହିଁ ଆପଣ ତାହା ଅନୁଭବ କରିବାକୁ ଚାହାଁନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਆਪਣੇ ਜਜ਼ਬਾਤ ਕੰਮ ਰਾਹੀਂ ਸੰਭਾਲਦੇ ਹੋ। ਕਿਸੇ ਦੀ ਯਾਦ ਆਉਣਾ ਤੁਹਾਨੂੰ ਬੇਚੈਨ ਕਰਦਾ ਹੈ — ਤੁਸੀਂ ਇਹ ਅਹਿਸਾਸ ਉਨ੍ਹਾਂ ਦੇ ਮੁੜ ਆਉਣ ਉੱਤੇ ਮਹਿਸੂਸ ਕਰਨਾ ਪਸੰਦ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radzisz sobie z emocjami przez działanie. Tęsknota jest dla ciebie niewygodna – wolisz ją poczuć, gdy znów będziecie razem."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو خپل احساسات د کار له لارې اداره کوئ. د چا یاد تاسو ته ستونزمن وي — غوره ګڼئ چې دا احساس هغه وخت وکړئ چې بېرته راشي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você lida com as emoções agindo. Sentir saudade incomoda — você prefere sentir tudo quando seu amor voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidas com as emoções através da ação. Sentir saudades é desconfortável para ti — preferes senti-las quando o teu par voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți gestionezi emoțiile prin acțiune. Dorul e incomod pentru tine — preferi să-l simți când partenerul tău se întoarce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты справляешься с эмоциями через действие. Скучать тебе неуютно — лучше прочувствовать всё, когда вы снова вместе."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucunga amarangamutima yawe ukoresheje ibikorwa. Gukumbura umuntu birakubangamira — wahitamo kubyumva amaze kugaruka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ හැඟීම් පාලනය කරන්නේ ක්‍රියාවෙන්. කෙනෙක් මතක් වෙන එක ඔබට අපහසුයි — ඔවුන් ආපසු ආවම ඒ හැඟීම විඳින්න ඔබ කැමතියි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emócie zvládaš cez činy. Chýbanie je pre teba nepríjemné – radšej ho precítiš, až keď budete znova spolu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čustva uravnavaš z dejanji. Pogrešanje ti ni prijetno – raje ga začutiš, ko je druga oseba spet ob tebi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unodzora manzwiro ako nekuita zvinhu. Kusuwa mumwe hakukunakidzi — unoda kuzvinzwa adzoka."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dareenkaaga waxaad ku maareysaa ficil. Xiisadda qof way kugu adag tahay — waxaad door bidaysaa inaad dareento marka la isu soo laabto."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emocionet i menaxhon përmes veprimit. Mungesa e dikujt është e pakëndshme për ty – preferon ta ndiesh kur partneri yt kthehet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоције држиш под контролом кроз акцију. Чежња ти није пријатна — радије ћеш је осетити кад се видите."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun ngatur rasa ku cara ngalakukeun hiji hal. Sono téh teu raoseun pikeun anjeun — anjeun langkung milih ngaraosna nalika pasangan parantos mulang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hanterar känslor genom att göra saker. Att sakna någon är obekvämt för dig – du känner hellre efter när ni ses igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unadhibiti hisia zako kwa kutenda. Kumkumbuka mtu hakukupi raha — ungependa kuhisi hivyo atakaporudi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயல்கள் மூலம் உணர்ச்சிகளைக் கையாள்கிறீர்கள். ஒருவரைப் பிரிந்து ஏங்குவது உங்களுக்குச் சங்கடமானது — அவர் திரும்பி வந்த பிறகு அதை உணர்வதையே விரும்புவீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు భావాలను పనుల ద్వారా సంభాళిస్తారు. ఒకరిని మిస్ అవ్వడం మీకు ఇబ్బందిగా ఉంటుంది — వారు తిరిగొచ్చాకే ఆ భావాన్ని అనుభవించాలనుకుంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту ҳиссиётатро бо амал идора мекунӣ. Пазмон шудан барои ту ногувор аст — беҳтар мешуморӣ онро вақте ҳис кунӣ, ки ёрат баргашт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจัดการอารมณ์ด้วยการลงมือทำ การคิดถึงใครสักคนทำให้คุณอึดอัด คุณอยากเก็บความรู้สึกนั้นไว้ตอนได้เจอกันมากกว่า"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስምዒታትኩም ብተግባር ትቆጻጸሩ። ሰብ ምንፋቕ ይጭንቐኩም — ምስ ተመልሱ ክስምዓኩም ትመርጹ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen duýgularyňy hereket bilen dolandyrýarsyň. Küýsemek saňa oňaýsyz — sen ony ol gaýdyp gelende duýmagy makul bilýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duygularını bir şeyler yaparak yönetiyorsun. Birini özlemek sana rahatsızlık veriyor; o duyguyu partnerin döndüğünde yaşamayı tercih ediyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти справляєшся з емоціями через дію. Сумувати тобі незатишно — краще прожити це почуття, коли половинка повернеться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل ہی آپ کا جذبات سنبھالنے کا طریقہ ہے۔ کسی کی کمی محسوس کرنا آپ کو بے چین کرتا ہے — یہ احساس ان کے لوٹ آنے پر محسوس کرنا آپ کو زیادہ اچھا لگتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz his-tuygʻularingizni harakat orqali boshqarasiz. Sogʻinch sizga noqulaylik tugʻdiradi — uni sherigingiz qaytgandagina his qilishni afzal koʻrasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn điều chỉnh cảm xúc bằng hành động. Nỗi nhớ khiến bạn khó chịu — bạn muốn để dành cảm xúc đó cho lúc người ấy trở về."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulawula iimvakalelo zakho ngezenzo. Ukukhumbula umntu kuyakuphazamisa — ukhetha ukuziva iimvakalelo xa ebuyile."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ máa ń ṣàkóso ìmọ̀lára yín nípa ìṣe. Ṣíṣàárò ẹnìkan kò rọ̀ yín lọ́rùn — ẹ fẹ́ràn láti ní ìmọ̀lára rẹ̀ nígbà tí ó bá padà dé."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用行動來調節情緒。想念一個人令你不太自在，你寧願等見面時才好好感受。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你习惯用行动来调节情绪。想念让你不太自在——你更愿意等见面时再好好感受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用行動來調整情緒。想念一個人讓你不太自在，你寧願等見面時再好好感受。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulawula imizwa yakho ngokwenza. Ukukhumbula othile akukuthokozisi — ungathanda ukukuzwa lapho esebuyile."
          }
        }
      }
    },
    "You need closure through words. The fight isn't done until both sides have been acknowledged." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy het afsluiting deur woorde nodig. Die rusie is eers verby wanneer albei kante erken is."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በቃላት መቋጨት ያስፈልግዎታል። ሁለቱም ወገኖች እውቅና እስኪያገኙ ድረስ ጠቡ አላለቀም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاجون إلى إغلاق الصفحة بالكلمات. لا ينتهي الشجار عندكم حتى يُعترف بمشاعر الطرفين."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি শব্দৰ জৰিয়তে সামৰণি বিচাৰে। দুয়ো পক্ষক স্বীকৃতি নিদিয়ালৈকে কাজিয়া শেষ নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlərlə nöqtə qoyulmasına ehtiyacın var. Hər iki tərəf eşidilməyincə dava bitmiş sayılmır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе трэба паставіць кропку словамі. Сварка не скончана, пакуль абодва бакі не пачулі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трябва ти завършек чрез думи. Караницата не е приключила, докато и двете страни не бъдат чути."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথার মধ্য দিয়েই তুমি ব্যাপারটার ইতি টানতে চাও। দুজনের কথাই মেনে না নেওয়া পর্যন্ত ঝগড়া শেষ হয় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treba ti zatvaranje kroz riječi. Svađa nije gotova dok se obje strane ne uvaže."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessites tancar-ho amb paraules. La baralla no s'acaba fins que les dues parts s'han sentit reconegudes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potřebuješ věci uzavřít slovy. Hádka nekončí, dokud nejsou vyslyšeny obě strany."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae angen geiriau arnat ti i gau pen y mwdwl. Dydy'r ffrae ddim drosodd nes bod y ddwy ochr wedi cael eu cydnabod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brug for at afslutte det med ord. Skænderiet er ikke slut, før begge sider er blevet anerkendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst einen Abschluss durch Worte. Der Streit ist erst vorbei, wenn beide Seiten gesehen wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεσαι να κλείσει με λόγια. Ο καβγάς δεν τελειώνει μέχρι να αναγνωριστούν και οι δύο πλευρές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas cerrar el tema con palabras. La pelea no termina hasta que las dos partes se sienten reconocidas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa vajad lõpetust sõnade kaudu. Tüli pole läbi enne, kui mõlema poole tunded on ära tunnustatud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitzen bidez itxi behar duzu. Liskarra ez da amaitzen bi aldeak aitortuak izan arte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیاز داری با کلمات ماجرا را ببندی. دعوا تمام نمی‌شود تا حرف هر دو طرف شنیده شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitset sanoja saadaksesi asian päätökseen. Riita ei ole ohi ennen kuin molempien näkemykset on tunnustettu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan mo ng closure sa pamamagitan ng salita. Hindi pa tapos ang away hangga’t hindi pa kinikilala ang panig ng bawat isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as besoin de tourner la page avec des mots. La dispute n'est pas finie tant que chacun n'a pas été entendu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teastaíonn críoch le focail uait. Níl an t-achrann thart go dtí go n-aithnítear an dá thaobh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisas pechalo con palabras. A discusión non remata ata que as dúas partes se sentiron recoñecidas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારે શબ્દો દ્વારા વાતનો અંત જોઈએ. બંને પક્ષની વાત સ્વીકારાય નહીં ત્યાં સુધી ઝઘડો પૂરો થતો નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna buƙatar kammalawa ta hanyar kalmomi. Faɗa bai ƙare ba har sai an amince da ra'ayin ɓangarorin biyu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך צורך לסגור את זה במילים. הריב לא נגמר עד ששני הצדדים קיבלו הכרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको शब्दों के ज़रिए बात ख़त्म करनी होती है। जब तक दोनों की बात सुनी और समझी न जाए, झगड़ा ख़त्म नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trebaš završetak kroz riječi. Svađa nije gotova dok obje strane ne budu saslušane."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou bezwen fèmen paj la ak pawòl. Kont lan pa fini toutotan toude bò yo pa santi yo rekonèt yo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked a szavak hozzák el a lezárást. A vitának akkor van vége, ha mindkét felet meghallgatták."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քեզ պետք է խոսքերով ավարտին հասցնել։ Վեճը չի ավարտվում, քանի դեռ երկու կողմերն էլ չեն լսվել։"
