    "The spark doesn't have to fade — but what maintains it is different for everyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس بالضرورة أن تخبو الشرارة، لكن ما يحافظ عليها يختلف من شخص لآخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiskra nemusí vyhasnout – ale každý ji udržuje něčím jiným."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gnisten behøver ikke at falme – men det, der holder den ved lige, er forskelligt for alle."
