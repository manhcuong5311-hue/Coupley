    "Give it time and let it settle naturally" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gee dit tyd en laat dit vanself bedaar"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጊዜ ሰጥቶ በተፈጥሮ እንዲረጋጋ መተው"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمنحه وقتًا ليهدأ من تلقاء نفسه"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সময় দিয়া আৰু স্বাভাৱিকতে থিতাপি ল'বলৈ দিয়া"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaxt vermək, qoy öz-özünə sakitləşsin"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даць часу і дазволіць усяму ўлегчыся"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Време, за да се уталожи от само себе си"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সময় দিই, নিজে থেকেই থিতিয়ে যাক"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damo tome vremena da se slegne"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donar-li temps i deixar que les coses s'assosseguin"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dát tomu čas, ať se to usadí"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhoi amser iddo a gadael iddo setlo'n naturiol"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give det tid, så det falder til ro af sig selv"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit lassen, bis es sich legt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λίγο χρόνο, να κατακάτσει μόνο του"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darle tiempo y que se calme solo"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna aega ja lase asjal loomulikult settida"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denbora eman eta berez baretzen utzi"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به زمان بسپاریم تا خودش آرام شود"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikaa, jotta asia laskeutuu itsestään"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigyan ng panahon at hayaang humupa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser le temps faire les choses"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am a thabhairt dó agus ligean dó socrú go nádúrtha"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar tempo e deixar que se calme soa"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સમય આપીએ અને વાતને આપમેળે શાંત થવા દઈએ"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ba shi lokaci ya lafa da kansa"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לתת לזה זמן, שיירגע מעצמו"
          }
        },
        "hi" : {
