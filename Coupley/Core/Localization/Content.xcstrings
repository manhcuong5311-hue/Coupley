        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu munosabatlarda qanday kuch toʻplashingiz, muloqot qilishingiz va qancha shaxsiy joyga muhtojligingizga taʼsir qiladi."
