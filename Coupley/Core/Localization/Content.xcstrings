        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነዊሕ ጸወታ ትጻወቱ ኣለኹም። ኣብ መጻኢ ክልቴኹም ንባዕልኹም ከተመስግኑ ኢኹም።"
