        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun akkaataa ati humna itti haaromfattu, namoota wajjin itti wal argitu fi hariiroo keessatti iddoo itti barbaaddu tuqa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ କିପରି ଶକ୍ତି ଫେରି ପାଆନ୍ତି, ଲୋକଙ୍କ ସହ ମିଶନ୍ତି ଓ ସମ୍ପର୍କରେ କେତେ ଜାଗା ଦରକାର — ଏହା ସେଥିରେ ପ୍ରଭାବ ପକାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਦਾ ਅਸਰ ਇਸ ਗੱਲ ਉੱਤੇ ਪੈਂਦਾ ਹੈ ਕਿ ਤੁਸੀਂ ਕਿਵੇਂ ਤਾਜ਼ਾ ਹੁੰਦੇ ਹੋ, ਲੋਕਾਂ ਨੂੰ ਮਿਲਦੇ ਹੋ, ਅਤੇ ਰਿਸ਼ਤੇ ਵਿੱਚ ਤੁਹਾਨੂੰ ਕਿੰਨੀ ਥਾਂ ਚਾਹੀਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wpływa na to, jak ładujesz baterie, spędzasz czas z ludźmi i ile przestrzeni potrzebujesz w związku."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا پر دې اغېز کوي چې څنګه انرژي بیا ترلاسه کوئ، له خلکو سره ګډېږئ او په اړیکه کې څومره ځای ته اړتیا لرئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
