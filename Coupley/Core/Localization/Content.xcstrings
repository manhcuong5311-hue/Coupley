        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mifantoka amin'ny vahaolana ianao. Hitanao fa lehibe noho ny tsy fifanarahana ny fifandraisana. Tanjaka tena izy izany."
