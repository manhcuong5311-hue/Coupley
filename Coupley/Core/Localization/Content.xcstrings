        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorgun ve durgun biri hiçbir şey yapmamak için izne ihtiyaç duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли втома й порожнеча, потрібен дозвіл нічого не робити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mệt và uể oải thì cần được cho phép không làm gì cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又累又提不起劲时，需要的是“什么都不做”的许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲倦又提不起勁時，需要的是被允許什麼都不做。"
          }
        }
      }
    },
    "Togetherness isn't optional for you — it's how you stay connected. Without it, you start to feel like strangers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواجد معًا ليس خيارًا ثانويًا عندكم، بل هو طريقتكم في البقاء قريبين. بدونه تبدؤون بالشعور كأنكما غريبان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Být spolu pro tebe není volitelné – tak si udržujete blízkost. Bez toho si začínáte připadat jako cizí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samvær er ikke valgfrit for dig – det er sådan, I holder forbindelsen. Uden det begynder I at føle jer som fremmede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweisamkeit ist für dich kein Extra – so bleibt ihr verbunden. Ohne sie fühlt ihr euch bald wie Fremde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να είστε μαζί δεν είναι προαιρετικό για σένα — έτσι μένετε κοντά. Χωρίς αυτό, αρχίζετε να νιώθετε σαν ξένοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar juntos no es opcional para ti: es tu forma de seguir en conexión. Sin eso, empiezas a sentir distancia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdessäolo ei ole sinulle vapaaehtoista – sen avulla pysytte yhteydessä. Ilman sitä alatte vieraantua toisistanne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi opsyonal sa’yo ang pagsasama — ganyan kayo nananatiling konektado. Kapag wala ito, parang nagiging estranghero kayo sa isa’t isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être ensemble n'est pas facultatif pour toi : c'est ce qui vous garde proches. Sans ça, tu as l'impression que vous devenez des inconnus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמן ביחד הוא לא מותרות בשבילך — ככה נשמר החיבור. בלעדיו, מתחילה להתגנב תחושה שאתם זרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए साथ होना ज़रूरी है, वैकल्पिक नहीं — इसी से आप जुड़े रहते हैं। इसके बिना आप अजनबी-से महसूस करने लगते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad az együttlét nem opcionális – így maradtok kapcsolatban. Nélküle kezditek idegennek érezni egymást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebersamaan itu wajib bagimu — itu caramu tetap terhubung. Tanpanya, kalian mulai terasa seperti orang asing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per te stare insieme non è un optional — è il modo in cui restate in contatto. Senza, cominciate a sentirvi due estranei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒にいることは、つながりを保つために欠かせないもの。それがないと、他人のように感じ始めてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나에게 함께하는 시간은 선택이 아니라 서로 이어져 있기 위한 방법이에요. 그 시간이 없으면 점점 남처럼 느껴지기 시작해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebersamaan bukan pilihan bagi anda — itulah cara anda kekal rapat. Tanpanya, anda mula rasa seperti orang asing."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid sammen er ikke valgfritt for deg – det er sånn dere holder kontakten. Uten det begynner dere å føle dere som fremmede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samenzijn is voor jou geen bijzaak – zo blijf je verbonden. Zonder dat worden jullie al snel vreemden voor elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólny czas to dla ciebie nie dodatek, a podstawa – tak utrzymujesz bliskość. Bez niego zaczynacie się od siebie oddalać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar junto não é opcional para você — é como vocês mantêm a conexão. Sem isso, vocês começam a parecer estranhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpul împreună nu e opțional pentru tine — așa rămâneți aproape. Fără el, începeți să vă simțiți ca doi străini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быть вместе для тебя не опция — так вы сохраняете связь. Без этого вы начинаете чувствовать себя чужими."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid tillsammans är inget tillval för dig – det är så ni håller ihop. Utan den börjar ni kännas som främlingar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การได้อยู่ด้วยกันไม่ใช่ทางเลือกสำหรับคุณ แต่เป็นวิธีที่ทำให้ยังใกล้ชิดกัน ถ้าขาดไป คุณจะเริ่มรู้สึกเหมือนคนแปลกหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte olmak senin için isteğe bağlı değil; bağınızı böyle koruyorsunuz. O olmadan birbirinize yabancılaşmaya başlıyorsunuz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бути разом для тебе не опція — так ви зберігаєте зв’язок. Без цього ви ніби стаєте чужими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với bạn, ở bên nhau là điều không thể thiếu — đó là cách bạn giữ kết nối. Thiếu nó, bạn bắt đầu thấy hai người như xa lạ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一起对你来说不是可有可无，而是保持亲近的方式。少了它，你们会开始觉得陌生。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相處時光對你不是可有可無，而是你們保持連結的方式。少了它，你會開始覺得彼此像陌生人。"
          }
        }
      }
    },
    "Tokyo lights. Kyoto mornings. Cherry blossoms with you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضواء طوكيو. صباحات كيوتو. أزهار الكرز معك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Světla Tokia. Rána v Kjótu. Sakury s tebou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokyos lys. Morgener i Kyoto. Kirsebærblomster med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lichter von Tokio. Kyoto am Morgen. Kirschblüten mit dir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα φώτα του Τόκιο. Πρωινά στο Κιότο. Ανθισμένες κερασιές μαζί σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las luces de Tokio. Las mañanas de Kioto. Los cerezos en flor contigo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokion valot. Kioton aamut. Kirsikankukat sinun kanssasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga ilaw ng Tokyo. Mga umaga sa Kyoto. Cherry blossoms kasama ka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lumières de Tokyo. Les matins de Kyoto. Les cerisiers en fleur avec toi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האורות של טוקיו. בקרים בקיוטו. פריחת הדובדבן איתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोक्यो की रोशनी। क्योटो की सुबहें। आपके साथ चेरी ब्लॉसम।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokió fényei. Kiotói reggelek. Cseresznyevirágzás veled."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemerlap Tokyo. Pagi di Kyoto. Bunga sakura bersamamu."
