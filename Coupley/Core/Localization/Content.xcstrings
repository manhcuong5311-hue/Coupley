        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сил немає, полегшення > запевнення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب توانائی ختم ہو جائے تو تسلی سے زیادہ راحت کام آتی ہے۔"
