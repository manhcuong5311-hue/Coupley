        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有狀況時才談"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有事的时候再聊"
