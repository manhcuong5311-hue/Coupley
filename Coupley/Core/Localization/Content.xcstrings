    "Skip the advice. Try 'that sounds really hard.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتركوا النصائح. جرّبوا: «يبدو هذا صعبًا حقًا»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynech rady. Zkus: „To zní fakt těžce.“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop rådene. Prøv med: »Det lyder virkelig hårdt.«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Ratschläge weg. Sag lieber: „Das klingt echt hart.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άσε τις συμβουλές. Δοκίμασε ένα «Ακούγεται πολύ δύσκολο»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvídate de los consejos. Prueba con “Eso suena muy duro”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä neuvot väliin. Kokeile: ”Tuo kuulostaa tosi rankalta.”"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huwag munang magpayo. Subukang sabihing “ang hirap siguro niyan.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublie les conseils. Essaie : « ça a l'air vraiment dur »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי עצות. לנסות: \"זה נשמע ממש קשה.\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सलाह रहने दें। कहकर देखें: “यह सच में बहुत मुश्किल लग रहा है।”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyd a tanácsokat. Próbáld ezt: „Ez tényleg nagyon nehéznek hangzik.”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan sarannya. Coba bilang “itu kedengarannya berat banget.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia stare i consigli. Prova con: «Dev’essere davvero dura»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドバイスは控えて、「それは本当に大変だったね」と伝えてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조언은 잠시 넣어 두고 “정말 힘들었겠다”라고 말해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupakan nasihat. Cuba kata “itu memang berat.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropp rådene. Prøv «det høres skikkelig tøft ut»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het advies achterwege. Probeer: “Dat klinkt echt zwaar.”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpuść rady. Powiedz: „To brzmi naprawdę ciężko”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueça os conselhos. Tente “isso parece muito difícil”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă sfaturile. Încearcă: „chiar pare greu”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обойдись без советов. Попробуй: «Звучит очень тяжело»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa över råden. Testa: ”Det låter verkligen tufft.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้ามคำแนะนำไปก่อน ลองพูดว่า “ฟังดูหนักมากเลยนะ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavsiyeyi bırak. “Bu gerçekten zor olmalı” demeyi dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обійдися без порад. Спробуй: «Звучить справді важко»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua lời khuyên. Thử nói: “nghe chắc vất vả lắm.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先别给建议，试试说：“听起来真的很难。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先別給建議，試著說：「聽起來真的很辛苦。」"
          }
        }
      }
    },
