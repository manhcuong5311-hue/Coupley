        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೀರ್ಘ ಸಂಬಂಧಗಳಲ್ಲಿ ಹಗುರತನದ ಮಹತ್ವ ಹಲವರಿಗೆ ಗೊತ್ತಿಲ್ಲ. ಜೊತೆಯಾಗಿ ನಗುವ ಜೋಡಿಗಳು ಹೆಚ್ಚು ಕಾಲ ಉಳಿಯುತ್ತವೆ."
