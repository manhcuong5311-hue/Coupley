    "After a hard day, what helps you reset with your partner?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد يوم صعب، ما الذي يعيد إليكم توازنكم مع شريكك؟"
