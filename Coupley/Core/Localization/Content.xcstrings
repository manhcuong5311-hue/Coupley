    "Physical transition from day to night. Washing the day off is literal for you. A very grounding habit." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’n Fisiese oorgang van dag na nag. Om die dag af te was, is vir jou letterlik. ’n Baie aardende gewoonte."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከቀን ወደ ማታ አካላዊ ሽግግር። ቀኑን ማጠብ ለእርስዎ ቃል በቃል ነው። በጣም የሚያረጋጋ ልማድ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقال جسدي من النهار إلى الليل. غسل تعب اليوم عندكم أمر حرفي. عادة تمنح ثباتًا كبيرًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দিনৰ পৰা ৰাতিলৈ শাৰীৰিক পৰিৱৰ্তন। আপোনাৰ বাবে দিনটো ধুই পেলোৱাটো আক্ষৰিক অৰ্থতেই। এক অতি থিতাপি দিয়া অভ্যাস।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gündüzdən gecəyə fiziki keçid. Sənin üçün günü üstündən yumaq sözün əsl mənasındadır. Çox sakitləşdirici vərdişdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фізічны пераход ад дня да ночы. Змыць з сябе дзень — для цябе гэта літаральна. Вельмі супакойлівая звычка."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физически преход от ден към нощ. За теб да отмиеш деня е буквално. Много заземяващ навик."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দিন থেকে রাতে যাওয়ার শারীরিক পালাবদল। তোমার কাছে দিনটা ধুয়ে ফেলা আক্ষরিক অর্থেই। খুব স্থির করে দেওয়ার মতো অভ্যাস।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizički prelaz iz dana u noć. Za tebe je „sprati dan sa sebe” doslovno. Navika koja jako smiruje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una transició física del dia a la nit. Per a tu, treure't el dia de sobre és literal. Un hàbit que dona molta calma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzický přechod ze dne do noci. Smýt ze sebe den bereš doslova. Velmi uklidňující zvyk."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Newid corfforol o ddydd i nos. I ti, mae golchi'r diwrnod i ffwrdd yn llythrennol. Arfer sy'n dy sadio'n fawr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fysisk overgang fra dag til aften. For dig er det helt bogstaveligt at vaske dagen af. En vane, der virkelig giver fodfæste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein körperlicher Übergang vom Tag zur Nacht. Du wäschst den Tag buchstäblich ab. Eine sehr erdende Gewohnheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα σωματικό πέρασμα από τη μέρα στη νύχτα. Για σένα, το να ξεπλένεις τη μέρα από πάνω σου είναι κυριολεξία. Μια πολύ γειωτική συνήθεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una transición física del día a la noche. Para ti, quitarte el día de encima es literal. Un hábito que da mucha calma."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füüsiline üleminek päevast öösse. Päeva mahapesemine on sinu jaoks sõna otseses mõttes. Väga maandav harjumus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egunetik gauerako trantsizio fisikoa. Eguna garbitzea, zuretzat, hitzez hitz da. Oso ohitura lasaigarria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گذار جسمی از روز به شب. شستن روز برای تو معنای واقعی کلمه است. عادتی بسیار آرامش‌بخش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyysinen siirtymä päivästä yöhön. Päivän peseminen pois on sinulle kirjaimellista. Hyvin rauhoittava tapa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisikal na paglipat mula araw papuntang gabi. Literal sa’yo ang paghuhugas ng pagod ng araw. Napakagandang nakasanayan na nagpapanatag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une transition physique entre le jour et la nuit. Pour toi, se laver de sa journée, ce n'est pas qu'une image. Une habitude très apaisante."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aistriú fisiciúil ón lá go dtí an oíche. Duitse, níonn tú an lá díot i ndáiríre. Nós a chuireann go mór ar do bhonnaí thú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha transición física do día á noite. Para ti, quitarte o día de enriba é literal. Un hábito que dá moita calma."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દિવસથી રાત તરફનું શારીરિક પરિવર્તન. તમારા માટે દિવસ ધોઈ નાખવો એ શબ્દશઃ સાચું છે. ખૂબ સ્થિરતા આપતી આદત."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauyi na zahiri daga rana zuwa dare. A gare ku, wanke yinin daga jiki abu ne na zahiri. Ɗabi'a ce mai kwantar da hankali sosai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבר פיזי מהיום ללילה. אצלך לשטוף מעליך את היום זה כפשוטו. הרגל שמקרקע מאוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन से रात की ओर एक शारीरिक बदलाव। आप सच में दिन की थकान धोकर उतार देते हैं। मन को ठहराव देने वाली आदत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizički prijelaz iz dana u noć. Za tebe je „sprati dan sa sebe” doslovno. Vrlo prizemljujuća navika."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon pasaj fizik soti lajounen rive lannwit. Pou ou, lave jounen an sou ou se vre. Yon abitid ki estabilize ou anpil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testi átmenet nappalból éjszakába. Nálad a nap lemosása szó szerint értendő. Nagyon megnyugtató szokás."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ֆիզիկական անցում օրից գիշերվա։ Քեզ համար օրը լվանալը բառացի է։ Շատ հանգստացնող սովորություն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transisi fisik dari siang ke malam. Bagimu, membilas penat seharian itu terjadi secara harfiah. Kebiasaan yang sangat menenangkan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgbanwe site n'ehihie gaa n'abalị. Ịsapụ ụbọchị ahụ bụ ihe ezigbo nye gị. Omume na-eme ka obi dajụọ nke ukwuu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líkamleg skil milli dags og nætur. Þú þværð daginn bókstaflega af þér. Mjög jarðtengjandi venja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passaggio fisico dal giorno alla notte. Per te lavarti di dosso la giornata non è solo un modo di dire. Un’abitudine che dà grande stabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体ごと昼から夜へ切り替えるタイプです。一日の疲れを文字どおり洗い流す。とても心が落ち着く習慣です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pralihan saka awan menyang bengi. Ngresiki awak saka dina iku sing panjenengan lakoni temenan. Pakulinan sing nentremake banget."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ფიზიკური გადასვლა დღიდან ღამეზე. შენთვის დღის ჩამორეცხვა სიტყვასიტყვით ხდება. ძალიან დამამშვიდებელი ჩვევაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Күннен түнге тәндік өту. Сен үшін күнді жуып тастау тура мағынасында. Өте тыныштандыратын әдет."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការផ្លាស់ប្ដូរតាមរាងកាយពីថ្ងៃទៅយប់។ សម្រាប់អ្នក ការលាងសម្អាតថ្ងៃចេញ គឺពិតតាមន័យត្រង់។ ជាទម្លាប់ដែលធ្វើឲ្យនឹងនរណាស់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಗಲಿನಿಂದ ರಾತ್ರಿಗೆ ದೈಹಿಕ ಬದಲಾವಣೆ. ನಿಮಗೆ ದಿನವನ್ನು ತೊಳೆದುಕೊಳ್ಳುವುದು ಅಕ್ಷರಶಃ ನಿಜ. ಮನಸ್ಸನ್ನು ನೆಲೆಗೊಳಿಸುವ ಅಭ್ಯಾಸ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮에서 밤으로 몸을 전환하는 시간이에요. 하루를 말 그대로 씻어 내죠. 마음을 안정시키는 좋은 습관이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derbasbûna laşî ji rojê ber bi şevê. Ji te re şûştina rojê bi rastî ye. Adeteke pir aramker."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Күндөн түнгө денелик өтүү. Сен үчүн күндү жууп салуу түз мааниде. Абдан тынчтандыруучу адат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E kierperlechen Iwwergank vum Dag an d'Nuecht. Den Dag ofzewäschen ass fir dech wuertwiertlech. Eng Gewunnecht, déi richteg Halt gëtt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການປ່ຽນຜ່ານຈາກກາງເວັນສູ່ກາງຄືນດ້ວຍຮ່າງກາຍ ສຳລັບເຈົ້າ ການລ້າງມື້ອອກໄປແມ່ນເລື່ອງຈິງ ນິໄສທີ່ຊ່ວຍໃຫ້ໃຈໝັ້ນຄົງຫຼາຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizinis perėjimas iš dienos į naktį. Tau dieną nusiplauti – tiesiogine prasme. Labai raminantis įprotis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziska pāreja no dienas uz nakti. Tev „nomazgāt dienu” ir burtiski. Ļoti nomierinošs ieradums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifindrana ara-batana avy amin'ny andro mankany amin'ny alina. Aminao, tena sasana tokoa ny andro. Fahazarana mampitony tokoa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nekehanga ā-tinana mai i te ao ki te pō. Ko te horoi atu i te rā he mea pono ki a koe. He tikanga tino whakaū."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физички премин од ден во ноќ. За тебе, да го измиеш денот е буквално. Многу смирувачка навика."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പകലിൽനിന്ന് രാത്രിയിലേക്കുള്ള ശാരീരികമായ മാറ്റം. ദിവസത്തെ കഴുകിക്കളയുക എന്നത് നിങ്ങൾക്ക് അക്ഷരാർഥത്തിൽത്തന്നെയാണ്. മനസ്സിനെ ഉറപ്പിച്ചുനിർത്തുന്ന ഒരു ശീലം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өдрөөс шөнө рүү шилжих бодит шилжилт. Чамд өдрийг угааж арилгах нь шууд утгаараа. Маш тогтворжуулдаг дадал."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिवसातून रात्रीकडे जाण्याचा शारीरिक बदल. दिवसभराचा थकवा धुऊन टाकणे तुमच्यासाठी अक्षरशः खरे आहे. खूप स्थिर करणारी सवय."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peralihan fizikal dari siang ke malam. Bagi anda, mandi benar-benar membersihkan penat seharian. Tabiat yang sangat menenangkan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranżizzjoni fiżika mill-ġurnata għal-lejl. Għalik, taħsel il-ġurnata minn fuqek litteralment. Drawwa li tagħtik ħafna stabbiltà."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေ့ကနေ ညကို ကိုယ်ခန္ဓာနဲ့ ကူးပြောင်းတာပါ။ တစ်နေ့တာကို ဆေးကြောချလိုက်တာက သင့်အတွက် စာသားအတိုင်း အမှန်ပါ။ အရမ်း တည်ငြိမ်စေတဲ့ အလေ့အထပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fysisk overgang fra dag til kveld. Å vaske av seg dagen er bokstavelig for deg. En vane som gir deg fotfeste."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिनबाट रातमा जाने शारीरिक सङ्क्रमण। तपाईंका लागि दिनको थकान पखाल्नु शाब्दिक अर्थमै हो। धेरै स्थिर बनाउने बानी।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een fysieke overgang van dag naar nacht. Jij spoelt de dag letterlijk van je af. Een gewoonte die je echt rust geeft."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusintha kuchoka masana kupita usiku m'thupi. Kwa inu, kusambitsa tsiku ndi zenizeni. Chizolowezi chokhazikitsa mtima kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guyyaa irraa gara halkaniitti ce'umsa qaamaa. Guyyaa of irraa dhiqachuun siif dhugumaan akkasuma. Amala baay'ee nama tasgabbeessu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦିନରୁ ରାତିକୁ ଶାରୀରିକ ପରିବର୍ତ୍ତନ। ଆପଣଙ୍କ ପାଇଁ ଦିନକୁ ଧୋଇଦେବା ଅକ୍ଷରେ ଅକ୍ଷରେ ସତ। ବହୁତ ସ୍ଥିରତା ଦେଉଥିବା ଅଭ୍ୟାସ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦਿਨ ਤੋਂ ਰਾਤ ਵੱਲ ਸਰੀਰਕ ਬਦਲਾਅ। ਤੁਹਾਡੇ ਲਈ ਦਿਨ ਨੂੰ ਧੋ ਦੇਣਾ ਸੱਚਮੁੱਚ ਦੀ ਗੱਲ ਹੈ। ਬਹੁਤ ਟਿਕਾਅ ਦੇਣ ਵਾਲੀ ਆਦਤ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizyczne przejście z dnia w noc. Dla ciebie zmycie z siebie dnia to coś dosłownego. Bardzo kojący nawyk."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له ورځې شپې ته جسمي تګ. د ورځې ستړیا وینځل ستاسو لپاره لفظي معنا لري. ډېر ډاډ ورکوونکی عادت."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma transição física do dia para a noite. Para você, lavar o dia é literal. Um hábito que traz muito equilíbrio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma transição física do dia para a noite. Para ti, lavar o dia é literal. Um hábito que te dá muito chão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trecere fizică de la zi la noapte. Pentru tine, „a spăla ziua de pe tine” are sens la propriu. Un obicei care te ancorează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физический переход от дня к ночи. Ты в прямом смысле смываешь с себя день. Очень заземляющая привычка."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni inzira ifatika yo kuva ku manywa ujya nijoro. Kwikuraho umunsi ni ukuri kuri wowe. Ni akamenyero gatuza cyane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දවාලේ ඉඳන් රෑට ශාරීරික සංක්‍රමණයක්. ඔබට දවසේ වෙහෙස සෝදා හරින්නේ ඇත්තටමයි. ගොඩක් සන්සුන් කරන පුරුද්දක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzický prechod z dňa do noci. Zmyť zo seba celý deň berieš doslova. Veľmi upokojujúci zvyk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telesni prehod iz dneva v noč. Zate je spiranje dneva dobesedno. Zelo prizemljujoča navada."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuchinja kwemuviri kubva masikati kuenda usiku. Kugeza zuva kunobva pauri chaizvo. Tsika inodzikamisa zvikuru."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kala-guur jidheed oo maalinta ilaa habeenka. Inaad maalinta iska dhaqdo adiga macno toos ah ayay kuu leedahay. Caado aad u dejisa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalim fizik nga dita te nata. Për ty, ta lash ditën nga trupi është fjalë për fjalë. Një zakon që të qetëson shumë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физички прелаз из дана у ноћ. За тебе је „спрати дан са себе“ буквално. Навика која веома смирује."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peralihan fisik ti beurang ka peuting. Ngumbah kacapé dinten téh harfiah pikeun anjeun. Kabiasaan anu ngajantenkeun tengtrem pisan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fysisk övergång från dag till kväll. Att tvätta av sig dagen är bokstavligt för dig. En vana som verkligen hjälper dig att landa."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mpito wa kimwili kutoka mchana hadi usiku. Kwako, kuiosha siku ni halisi kabisa. Tabia inayotuliza sana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பகலிலிருந்து இரவுக்கு உடல்ரீதியான மாற்றம். நாளைக் கழுவி விடுவது உங்களுக்கு உண்மையாகவே நடக்கிறது. மனதை நிலைப்படுத்தும் பழக்கம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పగటి నుంచి రాత్రికి శరీరంతో మారడం. రోజును కడిగేసుకోవడం మీకు అక్షరాలా నిజం. మనసును స్థిరపరిచే చక్కని అలవాటు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гузариши ҷисмонӣ аз рӯз ба шаб. Барои ту рӯзро шуста партофтан маънии аслӣ дорад. Одати хеле оромкунанда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นการเปลี่ยนผ่านจากกลางวันสู่กลางคืนด้วยร่างกาย สำหรับคุณ การล้างเรื่องราวของวันออกไปเกิดขึ้นจริงตามตัวอักษร เป็นนิสัยที่ช่วยให้ใจนิ่งมาก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ መዓልቲ ናብ ምሸት ኣካላዊ ምስግጋር። ንዓኹም ነታ መዓልቲ ምሕጻብ ብሓቂ እዩ። ኣዝዩ ዘረጋግእ ልምዲ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günden gijä fiziki geçiş. Günüň ýadawlygyny ýuwup aýyrmak seniň üçin göçme manyda däl. Gaty köşeşdirýän endik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gündüzden geceye fiziksel bir geçiş. Günü üzerinden yıkayıp atmak senin için kelimenin tam anlamıyla gerçek. Çok dengeleyici bir alışkanlık."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фізичний перехід від дня до ночі. Для тебе «змити з себе день» — буквально. Дуже заземлювальна звичка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دن سے رات کی طرف جسمانی تبدیلی۔ آپ کے لیے دن کو دھو ڈالنا لفظی معنوں میں ہے۔ بہت سکون دینے والی عادت۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kundan tunga jismoniy oʻtish. Siz uchun kunning charchogʻini yuvib tashlash — tom maʼnoda. Juda xotirjamlik beruvchi odat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bước chuyển từ ngày sang đêm bằng chính cơ thể. Với bạn, gột rửa một ngày là theo nghĩa đen. Một thói quen giúp bạn rất vững vàng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utshintsho lomzimba ukusuka emini ukuya ebusuku. Ukuhlamba usuku kuyinyani kuwe. Umkhwa okuzinzisayo kakhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìyípadà ara láti ọ̀sán sí alẹ́. Fífọ ọjọ́ kúrò lára jẹ́ ohun gidi fún yín. Àṣà tó ń fini lọ́kàn balẹ̀ gan-an."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從白天切換到晚上的身體儀式。對你來說，「洗走一整天」是字面意思。這個習慣很能讓人安定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从白天到夜晚的身体切换。“洗去一天的疲惫”对你来说不只是一种说法。这是很让人安定的习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從白天切換到夜晚的身體儀式。對你來說，真的是把一整天洗掉。這是很讓人安定的習慣。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushintsho lomzimba olusuka emini luya ebusuku. Ukugeza usuku kusho lokho ngempela kuwe. Umkhuba okuzinzisa kakhulu."
          }
        }
      }
    },
