          "stringUnit" : {
            "state" : "translated",
            "value" : "A recompensa de uma vida de trabalho é ver o mundo. Deves estar a poupar para uma certa ideia de liberdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răsplata pentru o viață de muncă e să vezi lumea. Probabil pui deoparte pentru o anumită formă de libertate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Награда за годы работы — увидеть мир. Наверное, ты уже копишь на свою версию свободы."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igihembo cy'ubuzima bw'akazi ni ukubona isi. Birashoboka ko urimo kuzigama ugana ku bwisanzure runaka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වැඩ කරපු ජීවිතයක ත්‍යාගය ලෝකය දැකීම. ඔබ බොහෝ විට එක්තරා නිදහසක් වෙනුවෙන් ඉතිරි කරනවා ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmenou za život plný práce je vidieť svet. Asi si šetríš na svoju verziu slobody."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrada za življenje dela je spoznati svet. Verjetno varčuješ za svojo različico svobode."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mubairo wehupenyu hwebasa kuona nyika. Zvimwe uri kuchengetera rumwe rudzi rwerusununguko."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaalmarinta nolol shaqo ah waa inaad adduunka aragto. Malaha waxaad lacag u kaydinaysaa nooc xorriyad ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shpërblimi për një jetë pune është të shohësh botën. Ndoshta po kursen për një version të lirisë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Награда за живот рада је да видиш свет. Вероватно штедиш за неку своју верзију слободе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganjaran tina hirup anu dipaké damel nyaéta ningali dunya. Anjeun meureun nuju nabung pikeun hiji wangun kabébasan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belöningen för ett helt arbetsliv är att få se världen. Du sparar nog till din egen version av frihet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thawabu ya maisha ya kazi ni kuuona ulimwengu. Huenda unaweka akiba kuelekea aina fulani ya uhuru."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உழைப்பு நிறைந்த வாழ்க்கைக்கான பரிசு உலகைப் பார்ப்பது. ஒருவகைச் சுதந்திரத்திற்காக நீங்கள் சேமித்துக்கொண்டிருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జీవితమంతా పని చేసినందుకు బహుమతి ప్రపంచాన్ని చూడటమే. బహుశా మీరు ఒక రకమైన స్వేచ్ఛ కోసం పొదుపు చేస్తున్నారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подоши як умр кор — дидани дунё. Эҳтимол ту барои як навъ озодӣ пасандоз мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รางวัลของการทำงานมาทั้งชีวิตคือการได้เห็นโลก คุณน่าจะกำลังเก็บเงินเพื่ออิสรภาพในแบบของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዓስቢ ናይ ህይወት ስራሕ ዓለም ምርኣይ እዩ። ምናልባት ንሓደ ዓይነት ናጽነት ትቕጥቡ ኣለኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähmetli ömrüň sylagy — dünýäni görmek. Megerem, azatlygyň bir görnüşi üçin pul ýygnaýansyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ömür çalışmanın ödülü dünyayı görmek. Muhtemelen bir tür özgürlük için birikim yapıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагорода за життя, повне праці, — побачити світ. Мабуть, ти вже відкладаєш на свою версію свободи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمر بھر کی محنت کا انعام دنیا دیکھنا ہے۔ شاید آپ کی بچت آزادی کے کسی خواب کے لیے ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehnat bilan oʻtgan hayotning mukofoti — dunyoni koʻrish. Ehtimol, erkinlikning oʻsha koʻrinishi uchun jamgʻaryapsiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần thưởng cho cả đời làm việc là được ngắm thế giới. Chắc bạn đang dành dụm cho một kiểu tự do nào đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umvuzo wobomi bokusebenza kukubona ihlabathi. Mhlawumbi uqokelela imali ukuze ufumane uhlobo oluthile lwenkululeko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Èrè iṣẹ́ ìgbésí ayé ni rírí ayé. Ó ṣeé ṣe kí ẹ máa fi owó pamọ́ fún irú òmìnira kan."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一生辛勞的回報，就是看看這個世界。你大概正為某種自由而儲錢。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辛苦工作一辈子的回报，就是去看看世界。你大概正在为某种自由攒钱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力工作一輩子的獎賞，就是看看這個世界。你大概正在為某種自由存錢。"
