        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiki daga gida ya zama ainihin rayuwa yanzu. Samun wuri na musamman na da muhimmanci ga aikinku da natsuwar hankalinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבודה מהבית היא כבר חלק מהחיים. מקום מסודר חשוב לפרודוקטיביות ולשפיות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्क फ़्रॉम होम अब असली ज़िंदगी है। एक ढंग की जगह आपके काम और आपके मन के सुकून, दोनों के लिए ज़रूरी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rad od kuće sada je stvarnost. Pravi radni kutak važan je za tvoju produktivnost i zdrav razum."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travay lakay se lavi reyèl kounye a. Gen yon bon espas enpòtan pou pwodiktivite ou ak pou lespri ou."
