    "Hands-busy activities unlock quiet conversation." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأنشطة التي تشغل اليدين تفتح باب الحديث الهادئ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když mají ruce co dělat, tichý rozhovor plyne sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når hænderne har travlt, kommer de stille samtaler af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Hände beschäftigt sind, kommen leise Gespräche von allein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν τα χέρια είναι απασχολημένα, η ήσυχη κουβέντα βγαίνει πιο εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con las manos ocupadas, la conversación tranquila fluye sola."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kädet ovat touhussa, rauhallinen keskustelu syntyy helpommin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbubukas ng tahimik na usapan ang mga gawaing abala ang kamay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand les mains sont occupées, la conversation vient toute seule, en douceur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהידיים עסוקות, שיחה שקטה נפתחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब हाथ व्यस्त हों, तो धीमी बातचीत अपने आप शुरू हो जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a kéz el van foglalva, könnyebben megindul a csendes beszélgetés."
