        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাৰসাম্যপূৰ্ণ আৰু বাস্তৱসন্মত। আপুনি চৰমপন্থী নহয় — খাদ্য উপভোগ কৰে, লগতে নিজৰ যত্নও লয়।"
