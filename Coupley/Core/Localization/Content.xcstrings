        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જે મને અઘરું લાગે — લોકો સામે બોલવું, આત્મવિશ્વાસ"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abin da ke yi min wahala — magana a gaban jama'a, ƙwarin gwiwa"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משהו שקשה לי — דיבור מול קהל, ביטחון עצמי"
