    "Give them space but leave a door open: 'here when you want me.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنحوا شريكك مساحة واتركوا الباب مفتوحًا: «أنا هنا متى احتجتني»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej protějšku prostor, ale nech otevřené dveře: „Jsem tu, až budeš chtít.“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv plads, men lad døren stå på klem: »Jeg er her, når du vil.«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Raum, aber halte die Tür offen: „Ich bin da, wenn du mich brauchst.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε χώρο, αλλά άφησε μια πόρτα ανοιχτή: «Είμαι εδώ όποτε με θέλεις.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale espacio, pero deja la puerta abierta: “Aquí estoy cuando me necesites”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna tilaa, mutta jätä ovi auki: ”Olen täällä, kun haluat.”"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigyan siya ng espasyo pero mag-iwan ng bukas na pinto: “nandito lang ako kapag kailangan mo.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse-lui de l'espace, mais garde la porte ouverte : « je suis là quand tu veux »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לתת מרחב, אבל להשאיר דלת פתוחה: \"אני כאן כשיתחשק לך.\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें जगह दें, पर दरवाज़ा खुला रखें: “जब चाहें, मैं यहीं हूँ।”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj neki teret, de hagyd nyitva az ajtót: „Itt vagyok, ha szükséged van rám.”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri dia ruang, tapi biarkan pintu terbuka: “aku di sini kalau kamu butuh.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia spazio, ma tieni una porta aperta: «Ci sono quando vuoi»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとりの時間をあげつつ、「話したくなったらいつでもいるよ」と扉を開けておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼자 있을 시간을 주되 “필요하면 언제든 여기 있어요” 하고 문을 열어 두세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri dia ruang tapi biarkan pintu terbuka: “saya ada bila anda perlukan.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi partneren din rom, men la døren stå på gløtt: «Jeg er her når du vil.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef ruimte, maar laat de deur open: “Ik ben er als je me nodig hebt.”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj przestrzeń, ale zostaw otwarte drzwi: „Jestem, kiedy zechcesz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê espaço, mas deixe a porta aberta: “tô aqui quando quiser”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă-i spațiu, dar lasă și o ușă deschisă: „sunt aici când ai nevoie de mine”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай партнёру пространство, но оставь дверь открытой: «Я рядом, когда захочешь»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge utrymme men lämna dörren på glänt: ”Jag finns här när du vill.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้พื้นที่ แต่เปิดประตูไว้: “อยู่ตรงนี้นะ เมื่อไหร่ที่อยากให้อยู่ด้วย”"
