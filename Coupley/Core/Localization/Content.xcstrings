        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubalekela kancane kuyindlela yakho yokululama. Ukuphuma ezicabangweni zakho ngokuthile okujabulisayo kukuvuselela kakhulu kunokukhuluma ngakho."
          }
        }
      }
