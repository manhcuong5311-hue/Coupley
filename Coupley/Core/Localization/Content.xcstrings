        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պրագմատիկ մոտեցում։ Քո իրական կյանքը աշխատանքից դուրս է։ Աշխատանքը ծառայում է ավելի մեծ նպատակի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatis. Hidupmu yang sebenarnya ada di luar pekerjaan. Pekerjaan hanyalah sarana untuk mewujudkan visimu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ele ihe anya n'ezie. Ndụ gị n'ezie na-eme n'èzí ọrụ. Ọrụ na-enyere ọhụụ gị aka."
