        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ jọ ṣe nǹkan tí kò béèrè nǹkan kan — ẹ se oúnjẹ, ẹ ká aṣọ, ẹ yàwòrán."
