    "Passive relaxation works for you. This can be a great shared couple ritual — or totally individual, depending on the show." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسترخاء الهادئ يناسبكم. قد يكون هذا طقسًا ثنائيًا رائعًا، أو وقتًا فرديًا تمامًا، حسب ما تشاهدونه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje na tebe pasivní relax. Může to být skvělý společný rituál – nebo úplně tvoje věc, podle toho, na co se koukáš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv afslapning virker for dig. Det kan være et dejligt fælles ritual – eller helt individuelt, alt efter serien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passive Entspannung tut dir gut. Das kann ein schönes gemeinsames Ritual sein – oder ganz deins, je nach Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε χαλαρώνει να παρακολουθείς κάτι. Μπορεί να γίνει υπέροχη τελετουργία για τους δυο σας — ή εντελώς προσωπική, ανάλογα με τη σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajarte sin hacer nada te funciona. Puede ser un gran ritual en pareja, o algo totalmente individual, según la serie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiivinen rentoutuminen toimii sinulle. Siitä voi tulla upea yhteinen rituaali – tai täysin oma juttu, sarjasta riippuen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana sa’yo ang chill na pagpapahinga. Puwede itong maging magandang ritwal ninyong dalawa — o sarili mong oras, depende sa palabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détente passive te réussit. Ça peut devenir un super rituel de couple, ou rester un moment perso, selon la série."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רגיעה פסיבית עובדת בשבילך. זה יכול להיות טקס זוגי נהדר — או משהו אישי לגמרי, תלוי בסדרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आराम से कुछ देखना आपको सुकून देता है। यह एक प्यारी साझा रस्म बन सकती है — या पूरी तरह निजी, शो पर निर्भर करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked a passzív kikapcsolódás válik be. Ez lehet remek közös rituálé – vagy teljesen egyéni, a sorozattól függően."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaksasi pasif cocok untukmu. Ini bisa jadi ritual berdua yang menyenangkan — atau sepenuhnya pribadi, tergantung tontonannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relax passivo fa per te. Può diventare un bellissimo rituale di coppia — o un momento tutto tuo, dipende dalla serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け身でリラックスできるタイプです。観るもの次第で、ふたりの素敵な習慣にも、完全にひとりの時間にもなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편하게 늘어지는 휴식이 잘 맞아요. 무엇을 보느냐에 따라 멋진 커플 의식이 될 수도, 완전히 혼자만의 시간이 될 수도 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersantai secara pasif sesuai untuk anda. Ia boleh menjadi rutin pasangan yang hebat — atau aktiviti sendiri, bergantung pada rancangannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv avkobling fungerer for deg. Det kan bli et fint ritual for dere to – eller helt ditt eget, alt etter serien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passief ontspannen werkt voor jou. Dat kan een heerlijk ritueel voor jullie samen zijn – of helemaal iets voor jezelf, afhankelijk van de serie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bierny relaks ci służy. To może być świetny wspólny rytuał – albo zupełnie osobny, zależnie od serialu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxar sem esforço funciona para você. Pode ser um ótimo ritual do casal — ou algo totalmente individual, dependendo da série."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxarea pasivă funcționează pentru tine. Poate fi un ritual frumos în doi — sau ceva complet individual, în funcție de serial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе подходит пассивный отдых. Это может стать отличным ритуалом для двоих — или чем-то совсем личным, смотря что за сериал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv avkoppling funkar för dig. Det kan bli en fin gemensam ritual – eller något helt eget, beroende på serien."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การพักผ่อนแบบสบายๆ ได้ผลกับคุณ อาจเป็นกิจวัตรคู่รักที่ดีมาก หรือเป็นเวลาส่วนตัวล้วนๆ ก็ได้ แล้วแต่ว่าดูเรื่องอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasif dinlenme sana iyi geliyor. Diziye göre harika bir çift ritüeli de olabilir, tamamen bireysel bir an da."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі допомагає пасивний відпочинок. Це може бути чудовий спільний ритуал — або цілком особистий, залежно від серіалу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư giãn nhẹ nhàng hợp với bạn. Đây có thể là nghi thức tuyệt vời của hai bạn — hoặc hoàn toàn riêng tư, tùy bộ phim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被动放松很适合你。这可以是很棒的两人仪式，也可以完全各看各的，看剧而定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆放空對你很有用。這可以是很棒的兩人小儀式，也可以完全是個人時間，看是什麼節目。"
          }
        }
      }
    },
    "Patience has limits, and bottling things leads to bigger blow-ups. Small, early conversations are usually gentler for everyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للصبر حدود، وكتمان الأمور يقود إلى انفجارات أكبر. الأحاديث الصغيرة المبكرة عادةً ألطف على الجميع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trpělivost má meze a dusit věci v sobě vede k větším výbuchům. Malé, včasné rozhovory bývají šetrnější pro všechny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighed har grænser, og når man holder ting inde, bliver eksplosionerne større. Små, tidlige samtaler er som regel blidere for alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld hat Grenzen, und Runterschlucken führt zu größeren Ausbrüchen. Kleine, frühe Gespräche sind meist schonender für alle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υπομονή έχει όρια, και ό,τι κρατάς μέσα σου καταλήγει σε μεγαλύτερες εκρήξεις. Οι μικρές, έγκαιρες κουβέντες είναι συνήθως πιο ήπιες για όλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paciencia tiene un límite, y guardarse las cosas acaba en estallidos más grandes. Las conversaciones pequeñas y tempranas suelen ser más suaves para todos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kärsivällisyydellä on rajansa, ja asioiden patoaminen johtaa isompiin räjähdyksiin. Pienet, ajoissa käydyt keskustelut ovat yleensä lempeämpiä kaikille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May hangganan ang pasensya, at ang pagkimkim ay nauuwi sa mas malaking pagsabog. Kadalasan, mas magaan para sa lahat ang maliliit at maagang pag-uusap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La patience a ses limites, et à force de tout garder pour soi, ça finit par exploser plus fort. Les petites discussions, tôt, sont souvent plus douces pour tout le monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לסבלנות יש גבול, ודברים שנאגרים מתפוצצים בגדול. שיחות קטנות ומוקדמות בדרך כלל עדינות יותר לכולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्र की भी हद होती है, और बातें मन में दबाते रहने से आगे चलकर बड़े झगड़े होते हैं। शुरुआत में ही छोटी-छोटी बातचीत अक्सर सबके लिए ज़्यादा आसान रहती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A türelemnek is van határa, és az elfojtott dolgokból nagyobb robbanás lesz. A kicsi, korai beszélgetések általában mindenkinek kíméletesebbek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesabaran ada batasnya, dan memendam perasaan bisa berujung ledakan yang lebih besar. Obrolan kecil sejak awal biasanya terasa lebih ringan bagi semua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pazienza ha un limite, e tenersi tutto dentro porta a esplosioni più grandi. Le conversazioni piccole e tempestive di solito sono più gentili per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我慢には限界があり、ため込むほど爆発も大きくなりがちです。小さなうちに早めに話すほうが、ふたりともやさしくいられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인내에도 한계가 있고, 꾹 참다 보면 더 크게 터지기 쉬워요. 일찍, 가볍게 나누는 대화가 서로에게 훨씬 부드러워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesabaran ada hadnya, dan memendam perasaan boleh membawa kepada letusan yang lebih besar. Perbualan kecil dari awal biasanya lebih lembut untuk semua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighet har sine grenser, og det du holder inne, kan eksplodere senere. Små, tidlige samtaler er som regel skånsommere for alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld heeft grenzen, en opkroppen leidt tot grotere uitbarstingen. Kleine gesprekken in een vroeg stadium zijn meestal zachter voor iedereen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwość ma granice, a tłumienie emocji kończy się większymi wybuchami. Krótkie rozmowy na wczesnym etapie są zwykle łagodniejsze dla wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paciência tem limite, e guardar tudo leva a explosões maiores. Conversas pequenas e logo no começo costumam ser mais leves para todo mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răbdarea are limite, iar lucrurile ținute în tine duc la explozii mai mari. Discuțiile mici și din timp sunt de obicei mai blânde pentru toată lumea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У терпения есть предел, а сдерживаемое потом выливается в большие ссоры. Короткие разговоры на раннем этапе обычно бережнее для всех."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålamod har sina gränser, och att hålla saker inom sig leder till större utbrott. Små samtal i tid är oftast mjukare för alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความอดทนมีขีดจำกัด และการเก็บกดมักนำไปสู่การระเบิดที่ใหญ่กว่าเดิม การคุยกันเร็วๆ ตั้งแต่เรื่องยังเล็กมักนุ่มนวลกว่าสำหรับทุกคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabrın da bir sınırı var ve içine atmak daha büyük patlamalara yol açıyor. Küçük ve erken konuşmalar genelde herkes için daha yumuşak geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпіння має межі, а стримане всередині згодом вибухає сильніше. Невеликі розмови на ранньому етапі зазвичай м’якші для всіх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiên nhẫn cũng có giới hạn, và dồn nén dễ dẫn đến những lần bùng nổ lớn hơn. Nói sớm từ khi chuyện còn nhỏ thường nhẹ nhàng hơn cho cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耐心是有限的，憋着容易酿成更大的爆发。早一点、轻一点地聊，通常对谁都更温和。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等累積多了才說"
          }
        }
      }
    },
    "Pay off debt together and start fresh" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سداد الديون معًا وبداية جديدة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splatit spolu dluhy a začít znovu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betale gæld af sammen og starte på en frisk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsam Schulden abbauen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεχρέωμα μαζί και νέο ξεκίνημα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldar deudas juntos y empezar de cero"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksetaan velat yhdessä ja aloitetaan alusta"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayaran nang sabay ang utang at magsimula muli"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rembourser nos dettes et repartir à zéro"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
