          "stringUnit" : {
            "state" : "translated",
            "value" : "Oorun ń nípa lórí ìṣesí, sùúrù, àti bí ẹ ṣe wà fún olólùfẹ́ yín tó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠會影響心情、耐性，以及你能為另一半付出多少心力。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠会影响心情、耐心，以及你能给另一半多少陪伴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠會影響心情、耐心，還有你能給另一半多少陪伴。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukulala kuthinta imizwa, ukubekezela, nokuthi ukhona kangakanani njengomlingani."
          }
        }
      }
    },
    "Sleep is sacred for you. A partner who keeps you up, or has different sleep habits, will affect your functioning — and your mood." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap is vir jou heilig. ’n Maat wat jou wakker hou of ander slaapgewoontes het, sal jou funksionering raak – en jou bui."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንቅልፍ ለእርስዎ የተቀደሰ ነው። እንቅልፍ የሚነሱዎት ወይም የተለየ የእንቅልፍ ልማድ ያላቸው አጋር በዕለት ውሎዎ — እና በስሜትዎ — ላይ ተጽዕኖ ያሳድራሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوم مقدّس عندك. شريك يُبقيك مستيقظًا أو له عادات نوم مختلفة سيؤثر في أدائك ومزاجك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ বাবে টোপনি পবিত্ৰ। যিজন সংগীয়ে আপোনাক সাৰে ৰাখে, বা যাৰ টোপনিৰ অভ্যাস বেলেগ, তেওঁ আপোনাৰ দিনটোত প্ৰভাৱ পেলাব — আৰু আপোনাৰ মনতো।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuxu sənin üçün müqəddəsdir. Səni yatmağa qoymayan və ya fərqli yuxu vərdişləri olan partnyor gününə — və əhvalına təsir edəcək."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон для цябе — святое. Калі палавінка не дае спаць ці мае іншы рэжым, гэта адаб’ецца на тваім самаадчуванні — і настроі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сънят е свещен за теб. Половинка, която не те оставя да заспиш или има други навици за сън, ще се отрази на функционирането ти – и на настроението ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘুম তোমার কাছে পবিত্র। যে পার্টনার তোমাকে জাগিয়ে রাখে বা যার ঘুমের অভ্যাস আলাদা, সে তোমার দিনভর চলা — আর তোমার মুড — দুটোতেই প্রভাব ফেলবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San ti je svet. Voljena osoba koja te drži budnim ili ima drugačije navike spavanja uticaće na to kako funkcionišeš – i na tvoje raspoloženje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a tu, dormir és sagrat. Una parella que et desvetlli, o amb uns altres hàbits de son, afectarà com funciones — i el teu humor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek je pro tebe posvátný. Protějšek, který tě nenechá spát nebo má jiné spací návyky, ovlivní, jak funguješ – i tvou náladu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae cwsg yn sanctaidd i ti. Bydd partner sy'n dy gadw'n effro, neu sydd ag arferion cysgu gwahanol, yn effeithio ar sut rwyt ti'n ymdopi — ac ar dy hwyliau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvn er helligt for dig. En partner, der holder dig vågen eller har andre sovevaner, påvirker, hvordan du fungerer – og dit humør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf ist dir heilig. Wer dich wach hält oder ganz andere Schlafgewohnheiten hat, beeinflusst, wie gut du funktionierst – und deine Laune."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος είναι ιερός για σένα. Ένα ταίρι που δεν σε αφήνει να κοιμηθείς ή έχει άλλες συνήθειες ύπνου θα επηρεάσει τη λειτουργικότητά σου — και τη διάθεσή σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ti el sueño es sagrado. Una pareja que te quite horas de sueño, o tenga otros hábitos, afectará a tu rendimiento — y a tu ánimo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni on sulle püha. Partner, kes sind üleval hoiab või kelle uneharjumused on teistsugused, mõjutab su toimetulekut — ja tuju."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loa sakratua da zuretzat. Esna mantentzen zaituen edo lo-ohitura desberdinak dituen bikotekide batek zure funtzionamenduan eragingo du, baita zure aldartean ere."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خواب برایت مقدس است. پارتنری که بیدار نگهت دارد یا عادت‌های خواب متفاوتی داشته باشد، روی عملکرد — و حالت — اثر می‌گذارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni on sinulle pyhää. Kumppani, joka valvottaa sinua tai jolla on eri unirytmi, vaikuttaa jaksamiseesi – ja mielialaasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagrado sa’yo ang tulog. Ang partner na nagpupuyat sa’yo o may ibang gawi sa pagtulog ay makakaapekto sa pagkilos mo — at sa mood mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil, c'est sacré pour toi. Quelqu'un qui t'empêche de dormir, ou qui a d'autres habitudes, aura un impact sur ta forme — et ton humeur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is rud naofa duit an codladh. Má choinníonn do pháirtí i do dhúiseacht thú, nó má tá nósanna codlata difriúla ag do pháirtí, rachaidh sé i bhfeidhm ar d’fheidhmiú — agus ar do ghiúmar."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono é sagrado para ti. Unha parella que non te deixe durmir, ou con hábitos de sono distintos, afectará ao teu rendemento e ao teu humor."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઊંઘ તમારા માટે પવિત્ર છે. તમને જગાડી રાખે કે જેની ઊંઘની આદત જુદી હોય એવા પાર્ટનર તમારા રોજિંદા કામ પર — અને તમારા મૂડ પર — અસર કરશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barci abu ne mai tsarki a gare ku. Abokin zama da ke hana ku barci, ko mai halayen barci daban, zai shafi yadda kuke aiki — da yanayinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השינה קדושה בשבילך. מי שמונע ממך לישון, או מישהו עם הרגלי שינה שונים, ישפיע על התפקוד שלך — ועל מצב הרוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए नींद सबसे ऊपर है। जो पार्टनर आपको जगाए रखे या जिसकी नींद की आदतें अलग हों, उसका असर आपके दिन पर — और आपके मूड पर — पड़ेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San ti je svet. Voljena osoba koja te drži budnim ili ima drukčije navike spavanja utjecat će na to kako funkcioniraš – i na tvoje raspoloženje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dòmi sakre pou ou. Yon patnè ki anpeche ou dòmi, oswa ki gen lòt abitid dòmi, ap afekte jan ou fonksyone — ak imè ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked szent az alvás. Ha a párod ébren tart, vagy mások az alvási szokásai, az kihat a működésedre – és a hangulatodra is."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քունը քեզ համար սրբություն է։ Զուգընկերը, ով քեզ արթուն է պահում կամ քնի այլ սովորություններ ունի, կազդի քո աշխատունակության ու տրամադրության վրա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur itu sakral buatmu. Pasangan yang membuatmu begadang, atau punya kebiasaan tidur berbeda, akan memengaruhi kondisimu — dan mood-mu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ụra dị nsọ nye gị. Onye na-eme ka ị mụrụ anya, ma ọ bụ nwere omume ụra dị iche, ga-emetụta otu ị si arụ ọrụ — na ọnọdụ obi gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svefninn er heilagur hjá þér. Maki sem heldur fyrir þér vöku eða hefur aðrar svefnvenjur hefur áhrif á hvernig þú virkar – og á skapið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per te il sonno è sacro. Un partner che ti toglie il sonno, o con abitudini diverse, inciderà su come stai — e sul tuo umore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は何より大切なものです。夜更かしに付き合わせるパートナーや睡眠習慣が違う相手だと、調子にも気分にも影響が出ます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turu iku suci kanggo panjenengan. Pasangan sing nggawe panjenengan melek, utawa duwe kabiasaan turu sing beda, bakal ngaruhi kegiatan — lan swasana ati panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ძილი შენთვის წმინდაა. პარტნიორი, რომელიც დაძინებას არ გაცლის ან ძილის სხვა ჩვევები აქვს, შენს ყოველდღიურობაზე იმოქმედებს — და განწყობაზეც."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұйқы сен үшін қасиетті. Сені ұйықтатпайтын не ұйқы әдеттері басқа серік күйіңе де, көңіл-күйіңе де әсер етеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការគេងជារឿងពិសិដ្ឋសម្រាប់អ្នក។ ដៃគូដែលធ្វើឲ្យអ្នកគេងយឺត ឬមានទម្លាប់គេងខុសពីអ្នក នឹងប៉ះពាល់ដល់សកម្មភាពប្រចាំថ្ងៃ — និងអារម្មណ៍របស់អ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿದ್ರೆ ನಿಮಗೆ ಪವಿತ್ರ. ನಿಮ್ಮನ್ನು ಎಚ್ಚರವಾಗಿರಿಸುವ ಅಥವಾ ಬೇರೆ ನಿದ್ರೆಯ ಅಭ್ಯಾಸಗಳಿರುವ ಸಂಗಾತಿ ನಿಮ್ಮ ದಿನಚರಿಯ ಮೇಲೆ — ಮತ್ತು ಮೂಡ್ ಮೇಲೆ — ಪರಿಣಾಮ ಬೀರುತ್ತಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠만큼은 양보할 수 없어요. 잠을 못 자게 하거나 수면 습관이 다른 연인이라면 컨디션과 기분에 영향을 줄 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xew ji bo te pîroz e. Hevjînek ku te şiyar dihêle an adetên xewê yên cuda hene, dê bandorê li rojên te bike — û li halê te jî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уйку сен үчүн ыйык. Сени уктатпаган же уйку адаты башка сүйгөнүң күнүңө — жана маанайыңа таасир этет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlof ass dir helleg. Wann däi Schatz dech wakereg hält oder aner Schlofgewunnechten huet, beaflosst dat, wéi s de funktionéiers — an deng Stëmmung."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການນອນເປັນສິ່ງສັກສິດສຳລັບເຈົ້າ ຄູ່ທີ່ເຮັດໃຫ້ເຈົ້ານອນບໍ່ພໍ ຫຼື ມີນິໄສການນອນຕ່າງກັນ ຈະມີຜົນຕໍ່ການໃຊ້ຊີວິດຂອງເຈົ້າ — ແລະ ອາລົມຂອງເຈົ້ານຳ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miegas tau šventas. Antroji pusė, kuri neleidžia tau miegoti ar turi kitokių miego įpročių, paveiks tavo savijautą – ir nuotaiką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev miegs ir svēts. Otrā puse, kas tevi nelaiž gulēt vai kurai ir citādi miega paradumi, ietekmēs tavu ikdienu – un noskaņojumu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masina aminao ny torimaso. Ny olon-tiana tsy mampatory anao na manana fahazarana matory hafa dia hisy fiantraikany amin'ny fiainanao — sy ny toe-ponao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He tapu te moe ki a koe. Mēnā ka whakaoho tonu tō hoa aroha i a koe, he rerekē rānei ōna tikanga moe, ka pā ki tō oranga — me ō kare ā-roto."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сонот за тебе е свет. Половинка што не те остава да спиеш или има поинакви навики за спиење ќе влијае на тоа како функционираш — и на расположението."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഉറക്കം നിങ്ങൾക്ക് പവിത്രമാണ്. നിങ്ങളെ ഉറങ്ങാൻ വിടാത്തതോ വ്യത്യസ്ത ഉറക്കശീലമുള്ളതോ ആയ പങ്കാളി നിങ്ങളുടെ പ്രവർത്തനത്തെയും മൂഡിനെയും ബാധിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нойр чамд ариун. Чамайг сэрүүн байлгадаг, эсвэл өөр нойрны дадалтай хань чиний чадавх, сэтгэл санаанд нөлөөлнө."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झोप तुमच्यासाठी पवित्र आहे. जोडीदारामुळे जागरण झाले किंवा झोपेच्या सवयी वेगळ्या असल्या, तर तुमच्या दिवसावर — आणि मूडवरही — परिणाम होईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur sangat penting bagi anda. Pasangan yang membuatkan anda berjaga, atau tabiat tidurnya berbeza, akan mempengaruhi fungsi diri — dan perasaan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-irqad huwa sagru għalik. Partner li ma jħallikx torqod, jew li għandu drawwiet differenti tal-irqad, se jaffettwa kif tiffunzjona — u l-burdata tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အိပ်ချိန်က သင့်အတွက် မြင့်မြတ်တယ်။ သင့်ကို မအိပ်ရအောင် လုပ်တဲ့ ဒါမှမဟုတ် အိပ်စက်ပုံ မတူတဲ့ ချစ်သူက သင့်ရဲ့ လုပ်ဆောင်နိုင်စွမ်း — စိတ်ခံစားမှုကိုပါ ထိခိုက်လိမ့်မယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnen er hellig for deg. En partner som holder deg våken eller har andre søvnvaner, vil påvirke hvordan du fungerer – og humøret ditt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निद्रा तपाईंका लागि पवित्र छ। तपाईंलाई जगाइराख्ने वा फरक सुत्ने बानी भएको पार्टनरले तपाईंको दिनचर्या — र मुडमा असर पार्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap is heilig voor je. Een partner die je wakker houdt of andere slaapgewoonten heeft, beïnvloedt hoe je functioneert – en je humeur."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulo ndi topatulika kwa inu. Wokondedwa amene amakusowetsani tulo, kapena ali ndi zizolowezi zosiyana za kugona, adzakhudza mmene mumagwirira ntchito — ndi mtima wanu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hirribni siif qulqulluu dha. Hirriba kee jeequun ykn amalli hirribaa garaa garaa hojii kee — fi miira kee irratti dhiibbaa geessisa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନିଦ ଆପଣଙ୍କ ପାଇଁ ପବିତ୍ର। ଯେଉଁ ସାଥୀ ଆପଣଙ୍କୁ ଜଗାଇ ରଖନ୍ତି କିମ୍ବା ଯାହାଙ୍କ ଶୋଇବା ଅଭ୍ୟାସ ଅଲଗା, ସେ ଆପଣଙ୍କ କାର୍ଯ୍ୟକ୍ଷମତା — ଓ ମନୋଭାବ ଉପରେ ପ୍ରଭାବ ପକାଇବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੀਂਦ ਤੁਹਾਡੇ ਲਈ ਬੇਹੱਦ ਕੀਮਤੀ ਹੈ। ਜੇ ਪਾਰਟਨਰ ਤੁਹਾਨੂੰ ਜਗਾਈ ਰੱਖਣ ਜਾਂ ਉਨ੍ਹਾਂ ਦੀਆਂ ਸੌਣ ਦੀਆਂ ਆਦਤਾਂ ਵੱਖਰੀਆਂ ਹੋਣ, ਤਾਂ ਇਸ ਦਾ ਅਸਰ ਤੁਹਾਡੇ ਕੰਮਕਾਜ ਉੱਤੇ ਪਵੇਗਾ — ਅਤੇ ਤੁਹਾਡੇ ਮੂਡ ਉੱਤੇ ਵੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen jest dla ciebie święty. Ktoś, kto nie daje ci spać albo ma inne nawyki, wpłynie na twoje funkcjonowanie – i nastrój."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوب ستاسو لپاره سپېڅلی دی. هغه ملګری چې ویښ مو ساتي یا د خوب بېل عادتونه لري، ستاسو پر ورځني کار — او مزاج — اغېز کوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para você, o sono é sagrado. Alguém que não te deixe dormir, ou tenha outros hábitos na hora de dormir, vai afetar seu rendimento — e seu humor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono é sagrado para ti. Um par que te tire o sono, ou tenha hábitos diferentes, vai afetar o teu dia — e o teu humor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somnul e sacru pentru tine. Un partener care nu te lasă să dormi sau are alte obiceiuri de somn îți va da peste cap ritmul — și starea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон для тебя священен. Партнёр, который не даёт спать или живёт в другом режиме, повлияет и на твою продуктивность, и на настроение."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibitotsi ni ibyera kuri wowe. Umukunzi ukubuza gusinzira, cyangwa ufite imisinzirire itandukanye, azagira ingaruka ku mikorere yawe — no ku marangamutima yawe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නින්ද ඔබට පූජනීයයි. ඔබව නිදි වර්ජිත කරන, හෝ වෙනස් නින්දේ පුරුදු තියෙන සහකරුවෙක් ඔබේ දවසට — සහ ඔබේ මනෝභාවයට — බලපායි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánok je pre teba posvätný. Polovička, ktorá ťa drží hore alebo má iné spánkové návyky, ovplyvní, ako funguješ – aj tvoju náladu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spanec ti je svet. Partner, ki te drži pokonci ali ima drugačne spalne navade, bo vplival na tvoje delovanje – in na razpoloženje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hope dzinoera kwauri. Mudiwa anokuramba wakamuka, kana ane maitiro akasiyana ekurara, anokanganisa mashandiro ako — nemanzwiro ako."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurdadu waa wax kuu muqaddas ah. Lammaane ku soo jeediya ama leh caadooyin hurdo oo kala duwan ayaa saameyn doona sida aad u shaqeyso — iyo niyaddaada."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjumi për ty është i shenjtë. Një partner që të mban zgjuar ose ka zakone të tjera gjumi do të ndikojë në funksionimin tënd – dhe në humorin tënd."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сан ти је светиња. Половина која ти ремети сан или има другачије навике спавања утицаће на то како функционишеш — и на твоје расположење."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saré téh suci pikeun anjeun. Pasangan anu ngajantenkeun anjeun bangun dugi ka wengi, atanapi kabiasaan sarénna béda, bakal mangaruhan kahirupan sapopoé sareng wanda anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömnen är helig för dig. En partner som håller dig vaken eller har andra sovvanor påverkar hur du fungerar – och ditt humör."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usingizi ni kitu kitakatifu kwako. Mwenzi anayekuweka macho, au mwenye mazoea tofauti ya kulala, ataathiri utendaji wako — na hisia zako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தூக்கம் உங்களுக்குப் புனிதமானது. உங்களைத் தூங்கவிடாமல் வைத்திருக்கும் அல்லது வேறுபட்ட தூக்கப் பழக்கம் கொண்ட துணை, உங்கள் செயல்திறனையும் மனநிலையையும் பாதிப்பார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిద్ర మీకు పవిత్రమైనది. మిమ్మల్ని మేల్కొని ఉంచే లేదా వేరే నిద్ర అలవాట్లు ఉన్న భాగస్వామి మీ పనితీరుపై — మీ మూడ్‌పై ప్రభావం చూపుతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоб барои ту муқаддас аст. Ёре, ки туро бедор нигоҳ медорад ё одатҳои дигари хоб дорад, ба кор ва кайфиятат таъсир мерасонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนอนคือสิ่งศักดิ์สิทธิ์สำหรับคุณ คนรักที่ทำให้คุณนอนดึกหรือมีนิสัยการนอนต่างกันจะส่งผลต่อการใช้ชีวิตและอารมณ์ของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ድቃስ ንዓኹም ቅዱስ እዩ። ዘንቅሓኩም ወይ ዝተፈልየ ልምዲ ድቃስ ዘለዎ መጻምዲ ኣብ ንጥፈትኩም — ኣብ ስምዒትኩም'ውን — ጽልዋ ክህልዎ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uky seniň üçin mukaddes. Seni ýatyrmaýan ýa-da başga uky endikleri bolan söýgüli seniň ýagdaýyňa — we keýpiňe täsir eder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku senin için kutsal. Seni uyutmayan ya da farklı uyku alışkanlıkları olan bir partner hem verimini hem ruh halini etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон для тебе — святе. Половинка, яка не дає спати чи має інший режим, вплине на твоє самопочуття — і настрій."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیند آپ کے لیے مقدس ہے۔ اگر ساتھی آپ کو جگائے رکھے یا اس کی نیند کی عادتیں مختلف ہوں، تو آپ کا کام کاج اور موڈ دونوں متاثر ہوں گے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyqu siz uchun muqaddas. Sizni uxlatmaydigan yoki boshqacha uyqu odatlariga ega sherik ish qobiliyatingizga — va kayfiyatingizga taʼsir qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấc ngủ là thiêng liêng với bạn. Người khiến bạn thức khuya, hay có thói quen ngủ khác, sẽ ảnh hưởng đến sức làm việc — và tâm trạng của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubuthongo bungcwele kuwe. Iqabane elikugcina uvukile, okanye elinemikhwa eyahlukileyo yokulala, liya kuchaphazela indlela osebenza ngayo — nemo yakho."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oorun jẹ́ mímọ́ fún yín. Olólùfẹ́ tó ń dá yín dúró láìsùn, tàbí tó ní àṣà oorun mìíràn, yóò nípa lórí bí ẹ ṣe ń ṣe — àti ìṣesí yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠對你來說神聖不可侵犯。如果另一半害你睡不夠，或作息很不同，會影響你的狀態和心情。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠对你来说神圣不可侵犯。如果另一半让你睡不好，或作息很不一样，就会影响你的状态和心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠對你來說很神聖。如果另一半害你熬夜，或作息不同，會影響你的狀態和心情。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukulala kungcwele kuwe. Umlingani okugcina uphapheme, noma onemikhuba yokulala ehlukile, uzothinta indlela osebenza ngayo — kanye nemizwa yakho."
          }
        }
      }
    },
    "Slow morning, nowhere to be" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’n Stadige oggend, nêrens om heen te gaan nie"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተረጋጋ ጠዋት፣ የምሄድበት ቦታ የለም"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صباح هادئ بلا مواعيد"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেহেম পুৱা, ক'তো যাবলগীয়া নাই"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tələsmədən səhər, getməli heç yer yox"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Павольная раніца, нікуды не трэба"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бавна сутрин, без да бързам за никъде"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধীরেসুস্থে সকাল, কোথাও যাওয়ার তাড়া নেই"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagano jutro, nigdje ne žurim"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un matí tranquil, sense pressa per res"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalé ráno, nikam nespěchat"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bore hamddenol, dim rhaid bod yn unman"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsom morgen, ingen planer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer Morgen, keine Termine"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αργό πρωινό, χωρίς υποχρεώσεις"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mañana tranquila, sin prisas"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aeglane hommik, kuhugi pole kiiret"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goiz lasaia, presarik gabe"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صبحی آرام، بدون هیچ برنامه‌ای"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidas aamu, ei mihinkään kiire"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabagal na umaga, walang lakad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une matinée tranquille, rien de prévu"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maidin mhall, gan áit le bheith"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañá tranquila, sen présas"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ધીમી સવાર, ક્યાંય જવાનું નહીં"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safiya a hankali, babu inda za a je"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוקר איטי, בלי לאן למהר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरामदेह सुबह, कहीं जाने की जल्दी नहीं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagano jutro, nigdje ne moram biti"
          }
        },
        "ht" : {
