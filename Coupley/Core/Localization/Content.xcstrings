        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agbára gíga, ohùn gíga. Ó ṣeé ṣe kí inú yín dùn jù nígbà tí ẹ bá dé ju ìgbà tí ẹ kúrò lọ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精力全開，音量全開。你到達時的心情，大概比出門時更好。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量拉满，音量拉满。你到达时的心情多半比出发时更好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量全開、音量全開。你抵達時的心情，大概比出門時還好。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amandla aphezulu, izwi eliphezulu. Kungenzeka ufika usujabule kakhulu kunalapho uhamba."
          }
        }
      }
    },
    "Maximum flexibility — or genuine uncertainty. Either way, you're not anchored to a specific place, which is a real freedom." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum buigsaamheid – of eerlike onsekerheid. Hoe ook al, jy is nie aan ’n spesifieke plek geanker nie, en dis ’n regte vryheid."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከፍተኛ ተለዋዋጭነት — ወይም እውነተኛ እርግጠኛ አለመሆን። ያም ሆነ ይህ በአንድ ቦታ አልታሰሩም፤ ይህ እውነተኛ ነፃነት ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرونة قصوى، أو حيرة صادقة. في الحالتين لا شيء يربطك بمكان محدد، وهذه حرية حقيقية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৰ্বোচ্চ নমনীয়তা — বা সঁচা অনিশ্চয়তা। যিয়েই নহওক, আপুনি কোনো নিৰ্দিষ্ট ঠাইত বান্ধ খাই থকা নাই, যিটো এক সঁচা স্বাধীনতা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum çeviklik — ya da həqiqi qeyri-müəyyənlik. Hər halda, konkret bir yerə bağlı deyilsən və bu, əsl azadlıqdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максімальная гнуткасць — або шчырая нявызначанасць. Так ці інакш, цябе не трымае нейкае канкрэтнае месца, і гэта сапраўдная свабода."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимална гъвкавост – или истинска несигурност. Така или иначе не те държи конкретно място, а това е истинска свобода."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরোপুরি নমনীয় — বা সত্যিকারের অনিশ্চয়তা। যেভাবেই হোক, তুমি নির্দিষ্ট কোনো জায়গায় বাঁধা নও, আর এটা সত্যিই একরকম স্বাধীনতা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuna fleksibilnost – ili iskrena nesigurnost. Kako god, ne veže te nijedno određeno mjesto, a to je prava sloboda."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màxima flexibilitat — o incertesa de veritat. En tot cas, no t'ancores a cap lloc concret, i això és una llibertat real."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální flexibilita – nebo upřímná nejistota. Ať tak či tak, nic tě neváže ke konkrétnímu místu, a to je skutečná svoboda."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyblygrwydd llwyr — neu ansicrwydd go iawn. Y naill ffordd neu'r llall, dwyt ti ddim wedi dy glymu i un lle, ac mae hynny'n rhyddid go iawn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal fleksibilitet – eller ægte usikkerhed. Uanset hvad er du ikke bundet til et bestemt sted, og det er en reel frihed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal flexibel – oder ehrlich unsicher. So oder so bist du an keinen Ort gebunden, und das ist echte Freiheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόλυτη ευελιξία — ή πραγματική αβεβαιότητα. Όπως και να 'χει, δεν σε δένει κάποιος συγκεκριμένος τόπος, και αυτό είναι πραγματική ελευθερία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máxima flexibilidad — o una duda sincera. Sea como sea, no te ata ningún lugar concreto, y eso es una verdadera libertad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimaalne paindlikkus — või siiras ebakindlus. Igal juhul pole sa seotud kindla kohaga, ja see on päris vabadus."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malgutasun osoa, edo benetako zalantza. Dena den, ez zaude leku jakin bati lotuta, eta hori benetako askatasuna da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انعطاف کامل — یا بلاتکلیفی واقعی. در هر حال به جای خاصی بند نیستی، که خودش آزادی واقعی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysi joustavuus – tai aito epävarmuus. Kummin vain, et ole sidottu tiettyyn paikkaan, ja se on todellista vapautta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinaka-flexible — o tunay na hindi sigurado. Alinman doon, hindi ka nakatali sa isang lugar, at totoong kalayaan ’yon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une flexibilité totale — ou une vraie incertitude. Dans les deux cas, rien ne t'attache à un lieu précis, et c'est une vraie liberté."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solúbthacht iomlán — nó fíoréiginnteacht. Cibé acu é, níl tú ceangailte d’áit ar leith, agus is fíorshaoirse é sin."
