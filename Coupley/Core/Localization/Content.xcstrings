        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isiko nomzamo. Ukholelwa ukuba intlantsi igcinwa ngotyalo-mali oluqhubekayo, ingashiywa nje kwithamsanqa."
