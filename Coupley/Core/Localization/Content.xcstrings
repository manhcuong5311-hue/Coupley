        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลามีอะไรติดใจ คุณเริ่มพูดถึงมันอย่างไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni rahatsız eden bir şeyi nasıl dile getirirsin?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як ти говориш про те, що тебе турбує?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có điều gì khiến bạn phiền lòng, bạn nói ra thế nào?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有事让你不舒服时，你会怎么说出来？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有事讓你不舒服時，你會怎麼開口？"
          }
        }
      }
    },
