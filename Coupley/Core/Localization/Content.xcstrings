        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尊重對方想退一步的需要，也讓對方知道隨時可以回來找你。"
          }
        }
      }
    },
    "Respectful and polite, but we keep things mostly separate" : {
