        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზრდა მოქმედებაში. ამოიცანი, რისი გადაცემაც არ გინდა — და ამაზე მუშაობ. ეს დიდი რამაა."
