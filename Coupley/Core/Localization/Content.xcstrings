    "Cleanliness expectations are quietly one of the biggest lived-in relationship flashpoints." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقعات النظافة من أكبر نقاط الاحتكاك الصامتة في الحياة اليومية المشتركة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Představy o pořádku jsou nenápadně jedním z největších ohnisek sporů ve společné domácnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventninger til rengøring er i al stilhed et af de største stridspunkter, når man bor sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwartungen an Ordnung sind im Alltag still und leise einer der größten Zündstoffe in Beziehungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προσδοκίες για την καθαριότητα είναι, αθόρυβα, από τις μεγαλύτερες εστίες τριβής στη συμβίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las expectativas de limpieza son, aunque no lo parezca, uno de los mayores focos de conflicto en la convivencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siisteyteen liittyvät odotukset ovat huomaamatta yksi arjen suurimmista kiistanaiheista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahimik na isa sa pinakamalaking pinagmumulan ng tampuhan sa pagsasama sa iisang bahay ang inaasahan sa kalinisan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attentes en matière de ménage sont, mine de rien, l'une des plus grandes sources de tension au quotidien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציפיות לגבי ניקיון הן, בלי שמדברים על זה הרבה, אחד ממוקדי החיכוך הגדולים בחיים המשותפים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साफ़-सफ़ाई की उम्मीदें, साथ रहने में चुपचाप सबसे बड़े टकराव की वजहों में से एक हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tisztasággal kapcsolatos elvárások a közös élet egyik legnagyobb, csendes feszültségforrását jelentik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspektasi soal kebersihan diam-diam jadi salah satu pemicu konflik terbesar saat tinggal bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aspettative sulla pulizia sono, senza che ce ne accorgiamo, uno dei maggiori punti di scontro nella vita sotto lo stesso tetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片づけへの期待値の違いは、一緒に暮らすカップルの大きな火種になりやすいポイントです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "청결 기준은 함께 살면서 조용히 가장 크게 부딪히는 문제 중 하나예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangkaan tentang kebersihan diam-diam menjadi antara punca pertelingkahan terbesar dalam hidup bersama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventninger til renhold er i det stille en av de største konfliktkildene i et felles hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwachtingen over netheid zijn stiekem een van de grootste dagelijkse twistpunten in een relatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwania co do porządku to po cichu jeden z największych punktów zapalnych we wspólnym życiu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expectativas de limpeza são, discretamente, um dos maiores pontos de atrito de quem divide a casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așteptările legate de curățenie sunt, pe tăcute, una dintre cele mai mari surse de scântei în viața de zi cu zi a unui cuplu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разные представления о чистоте — одна из главных и самых недооценённых причин бытовых ссор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förväntningar på städning är i det tysta en av de största vardagliga konfliktkällorna i en relation."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาตรฐานความสะอาดเป็นหนึ่งในชนวนใหญ่ของการใช้ชีวิตร่วมกันแบบที่ไม่ค่อยมีใครพูดถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temizlik beklentileri, birlikte yaşarken sessiz sedasız en büyük gerilim noktalarından biri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікування щодо чистоти — одна з найгарячіших, хоч і непомітних тем спільного побуту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kỳ vọng về sự sạch sẽ là một trong những ngòi nổ âm thầm nhưng lớn nhất khi sống chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对整洁的期待，是同居生活里悄悄引发矛盾的最大导火索之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對整潔的期待，是同住之後最容易悄悄引爆的導火線之一。"
          }
        }
      }
    },
    "Close, but with healthy boundaries" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
