        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушај како пријател, не како мајстор за поправки. Врати ѝ го со зборови она што го чувствува."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിഹരിക്കാൻ നോക്കുന്നയാളെപ്പോലെയല്ല, ഒരു സുഹൃത്തിനെപ്പോലെ കേൾക്കൂ. അവർക്ക് തോന്നുന്നത് തിരികെ പറയൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засагч биш, найз шиг сонсоорой. Мэдэрч буйг нь буцааж хэлээрэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपाय सुचवण्यासाठी नाही, सोबत म्हणून ऐका. त्यांना जे वाटते ते पुन्हा त्यांच्याच शब्दांत सांगा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengar seperti kawan, bukan tukang baiki. Ulang semula apa yang dia rasa."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isma' biex tifhem, mhux biex issewwi. Irrifletti lura s-sentimenti tal-partner tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပြင်ပေးသူလို မဟုတ်ဘဲ သူငယ်ချင်းလို နားထောင်ပါ။ ချစ်သူ ခံစားရတာကို ပြန်ပြောပြပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytt som en venn, ikke som en reparatør. Speil det partneren din føler."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या सुल्झाउने होइन, साथी बनेर सुन्नुहोस्। उहाँको भावना दोहोर्‍याएर भनिदिनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luister als een vriend, niet als een probleemoplosser. Benoem wat je partner voelt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mvetserani ngati mnzanu, osati wokonza. Bwerezani zomwe akumva."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akka hiriyaatti dhaggeeffadhu, akka sirreessaatti miti. Miira jaalallee keetii deebistee ibsi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସୁଧାରିବା ଲୋକ ଭଳି ନୁହେଁ, ବନ୍ଧୁ ଭଳି ଶୁଣନ୍ତୁ। ସେ ଯାହା ଅନୁଭବ କରୁଛନ୍ତି, ତାହା ପୁଣି କହି ଶୁଣାନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੱਲ ਲੱਭਣ ਵਾਲੇ ਵਾਂਗ ਨਹੀਂ, ਦੋਸਤ ਵਾਂਗ ਸੁਣੋ। ਜੋ ਉਹ ਮਹਿਸੂਸ ਕਰ ਰਹੇ ਹਨ, ਉਸ ਨੂੰ ਆਪਣੇ ਸ਼ਬਦਾਂ ਵਿੱਚ ਦੁਹਰਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słuchaj jak przyjaciel, nie jak ktoś od naprawiania. Nazwij na głos to, co czuje druga połówka."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د دوست په څېر غوږ ونیسئ، نه د ترمیمګر. هغه څه بېرته ورته ووایئ چې احساسوي یې."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escute como quem é amigo, não como quem conserta. Devolva o que seu amor sente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouve como quem é amigo, não como quem conserta. Devolve o que o teu par sente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascultă ca un prieten, nu ca un reparator. Spune-i cu vorbele tale ce simte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушай как друг — не пытайся всё исправить. Повторяй своими словами, что чувствует партнёр."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega amatwi nk'inshuti, si nk'ushaka gukosora. Subiramo ibyo yiyumvamo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හදන්නෙක් විදිහට නෙවෙයි, යාළුවෙක් විදිහට අහන්න. ඔවුන්ට දැනෙන දේ ආපසු කියන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počúvaj ako blízky človek, nie ako opravár. Zopakuj vlastnými slovami, čo cíti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslušaj prijateljsko, ne popravljaj. Z besedami odrazi, kar partner čuti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teerera seshamwari, kwete semugadziri. Dzokorora zvaari kunzwa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U dhegeyso sida saaxiib, ma aha sida qof wax hagaajiya. Dib ugu celi dareenka aad maqasho."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dëgjo si mik, jo si riparues. Pasqyroji ato që ndien."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушај да разумеш, а не да поправиш. Понови оно што твоја половина осећа."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dangukeun sapertos réréncangan, sanés tukang ngabenerkeun. Balikan deui naon anu karaos ku anjeunna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssna som en vän, inte som en problemlösare. Spegla det din partner känner."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikiliza kama rafiki, si kama fundi wa kurekebisha. Mrudishie kile anachohisi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சரிசெய்பவராக அல்ல, நண்பராகக் கேளுங்கள். அவர் உணர்வதைத் திருப்பிச் சொல்லுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సరిదిద్దేవారిలా కాదు, స్నేహితుల్లా వినండి. వారి భావాలను మళ్లీ వారికే చెప్పండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мисли дӯст гӯш кун, на мисли устои таъмир. Ҳиссиёташро баргардонда гӯй."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังแบบเพื่อน ไม่ใช่แบบช่างซ่อม สะท้อนความรู้สึกของคนรักกลับไป"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከም ኣዕራዪ ዘይኮነ ከም ዓርኪ ስምዑ። ዝስምዖም መሊስኩም ግለጹ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzediji däl, dost ýaly diňle. Onuň duýýan zadyny gaýtalap aýt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorun çözücü gibi değil, arkadaş gibi dinle. Hissettiklerini ona geri yansıt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слухай як друг, а не як майстер-ремонтник. Віддзеркалюй почуття половинки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل نکالنے والے کی طرح نہیں، دوست کی طرح سنیں۔ ان کے احساسات کو دہرا کر بتائیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuzatuvchi emas, doʻst kabi tinglang. Sherigingiz his qilayotgan narsani qaytarib ayting."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lắng nghe như một người bạn, không phải người sửa chữa. Nhắc lại điều người ấy đang cảm thấy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamela njengomhlobo, hayi njengomlungisi. Liphindele indlela eliziva ngayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ tẹ́tí bí ọ̀rẹ́, kì í ṣe bí ẹni tó fẹ́ tún nǹkan ṣe. Ẹ sọ ohun tí ó ń ní lára padà fún un."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像朋友般聆聽，不要急着解決問題。把對方的感受說回給對方聽。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像朋友一样倾听，而不是急着解决问题。把另一半的感受复述回去。"
