        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई जवाब ग़लत नहीं है — आपका तरीका समझकर आपके पार्टनर आपसे वहीं मिल सकते हैं जहाँ आप हैं।"
