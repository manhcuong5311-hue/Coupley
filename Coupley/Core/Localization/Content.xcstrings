        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatiżmu. Il-ħajja vera tiegħek tgħixha barra mix-xogħol. Ix-xogħol iservi l-viżjoni."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်တွေ့ကျသူပါ။ သင့်ရဲ့ တကယ့်ဘဝက အလုပ်ပြင်ပမှာ ရှိတယ်။ အလုပ်က သင့်ရည်မှန်းချက်ကို ဖြည့်ဆည်းပေးဖို့သာ ဖြစ်တယ်။"
