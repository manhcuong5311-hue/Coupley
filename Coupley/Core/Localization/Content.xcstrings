        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стварање. Вероватно у себи носиш идеје за које још тражиш начин да их изразиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyieun karya. Meureun aya ideu dina diri anjeun anu can kapendak carana pikeun diébréhkeun."
