        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سچا جواب۔ زیادہ تر لوگوں کا یہی حال ہے۔ اسے پرکھنے کی آمادگی ہی سب سے اہم ہے۔"
