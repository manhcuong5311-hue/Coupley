        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো উত্তরই ভুল নয় — তোমার ধরনটা বুঝলে তোমার পার্টনার তুমি যেখানে আছ, সেখানেই তোমার কাছে পৌঁছাতে পারবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema pogrešnog odgovora – kad razumije tvoj stil, voljena osoba ti lakše izađe u susret."
