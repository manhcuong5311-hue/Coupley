          "stringUnit" : {
            "state" : "translated",
            "value" : "একেই উদ্দেশ্যই ঘনিষ্ঠতা গঢ়ে। ৰন্ধা, সজা, সৃষ্টি কৰা — দুয়োৰে বাবে গুৰুত্বপূৰ্ণ কিবা কৰা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortaq məqsəd yaxınlaşdırır. Yemək bişirmək, nəsə qurmaq, yaratmaq — ikiniz üçün də önəmli bir iş görmək."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агульная мэта збліжае. Гатаваць, будаваць, ствараць — рабіць нешта, што важна вам абодвум."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общата цел сближава. Готвене, майсторене, създаване – нещо, което има значение за вас."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথের উদ্দেশ্য কাছে আনে। রান্না, কিছু বানানো, কিছু সৃষ্টি করা — এমন কিছু করা, যা তোমাদের দুজনের কাছেই জরুরি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajednička svrha gradi bliskost. Kuhanje, gradnja, stvaranje – nešto što je važno vama oboma."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un propòsit compartit uneix. Cuinar, construir, crear — fer alguna cosa que us importi a tots dos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Společný cíl sbližuje. Vařit, stavět, tvořit – dělat něco, na čem vám oběma záleží."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae pwrpas ar y cyd yn creu agosrwydd. Coginio, adeiladu, creu — gwneud rhywbeth sy'n bwysig i'r ddau ohonoch chi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et fælles formål skaber nærhed. At lave mad, bygge, skabe – noget, der betyder noget for jer begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gemeinsamer Sinn schafft Nähe. Kochen, bauen, gestalten – etwas tun, das euch beiden wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κοινός σκοπός φέρνει εγγύτητα. Μαγείρεμα, φτιάξιμο, δημιουργία — κάτι που μετράει και για τους δυο σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un propósito compartido crea cercanía. Cocinar, construir, crear: hacer algo que les importe a los dos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühine eesmärk loob lähedust. Söögitegemine, ehitamine, loomine — midagi, mis on teile mõlemale oluline."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helburu partekatuak hurbiltzen zaituzte. Sukaldatzea, eraikitzea, sortzea — biontzat garrantzitsua den zerbait egitea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدف مشترک نزدیکی می‌سازد. آشپزی، ساختن، خلق کردن — انجام کاری که برای هر دوتان مهم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteinen tarkoitus rakentaa läheisyyttä. Kokkaaminen, rakentaminen, luominen – jotain, millä on merkitystä teille molemmille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinalalapit kayo ng iisang layunin. Pagluluto, pagbubuo, paglikha — paggawa ng bagay na mahalaga sa inyong dalawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un but commun rapproche. Cuisiner, construire, créer : faire quelque chose qui compte pour vous deux."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cothaíonn cuspóir comhroinnte gaire. Cócaráil, tógáil, cruthú — rud a dhéanamh atá tábhachtach don bheirt agaibh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un propósito compartido crea proximidade. Cociñar, construír, crear: facer algo que vos importe aos dous."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સહિયારો હેતુ નિકટતા બાંધે છે. રાંધવું, બનાવવું, સર્જવું — એવું કંઈક કરવું જે તમારા બંને માટે મહત્ત્વનું હોય."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manufa ta tare na gina kusanci. Girki, gini, ƙirƙira — yin wani abu da ke da muhimmanci ga ku biyu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מטרה משותפת בונה קרבה. לבשל, לבנות, ליצור — לעשות משהו ששניכם רואים בו ערך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा मक़सद से नज़दीकी बनती है। खाना बनाना, कुछ बनाना, कुछ रचना — ऐसा कुछ करना जो आप दोनों के लिए मायने रखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajednička svrha gradi bliskost. Kuhanje, gradnja, stvaranje – nešto važno za vas dvoje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon bi an komen kreye pwoksimite. Kwit manje, bati, kreye — fè yon bagay ki enpòtan pou nou tou de."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közös cél közelséget teremt. Főzni, építeni, alkotni – valami olyat csinálni, ami mindkettőtöknek számít."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընդհանուր նպատակը մտերմացնում է։ Ճաշ պատրաստել, կառուցել, ստեղծել — անել մի բան, որ կարևոր է երկուսիդ համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuan bersama membangun kedekatan. Memasak, membangun, berkarya — melakukan sesuatu yang penting bagi kalian berdua."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebumnuche unu na-ekerịta na-ewulite ịdị nso. Isi nri, iwu ihe, ike ihe — ime ihe dị unu abụọ mkpa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sameiginlegur tilgangur skapar nánd. Elda, smíða, skapa – gera eitthvað sem skiptir ykkur bæði máli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno scopo comune crea vicinanza. Cucinare, costruire, creare — fare qualcosa che conta per voi due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ目的が近さを育てるタイプです。料理、ものづくり、創作など、ふたりにとって大切なことを一緒にするのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancas bareng nggawe cedhak. Masak, mbangun, nggawe — nglakoni bab sing wigati kanggo panjenengan sakloron."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საერთო მიზანი სიახლოვეს ქმნის. საჭმლის მომზადება, მშენებლობა, შექმნა — რამის კეთება, რაც ორივესთვის მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ортақ мақсат жақындастырады. Ас әзірлеу, құрастыру, жасау — екеуіңе де маңызды бірдеңе істеу."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គោលបំណងរួមកសាងភាពជិតស្និទ្ធ។ ធ្វើម្ហូប សាងសង់ បង្កើតអ្វីថ្មី — ធ្វើអ្វីដែលសំខាន់សម្រាប់អ្នកទាំងពីរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದೇ ಉದ್ದೇಶ ಹತ್ತಿರತನವನ್ನು ಬೆಳೆಸುತ್ತದೆ. ಅಡುಗೆ, ಏನನ್ನಾದರೂ ಕಟ್ಟುವುದು, ಸೃಷ್ಟಿಸುವುದು — ನಿಮ್ಮಿಬ್ಬರಿಗೂ ಮುಖ್ಯವಾದುದನ್ನು ಮಾಡುವುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 목적이 가까움을 만들어요. 요리하고, 만들고, 창작하며 두 사람 모두에게 의미 있는 일을 함께하는 것."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armanca hevpar nêzîkiyê ava dike. Xwarin çêkirin, avakirin, afirandin — kirina tiştekî ku ji we herduyan re girîng e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалпы максат жакындатат. Тамак жасоо, куруу, жаратуу — экөөң үчүн тең маанилүү бир нерсе кылуу."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E gemeinsamt Zil bréngt iech méi no. Kachen, bauen, eppes erschafen — eppes maachen, wat iech zwee wichteg ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເປົ້າໝາຍຮ່ວມກັນສ້າງຄວາມໃກ້ຊິດ ເຮັດອາຫານ, ສ້າງ, ສ້າງສັນ — ເຮັດສິ່ງທີ່ສຳຄັນກັບທັງສອງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendras tikslas kuria artumą. Gaminti, statyti, kurti – daryti tai, kas svarbu jums abiem."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopīgs mērķis veido tuvību. Gatavot, būvēt, radīt – darīt kaut ko, kas svarīgs jums abiem."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny tanjona iraisana no mampifanakaiky. Mahandro, manamboatra, mamorona — manao zavatra manan-danja aminareo roa."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mā te kaupapa tahi e tata ai. He tunu kai, he hanga, he waihanga — he mahi i tētahi mea e nui ana ki a kōrua tahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заедничката цел гради блискост. Готвење, градење, создавање — нешто што ви е важно на вас."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പങ്കിട്ട ലക്ഷ്യം അടുപ്പം വളർത്തുന്നു. പാചകം, എന്തെങ്കിലും നിർമിക്കൽ, സൃഷ്ടിക്കൽ — നിങ്ങൾ ഇരുവർക്കും പ്രധാനപ്പെട്ട എന്തെങ്കിലും ചെയ്യുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хамтын зорилго ойртуулдаг. Хоол хийх, ямар нэг юм барих, бүтээх — хоёуланд тань чухал зүйлийг хийх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकत्र ध्येयातून जवळीक वाढते. स्वयंपाक, काहीतरी बनवणे, निर्मिती — तुम्हा दोघांना महत्त्वाचे असे काहीतरी करणे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuan bersama membina keakraban. Memasak, membina, mencipta — melakukan sesuatu yang penting bagi anda berdua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għan komuni jibni l-qrubija. Issajru, tibnu, toħolqu — tagħmlu xi ħaġa li tgħodd għalikom it-tnejn."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘုံရည်ရွယ်ချက်က နီးစပ်မှုကို တည်ဆောက်တယ်။ ချက်ပြုတ်၊ တည်ဆောက်၊ ဖန်တီး — နှစ်ယောက်စလုံးအတွက် အရေးပါတဲ့ တစ်ခုခုကို လုပ်တာ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et felles mål skaper nærhet. Lage mat, bygge, skape – gjøre noe som betyr noe for dere begge."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा उद्देश्यले निकटता बनाउँछ। पकाउनु, बनाउनु, सिर्जना गर्नु — तपाईं दुवैका लागि महत्त्वपूर्ण केही गर्नु।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gedeeld doel brengt je dichter bij elkaar. Koken, bouwen, maken – iets doen wat jullie allebei belangrijk vinden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cholinga chimodzi chimamanga kuyandikana. Kuphika, kumanga, kupanga — kuchita chinthu chofunika kwa nonse awiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaayyoon waliinii walitti dhiyeenya ijaara. Bilcheessuu, ijaaruu, uumuu — waan lamaan keessaniif hiika qabu gochuu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମିଳିତ ଉଦ୍ଦେଶ୍ୟ ଘନିଷ୍ଠତା ଗଢ଼େ। ରାନ୍ଧିବା, ତିଆରି କରିବା, ସୃଷ୍ଟି କରିବା — ଦୁହିଁଙ୍କ ପାଇଁ ଜରୁରି କିଛି କରିବା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਾਂਝਾ ਮਕਸਦ ਨੇੜਤਾ ਬਣਾਉਂਦਾ ਹੈ। ਖਾਣਾ ਬਣਾਉਣਾ, ਕੁਝ ਉਸਾਰਨਾ, ਕੁਝ ਰਚਣਾ — ਕੁਝ ਅਜਿਹਾ ਕਰਨਾ ਜੋ ਤੁਹਾਡੇ ਦੋਵਾਂ ਲਈ ਅਹਿਮ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólny cel buduje bliskość. Gotowanie, budowanie, tworzenie – robienie razem czegoś, co ma dla was znaczenie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ګډ هدف نږدېوالی جوړوي. پخلی، جوړول، پنځونه — داسې کار کول چې تاسو دواړو ته مهم وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um propósito em comum aproxima. Cozinhar, construir, criar — fazer algo que importa para os dois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um propósito comum cria proximidade. Cozinhar, construir, criar — fazer algo que importa aos dois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un scop comun creează apropiere. Să gătiți, să construiți, să creați — să faceți ceva important pentru amândoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общая цель сближает. Готовить, строить, творить — делать то, что важно вам обоим."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intego musangiye yubaka ukwegerana. Guteka, kubaka, guhanga — gukora ikintu gifite agaciro kuri mwembi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පොදු අරමුණක් සමීපත්වය ගොඩනඟනවා. උයන එක, හදන එක, නිර්මාණය කරන එක — ඔබ දෙදෙනාටම වැදගත් දෙයක් කරන එක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoločný cieľ buduje blízkosť. Varenie, stavanie, tvorenie – robiť niečo, na čom záleží vám obom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupni namen gradi bližino. Kuhanje, gradnja, ustvarjanje – nekaj, kar je pomembno vama obema."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chinangwa chamunogovana chinovaka kuswedera. Kubika, kuvaka, kugadzira — kuita chimwe chinhu chinokosha kwamuri mose."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujeeddo la wadaago ayaa dhista dhawaansho. Karin, dhisid, abuurid — samaynta wax labadiinaba idiin muhiim ah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një qëllim i përbashkët ndërton afërsi. Të gatuani, të ndërtoni, të krijoni – të bëni diçka që ka rëndësi për të dy."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заједничка сврха гради блискост. Кување, прављење, стварање — радити нешто што је важно обома."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuan babarengan ngawangun kadeukeutan. Masak, ngawangun, nyiptakeun — ngalakukeun hal anu penting pikeun aranjeun duaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett gemensamt syfte skapar närhet. Laga mat, bygga, skapa – göra något som betyder något för er båda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusudi la pamoja hujenga ukaribu. Kupika, kujenga, kuunda — kufanya kitu chenye maana kwenu nyote wawili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பகிர்ந்த நோக்கம் நெருக்கத்தை வளர்க்கிறது. சமைப்பது, உருவாக்குவது, படைப்பது — உங்கள் இருவருக்கும் முக்கியமான ஒன்றைச் செய்வது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉమ్మడి లక్ష్యం సాన్నిహిత్యాన్ని పెంచుతుంది. వంట చేయడం, ఏదైనా నిర్మించడం, సృష్టించడం — మీ ఇద్దరికీ ముఖ్యమైనదేదో చేయడం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳадафи муштарак наздикӣ месозад. Пухтан, сохтан, эҷод кардан — кори барои ҳар дуятон муҳим."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายร่วมกันสร้างความใกล้ชิด ไม่ว่าจะทำอาหาร ลงมือสร้าง หรือสร้างสรรค์อะไรสักอย่าง ขอแค่ได้ทำสิ่งที่สำคัญกับคุณทั้งสอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ናይ ሓባር ዕላማ ቅርበት ይሃንጽ። ምኽሻን፣ ምህናጽ፣ ምፍጣር — ንኽልቴኹም ኣገዳሲ ዝኾነ ነገር ምግባር።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umumy maksat ýakynlyk döredýär. Nahar bişirmek, gurmak, döretmek — ikiňiz üçin hem möhüm bir zat etmek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak bir amaç yakınlık kurar. Yemek yapmak, bir şey inşa etmek, üretmek; ikiniz için de önemli olan bir şey yapmak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільна мета зближує. Готувати, будувати, творити — робити щось важливе для вас обох."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشترکہ مقصد قربت بڑھاتا ہے۔ پکانا، بنانا، تخلیق کرنا — کوئی ایسا کام جو آپ دونوں کے لیے اہم ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umumiy maqsad yaqinlashtiradi. Ovqat pishirish, nimadir qurish, yaratish — ikkalangiz uchun muhim ishni birga qilish."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục đích chung xây nên sự gần gũi. Nấu ăn, xây dựng, sáng tạo — cùng làm điều quan trọng với cả hai."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injongo enabelana ngayo yakha ukusondelelana. Ukupheka, ukwakha, ukuyila — ukwenza into ebalulekileyo kuni nobabini."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Èrò àjọṣe ń kọ́ ìsúnmọ́ra. Sísè, kíkọ́, ṣíṣẹ̀dá — ṣíṣe nǹkan tó ṣe pàtàkì sí ẹ̀yin méjèèjì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的目標帶來親近。煮飯、動手做、一起創作，做一件對你們兩個都重要的事。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的目标让人亲近。做饭、动手做东西、一起创作——做一件对你们俩都重要的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的目標讓人更親近。一起煮飯、動手做、創作，做一件對你們兩人都重要的事。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhloso eyabelwanayo yakha ukusondelana. Ukupheka, ukwakha, ukudala — ukwenza okuthile okubalulekile kini nobabili."
          }
        }
      }
