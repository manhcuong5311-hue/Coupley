        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשלוח דבר אחד ספציפי שאוהבים בצד השני — לא סתם \"אין כמוך\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी कोई एक ख़ास बात बताएँ जो आपको पसंद है — सिर्फ़ “आप लाजवाब हैं” नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošalji jednu konkretnu stvar koju voliš kod voljene osobe – ne samo „super si”."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voye l yon bagay presi ou renmen nan li — pa “ou bon nèt”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írj meg egy konkrét dolgot, amit szeretsz benne – ne csak azt, hogy „szuper vagy”."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գրիր մի կոնկրետ բան, որ սիրում ես նրա մեջ, ոչ թե պարզապես «դու հիանալի ես»։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim satu hal spesifik yang kamu sukai darinya — bukan “kamu hebat.”"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zipu otu ihe a kapịrị ọnụ ị hụrụ n'anya banyere ya — ọ bụghị ‘ị dị mma.’"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendu eitt ákveðið atriði sem þú elskar við makann þinn – ekki bara „þú ert frábær“."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una cosa precisa che ami del tuo partner — non un generico «sei speciale»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すごいね」ではなく、パートナーの好きなところを具体的にひとつ伝えましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim siji bab tartamtu sing panjenengan tresnani saka pasangan — dudu mung “panjenengan apik banget”."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მისწერე ერთი კონკრეტული რამ, რაც მასში გიყვარს — და არა „შესანიშნავი ხარ“."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Онда ұнайтын бір нақты нәрсені жаз, «сен кереметсің» емес."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ញើរឿងជាក់លាក់មួយដែលអ្នកស្រឡាញ់ចំពោះគាត់ — មិនមែន “អ្នកពូកែណាស់” ទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅವರಲ್ಲಿ ನಿಮಗಿಷ್ಟವಾದ ಒಂದು ನಿರ್ದಿಷ್ಟ ವಿಷಯವನ್ನು ಕಳುಹಿಸಿ — “ನೀನು ಸೂಪರ್” ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“최고예요” 말고, 연인의 좋은 점 하나를 구체적으로 보내 보세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiştekî taybet ku tu di hevjînê xwe de jê hez dikî bişîne — ne “tu pir baş î”."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анын сен жакшы көргөн бир конкреттүү сапатын жаз — «сен сонунсуң» эмес."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schéck eng konkret Saach, déi s de un dengem Schatz gär hues — net „Du bass super.“"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບອກສິ່ງທີ່ເຈາະຈົງໜຶ່ງຢ່າງທີ່ເຈົ້າຮັກໃນຕົວລາວ — ບໍ່ແມ່ນ “ເຈົ້າເກັ່ງ”"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parašyk vieną konkretų dalyką, kurį myli antrojoje pusėje, – ne bendrą komplimentą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzraksti vienu konkrētu lietu, ko tu otrā mīli – ne vienkārši ‚tu esi zelts’."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alefaso zavatra iray voafaritra tianao aminy — fa tsy hoe “mahafinaritra ianao.”"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukua tētahi mea motuhake e aroha ana koe ki a ia — kaua ko “he rawe koe.”"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажи ѝ едно конкретно нешто што го сакаш кај неа — не „Супер си“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവരിൽ നിങ്ങൾക്കിഷ്ടമുള്ള ഒരു പ്രത്യേക കാര്യം അയയ്ക്കൂ — “നിങ്ങൾ അടിപൊളിയാണ്” എന്നല്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ханийнхаа дуртай нэг тодорхой зүйлээ бичээрэй — «чи гоё» гэж биш."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्यांच्याबद्दल तुम्हाला आवडणारी एक नेमकी गोष्ट पाठवा — फक्त “तुम्ही छान आहात” नको."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hantar satu perkara khusus yang anda sayangi tentang dirinya — bukan sekadar “anda hebat.”"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibgħat ħaġa speċifika waħda li tħobb fil-partner tiegħek — mhux “int tal-għaġeb.”"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချစ်သူ့ရဲ့ ချစ်စရာ အတိအကျ တစ်ခုကို ပို့ပေးပါ — “တော်လိုက်တာ” လိုမျိုး မဟုတ်ဘဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send én konkret ting du elsker ved partneren din – ikke «du er flott»."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उहाँको एउटा खास कुरा पठाउनुहोस्, जुन तपाईंलाई मन पर्छ — ‘तपाईं राम्रो हुनुहुन्छ’ मात्र होइन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur één concreet ding dat je zo leuk vindt aan je partner – niet “je bent geweldig”."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atumizireni chinthu chimodzi chenicheni chomwe mumakonda mwa iwo — osati “ndiwe wabwino.”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan jaalallee kee irratti jaallattu murtaa'aa tokko ergi — “ati gaarii dha” miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତାଙ୍କର ଗୋଟିଏ ନିର୍ଦ୍ଦିଷ୍ଟ କଥା ପଠାନ୍ତୁ ଯାହା ଆପଣ ଭଲପାଆନ୍ତି — କେବଳ “ତୁମେ ବହୁତ ଭଲ” ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਨ੍ਹਾਂ ਬਾਰੇ ਕੋਈ ਇੱਕ ਖ਼ਾਸ ਗੱਲ ਭੇਜੋ ਜੋ ਤੁਹਾਨੂੰ ਪਿਆਰੀ ਲੱਗਦੀ ਹੈ — ਸਿਰਫ਼ “ਤੁਸੀਂ ਬਹੁਤ ਵਧੀਆ ਹੋ” ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz jedną konkretną rzecz, którą kochasz w drugiej połówce – nie „jesteś super”."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یو ځانګړی شی ورته ولیکئ چې په ملګري کې مو خوښېږي — نه یوازې «ته عالي یې.»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mande uma coisa específica que você ama no seu amor — não um “você é demais”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia uma coisa concreta que adoras no teu par — não um «és o máximo»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrie-i un lucru anume pe care îl iubești la partenerul tău — nu „ești super”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напиши одну конкретную вещь, которую любишь в партнёре, — не просто «ты лучше всех»."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwoherereze ikintu kimwe cyihariye umukundiraho — si “uri igitangaza”."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ඔවුන් ගැන ආදරය කරන එක නිශ්චිත දෙයක් යවන්න — “ඔයා නියමයි” නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošli jednu konkrétnu vec, ktorú na svojej polovičke ľúbiš – nie len „si poklad“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošlji eno konkretno stvar, ki jo ljubiš pri partnerju – ne le „super si“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumira chinhu chimwe chaicho chaunoda maari — kwete ‘wakanaka’."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U dir hal shay oo gaar ah oo aad ka jeceshahay — ma aha “waad fiican tahay”."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dërgo një gjë konkrete që e do te partneri – jo thjesht „je super“."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошаљи једну конкретну ствар коју волиш код своје половине — не „супер си“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim hiji hal husus anu ku anjeun dipikaresep ti anjeunna, sanés ngan “anjeun hébat.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka en konkret sak du älskar hos din partner – inte bara ”du är bäst”."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mtumie jambo moja mahususi unalompendea — si “wewe ni mzuri.”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவரிடம் நீங்கள் நேசிக்கும் ஒரு குறிப்பிட்ட விஷயத்தை அனுப்புங்கள் — “நீங்கள் அருமை” என்பது அல்ல."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వారిలో మీకు నచ్చే ఒక ప్రత్యేకమైన విషయం పంపండి — “నువ్వు గొప్ప” లాంటిది కాదు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як чизи мушаххасеро, ки дар ёрат дӯст медорӣ, бифирист — на «ту олӣ ҳастӣ»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งสิ่งที่คุณรักในตัวคนรักแบบเจาะจงไปสักข้อ ไม่ใช่แค่ “คุณเก่งมาก”"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዛዕባ መጻምድኹም እትፈትውዎ ሓደ ፍሉይ ነገር ስደዱ — «ጽቡቓት ኢኹም» ዘይኮነ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onda gowy görýän bir anyk zadyňy ýaz — “sen ajaýyp” däl."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onda sevdiğin belirli bir şeyi yaz; “harikasın” değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напиши одну конкретну річ, яку ти любиш у половинці, — не просто «ти класна людина»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کی کوئی ایک خاص بات بھیجیں جو آپ کو پسند ہے، صرف “آپ کمال ہیں” نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sherigingizda yaxshi koʻradigan bitta aniq narsani yozing — «sen zoʻrsan» emas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi một điều cụ thể bạn yêu ở người ấy — không phải “bạn tuyệt lắm”."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thumela into enye ethile oyithandayo ngeqabane lakho — hayi nje “ubalasele”."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ fi ohun pàtó kan tí ẹ fẹ́ràn nípa rẹ̀ ránṣẹ́ — kì í ṣe “o dára gan-an.”"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出一件你愛對方的具體事情——而不是「你很好」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出一件你爱另一半的具体之处，而不是一句“你真好”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳一件你喜歡對方的具體小事，而不是「你很棒」。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mthumelele into eyodwa ethile oyithandayo ngaye — hhayi nje ukuthi “umuhle”."
          }
        }
      }
    },
