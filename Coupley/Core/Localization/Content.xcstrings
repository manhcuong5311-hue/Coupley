          "stringUnit" : {
            "state" : "translated",
            "value" : "أحلام مؤجلة. هناك شيء لطالما حلمت ببنائه أو صنعه، ونفَسك في ذلك طويل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পিছুৱাই থোৱা সপোন। আপুনি সদায় কিবা এটা গঢ়িব বা সৃষ্টি কৰিব বিচাৰিছিল — আৰু আপুনি দীঘলীয়া খেল খেলি আছে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təxirə salınmış arzular. Həmişə qurmaq və ya yaratmaq istədiyin bir şey var — və sən uzun oyun oynayırsan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкладзеныя мары. Ёсць нешта, што табе заўсёды хацелася стварыць, — і ты гуляеш у доўгую."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложени мечти. Има нещо, което винаги ти се е искало да изградиш или създадеш – и играеш в дългосрочен план."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুলে রাখা স্বপ্ন। এমন কিছু আছে যা তুমি সবসময় গড়তে বা তৈরি করতে চেয়েছ — আর তুমি লম্বা খেলা খেলছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgođeni snovi. Postoji nešto što oduvijek želiš izgraditi ili stvoriti – i igraš dugu igru."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somnis ajornats. Hi ha alguna cosa que sempre has volgut construir o crear — i hi jugues a llarg termini."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložené sny. Je něco, co odjakživa chceš vybudovat nebo vytvořit – a hraješ dlouhou hru."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breuddwydion wedi'u gohirio. Mae rhywbeth rwyt ti wastad wedi bod eisiau ei adeiladu neu ei greu — ac rwyt ti'n chwarae'r gêm hir."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udskudte drømme. Der er noget, du altid har villet bygge eller skabe – og du spiller det lange spil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgeschobene Träume. Es gibt etwas, das du schon immer aufbauen oder erschaffen wolltest – und du denkst langfristig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όνειρα σε αναμονή. Υπάρχει κάτι που πάντα ήθελες να χτίσεις ή να δημιουργήσεις — και το παίζεις μακροπρόθεσμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueños aplazados. Hay algo que siempre has querido construir o crear — y juegas a largo plazo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edasilükatud unistused. On midagi, mida oled alati tahtnud ehitada või luua — ja sa mängid pikka mängu."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atzeratutako ametsak. Beti eraiki edo sortu nahi izan duzun zerbait badago, eta epe luzerako jokatzen ari zara."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رویاهای عقب‌افتاده. چیزی هست که همیشه می‌خواستی بسازی یا خلق کنی — و داری بازی بلندمدتی می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lykättyjä unelmia. On jotain, mitä olet aina halunnut rakentaa tai luoda – ja pelaat pitkää peliä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangarap na ipinagpaliban. May bagay kang matagal nang gustong buuin o likhain — at pangmatagalan ang laro mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rêves mis en attente. Il y a quelque chose que tu as toujours voulu construire ou créer — et tu joues sur le long terme."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aislingí curtha ar athló. Tá rud éigin a theastaigh uait riamh a thógáil nó a chruthú — agus tá tú ag imirt cluiche fada."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soños aprazados. Hai algo que sempre quixeches construír ou crear, e xogas a longo prazo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મુલતવી રાખેલાં સપનાં. તમારે હંમેશાં કંઈક બનાવવું કે સર્જવું હતું — અને તમે લાંબી રમત રમી રહ્યા છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mafarkai da aka jinkirta. Akwai wani abu da kullum kuke son ginawa ko ƙirƙira — kuma kuna wasa mai dogon zango."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלומות שחיכו בסבלנות. יש משהו שתמיד רצית לבנות או ליצור — והמשחק שלך ארוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टले हुए सपने। कुछ ऐसा है जिसे बनाने या रचने की चाह हमेशा से रही है — और इसके लिए आपकी नज़र दूर तक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgođeni snovi. Postoji nešto što oduvijek želiš izgraditi ili stvoriti – i igraš na duge staze."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rèv ki ap tann. Gen yon bagay ou toujou vle bati oswa kreye — e w ap jwe yon jwèt alontèm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elhalasztott álmok. Van valami, amit mindig is meg akartál építeni vagy alkotni – és hosszú távra játszol."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հետաձգված երազանքներ։ Կա մի բան, որ միշտ ուզել ես կառուցել կամ ստեղծել, և դու երկար խաղ ես խաղում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impian yang ditunda. Ada sesuatu yang selalu ingin kamu bangun atau ciptakan — dan kamu menyiapkannya untuk jangka panjang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nrọ e yigharịrị. E nwere ihe ị chọburu mgbe niile iwu ma ọ bụ ịkpụ — ị na-egwu egwuregwu ogologo oge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draumar á bið. Það er eitthvað sem þig hefur alltaf langað að byggja eða skapa – og þú hugsar til langs tíma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sogni rimandati. C’è qualcosa che hai sempre voluto costruire o creare — e stai giocando sul lungo periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先送りにしてきた夢があります。ずっと作りたかったものがあって、長い目で準備しているのでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impen sing ditunda. Ana bab sing wiwit biyen pengin panjenengan bangun utawa gawe — lan panjenengan sabar ngenteni wektune."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადადებული ოცნებები. არის რაღაც, რისი შექმნაც ყოველთვის გინდოდა — და შორს იყურები."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кейінге қалдырылған армандар. Әрқашан құрғың не жасағың келген бір нәрсе бар, және сен ұзақ ойын ойнап жүрсің."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ក្ដីស្រមៃដែលបានពន្យារពេល។ មានអ្វីមួយដែលអ្នកតែងចង់កសាង ឬបង្កើត — ហើយអ្នកកំពុងគិតវែងឆ្ងាយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಂದೂಡಿದ ಕನಸುಗಳು. ನೀವು ಯಾವಾಗಲೂ ಕಟ್ಟಬೇಕೆಂದಿದ್ದ ಅಥವಾ ರಚಿಸಬೇಕೆಂದಿದ್ದ ಏನೋ ಒಂದಿದೆ — ಮತ್ತು ನೀವು ದೀರ್ಘಾವಧಿಯ ಆಟ ಆಡುತ್ತಿದ್ದೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미뤄 둔 꿈이 있어요. 늘 만들고 싶었던 무언가가 있고, 긴 호흡으로 준비하고 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xeyalên paşxistî. Tiştek heye ku te her gav xwestiye ava bikî an biafirînî — û tu bi sebir li bendê yî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кийинкиге калтырылган кыялдар. Дайыма куруп же жаратып көргүң келген бир нерсе бар — жана сен узак мөөнөткө ойноп жатасың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeschobe Dreem. Et gëtt eppes, wat s de ëmmer wollts bauen oder erschafen — an du denks op laang Siicht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມຝັນທີ່ລໍຖ້າ ມີບາງຢ່າງທີ່ເຈົ້າຢາກສ້າງມາຕະຫຼອດ — ແລະ ເຈົ້າກຳລັງວາງແຜນໄລຍະຍາວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidėtos svajonės. Yra kažkas, ką visada norėjai sukurti, – ir tu žaidi ilgą žaidimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlikti sapņi. Ir kaut kas, ko tu vienmēr gribēji uzbūvēt vai radīt – un tu spēlē ilgtermiņā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nofy nahemotra. Misy zavatra efa ela no tianao naorina na noforonina — ary lalao maharitra no ataonao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He moemoeā kua tārewa. He mea kua roa koe e hiahia ana ki te hanga, ki te waihanga — ā, kei te tākaro koe i tētahi kēmu roa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одложени соништа. Има нешто што отсекогаш сакаш да изградиш или создадеш — и играш долга игра."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മാറ്റിവച്ച സ്വപ്നങ്ങൾ. എന്നും നിർമിക്കാനോ സൃഷ്ടിക്കാനോ ആഗ്രഹിച്ച എന്തോ ഒന്നുണ്ട് — ദീർഘദൂര ഓട്ടമാണ് നിങ്ങൾ ഓടുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хойшлуулсан мөрөөдөл. Үргэлж бүтээхийг хүсдэг байсан нэг зүйл бий — чи урт хугацааны тоглоом тоглож байна."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुढे ढकललेली स्वप्ने. तुम्हाला नेहमीच काहीतरी उभारायचे किंवा निर्माण करायचे होते — आणि त्यासाठी तुम्ही लांबचा पल्ला धरला आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impian yang ditangguhkan. Ada sesuatu yang selalu anda mahu bina atau cipta — dan anda sabar merancangnya untuk jangka panjang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ħolm imwarrab għal wara. Hemm xi ħaġa li dejjem xtaqt tibni jew toħloq — u qed tilgħab logħba twila."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆိုင်းငံ့ထားခဲ့တဲ့ အိပ်မက်တွေ။ အမြဲ တည်ဆောက်ချင်၊ ဖန်တီးချင်ခဲ့တဲ့ အရာတစ်ခု ရှိတယ် — ရေရှည်ကို ကြည့်ပြီး စောင့်နေတာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utsatte drømmer. Det er noe du alltid har villet bygge eller skape – og du tenker langsiktig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर सारिएका सपना। तपाईंले सधैँ केही बनाउन वा सिर्जना गर्न चाहनुभएको छ — र तपाईं लामो खेल खेल्दै हुनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgestelde dromen. Er is iets wat je altijd al wilde bouwen of maken – en daar heb je een lange adem voor."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maloto osungidwa. Pali chinthu chimene mwakhala mukufuna kupanga — ndipo mukudikira moleza mtima."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abjuu booda tursiifame. Waan yeroo hunda ijaaruu ykn uumuu barbaaddu tokko jira — tapha dheeraa taphachaa jirta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅପେକ୍ଷାରେ ଥିବା ସ୍ୱପ୍ନ। ଏମିତି କିଛି ଅଛି ଯାହା ଆପଣ ସବୁଦିନ ଗଢ଼ିବାକୁ ବା ସୃଷ୍ଟି କରିବାକୁ ଚାହିଁଛନ୍ତି — ଆଉ ଆପଣ ଲମ୍ବା ସମୟ ପାଇଁ ଧୈର୍ଯ୍ୟ ଧରିଛନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਟਾਲੇ ਹੋਏ ਸੁਪਨੇ। ਕੁਝ ਅਜਿਹਾ ਹੈ ਜੋ ਤੁਸੀਂ ਹਮੇਸ਼ਾ ਬਣਾਉਣਾ ਜਾਂ ਸਿਰਜਣਾ ਚਾਹਿਆ ਹੈ — ਅਤੇ ਤੁਸੀਂ ਲੰਮੀ ਖੇਡ ਖੇਡ ਰਹੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odroczone marzenia. Jest coś, co od zawsze chcesz zbudować lub stworzyć – i myślisz o tym długofalowo."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ځنډول شوي ارمانونه. یو څه شته چې تل مو جوړول یا رامنځته کول غوښتل — او تاسو اوږده لوبه کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonhos adiados. Tem algo que você sempre quis construir ou criar — e você está jogando a longo prazo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonhos adiados. Há algo que sempre quiseste construir ou criar — e estás a jogar a longo prazo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vise amânate. E ceva ce ți-ai dorit mereu să construiești sau să creezi — și joci pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложенные мечты. Есть что-то, что тебе всегда хотелось построить или создать, — и ты играешь вдолгую."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inzozi zasubitswe. Hari ikintu wahoze wifuza kubaka cyangwa guhanga — kandi urimo kwihangana igihe kirekire."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කල් දැමූ සිහින. ඔබ හැමදාම හදන්න හෝ නිර්මාණය කරන්න ආස කරපු දෙයක් තියෙනවා — ඔබ දිගු කාලීනව හිතනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložené sny. Je niečo, čo chceš odjakživa vybudovať alebo vytvoriť – a hráš dlhú hru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložene sanje. Je nekaj, kar si vedno želiš zgraditi ali ustvariti – in igraš dolgo igro."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zviroto zvakamirira. Pane chimwe chinhu chawagara uchida kuvaka kana kugadzira — uye uri kutamba mutambo murefu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riyooyin dib loo dhigay. Waxa jira wax aad had iyo jeer rabtay inaad dhisto ama abuurto — waxaadna ciyaaraysaa ciyaar dheer."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ëndrra të shtyra. Ka diçka që gjithmonë ke dashur ta ndërtosh ose krijosh – dhe po luan një lojë afatgjatë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одложени снови. Постоји нешто што одувек желиш да изградиш или створиш — и играш на дуге стазе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impian anu ditunda. Aya hal anu ti baheula hoyong diwangun atanapi dijieun ku anjeun, sareng anjeun nuju ngajalankeun rencana jangka panjang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppskjutna drömmar. Det finns något du alltid velat bygga eller skapa – och du spelar på lång sikt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndoto zilizoahirishwa. Kuna kitu ambacho siku zote umetaka kujenga au kuunda — na unacheza mchezo mrefu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தள்ளிவைத்த கனவுகள். எப்போதும் உருவாக்க விரும்பிய ஒன்று இருக்கிறது — நீங்கள் நீண்ட கால ஆட்டம் ஆடுகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వాయిదా వేసిన కలలు. మీరు ఎప్పటినుంచో నిర్మించాలని లేదా సృష్టించాలని కోరుకుంటున్నది ఏదో ఉంది — దాని కోసం మీరు ఓపికగా ఎదురుచూస్తున్నారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орзуҳои мавқуфгузошта. Чизе ҳаст, ки ҳамеша сохтан ё офаридан мехостӣ — ва ту бозии дарозро пеш мебарӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความฝันที่รอเวลา มีบางอย่างที่คุณอยากสร้างมาตลอด และคุณกำลังวางแผนระยะยาว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝተደናጐዩ ሕልምታት። ኩሉ ግዜ ክትሃንጽዎ ወይ ክትፈጥርዎ እትደልዩ ነገር ኣሎ — ነዊሕ ጸወታ ትጻወቱ ኣለኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yza süýşürilen arzuwlar. Hemişe gurmak ýa-da döretmek isleýän bir zadyň bar — we sen uzak möhletli oýun oýnaýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertelenmiş hayaller. Hep yapmak ya da üretmek istediğin bir şey var ve uzun vadeli düşünüyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкладені мрії. Є щось, що тобі завжди хотілося збудувати чи створити, — і ти граєш на довгу дистанцію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملتوی خواب۔ کچھ ایسا ہے جسے بنانے یا تخلیق کرنے کی ہمیشہ سے خواہش رہی ہے، اور اس کے لیے آپ کی نظر دور تک ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyinga qoldirilgan orzular. Doim yaratishni xohlagan narsangiz bor — va siz uzoqni koʻzlab harakat qilyapsiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những ước mơ tạm gác. Có điều gì đó bạn luôn muốn gây dựng hay sáng tạo — và bạn đang kiên nhẫn chờ."
