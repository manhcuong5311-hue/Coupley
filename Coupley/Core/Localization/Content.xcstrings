        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi bộ giúp giảm cortisol, và đi cạnh nhau dễ chịu hơn ngồi đối diện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散步能降低压力激素，并肩走也比面对面更轻松。"
