    "Career ambition shapes schedules, energy levels, and what you expect from home." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطموح المهني يشكّل المواعيد ومستوى الطاقة والتوقعات من البيت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracovní ambice ovlivňují rozvrh, energii i to, co čekáš od domova."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereambitioner former jeres hverdag, dit energiniveau og det, du forventer derhjemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Ambitionen prägen Zeitpläne, Energie und was du dir von Zuhause erwartest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επαγγελματικές φιλοδοξίες καθορίζουν προγράμματα, ενέργεια και το τι περιμένεις από το σπίτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ambición profesional marca horarios, niveles de energía y lo que esperas de casa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uratavoitteet muovaavat aikatauluja, jaksamista ja sitä, mitä odotat kotoa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinuhubog ng ambisyon sa career ang schedule, lakas, at mga inaasahan mo sa bahay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ambition professionnelle façonne les horaires, le niveau d'énergie et ce qu'on attend de la maison."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שאפתנות בקריירה מעצבת את סדר היום, את רמת האנרגיה ואת מה שמצפים מהבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "करियर की महत्वाकांक्षा से तय होता है कि दिनचर्या, ऊर्जा और घर से उम्मीदें कैसी होंगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A karrierambíció meghatározza a napirendet, az energiaszintet és azt, mit vársz az otthontól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambisi karier membentuk jadwal, tingkat energi, dan apa yang kamu harapkan di rumah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambizione professionale influenza orari, livelli di energia e ciò che ti aspetti dalla vita di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事への意欲は、スケジュールや元気の残り具合、家に求めるものまで左右します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일에 대한 욕심은 일정, 에너지, 그리고 집에서 기대하는 것까지 좌우해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cita-cita kerjaya membentuk jadual, tahap tenaga dan apa yang anda harapkan di rumah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereambisjoner former timeplaner, energinivå og hva du forventer hjemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambitie bepaalt je agenda, je energie en wat je thuis verwacht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambicje zawodowe kształtują grafik, poziom energii i to, czego oczekujesz od domu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ambição profissional molda rotinas, níveis de energia e o que você espera de casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambiția profesională influențează programul, nivelul de energie și ce aștepți de la viața acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карьерные амбиции влияют на график, энергию и ожидания от дома."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärambitioner påverkar scheman, energinivåer och vad man förväntar sig hemma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความทะเยอทะยานในอาชีพส่งผลต่อตารางเวลา พลังงาน และสิ่งที่คุณคาดหวังจากบ้าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariyer hırsı, programını, enerjini ve evden beklentilerini şekillendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар’єрні амбіції впливають на графік, рівень енергії й очікування від дому."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham vọng sự nghiệp định hình lịch trình, năng lượng và những gì bạn mong đợi ở nhà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事业心会影响作息、精力，以及你对家的期待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事業心會影響作息、精力，還有你對家的期待。"
          }
        }
      }
    },
    "Career is a means to an end — it funds the life I want" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل وسيلة لغاية، يموّل الحياة التي أريدها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariéra je prostředek – financuje život, jaký chci"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrieren er et middel – den finansierer det liv, jeg vil have"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Job ist Mittel zum Zweck – er finanziert das Leben, das ich will"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καριέρα είναι μέσο — χρηματοδοτεί τη ζωή που θέλω"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carrera es un medio — financia la vida que quiero"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ura on väline – se rahoittaa haluamani elämän"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paraan lang ang career — pinopondohan nito ang buhay na gusto ko"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moyen, pas une fin : ça finance la vie que je veux"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקריירה היא אמצעי — היא מממנת את החיים שאני רוצה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "करियर बस एक ज़रिया है — मनचाही ज़िंदगी का ख़र्च चलाने का"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A karrier eszköz – abból finanszírozom a vágyott életet"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karier hanya sarana — untuk membiayai hidup yang kuinginkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro è un mezzo — finanzia la vita che voglio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアは手段。望む暮らしの資金源"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커리어는 수단이에요, 원하는 삶을 위한 돈줄이죠"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerjaya hanyalah alat — ia membiayai hidup yang saya mahukan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrieren er et middel – den finansierer livet jeg vil ha"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk is een middel – het betaalt het leven dat ik wil"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariera to środek do celu – finansuje życie, jakiego chcę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carreira é um meio — banca a vida que eu quero"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cariera e un mijloc — îmi finanțează viața pe care o vreau"
