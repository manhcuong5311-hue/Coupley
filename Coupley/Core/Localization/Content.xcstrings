    "Open-door policy. This works well when both partners are comfortable raising things without a formal invitation." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة الباب المفتوح. تنجح هذه الطريقة حين يرتاح الطرفان لطرح الأمور دون دعوة رسمية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dveře jsou vždycky otevřené. Funguje to, když oba dokážete otevřít jakékoli téma i bez formálního pozvání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åben-dør-politik. Det fungerer godt, når I begge er trygge ved at tage ting op uden en formel invitation."
