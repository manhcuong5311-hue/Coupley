        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብባህሪኹም ሚዛናውያን ኢኹም። ምስ መብዛሕትኦም መጻምድቲ ብዛዕባ ገንዘብ ብቐሊሉ ክትዘራረቡ ትኽእሉ ትኾኑ።"
