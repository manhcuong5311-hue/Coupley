        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተቀባይና ፈቃደኛ። ብቻ በእውነት ማለትዎን ያረጋግጡ — የቤት እንስሳ ረጅም ቁርጠኝነት ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقبّل واستعداد. فقط تأكدوا أنكم تعنون ذلك فعلًا، فالحيوان الأليف التزام طويل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সহযোগী আৰু ইচ্ছুক। কেৱল নিশ্চিত হওক যে আপুনি সঁচাকৈয়ে তেনে ভাবে — পোহনীয়া জীৱ এক দীঘলীয়া দায়িত্ব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güzəştə gedən və hazır. Sadəcə bunu həqiqətən nəzərdə tutduğuna əmin ol — ev heyvanı uzunmüddətli öhdəlikdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падатліва і з гатоўнасцю. Толькі пераканайся, што сапраўды гэтага хочаш, — гадаванец гэта надоўга."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отстъпчиво и с желание. Само се увери, че наистина го мислиш – любимецът е дълъг ангажимент."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানিয়ে নিতে আর রাজি থাকতে পারো। শুধু নিশ্চিত হও যে সত্যিই মন থেকে বলছ — পোষা প্রাণী লম্বা দায়িত্ব।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susretljivo i spremno. Samo se uvjeri da to zaista misliš – ljubimci su duga obaveza."
