        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথাটো দামৰ নহয় — আপুনি নথকা সময়তো কোনোবাই আপোনাৰ কথা ভাবিছিল, তাৰেই প্ৰমাণ। মনত ৰখাটোৱেই আচল কথা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Məsələ qiymətdə deyil — bu, sən yanında olmayanda da kimsə səni düşündüyünün sübutudur. Bütün məna diqqətdədir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справа не ў цане — гэта доказ, што пра цябе думалі, нават калі цябе не было побач. Увесь сэнс — ва ўвазе."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е важна цената – а доказателството, че някой е мислил за теб, дори когато те няма наоколо. Вниманието е най-важното."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দামটা আসল নয় — আসল হলো প্রমাণ যে তুমি না থাকলেও কেউ তোমার কথা ভেবেছে। যত্ন করে ভাবাটাই সব।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije stvar u cijeni – to je dokaz da neko misli na tebe i kad niste zajedno. Upravo je pažnja ono što se računa."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es tracta del preu — és la prova que algú ha pensat en tu quan no hi eres. El detall ho és tot."
