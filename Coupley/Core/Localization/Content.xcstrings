        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баарына туура келген жооп жок — бирок бул жерде бир пикирде болуу олуттуу чыр-чатактын алдын алат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et gëtt keng Äntwert, déi fir jiddereen stëmmt — mee wann dir hei eens sidd, vermeit dir vill Reiwereien."
