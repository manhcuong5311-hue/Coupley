        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que acho difícil — falar em público, autoconfiança"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que me custa — falar em público, autoconfiança"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva ce mi se pare greu — vorbitul în public, încrederea"
