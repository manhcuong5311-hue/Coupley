        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ዋጋው ያልታወቀ ነገር ነው። ከመገመት ይልቅ መጀመሪያ ይጠይቃሉ። ይህ በእውነት አሳቢ የሆነ የድጋፍ መንገድ ነው።"
