        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họrọ ihe niile metụrụ gị — ndepụta egwu unu na-ekerịta bụ ihe na-ejikọ unu nke a naghị akpọ ihe."
