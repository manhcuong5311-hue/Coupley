    "Offer a no-pressure wind-down: 'no need to chat, just here.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقترحوا استرخاءً بلا ضغط: «لا داعي للكلام، أنا هنا فقط»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídni zklidnění bez tlaku: „Nemusíme mluvit, jsem tu.“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbyd en rolig afslutning på dagen uden pres: »Vi behøver ikke snakke, jeg er bare her.«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biete entspanntes Runterkommen an: „Wir müssen nicht reden, ich bin einfach da.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρότεινε ένα χαλαρό κλείσιμο της μέρας χωρίς πίεση: «Δεν χρειάζεται να μιλήσουμε, είμαι απλώς εδώ.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrécele un rato para desconectar sin presión: “No hace falta hablar, solo estoy aquí”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjoa paineetonta rauhoittumista: ”Ei tarvitse jutella, olen vain tässä.”"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-alok ng pahingang walang pressure: “hindi kailangang mag-usap, nandito lang ako.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose un moment calme, sans pression : « pas besoin de parler, je suis juste là »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להציע התכנסות בלי לחץ: \"לא צריך לדבר, אני פשוט כאן.\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना दबाव के सुस्ताने का मौक़ा दें: “बात करने की ज़रूरत नहीं, मैं बस यहीं हूँ।”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajánlj egy nyomás nélküli lazítást: „Nem kell beszélgetnünk, csak itt vagyok.”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tawarkan waktu santai tanpa tekanan: “nggak usah ngobrol, aku di sini aja.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponi un momento di relax senza pressioni: «Non serve parlare, sono qui»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「話さなくていいよ、そばにいるね」と、気負わずくつろげる時間を差し出しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“얘기 안 해도 돼요, 그냥 옆에 있을게요” 하며 편하게 쉬게 해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajak berehat tanpa tekanan: “tak perlu berbual, saya ada di sini.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By på en rolig stund uten krav: «Vi trenger ikke prate, jeg er bare her.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bied een ontspannen avond zonder druk: “We hoeven niet te praten, ik ben er gewoon.”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproponuj spokojne wyciszenie bez presji: „Nie musimy rozmawiać, po prostu jestem”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofereça um momento para relaxar sem pressão: “não precisa conversar, só tô aqui”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propune o seară liniștită, fără presiune: „nu trebuie să vorbim, sunt doar aici”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложи спокойно расслабиться без давления: «Можно не болтать, я просто рядом»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erbjud en stund att varva ner, helt utan press: ”Vi behöver inte prata, jag är bara här.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชวนผ่อนคลายแบบไม่กดดัน: “ไม่ต้องคุยก็ได้ แค่อยู่ตรงนี้”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
