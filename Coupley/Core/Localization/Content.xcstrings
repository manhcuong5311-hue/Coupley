    "Space to breathe. A garden for dinner, kids, a dog — you're thinking in domestic terms and that's honest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة للتنفس. حديقة للعشاء والأطفال وكلب. تفكيرك منصبّ على الحياة المنزلية، وهذه صراحة تُحسب لك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor k nadechnutí. Zahrada na večeře, děti, pejsek – přemýšlíš v domácích kategoriích a je to upřímné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plads til at trække vejret. En have til middage, børn, en hund – du tænker i hjemlige baner, og det er ærligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raum zum Durchatmen. Ein Garten für Essen im Freien, für Kinder, einen Hund – du denkst an ein Zuhause, und das ist ehrlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χώρος για να ανασάνεις. Ένας κήπος για τραπέζια, παιδιά, έναν σκύλο — σκέφτεσαι με όρους οικογενειακής ζωής και αυτό είναι ειλικρινές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio para respirar. Un jardín para cenar fuera, para hijos, para un perro — piensas en clave de hogar, y es sincero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaa hengittää. Puutarha illallisille, lapsille, koiralle – ajattelet kotielämän kautta, ja se on rehellistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espasyong makahinga. Hardin para sa hapunan, mga anak, aso — iniisip mo ang buhay-bahay, at tapat ’yon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l'espace pour respirer. Un jardin pour les dîners, les enfants, un chien — tu penses vie de famille, et c'est honnête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקום לנשום. גינה לארוחות ערב, לילדים, לכלב — החשיבה שלך ביתית, וזה כן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साँस लेने की जगह। बग़ीचे में डिनर, बच्चे, एक कुत्ता — आपकी सोच घर-गृहस्थी वाली है, और यह ईमानदारी की बात है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tér, ahol fellélegezhetsz. Kert a vacsorákhoz, a gyerekekhez, egy kutyához – családi otthonban gondolkodsz, és ez őszinte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang untuk bernapas. Taman untuk makan malam, anak-anak, anjing — kamu berpikir soal kehidupan rumah tangga, dan itu jujur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio per respirare. Un giardino per le cene, i bambini, un cane — pensi in termini di vita domestica ed è un pensiero sincero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆとりのある空間。庭でのディナー、子ども、犬。家庭的な暮らしを思い描いていて、それは素直な気持ちです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨 쉴 공간이 필요해요. 마당에서 먹는 저녁, 아이, 강아지까지 가정적인 그림을 그리고 있고, 그건 솔직한 마음이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang untuk bernafas. Taman untuk makan malam, anak-anak, anjing — anda berfikir tentang kehidupan berumah tangga, dan itu jujur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rom til å puste. En hage til middager, barn og hund – du tenker på hjem og hverdagsliv, og det er ærlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruimte om te ademen. Een tuin voor etentjes, kinderen, een hond – je denkt aan huiselijk leven, en dat is eerlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestrzeń do oddychania. Ogród na wspólne kolacje, dla dzieci, dla psa – myślisz kategoriami rodzinnego domu i to szczere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço para respirar. Um quintal para jantares, crianças, um cachorro — você pensa na vida em casa, e isso é sincero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiu de respirat. O grădină pentru cine în aer liber, copii, un câine — gândești în termeni de cămin și e o dorință sinceră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место, где можно дышать. Сад для ужинов, детей, собаки — ты мыслишь категориями дома, и это честно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrymme att andas. En trädgård för middagar, barn, en hund – du tänker i hem- och familjebanor, och det är ärligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ให้หายใจ สวนไว้กินข้าวเย็น ให้ลูกวิ่งเล่น ให้หมาวิ่ง คุณคิดแบบคนสร้างครอบครัว และนั่นก็จริงใจดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nefes alacak alan. Akşam yemekleri, çocuklar, bir köpek için bir bahçe; ev hayatı üzerinden düşünüyorsun ve bu dürüst bir tutum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простір, щоб дихати. Сад для вечер просто неба, дітей, собаки — ти мислиш категоріями дому, і це чесно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian để thở. Một khu vườn để ăn tối, cho con trẻ, cho chú chó — bạn đang nghĩ về tổ ấm, và điều đó thật chân thành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸的空间。在花园里吃晚饭，有孩子，养条狗，你在用过日子的眼光思考，这很实在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以喘口氣的空間。有座庭院，可以在那裡吃晚餐、陪小孩、養隻狗。你想的是居家生活，這很誠實。"
          }
        }
      }
    },
    "Specific > generic. 'You're amazing' lands flat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحدد أفضل من العام. «أنت شخص مذهل» لا تترك أثرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrétní > obecné. „Jsi poklad“ vyzní naprázdno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
