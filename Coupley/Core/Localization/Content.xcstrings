        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutengapo mbali kwabwino. Mumapezeka, mumasamala, koma mumatetezanso malo a inu awiri. Izi zimakhalitsa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hirmaannaa fayya-qabeessa. Ni argamta, ni yaadda, garuu iddoo jaalallee lamaaniis ni eegda. Kun itti fufiinsa qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସୁସ୍ଥ ସମ୍ପର୍କ। ଆପଣ ପାଖରେ ରହନ୍ତି, ଯତ୍ନ ନିଅନ୍ତି, କିନ୍ତୁ ଦୁହିଁଙ୍କ ନିଜସ୍ୱ ଜାଗାକୁ ବି ସୁରକ୍ଷିତ ରଖନ୍ତି। ଏହା ଲମ୍ବା ସମୟ ଚାଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿਹਤਮੰਦ ਮੇਲ-ਜੋਲ। ਤੁਸੀਂ ਹਾਜ਼ਰ ਹੁੰਦੇ ਹੋ, ਪਰਵਾਹ ਕਰਦੇ ਹੋ, ਪਰ ਜੋੜੇ ਦੀ ਆਪਣੀ ਥਾਂ ਵੀ ਬਚਾ ਕੇ ਰੱਖਦੇ ਹੋ। ਇਹ ਲੰਮਾ ਨਿਭ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowe zaangażowanie. Pojawiasz się, zależy ci, ale chronisz też przestrzeń pary. Tak da się żyć długo."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روغه اړیکه. تاسو ورسره یاست، پروا کوئ، خو د جوړې ځای هم ساتئ. دا د دوام وړ ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolvimento saudável. Você aparece, se importa, mas também protege o espaço do casal. Isso se sustenta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma relação saudável. Estás presente, preocupas-te, mas também proteges o espaço do casal. Isso é sustentável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implicare sănătoasă. Ești acolo, îți pasă, dar protejezi și spațiul cuplului. Asta se poate susține pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здоровое участие. Ты приходишь, заботишься, но бережёшь и пространство пары. Так можно долго."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imibanire myiza. Uraza, urabitaho, ariko kandi urinda umwanya wanyu bwite. Ibyo birambye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සෞඛ්‍ය සම්පන්න සම්බන්ධ වීම. ඔබ සහභාගී වෙනවා, සැලකිලිමත් වෙනවා, ඒත් යුවළේ අවකාශයත් රැකගන්නවා. ඒක දිගටම පවත්වාගන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravé zapojenie. Prídeš, záleží ti, ale zároveň chrániš priestor vás dvoch. To je udržateľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravo sodelovanje. Pokažeš se, mar ti je, a varuješ tudi prostor para. To je vzdržno."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubatana kune utano. Unovapo, une hanya, asi unochengetedzawo nzvimbo yenyu vaviri. Izvozvo zvinogona kuramba zviripo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka qayb-qaadasho caafimaad leh. Waad timaaddaa, waad daryeeshaa, laakiin waxaad ilaalisaa goobta labadiinaba. Taasi waa mid waarta."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përfshirje e shëndetshme. Je aty, të intereson, por mbron edhe hapësirën e çiftit. Kjo është e qëndrueshme."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здраво учешће. Ту си, стало ти је, али чуваш и простор вас двоје. То је одрживо."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibet anu séhat. Anjeun sumping, anjeun paduli, tapi anjeun ogé ngajaga rohangan aranjeun duaan. Éta tiasa dijalankeun lami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt engagemang. Du ställer upp, du bryr dig, men du skyddar också parets eget utrymme. Det håller i längden."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushiriki wenye afya. Unakuwepo, unajali, lakini pia unalinda nafasi yenu wawili. Hilo linadumu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆரோக்கியமான ஈடுபாடு. நீங்கள் வருகிறீர்கள், அக்கறை காட்டுகிறீர்கள், ஆனால் ஜோடியின் தனி இடத்தையும் காக்கிறீர்கள். இது நீண்ட காலம் நீடிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆరోగ్యకరమైన అనుబంధం. మీరు వెళ్తారు, పట్టించుకుంటారు, కానీ జంటగా మీ స్థలాన్నీ కాపాడుకుంటారు. అది దీర్ఘకాలం నిలుస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иштироки солим. Ту ҳозир мешавӣ, ғамхорӣ мекунӣ, вале фазои ҷуфтро ҳам ҳифз мекунӣ. Ин устувор аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีส่วนร่วมอย่างพอดี คุณไปหา คุณใส่ใจ แต่ก็ปกป้องพื้นที่ของคู่รักไว้ด้วย แบบนี้ยั่งยืน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጥዑይ ተሳትፎ። ትርከቡ፣ ትግደሱ፣ ግን ናይ ጽምዲ ቦታ እውን ትሕልዉ። እዚ ዝቕጽል እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagdyn gatnaşyk. Sen gelýärsiň, alada edýärsiň, ýöne jübütiň öz dünýäsini hem goraýarsyň. Bu uzak dowam edip biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlıklı bir ilgi. Oradasın, önemsiyorsun ama çiftin alanını da koruyorsun. Bu sürdürülebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здорова участь. Ти приходиш, дбаєш, але й бережеш простір вашої пари. Так можна довго."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صحت مند میل جول۔ آپ کی موجودگی بھی ہے، فکر بھی، مگر جوڑے کی اپنی جگہ کی حفاظت بھی۔ یہ دیرپا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sogʻlom ishtirok. Yonida boʻlasiz, gʻamxoʻrlik qilasiz, lekin juftlikning shaxsiy dunyosini ham asraysiz. Bu uzoq muddat davom etadigan yondashuv."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gắn kết lành mạnh. Bạn có mặt, bạn quan tâm, nhưng cũng giữ gìn không gian riêng của hai người. Như vậy mới bền."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubandakanyeka okusempilweni. Uyafika, uyakhathala, kodwa uyasikhusela nesithuba sesibini. Oko kunokuqhubeka ixesha elide."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àjọṣe tó dára. Ẹ ń wá, ẹ ń bìkítà, ṣùgbọ́n ẹ tún ń dáàbò bo àyè ẹ̀yin méjèèjì. Ìyẹn ṣeé ṣe fún ọjọ́ pípẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的參與。你會出現、會關心，也會守護兩人的空間。這樣能長久。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的相处方式。你会常去走动、真心关心，也会守护你们俩的空间。这样能长久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的參與。你會出現、會關心，也會守護兩人的空間。這樣的方式能長久。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuzibandakanya okunempilo. Uyaba khona, uyakhathalela, kodwa futhi uvikela isikhala sombhangqwana. Lokho kusimeme."
          }
        }
      }
    },
    "High effort, high reward. You probably have big goals and you're willing to sacrifice for them. A partner needs to be okay with that." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groot moeite, groot beloning. Jy het waarskynlik groot doelwitte en is bereid om daarvoor op te offer. ’n Maat moet dit kan aanvaar."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከፍተኛ ጥረት፣ ከፍተኛ ውጤት። ትልቅ ግቦች ሳይኖሩዎት አይቀሩም፣ ለእነሱም መሥዋዕትነት ለመክፈል ፈቃደኛ ነዎት። አጋርዎ በዚህ መስማማት አለባቸው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهد كبير وعائد كبير. لديك على الأرجح أهداف كبيرة واستعداد للتضحية من أجلها، والشريك يحتاج إلى تقبّل ذلك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেছি প্ৰচেষ্টা, বেছি পুৰস্কাৰ। আপোনাৰ হয়তো ডাঙৰ লক্ষ্য আছে আৰু তাৰ বাবে ত্যাগ কৰিবলৈ আপুনি সাজু। সংগীয়ে এইটো মানি ল'ব পাৰিব লাগিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyük səy, böyük qazanc. Yəqin ki, böyük hədəflərin var və onlar üçün fədakarlığa hazırsan. Partnyorun bununla barışmalıdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шмат намаганняў, шмат вынікаў. Хутчэй за ўсё, у цябе вялікія мэты, і дзеля іх табе не шкада ахвяр. Палавінцы трэба з гэтым пагадзіцца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голямо усилие, голяма награда. Вероятно имаш големи цели и приемаш жертви заради тях. Половинката ти трябва да е съгласна с това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেশি চেষ্টা, বেশি প্রাপ্তি। তোমার হয়তো বড় লক্ষ্য আছে, আর তার জন্য ত্যাগ করতেও রাজি। পার্টনারকে এটা মেনে নিতে হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veliki trud, velika nagrada. Vjerovatno imaš velike ciljeve i spremnost na odricanje. Voljena osoba mora biti okej s tim."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molt esforç, molta recompensa. Segurament tens grans objectius i no et fa res sacrificar-te per aconseguir-los. La teva parella ha d'estar d'acord amb això."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velké úsilí, velká odměna. Nejspíš máš velké cíle a leccos pro ně obětuješ. Protějšek s tím musí být v pohodě."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymdrech fawr, gwobr fawr. Mae'n siŵr bod gen ti nodau mawr a dy fod yn fodlon aberthu er eu mwyn. Mae angen i bartner fod yn iawn gyda hynny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor indsats, stor gevinst. Du har nok store mål og er villig til at ofre noget for dem. En partner skal være okay med det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoher Einsatz, hoher Lohn. Du hast wahrscheinlich große Ziele und bist bereit, dafür zu verzichten. Die andere Person muss damit klarkommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλη προσπάθεια, μεγάλη ανταμοιβή. Μάλλον έχεις μεγάλους στόχους και θυσιάζεις πράγματα γι' αυτούς. Το ταίρι σου πρέπει να είναι εντάξει με αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucho esfuerzo, mucha recompensa. Seguramente tienes grandes metas y aceptas sacrificarte por ellas. Tu pareja tiene que estar de acuerdo con eso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suur pingutus, suur tasu. Sul on ilmselt suured eesmärgid ja oled nende nimel valmis ohverdama. Partner peab sellega leppima."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahalegin handia, sari handia. Ziur asko helburu handiak dituzu eta horien alde sakrifizioak egiteko prest zaude. Bikotekide batek hori onartu behar du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاش زیاد، پاداش زیاد. احتمالاً هدف‌های بزرگی داری و حاضری برایشان از خیلی چیزها بگذری. پارتنرت باید با این کنار بیاید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso panos, iso palkinto. Sinulla on luultavasti suuria tavoitteita, ja olet valmis uhrautumaan niiden eteen. Kumppanin täytyy hyväksyä se."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malaking effort, malaking gantimpala. Malamang malalaki ang pangarap mo at handa kang magsakripisyo para dito. Kailangang ayos lang ito sa partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gros efforts, grosses récompenses. Tu as sûrement de grands objectifs et tu acceptes de faire des sacrifices pour eux. L'autre doit être d'accord avec ça."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iarracht mhór, luach saothair mór. Is dócha go bhfuil spriocanna móra agat agus go bhfuil tú sásta íobairt a dhéanamh ar a son. Caithfidh páirtí a bheith sásta leis sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moito esforzo, moita recompensa. Seguramente tes metas grandes e disposición para sacrificarte por elas. A túa parella ten que estar de acordo con iso."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વધુ મહેનત, વધુ વળતર. તમારાં લક્ષ્યો કદાચ મોટાં છે અને એ માટે તમે ત્યાગ કરવા તૈયાર છો. પાર્ટનરે આ સ્વીકારવું પડશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babban ƙoƙari, babbar riba. Wataƙila kuna da manyan buri kuma kuna shirye ku sadaukar dominsu. Abokin zama na buƙatar ya amince da hakan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השקעה גבוהה, תמורה גבוהה. כנראה שיש לך מטרות גדולות ונכונות להקריב בשבילן. הצד השני צריך להיות בסדר עם זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा मेहनत, ज़्यादा इनाम। शायद आपके लक्ष्य बड़े हैं और उनके लिए त्याग करने को आप तैयार हैं। पार्टनर को इससे सहज होना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velik trud, velika nagrada. Vjerojatno imaš velike ciljeve i za njih se rado odričeš nekih stvari. Voljena osoba to mora moći prihvatiti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwo efò, gwo rekonpans. Ou pwobableman gen gwo objektif e ou dispoze fè sakrifis pou yo. Yon patnè bezwen dakò ak sa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagy erőfeszítés, nagy jutalom. Valószínűleg nagy céljaid vannak, és áldozatot is hozol értük. A párodnak ezzel rendben kell lennie."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեծ ջանք, մեծ պարգև։ Հավանաբար մեծ նպատակներ ունես և պատրաստ ես զոհողությունների։ Զուգընկերդ պետք է համաձայն լինի դրան։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha besar, hasil besar. Kamu mungkin punya target besar dan rela berkorban untuknya. Pasanganmu perlu bisa menerima itu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgbalị dị elu, ụgwọ ọrụ dị elu. O nwere ike ịbụ na i nwere nnukwu ebumnuche, ị dịkwa njikere ịchụ àjà maka ha. Onye gị kwesịrị ịnabata nke ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikil fyrirhöfn, mikil umbun. Þú átt líklega stór markmið og ert til í að fórna ýmsu fyrir þau. Maki þarf að geta sætt sig við það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande impegno, grandi risultati. Probabilmente hai obiettivi ambiziosi e accetti di fare sacrifici per raggiungerli. Il tuo partner deve sentirsi a suo agio con questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力で頑張り、大きな成果を得るタイプです。きっと大きな目標があって、そのために犠牲も払えるのでしょう。パートナーにはそれを受け入れてもらう必要があります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha gedhe, asil gedhe. Panjenengan mbokmenawa nduwe ancas gedhe lan gelem korban kanggo kuwi. Pasangan perlu bisa nampa iki."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დიდი ძალისხმევა, დიდი ჯილდო. ალბათ, დიდი მიზნები გაქვს და მათთვის მსხვერპლის გაღებაც შეგიძლია. პარტნიორი ამას უნდა შეეგუოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үлкен еңбек, үлкен нәтиже. Үлкен мақсаттарың бар шығар, олар үшін құрбандыққа дайынсың. Серігің мұны қабылдай алуы керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ខិតខំខ្លាំង ទទួលផលខ្លាំង។ អ្នកប្រហែលមានគោលដៅធំៗ ហើយសុខចិត្តលះបង់ដើម្បីវា។ ដៃគូត្រូវទទួលយករឿងនោះបាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೆಚ್ಚು ಶ್ರಮ, ಹೆಚ್ಚು ಫಲ. ನಿಮಗೆ ದೊಡ್ಡ ಗುರಿಗಳಿವೆ, ಅವುಗಳಿಗಾಗಿ ತ್ಯಾಗಕ್ಕೂ ಸಿದ್ಧ. ಸಂಗಾತಿ ಇದನ್ನು ಒಪ್ಪಿಕೊಳ್ಳಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많이 쏟는 만큼 크게 얻어요. 아마 큰 목표가 있고 그걸 위해 희생할 각오도 되어 있을 거예요. 연인도 그걸 받아들일 수 있어야 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewla mezin, xelata mezin. Belkî armancên te yên mezin hene û tu amade yî ji bo wan fedakariyê bikî. Divê hevjînê te bi vê re rehet be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чоң аракет, чоң натыйжа. Чоң максаттарың бар го, алар үчүн курмандык кылууга даярсың. Сүйгөнүң буга макул болушу керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill Asaz, vill Belounung. Du hues wuel grouss Ziler a bass bereet, dofir Affer ze bréngen. Däi Schatz muss domat kloerkommen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ລົງແຮງຫຼາຍ ໄດ້ຫຼາຍ ເຈົ້າຄົງມີເປົ້າໝາຍໃຫຍ່ ແລະ ພ້ອມເສຍສະລະເພື່ອມັນ ຄູ່ຕ້ອງຮັບໄດ້ກັບເລື່ອງນັ້ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didelės pastangos, didelis atlygis. Tikriausiai turi didelių tikslų ir dėl jų sutinki aukotis. Antrajai pusei tai turi tikti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lielas pūles, liela atdeve. Droši vien tev ir lieli mērķi, un to dēļ tu daudz ko upurē. Otrajai pusei tam jābūt pieņemamam."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezaka lehibe, valisoa lehibe. Azo inoana fa manana tanjona lehibe ianao ary vonona hanao sorona ho azy ireo. Mila manaiky izany ny olon-tiana."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He kaha nui, he hua nui. Tērā pea he whāinga nui āu, ā, ka whakaae koe ki te whakarērea mō aua whāinga. Me pai tēnā ki tētahi hoa aroha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голем труд, голема награда. Веројатно имаш големи цели и спремност да се жртвуваш за нив. Половинката треба да е во ред со тоа."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വലിയ പരിശ്രമം, വലിയ നേട്ടം. നിങ്ങൾക്ക് വലിയ ലക്ഷ്യങ്ങളുണ്ടാകും, അതിനായി ത്യാഗം ചെയ്യാനും നിങ്ങൾ തയ്യാറാണ്. പങ്കാളിക്ക് അത് ഉൾക്കൊള്ളാനാകണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их хүчин чармайлт, их шагнал. Чамд том зорилго бий, түүнийхээ төлөө золиослоход бэлэн байх. Хань чинь үүнийг хүлээн зөвшөөрөх хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोठे प्रयत्न, मोठे फळ. तुमची ध्येये बहुधा मोठी असतील आणि त्यांच्यासाठी त्याग करायला तुम्ही तयार असाल. जोडीदाराला ते मान्य असायला हवे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha tinggi, ganjaran tinggi. Anda mungkin ada matlamat besar dan sanggup berkorban untuknya. Pasangan perlu boleh terima hal itu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sforz kbir, premju kbir. Probabbli għandek għanijiet kbar u tissagrifika għalihom. Partner ikollu bżonn jaċċetta dan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အားထုတ်မှု များလေ ရလဒ် များလေ။ ပန်းတိုင်ကြီးတွေ ရှိပြီး အဲဒီအတွက် စွန့်လွှတ်ဖို့ ဆန္ဒရှိမှာပါ။ ချစ်သူက ဒါကို လက်ခံနိုင်ဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy innsats, høy gevinst. Du har nok store mål og er villig til å ofre for dem. En partner må være komfortabel med det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठूलो मेहनत, ठूलो प्रतिफल। तपाईंका ठूला लक्ष्य होलान् र तिनका लागि त्याग गर्न तयार हुनुहुन्छ। पार्टनर यसमा सहज हुनुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel inzet, veel beloning. Je hebt vast grote doelen en bent bereid er iets voor op te offeren. Je partner moet daar vrede mee hebben."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khama lalikulu, phindu lalikulu. Mwina muli ndi zolinga zazikulu ndipo ndinu ofunitsitsa kudzipereka chifukwa cha izo. Wokondedwa ayenera kuvomereza izi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carraaqqii guddaa, bu'aa guddaa. Kaayyoo gurguddaa qabda ta'a, isaaniifis aarsaa kaffaluuf qophii dha. Jaalalleen kee kana fudhachuun barbaachisaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଧିକ ପରିଶ୍ରମ, ଅଧିକ ଫଳ। ଆପଣଙ୍କ ବୋଧହୁଏ ବଡ଼ ଲକ୍ଷ୍ୟ ଅଛି ଓ ସେଥିପାଇଁ ତ୍ୟାଗ କରିବାକୁ ପ୍ରସ୍ତୁତ। ସାଥୀଙ୍କୁ ଏଥିରେ ସହମତ ହେବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਡੀ ਮਿਹਨਤ, ਵੱਡਾ ਫਲ। ਸ਼ਾਇਦ ਤੁਹਾਡੇ ਟੀਚੇ ਵੱਡੇ ਹਨ ਅਤੇ ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਲਈ ਕੁਰਬਾਨੀ ਦੇਣ ਨੂੰ ਤਿਆਰ ਹੋ। ਪਾਰਟਨਰ ਨੂੰ ਇਸ ਨਾਲ ਸਹਿਜ ਹੋਣਾ ਪਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duży wysiłek, duża nagroda. Pewnie masz wielkie cele i chcesz się dla nich poświęcać. Druga połówka musi to akceptować."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوړه هڅه، لوړ انعام. ښايي لویې موخې لرئ او د هغو لپاره قرباني ورکولو ته چمتو یاست. ملګری مو باید له دې سره سم وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito esforço, muita recompensa. Você provavelmente tem grandes metas e topa abrir mão de coisas por elas. Seu amor precisa estar de boa com isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito esforço, muita recompensa. Provavelmente tens grandes objetivos e aceitas fazer sacrifícios por eles. O teu par precisa de aceitar isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efort mare, recompense mari. Probabil ai obiective mari și accepți să faci sacrificii pentru ele. Un partener trebuie să fie de acord cu asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие усилия — большая отдача. Скорее всего, у тебя крупные цели, и ради них ты идёшь на жертвы. Партнёру важно быть к этому готовым."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuhate mwinshi, inyungu nyinshi. Birashoboka ko ufite intego nini kandi witeguye kuzitangira. Umukunzi wawe agomba kubyakira."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වැඩි උත්සාහය, වැඩි ප්‍රතිලාභ. ඔබට ලොකු ඉලක්ක ඇති, ඒවා වෙනුවෙන් කැප කරන්නත් ඔබ කැමතියි. සහකරුවෙක් ඒකට එකඟ වෙන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľké úsilie, veľká odmena. Asi máš veľké ciele a vieš im veľa obetovať. Polovička s tým musí byť v pohode."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velik vložek, velika nagrada. Verjetno imaš velike cilje in zanje zmoreš marsikaj žrtvovati. Partner mora to sprejeti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushanda zvikuru, mubayiro mukuru. Pamwe une zvinangwa zvikuru uye unoda kuzvipira nekuda kwazvo. Mudiwa anofanira kunzwisisa izvozvo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadaal badan, abaal-marin badan. Waxay u badan tahay inaad leedahay hadafyo waaweyn oo aad diyaar u tahay inaad u huriso. Lammaane wuxuu u baahan yahay inuu taas ku qanco."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përpjekje e madhe, shpërblim i madh. Ndoshta ke synime të mëdha dhe je gati të sakrifikosh për to. Partneri yt duhet ta pranojë këtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Велики труд, велика награда. Вероватно имаш велике циљеве и не плашиш се одрицања због њих. Твојој половини то мора бити у реду."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha ageung, hasil ageung. Anjeun sigana gaduh tujuan anu ageung sareng daék berkorban kanggo éta. Pasangan kedah narima éta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor insats, stor belöning. Du har nog stora mål och är beredd att offra för dem. En partner behöver vara okej med det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhudi kubwa, mafanikio makubwa. Huenda una malengo makubwa na uko tayari kujitolea kwa ajili yake. Mwenzi anahitaji kuwa sawa na hilo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிக முயற்சி, அதிகப் பலன். உங்களுக்குப் பெரிய இலக்குகள் இருக்கும், அவற்றுக்காகத் தியாகம் செய்யத் தயாராக இருப்பீர்கள். துணை அதை ஏற்றுக்கொள்ள வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎక్కువ శ్రమ, ఎక్కువ ఫలితం. మీకు బహుశా పెద్ద లక్ష్యాలు ఉన్నాయి, వాటి కోసం త్యాగాలకు సిద్ధం. భాగస్వామికి అది సమ్మతం కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заҳмати баланд, мукофоти баланд. Эҳтимол ту ҳадафҳои калон дорӣ ва барои онҳо қурбонӣ карданро омодаӣ. Ёрат бояд бо ин розӣ бошад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงแรงมาก ได้ผลมาก คุณน่าจะมีเป้าหมายใหญ่และยอมเสียสละเพื่อมัน คนรักต้องรับเรื่องนี้ได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዓቢ ጻዕሪ፣ ዓቢ ዓስቢ። ዓበይቲ ዕላማታት ኣለኩም ትኾኑ፣ ንዕኦም ክትውፍዩ ድማ ድሉዋት ኢኹም። መጻምዲ ነዚ ክቕበሎ የድልዮ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uly tagalla, uly netije. Seniň uly maksatlaryň bar we olar üçin gurban bermäge taýýarsyň. Söýgüliň muny kabul edip bilmeli."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük emek, büyük ödül. Muhtemelen büyük hedeflerin var ve onlar için fedakârlığa hazırsın. Partnerinin de bununla barışık olması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великі зусилля — велика віддача. Схоже, у тебе масштабні цілі, і заради них тобі не шкода жертвувати. Половинці треба бути з цим згодною."
