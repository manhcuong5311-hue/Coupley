    "Listen like a friend, not a fixer. Echo back what they feel." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luister soos ’n vriend, nie soos ’n hersteller nie. Weerkaats wat jou maat voel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንደ አስተካካይ ሳይሆን እንደ ጓደኛ ያዳምጡ። የሚሰማቸውን መልሰው ይንገሯቸው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصغوا كصديق، لا كمن يصلح الأعطال. ردّدوا ما يشعر به شريكك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমাধানকাৰী হিচাপে নহয়, বন্ধুৰ দৰে শুনক। তেওঁ যি অনুভৱ কৰিছে, সেয়া ঘূৰাই কওক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dost kimi dinlə, problem həll edən kimi yox. Onun hisslərini öz sözlərinlə təkrarla."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слухай па-сяброўску, не спяшайся выпраўляць. Агучвай тое, што адчувае палавінка."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушай с разбиране, а не за да поправяш. Повтори с твои думи това, което чувства."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্যা সমাধানকারী নয়, বন্ধুর মতো শোনো। ও যা অনুভব করছে, সেটা ফিরিয়ে বলো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slušaj kao prijatelj, ne kao majstor za popravke. Ponovi ono što osjeća."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolta per acompanyar, no per arreglar. Torna-li amb les teves paraules el que sent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslouchej a nesnaž se nic spravovat. Zrcadli, co cítí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwranda fel ffrind, nid fel trwsiwr. Adlewyrcha'r hyn mae dy bartner yn ei deimlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyt som en ven, ikke som en problemløser. Spejl de følelser, din partner giver udtryk for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör zu wie unter Freunden, ohne gleich reparieren zu wollen. Spiegle die Gefühle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άκου για να καταλάβεις, όχι για να «διορθώσεις». Επανάλαβε αυτό που νιώθει το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha para acompañar, no para arreglar. Repite con tus palabras lo que siente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuula nagu sõber, mitte nagu parandaja. Peegelda tagasi, mida ta tunneb."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entzun lagun batek bezala, ez konpontzaile batek. Errepikatu sentitzen duena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل یک دوست گوش بده، نه مثل تعمیرکار. حسش را برایش بازگو کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntele kuin ystävä, älä kuin korjaaja. Sanoita, mitä hän tuntee."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makinig na parang kaibigan, hindi tagaayos. Ibalik sa kanya ang nararamdaman niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute pour comprendre, pas pour réparer. Reformule ce que l'autre ressent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éist mar chara, ní mar dheisitheoir. Abair ar ais an rud a mhothaíonn do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escoita como unha amizade, non como quen arranxa. Repítelle o que sente."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉકેલ શોધનાર નહીં, મિત્રની જેમ સાંભળો. એમને જે લાગે છે એ પાછું કહો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku saurara kamar aboki na kusa, ba mai gyara ba. Ku maimaita abin da abokin zamanku ke ji."
