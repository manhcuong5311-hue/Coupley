        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमानमा केन्द्रित। तपाईं लामो योजनाका लागि बनेको हुनुहुन्न — वा तपाईं यति जवान हुनुहुन्छ कि यो अझै सैद्धान्तिक लाग्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gericht op het nu. Je bent niet ingesteld op plannen voor de lange termijn – of je bent jong genoeg dat dit nog theoretisch voelt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumaika maganizo pa zapano. Simunapangidwe kukonzekera zinthu za kutali — kapena ndinu achinyamata moti izi zikumveka ngati nthano."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har'a irratti xiyyeeffatta. Karoora yeroo dheeraatiif uumamaan hin qophoofne — ykn hamma kun yaada qofa sitti fakkaatutti dargaggeessa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବର୍ତ୍ତମାନରେ ବଞ୍ଚନ୍ତି। ଆପଣ ଲମ୍ବା ସମୟର ଯୋଜନା ପାଇଁ ତିଆରି ନୁହଁନ୍ତି — କିମ୍ବା ଆପଣଙ୍କ ବୟସ ଏତେ କମ୍ ଯେ ଏହା କେବଳ କାଗଜି କଥା ଲାଗେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਜ ਉੱਤੇ ਧਿਆਨ। ਲੰਮੀ ਯੋਜਨਾਬੰਦੀ ਤੁਹਾਡੇ ਸੁਭਾਅ ਵਿੱਚ ਨਹੀਂ — ਜਾਂ ਤੁਸੀਂ ਹਾਲੇ ਇੰਨੇ ਜਵਾਨ ਹੋ ਕਿ ਇਹ ਸਿਰਫ਼ ਕਿਤਾਬੀ ਗੱਲ ਲੱਗਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupienie na teraźniejszości. Planowanie na lata to nie twoja natura – albo to wciąż brzmi dla ciebie jak teoria."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پر اوسني وخت تمرکز. اوږدمهاله پلان ستاسو طبیعت نه دی — یا لا هم په هغه عمر کې یاست چې دا نظري ښکاري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco no presente. Planejar a longo prazo não é a sua — ou isso ainda parece teórico na sua fase de vida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco no presente. Não és de planear a longo prazo — ou ainda falta tanto tempo que isto parece teórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus pe prezent. Planurile pe termen lung nu sunt stilul tău — sau ești la o vârstă la care asta pare încă teoretic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жизнь в настоящем. Долгосрочное планирование — не твоё, или всё это пока кажется слишком далёкой теорией."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaye ku bya none. Ntiwaremewe gutegura ibya kure — cyangwa uracyari muto ku buryo ibi bisa n'ibitekerezo gusa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වර්තමානය කේන්ද්‍ර කරගත්තා. ඔබ දිගු කාලීන සැලසුම් වලට හැදිලා නැහැ — නැත්නම් මේක න්‍යායික දෙයක් වගේ දැනෙන තරම් ඔබ තවම තරුණයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zameranie na prítomnosť. Dlhodobé plánovanie nie je tvoja parketa – alebo je to pre teba zatiaľ len teória."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmerjenost v sedanjost. Dolgoročno načrtovanje ti ni v naravi – ali pa si še v letih, ko se ti to zdi teoretično."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unotarisa nhasi. Hauna kugadzirirwa kuronga kwenguva refu — kana kuti uchiri mudiki zvekuti izvi zvinonzwika sepfungwa chete."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad diiradda saartaa xilligan. Qorshayn fog kuma dhisnid — ama waad yar tahay oo tani waxay kuu muuqataa aragti uun."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus te e tashmja. Planet afatgjata nuk janë për ty – ose je ende në atë fazë të jetës kur kjo duket teorike."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокус на садашњост. Дугорочно планирање ти није у природи — или ти је то још толико далеко да делује као теорија."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museur ka ayeuna. Anjeun sanés jalma anu resep ngarencanakeun jangka panjang, atanapi masih cekap ngora dugi ka ieu karaos sapertos téori waé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lever i nuet. Du är inte gjord för långsiktig planering – eller så är du ung nog för att det ska kännas teoretiskt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unazingatia sasa. Hujaumbwa kwa mipango ya muda mrefu — au bado ni kijana kiasi kwamba hili linaonekana la kinadharia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிகழ்காலத்தில் கவனம். நீண்டகாலத் திட்டமிடல் உங்கள் இயல்பல்ல — அல்லது இது வெறும் கற்பனையாகத் தோன்றும் அளவு நீங்கள் இளமையானவர்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వర్తమానంపైనే దృష్టి. దీర్ఘకాల ప్రణాళికలు మీ స్వభావం కాదు — లేదా ఇది ఇంకా ఊహాజనితంగా అనిపించేంత చిన్నవయసులో ఉన్నారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диққат ба ҳозира. Ту барои нақшаҳои дуру дароз сохта нашудаӣ — ё ҳанӯз ба қадри кофӣ ҷавонӣ, ки ин назариявӣ менамояд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณโฟกัสที่ปัจจุบัน ไม่ได้ถนัดวางแผนระยะยาว หรือยังอายุน้อยพอที่เรื่องนี้จะยังเป็นแค่ทฤษฎี"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ሕጂ ዘተኰሩ። ንነዊሕ መደብ ኣይተፈጠርኩምን — ወይ እዚ ሓሳባዊ ዝመስለኩም ንኡሳን ኢኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu güne gönükdirilen. Uzak möhletli meýilnama düzmäge ýykgyn däl — ýa-da bu entek nazary görünýän ýaly ýaşsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye odaklısın. Uzun vadeli plan yapmaya yatkın değilsin ya da bu sana henüz teorik gelecek kadar gençsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокус на теперішньому. Довгострокове планування — не твоє, або до цього ще так далеко, що все здається теорією."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حال پر توجہ۔ لمبی منصوبہ بندی آپ کی فطرت میں نہیں، یا ابھی عمر ایسی ہے کہ یہ سب نظریاتی لگتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugunga eʼtibor. Uzoq muddatli rejalashtirish sizning tabiatingizda emas — yoki bu siz uchun hali nazariyadek tuyuladigan darajada yoshsiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sống cho hiện tại. Bạn không quen lên kế hoạch dài hạn — hoặc bạn còn đủ trẻ để chuyện này nghe như lý thuyết."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujonge okwangoku. Akwakhelwanga ukucwangcisa kwexesha elide — okanye usemncinci ngokwaneleyo ukuba oku kuvakale njengethiyori nje."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń wo ìsinsìnyí. Ètò ọjọ́ pípẹ́ kì í ṣe tiyín — tàbí ẹ ṣì kéré tó pé èyí dàbí àlá lásán."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活在當下。你天生不愛長遠規劃，又或者你還年輕，這一切感覺仍很抽象。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活在当下。你不太习惯做长远规划，或者你还年轻，这事感觉还很遥远。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你活在當下。你天生不擅長長遠規劃，或者你還年輕，這件事感覺還很遙遠。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugxile kokwamanje. Awakhiwe ukuhlela isikhathi eside — noma usemncane ngokwanele ukuthi lokhu kuzwakale kungumcabango nje."
          }
        }
      }
