    "Love it — the more plans the better" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek’s mal daaroor – hoe meer planne, hoe beter"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እወደዋለሁ — ብዙ ዕቅድ ባለ ቁጥር ይሻላል"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحبها، وكلما كثرت الخطط كان أفضل"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বৰ ভাল পাওঁ — যিমান বেছি পৰিকল্পনা, সিমান ভাল"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çox sevirəm — plan nə qədər çox, bir o qədər yaxşı"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абажаю — чым больш планаў, тым лепш"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обожавам го – колкото повече планове, толкова по-добре"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দারুণ লাগে — যত প্ল্যান, তত ভালো"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obožavam – što više planova, to bolje"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'encanta — com més plans, millor"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miluju to – čím víc plánů, tím líp"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrth fy modd — gorau po fwyaf o gynlluniau"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elsker det – jo flere planer, jo bedre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liebe ich – je mehr Pläne, desto besser"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τις λατρεύω — όσο περισσότερα σχέδια τόσο καλύτερα"
