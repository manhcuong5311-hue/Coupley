        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यावहारिक संतुलन। साझा ज़िम्मेदारी के साथ निजी आज़ादी। ज़्यादातर जोड़ों के लिए यह लंबे समय तक चलता है।"
