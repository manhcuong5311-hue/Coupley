        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokuss uz tagadni. Tālejoša plānošana nav tavā dabā – vai arī tev vēl ir tik maz gadu, ka tas šķiet teorētiski."
