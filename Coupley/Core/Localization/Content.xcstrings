    "The space you live in affects everything — how you rest, socialise, work." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ruimte waarin jy woon, raak alles – hoe jy rus, kuier en werk."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሚኖሩበት ቦታ በሁሉም ነገር ላይ ተጽዕኖ አለው — እንዴት እንደሚያርፉ፣ ከሰዎች ጋር እንደሚገናኙና እንደሚሠሩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكان الذي تعيشون فيه يؤثر في كل شيء: الراحة والحياة الاجتماعية والعمل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি থকা ঠাইখিনিয়ে সকলোতে প্ৰভাৱ পেলায় — আপুনি কেনেকৈ জিৰণি লয়, মানুহৰ লগত মিলে, কাম কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşadığın məkan hər şeyə təsir edir — necə dincəldiyinə, ünsiyyət qurduğuna, işlədiyinə."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месца, дзе ты жывеш, уплывае на ўсё — як ты адпачываеш, бавіш час з людзьмі, працуеш."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространството, в което живееш, влияе на всичко – как почиваш, общуваш, работиш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেখানে থাকো, সেটা সবকিছুর ওপর প্রভাব ফেলে — কীভাবে বিশ্রাম নাও, মেলামেশা করো, কাজ করো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor u kojem živiš utiče na sve – kako se odmaraš, družiš i radiš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'espai on vius ho afecta tot — com descanses, com fas vida social, com treballes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor, kde žiješ, ovlivňuje všechno – jak odpočíváš, trávíš čas s lidmi i pracuješ."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae'r lle rwyt ti'n byw ynddo'n effeithio ar bopeth — sut rwyt ti'n gorffwys, yn cymdeithasu, yn gweithio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sted, du bor, påvirker alt – hvordan du hviler, er social og arbejder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du wohnst, beeinflusst alles – wie du dich erholst, Leute triffst und arbeitest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χώρος όπου ζεις επηρεάζει τα πάντα — πώς ξεκουράζεσαι, πώς βλέπεις κόσμο, πώς δουλεύεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio en el que vives lo afecta todo — cómo descansas, socializas y trabajas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruum, kus elad, mõjutab kõike — kuidas puhkad, suhtled ja töötad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bizi zaren espazioak denean eragiten du: atseden hartzeko, jendea hartzeko, lan egiteko moduan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضایی که در آن زندگی می‌کنی روی همه چیز اثر دارد — اینکه چطور استراحت می‌کنی، معاشرت می‌کنی، کار می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asuintila vaikuttaa kaikkeen – miten lepäät, seurustelet ja teet töitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apektado ng tirahan mo ang lahat — kung paano ka nagpapahinga, nakikisalamuha, nagtatrabaho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton lieu de vie influence tout — ta façon de te reposer, de recevoir, de travailler."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téann an spás ina gcónaíonn tú i bhfeidhm ar gach rud — conas a ligeann tú do scíth, a bhíonn tú sóisialta, a oibríonn tú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espazo no que vives inflúe en todo: en como descansas, te relacionas e traballas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે જ્યાં રહો છો એ જગ્યા બધા પર અસર કરે છે — તમે કેવી રીતે આરામ કરો, લોકોને મળો, કામ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurin da kuke zaune na shafar komai — yadda kuke hutawa, zumunci, aiki."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המקום שבו גרים משפיע על הכול — על המנוחה, על החיים החברתיים, על העבודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस जगह आपका बसेरा है, उसका असर हर चीज़ पर पड़ता है — आराम, मेल-जोल, काम।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor u kojem živiš utječe na sve – kako se odmaraš, družiš i radiš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espas kote ou viv la afekte tout bagay — jan ou repoze, jan ou resevwa moun, jan ou travay."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az a tér, ahol élsz, mindenre hat – arra, hogyan pihensz, hogyan vagy együtt másokkal, hogyan dolgozol."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տարածքը, որտեղ ապրում ես, ազդում է ամեն ինչի վրա՝ ինչպես ես հանգստանում, շփվում, աշխատում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat tinggal memengaruhi segalanya — cara kamu beristirahat, bersosialisasi, dan bekerja."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebe ị bi na-emetụta ihe niile — otu i si ezu ike, nọrọ na ndị mmadụ, rụọ ọrụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rýmið sem þú býrð í hefur áhrif á allt – hvernig þú hvílist, umgengst fólk og vinnur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio in cui vivi influisce su tutto — su come riposi, ricevi gli amici, lavori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住む空間は、休み方や人付き合い、働き方まですべてに影響します。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papan panggonan ngaruhi kabeh — carane panjenengan ngaso, srawung, lan nyambut gawe."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სივრცე, სადაც ცხოვრობ, ყველაფერზე მოქმედებს — როგორ ისვენებ, როგორ ხვდები ხალხს, როგორ მუშაობ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тұратын орның бәріне әсер етеді: қалай демалатыныңа, араласатыныңа, жұмыс істейтініңе."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កន្លែងដែលអ្នករស់នៅប៉ះពាល់ដល់គ្រប់យ៉ាង — របៀបដែលអ្នកសម្រាក ជួបជុំ និងធ្វើការ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ವಾಸಿಸುವ ಸ್ಥಳ ಎಲ್ಲದರ ಮೇಲೂ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ — ನೀವು ಹೇಗೆ ವಿಶ್ರಮಿಸುತ್ತೀರಿ, ಬೆರೆಯುತ್ತೀರಿ, ಕೆಲಸ ಮಾಡುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사는 공간은 쉬는 법, 사람 만나는 법, 일하는 법까지 모든 것에 영향을 줘요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihê ku tu lê dijî bandorê li her tiştî dike — tu çawa bêhna xwe vedidî, bi kesan re dicivî, dixebitî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жашаган жериң баарына таасир этет — кантип эс аларыңа, адамдар менен баарлашканыңа, иштегениңе."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Raum, an deem s de wunns, beaflosst alles — wéi s de raschts, Leit empfänks a schaffs."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບ່ອນທີ່ເຈົ້າອາໄສມີຜົນຕໍ່ທຸກຢ່າງ — ວິທີພັກຜ່ອນ ພົບປະຜູ້ຄົນ ແລະ ເຮັດວຽກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erdvė, kurioje gyveni, veikia viską – kaip ilsiesi, bendrauji, dirbi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieta, kur dzīvo, ietekmē visu – kā tu atpūties, satiecies ar cilvēkiem, strādā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misy fiantraikany amin'ny zava-drehetra ny toerana ipetrahanao — ny fialanao sasatra, ny fiarahanao amin'ny olona, ny asanao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka pā tō wāhi noho ki ngā mea katoa — ki tō okioki, ki tō whakahoahoa, ki tō mahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просторот во кој живееш влијае на сè — како се одмораш, се дружиш, работиш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ താമസിക്കുന്ന ഇടം എല്ലാറ്റിനെയും ബാധിക്കുന്നു — നിങ്ങൾ എങ്ങനെ വിശ്രമിക്കുന്നു, കൂട്ടുകൂടുന്നു, ജോലി ചെയ്യുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амьдардаг орчин чинь бүх юманд нөлөөлдөг — хэрхэн амрах, хүмүүстэй харилцах, ажиллахад."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही राहता ती जागा सगळ्यावर परिणाम करते — तुम्ही कसा आराम करता, लोकांना भेटता, काम करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang tempat anda tinggal mempengaruhi segalanya — cara anda berehat, bersosial dan bekerja."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ispazju fejn tgħix jaffettwa kollox — kif tistrieħ, kif tissoċjalizza, kif taħdem."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေထိုင်ရာ နေရာက အရာအားလုံးကို ထိခိုက်တယ် — အနားယူပုံ၊ လူမှုဆက်ဆံပုံ၊ အလုပ်လုပ်ပုံ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedet du bor, påvirker alt – hvordan du hviler, er sosial og jobber."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं बस्ने ठाउँले सबै कुरामा असर गर्छ — कसरी आराम गर्नुहुन्छ, भेटघाट गर्नुहुन्छ, काम गर्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar je woont, beïnvloedt alles – hoe je rust, mensen ziet en werkt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malo omwe mumakhala amakhudza chilichonse — mmene mumapumulira, kucheza, ndi kugwira ntchito."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakki ati keessa jiraattu waan hunda tuqa — akkaataa ati itti boqottu, namoota wajjin wal argitu, hojjettu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଯେଉଁ ଜାଗାରେ ରହନ୍ତି ତାହା ସବୁକିଛି ଉପରେ ପ୍ରଭାବ ପକାଏ — ଆପଣ କିପରି ଆରାମ କରନ୍ତି, ଲୋକଙ୍କ ସହ ମିଶନ୍ତି, କାମ କରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਿਸ ਥਾਂ ਤੁਸੀਂ ਰਹਿੰਦੇ ਹੋ, ਉਹ ਹਰ ਚੀਜ਼ ਉੱਤੇ ਅਸਰ ਪਾਉਂਦੀ ਹੈ — ਤੁਸੀਂ ਕਿਵੇਂ ਆਰਾਮ ਕਰਦੇ ਹੋ, ਮਿਲਦੇ-ਜੁਲਦੇ ਹੋ, ਕੰਮ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestrzeń, w której mieszkasz, wpływa na wszystko – jak odpoczywasz, spotykasz się z ludźmi, pracujesz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هغه ځای چې پکې ژوند کوئ، پر هر څه اغېز کوي — څنګه آرام کوئ، له خلکو سره ناست پاست کوئ او کار کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lugar onde você mora afeta tudo — como você descansa, recebe gente, trabalha."
