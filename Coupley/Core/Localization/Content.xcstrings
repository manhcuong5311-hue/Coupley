        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voalanjalanja ho azy ianao. Azo inoana fa mora aminao ny miresaka momba ny vola amin'ny ankamaroan'ny olon-tiana."
