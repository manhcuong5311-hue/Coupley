        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі потрібно завершити все словами. Сварка не скінчена, доки обидві сторони не почуті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cần khép lại bằng lời. Cuộc cãi vã chỉ thật sự kết thúc khi cả hai bên đều được thấu hiểu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要通过语言来画上句号。只有双方都被理解了，这次争吵才算真正结束。"
