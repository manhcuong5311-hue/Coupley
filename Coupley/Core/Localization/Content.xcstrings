        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedar tentang asal-usul anda. Bahagian yang indah dan yang sukar dalam kisah anda, kedua-duanya jelas bagi anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taf sew minn fejn ġejt. Kemm il-partijiet tajbin kif ukoll dawk diffiċli tal-istorja tiegħek huma ċari għalik."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ် ဘယ်ကလာလဲဆိုတာ သိမြင်တယ်။ သင့်ဇာတ်လမ်းရဲ့ ကောင်းတဲ့အပိုင်းရော ခက်ခဲတဲ့အပိုင်းရော နှစ်ခုလုံးကို မြင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er bevisst på hvor du kommer fra. Både de gode og de vanskelige delene av historien din er synlige for deg."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफू कहाँबाट आएको भन्नेमा सचेत। तपाईंको कथाका राम्रा र कठिन दुवै पाटा तपाईंलाई प्रस्ट देखिन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je weet goed waar je vandaan komt. Zowel de mooie als de moeilijke kanten van je verhaal zie je helder."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukudzidziwa bwino kumene mwachokera. Mbali zabwino ndi zovuta za nkhani yanu zonse mukuziona."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakka itti dhufte ni beekta. Kutaaleen seenaa keetii gaarii fi ulfaatoon lachuu siif mul'atu."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ କେଉଁଠୁ ଆସିଛନ୍ତି, ସେ ବିଷୟରେ ସଚେତନ। ଆପଣଙ୍କ କାହାଣୀର ଭଲ ଓ କଠିନ ଦୁଇ ଦିଗ ଆପଣଙ୍କୁ ଦିଶେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਜਾਣਦੇ ਹੋ ਕਿ ਤੁਸੀਂ ਕਿੱਥੋਂ ਆਏ ਹੋ। ਤੁਹਾਡੀ ਕਹਾਣੀ ਦੇ ਚੰਗੇ ਅਤੇ ਔਖੇ, ਦੋਵੇਂ ਹਿੱਸੇ ਤੁਹਾਨੂੰ ਸਾਫ਼ ਦਿਸਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadomość własnych korzeni. Widzisz zarówno dobre, jak i trudne strony swojej historii."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په خپلو ریښو ښه پوهېږئ. د خپلې کیسې ښې او سختې برخې دواړه درته ښکاري."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem consciência de onde veio. Enxerga tanto as partes boas quanto as difíceis da sua história."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens consciência de onde vens. Vês tanto as partes boas como as difíceis da tua história."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Știi de unde vii. Vezi limpede atât părțile bune, cât și pe cele grele ale poveștii tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты хорошо понимаешь свои корни. И хорошие, и трудные части твоей истории тебе видны."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzi aho ukomoka. Ibice byiza n'ibigoye by'inkuru yawe byose urabibona."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ආපු තැන ගැන ඔබ හොඳින් දන්නවා. ඔබේ කතාවේ හොඳ කොටසුත් අමාරු කොටසුත් දෙකම ඔබට පේනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieš, odkiaľ pochádzaš. Dobré aj ťažké časti tvojho príbehu sú pre teba viditeľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavedaš se, od kod prihajaš. Vidiš tako lepe kot težke dele svoje zgodbe."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoziva kwawakabva. Zvikamu zvakanaka nezvakaoma zvenyaya yako zvose unozviona."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waad garanaysaa meesha aad ka timid. Qaybaha wanaagsan iyo kuwa adag ee sheekadaadaba waad aragtaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E njeh mirë prej nga vjen. Pjesët e mira dhe të vështira të historisë sate i sheh qartë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаш одакле долазиш. Видиш и лепе и тешке делове своје приче."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadar ti mana anjeun asalna. Bagian anu saé sareng anu hésé tina carita anjeun duanana katingali ku anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har koll på var du kommer ifrån. Både de fina och de svåra delarna av din historia är synliga för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unajitambua kuhusu ulikotoka. Sehemu nzuri na ngumu za hadithi yako zote unaziona."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் எங்கிருந்து வந்தீர்கள் என்பதில் தெளிவு. உங்கள் கதையின் நல்ல பகுதிகளும் கடினமான பகுதிகளும் உங்களுக்குத் தெரிகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఎక్కడి నుంచి వచ్చారో మీకు స్పష్టంగా తెలుసు. మీ కథలోని మంచి భాగాలూ, కష్టమైన భాగాలూ రెండూ మీకు కనిపిస్తాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту медонӣ, ки аз куҷо омадаӣ. Ҳам қисмҳои хуб ва ҳам душвори қиссаат ба ту аён аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรู้ตัวดีว่ามาจากไหน มองเห็นทั้งส่วนที่ดีและส่วนที่ยากในเรื่องราวของตัวเอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካበይ ከም ዝመጻእኩም ትፈልጡ። ጽቡቕን ከቢድን ክፋላት ታሪኽኩም ክልቲኦም ንዓኹም ንጹራት እዮም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nireden gelýändigiňi bilýärsiň. Hekaýaňyň gowy hem kyn taraplaryny görýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nereden geldiğinin farkındasın. Hikâyenin hem güzel hem zor kısımlarını görebiliyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти добре розумієш, звідки походиш. І світлі, і складні сторінки твоєї історії тобі видно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی جڑوں سے آگاہی۔ آپ کی کہانی کے اچھے اور مشکل، دونوں حصے آپ کے سامنے واضح ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qayerdan kelganingizni yaxshi anglaysiz. Hikoyangizning yaxshi ham, ogʻir ham tomonlarini koʻrasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu rõ mình đến từ đâu. Cả những phần tốt đẹp lẫn khó khăn trong câu chuyện của bạn, bạn đều nhìn thấy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazazi apho uvela khona. Iindawo ezintle nezinzima zebali lakho zombini uyazibona."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ mọ ibi tí ẹ ti wá. Apá rere àti apá líle ìtàn yín ni ẹ ń rí méjèèjì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你清楚自己從哪裏來。故事中美好和艱難的部分，你都看得見。"
