    },
    "Connection is your energy source, not time of day. The quality of company matters more than the clock to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرب مصدر طاقتكم، لا ساعات اليوم. جودة الرفقة أهم عندكم من عقارب الساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvým zdrojem energie je blízkost, ne denní doba. Na kvalitní společnosti ti záleží víc než na hodinách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er samværet, der giver dig energi, ikke tidspunktet på dagen. Selskabet betyder mere for dig end uret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Energie kommt aus Verbindung, nicht aus der Uhrzeit. Gute Gesellschaft zählt für dich mehr als die Uhr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πηγή της ενέργειάς σου είναι η επαφή, όχι η ώρα της ημέρας. Η ποιότητα της παρέας μετράει για σένα περισσότερο από το ρολόι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fuente de energía es la conexión, no la hora del día. Para ti, la calidad de la compañía importa más que el reloj."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energianlähteesi on yhteys, ei vuorokaudenaika. Seuran laatu merkitsee sinulle enemmän kuin kello."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksyon ang pinagmumulan ng enerhiya mo, hindi oras ng araw. Mas mahalaga sa’yo ang kalidad ng kasama kaysa sa orasan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le lien qui te donne de l'énergie, pas l'heure. Pour toi, la qualité de la compagnie compte plus que l'horloge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור הוא מקור האנרגיה שלך, לא השעה ביום. בשבילך, איכות החברה חשובה יותר מהשעון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी ऊर्जा का स्रोत जुड़ाव है, दिन का वक़्त नहीं। आपके लिए घड़ी से ज़्यादा साथ की अहमियत है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálad nem a napszak, hanem a kapcsolódás az energiaforrás. A társaság minősége többet számít neked, mint az óra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber energimu adalah kedekatan, bukan jam. Bagimu, dengan siapa kamu menghabiskan waktu lebih penting daripada jam berapa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua fonte di energia è la connessione, non l’ora del giorno. Per te conta più la compagnia giusta che l’orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギー源は時間帯ではなく、人とのつながりです。時計より、誰と過ごすかのほうが大切なのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간대가 아니라 사람과의 연결이 에너지원이에요. 시계보다 누구와 함께하는지가 더 중요하죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan dengan orang lain ialah sumber tenaga anda, bukan waktu. Bagi anda, kualiti teman lebih penting daripada jam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er mennesker som gir deg energi, ikke tidspunktet. Hvem du er sammen med, betyr mer enn hva klokka er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding is je energiebron, niet het tijdstip. Goed gezelschap telt voor jou meer dan de klok."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoim źródłem energii jest bliskość, a nie pora dnia. Liczy się dla ciebie towarzystwo, nie zegar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua fonte de energia é a conexão, não a hora do dia. Para você, a companhia importa mais do que o relógio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sursa ta de energie e conexiunea, nu ora din zi. Pentru tine, compania contează mai mult decât ceasul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой источник энергии — общение, а не время суток. Для тебя важнее, с кем ты, чем который час."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är samvaron som ger dig energi, inte tiden på dygnet. Sällskapet betyder mer för dig än klockan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การได้เชื่อมโยงกับผู้คนคือแหล่งพลังของคุณ ไม่ใช่ช่วงเวลาของวัน สำหรับคุณ คนที่อยู่ด้วยสำคัญกว่าเข็มนาฬิกา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji kaynağın günün saati değil, bağ kurmak. Senin için kiminle olduğun saatten daha önemli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоє джерело енергії — зв’язок, а не час доби. Для тебе якість компанії важливіша за годинник."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối mới là nguồn năng lượng của bạn, chứ không phải thời điểm trong ngày. Với bạn, ở bên ai quan trọng hơn mấy giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的能量来自和人的联结，而不是时间段。对你来说，和谁在一起比几点更重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的能量來源是連結，而不是時間。對你來說，和誰在一起比幾點鐘更重要。"
          }
        }
      }
    },
    "Connection is your therapy. You process best in conversation with people you trust. Your partner is probably part of that circle." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواصل هو علاجك. أفضل معالجة للأمور عندك تكون في الحديث مع الأشخاص الموثوقين لديك، وشريكك على الأرجح من هذه الدائرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvou terapií je blízkost lidí. Nejlíp si věci srovnáš v rozhovoru s lidmi, kterým věříš. Tvůj protějšek k nim nejspíš patří."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fællesskab er din terapi. Du bearbejder bedst i samtale med folk, du stoler på. Din partner er nok en del af den kreds."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung ist deine Therapie. Du verarbeitest am besten im Gespräch mit Menschen, denen du vertraust. Dein Schatz gehört bestimmt dazu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση είναι η θεραπεία σου. Επεξεργάζεσαι καλύτερα τα πράγματα συζητώντας με ανθρώπους που εμπιστεύεσαι. Το ταίρι σου μάλλον ανήκει σε αυτόν τον κύκλο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar es tu terapia. Procesas mejor conversando con gente de confianza. Seguramente tu pareja forma parte de ese círculo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läheiset ihmiset ovat terapiaasi. Käsittelet asioita parhaiten keskustelemalla luotettujen ihmisten kanssa. Kumppanisi kuuluu luultavasti tähän piiriin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksyon ang therapy mo. Pinakamahusay kang nagpoproseso sa pakikipag-usap sa mga taong pinagkakatiwalaan mo. Malamang kasama ang partner mo sa grupong iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien, c'est ta thérapie. Tu y vois plus clair en discutant avec des gens de confiance. L'autre fait sûrement partie de ce cercle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיבור הוא הטיפול שלך. הכי טוב לך לעבד דברים בשיחה עם אנשים שסומכים עליהם. הצד השני כנראה חלק מהמעגל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुड़ाव ही आपकी थेरेपी है। भरोसेमंद लोगों से बातचीत में चीज़ें आपको सबसे अच्छे से समझ आती हैं। आपके पार्टनर शायद उस दायरे का हिस्सा हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolódás a terápiád. Akkor dolgozod fel legjobban a dolgokat, ha olyanokkal beszélgetsz, akikben megbízol. A párod valószínűleg ebbe a körbe tartozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedekatan adalah terapimu. Kamu paling bisa memproses sesuatu lewat obrolan dengan orang yang kamu percaya. Pasanganmu mungkin termasuk di lingkaran itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contatto con gli altri è la tua terapia. Elabori meglio parlando con le persone di cui ti fidi. Il tuo partner probabilmente fa parte di quella cerchia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つながりがセラピーです。信頼できる人との会話で、いちばんうまく気持ちを整理できます。きっとパートナーもその輪の一員です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사람과의 연결이 곧 치유예요. 믿는 사람들과 대화할 때 가장 잘 정리돼요. 연인도 아마 그 안에 있을 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungan ialah terapi anda. Anda paling mudah menghadam sesuatu bila berbual dengan orang yang dipercayai. Pasangan anda mungkin sebahagian daripada lingkungan itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fellesskap er terapien din. Du bearbeider best i samtale med folk du stoler på. Partneren din er nok en del av den kretsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding is jouw therapie. Je verwerkt dingen het best in gesprek met mensen die je vertrouwt. Je partner hoort vast bij die kring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więź to twoja terapia. Najlepiej przetwarzasz emocje w rozmowie z zaufanymi osobami. Twoja druga połówka pewnie należy do tego kręgu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexão é a sua terapia. Você processa melhor conversando com quem confia. Seu amor provavelmente faz parte desse círculo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea e terapia ta. Procesezi cel mai bine vorbind cu oameni în care ai încredere. Partenerul tău face probabil parte din acest cerc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общение — твоя терапия. Лучше всего ты разбираешься в себе в разговоре с теми, кому доверяешь. Партнёр наверняка входит в этот круг."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemenskap är din terapi. Du bearbetar bäst i samtal med människor du litar på. Din partner är nog en del av den kretsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การได้เชื่อมโยงกับผู้คนคือการบำบัดของคุณ คุณคิดได้ดีที่สุดเวลาคุยกับคนที่ไว้ใจ และคนรักก็น่าจะเป็นหนึ่งในนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağ kurmak senin terapin. En iyi, güvendiğin insanlarla konuşarak sindiriyorsun. Partnerin de muhtemelen o çemberin bir parçası."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спілкування — твоя терапія. Найкраще тобі вдається розібратися в розмові з тими, кому довіряєш. Твоя половинка, мабуть, теж у цьому колі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối là liệu pháp của bạn. Bạn gỡ rối tốt nhất khi trò chuyện với người mình tin. Người ấy chắc cũng nằm trong vòng tròn đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "联结就是你的疗愈。和信任的人聊天时，你最能理清思绪。另一半大概也在这个圈子里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人際連結就是你的療癒。和信任的人聊天時，你最能理清思緒。另一半大概也在這個圈子裡。"
          }
        }
      }
    },
