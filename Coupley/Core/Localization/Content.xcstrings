          "stringUnit" : {
            "state" : "translated",
            "value" : "När det inre vädret får ett namn blir det lättare att dela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเอ่ยถึงอารมณ์ออกมา ก็จะเล่าต่อได้ง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruh halinin adını koymak paylaşmayı kolaylaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли «погоду» названо, нею легше поділитися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gọi tên “thời tiết” trong lòng giúp người ấy dễ chia sẻ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把心里的天气说出来，就更容易分享了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替對方點出心情，對方會更容易開口。"
          }
        }
      }
    },
