          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затишна тиша й жодних планів. Така легкість поруч із кимось — справжня ознака близькості."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
