        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhimmi dhuunfaa dhuunfaa ta'ee hafuu qaba. Ifatti qeeqamuun kabaja bu'uuraa cabsuu sitti fakkaata."
