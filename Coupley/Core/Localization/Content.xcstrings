        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သေချာပေါက်ပါ။ ဇာတ်လမ်းတွေ၊ အတွေးအခေါ်တွေကို ချစ်တုန်းပါပဲ — သင့်ဘဝနဲ့ ပိုကိုက်တဲ့ ပုံစံနဲ့ ခံစားနေတာပါ။"
