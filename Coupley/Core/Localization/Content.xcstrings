          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lysene i Tokyo. Morgener i Kyoto. Kirsebærblomster med deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
