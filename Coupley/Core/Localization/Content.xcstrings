        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사랑하는 모든 사람 앞에서 서로를 선택하는 날."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari kita memilih satu sama lain di depan semua orang yang kita sayang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen vi velger hverandre foran alle vi er glade i."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dag waarop we voor elkaar kiezen, met iedereen van wie we houden erbij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień, w którym wybieramy siebie nawzajem przy wszystkich, których kochamy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dia em que nos escolhemos diante de todos que amamos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziua în care ne alegem unul pe altul în fața tuturor celor pe care îi iubim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День, когда мы выбираем друг друга перед всеми, кого любим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen då vi väljer varandra inför alla vi älskar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่เราเลือกกันและกันต่อหน้าทุกคนที่เรารัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevdiğimiz herkesin önünde birbirimizi seçtiğimiz gün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День, коли ми обираємо одне одного перед усіма, кого любимо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày hai đứa chọn nhau trước tất cả những người mình thương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有我们爱的人面前，选择彼此的那一天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有我們愛的人面前，選擇彼此的那一天。"
          }
        }
      }
    },
    "The dream job, completely unconstrained. Even if it feels out of reach." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وظيفة الأحلام بلا أي قيود، حتى لو بدت بعيدة المنال."
