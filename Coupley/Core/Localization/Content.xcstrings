        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிகபட்ச ஆற்றல், அதிகபட்ச சத்தம். புறப்பட்டதை விட நல்ல மனநிலையில்தான் நீங்கள் போய்ச் சேர்வீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "గరిష్ట శక్తి, గరిష్ట వాల్యూమ్. బయల్దేరినప్పటి కంటే మంచి మూడ్‌తో మీరు బహుశా గమ్యం చేరతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қуввати ҳадди аксар, овози ҳадди аксар. Эҳтимол ту бо кайфияти беҳтар аз он ки баромада будӣ, мерасӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พลังเต็มที่ เสียงเต็มที่ คุณคงถึงที่หมายด้วยอารมณ์ดีกว่าตอนออกจากบ้าน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝለዓለ ሓይሊ፣ ዝለዓለ ድምጺ። ካብ ዝወጻእኩምዎ ብዝሓሸ ስምዒት ኢኹም እትበጽሑ ትኾኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iň ýokary güýç, iň ýokary ses. Ýola çykanyňdan has gowy keýp bilen barýansyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum enerji, maksimum ses. Muhtemelen yola çıktığından daha iyi bir ruh haliyle varıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимум енергії, максимум гучності. Мабуть, ти приїжджаєш у кращому настрої, ніж виїжджаєш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوری توانائی، پوری آواز۔ منزل پر پہنچ کر شاید آپ کا موڈ نکلتے وقت سے بہتر ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal quvvat, maksimal ovoz. Ehtimol, manzilga chiqib ketgandagidan yaxshiroq kayfiyatda yetib borasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năng lượng tối đa, âm lượng tối đa. Có lẽ lúc đến nơi bạn còn vui hơn lúc xuất phát."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amandla aphezulu, isandi esiphezulu. Mhlawumbi ufika unemo engcono kunaleyo ubunayo xa uhamba."
