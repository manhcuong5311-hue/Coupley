        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ცვლილებებისა და შესაძლებლობების პერიოდი. შენმა პარტნიორმა ეს წინასწარ უნდა იცოდეს — შემოსავლის, დროისა და ემოციური რესურსის თვალსაზრისით."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзгеріс пен мүмкіндікке толы кезең. Серігің мұның алда екенін білуі керек: табыс, уақыт және эмоциялық күш жағынан."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពេលនៃការប្រែប្រួល និងឱកាសថ្មីៗ។ ដៃគូរបស់អ្នកត្រូវដឹងជាមុន — ទាំងរឿងចំណូល ពេលវេលា និងកម្លាំងចិត្ត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬದಲಾವಣೆ ಮತ್ತು ಸಾಧ್ಯತೆಗಳ ಕಾಲ. ಇದು ಬರುತ್ತಿದೆ ಎಂದು ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ತಿಳಿದಿರಬೇಕು — ಆದಾಯ, ಸಮಯ ಮತ್ತು ಭಾವನಾತ್ಮಕ ಶಕ್ತಿಯ ವಿಷಯದಲ್ಲಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변화와 가능성의 시기예요. 수입, 시간, 마음의 여유 면에서 어떤 일이 다가오는지 연인도 알고 있어야 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demeke tevger û derfetan. Divê hevjînê te zanibe ku ev tê — ji aliyê dahat, dem û enerjiya hestyarî ve."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзгөрүүлөр жана мүмкүнчүлүктөр мезгили. Сүйгөнүң муну алдын ала билиши керек — киреше, убакыт жана эмоционалдык күч жагынан."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eng Zäit vu Wandel a Méiglechkeeten. Däi Schatz muss wëssen, wat op iech zoukënnt — wat Akommes, Zäit an emotional Kraaft ugeet."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຊ່ວງເວລາແຫ່ງການປ່ຽນແປງ ແລະ ຄວາມເປັນໄປໄດ້ ຄູ່ຂອງເຈົ້າຄວນຮູ້ລ່ວງໜ້າ — ທັງເລື່ອງລາຍໄດ້ ເວລາ ແລະ ພະລັງທາງໃຈ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokyčių ir galimybių metas. Tavo antroji pusė turi žinoti, kas laukia – kalbant apie pajamas, laiką ir emocines jėgas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainīgs un iespēju pilns laiks. Tavai otrajai pusei jāzina, kas gaidāms – ienākumu, laika un emocionālo spēku ziņā."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoana fiovana sy fahafahana. Tokony hahafantatra izany mialoha ny olon-tianao — eo amin'ny vola miditra, ny fotoana ary ny hery ara-pihetseham-po."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He wā hurihuri, he wā huatau. Me mōhio tō hoa aroha kei te tata mai tēnei — mō te moni whiwhi, mō te wā, mō tō kaha ā-ngākau hoki."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Период на промени и можности. Твојата половинка треба да знае што доаѓа — во поглед на приходите, времето и емоционалната енергија."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മാറ്റങ്ങളുടെയും സാധ്യതകളുടെയും കാലം. ഇത് വരുന്നുണ്ടെന്ന് നിങ്ങളുടെ പങ്കാളി അറിയണം — വരുമാനം, സമയം, മാനസിക ഊർജം എന്നിവയെയെല്ലാം ഇത് ബാധിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хөдөлгөөн, боломжийн үе. Хань чинь орлого, цаг, сэтгэлийн тэнхээ гээд энэ юу авчрахыг мэдэх хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदल आणि नव्या शक्यतांचा काळ. हे येत आहे, हे तुमच्या जोडीदाराला माहीत असायला हवे — उत्पन्न, वेळ आणि भावनिक ऊर्जा, या सगळ्याच बाबतीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempoh yang penuh perubahan dan kemungkinan. Pasangan anda perlu tahu apa yang bakal tiba — dari segi pendapatan, masa dan ruang emosi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjodu ta' bidla u possibbiltajiet. Għarraf lill-partner tiegħek li dan ġej — f'termini ta' dħul, ħin u enerġija emozzjonali."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပြောင်းအလဲနဲ့ အခွင့်အလမ်းတွေ ပြည့်နေတဲ့ ကာလပါ။ ဝင်ငွေ၊ အချိန်နဲ့ စိတ်ခွန်အားဘက်က ဒါတွေ ရောက်လာတော့မယ်ဆိုတာ သင့်ချစ်သူ သိထားဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En periode med endring og muligheter. Partneren din må vite at dette kommer – når det gjelder inntekt, tid og følelsesmessig overskudd."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उतारचढाव र सम्भावनाको समय। आम्दानी, समय र भावनात्मक क्षमताका हिसाबले के आउँदै छ भन्ने कुरा तपाईंको पार्टनरलाई थाहा हुनुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een periode vol beweging en kansen. Je partner moet weten wat eraan komt – qua inkomen, tijd en emotionele ruimte."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nthawi ya kusintha ndi ya mwayi watsopano. Wokondedwa wanu ayenera kudziwa zimenezi zisanachitike — pa nkhani ya ndalama, nthawi, ndi mphamvu ya mtima."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo jijjiiramaa fi carraa. Kana dursitee jaalallee keetti himuu qabda — galii, yeroo fi humna miiraa ilaalchisee."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିବର୍ତ୍ତନ ଓ ସମ୍ଭାବନାର ଏକ ସମୟ। ଆପଣଙ୍କ ସାଥୀଙ୍କୁ ଏହା ଆଗରୁ ଜାଣିବା ଦରକାର — ଆୟ, ସମୟ ଓ ଭାବନାତ୍ମକ ଶକ୍ତି ଦୃଷ୍ଟିରୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਦਲਾਅ ਅਤੇ ਸੰਭਾਵਨਾਵਾਂ ਦਾ ਦੌਰ। ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਨੂੰ ਪਤਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ ਕਿ ਇਹ ਆ ਰਿਹਾ ਹੈ — ਆਮਦਨ, ਸਮੇਂ ਅਤੇ ਜਜ਼ਬਾਤੀ ਤਾਕਤ, ਤਿੰਨਾਂ ਪੱਖੋਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas zmian i możliwości. Twoja druga połówka musi wiedzieć, co nadchodzi – jeśli chodzi o dochody, czas i emocjonalne zasoby."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د بدلون او امکاناتو دوره. ستاسو ملګری باید پوه شي چې دا راروان دي — د عاید، وخت او احساسي توان له پلوه."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um período de movimento e possibilidades. Seu amor precisa saber o que vem aí — em renda, tempo e energia emocional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um período de mudança e de possibilidades. O teu par precisa de saber o que vem aí — em rendimento, tempo e disponibilidade emocional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perioadă de schimbări și posibilități. Partenerul tău trebuie să știe ce urmează — în privința veniturilor, a timpului și a resurselor emoționale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время перемен и возможностей. Партнёру важно знать об этом заранее — и про доход, и про время, и про эмоциональные силы."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igihe cy'impinduka n'amahirwe. Umukunzi wawe akwiye kubimenya hakiri kare — ku birebana n'amafaranga, igihe n'imbaraga z'umutima."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වෙනස්වීම් සහ අවස්ථා පිරුණු කාලයක්. ආදායම, කාලය සහ හැඟීම් අතින් මොනවා එන්න පුළුවන්ද කියලා ඔබේ සහකරු දැනගන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obdobie zmien a možností. Tvoja polovička by mala vedieť, čo sa blíži – pokiaľ ide o príjem, čas aj emočnú kapacitu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obdobje sprememb in možnosti. Tvoj partner mora vedeti, kaj prihaja – glede dohodka, časa in čustvene energije."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguva yekuchinja nemikana mitsva. Mudiwa wako anofanira kuziva kuti izvi zviri kuuya, maererano nemari, nguva, uye simba remwoyo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xilli is-beddel iyo fursado leh. Waa in lammaanahaaga loo sheegaa in tani soo socoto — xagga dakhliga, waqtiga iyo awoodda dareenka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një periudhë lëvizjesh dhe mundësish. Partneri yt duhet ta dijë se po vjen – për të ardhurat, kohën dhe energjinë emocionale."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Време промена и могућности. Твоја половина треба да зна шта долази — кад је реч о приходима, времену и емотивној снази."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangsa anu pinuh parobahan sareng kasempetan. Pasangan anjeun kedah terang ieu bakal sumping: kana panghasilan, waktos, sareng tanaga émosional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tid av rörelse och möjligheter. Din partner behöver veta vad som väntar – när det gäller inkomst, tid och känslomässig ork."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kipindi cha mabadiliko na fursa. Mwenzi wako anahitaji kujua hili linakuja — kwa upande wa kipato, muda na nguvu za kihisia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாற்றமும் வாய்ப்புகளும் நிறைந்த காலம். இது வருகிறது என்று உங்கள் துணைக்குத் தெரிய வேண்டும் — வருமானம், நேரம், மன ஆற்றல் என எல்லாவற்றிலும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మార్పులు, అవకాశాలతో నిండిన కాలం. ఇది రాబోతోందని మీ భాగస్వామికి తెలియాలి — ఆదాయం, సమయం, భావోద్వేగ శక్తి పరంగా."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давраи тағйирот ва имкониятҳо. Ёрат бояд пешакӣ донад, ки ин ба даромад, вақт ва қуввати рӯҳӣ таъсир мерасонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงเวลาแห่งความไม่แน่นอนและความเป็นไปได้ คนรักควรรู้ว่ากำลังจะเกิดอะไรขึ้น ทั้งเรื่องรายได้ เวลา และพลังใจ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እዋን ምንቅስቓስን ዕድላትን። እዚ ከም ዝመጽእ ንመጻምድኹም ኣፍልጥዎ — ብመንጽር ኣታዊ፣ ግዜን ስምዒታዊ ዓቕምን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üýtgeşmeler we mümkinçilikler döwri. Söýgüliň munuň golaýdygyny bilmeli — girdeji, wagt we duýgy güýji babatda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketli ve olasılıklarla dolu bir dönem. Partnerinin bunun gelir, zaman ve duygusal enerji açısından neler getireceğini bilmesi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Період змін і можливостей. Половинці варто знати, що на неї чекає — щодо доходу, часу й емоційного ресурсу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدلاؤ اور امکانات کا دور۔ آپ کے ساتھی کو اس کا پہلے سے علم ہونا چاہیے، آمدنی، وقت اور جذباتی توانائی، سب کے لحاظ سے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻzgarishlar va imkoniyatlar davri. Sherigingiz bundan oldindan xabardor boʻlishi kerak — daromad, vaqt va hissiy kuch jihatidan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một giai đoạn biến động và đầy khả năng. Người ấy cần biết trước điều sắp tới — về thu nhập, thời gian và sức chứa cảm xúc của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ixesha lokuguquguquka namathuba. Iqabane lakho kufuneka lazi ukuba oku kuyeza — malunga nengeniso, ixesha namandla akho eemvakalelo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àkókò ìyípadà àti àǹfààní ni. Olólùfẹ́ yín nílò láti mọ̀ pé èyí ń bọ̀ — nípa owó tó ń wọlé, àkókò, àti agbára ọkàn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一段充滿變化與可能的時期。另一半需要知道這一切即將到來——無論是收入、時間，還是情緒上的餘裕。"
          }
        },
        "zh-Hans" : {
