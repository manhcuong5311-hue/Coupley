        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "രണ്ടറ്റവും തെറ്റല്ല — പക്ഷേ നിങ്ങൾ എവിടെ നിൽക്കുന്നുവെന്ന് അറിയുന്നത് ഒരു ടീമായി പ്ലാൻ ചെയ്യാൻ സഹായിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аль ч туйл буруу биш — гэхдээ хаана байгаагаа мэдвэл баг шиг төлөвлөхөд тусална."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
