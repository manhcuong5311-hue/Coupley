            "value" : "ಸಂಬಂಧದಲ್ಲಿ ನೀವು ಹೇಗೆ ಚೈತನ್ಯ ಮರಳಿ ಪಡೆಯುತ್ತೀರಿ, ಬೆರೆಯುತ್ತೀರಿ ಮತ್ತು ಎಷ್ಟು ಜಾಗ ಬಯಸುತ್ತೀರಿ ಎಂಬುದರ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지를 채우는 방법, 사람들과 어울리는 방식, 관계 속에서 필요한 혼자만의 공간에 영향을 줘요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev bandorê dike ka tu çawa enerjiya xwe nû dikî, bi kesan re dicivî û di têkiliyê de çiqas cih hewce dikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул мамиледе кантип күч топтооруңа, адамдар менен баарлашканыңа жана жеке мейкиндикке муктаждыгыңа таасир этет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat beaflosst, wéi s de nei Energie tanks, wéi s de Leit begéins a wéi vill Raum s de an enger Bezéiung brauchs."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເລື່ອງນີ້ມີຜົນຕໍ່ວິທີທີ່ເຈົ້າເຕີມພະລັງ ພົບປະຜູ້ຄົນ ແລະ ຕ້ອງການພື້ນທີ່ໃນຄວາມສຳພັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai lemia, kaip atgauni jėgas, bendrauji ir kiek erdvės tau reikia santykiuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ietekmē, kā tu atgūsties, kā socializējies un cik daudz telpas tev attiecībās vajag."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misy fiantraikany amin'ny fomba hamerenanao hery, hiarahanao amin'ny olona ary hilanao toerana ao amin'ny fifandraisana izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka pā tēnei ki tō whakahou i tō kaha, ki tō whakahoahoa, ki tō hiahia ki tētahi wāhi motuhake i roto i te hononga."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова влијае на тоа како се полниш, се дружиш и колку простор ти треба во врска."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബന്ധത്തിൽ നിങ്ങൾ എങ്ങനെ ഊർജം വീണ്ടെടുക്കുന്നു, കൂട്ടുകൂടുന്നു, എത്ര ഇടം വേണം എന്നതിനെയെല്ലാം ഇത് ബാധിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ нь харилцаанд хэрхэн цэнэглэх, хүмүүстэй харилцах, хэр орон зай хэрэгтэйд чинь нөлөөлдөг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही कसे ताजेतवाने होता, लोकांमध्ये कसे मिसळता आणि नात्यात तुम्हाला किती जागा लागते, यावर याचा परिणाम होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mempengaruhi cara anda mengecas semula tenaga, bersosial dan memerlukan ruang dalam hubungan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan jaffettwa kif tiċċarġja, kif tissoċjalizza u kemm għandek bżonn spazju f'relazzjoni."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒါက ဆက်ဆံရေးထဲမှာ အားပြန်ဖြည့်ပုံ၊ လူမှုဆက်ဆံပုံ၊ ကိုယ်ပိုင်နေရာ လိုအပ်ပုံကို သက်ရောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette påvirker hvordan du lader opp, er sosial og trenger rom i et forhold."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सम्बन्धमा तपाईं कसरी ऊर्जा फर्काउनुहुन्छ, भेटघाट गर्नुहुन्छ र कति ठाउँ चाहिन्छ भन्नेमा यसले असर गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bepaalt hoe je oplaadt, met mensen omgaat en hoeveel ruimte je nodig hebt in een relatie."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izi zimakhudza mmene mumapezera mphamvu, mmene mumachezera, ndi malo omwe mumafuna m'chibwenzi."
