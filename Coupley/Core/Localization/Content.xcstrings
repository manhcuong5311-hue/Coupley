        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kì í ṣe nípa iye owó — ẹ̀rí ni pé ẹnìkan rántí yín nígbà tí ẹ kò sí níbẹ̀. Ìrònú nípa yín ni gbogbo kókó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重點從來不是價錢，而是證明你不在身邊時，有人想起你。心意才是一切。"
