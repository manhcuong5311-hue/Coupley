        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effiċjenza. M'għandekx bżonn ritwali biex tiddekompressa — jew normalment l-għeja tkun biżżejjed biex ma jkollokx bżonnhom."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထိရောက်တယ်။ စိတ်အေးဖို့ ဓလေ့တွေ မလိုဘူး — ဒါမှမဟုတ် များသောအားဖြင့် မလိုလောက်အောင် ပင်ပန်းနေတာ ဖြစ်မယ်။"
