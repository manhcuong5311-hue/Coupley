        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ăn uống gì đó cho dễ chịu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃点或喝点安慰自己"
