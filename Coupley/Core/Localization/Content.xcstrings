        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultura doopravdy žije u stolu. Restaurace rezervuješ dřív než letenky, a tak je to správně."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrth y bwrdd mae diwylliant yn byw go iawn. Rwyt ti'n archebu bwytai cyn hediadau, ac mae hynny'n hollol gywir."
