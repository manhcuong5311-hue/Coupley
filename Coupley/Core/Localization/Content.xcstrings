        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইয়াৰ প্ৰভাৱ একেলগে খোৱা, বজাৰ কৰা আৰু বাহিৰত খোৱাত পৰে — জানি থোৱা ভাল।"
