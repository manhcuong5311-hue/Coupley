    "Say it or don't — but don't say it sideways. You'd rather hear something hard than feel tension you can't address." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قولوها أو لا تقولوها، لكن لا تلمّحوا بها. تفضّلون سماع شيء صعب على الشعور بتوتر لا يمكنكم مواجهته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni to, nebo neříkej – ale ne oklikou. Raději uslyšíš něco tvrdého, než nést napětí, se kterým nejde nic dělat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig det, eller lad være – men sig det ikke ad omveje. Du vil hellere høre noget svært end mærke en spænding, du ikke kan tage fat på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag es oder lass es – aber nicht durch die Blume. Du hörst lieber etwas Unangenehmes, als eine Spannung zu spüren, die du nicht ansprechen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες το ή μην το πεις — αλλά όχι πλαγίως. Προτιμάς να ακούσεις κάτι δύσκολο παρά να νιώθεις μια ένταση που δεν μπορείς να συζητήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo o no lo digas, pero sin indirectas. Prefieres escuchar algo difícil antes que sentir una tensión que no puedes resolver."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano tai ole sanomatta – mutta älä sano kiertoteitse. Kuulet mieluummin jotain vaikeaa kuin tunnet jännitettä, johon et voi tarttua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabihin o huwag — pero huwag nang paikot-ikot. Mas gusto mo pang makarinig ng mabigat na bagay kaysa maramdaman ang tensyong hindi mo maharap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-le ou ne le dis pas, mais pas de biais. Tu préfères entendre une vérité difficile que sentir une tension impossible à aborder."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להגיד או לא להגיד — אבל לא מהצד. עדיף לך לשמוע משהו קשה מאשר להרגיש מתח שאי אפשר לגעת בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहना है तो साफ़ कहिए, वरना नहीं — पर घुमा-फिराकर नहीं। जिस तनाव पर बात ही न हो सके, उसे झेलने से अच्छा आपको कोई कड़वी बात सीधे सुन लेना लगता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd ki, vagy ne mondd – de ne kerülőúton. Inkább hallasz valami nehezet, mint hogy olyan feszültséget érezz, amit nem tudsz kezelni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilang atau jangan sama sekali — tapi jangan menyindir. Kamu lebih suka mendengar hal yang berat daripada merasakan ketegangan yang tak bisa dibahas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dillo o non dirlo — ma non dirlo di traverso. Preferisci sentire una cosa difficile piuttosto che percepire una tensione che non puoi affrontare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言うなら言う、言わないなら言わない。遠回しなのが苦手なタイプです。どうにもできない空気より、つらいことでもはっきり聞きたいのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말을 하든 안 하든, 돌려 말하는 건 싫은 타입이에요. 풀 수 없는 긴장감보다 차라리 듣기 힘든 말이 나아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cakap terus atau jangan cakap langsung — tetapi jangan berkias. Anda lebih rela mendengar sesuatu yang pahit daripada merasai ketegangan yang tidak dapat ditangani."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det eller la være – men ikke kom med stikk. Du hører heller noe vanskelig enn å kjenne på en spenning du ikke kan ta tak i."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het of zeg het niet – maar niet via een omweg. Je hoort liever iets moeilijks dan dat je spanning voelt waar je niets mee kunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz albo nie mów – tylko nie półsłówkami. Wolisz usłyszeć coś trudnego niż czuć napięcie, z którym nic nie możesz zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale ou não fale — mas não pelas beiradas. Você prefere ouvir algo difícil a sentir uma tensão que não dá para resolver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ori o spui, ori nu — dar nu pe ocolite. Preferi să auzi ceva greu decât să simți o tensiune pe care n-o poți aborda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи прямо или промолчи, но не намёками. Тебе легче услышать что-то тяжёлое, чем чувствовать напряжение, с которым ничего не сделать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg det eller låt bli – men inte genom pikar och antydningar. Du hör hellre något jobbigt än känner en spänning du inte kan ta tag i."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะพูดก็พูด ไม่พูดก็ไม่ต้อง แต่อย่าพูดอ้อมๆ คุณยอมฟังเรื่องที่ยากดีกว่ารู้สึกถึงความตึงเครียดที่แก้ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya söyle ya söyleme ama lafı dolandırma. Konuşamadığın bir gerginliği hissetmektense zor bir şey duymayı tercih edersin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи прямо або не кажи взагалі — тільки не натяками. Тобі краще почути щось важке, ніж відчувати напругу, з якою нічого не вдієш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói hoặc đừng nói — nhưng đừng nói vòng vo. Bạn thà nghe điều khó nghe còn hơn cảm thấy căng thẳng mà không biết giải quyết thế nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要说就直说，别拐弯抹角。比起无从化解的紧张气氛，你宁愿听到难听的真话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要說就直說，別拐彎抹角。你寧願聽到難聽的真話，也不想感受那種說不出口的緊繃。"
          }
        }
      }
    },
    "Saying it out loud — 'I love you', compliments" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعبير بالكلام: «أحبك» والمديح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Říkám to nahlas – „miluju tě“, komplimenty"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siger det højt – »jeg elsker dig«, komplimenter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut aussprechen – „Ich liebe dich“, Komplimente"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το λέω φωναχτά — «σ' αγαπώ», κομπλιμέντα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diciéndolo en voz alta: “te quiero”, cumplidos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanon sen ääneen – ”rakastan sinua”, kehut"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinasabi talaga — “mahal kita”, mga papuri"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dire à voix haute : « je t'aime », des compliments"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להגיד את זה בקול — מילים של אהבה, מחמאות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलकर — “आई लव यू”, तारीफ़ें"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimondom – „szeretlek”, bókok"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengucapkannya — “aku sayang kamu”, pujian"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicendolo ad alta voce — «ti amo», complimenti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉にする。「大好き」やほめ言葉"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말로 표현하기, “사랑해”나 칭찬"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meluahkannya — ucapan sayang, pujian"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det høyt – «jeg elsker deg», komplimenter"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hardop zeggen – ‘ik hou van je’, complimenten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówię to na głos – „kocham cię”, komplementy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falando — “eu te amo”, elogios"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunând-o cu voce tare — „te iubesc”, complimente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорю вслух — «люблю», комплименты"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säger det högt – ”jag älskar dig”, komplimanger"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดออกมา เช่น “รักนะ” หรือคำชม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkça söylerim: “Seni seviyorum”, iltifatlar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажу вголос — «я тебе кохаю», компліменти"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói thành lời — “mình thương bạn”, lời khen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出来——“我爱你”、夸奖"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出口，「我愛你」、稱讚"
          }
        }
      }
    },
