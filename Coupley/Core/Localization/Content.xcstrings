    "Structured but not overwhelming. You like intentional moments without it feeling like therapy every week." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظيم دون إرهاق. تحبون اللحظات المقصودة دون أن تشعروا بأنها جلسة علاج كل أسبوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řád, ale ne přehnaný. Stojíš o vědomé chvíle, aniž by to každý týden působilo jako terapie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktur, men ikke for meget. Du kan lide bevidste øjeblikke, uden at det føles som terapi hver uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturiert, aber nicht zu viel. Du magst bewusste Momente, ohne dass es sich jede Woche wie Therapie anfühlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με δομή αλλά χωρίς υπερβολές. Σου αρέσουν οι συνειδητές στιγμές, χωρίς να μοιάζει με θεραπεία κάθε εβδομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con estructura, pero sin agobiar. Te gusta reservar momentos para ello sin que parezca terapia cada semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmällistä muttei uuvuttavaa. Pidät tarkoituksellisista hetkistä ilman, että joka viikko tuntuu terapialta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May istruktura pero hindi nakakapagod. Gusto mo ng sinadyang sandali nang hindi parang therapy linggo-linggo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structuré sans être pesant. Tu aimes les moments choisis, sans avoir l'impression d'une séance de thérapie chaque semaine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסודר אבל לא מכביד. רגעים מכוונים מתאימים לך, בלי שזה ירגיש כמו טיפול זוגי כל שבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय ढंग से, पर बोझ बने बिना। आपको सोचे-समझे पल पसंद हैं, लेकिन ऐसा नहीं कि हर हफ़्ते थेरेपी जैसा लगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van rendje, de nem megterhelő. Szereted a tudatos pillanatokat, de nem akarod, hogy minden hét terápiának tűnjön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terstruktur tapi nggak berlebihan. Kamu suka momen yang disengaja tanpa terasa seperti sesi terapi tiap minggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una certa regolarità, senza esagerare. Ti piacciono i momenti intenzionali, senza che sembri una seduta di terapia ogni settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きちんとしつつ、重すぎない。毎週カウンセリングのようになるのは避けつつ、意識的な時間を持ちたいタイプです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체계적이지만 부담스럽지 않게. 매주 상담받는 느낌 없이 의미 있는 순간을 갖고 싶어 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersusun tetapi tidak membebankan. Anda suka saat yang dirancang tanpa terasa seperti sesi terapi setiap minggu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
