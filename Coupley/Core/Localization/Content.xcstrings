    "Love it — the more plans the better" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحبها، وكلما كثرت الخطط كان أفضل"
          }
        },
        "cs" : {
          "stringUnit" : {
