    "This is affecting everything — your mood, your patience, your capacity for connection. Worth treating it as a priority." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يؤثر في كل شيء: مزاجك وصبرك وقدرتك على التواصل. يستحق أن يكون أولوية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovlivňuje to všechno – náladu, trpělivost i schopnost být druhým nablízku. Stojí za to brát to jako prioritu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det påvirker alt – dit humør, din tålmodighed og dit overskud til nærhed. Værd at gøre det til en prioritet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das beeinflusst alles – deine Stimmung, deine Geduld, deine Kraft für Nähe. Es lohnt sich, das ganz oben auf die Liste zu setzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό επηρεάζει τα πάντα — τη διάθεσή σου, την υπομονή σου, την ικανότητά σου να συνδέεσαι. Αξίζει να το βάλεις προτεραιότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto lo afecta todo — tu ánimo, tu paciencia, tu capacidad de conectar. Vale la pena tratarlo como una prioridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vaikuttaa kaikkeen – mielialaasi, kärsivällisyyteesi ja kykyysi olla yhteydessä. Se kannattaa nostaa etusijalle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apektado na nito ang lahat — ang mood mo, pasensya mo, kakayahan mong makipag-ugnayan. Magandang gawin itong priority."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça touche tout — ton humeur, ta patience, ta disponibilité pour l'autre. Ça vaut le coup d'en faire une priorité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה משפיע על הכול — על מצב הרוח, על הסבלנות, על היכולת להתחבר. שווה להתייחס לזה כעדיפות עליונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका असर हर चीज़ पर पड़ रहा है — आपके मूड, आपके सब्र, जुड़ने की आपकी क्षमता पर। इसे प्राथमिकता दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez mindenre kihat – a hangulatodra, a türelmedre, arra, mennyire tudsz kapcsolódni. Érdemes prioritásként kezelni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memengaruhi segalanya — mood, kesabaran, dan kemampuanmu untuk terhubung. Layak dijadikan prioritas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta influendo su tutto — umore, pazienza, capacità di connetterti. Vale la pena trattarlo come una priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分や忍耐力、人とつながる余裕まで、すべてに影響が出ています。優先して取り組む価値があります。"
