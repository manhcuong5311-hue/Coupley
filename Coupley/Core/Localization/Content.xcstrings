          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે સંબંધને સંયુક્ત પ્રોજેક્ટ તરીકે જુઓ છો. મોટા નિર્ણયોમાં તમે બંને સામેલ હો — અને તમને એ જ જોઈએ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna ganin soyayya a matsayin aiki na haɗin gwiwa. Manyan shawarwari sun shafi ku biyu — kuma haka kuke so."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשר בעיניך הוא פרויקט משותף. החלטות גדולות מתקבלות בשניים — וככה בדיוק זה צריך להיות מבחינתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए रिश्ता एक साझा प्रोजेक्ट है। बड़े फ़ैसलों में आप दोनों शामिल हों — आपको यही चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezu vidiš kao zajednički projekt. Velike odluke uključuju oboje – i tako to želiš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou wè relasyon an tankou yon pwojè komen. Gwo desizyon yo konsène nou tou de — e se konsa ou vle l."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolatot közös projektnek látod. A nagy döntéseket ketten hozzátok meg – és te ezt így szeretnéd."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հարաբերությունները քեզ համար համատեղ նախագիծ են։ Կարևոր որոշումները երկուսդ եք կայացնում, և դու հենց դա ես ուզում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu melihat hubungan sebagai proyek bersama. Keputusan besar melibatkan kalian berdua — dan memang begitu yang kamu mau."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-ahụ mmekọrịta ahụ dịka ọrụ unu abụọ. Mkpebi ndị dị ukwuu na-agụnye unu abụọ — otu a ka ị chọrọ ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú lítur á sambandið sem sameiginlegt verkefni. Stórar ákvarðanir varða ykkur bæði – og þannig viltu hafa það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi la relazione come un progetto comune. Le grandi decisioni si prendono in due, ed è così che ti piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係をふたりの共同プロジェクトと考えるタイプ。大きな決断はふたりで。それが理想の形です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan nganggep sesambungan minangka proyek bareng. Keputusan gedhe nglibatake panjenengan sakloron — lan pancen kaya ngono sing dikarepake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ურთიერთობას საერთო პროექტად ხედავ. მნიშვნელოვან გადაწყვეტილებებს ორივე იღებთ — და სწორედ ასე გინდა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қарым-қатынасты ортақ жоба деп көресің. Үлкен шешімдерге екеуің де қатысасыңдар, және сен дәл осылай болғанын қалайсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកមើលឃើញទំនាក់ទំនងជាគម្រោងរួមមួយ។ ការសម្រេចចិត្តធំៗពាក់ព័ន្ធនឹងអ្នកទាំងពីរ — ហើយនោះជាអ្វីដែលអ្នកចង់បាន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಂಬಂಧವನ್ನು ನೀವು ಜಂಟಿ ಯೋಜನೆಯಂತೆ ನೋಡುತ್ತೀರಿ. ದೊಡ್ಡ ನಿರ್ಧಾರಗಳಲ್ಲಿ ನೀವಿಬ್ಬರೂ ಇರುತ್ತೀರಿ — ನಿಮಗೆ ಬೇಕಾಗಿರುವುದೂ ಅದೇ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관계를 함께 만들어 가는 프로젝트로 봐요. 큰 결정은 두 사람이 같이 내리고, 그게 바로 원하는 방식이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu têkiliyê wekî projeyeke hevbeş dibînî. Biryarên mezin her duyan jî digirin nav xwe — û tu wisa dixwazî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мамилени жалпы долбоор катары көрөсүң. Маанилүү чечимдерди экөөң чогуу кабыл аласыңар — сен ушундай болушун каалайсың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir dech ass d'Bezéiung e gemeinsame Projet. Bei grousse Decisioune sidd dir zwee bedeelegt — an esou wëlls du et."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເຫັນຄວາມສຳພັນເປັນໂຄງການຮ່ວມກັນ ການຕັດສິນໃຈເລື່ອງໃຫຍ່ຕ້ອງມີທັງສອງຄົນ — ແລະ ນັ້ນຄືສິ່ງທີ່ເຈົ້າຕ້ອງການ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santykius matai kaip bendrą projektą. Svarbūs sprendimai priimami abiejų – ir taip tu nori."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu attiecības redzi kā kopīgu projektu. Lielos lēmumos piedalāties abi – un tieši tā tu to gribi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikasa iombonana aminao ny fifandraisana. Samy mandray anjara ianareo roa amin'ny fanapahan-kevitra lehibe — ary izany no tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki a koe, he kaupapa ngātahi te hononga. Ko ngā whakatau nui ka uru kōrua tahi — ā, koinā tāu e hiahia ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Врската ја гледаш како заеднички проект. Големите одлуки ги носите заедно — и така сакаш да биде."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബന്ധത്തെ ഒരു സംയുക്ത സംരംഭമായാണ് നിങ്ങൾ കാണുന്നത്. വലിയ തീരുമാനങ്ങൾ നിങ്ങൾ ഇരുവരും ചേർന്നെടുക്കും — നിങ്ങൾ ആഗ്രഹിക്കുന്നതും അങ്ങനെയാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи харилцааг хамтын төсөл гэж хардаг. Том шийдвэрт хоёулаа оролцдог — чи яг ингэхийг хүсдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही नात्याकडे संयुक्त प्रकल्प म्हणून पाहता. मोठे निर्णय तुम्ही दोघे मिळून घेता — आणि तुम्हाला तसेच हवे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda melihat hubungan sebagai projek bersama. Keputusan besar melibatkan anda berdua — dan memang itu yang anda mahukan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tara r-relazzjoni bħala proġett konġunt. Id-deċiżjonijiet il-kbar jinvolvu lit-tnejn li intom — u hekk tridha."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်ဆံရေးကို ပူးတွဲစီမံကိန်းလို မြင်တယ်။ အရေးကြီးတဲ့ ဆုံးဖြတ်ချက်တွေမှာ နှစ်ယောက်လုံး ပါဝင်တယ် — အဲဒါကို သင် လိုလားတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser forholdet som et felles prosjekt. Store avgjørelser tas av dere begge – og det er slik du vil ha det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं सम्बन्धलाई साझा परियोजनाका रूपमा हेर्नुहुन्छ। ठुला निर्णयमा तपाईं दुवैको सहभागिता हुन्छ — र तपाईं यस्तै चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet jullie relatie als een gezamenlijk project. Bij grote beslissingen praten jullie allebei mee – en zo wil je het ook."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumaona chibwenzi ngati ntchito yogwirira limodzi. Zisankho zazikulu zimakhudza nonse awiri — ndipo ndi momwe mukufunira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hariiroo akka pirojektii walootti ilaalta. Murtiiwwan gurguddoon lamaan keessan hirmaachisu — kunis akkuma ati barbaaddu dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ସମ୍ପର୍କକୁ ଏକ ମିଳିତ ପ୍ରୋଜେକ୍ଟ୍ ଭାବେ ଦେଖନ୍ତି। ବଡ଼ ନିଷ୍ପତ୍ତିରେ ଆପଣ ଦୁହେଁ ସାମିଲ ହୁଅନ୍ତି — ଆଉ ଆପଣ ଏହା ହିଁ ଚାହାନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਰਿਸ਼ਤੇ ਨੂੰ ਇੱਕ ਸਾਂਝਾ ਪ੍ਰੋਜੈਕਟ ਮੰਨਦੇ ਹੋ। ਵੱਡੇ ਫ਼ੈਸਲਿਆਂ ਵਿੱਚ ਤੁਸੀਂ ਦੋਵੇਂ ਸ਼ਾਮਲ ਹੁੰਦੇ ਹੋ — ਅਤੇ ਤੁਸੀਂ ਇਹੀ ਚਾਹੁੰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Związek to dla ciebie wspólny projekt. Ważne decyzje podejmujecie razem – i tak właśnie ma być."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو اړیکه د یوې ګډې پروژې په توګه ګورئ. په لویو پرېکړو کې دواړه ګډون کوئ — او تاسو همداسې غواړئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para você, a relação é um projeto a dois. As grandes decisões envolvem os dois — e é assim que você quer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vês a relação como um projeto comum. As grandes decisões envolvem os dois — e é assim que queres."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezi relația ca pe un proiect comun. Deciziile importante le luați împreună — și exact așa îți dorești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для тебя отношения — общий проект. Важные решения вы принимаете вдвоём, и тебе так нравится."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubona urukundo nk'umushinga muhuriyeho. Ibyemezo bikomeye bibareba mwembi — kandi ni ko ubishaka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ සබඳතාව දකින්නේ ඒකාබද්ධ ව්‍යාපෘතියක් විදිහට. ලොකු තීරණ වලට ඔබ දෙදෙනාම සම්බන්ධයි — ඔබට ඕනේත් ඒ විදිහටමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzťah vnímaš ako spoločný projekt. Veľké rozhodnutia sa týkajú vás oboch – a tak to chceš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnos vidiš kot skupen projekt. Velike odločitve sprejemata skupaj – in tako želiš, da je."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unoona ukama sebasa remubatanidzwa. Sarudzo huru dzinosanganisira imi vaviri — uye ndizvo zvaunoda."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriirka waxaad u aragtaa mashruuc wadaag ah. Go'aannada waaweyn labadiinaba ayay idin khuseeyaan — sidaasna waad rabtaa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E sheh lidhjen si një projekt të përbashkët. Vendimet e mëdha i merrni të dy – dhe kështu e do."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Везу видиш као заједнички пројекат. Велике одлуке доносите обоје — и тако желиш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun ningali hubungan salaku proyék babarengan. Kaputusan ageung ngalibetkeun aranjeun duaan, sareng éta anu dipikahoyong."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser relationen som ett gemensamt projekt. Stora beslut tar ni tillsammans – och det är precis så du vill ha det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unauona uhusiano kama mradi wa pamoja. Maamuzi makubwa yanawahusisha nyinyi wawili — na ndivyo unavyotaka."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உறவை ஒரு கூட்டுத் திட்டமாகப் பார்க்கிறீர்கள். பெரிய முடிவுகளில் இருவரும் பங்கேற்க வேண்டும் — அப்படித்தான் நீங்கள் விரும்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ దృష్టిలో బంధం ఒక ఉమ్మడి ప్రాజెక్ట్. పెద్ద నిర్ణయాల్లో మీరిద్దరూ ఉంటారు — మీరు కోరుకునేది అదే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту муносибатро лоиҳаи муштарак мебинӣ. Қарорҳои калон ҳар дуи шуморо дар бар мегиранд — ва ту ҳамин тавр мехоҳӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมองความสัมพันธ์เป็นโปรเจกต์ร่วมกัน การตัดสินใจใหญ่ๆ ต้องมีทั้งสองคน และนั่นคือแบบที่คุณต้องการ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ነቲ ርክብ ከም ናይ ሓባር ፕሮጀክት ትርእይዎ። ዓበይቲ ውሳነታት ንክልቴኹም የጠቓልሉ — ከምኡ ድማ ኢኹም እትደልዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatnaşygy umumy taslama hökmünde görýärsiň. Uly kararlar ikiňize hem degişli — we sen muny şeýle isleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişkiyi ortak bir proje olarak görüyorsun. Büyük kararlar ikinizi de kapsıyor ve sen de bunu istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для тебе стосунки — спільний проєкт. Важливі рішення ви ухвалюєте вдвох, і саме так тобі й хочеться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے لیے رشتہ ایک مشترکہ منصوبہ ہے۔ بڑے فیصلوں میں دونوں شامل ہوتے ہیں، اور آپ کو یہی پسند ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munosabatlarni umumiy loyiha deb bilasiz. Muhim qarorlar ikkalangizga ham tegishli — va siz shuni xohlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn xem mối quan hệ là một dự án chung. Những quyết định lớn đều có cả hai — và bạn muốn đúng như vậy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ububona ubudlelwane njengeprojekthi ehlangeneyo. Izigqibo ezinkulu ziquka nobabini — kwaye ufuna kube njalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń wo ìbáṣepọ̀ bí iṣẹ́ àjùmọ̀ṣe. Àwọn ìpinnu ńlá kan ẹ̀yin méjèèjì — bẹ́ẹ̀ sì ni ẹ fẹ́ ẹ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你把這段感情視為共同的計劃。重大決定要兩個人一起做，而這正是你想要的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你把这段关系看作两个人共同经营的事。大事一起商量，这正是你想要的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你把這段關係看成兩人共同的計畫。重大決定都由你們一起做，而你也希望如此。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubona ubudlelwano njengephrojekthi ehlanganyelwe. Izinqumo ezinkulu zibandakanya nobabili — futhi yilokho okufunayo."
          }
        }
      }
    },
    "You spiral a little and you know it. You need someone to gently ground you in perspective." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy raak bietjie meegesleur en jy weet dit. Jy het iemand nodig wat jou saggies terugbring na die groter prentjie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትንሽ ከመጠን በላይ ማሰብ ይቀናዎታል፣ ይህንንም ያውቃሉ። ነገሮችን በትክክለኛ መጠናቸው እንዲያዩ በእርጋታ የሚያረጋጋዎት ሰው ያስፈልግዎታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تنجرف أفكارك قليلًا، وأنت أدرى بذلك. ما يلزمك شخص يعيدك بلطف إلى المنظور الصحيح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি অলপ বেছিকৈ ভাবি পেলায়, আৰু সেয়া আপুনি জানে। আপোনাক এনে কোনোবা লাগে যিয়ে কোমলভাৱে কথাবোৰ সঠিক দৃষ্টিৰে চাবলৈ সহায় কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir az fikir burulğanına düşürsən və bunu bilirsən. Səni yumşaqlıqla yerə endirib hər şeyi düzgün görməyə kömək edəcək birinə ehtiyacın var."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты трошкі накручваеш сябе — і ведаеш пра гэта. Табе трэба, каб нехта мякка вярнуў цябе да рэальнасці."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понякога се завърташ в мислите си и го знаеш. Трябва ти някой, който нежно да те върне на земята."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি একটু ঘুরপাক খাও, আর সেটা তুমি জানো। তোমার দরকার এমন কাউকে, যে আলতো করে তোমাকে আবার পরিস্থিতিটা পরিষ্কার দেখতে সাহায্য করবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponekad se malo zavrtiš u mislima i znaš to. Treba ti neko ko će te nježno vratiti na zemlju i pomoći ti da stvari vidiš u pravoj mjeri."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendeixes a entrar en espiral i ho saps. Necessites algú que t'ajudi amb suavitat a veure les coses amb perspectiva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochu se v tom umíš zamotat a víš to. Potřebuješ někoho, kdo ti jemně vrátí nadhled."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n troelli ychydig, ac rwyt ti'n gwybod hynny. Mae angen rhywun arnat ti i dy dawelu'n dyner a rhoi pethau mewn persbectif."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kører lidt op, og det ved du godt. Du har brug for nogen, der blidt hjælper dig med at få perspektiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du steigerst dich manchmal rein, und das weißt du. Du brauchst jemanden, der dich sanft wieder auf den Boden holt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρασύρεσαι λίγο και το ξέρεις. Χρειάζεσαι κάποιον να σε επαναφέρει απαλά στη σωστή διάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te agobias un poco y lo sabes. Necesitas a alguien que, con cariño, te devuelva la perspectiva."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa kipud end veidi üles kerima ja tead seda. Sul on vaja kedagi, kes aitaks sul õrnalt asju perspektiivis näha."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixka bat kiribiltzen zara, eta badakizu. Norbait behar duzu gauzak perspektibaz ikusten leunki laguntzeko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمی در فکرها فرو می‌روی و خودت هم این را می‌دانی. به کسی نیاز داری که آرام تو را به زمین و به دیدی درست برگرداند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajatuksesi lähtevät helposti kierteelle, ja tiedät sen. Tarvitset jonkun, joka lempeästi palauttaa mittasuhteet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medyo nag-o-overthink ka, at alam mo ’yon. Kailangan mo ng taong marahang magbabalik sa’yo sa tamang pananaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'emballes un peu et tu le sais. Tu as besoin de quelqu'un qui te ramène en douceur à la réalité."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téann tú beagán ar strae i do smaointe agus tá a fhios agat é. Teastaíonn duine uait a thabharfaidh ar ais go talamh tú go séimh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dás un pouco de voltas ás cousas e sábelo. Necesitas a alguén que, con tenrura, che devolva a perspectiva."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે થોડા વિચારોના વમળમાં ફસાઈ જાઓ છો, અને એ તમે જાણો છો. તમને એવી વ્યક્તિ જોઈએ જે હળવેથી તમને સાચું ચિત્ર બતાવે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukan ɗan nutse cikin damuwa, kuma kun sani. Kuna buƙatar wani da zai dawo da ku cikin natsuwa a hankali, ya nuna muku ainihin girman abin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך נטייה להיסחף קצת, וזה ידוע לך. עוזר לך שמישהו יחזיר אותך בעדינות לפרופורציות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात को बढ़ा-चढ़ाकर सोचने में आपका मन थोड़ा उलझ जाता है, और यह आपको पता है। आपको कोई चाहिए जो प्यार से चीज़ों को सही नज़रिए से दिखाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malo se zavrtiš u mislima i znaš to. Trebaš nekoga tko će te nježno vratiti na zemlju."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou konn kite panse ou pran vitès, e ou konnen sa. Ou bezwen yon moun ki dousman ede ou mete bagay yo nan plas yo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kicsit hajlamos vagy belepörögni, és ezt tudod is. Kell valaki, aki gyengéden visszahoz a földre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու մի քիչ խորանում ես մտքերի մեջ, և գիտես դա։ Քեզ պետք է մեկը, ով մեղմորեն կօգնի տեսնել իրական պատկերը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikiranmu suka sedikit berputar-putar, dan kamu tahu itu. Kamu butuh seseorang yang dengan lembut membantumu melihat dari sudut pandang yang lebih jernih."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uche gị na-agbagharị ntakịrị, ị makwaara ya. Ị chọrọ onye ga-eji nwayọọ mee ka i lee ihe anya nke ọma."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ferð aðeins á flug í huganum og veist af því. Þú þarft einhvern sem hjálpar þér blíðlega að sjá hlutina í samhengi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendi un po’ a farti prendere dal vortice, e lo sai. Ti serve qualcuno che ti riporti con dolcezza alla giusta prospettiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考えすぎてしまう自覚があるタイプです。広い視点に、そっと引き戻してくれる人が必要です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan gampang kebablasan mikir, lan panjenengan ngerti iku. Panjenengan butuh wong sing alon-alon ngajak ndeleng kahanan kanthi wening."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ფიქრებში ცოტა ზედმეტად იხლართები და ეს თავადაც იცი. გჭირდება ვინმე, ვინც ნაზად დაგაბრუნებს მიწაზე და სიტუაციას სხვა კუთხით დაგანახებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен аздап уайымға батып кетесің және оны өзің де білесің. Саған бәрін жұмсақ түрде орнына қоятын біреу керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកងាយគិតច្រើនបន្តិច ហើយអ្នកក៏ដឹងដែរ។ អ្នកត្រូវការនរណាម្នាក់ជួយទាញអ្នកមកមើលរឿងរ៉ាវឲ្យត្រឹមត្រូវវិញដោយទន់ភ្លន់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಸ್ವಲ್ಪ ಅತಿಯಾಗಿ ಯೋಚಿಸುತ್ತೀರಿ, ಅದು ನಿಮಗೂ ಗೊತ್ತು. ನಿಮ್ಮನ್ನು ಮೃದುವಾಗಿ ವಾಸ್ತವಕ್ಕೆ ಮರಳಿ ತರುವವರು ನಿಮಗೆ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각이 꼬리에 꼬리를 무는 편이라는 걸 스스로도 알아요. 다정하게 중심을 잡아 줄 누군가가 필요해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu hinekî di nav ramanan de diçî xwarê û tu vê dizanî. Tu hewceyî kesekî yî ku bi nermî te vegerîne ser erdê."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кээде ойлоруңа батып кетесиң, муну өзүң да билесиң. Сени акырын тынчтандырып, кырдаалды туура көрүүгө жардам берген адам керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du dréins dech heiansdo e bëssen am Krees, an du weess et. Du brauchs een, deen dech sanft erëm op de Buedem bréngt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຄິດວົນໄປວົນມາແດ່ ແລະ ເຈົ້າກໍຮູ້ຕົວ ເຈົ້າຕ້ອງການຄົນທີ່ຄ່ອຍໆ ດຶງເຈົ້າກັບມາເບິ່ງພາບລວມ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartais įsisuki į mintis ir tai žinai. Tau reikia, kad kas nors švelniai padėtų pažvelgti į viską plačiau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mēdz drusku iegrimt domās, un tu to zini. Tev vajag kādu, kas maigi palīdz atgūt perspektīvu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somary mihodinkodina ny eritreritrao ary fantatrao izany. Mila olona hampiverina anao moramora amin'ny fijery marina ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka hurihuri āmaimai koe i ētahi wā, ā, e mōhio ana koe. Me whai koe i tētahi e āta whakatau ana i a koe kia kite anō i te āhua tūturu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малку се вртиш во круг и го знаеш тоа. Ти треба некој нежно да те врати на земја и да ти даде перспектива."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ചിലപ്പോൾ ചിന്തകളിൽ കുരുങ്ങിപ്പോകും, അത് നിങ്ങൾക്കറിയാം. കാര്യങ്ങളെ ശരിയായ കാഴ്ചപ്പാടിൽ കാണാൻ സൗമ്യമായി സഹായിക്കുന്ന ഒരാളെയാണ് നിങ്ങൾക്ക് വേണ്ടത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи жаахан эргэцүүлэн бодож хэтрүүлдэг, өөрөө ч мэднэ. Чамайг зөөлөн тайвшруулж, бодит байдал руу эргүүлэх хүн хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही थोडे अतिविचारात गुरफटता, आणि हे तुम्हाला माहीत आहे. कुणीतरी हळुवारपणे तुम्हाला वास्तवाचे भान आणून द्यावे, असे तुम्हाला वाटते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mudah terlebih fikir dan anda sedar akannya. Anda perlukan seseorang yang lembut membantu anda melihat perkara dengan lebih jelas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultant tinqabad f'ċiklu ta' ħsibijiet, u taf. Għandek bżonn lil xi ħadd li bil-galbu jġibek lura għall-perspettiva."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် စိုးရိမ်စိတ်ထဲ နည်းနည်း နစ်သွားတတ်တယ်ဆိုတာ ကိုယ်တိုင် သိတယ်။ အမြင်မှန်ဆီ ညင်ညင်သာသာ ပြန်ဆွဲခေါ်ပေးမယ့်သူ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spinner deg litt opp, og det vet du. Du trenger noen som forsiktig hjelper deg å se ting i perspektiv."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं अलिअलि चिन्ताको भुमरीमा पर्नुहुन्छ, र यो तपाईंलाई थाहा छ। तपाईंलाई कसैले बिस्तारै यथार्थमा फर्काइदिनु पर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je slaat soms een beetje op hol, en dat weet je. Je hebt iemand nodig die je zacht weer met beide benen op de grond zet."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakonda kutengeka ndi maganizo pang'ono, ndipo mukudziwa. Mumafuna wina wokukhazikitsani mofatsa kuti muone zinthu moyenera."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaadni kee xiqqoo si fudhata, kanas ni beekta. Nama suuta jedhee haala dhugaatti si deebisu barbaadda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଟିକେ ଅଧିକ ଚିନ୍ତାରେ ବୁଡ଼ିଯାଆନ୍ତି ଓ ଆପଣ ଏହା ଜାଣନ୍ତି। ଆପଣଙ୍କୁ ଏମିତି କେହି ଦରକାର, ଯିଏ ଧୀରେ ଆପଣଙ୍କୁ ସଠିକ୍ ଦୃଷ୍ଟିକୋଣକୁ ଫେରାଇ ଆଣିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਕਈ ਵਾਰ ਸੋਚਾਂ ਵਿੱਚ ਉਲਝ ਜਾਂਦੇ ਹੋ, ਅਤੇ ਤੁਹਾਨੂੰ ਇਹ ਪਤਾ ਵੀ ਹੈ। ਤੁਹਾਨੂੰ ਕੋਈ ਚਾਹੀਦਾ ਹੈ ਜੋ ਨਰਮੀ ਨਾਲ ਤੁਹਾਨੂੰ ਗੱਲ ਦਾ ਸਹੀ ਅਕਾਰ ਦਿਖਾਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochę się nakręcasz i dobrze o tym wiesz. Potrzebujesz kogoś, kto łagodnie przywróci ci perspektywę."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لږ په فکرونو کې ډوبېږئ او پخپله پرې پوهېږئ. تاسو یو چا ته اړتیا لرئ چې په نرمۍ مو بېرته حقیقت ته راوګرځوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entra numa espiral às vezes, e sabe disso. Precisa de alguém que, com carinho, te ajude a pôr as coisas em perspectiva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras um pouco em espiral e sabes disso. Precisas de alguém que te devolva a perspetiva com calma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intri puțin în spirală și știi asta. Ai nevoie de cineva care să te readucă blând cu picioarele pe pământ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты слегка накручиваешь себя и знаешь об этом. Тебе нужен кто-то, кто мягко вернёт тебя на землю и поможет взглянуть на всё трезво."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujya ukabya gutekereza gato kandi urabizi. Ukeneye umuntu ugufasha mu bwitonzi kubona ibintu uko biri."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ටිකක් කල්පනාවේ ගිලෙනවා, ඒක ඔබත් දන්නවා. ඔබව මෘදුවෙන් යථාර්ථයට ගෙනෙන කෙනෙක් ඔබට ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občas sa trochu zamotáš do vlastných myšlienok a vieš o tom. Potrebuješ niekoho, kto ti jemne pomôže vidieť veci s nadhľadom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malo se zapleteš v vrtinec misli in to veš. Potrebuješ nekoga, ki ti nežno pomaga videti stvari v pravi luči."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfungwa dzako dzinombotenderera, uye unozviziva. Unoda munhu anokudzosa zvinyoro-nyoro kuti uone zvinhu nemazvo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wax yar baad iska wareertaa, adiguna waad ogtahay. Waxaad u baahan tahay qof si tartiib ah kuu dejiya oo arrinta cabbirkeeda saxda ah kuu tusa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendimet të marrin pak rrëmbimi dhe e di. Të duhet dikush që me butësi të të sjellë sërish në tokë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лако упаднеш у спиралу и знаш то. Треба ти неко ко ће те нежно вратити на земљу и помоћи ти да ствари видиш у правом светлу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikiran anjeun sok rada kamana-mana, sareng anjeun terang éta. Anjeun peryogi jalma anu lemes ngajak anjeun ningali deui ka gambaran anu langkung lega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du snurrar gärna upp dig lite, och du vet om det. Du behöver någon som varsamt hjälper dig se saker i proportion."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mawazo yako huzunguka kidogo, na unajua hilo. Unahitaji mtu wa kukutuliza kwa upole na kukurudishia mtazamo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் கொஞ்சம் அதிகமாக யோசித்துச் சுழல்வீர்கள், அது உங்களுக்கே தெரியும். உங்களை மென்மையாக நிதானப்படுத்தி, சரியான கோணத்தில் பார்க்க வைக்க ஒருவர் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు కొంచెం ఎక్కువగా ఆలోచించి కంగారుపడతారు, అది మీకూ తెలుసు. విషయాన్ని సరైన కోణంలో చూపిస్తూ, మిమ్మల్ని మెల్లగా నిలకడకు తెచ్చే వ్యక్తి మీకు కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту каме дар фикрҳо ғарқ мешавӣ ва инро худат медонӣ. Ба ту касе лозим аст, ки нарм туро ба замин баргардонад ва чизҳоро дар андозаи аслиашон нишон диҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมักคิดวนจนจมดิ่งไปบ้าง และคุณก็รู้ตัว คุณต้องการใครสักคนที่ค่อยๆ ดึงคุณกลับมามองภาพรวม"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቁሩብ ኣብ ሓሳባት ትጥሕሉ ኢኹም፣ ንሱ ድማ ትፈልጥዎ። ብልስሉስ ናብ ሚዛን ዝመልሰኩም ሰብ የድልየኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz aşa pikire batýarsyň we muny bilýärsiň. Saňa seni ýuwaşlyk bilen ýere düşürip, zatlary dogry görmäge kömek edýän biri gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olayları biraz kafanda büyütüyorsun ve bunun farkındasın. Ayaklarını nazikçe yere bastıracak birine ihtiyacın var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти трохи накручуєш себе — і знаєш це. Тобі потрібен хтось, хто м’яко поверне тебе до реальності."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کبھی کبھی خیالات کا بھنور آپ کو گھیر لیتا ہے، اور آپ کو اس کا اندازہ بھی ہے۔ آپ کو کسی ایسے کی ضرورت ہے جو نرمی سے آپ کو حقیقت کی طرف واپس لے آئے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz oʻylab-oʻylab biroz berilib ketasiz va buni oʻzingiz ham bilasiz. Sizni muloyimlik bilan yerga qaytarib, vaziyatga toʻgʻri qarashga yordam beradigan odam kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hay nghĩ quẩn một chút và bạn biết điều đó. Bạn cần ai đó nhẹ nhàng giúp mình nhìn mọi chuyện đúng mức."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazityhutyha kancinci kwaye uyazi. Ufuna umntu okubuyisela ngobunono ekuboneni izinto njengoko zinjalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọkàn yín máa ń ru sókè díẹ̀, ẹ sì mọ̀ bẹ́ẹ̀. Ẹ nílò ẹnì kan tí yóò fi pẹ̀lẹ́ mú yín padà wo nǹkan bó ṣe rí gan-an."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道自己有時會越想越鑽牛角尖。你需要有人溫柔地把你拉回來，讓你看清全局。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会有点钻牛角尖，自己也知道。你需要有人温柔地把你拉回来，看清全局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有時會想太多，而且你自己也知道。你需要有人溫柔地把你拉回現實。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucabanga ngokweqile kancane futhi uyakwazi lokho. Udinga umuntu ozokubuyisela emqondweni ophilile ngobumnene."
          }
        }
      }
    },
    "You think in terms of growth. Money sitting still makes you restless. A good counterbalance to a partner who prioritises security." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy dink in terme van groei. Geld wat net lê, maak jou rusteloos. ’n Goeie teenwig vir ’n maat wat sekuriteit eerste stel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዕድገት ያስባሉ። ዝም ብሎ የተቀመጠ ገንዘብ ያቅበጠብጥዎታል። ደህንነትን ለሚያስቀድም አጋር ጥሩ ሚዛን ነዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفكرون بمنطق النمو، والمال الراكد يقلقكم. أنتم توازن جيد لشريك يمنح الأولوية للأمان."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি বৃদ্ধিৰ কথা ভাবে। টকা থমকি থাকিলে আপুনি অস্থিৰ হয়। নিৰাপত্তাক অগ্ৰাধিকাৰ দিয়া সংগীৰ বাবে এয়া এক ভাল ভাৰসাম্য।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyümə baxımından düşünürsən. Pulun boş dayanması səni narahat edir. Təhlükəsizliyə üstünlük verən partnyor üçün yaxşı tarazlıqdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты думаеш катэгорыямі росту. Грошы, што ляжаць без руху, не даюць табе спакою. Добрая процівага палавінцы, для якой галоўнае — стабільнасць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мислиш в посока растеж. Парите, които стоят без работа, не ти дават покой. Добра противотежест на половинка, която поставя сигурността на първо място."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি বৃদ্ধির হিসেবে ভাবো। টাকা অলস পড়ে থাকলে তুমি অস্থির হও। যে পার্টনার নিরাপত্তাকে আগে রাখে, তার সাথে এটা ভালো ভারসাম্য।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razmišljaš u smislu rasta. Novac koji samo stoji čini te nemirnim. Dobra protuteža voljenoj osobi kojoj je prioritet sigurnost."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penses en termes de creixement. Els diners aturats et neguitegen. Un bon contrapès per a una parella que prioritza la seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přemýšlíš v kategoriích růstu. Peníze, které jen leží, tě znervózňují. Dobrá protiváha k protějšku, pro kterého je na prvním místě jistota."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n meddwl yn nhermau twf. Mae arian sy'n segur yn dy wneud yn aflonydd. Gwrthbwys da i bartner sy'n rhoi blaenoriaeth i sicrwydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tænker i vækst. Penge, der bare ligger stille, gør dig rastløs. En god modvægt til en partner, der prioriterer tryghed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du denkst in Wachstum. Geld, das einfach rumliegt, macht dich unruhig. Ein gutes Gegengewicht zu jemandem, dem Sicherheit vorgeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκέφτεσαι με όρους ανάπτυξης. Τα λεφτά που μένουν ακίνητα σού φέρνουν ανησυχία. Καλό αντίβαρο σε ένα ταίρι που βάζει πρώτα την ασφάλεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensas en términos de crecimiento. El dinero parado te inquieta. Es un buen contrapeso para una pareja que prioriza la seguridad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa mõtled kasvu peale. Paigal seisev raha teeb sind rahutuks. Hea vastukaal partnerile, kes seab esikohale turvalisuse."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazkundean pentsatzen duzu. Geldirik dagoen diruak urduri jartzen zaitu. Oreka ona da segurtasuna lehenesten duen bikotekide batentzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با زبان رشد فکر می‌کنی. پولِ بی‌حرکت بی‌قرارت می‌کند. وزنهٔ تعادل خوبی برای پارتنری هستی که امنیت را در اولویت می‌گذارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajattelet kasvun kautta. Paikallaan makaava raha tekee sinut levottomaksi. Hyvä vastapaino kumppanille, joka asettaa turvallisuuden etusijalle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paglago ang iniisip mo. Hindi ka mapakali kapag nakatengga lang ang pera. Magandang pambalanse ito sa partner na inuuna ang seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu penses en termes de croissance. L'argent qui dort t'impatiente. Un bon contrepoids pour quelqu'un qui privilégie la sécurité."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaoiníonn tú i dtéarmaí fáis. Cuireann airgead díomhaoin míshuaimhneas ort. Frithmheáchan maith le páirtí a thugann tús áite don tslándáil."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensas en termos de crecemento. Os cartos parados inquédante. Un bo contrapeso para unha parella que prioriza a seguridade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે વૃદ્ધિના સંદર્ભમાં વિચારો છો. પડ્યા રહેતા પૈસા તમને બેચેન કરે છે. સલામતીને પ્રાધાન્ય આપતા પાર્ટનર માટે તમે સારું સંતુલન છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna tunani ta fuskar haɓaka. Kuɗin da ke zaune kawai na hana ku nutsuwa. Daidaito mai kyau ga abokin zama mai fifita tsaro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצלך חושבים במונחים של צמיחה. כסף שעומד במקום לא נותן לך מנוחה. איזון טוב מול מי שמעדיף ביטחון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बढ़त के हिसाब से सोचते हैं। पड़ा हुआ पैसा आपको बेचैन करता है। सुरक्षा को पहले रखने वाले पार्टनर के लिए आप अच्छा संतुलन हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razmišljaš u smislu rasta. Novac koji miruje ne da ti mira. Dobra protuteža voljenoj osobi kojoj je sigurnost na prvom mjestu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou panse an tèm kwasans. Lajan ki chita san fè anyen fè ou enpasyan. Se yon bon kontrepwa pou yon patnè ki bay sekirite priyorite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növekedésben gondolkodsz. Az álló pénz nyugtalanít. Jó ellensúly vagy, ha a párod a biztonságot helyezi előtérbe."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու մտածում ես աճի տեսանկյունից։ Անշարժ փողը քեզ հանգիստ չի տալիս։ Լավ հակակշիռ՝ ապահովությունն առաջնային համարող զուգընկերոջ համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu berpikir soal pertumbuhan. Uang yang diam bikin kamu gelisah. Penyeimbang yang pas untuk pasangan yang mengutamakan rasa aman."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eche maka uto. Ego na-anọ otu ebe na-eme ka ahụ ghara izu gị ike. Ọ bụ ezigbo nguzozi nye onye gị nke na-ebute nchekwa ụzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú hugsar í vexti. Peningar sem liggja óhreyfðir valda þér óþreyju. Gott mótvægi við maka sem setur öryggið í forgang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ragioni in termini di crescita. I soldi fermi ti mettono addosso una certa smania. Un buon contrappeso per un partner che punta sulla sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長という視点で考えるタイプです。お金を眠らせておくと落ち着きません。安定を重視するパートナーとはいいバランスです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan mikir bab ngrembakakake. Dhuwit sing mung meneng nggawe panjenengan ora tenang. Imbangan sing apik kanggo pasangan sing ngutamakake rasa aman."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზრდის კატეგორიებით ფიქრობ. უმოქმედო ფული მოუსვენრობას გიჩენს. კარგი საპირწონე ხარ პარტნიორისთვის, რომელიც უსაფრთხოებას ანიჭებს უპირატესობას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен өсім тұрғысынан ойлайсың. Бір орында тұрған ақша сені мазалайды. Қауіпсіздікті бірінші қоятын серікке жақсы тепе-теңдік."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកគិតពីការរីកចម្រើន។ លុយដែលនៅស្ងៀមធ្វើឲ្យអ្នកអន្ទះសារ។ ជាតុល្យភាពល្អសម្រាប់ដៃគូដែលផ្ដល់អាទិភាពលើសុវត្ថិភាព។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಬೆಳವಣಿಗೆಯ ದೃಷ್ಟಿಯಿಂದ ಯೋಚಿಸುತ್ತೀರಿ. ಸುಮ್ಮನೆ ಕುಳಿತ ಹಣ ನಿಮ್ಮನ್ನು ಚಡಪಡಿಸುವಂತೆ ಮಾಡುತ್ತದೆ. ಭದ್ರತೆಗೆ ಆದ್ಯತೆ ಕೊಡುವ ಸಂಗಾತಿಗೆ ಇದು ಒಳ್ಳೆಯ ಸಮತೋಲನ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성장의 관점에서 생각해요. 가만히 있는 돈을 보면 마음이 근질근질하죠. 안정을 중시하는 연인과 좋은 균형을 이룰 수 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu li gorî mezinbûnê difikirî. Pereyên ku bê kar dimînin te bêhedan dikin. Heke hevjînê te ewlehiyê li pêş digire, tu hevsengiyeke baş î."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сен өсүү жагынан ойлойсуң. Кыймылсыз жаткан акча сени тынчсыздандырат. Коопсуздукту биринчи койгон сүйгөнүң үчүн жакшы тең салмак."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du denks u Wuesstem. Geld, dat just do läit, mécht dech onrouegg. E gudde Géigepol fir e Schatz, fir deen Sécherheet un éischter Stell kënnt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຄິດໃນແງ່ການເຕີບໂຕ ເງິນທີ່ຢູ່ນິ່ງໆເຮັດໃຫ້ເຈົ້າບໍ່ສະບາຍໃຈ ເຈົ້າຊ່ວຍຖ່ວງດຸນໄດ້ດີກັບຄູ່ທີ່ໃຫ້ຄວາມສຳຄັນກັບຄວາມໝັ້ນຄົງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mąstai augimo kategorijomis. Nejudantys pinigai tau neduoda ramybės. Gera atsvara antrajai pusei, kuriai svarbiausias saugumas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu domā par izaugsmi. Nauda, kas stāv uz vietas, tevi nemierina. Labs pretsvars otrai pusei, kurai svarīgāka ir drošība."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mieritreritra amin'ny fitomboana ianao. Ny vola tsy mihetsika dia mampisalasala anao. Mandanjalanja tsara ny olon-tiana manome laharana ny filaminana izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka whakaaro koe mō te tipu. Ka koekoe koe ina noho noa te moni. He taurite pai ki tētahi hoa aroha e whakaarotau ana i te haumaru."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размислуваш во рамки на раст. Парите што мируваат не ти даваат мир. Добра противтежа на половинка на која ѝ е приоритет сигурноста."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വളർച്ചയുടെ ഭാഷയിലാണ് നിങ്ങൾ ചിന്തിക്കുന്നത്. വെറുതെ കിടക്കുന്ന പണം നിങ്ങളെ അസ്വസ്ഥരാക്കും. സുരക്ഷിതത്വത്തിന് മുൻഗണന നൽകുന്ന ഒരു പങ്കാളിക്ക് നല്ലൊരു മറുതൂക്കമാണ് നിങ്ങൾ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи өсөлтийн талаас боддог. Хөдөлгөөнгүй хэвтэх мөнгө чамайг тайван бус болгодог. Аюулгүй байдлыг эрхэмлэдэг ханьд сайн тэнцвэр."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही वाढीच्या भाषेत विचार करता. पडून राहिलेला पैसा तुम्हाला अस्वस्थ करतो. सुरक्षिततेला प्राधान्य देणाऱ्या जोडीदारासाठी तुम्ही छान समतोल आहात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda berfikir tentang pertumbuhan. Wang yang tidak bergerak membuatkan anda resah. Pengimbang yang baik untuk pasangan yang mengutamakan kestabilan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taħseb f'termini ta' tkabbir. Il-flus wieqfa jqanqluk. Bilanċ tajjeb għal partner li jagħti prijorità lis-sigurtà."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် တိုးပွားမှုဘက်က တွေးတယ်။ ငွေ ငြိမ်နေတာက သင့်ကို မငြိမ်မသက် ဖြစ်စေတယ်။ လုံခြုံမှုကို ဦးစားပေးတဲ့ ချစ်သူအတွက် ကောင်းတဲ့ ချိန်ခွင်လျှာပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tenker i vekst. Penger som står stille, gjør deg rastløs. En fin motvekt til en partner som prioriterer trygghet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं वृद्धिको हिसाबले सोच्नुहुन्छ। पैसा थन्किएर बस्दा तपाईं बेचैन हुनुहुन्छ। सुरक्षालाई प्राथमिकता दिने पार्टनरसँग यो राम्रो सन्तुलन हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij denkt in groei. Geld dat stilstaat maakt je onrustig. Een goed tegenwicht voor een partner die zekerheid voorop zet."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumaganizira za kukula. Ndalama zongokhala zimakusowetsani mtendere. Ndinu oyenerana bwino ndi wokondedwa amene amaika chitetezo patsogolo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guddina irratti yaadda. Maallaqni osoo hin sochoone taa'u si dhiphisa. Jaalallee nageenya dursa kennuuf madaala gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ବୃଦ୍ଧି ଭାଷାରେ ଭାବନ୍ତି। ଟଙ୍କା ପଡ଼ି ରହିଲେ ଆପଣ ଅସ୍ଥିର ହୁଅନ୍ତି। ସୁରକ୍ଷାକୁ ପ୍ରାଥମିକତା ଦେଉଥିବା ସାଥୀଙ୍କ ପାଇଁ ଏହା ଏକ ଭଲ ସନ୍ତୁଳନ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਵਾਧੇ ਦੇ ਹਿਸਾਬ ਨਾਲ ਸੋਚਦੇ ਹੋ। ਵਿਹਲਾ ਪਿਆ ਪੈਸਾ ਤੁਹਾਨੂੰ ਬੇਚੈਨ ਕਰਦਾ ਹੈ। ਸੁਰੱਖਿਆ ਨੂੰ ਪਹਿਲ ਦੇਣ ਵਾਲੇ ਪਾਰਟਨਰ ਲਈ ਇਹ ਵਧੀਆ ਸੰਤੁਲਨ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myślisz w kategoriach wzrostu. Pieniądze leżące bezczynnie nie dają ci spokoju. Dobra przeciwwaga dla drugiej połówki, która stawia na bezpieczeństwo."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو د ودې په ژبه فکر کوئ. ولاړې پیسې تاسو ته آرام نه درکوي. د داسې ملګري لپاره ښه انډول چې خوندیتوب ته لومړیتوب ورکوي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pensa em crescimento. Dinheiro parado tira seu sossego. Um bom contrapeso para um amor que prioriza segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensas em termos de crescimento. Dinheiro parado dá-te inquietação. Um bom contrapeso para um par que dá prioridade à segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gândești în termeni de creștere. Banii care stau pe loc te neliniștesc. O bună contrapondere pentru un partener care pune siguranța pe primul loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты мыслишь категориями роста. Деньги без дела тебя тревожат. Хороший противовес партнёру, для которого важнее безопасность."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utekereza mu buryo bw'iterambere. Amafaranga adakora agutera kudatuza. Uringaniza neza umukunzi ushyira imbere umutekano."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ හිතන්නේ වර්ධනය ගැන. මුදල් නිකන් තියෙනකොට ඔබට නොසන්සුන් බවක් දැනෙනවා. ආරක්ෂාවට ප්‍රමුඛත්වය දෙන සහකරුවෙක්ට හොඳ සමබරතාවක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myslíš v kategóriách rastu. Peniaze, ktoré len ležia, ťa znepokojujú. Dobrá protiváha k polovičke, ktorá uprednostňuje istotu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razmišljaš v smeri rasti. Denar, ki miruje, ti ne da miru. Dobra protiutež partnerju, ki daje prednost varnosti."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unofunga nezvekukura. Mari yakangomira inokunetsa. Uri kuenzanisa kwakanaka kumudiwa anoisa kuchengeteka pekutanga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad ka fekertaa kobac. Lacag fadhida ayaa ku ciriiriya. Waa dheelitir wanaagsan oo loogu talagalay lammaane mudnaanta siiya ammaanka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti mendon në terma rritjeje. Paratë që rrinë në vend të shqetësojnë. Një kundërpeshë e mirë për një partner që i jep përparësi sigurisë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размишљаш у смислу раста. Новац који мирује те чини немирним. Добра противтежа половини којој је сигурност на првом месту."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun mikir dina hal kamekaran. Artos anu cicing waé ngajantenkeun anjeun gelisah. Panyaimbang anu saé pikeun pasangan anu ngutamakeun kaamanan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tänker i tillväxt. Pengar som står still gör dig rastlös. En bra motvikt till en partner som prioriterar trygghet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unafikiri kwa mtazamo wa ukuaji. Pesa iliyokaa tu inakukosesha utulivu. Unamsawazisha vizuri mwenzi anayetanguliza usalama."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வளர்ச்சியின் கோணத்தில் யோசிக்கிறீர்கள். சும்மா கிடக்கும் பணம் உங்களை அமைதியிழக்கச் செய்யும். பாதுகாப்புக்கு முன்னுரிமை தரும் துணைக்கு நீங்கள் நல்ல சமநிலை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఎదుగుదల పరంగా ఆలోచిస్తారు. డబ్బు కదలకుండా ఉంటే మీకు అశాంతిగా ఉంటుంది. భద్రతకు ప్రాధాన్యం ఇచ్చే భాగస్వామికి ఇది మంచి సమతుల్యత."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар бораи афзоиш фикр мекунӣ. Пули бекорхобида туро ноором мекунад. Мувозинати хуб барои ёре, ки амниятро афзал медонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคิดในแง่ของการเติบโต เงินที่อยู่นิ่งๆ ทำให้คุณอยู่ไม่สุข เป็นตัวถ่วงดุลที่ดีกับคนรักที่ให้ความสำคัญกับความมั่นคง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብመንጽር ዕቤት ትሓስቡ። ስቕ ኢሉ ዝጸንሕ ገንዘብ የጨንቐኩም። ንውሕስነት ቀዳምነት ዝህብ መጻምዲ ጽቡቕ ሚዛን ኢኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen ösüş barada pikir edýärsiň. Bir ýerde ýatan pul seni biynjalyk edýär. Howpsuzlygy öňe goýýan söýgüli üçin gowy deňagramlylyk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyüme odaklı düşünüyorsun. Duran para seni huzursuz ediyor. Güvenliği önceleyen bir partner için iyi bir denge unsurusun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти мислиш категоріями зростання. Гроші, що просто лежать, тебе непокоять. Гарна противага половинці, для якої головне — безпека."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی سوچ ترقی کے حساب سے چلتی ہے۔ رکا ہوا پیسہ آپ کو بے چین کرتا ہے۔ تحفظ کو ترجیح دینے والے ساتھی کے لیے آپ اچھا توازن ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz oʻsish nuqtai nazaridan fikrlaysiz. Bir joyda turgan pul sizni bezovta qiladi. Xavfsizlikni ustun qoʻyadigan sherik uchun yaxshi muvozanat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nghĩ theo hướng sinh lời. Tiền nằm im khiến bạn sốt ruột. Một đối trọng tốt cho người ấy nếu người ấy ưu tiên sự an toàn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucinga ngokukhula. Imali emi nje ikwenza ungazoli. Ulungelelanisa kakuhle iqabane elibeka phambili ukhuseleko."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń ronú nípa ìdàgbàsókè. Owó tó dúró jẹ́ẹ́ máa ń kó àìbalẹ̀ bá yín. Ẹ jẹ́ ìwọ̀ntúnwọ̀nsì tó dára fún olólùfẹ́ tó fi ààbò ṣáájú."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你習慣想著怎樣讓錢增值，錢放著不動會令你坐立不安。和重視安全感的另一半正好互補。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你习惯从增长的角度思考，钱放着不动会让你坐不住。正好能和看重安全感的另一半互补。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你習慣想著怎麼讓錢成長，錢放著不動會讓你坐立難安。和重視安全感的另一半剛好互補。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucabanga ngokukhula. Imali emile ikwenza ungazinzi. Ulinganisa kahle nomlingani obeka phambili ukuvikeleka."
          }
        }
      }
    },
    "You thrive in the unplanned. Rigid schedules feel like a cage. A partner who over-plans might slow you down — or ground you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy floreer in die onbeplande. Streng skedules voel soos ’n hok. ’n Maat wat oorbeplan, kan jou afrem – of jou gegrond hou."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባልታቀደ ነገር ውስጥ ይለመልማሉ። ጥብቅ መርሐ ግብሮች እንደ ጎጆ ይሰማዎታል። ከልክ በላይ የሚያቅዱ አጋር ሊያዘገዩዎት ይችላሉ — ወይም ሊያረጋጉዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تزدهرون في غير المخطط له، والجداول الصارمة تبدو لكم كالقفص. شريك يفرط في التخطيط قد يبطئكم، أو يمنحكم الثبات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিকল্পনা নোহোৱাকৈয়ে আপুনি ফুলি উঠে। কঠোৰ সময়সূচী আপোনাৰ বাবে পিঞ্জৰা যেন। বেছি পৰিকল্পনা কৰা সংগী এজনে আপোনাক লেহেমীয়া কৰিব পাৰে — বা মাটিত ভৰি থৈ ৰাখিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plansız anlarda çiçəklənirsən. Sərt cədvəllər qəfəs kimi gəlir. Hər şeyi planlayan partnyor səni ləngidə bilər — ya da ayaqlarını yerə basdıra bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе добра без планаў. Жорсткі расклад — як клетка. Палавінка, якая ўсё плануе, можа стрымліваць цябе — або даваць апору."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процъфтяваш в непланираното. Строгите графици ти приличат на клетка. Половинка, която планира прекалено много, може да те забави – или да те заземи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিকল্পনা ছাড়াই তুমি সবচেয়ে ভালো থাকো। কড়া রুটিন খাঁচার মতো লাগে। বেশি পরিকল্পনা করা পার্টনার তোমার গতি কমাতে পারে — বা তোমাকে স্থির রাখতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cvjetaš u neplaniranom. Krut raspored ti djeluje kao kavez. Voljena osoba koja sve previše planira može te usporiti – ili prizemljiti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sents com peix a l'aigua en allò no planificat. Els horaris rígids són una gàbia. Una parella que ho planifiqui tot et pot frenar — o donar-te estabilitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daří se ti v neplánovaném. Pevný rozvrh ti připadá jako klec. Protějšek, který všechno plánuje, tě může brzdit – nebo ukotvit."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n ffynnu pan nad oes cynllun. Mae amserlenni caeth yn teimlo fel cawell. Gallai partner sy'n gor-gynllunio dy arafu — neu dy sadio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trives med det uplanlagte. Faste skemaer føles som et bur. En partner, der planlægger alt, kan bremse dig – eller give dig jordforbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blühst im Ungeplanten auf. Starre Pläne fühlen sich wie ein Käfig an. Wer alles verplant, bremst dich vielleicht – oder erdet dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανθίζεις στο απρογραμμάτιστο. Τα αυστηρά προγράμματα σε πνίγουν σαν κλουβί. Ένα ταίρι που τα σχεδιάζει όλα μπορεί να σε φρενάρει — ή να σε προσγειώνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo improvisado te da vida. Los horarios rígidos te parecen una jaula. Alguien que lo planifica todo podría frenarte… o darte equilibrio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Õitsed planeerimatus. Jäigad graafikud tunduvad puurina. Üleplaneeriv partner võib sind pidurdada — või maa peal hoida."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurrez pentsatu gabekoan loratzen zara. Ordutegi zurrunak kaiola dira zuretzat. Gehiegi planifikatzen duen bikotekide batek moteldu zaitzake… edo lurrean jarri."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در برنامه‌ریزی‌نشده‌ها شکوفا می‌شوی. برنامه‌های خشک برایت مثل قفس است. پارتنری که زیادی برنامه می‌ریزد شاید کُندت کند — یا آرامت کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viihdyt suunnittelemattomassa. Tiukat aikataulut tuntuvat häkiltä. Liikaa suunnitteleva kumppani voi hidastaa sinua – tai pitää jalkasi maassa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buhay na buhay ka kapag walang plano. Parang kulungan sa’yo ang mahigpit na schedule. Ang partner na sobrang magplano ay puwedeng magpabagal sa’yo — o magpatatag sa’yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'imprévu, c'est ton élément. Un planning rigide te fait l'effet d'une cage. Quelqu'un qui planifie tout pourrait te freiner… ou t'ancrer."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíonn tú ar do sháimhín só le rudaí gan phleanáil. Is cosúil le cás iad sceidil dhochta. D’fhéadfadh páirtí a phleanálann an iomarca moill a chur ort — nó tú a choinneáil ar an talamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillas no que non está planificado. Os horarios ríxidos parécenche unha gaiola. Unha parella que o planifique todo pode frearte… ou axudarche a pór os pés na terra."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આયોજન વગરનું તમને ગમે છે. કડક સમયપત્રક પાંજરા જેવું લાગે. વધુ પડતું આયોજન કરતા પાર્ટનર તમને ધીમા પાડી શકે — કે સ્થિર પણ રાખી શકે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna haskakawa a abin da ba a shirya ba. Tsauraran jadawali na kama da keji a gare ku. Abokin zama mai yawan tsara abubuwa zai iya rage muku gudu — ko ya ba ku natsuwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הלא־מתוכנן הוא המגרש שלך. לוחות זמנים נוקשים מרגישים לך כמו כלוב. מי שמתכנן יותר מדי עלול להאט אותך — או לקרקע אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना प्लान के आपका मन खिल उठता है। सख़्त शेड्यूल पिंजरे जैसा लगता है। अगर पार्टनर हर चीज़ प्लान करें, तो इससे आपकी रफ़्तार धीमी हो सकती है — या आपको ज़मीनी सहारा मिल सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cvjetaš u neplaniranom. Kruti rasporedi djeluju kao kavez. Voljena osoba koja sve previše planira mogla bi te usporiti – ili prizemljiti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou byen nan sa ki pa planifye. Yon orè ki rèd sanble yon kalòj. Yon patnè ki planifye twòp ta ka ralanti ou — oswa ancre ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tervezetlenben érzed jól magad. A merev napirend ketrecnek tűnik. Ha a párod mindent eltervez, az lelassíthat – vagy épp a földön tarthat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու ծաղկում ես չպլանավորվածի մեջ։ Խիստ ժամանակացույցը վանդակ է թվում։ Ամեն ինչ պլանավորող զուգընկերը կարող է քեզ դանդաղեցնել, կամ էլ հավասարակշռել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu paling hidup saat semuanya serba dadakan. Jadwal kaku terasa seperti kurungan. Pasangan yang terlalu banyak rencana bisa memperlambatmu — atau justru membuatmu membumi."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe a na-ahazighị ahazi na-atọ gị ụtọ. Usoro siri ike dị ka ụlọ mkpọrọ. Onye na-ahazi ihe karịa nwere ike ibelata gị ọsọ — ma ọ bụ mee ka i guzosie ike."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú nýtur þín í því óskipulagða. Föst dagskrá er eins og búr. Maki sem skipuleggur allt gæti hægt á þér – eða veitt þér festu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai il meglio nell’imprevisto. I programmi rigidi ti stanno stretti. Un partner che pianifica troppo potrebbe frenarti, o darti stabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定のない時間でこそ輝くタイプ。きっちりしたスケジュールは窮屈に感じます。計画しすぎるパートナーは、ブレーキにも、心強い支えにもなりそうです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan mekar ing sing ora direncanakake. Jadwal sing kaku krasa kaya kurungan. Pasangan sing kakehan ngrancang bisa ngalon-alonake panjenengan — utawa malah nggawe ayem."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაუგეგმავში იფურჩქნები. მკაცრი განრიგი გალიად გეჩვენება. ზედმეტად დამგეგმავმა პარტნიორმა შეიძლება შეგაფერხოს — ან მიწაზე დაგაბრუნოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоспарсыз сәттерде гүлденесің. Қатаң кесте саған тор сияқты. Тым көп жоспарлайтын серік сені баяулатуы мүмкін, не керісінше тұрақтандырады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នករីកចម្រើនក្នុងអ្វីដែលមិនបានគ្រោងទុក។ កាលវិភាគតឹងរ៉ឹងហាក់ដូចជាទ្រុង។ ដៃគូដែលរៀបផែនការច្រើនពេក អាចធ្វើឲ្យអ្នកយឺត — ឬជួយឲ្យអ្នកនឹងន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯೋಜನೆಯಿಲ್ಲದ ಕ್ಷಣಗಳಲ್ಲೇ ನೀವು ಅರಳುತ್ತೀರಿ. ಕಟ್ಟುನಿಟ್ಟಿನ ವೇಳಾಪಟ್ಟಿ ಪಂಜರದಂತೆ ಅನಿಸುತ್ತದೆ. ಅತಿಯಾಗಿ ಯೋಜಿಸುವ ಸಂಗಾತಿ ನಿಮ್ಮನ್ನು ನಿಧಾನಗೊಳಿಸಬಹುದು — ಅಥವಾ ನೆಲೆಗೊಳಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획 없는 순간에 빛나요. 빡빡한 일정은 새장처럼 느껴지죠. 계획을 많이 세우는 연인은 발목을 잡을 수도, 중심을 잡아 줄 수도 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu di tiştên neplankirî de geş dibî. Bernameyên hişk ji bo te wekî qefesê ne. Hevjînek ku zêde plan dike dibe ku te hêdî bike — an jî te aram bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пландалбаган нерселерде гүлдөйсүң. Катуу графиктер капастай сезилет. Баарын алдын ала пландаган сүйгөнүң сени жайлатышы — же тең салмакта кармашы мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bléis am Ongeplangten op. Fest Pläng fille sech wéi e Käfeg un. E Schatz, deen alles plangt, kéint dech bremsen — oder dir Halt ginn."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າມີຊີວິດຊີວາເມື່ອບໍ່ມີແຜນ ຕາຕະລາງທີ່ເຄັ່ງຄັດເປັນຄືກັບກົງຂັງ ຄູ່ທີ່ວາງແຜນຫຼາຍເກີນໄປອາດເຮັດໃຫ້ເຈົ້າຊ້າລົງ — ຫຼື ຊ່ວຍໃຫ້ເຈົ້າໝັ້ນຄົງ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau puikiai sekasi, kai niekas nesuplanuota. Griežtas grafikas – kaip narvas. Viską planuojanti antroji pusė gali tave stabdyti – arba įžeminti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plauksti neplānotajā. Stingri grafiki šķiet kā būris. Otrā puse, kas visu pārplāno, var tevi bremzēt – vai iezemēt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miroborobo ianao amin'ny tsy voalamina. Toy ny tranom-borona ny fandaharam-potoana henjana. Ny olon-tiana mandamina be loatra dia mety hampiadana anao — na hampitony anao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka tupu koe i ngā mea kāore i whakaritea. He rite ngā mahere pakari ki te whare herehere. Mā tētahi hoa aroha whakarite nui pea koe e whakapōturi — e whakatau rānei."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цветаш во непланираното. Строгите распореди ти се како кафез. Половинка што премногу планира може да те успори — или да те приземји."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്ലാൻ ചെയ്യാത്ത നിമിഷങ്ങളിലാണ് നിങ്ങൾ തിളങ്ങുന്നത്. കർക്കശമായ ഷെഡ്യൂളുകൾ കൂട്ടിലടച്ചതുപോലെ തോന്നും. എല്ലാം അമിതമായി പ്ലാൻ ചെയ്യുന്ന പങ്കാളി നിങ്ങളുടെ വേഗം കുറച്ചേക്കാം — അല്ലെങ്കിൽ നിങ്ങളെ നിലത്തുറപ്പിച്ചേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи төлөвлөгөөгүй зүйлд цэцэглэдэг. Хатуу хуваарь тор мэт санагддаг. Хэт төлөвлөдөг хань чамайг удаашруулж — эсвэл тогтворжуулж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न ठरवलेल्या गोष्टींत तुम्ही खुलता. कडक वेळापत्रक तुम्हाला पिंजऱ्यासारखे वाटते. जोडीदार प्रत्येक गोष्टीचे जास्तच नियोजन करत असेल, तर तुमचा वेग कमी होईल — किंवा तुम्हाला स्थैर्य मिळेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda paling bersemangat bila sesuatu tidak dirancang. Jadual yang ketat terasa seperti sangkar. Pasangan yang terlalu merancang mungkin melambatkan anda — atau membuat anda lebih berpijak di bumi nyata."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiffjorixxi f'dak li mhux ippjanat. L-iskedi riġidi għalik huma gaġġa. Partner li jippjana wisq jista' jnaqqaslek il-pass — jew iżommok b'saqajk mal-art."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကြိုမစီစဉ်ထားတာတွေထဲမှာ ပျော်တယ်။ တင်းကျပ်တဲ့ အချိန်ဇယားက လှောင်အိမ်လို ခံစားရတယ်။ အစီအစဉ် အရမ်းဆွဲတဲ့ ချစ်သူက သင့်ကို နှေးစေနိုင်တယ် — ဒါမှမဟုတ် တည်ငြိမ်စေနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blomstrer i det uplanlagte. Faste timeplaner føles som et bur. En partner som planlegger mye, kan bremse deg – eller gi deg fotfeste."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईं योजनाबिनाको अवस्थामा फस्टाउनुहुन्छ। कडा तालिका पिँजडाजस्तो लाग्छ। धेरै योजना बनाउने पार्टनरले तपाईंलाई सुस्त बनाउन सक्नुहुन्छ — वा स्थिर राख्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bloeit op als niets vastligt. Een strak schema voelt als een kooi. Een partner die alles plant, kan je afremmen – of je juist houvast geven."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumakula bwino pa zinthu zosakonzekera. Ndondomeko zokhwima zimamveka ngati khola. Wokondedwa wokonzekera kwambiri angakuchedwetseni — kapena kukukhazikitsani."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan hin karoorfamne keessatti ni dagaagda. Sagantaan cimaan mana hidhaa sitti fakkaata. Karoorri baay'een jaalallee kee si suuta buusuu danda'a — ykn si tasgabbeessuu danda'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯୋଜନା ବିନା ଆପଣ ଫୁଲିଫଳି ଉଠନ୍ତି। କଡ଼ା ସମୟସୂଚୀ ପିଞ୍ଜରା ଭଳି ଲାଗେ। ବେଶି ଯୋଜନା କରୁଥିବା ସାଥୀ ଆପଣଙ୍କୁ ଧୀମା କରିପାରନ୍ତି — କିମ୍ବା ସ୍ଥିର କରିପାରନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਿਨਾਂ ਯੋਜਨਾ ਵਾਲੇ ਪਲਾਂ ਵਿੱਚ ਤੁਹਾਨੂੰ ਸਭ ਤੋਂ ਵੱਧ ਮਜ਼ਾ ਆਉਂਦਾ ਹੈ। ਸਖ਼ਤ ਸਮਾਂ-ਸਾਰਣੀ ਤੁਹਾਨੂੰ ਪਿੰਜਰਾ ਲੱਗਦੀ ਹੈ। ਜੇ ਪਾਰਟਨਰ ਹਰ ਚੀਜ਼ ਦੀ ਯੋਜਨਾ ਬਣਾਉਂਦੇ ਹਨ, ਤਾਂ ਉਹ ਤੁਹਾਡੀ ਰਫ਼ਤਾਰ ਘਟਾ ਸਕਦੇ ਹਨ — ਜਾਂ ਤੁਹਾਨੂੰ ਟਿਕਾ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwitniesz, gdy nic nie jest zaplanowane. Sztywny grafik to dla ciebie klatka. Ktoś, kto planuje za dużo, może cię spowalniać – albo uziemiać."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو په ناپلان شوي حالت کې غوړېږئ. سخت مهالوېشونه د پنجرې په څېر احساسېږي. هغه ملګری چې ډېر پلان جوړوي، کېدای شي مو ورو کړي — یا مو ثابت وساتي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você brilha no improviso. Agenda rígida parece uma prisão. Alguém que planeja demais pode frear você — ou te dar chão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O improviso é o teu elemento. Horários rígidos parecem uma jaula. Um par que planeia demais pode travar-te — ou dar-te chão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te simți în largul tău în neprevăzut. Programul rigid ți se pare o cușcă. Un partener care planifică prea mult te poate frâna — sau te poate ancora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты расцветаешь без планов. Жёсткое расписание для тебя как клетка. Партнёр, который всё планирует, может тебя тормозить — или заземлять."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishimira ibitateguwe. Gahunda zikomeye zikumerera nk'akazu. Umukunzi utegura cyane ashobora kugutinza — cyangwa kugutuza."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැලසුම් නොකළ දේවල් වලදී ඔබ දිදුලනවා. තද කාලසටහන් කූඩුවක් වගේ දැනෙනවා. වැඩියෙන් සැලසුම් කරන සහකරුවෙක් ඔබව මන්දගාමී කරන්න පුළුවන් — නැත්නම් සමබර කරන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darí sa ti v neplánovanom. Pevné rozvrhy sú pre teba klietka. Polovička, ktorá všetko plánuje, ťa môže brzdiť – alebo ukotviť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nenačrtovanem uspevaš. Tog urnik je zate kot kletka. Partner, ki preveč načrtuje, te lahko upočasni – ali prizemlji."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unobudirira muzvisina kurongwa. Purogiramu dzakaomarara dzinonzwika sejeri. Mudiwa anoronga zvakanyanya angakunonotsa — kana kukugadzikanisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad ku barwaaqowdaa waxa aan la qorsheyn. Jadwal adag wuxuu kuu yahay sidii qafis. Lammaane qorsheyn badan jecel ayaa ku gaabin kara — ama ku dejin kara."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lulëzon në të paplanifikuarën. Oraret e ngurta të duken si kafaz. Një partner që planifikon shumë mund të të ngadalësojë – ose të të japë stabilitet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цветаш у непланираном. Крути распореди ти делују као кавез. Половина која све превише планира може да те успори — или да те уземљи."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun mekar dina hal anu teu direncanakeun. Jadwal anu kaku karaos sapertos kurungan. Pasangan anu réa teuing ngarencanakeun meureun ngalambatkeun anjeun, atanapi ngajantenkeun anjeun langkung ajeg."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trivs i det oplanerade. Fasta scheman känns som en bur. En partner som planerar för mycket kan bromsa dig – eller ge dig fotfäste."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unastawi katika yasiyopangwa. Ratiba ngumu huhisi kama kizimba. Mwenzi anayepanga kupita kiasi anaweza kukupunguza kasi — au kukutuliza."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டமிடாத தருணங்களில் மலர்கிறீர்கள். கடுமையான அட்டவணை கூண்டு போலத் தோன்றும். அதிகம் திட்டமிடும் துணை உங்களை மெதுவாக்கலாம் — அல்லது நிலைப்படுத்தலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్లాన్ లేనప్పుడే మీరు వికసిస్తారు. కచ్చితమైన షెడ్యూళ్లు పంజరంలా అనిపిస్తాయి. అతిగా ప్లాన్ చేసే భాగస్వామి మిమ్మల్ని నెమ్మదింపజేయవచ్చు — లేదా నిలకడగా ఉంచవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту дар бенақшагӣ гул мекунӣ. Ҷадвалҳои сахт ба қафас монанданд. Ёре, ки ҳама чизро аз пеш нақша мекашад, шояд туро суст кунад — ё ба замин орад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมีชีวิตชีวาที่สุดเมื่อไม่มีแผน ตารางที่ตายตัวเหมือนกรงขัง คนรักที่วางแผนมากเกินไปอาจทำให้คุณช้าลง หรือช่วยดึงคุณให้อยู่กับร่องกับรอย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብቲ ዘይተመደበ ትዕንብቡ። ተሪር መደብ ከም ቤት ማእሰርቲ ይስምዓኩም። ብዙሕ ዝመድብ መጻምዲ ከደንጉየኩም ይኽእል — ወይ ከረጋግኣኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meýilnamasyz ýagdaýda gülläp ösýärsiň. Berk tertip kapas ýaly duýulýar. Aşa meýilnama düzýän söýgüli seni haýalladyp biler — ýa-da deňagramlaşdyryp biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plansızlıkta parlıyorsun. Katı programlar kafes gibi geliyor. Her şeyi planlayan bir partner seni yavaşlatabilir ya da ayaklarını yere bastırabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі добре без планів. Жорсткий розклад — як клітка. Половинка, яка все планує, може тебе гальмувати — або заземлювати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بے منصوبہ لمحوں میں آپ کی جان ہے۔ سخت شیڈول پنجرے جیسا لگتا ہے۔ اگر ساتھی ہر چیز کی حد سے زیادہ منصوبہ بندی کرے تو آپ کی رفتار سست ہو سکتی ہے، یا آپ کو ٹھہراؤ مل سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejalashtirilmagan vaziyatlarda gullab-yashnaysiz. Qatʼiy jadval qafasdek tuyuladi. Ortiqcha rejalashtiradigan sherik sizni sekinlashtirishi — yoki muvozanatga keltirishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sống tốt nhất khi không có kế hoạch. Lịch trình cứng nhắc như một cái lồng. Một người quá kỹ tính trong việc lên kế hoạch có thể làm bạn chậm lại — hoặc giúp bạn vững vàng."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakhula kwizinto ezingacwangciswanga. Iishedyuli eziqinileyo zivakala njengentolongo. Iqabane elicwangcisa kakhulu lingakucothisa — okanye likuzinzise."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ ń gbèrú nínú ohun tí a kò gbèrò. Ètò tó le ń dàbí àgò fún yín. Olólùfẹ́ tó ń gbèrò jù lè dá yín dúró — tàbí kí ó mú yín balẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在沒有計劃時最如魚得水。死板的時間表像個籠子。凡事計劃周詳的另一半，可能會拖慢你，也可能讓你更踏實。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有计划时你最自在，死板的日程像笼子。如果另一半什么都要计划，可能会拖慢你，也可能让你更踏实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在沒計畫的時候最如魚得水，死板的行程對你來說像牢籠。太愛規劃的另一半可能會拖慢你，也可能讓你更踏實。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uphumelela ezintweni ezingahleliwe. Izinhlelo eziqinile zizwakala njengejele. Umlingani ohlela ngokweqile angakwehlisa ijubane — noma akuzinzise."
          }
        }
      }
    },
    "You thrive on being told. Compliments, 'I love you', a text saying you're appreciated — that's what fills your tank. Don't make them guess." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy floreer as iemand dit vir jou sê. Komplimente, “Ek is lief vir jou”, ’n boodskap wat wys jy word waardeer – dít maak jou tenk vol. Moenie jou maat laat raai nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መስማት ያስደስትዎታል። ሙገሳ፣ «እወድዎታለሁ»፣ እንደሚደነቁ የሚገልጽ መልዕክት — ልብዎን የሚሞላው ይሄ ነው። አጋርዎ እንዲገምቱ አይተዉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات هي ما يُنعشكم. مديح صادق، أو «أحبك»، أو رسالة تقول إنكم موضع تقدير، هذا ما يملأ قلوبكم. لا تتركوا شريكك يخمّن."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখেৰে শুনিলেহে আপুনি সজীৱ হৈ উঠে। প্ৰশংসা, “মই তোমাক ভাল পাওঁ”, আপোনাক মূল্য দিয়া বুলি এটা মেছেজ — এইবোৰেই আপোনাৰ মন ভৰাই তোলে। সংগীক অনুমান কৰিবলৈ নিদিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevginin sözlə deyilməsi sənə güc verir. İltifatlar, “səni sevirəm”, dəyər verildiyini göstərən bir mesaj — səni məhz bunlar doldurur. Qoy partnyorun təxmin etməli olmasın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табе важна чуць гэта ўголас. Кампліменты, «Я цябе кахаю», паведамленне пра тое, як цябе цэняць, — вось што напаўняе цябе. Не прымушай палавінку здагадвацца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разцъфваш, когато ти го кажат. Комплименти, „Обичам те“, съобщение, че те ценят – това те зарежда. Не карай половинката си да гадае."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুখে শুনতে পেলেই তুমি ভালো থাকো। প্রশংসা, “ভালোবাসি”, একটা মেসেজ যে তোমাকে কতটা কদর করা হয় — এতেই তোমার মন ভরে। পার্টনারকে আন্দাজের ওপর ছেড়ে দিয়ো না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebe hrane riječi. Komplimenti, „volim te”, poruka da te neko cijeni – to ti puni baterije. Ne tjeraj voljenu osobu da pogađa."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'omple que t'ho diguin. Compliments, un «t'estimo», un missatge que diu que t'aprecien — això és el que et carrega les piles. No deixis que ho hagi d'endevinar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potřebuješ to slyšet. Komplimenty, „miluju tě“, zpráva, že si tě někdo váží – to tě nabíjí. Nenech druhou stranu hádat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti'n ffynnu ar glywed y geiriau. Canmoliaeth, ‘Dw i'n dy garu di’, neges yn dweud dy fod yn cael dy werthfawrogi — dyna sy'n llenwi dy danc. Paid â gwneud i dy bartner ddyfalu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blomstrer, når det bliver sagt højt. Komplimenter, »jeg elsker dig«, en sms om, at du bliver værdsat – det er det, der fylder dig op. Lad ikke din partner gætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blühst auf, wenn man es dir sagt. Komplimente, ein „Ich liebe dich“, eine Nachricht, dass du geschätzt wirst – das füllt deinen Tank. Lass deinen Schatz nicht raten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανθίζεις όταν σου το λένε. Ένα κομπλιμέντο, ένα «σ' αγαπώ», ένα μήνυμα ότι σε εκτιμούν — αυτά σε γεμίζουν. Μην αφήνεις το ταίρι σου να μαντεύει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te llena que te lo digan. Un cumplido, un “te quiero”, un mensaje diciendo cuánto te valoran: eso es lo que te recarga. No hagas que tu pareja tenga que adivinarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulle on oluline seda kuulda. Komplimendid, „Ma armastan sind“, sõnum, et sind hinnatakse — just see täidab su paagi. Ära jäta partnerit oletama."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esaten dizutenean loratzen zara. Laudorioak, «maite zaitut» bat, eskertzen zaituztela dioen mezu bat — horrek betetzen zaitu. Ez utzi zure bikotekidea asmaka."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شنیدنش حالت را خوب می‌کند. تعریف، «دوستت دارم»، پیامی که بگوید قدردانت است — این‌هاست که دلت را پر می‌کند. نگذار پارتنرت حدس بزند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukoistat, kun asiat sanotaan ääneen. Kehut, ”rakastan sinua” tai viesti, jossa kerrotaan, että sinua arvostetaan – juuri ne lataavat akkujasi. Älä jätä kumppaniasi arvailemaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumalakas ang loob mo kapag sinasabi ito sa’yo. Papuri, “mahal kita”, isang text na nagsasabing pinahahalagahan ka — iyan ang pumupuno sa puso mo. Huwag mo siyang pahulaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as besoin de l'entendre. Un compliment, un « je t'aime », un message pour te dire qu'on t'apprécie : c'est ça qui remplit ton cœur. Ne laisse pas l'autre deviner."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíonn tú ar do sháimhín só nuair a deirtear leat é. Moladh, “Is breá liom thú”, téacs a deir go bhfuil meas ort — sin a chothaíonn thú. Ná fág do pháirtí ag tomhas."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medras cando cho din. Eloxios, un «quérote», unha mensaxe dicindo que te valoran: iso é o que che enche o depósito. Non llo fagas adiviñar."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ કહે ત્યારે તમે ખીલી ઊઠો છો. વખાણ, “આઇ લવ યુ”, તમારી કદર થાય છે એવો એક મેસેજ — એનાથી જ તમારું મન ભરાય છે. તેમને અનુમાન લગાવતા ન રાખો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna bunƙasa idan aka faɗa muku. Yabo, “Ina son ku”, saƙon da ke cewa ana yaba ku — wannan ne ke cika zuciyarku. Kada ku bari a yi ta zato."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שום דבר לא עושה לך טוב כמו לשמוע את זה במילים. מחמאות, מילים של אהבה, הודעה שאומרת כמה מעריכים אותך — זה מה שממלא לך את המצברים. אין סיבה להשאיר את זה לניחושים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए कहा जाना बहुत मायने रखता है। तारीफ़, “आई लव यू”, या बस एक मैसेज कि आपकी क़द्र है — इसी से आपका दिल भरता है। पार्टनर को अंदाज़ों के भरोसे मत छोड़िए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebi je važno to čuti. Komplimenti, „volim te”, poruka da te netko cijeni – to te puni. Ne tjeraj voljenu osobu da pogađa."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou bezwen tande l. Konpliman, “Mwen renmen ou”, yon mesaj ki di yo apresye ou — se sa ki ranpli kè ou. Pa kite l ap devine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked az számít, ha kimondják. Bókok, egy „szeretlek”, egy üzenet, hogy értékelnek – ez tölt fel igazán. Ne hagyd, hogy a párod találgasson."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քեզ համար կարևոր է լսել։ Հաճոյախոսություններ, «Սիրում եմ քեզ», մի հաղորդագրություն, որ քեզ գնահատում են — հենց դա է քեզ լիցքավորում։ Մի՛ ստիպիր, որ զուգընկերդ գուշակի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu butuh mendengarnya diucapkan. Pujian, “aku sayang kamu”, pesan yang bilang kamu dihargai — itulah yang mengisi hatimu. Jangan biarkan dia menebak-nebak."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-eto mgbe a gwara gị. Otuto, “A hụrụ m gị n'anya”, ozi na-egosi na a na-enwe ekele maka gị — nke ahụ na-ejupụta obi gị. Ahapụla ya ka ọ na-akọ nkọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú blómstrar þegar hlutirnir eru sagðir upphátt. Hrós, „ég elska þig“, skilaboð um að einhver kunni að meta þig – það fyllir á tankinn. Ekki láta makann þinn giska."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai bisogno di sentirtelo dire. Complimenti, un «ti amo», un messaggio che dice quanto vali — è questo che ti ricarica. Non lasciare che l’altra persona debba indovinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉にしてもらうことで満たされるタイプです。ほめ言葉や「大好き」、感謝を伝えるひと言のメッセージが心のエネルギーになります。相手に推測させず、伝えておきましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panjenengan seneng yen diomongi. Pangalembana, “Aku tresna kowe”, pesen sing ngandharake yen panjenengan diajeni — kuwi sing ngisi ati panjenengan. Aja nganti pasangan kudu ngira-ira."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიტყვებით იკვებები. კომპლიმენტები, „მიყვარხარ“, მესიჯი, რომ გაფასებენ — აი, რა გავსებს ენერგიით. ნუ აიძულებ პარტნიორს, გამოიცნოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Саған айтылғаны маңызды. Комплимент, «Сені жақсы көремін», сені бағалайтынын білдіретін хабарлама — міне, жүрегіңді осылар толтырады. Серігің болжап әуре болмасын."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នករីកស្រស់ពេលបានឮពាក្យសម្ដី។ ពាក្យសរសើរ “ខ្ញុំស្រឡាញ់អ្នក” ឬសារមួយប្រាប់ថាអ្នកមានតម្លៃ — នោះហើយជាអ្វីដែលបំពេញចិត្តអ្នក។ កុំទុកឲ្យគាត់ទាយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾತಿನಲ್ಲಿ ಕೇಳಿದಾಗ ನೀವು ಅರಳುತ್ತೀರಿ. ಹೊಗಳಿಕೆ, “ಐ ಲವ್ ಯೂ”, ನಿಮ್ಮನ್ನು ಮೆಚ್ಚುತ್ತಾರೆ ಎಂದು ಹೇಳುವ ಒಂದು ಮೆಸೇಜ್ — ಇವೇ ನಿಮ್ಮ ಮನಸ್ಸನ್ನು ತುಂಬುವುದು. ಅವರು ಊಹಿಸುವಂತೆ ಬಿಡಬೇಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말로 들을 때 힘이 나는 타입이에요. 칭찬, “사랑해”, 고맙다는 메시지 하나가 마음을 가득 채워 줘요. 연인이 짐작하게 두지 말고 알려 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotin te geş dikin. Pesindan, “Ez ji te hez dikim”, peyamek ku dibêje tu tê qedirgirtin — ev e ya ku dilê te tije dike. Nehêle hevjînê te texmîn bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сага айтылган сөз күч берет. Мактоо, «Мен сени сүйөм», сени баалаганын билдирген кыска кат — жүрөгүңдү ушулар толтурат. Муну сүйгөнүңө ачык айт, божомолдоп жүрбөсүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bléis op, wann een et dir seet. Komplimenter, „Ech hunn dech gär“, e Message, deen weist, datt een dech schätzt — dat fëllt däin Tank. Looss däi Schatz net roden."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າເບີກບານເມື່ອໄດ້ຍິນຄຳເວົ້າ ຄຳຊົມ, ‘ຮັກນະ’, ຂໍ້ຄວາມທີ່ບອກວ່າເຈົ້າມີຄຸນຄ່າ — ນັ້ນແຫຼະຄືສິ່ງທີ່ເຕີມໃຈເຈົ້າໃຫ້ເຕັມ ຢ່າປ່ອຍໃຫ້ຄູ່ຕ້ອງເດົາເອົາ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau reikia tai išgirsti. Komplimentai, „myliu tave“, žinutė, kad tave vertina, – štai kas tave pripildo. Neversk antrosios pusės spėlioti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev vajag to dzirdēt. Komplimenti, „Es tevi mīlu”, ziņa, ka tevi novērtē, – tas tevi piepilda. Neliec otrai pusei minēt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velombelona ianao rehefa voalaza aminao. Fiderana, “Tiako ianao”, hafatra milaza fa ankasitrahina ianao — izany no mameno ny fonao. Aza avela hanombantombana izy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka tipu koe i ngā kupu. He kupu whakamihi, he “Aroha ana ahau ki a koe”, he karere e kī ana he mea nui koe — koinā e whakakī ana i tō kete. Kaua e waiho kia matapae noa ia."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти значи кога ти се кажува. Комплименти, „Те сакам“, порака дека си ценет човек — тоа те полни. Не оставај ја половинката да погодува."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കേൾക്കുമ്പോഴാണ് നിങ്ങൾ തളിർക്കുന്നത്. അഭിനന്ദനങ്ങൾ, “ഞാൻ നിന്നെ സ്നേഹിക്കുന്നു”, നിങ്ങളെ വിലമതിക്കുന്നു എന്നൊരു മെസേജ് — അതാണ് നിങ്ങളുടെ മനസ്സ് നിറയ്ക്കുന്നത്. പങ്കാളിയെ ഊഹിക്കാൻ വിടരുത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чамд үгээр хэлүүлэх нь чухал. Магтаал, «Хайртай шүү», чамайг үнэлдгийг илэрхийлсэн мессеж — энэ л чиний сэтгэлийг дүүргэдэг. Ханиа таалгалгүй, шууд хэлээрэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला शब्दांतून ऐकायला आवडते. कौतुक, “माझं तुझ्यावर प्रेम आहे”, तुमची कदर आहे असा एखादा मेसेज — यानेच तुमचे मन भरून येते. जोडीदाराला अंदाज लावत बसू देऊ नका."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda paling bersemangat apabila mendengarnya diucapkan. Pujian, ucapan sayang, mesej yang mengatakan anda dihargai — itulah yang mengisi jiwa anda. Jangan biarkan pasangan anda meneka."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Int tiffjorixxi meta tisma' l-kliem. Kumplimenti, “Inħobbok”, messaġġ li juri kemm tiswa — dak li jimlielek qalbek. Għid ċar x'għandek bżonn."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားနဲ့ ပြောပြခံရတာက သင့်ကို ရှင်သန်စေတယ်။ ချီးကျူးစကား၊ “ချစ်တယ်” ဆိုတဲ့စကား၊ သင့်ကို တန်ဖိုးထားကြောင်း ပို့တဲ့ မက်ဆေ့ချ်လေး — ဒါတွေက သင့်နှလုံးသားကို ပြည့်စေတာပါ။ ချစ်သူကို ခန့်မှန်းခိုင်းမနေပါနဲ့။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blomstrer når du får høre det. Komplimenter, «jeg elsker deg», en melding om at du blir satt pris på – det er det som lader batteriene dine. Ikke la partneren din gjette."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मायालु शब्द सुन्दा तपाईं फक्रिनुहुन्छ। प्रशंसा, ‘म तपाईंलाई माया गर्छु’, तपाईंको कदर गरिएको छ भन्ने एउटा म्यासेज — यस्तै कुराले तपाईंको मन भरिन्छ। उहाँलाई अनुमान लगाउन नछोड्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bloeit op als je het hoort. Complimenten, ‘ik hou van je’, een berichtje dat je gewaardeerd wordt – daar laad jij van op. Laat je partner niet raden."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mumasangalala mukauzidwa. Kuyamikiridwa, “Ndimakukonda”, uthenga wonena kuti mumayamikiridwa — ndizo zimadzaza mtima wanu. Musawasiye akungoganizira."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jechoota sitti himaman irraa jabina argatta. Jajjabeessuu, “Sin jaalladha”, ergaa akka ati dinqisiifamtu sitti himu — kun garaa kee guuta. Jaalallee kee tilmaamsiisuu dhiisi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କହିଲେ ହିଁ ଆପଣ ଖୁସିରେ ଫୁଟି ଉଠନ୍ତି। ପ୍ରଶଂସା, ‘ମୁଁ ତୁମକୁ ଭଲପାଏ’, ଆପଣଙ୍କୁ ମୂଲ୍ୟ ଦିଆଯାଉଛି ବୋଲି ଏକ ମେସେଜ୍ — ଏଇଆ ଆପଣଙ୍କ ମନ ଭରିଦିଏ। ସେମାନଙ୍କୁ ଅନୁମାନ କରିବାକୁ ଛାଡ଼ନ୍ତୁ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਬਦ ਸੁਣ ਕੇ ਤੁਸੀਂ ਖਿੜ ਉੱਠਦੇ ਹੋ। ਤਾਰੀਫ਼ਾਂ, “ਤੁਸੀਂ ਮੈਨੂੰ ਬਹੁਤ ਪਿਆਰੇ ਹੋ”, ਜਾਂ ਕੋਈ ਮੈਸੇਜ ਕਿ ਤੁਹਾਡੀ ਕਦਰ ਹੈ — ਇਹੀ ਤੁਹਾਡਾ ਦਿਲ ਭਰਦਾ ਹੈ। ਆਪਣੇ ਪਾਰਟਨਰ ਨੂੰ ਅੰਦਾਜ਼ੇ ਨਾ ਲਾਉਣ ਦਿਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozkwitasz, gdy słyszysz miłe słowa. Komplementy, „kocham cię”, SMS z podziękowaniem – to właśnie napełnia twoje serce. Nie każ drugiej połówce zgadywać."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاسو ته دا ډېره مهمه ده چې په خوله درته وویل شي. ستاینه، «مینه درسره لرم»، یو پیغام چې ووايي ستاسو قدر کېږي — همدا ستاسو زړه ډکوي. خپل ملګری په اټکل مه پرېږدئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvir faz toda a diferença para você. Elogios, um “eu te amo”, uma mensagem dizendo o quanto você é importante — é isso que enche seu coração. Não deixe seu amor adivinhando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvir dizer faz-te florescer. Elogios, um «amo-te», uma mensagem a dizer que és importante — é isso que te enche o coração. Não deixes o teu par a adivinhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înflorești când ți se spune. Complimente, un „te iubesc”, un mesaj care îți arată prețuirea — asta îți umple sufletul. Nu-l lăsa pe partenerul tău să ghicească."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе важно слышать это вслух. Комплименты, «я тебя люблю», сообщение о том, как тебя ценят, — вот что наполняет тебя. Не заставляй партнёра гадать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishimira kubwirwa. Amagambo meza, “Ndagukunda”, ubutumwa bukubwira ko ushimwa — ibyo ni byo bikuzuza. Ntukamuharire gukeka."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබට දැනෙන්න ඕනේ වචනවලින් කියන දේ. ප්‍රශංසා, “මම ඔබට ආදරෙයි”, ඔබව අගය කරන බව කියන පණිවිඩයක් — ඔබේ හදවත පුරවන්නේ ඒවායි. ඔබේ සහකරුට අනුමාන කරන්න තියන්න එපා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebuješ to počuť. Kompliment, „ľúbim ťa“, správa, že si ťa váži – presne to ťa nabíja. Nenechaj tvoju polovičku hádať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cvetiš, ko ti to povedo. Pohvale, „ljubim te“, sporočilo, da te cenijo – to ti napolni rezervoar. Ne puščaj partnerja ugibati."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unofara kana uchiudzwa. Kurumbidzwa, “Ndinokuda”, meseji inoti unokosheswa — ndizvo zvinozadza mwoyo wako. Usamusiya achingofungidzira."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad ku faraxdaa marka erayo laguu sheego. Ammaan, “Waan ku jeclahay”, fariin kuu sheegaysa in lagu qaddariyo — taasi ayaa qalbigaaga buuxisa. Si cad u sheeg si aan loo qiyaasin."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ty të jep krahë kur ta thonë. Komplimentet, një „Të dua“, një mesazh që të tregon sa të vlerësojnë – kjo të mbush me energji. Mos e lër partnerin tënd të hamendësojë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цветаш кад ти се то каже. Комплименти, „волим те“, порука да те неко цени — то ти пуни батерије. Не терај своју половину да погађа."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjeun mekar upami dicarioskeun. Pangalem, “Abdi bogoh ka anjeun”, pesen anu nyebatkeun anjeun dihargaan — éta anu ngeusian haté anjeun. Ulah ngantep pasangan nebak-nebak."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du växer av att få höra det. Komplimanger, ”jag älskar dig”, ett sms om att du är uppskattad – det är det som fyller på dig. Låt inte din partner gissa."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unastawi unapoambiwa. Sifa, “nakupenda”, ujumbe unaosema unathaminiwa — hivyo ndivyo moyo wako hujaa. Usimwache akisie."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சொல்லக் கேட்கும்போதுதான் நீங்கள் மலர்கிறீர்கள். பாராட்டுகள், “உங்களை நேசிக்கிறேன்”, நீங்கள் மதிக்கப்படுகிறீர்கள் என்று ஒரு குறுஞ்செய்தி — இவைதான் உங்கள் மனதை நிரப்புகின்றன. உங்கள் துணையை ஊகிக்க விடாதீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మాటల్లో వినడం మీకు బలాన్నిస్తుంది. పొగడ్తలు, “ఐ లవ్ యూ”, మిమ్మల్ని మెచ్చుకుంటూ ఒక మెసేజ్ — ఇవే మీ మనసు నింపుతాయి. మీ భాగస్వామి ఊహించుకునేలా వదిలేయకండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ту аз шунидан гул мекунӣ. Таъриф, «дӯстат медорам», паёме, ки қадри туро мегӯяд — ҳамин дили туро пур мекунад. Нагузор, ки ёрат тахмин занад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมีความสุขที่สุดเมื่อได้ยินออกมาเป็นคำพูด คำชม คำว่า “รักนะ” หรือข้อความสั้นๆ ว่าคุณมีค่า สิ่งเหล่านี้เติมหัวใจคุณให้เต็ม อย่าปล่อยให้คนรักต้องเดาเอง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብቓላት ክንገረኩም ከለኹም ትዕንበቡ። ናእዳ፣ «እፈቕረኩም እየ»፣ ከም እትምስገኑ ዝገልጽ መልእኽቲ — ልብኹም ዝመልእ እዚ እዩ። ብግምት ኣይትሕደግዎም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saňa aýdylmagy gerek. Öwgüler, “Seni söýýärin”, seni gadyrlaýandygyny aýdýan gysga hat — ýüregiňi doldurýan şular. Söýgüliňi çaklamaga mejbur etme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duymak sana iyi geliyor. İltifatlar, “Seni seviyorum” demek, değer verildiğini söyleyen bir mesaj… Seni dolduran bunlar. Partnerini tahmin etmek zorunda bırakma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі важливо це чути. Компліменти, «я тебе кохаю», повідомлення про те, як тебе цінують, — ось що тебе наповнює. Не змушуй половинку здогадуватися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو زبان سے سننا اچھا لگتا ہے۔ تعریف، “مجھے آپ سے محبت ہے”، یا ایک پیغام کہ آپ کی قدر ہے — یہی آپ کا دل بھرتا ہے۔ اپنے ساتھی کو اندازوں پر نہ چھوڑیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizga yoqimli soʻzlar aytilishi muhim. Maqtovlar, «Seni sevaman», qadrlanayotganingiz haqidagi xabar — qalbingizni aynan shular toʻldiradi. Sherigingizni taxmin qilishga majbur qilmang."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cần được nghe thành lời. Một lời khen, câu “mình thương bạn”, một tin nhắn nói rằng bạn được trân trọng — đó là những gì nạp đầy năng lượng cho bạn. Đừng để người ấy phải đoán."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakhula xa uxelelwa. Ukunconywa, “Ndiyakuthanda”, umyalezo othi uyaxatyiswa — yiloo nto ezalisa intliziyo yakho. Musa ukwenza ukuba iqabane lakho liqikelele."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ̀rọ̀ ẹnu ló ń fún yín lókun. Ìyìn, “Mo nífẹ̀ẹ́ rẹ”, àtẹ̀jíṣẹ́ tó sọ pé a mọyì yín — ìyẹn ló ń kún ọkàn yín. Ẹ má ṣe jẹ́ kí olólùfẹ́ yín máa méfò."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要聽到愛說出口。一句讚美、一句「我愛你」、一個說感謝你的訊息，就能為你充滿電。別讓對方去猜。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要听到对方说出来。一句夸奖、一句“我爱你”、一条说很感激你的消息，就能把你的心填满。别让对方去猜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要聽到說出口的愛。一句稱讚、一句「我愛你」、一則表達感謝的訊息，就能讓你充滿能量。別讓對方用猜的。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchuma uma utshelwa. Ukunconywa, “Ngiyakuthanda”, umyalezo othi uyaziswa — yikho okugcwalisa inhliziyo yakho. Ungamenzi aqagele."
          }
        }
      }
    },
