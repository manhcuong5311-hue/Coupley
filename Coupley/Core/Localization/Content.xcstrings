        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakykata laýyk. Dürli maşgalalar dürli çemeleşme talap edýär. Esasy zat — ikiňiziň pikiriňiziň bir bolmagy."
