    "Travel compatibility can make or break a holiday — this is worth knowing early." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوافق في السفر قد يصنع العطلة أو يفسدها، ومن المفيد معرفة ذلك مبكرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestovatelská kompatibilita může dovolenou zachránit, nebo zničit – vyplatí se o ní vědět včas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om I passer sammen som rejsepartnere, kan være afgørende for ferien – det er værd at vide tidligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob ihr beim Reisen zusammenpasst, kann einen Urlaub retten oder ruinieren – das solltet ihr früh wissen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αν ταιριάζετε στα ταξίδια μπορεί να κάνει ή να χαλάσει τις διακοπές — αξίζει να το ξέρετε νωρίς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser compatibles al viajar puede salvar o arruinar unas vacaciones; vale la pena saberlo pronto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matkailutyylien yhteensopivuus voi pelastaa tai pilata loman – tämä kannattaa tietää ajoissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwedeng magpaganda o sumira ng bakasyon ang pagkakatugma sa pagbiyahe — mabuting malaman ito nang maaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être compatibles en voyage peut faire ou défaire des vacances : mieux vaut le savoir tôt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה בטיולים יכולה לעשות או להרוס חופשה — שווה לדעת את זה מוקדם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़र में तालमेल छुट्टी बना भी सकता है और बिगाड़ भी — इसे जल्दी जान लेना अच्छा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy mennyire vagytok jó útitársak, azon múlhat egy egész nyaralás – ezt érdemes korán tudni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecocokan saat traveling bisa bikin liburan sukses atau gagal — ini layak diketahui sejak awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compatibilità in viaggio può salvare o rovinare una vacanza — meglio saperlo presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅の相性は旅行の成否を左右します。早めに知っておく価値があります。"
