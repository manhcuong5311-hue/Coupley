        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiljanlegt. Gott að vita samt hvort makinn þinn myndi elska að spila með þér – eða þarf að fá að hafa sinn leikjatíma í friði."
