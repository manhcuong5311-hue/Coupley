        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зроби улюблений чай чи страву половинки. Залиш так, щоб легко дотягнутися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pha trà hoặc nấu món người ấy thích. Để sẵn trong tầm tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泡杯茶或做点另一半爱吃的，放在伸手就能拿到的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泡杯茶或做一道對方愛吃的，放在伸手拿得到的地方。"
          }
        }
      }
    },
    "Making things. You probably have ideas inside you that you haven't found a way to express yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صنع الأشياء. على الأرجح في داخلك أفكار لم تجد طريقها إلى التعبير بعد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoření. Nejspíš v sobě nosíš nápady, které si zatím nenašly cestu ven."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At skabe ting. Du har nok idéer i dig, som du endnu ikke har fundet en måde at udtrykke på."
