        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצמאות כלכלית חשובה לך. זה עובד טוב עם הסכמות ברורות על ההוצאות המשותפות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको आर्थिक आज़ादी प्यारी है। यह तब अच्छा चलता है जब साझा ख़र्चों को लेकर साफ़ समझौते हों।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értékeled a pénzügyi függetlenséget. Ez jól működik, ha világosan megállapodtok, hogyan kezelitek a közös kiadásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menghargai kemandirian finansial. Ini berjalan baik dengan kesepakatan yang jelas soal pengeluaran bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai valore all’indipendenza economica. Funziona bene con accordi chiari su come gestire le spese comuni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な自立を大切にするタイプです。共通の出費の扱いをはっきり決めておけば、うまくいきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경제적 독립을 중요하게 여겨요. 공동 지출을 어떻게 나눌지 분명하게 약속해 두면 잘 맞는 방식이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menghargai kebebasan kewangan. Cara ini berkesan dengan persetujuan yang jelas tentang cara perbelanjaan bersama diuruskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verdsetter økonomisk selvstendighet. Det fungerer godt med tydelige avtaler om hvordan felles utgifter håndteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij hecht aan financiële onafhankelijkheid. Dat werkt goed met duidelijke afspraken over hoe jullie gedeelde kosten regelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cenisz niezależność finansową. To dobrze działa przy jasnych ustaleniach, jak dzielicie wspólne wydatki."
