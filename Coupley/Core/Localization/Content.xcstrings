    "Give it time and let it settle naturally" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمنحه وقتًا ليهدأ من تلقاء نفسه"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dát tomu čas, ať se to usadí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give det tid, så det falder til ro af sig selv"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit lassen, bis es sich legt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λίγο χρόνο, να κατακάτσει μόνο του"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darle tiempo y que se calme solo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikaa, jotta asia laskeutuu itsestään"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigyan ng panahon at hayaang humupa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser le temps faire les choses"
          }
        },
        "he" : {
          "stringUnit" : {
