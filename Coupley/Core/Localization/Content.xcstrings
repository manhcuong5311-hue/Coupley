            "state" : "translated",
            "value" : "觀察型：我會注意到別人沒發現的事"
          }
        }
      }
    },
    "Offer a 20-minute distraction — a show, a meme, anything light." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقترحوا 20 دقيقة من التسلية: حلقة، أو صورة طريفة، أو أي شيء خفيف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídni 20 minut rozptýlení – seriál, meme, cokoli lehkého."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbyd 20 minutters afledning – en serie, et meme, noget let."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biete 20 Minuten Ablenkung an – eine Serie, ein Meme, irgendwas Leichtes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρότεινε 20 λεπτά απόσπασης — μια σειρά, ένα meme, κάτι ανάλαφρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrécele 20 minutos de distracción: una serie, un meme, algo ligero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjoa 20 minuutin irtiotto – sarja, meemi, mitä tahansa kevyttä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-alok ng 20 minutong libangan — isang palabas, meme, kahit anong magaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose 20 minutes de distraction : une série, un mème, n'importe quoi de léger."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להציע 20 דקות של הסחת דעת — סדרה, מם, כל דבר קליל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
