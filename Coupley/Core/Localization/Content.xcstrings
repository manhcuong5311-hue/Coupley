        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದರ ಮಹತ್ವ ಹಲವರಿಗೆ ಗೊತ್ತಿಲ್ಲ. ಊಹಿಸುವ ಬದಲು, ನೀವು ಮೊದಲು ಕೇಳುತ್ತೀರಿ. ಆಸರೆ ನೀಡುವ ನಿಜವಾದ ಕಾಳಜಿಯ ರೀತಿ ಇದು."
