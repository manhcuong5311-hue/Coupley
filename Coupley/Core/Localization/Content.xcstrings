        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vis dans le présent. Un budget commun peut sembler contraignant au début, mais il peut t'offrir plus de liberté sur le long terme."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maireann tú sa lá atá inniu ann. D'fhéadfadh buiséad comhroinnte a bheith srianta ar dtús, ach is féidir leis níos mó saoirse a thabhairt duit san fhadtéarma."
