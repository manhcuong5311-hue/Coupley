    "Tangible support. You show love through action when someone's struggling — not just words." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعم ملموس. تعبّرون عن الحب بالأفعال حين يمرّ أحدهم بوقت صعب، لا بالكلمات وحدها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmatatelná podpora. Když má někdo těžké chvíle, projevuješ lásku činy – nejen slovy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndgribelig støtte. Når nogen har det svært, viser du kærlighed med handling – ikke kun med ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greifbare Unterstützung. Wenn es jemandem schlecht geht, zeigst du Liebe durch Taten – nicht nur mit Worten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στήριξη που πιάνεται. Όταν κάποιος περνάει δύσκολα, δείχνεις την αγάπη σου με πράξεις — όχι μόνο με λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoyo tangible. Cuando alguien lo pasa mal, demuestras tu amor con hechos, no solo con palabras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkreettista tukea. Kun joku on ahdingossa, näytät rakkautesi teoilla etkä pelkillä sanoilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportang nahahawakan. Ipinapakita mo ang pagmamahal sa gawa kapag may nahihirapan — hindi lang sa salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un soutien tangible. Quand quelqu'un traverse une passe difficile, tu montres ton amour par des actes, pas seulement par des mots."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמיכה מוחשית. כשלמישהו קשה, האהבה שלך מתבטאת במעשים — לא רק במילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठोस मदद। जब कोई परेशान हो, तो आपका प्यार सिर्फ़ बातों में नहीं, काम में दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kézzelfogható támogatás. Ha valaki nehéz helyzetben van, tettekkel mutatod ki a szereteted – nem csak szavakkal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan yang nyata. Kamu menunjukkan cinta lewat tindakan saat seseorang sedang kesulitan — bukan cuma kata-kata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sostegno concreto. Quando qualcuno è in difficoltà, dimostri amore con i fatti, non solo con le parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形のあるサポート。相手が苦しいとき、言葉だけでなく行動で愛情を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손에 잡히는 도움을 줘요. 누군가 힘들어할 때 말뿐 아니라 행동으로 사랑을 보여 주죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokongan yang nyata. Anda tunjukkan kasih sayang melalui tindakan bila seseorang sedang susah — bukan sekadar kata-kata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndfast støtte. Du viser kjærlighet gjennom handling når noen har det tungt – ikke bare med ord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastbare steun. Als iemand het zwaar heeft, laat je je liefde zien in daden – niet alleen in woorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretne wsparcie. Gdy ktoś ma trudny czas, okazujesz miłość czynami – nie tylko słowami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoio concreto. Quando alguém está mal, você demonstra amor com atitudes — não só com palavras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprijin palpabil. Când cineva trece printr-un moment greu, îți arăți iubirea prin fapte — nu doar prin vorbe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ощутимая поддержка. Когда человеку тяжело, ты выражаешь любовь делом, а не только словами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handfast stöd. När någon har det tufft visar du kärlek genom handling – inte bara ord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซัพพอร์ตที่จับต้องได้ เวลาใครกำลังลำบาก คุณแสดงความรักผ่านการลงมือทำ ไม่ใช่แค่คำพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somut destek. Biri zor bir dönemden geçerken sevgini sadece sözle değil, eylemle gösteriyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відчутна підтримка. Коли комусь важко, ти показуєш любов ділами, а не лише словами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nâng đỡ bằng việc làm cụ thể. Khi ai đó gặp khó, bạn thể hiện yêu thương bằng hành động — không chỉ bằng lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看得见的支持。有人难过时，你用行动而不只是言语来表达爱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看得見的支持。有人在難關裡時，你用行動表達愛，而不只是說說。"
          }
        }
      }
    },
