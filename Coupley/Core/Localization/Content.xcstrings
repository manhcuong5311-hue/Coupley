        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mãos ocupadas destravam conversas tranquilas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când mâinile sunt ocupate, vorbele vin mai ușor."
