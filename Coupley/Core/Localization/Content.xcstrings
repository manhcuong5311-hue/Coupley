    "Exercise or move — burn it off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رياضة أو حركة — لتفريغ التوتر"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hýbu se – vybiju to ze sebe"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træne eller bevæge mig – brænde det af"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mache ich Sport – raus damit"
          }
        },
        "el" : {
