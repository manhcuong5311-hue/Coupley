        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोजच्या देखभालीपेक्षा अधूनमधून मोठा प्रयत्न. दोघांच्या अपेक्षा जुळल्या, तर हे छान चालते."
