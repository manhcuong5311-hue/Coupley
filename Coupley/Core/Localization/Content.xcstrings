        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टहलने से कॉर्टिसोल घटता है, और साथ-साथ चलना आमने-सामने बैठने से आसान है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A séta csökkenti a kortizolt, és egymás mellett könnyebb, mint szemtől szemben."
