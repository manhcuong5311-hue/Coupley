        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקופה של תנועה ואפשרויות. הצד השני צריך לדעת שזה מגיע — מבחינת הכנסה, זמן וכוחות רגשיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उथल-पुथल और संभावनाओं का दौर। आपके पार्टनर को पता होना चाहिए कि आगे क्या है — कमाई, समय और भावनात्मक ऊर्जा, तीनों के लिहाज़ से।"
