          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibikorwa byiza kurusha ibindi biba bikwihariye — iki kibazo kigaragaza icyo “kwihariye” bisobanuye kuri wowe."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හොඳම දේවල් දැනෙන්නේ පෞද්ගලිකව — ඔබට “පෞද්ගලික” කියන්නේ මොකක්ද කියලා මෙයින් පෙනෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najkrajšie gestá sú osobné – toto ukáže, čo „osobné“ znamená pre teba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepše geste so osebne – to razkriva, kaj zate pomeni „osebno“."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zviito zvakanakisa zvinonzwika sezvakaitirwa iwe chaiwe — izvi zvinoratidza kuti “zvako chaizvo” zvinorevei kwauri."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadaallada ugu qurxoon waa kuwa qofka u gaar ah — tani waxay muujinaysaa waxa “gaar” kula yahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjestet më të bukura ndihen personale – kjo zbulon çfarë do të thotë „personale“ për ty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Најлепши гестови су лични — ово открива шта за тебе значи „лично“."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikep anu pangsaéna karaos pribadi — ieu nembongkeun naon hartosna “pribadi” pikeun anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bästa gesterna känns personliga – det här visar vad ”personligt” betyder för dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishara bora huhisiwa kuwa za kibinafsi — hili linaonyesha “kibinafsi” kunamaanisha nini kwako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சிறந்த அன்புச் செயல்கள் தனிப்பட்டதாக உணர வைக்கும் — “தனிப்பட்டது” என்றால் உங்களுக்கு என்ன என்பதை இது காட்டுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మంచి పనులు వ్యక్తిగతంగా అనిపిస్తాయి — “వ్యక్తిగతం” అంటే మీకు ఏమిటో ఇది చెబుతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Беҳтарин ишораҳо шахсӣ ҳис мешаванд — ин нишон медиҳад, ки «шахсӣ» барои ту чӣ маъно дорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความใส่ใจที่ดีที่สุดคือความใส่ใจที่เป็นเรื่องเฉพาะตัว คำถามนี้จะเผยว่า “เฉพาะตัว” สำหรับคุณหมายถึงอะไร"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝበለጹ ተግባራት ውልቃዊ ይመስሉ — እዚ «ውልቃዊ» ንዓኹም እንታይ ማለት ምዃኑ የርኢ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iň gowy alada şahsy duýulýar — bu seniň üçin “şahsy” sözüniň manysyny açýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En güzel jestler kişiye özel hissettirir; bu soru, senin için “kişiye özel”in ne demek olduğunu gösteriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкращі жести — особисті. Тут видно, що «особисте» означає саме для тебе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہترین انداز وہ ہوتے ہیں جو ذاتی لگیں — اس سے پتا چلتا ہے کہ آپ کے لیے “ذاتی” کا مطلب کیا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eng yaxshi eʼtibor shaxsiy boʻladi — bu savol siz uchun «shaxsiy» nimani anglatishini koʻrsatadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những cử chỉ đẹp nhất luôn mang dấu ấn riêng — câu này cho thấy “riêng” với bạn là gì."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezona zenzo zintle zivakala zezakho ngqo — oku kubonisa ukuba “okwakho ngqo” kuthetha ntoni kuwe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn ìṣe tó dára jù máa ń jẹ́ ti ara ẹni — èyí ń fi ohun tí “ti ara ẹni” túmọ̀ sí fún yín hàn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好的心意都是為你而設的，這題能看出你心中的「專屬」是甚麼模樣。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最打动人的心意总是专属于你的——这能看出“专属”对你意味着什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好的心意都是專屬於你的，這題能看出你心中的「專屬」是什麼樣子。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izenzo ezinhle kakhulu zizwakala ziqondene nawe — lokhu kuveza ukuthi “okuqondene nawe” kusho ukuthini kuwe."
          }
        }
      }
    },
    "The build-up is your thing. You're funnier in person than in a text — and your stories improve with every retelling." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die opbou is jou ding. Jy is snaakser in persoon as in ’n boodskap – en jou stories word beter met elke keer wat jy dit vertel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀስ ብሎ ማዘጋጀት የእርስዎ ነገር ነው። ከጽሑፍ መልዕክት ይልቅ በአካል ይበልጥ አስቂኝ ነዎት — ታሪኮችዎም በተነገሩ ቁጥር ይሻሻላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التمهيد هو ملعبكم. أنتم أظرف وجهًا لوجه منكم في الرسائل، وقصصكم تتحسّن مع كل إعادة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধীৰে ধীৰে গঢ়ি তোলাটোৱেই আপোনাৰ কৌশল। মেছেজতকৈ মুখামুখিকৈ আপুনি বেছি হাস্যকৰ — আৰু প্ৰতিবাৰ কওঁতে আপোনাৰ কাহিনী আৰু ভাল হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sənin gücün gərginliyi yığmaqdadır. Canlı söhbətdə mesajdakından daha gülməlisən — və hekayələrin hər dəfə danışdıqca daha yaxşı olur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тваё — гэта нарастанне. Ужывую твае жарты працуюць лепш, чым у перапісцы, — а гісторыі становяцца лепшымі з кожным пераказам."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Силата ти е в натрупването. На живо разсмиваш повече, отколкото в съобщение – и историите ти стават по-добри с всеки преразказ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধীরে ধীরে জমিয়ে তোলাই তোমার কারিশমা। টেক্সটের চেয়ে সামনাসামনি তুমি বেশি মজার — আর প্রতিবার বলায় তোমার গল্প আরও জমে ওঠে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja snaga je u građenju poente. Uživo je s tobom smiješnije nego u poruci – a tvoje priče postaju sve bolje sa svakim prepričavanjem."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu fort és la preparació. Fas més gràcia en persona que per missatge — i les teves històries milloren cada cop que les expliques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje silná stránka je gradace. Naživo jsi vtipnější než ve zprávě – a tvoje historky jsou s každým vyprávěním lepší."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yr adeiladu yw dy beth di. Rwyt ti'n fwy doniol wyneb yn wyneb nag mewn neges — ac mae dy straeon yn gwella bob tro rwyt ti'n eu hadrodd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbygningen er din styrke. Du er sjovere i virkeligheden end på skrift – og dine historier bliver bedre for hver gang, du fortæller dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spannungsaufbau ist dein Ding. Persönlich bist du lustiger als per Nachricht – und deine Geschichten werden mit jedem Erzählen besser."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χτίσιμο της ιστορίας είναι το δυνατό σου σημείο. Έχεις πιο πολλή πλάκα από κοντά παρά σε μήνυμα — και οι ιστορίες σου γίνονται καλύτερες κάθε φορά που τις λες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo tuyo es crear expectación. Tienes más gracia en persona que por mensaje, y tus historias mejoran cada vez que las cuentas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu tugevus on pinge kasvatamine. Oled näost näkku naljakam kui sõnumis — ja su lood paranevad iga ümberjutustusega."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixkanaka eraikitzea da zure kontua. Barregarriagoa zara aurrez aurre mezu batean baino, eta zure istorioak hobetu egiten dira kontatzen dituzun aldiro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زمینه‌چینی کار توست. رودررو خیلی بامزه‌تری تا در پیام — و قصه‌هایت هر بار که دوباره تعریفشان می‌کنی بهتر می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohjustus on sinun juttusi. Olet hauskempi kasvokkain kuin viestissä – ja tarinasi paranevat joka kerralla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang build-up ang galing mo. Mas nakakatawa ka nang personal kaysa sa text — at gumaganda ang mga kuwento mo sa bawat ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton truc, c'est la montée en puissance. Tu es plus drôle en vrai que par message, et tes histoires s'améliorent à chaque fois que tu les racontes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an t-ullmhúchán do bhua. Bíonn tú níos greannmhaire aghaidh ar aghaidh ná i dteachtaireacht — agus feabhsaíonn do scéalta gach uair a insíonn tú iad."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu é ir preparando o terreo. Tes máis graza en persoa ca por mensaxe, e as túas historias melloran cada vez que as contas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "માહોલ બાંધવો એ તમારી ખાસિયત છે. ટેક્સ્ટ કરતાં રૂબરૂ તમે વધુ રમૂજી છો — અને દરેક વખતે કહેતાં તમારી વાર્તા વધુ જામે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gina labari a hankali shi ne gwaninku. Kun fi ban dariya ido da ido fiye da a saƙo — kuma labaranku na ƙara daɗi duk lokacin da aka sake faɗarsu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבנייה היא הכוח שלך. פנים מול פנים יש לך הרבה יותר הומור מאשר בהודעה — והסיפורים שלך משתבחים בכל פעם שמספרים אותם מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माहौल बनाना आपकी ख़ूबी है। आप मैसेज से ज़्यादा आमने-सामने मज़ेदार हैं — और आपके क़िस्से हर बार सुनाने पर और निखरते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja je jača strana građenje napetosti. Uživo ti humor bolje dolazi do izražaja nego u poruci – a priče ti postaju bolje sa svakim prepričavanjem."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte istwa a, se sa ou fè pi byen. Ou pi komik an pèsòn pase nan yon mesaj — e istwa ou vin pi bon chak fwa ou rakonte yo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felvezetés a te tereped. Élőben viccesebb vagy, mint üzenetben – és a történeteid minden újramesélésnél jobbak lesznek."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո ուժը նախապատրաստությունն է։ Կենդանի շփման մեջ ավելի զվարճալի ես, քան նամակներում, և պատմություններդ ամեն անգամ ավելի լավն են դառնում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membangun suasana adalah keahlianmu. Kamu lebih lucu langsung daripada lewat chat — dan ceritamu makin seru setiap kali diceritakan ulang."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwulite akụkọ bụ ihe gị. Ị na-atọkarị ọchị n'ihu mmadụ karịa n'ozi — akụkọ gị na-akawanye mma oge ọ bụla ị kọrọ ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppbyggingin er þín sterka hlið. Þú ert fyndnari í eigin persónu en í skilaboðum – og sögurnar þínar batna í hvert sinn sem þú segir þær."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo forte è la costruzione. Fai più ridere dal vivo che per messaggio, e le tue storie migliorano a ogni racconto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前振りこそ腕の見せどころ。メッセージより会って話すほうが面白くて、同じ話も語るたびに磨きがかかります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbangun crita iku kesenengan panjenengan. Panjenengan luwih lucu yen ketemu langsung tinimbang liwat pesen — lan crita panjenengan saya apik saben dicritakake maneh."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი ძალა თანდათანობით მომზადებაა. პირისპირ უფრო სასაცილო ხარ, ვიდრე მესიჯში — და შენი ამბები ყოველი მოყოლისას უკეთესდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шиеленісті біртіндеп құру — сенің ісің. Хабарламадан гөрі бетпе-бет әлдеқайда күлкілісің, әңгімелерің әр қайталаған сайын жақсара түседі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការរៀបរាប់បណ្ដើរៗជាចំណុចខ្លាំងរបស់អ្នក។ អ្នកកំប្លែងពេលនៅមុខគ្នា ជាងតាមសារ — ហើយរឿងរបស់អ្នកកាន់តែល្អរាល់ពេលនិទានឡើងវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕುತೂಹಲ ಕಟ್ಟುವುದೇ ನಿಮ್ಮ ಶೈಲಿ. ಮೆಸೇಜ್‌ಗಿಂತ ಎದುರಿಗೆ ನೀವು ಹೆಚ್ಚು ತಮಾಷೆ — ಮತ್ತು ಪ್ರತಿ ಬಾರಿ ಹೇಳಿದಾಗಲೂ ನಿಮ್ಮ ಕಥೆಗಳು ಇನ್ನಷ್ಟು ಚೆನ್ನಾಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드업이 특기예요. 문자보다 직접 만났을 때 더 웃기고, 이야기는 할 때마다 더 재밌어져요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amadekirina henekê tiştê te ye. Tu rû bi rû ji di peyamekê de bêtir dikenînî — û çîrokên te her ku tu wan dîsa vedibêjî xweştir dibin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенин күчүң — окуяны акырындап өрчүтүү. Билдирүүдөн көрө жүзмө-жүз күлкүлүүрөөксүң — жана окуяларың ар бир кайталаган сайын жакшыра берет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Opbau ass däin Ding. Perséinlech bass du méi witzeg wéi per SMS — an deng Geschichte gi mat all Kéier besser, wous de se erziels."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການປູເລື່ອງຄືຈຸດເດັ່ນຂອງເຈົ້າ ເຈົ້າຕະຫຼົກກວ່າເມື່ອເຈິໜ້າກັນ ຫຼາຍກວ່າໃນຂໍ້ຄວາມ — ແລະ ເລື່ອງຂອງເຈົ້າມ່ວນຂຶ້ນທຸກເທື່ອທີ່ເລົ່າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo stiprybė – įžanga. Gyvai tavo humoras veikia geriau nei žinutėse – o istorijos su kiekvienu perpasakojimu tik gerėja."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tava stiprā puse ir iesildīšanās. Klātienē tavs humors darbojas labāk nekā īsziņās – un tavi stāsti kļūst labāki ar katru reizi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fanomanana no anjaranao. Mahatsikaiky kokoa ianao rehefa mifanatrika noho ny amin'ny hafatra soratana — ary mihatsara isaky ny averinao ny tantaranao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te whakapiki haere tāu. He kata ake koe kanohi ki te kanohi i tētahi karere — ā, ka pai ake ō kōrero i ia whakahua anō."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градењето напнатост е твојата сила. Твојот хумор е подобар во живо отколку во порака — а приказните ти стануваат подобри со секое раскажување."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പടിപടിയായി കൊണ്ടുവരുന്നതാണ് നിങ്ങളുടെ ശൈലി. മെസേജിനേക്കാൾ നേരിട്ടാണ് നിങ്ങൾ കൂടുതൽ രസകരം — ഓരോ തവണ പറയുമ്പോഴും നിങ്ങളുടെ കഥകൾ കൂടുതൽ മെച്ചപ്പെടും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аажмаар өрнүүлэх нь чиний онцлог. Мессежээс илүү биечлэн инээдтэй — түүхүүд чинь дахин ярих бүрт илүү сайхан болдог."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हळूहळू रंगवत नेणे ही तुमची खासियत. मेसेजपेक्षा प्रत्यक्ष भेटीत तुम्ही जास्त मजेदार असता — आणि तुमचे किस्से प्रत्येक वेळी सांगताना अधिक रंगतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membina suspens memang kepakaran anda. Anda lebih kelakar secara bersemuka berbanding melalui mesej — dan cerita anda semakin menarik setiap kali diulang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-bini tas-suspens huwa l-qawwa tiegħek. Tagħmel aktar daħq wiċċ imb wiċċ milli f'messaġġ — u l-istejjer tiegħek jitjiebu kull darba li terġa' tgħidhom."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "တဖြည်းဖြည်း တည်ဆောက်သွားတာက သင့်အားသာချက်ပါ။ စာတိုထက် မျက်နှာချင်းဆိုင် ပိုရယ်စရာကောင်းတယ် — ပြန်ပြောလေ သင့်ဇာတ်လမ်းတွေ ပိုကောင်းလာလေပါပဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppbyggingen er din greie. Du er morsommere ansikt til ansikt enn på melding – og historiene dine blir bedre for hver gang du forteller dem."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिस्तारै माहोल बनाउनु तपाईंको खुबी हो। तपाईं म्यासेजमा भन्दा आमनेसामने बढी रमाइलो हुनुहुन्छ — र तपाईंका कथा हरेक पटक भन्दा झन् राम्रा हुन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opbouw is jouw ding. Je bent grappiger in het echt dan in een appje – en je verhalen worden bij elke keer vertellen beter."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumanga nkhani ndiye luso lanu. Ndinu oseketsa kwambiri pamaso kuposa pa uthenga — ndipo nkhani zanu zimakoma kwambiri nthawi iliyonse mukazinenanso."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuta suutaan ijaaruun kan kee ti. Ergaa barreeffamaa caalaa fuula duratti caalaa nama kolfisiifta — seenaawwan kees yeroo deebitee himtu hunda fooyya'u."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଧୀରେ ଧୀରେ ଗଢ଼ି ତୋଳିବା ହିଁ ଆପଣଙ୍କ କଳା। ମେସେଜ୍ ଅପେକ୍ଷା ସାମ୍ନାସାମ୍ନି ଆପଣ ଅଧିକ ମଜାଳିଆ — ଆଉ ପ୍ରତିଥର କହିଲେ ଆପଣଙ୍କ କାହାଣୀ ଆହୁରି ଭଲ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੱਲ ਨੂੰ ਬੰਨ੍ਹਣਾ ਤੁਹਾਡੀ ਖ਼ੂਬੀ ਹੈ। ਤੁਸੀਂ ਮੈਸੇਜ ਨਾਲੋਂ ਆਹਮੋ-ਸਾਹਮਣੇ ਵੱਧ ਮਜ਼ੇਦਾਰ ਹੋ — ਅਤੇ ਤੁਹਾਡੀਆਂ ਕਹਾਣੀਆਂ ਹਰ ਵਾਰ ਸੁਣਾਉਣ ਨਾਲ ਹੋਰ ਵਧੀਆ ਹੁੰਦੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja specjalność to budowanie napięcia. Na żywo bawisz bardziej niż w wiadomościach – a twoje historie są lepsze z każdym opowiedzeniem."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د کیسې جوړول ستاسو کار دی. ستاسو طنز مخامخ تر پیغام ډېر اغېز لري — او کیسې مو په هر ځل بیا ویلو ښې کېږي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A construção é a sua praia. Você tem mais graça ao vivo do que por mensagem — e suas histórias melhoram a cada vez que são contadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A construção é o teu forte. Tens mais graça ao vivo do que por mensagem — e as tuas histórias melhoram de cada vez que as contas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punctul tău forte e construcția. Faci mai mult haz în persoană decât în scris — iar poveștile tale devin mai bune cu fiecare repovestire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя сила — в подводке. Вживую ты смешнее, чем в переписке, а твои истории становятся лучше с каждым пересказом."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gutegura inkuru ni byo byawe. Usekeje cyane imbonankubone kurusha mu butumwa — kandi inkuru zawe ziryoha uko uzisubiramo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ක්‍රමයෙන් ගොඩනැගීම තමයි ඔබේ විශේෂත්වය. මැසේජ් එකකට වඩා ඔබ මුහුණට මුහුණ හමුවෙද්දී වැඩියෙන් හිනායන සුළුයි — ඔබේ කතා කියන හැම වතාවකම තවත් හොඳ වෙනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja sila je v gradácii. Naživo ti to ide lepšie než v správe – a tvoje príbehy sú s každým ďalším rozprávaním lepšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja moč je stopnjevanje. Tvoj humor bolj zaživi v živo kot v sporočilu – in tvoje zgodbe so z vsakim pripovedovanjem boljše."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaka nyaya ndiko kwaunogona. Unosetsa zvakanyanya uri pamberi pemunhu kupfuura pameseji — uye nyaya dzako dzinonaka nguva imwe neimwe yaunodzidzokorora."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhisidda sheekada ayaad ku fiican tahay. Fool-ka-fool ayaad uga qosol badan tahay fariin qoraal ah — sheekooyinkaaguna way sii fiicnaadaan mar kasta oo aad dib u sheegto."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përgatitja e momentit është forca jote. Live të del më shumë humor sesa me mesazh – dhe historitë e tua përmirësohen sa herë i tregon."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоја ствар је увод. Уживо ти иде боље него у поруци — и приче ти постају све боље са сваким препричавањем."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngawangun carita téh kaahlian anjeun. Anjeun langkung lucu langsung tibatan dina pesen, sareng carita anjeun langkung saé unggal dicarioskeun deui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppbyggnaden är din grej. Du är roligare på riktigt än i sms – och dina historier blir bättre för varje gång du drar dem."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujenga hadithi ndiko kwako. Unachekesha zaidi ana kwa ana kuliko kwenye ujumbe — na hadithi zako huboreka kila unapozisimulia tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "படிப்படியாக உச்சத்திற்குக் கொண்டு செல்வதுதான் உங்கள் பலம். மெசேஜைவிட நேரில் அதிக வேடிக்கையானவர் — ஒவ்வொரு முறை சொல்லும்போதும் உங்கள் கதைகள் மெருகேறும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బిల్డప్ మీ ప్రత్యేకత. మెసేజ్‌లో కన్నా ఎదురుగా ఉన్నప్పుడే మీరు ఎక్కువ నవ్విస్తారు — మీ కథలు చెప్పిన ప్రతిసారీ మెరుగవుతాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳунари ту — тайёр кардани шӯхӣ. Ту рӯ ба рӯ аз паём хандаовартарӣ — ва қиссаҳоят бо ҳар бозгӯӣ беҳтар мешаванд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปูเรื่องคือจุดแข็งของคุณ เจอตัวจริงคุณตลกกว่าในแชท และเรื่องเล่าของคุณยิ่งเล่ายิ่งสนุก"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እቲ ምድላው ናትኩም እዩ። ብመልእኽቲ ካብ ዝኾነ ብኣካል ዝያዳ ተስሕቑ — ዛንታታትኩም ድማ ኣብ ነፍሲ ወከፍ ምድጋም ይምሕየሹ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seniň güýjüň — hekaýany ýuwaş-ýuwaşdan gurmak. Ýüzbe-ýüz gürleşeňde hatdakydan has gülkünç — we hekaýalaryň her gezek aýdanyňda gowulanýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin gücün espriyi adım adım kurmak. Yüz yüzeyken mesajdakinden çok daha komiksin ve hikâyelerin her anlatışta daha da güzelleşiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя сила — у підводці. Наживо в тебе виходить смішніше, ніж у повідомленнях, а твої історії стають кращими з кожним переказом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمہید باندھنا آپ کا کمال ہے۔ آپ کا مزاح میسج سے زیادہ آمنے سامنے چلتا ہے، اور آپ کے قصے ہر بار سنانے پر مزید نکھر جاتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizning kuchingiz — asta-sekin avjga chiqarish. Jonli suhbatda xabardagidan kulgiliroqsiz — hikoyalaringiz esa har safar qayta aytilganda yaxshilanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thế mạnh của bạn là màn dẫn dắt. Gặp trực tiếp, bạn hài hước hơn hẳn qua tin nhắn — và câu chuyện của bạn càng kể lại càng hay."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukwakha ibali yinto yakho. Uhlekisa ngakumbi ubuso ngobuso kunakumyalezo — kwaye amabali akho aya esiba ngcono ngokuphindwa kwawo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kíkọ́ ìtàn dé òkè ni tiyín. Ẹ dùn jù lójúkojú ju nínú àtẹ̀jíṣẹ́ — ìtàn yín sì ń dára sí i ní gbogbo ìgbà tí ẹ bá tún un sọ."
          }
        },
