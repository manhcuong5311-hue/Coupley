        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іноді найкраще побачення — те, на яке нікому не треба взуватися. Затишок і простота важливіші за антураж."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کبھی بہترین ڈیٹ وہی ہوتی ہے جس میں کسی کو جوتے پہننے کی ضرورت نہ پڑے۔ ماحول سے زیادہ آرام اور آسانی۔"
