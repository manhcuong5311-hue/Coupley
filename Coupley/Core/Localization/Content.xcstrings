        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri saya ruang bertenang sendiri dulu"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi meg rom til å lande alene først"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
