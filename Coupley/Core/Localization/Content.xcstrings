            "state" : "translated",
            "value" : "Быць побач з сям’ёй і бачыць, як усе растуць"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да съм близо до семейството и да гледам как растат"
