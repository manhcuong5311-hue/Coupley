        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमानदार जवाब। ज़्यादातर लोग इसी जगह हैं। इसे परखने की इच्छा ही सबसे अहम है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskreno. Većina ljudi je u istoj situaciji. Spremnost da to istražiš najvažniji je dio."
          }
        },
        "ht" : {
