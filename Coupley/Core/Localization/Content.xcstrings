        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubudlelwane obungenalo uvuyo abunakuqhubeka. Ufuna umntu onokuhlekisa, adlale, akhaphukhaphe nokuba ubomi abunjalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbáṣepọ̀ láìsí ayọ̀ kò lè pẹ́. Ẹ nílò ẹni tó lè pani lẹ́rìn-ín, ṣe yẹ̀yẹ́, kí ọkàn rẹ̀ sì fúyẹ́ kódà nígbà tí ayé kò rí bẹ́ẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有快樂的感情難以長久。你需要一個在生活不輕鬆時，依然能搞笑、傻氣、輕鬆的人。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有快乐的感情难以长久。你需要一个即使生活不轻松，也能逗趣、犯傻、保持轻松的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
