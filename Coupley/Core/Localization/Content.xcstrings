        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဖြေရှင်းချက်ကို အာရုံစိုက်တယ်။ ဆက်ဆံရေးက အမြင်မတူမှုထက် ပိုကြီးတယ်လို့ သင် မြင်တယ်။ ဒါက တကယ့် အားသာချက်ပါ။"
