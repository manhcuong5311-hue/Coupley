        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus pada masa kini. Anda bukan jenis yang merancang jangka panjang — atau anda cukup muda sehingga ini terasa teori semata-mata."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-preżent l-ewwel. L-ippjanar fit-tul mhux il-forza tiegħek — jew forsi l-irtirar għadu 'l bogħod tant li jidher teoretiku."
