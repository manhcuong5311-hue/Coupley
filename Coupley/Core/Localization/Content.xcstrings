        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท้องฟ้าตรงที่คุณอยู่"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ዘለኹምዎ ቦታ ዘሎ ሰማይ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulunýan ýeriňdäki asman."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulunduğun yerdeki gökyüzü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Небо там, де ти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاں آپ ہیں، وہاں کا آسمان۔"
