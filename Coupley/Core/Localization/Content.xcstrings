        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமநிலை. நீங்கள் கண்காணிக்க விரும்புவதில்லை, ஆனால் ஒருவர் பாதி மனதோடு மட்டும் இருக்கும்போது கவனிக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమతుల్యత. మీరు కాపలా కాయాలనుకోరు, కానీ ఎవరైనా సగం మాత్రమే ఇక్కడ ఉంటే గమనిస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мувозинат. Ту намехоҳӣ назоратчӣ бошӣ, вале пай мебарӣ, вақте касе танҳо нимаш ҳозир аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
