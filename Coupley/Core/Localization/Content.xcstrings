          "stringUnit" : {
            "state" : "translated",
            "value" : "Consigue algo pequeño que le encante: su snack, bebida o flor favorita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hae jokin pieni lempiasia – hänen vakiovälipalansa, -juomansa tai kukka."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibili siya ng maliit na paborito — meryenda, inumin, o bulaklak na gusto niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporte un de ses petits plaisirs : son en-cas préféré, sa boisson, une fleur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להביא משהו קטן ואהוב — הנשנוש, המשקה או הפרח הקבועים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी कोई छोटी पसंदीदा चीज़ ले आएँ — पसंदीदा स्नैक, ड्रिंक, फूल।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegyél neki egy kis kedvencet – a szokásos nasiját, italát, virágát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belikan hal kecil favoritnya — camilan, minuman, atau bunga andalannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi una piccola cosa che ama — il suo snack preferito, una bevanda, un fiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつものおやつや飲みもの、好きな花など、ちょっとした好きなものを買ってきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "늘 먹는 간식, 음료, 꽃처럼 연인이 좋아하는 작은 걸 사 가세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belikan sesuatu kegemarannya — snek, minuman atau bunga kesukaannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøp en liten favoritt – yndlingssnacksen, -drikken eller -blomsten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal iets kleins wat je partner lekker vindt – een favoriete snack, drankje, bloem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kup drobiazg, który druga połówka uwielbia – jej ulubioną przekąskę, napój, kwiat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve um pequeno agrado — o lanche, a bebida ou a flor preferida do seu amor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia ceva mic din ce îi place — gustarea, băutura sau floarea preferată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захвати что-нибудь любимое — привычный перекус, напиток, цветок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp med något litet din partner älskar – ett snacks, en dryck, en blomma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อของโปรดเล็กๆ ติดมือไป ขนมประจำ เครื่องดื่ม หรือดอกไม้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevdiği küçük bir şey al: favori atıştırmalığı, içeceği, çiçeği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купи щось маленьке з улюбленого половинки — смаколик, напій, квітку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một món nhỏ người ấy thích — đồ ăn vặt, thức uống quen thuộc, một bông hoa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顺手带一样另一半的心头好：常吃的零食、爱喝的饮料、一束花。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帶一樣對方愛的小東西：常吃的零食、飲料或一束花。"
          }
        }
      }
    },
