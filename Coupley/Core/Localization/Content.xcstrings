          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองวาดภาพชีวิตที่คุณทั้งสองจะได้ใช้ร่วมกัน ถ้าทุกอย่างเป็นไปด้วยดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayal et: her şey yolunda giderse ikinizin nasıl bir hayatı olurdu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиши, яким було б ваше спільне життя, якби все склалося добре."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy vẽ ra bức tranh — cuộc sống mà hai bạn sẽ có nếu mọi thứ suôn sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描绘一下：如果一切顺利，你们俩会过着怎样的生活。"
