        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যক্তিগত কথা ব্যক্তিগতই থাকিব লাগে। ৰাজহুৱাকৈ দোষ দিয়াটো আপোনাৰ বাবে সন্মানৰ মৌলিক উলংঘন যেন লাগে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şəxsi məsələlər şəxsi qalmalıdır. İnsanların yanında tənqid olunmaq sənə hörmətin kobud şəkildə pozulması kimi gəlir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Асабістае застаецца асабістым. Публічныя папрокі — гэта для цябе грубае парушэнне павагі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личното си остава лично. Публичното порицание е тежко нарушение на уважението."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যক্তিগত কথা ব্যক্তিগতই থাকবে। সবার সামনে কিছু ধরিয়ে দেওয়া তোমার কাছে সম্মানের মৌলিক লঙ্ঘন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privatno ostaje privatno. Javno prozivanje doživljavaš kao ozbiljno kršenje poštovanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El que és privat es queda en privat. Que t'exposin en públic et sembla una falta greu de respecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromé věci zůstávají v soukromí. Veřejné výtky jsou pro tebe zásadní porušení respektu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae materion preifat yn aros yn breifat. Mae cael dy feirniadu'n gyhoeddus yn teimlo fel torri parch yn sylfaenol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private ting forbliver private. At blive sat på plads offentligt føles som et grundlæggende brud på respekten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privates bleibt privat. Vor anderen bloßgestellt zu werden, fühlt sich für dich zutiefst respektlos an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προσωπικά μένουν προσωπικά. Το να σε εκθέτουν δημόσια το νιώθεις ως βαθιά έλλειψη σεβασμού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo privado se queda en privado. Que te expongan en público te parece una falta de respeto fundamental."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isiklikud asjad jäävad isiklikuks. Avalikult noomimine tundub sulle põhimõttelise lugupidamatusena."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gauza pribatuak pribatu. Jendaurrean seinalatua izatea errespetuaren funtsezko haustura iruditzen zaizu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسائل خصوصی باید خصوصی بمانند. اینکه جلوی جمع ایراد بگیرند، برایت زیر پا گذاشتن اساسی احترام است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityiset asiat pysyvät yksityisinä. Julkinen moittiminen tuntuu perustavanlaatuiselta kunnioituksen rikkomiselta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pribadong usapan ay dapat manatiling pribado. Ang mapuna sa harap ng iba ay parang paglabag sa pinakapangunahing respeto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est privé reste privé. Se faire reprendre en public, c'est pour toi un vrai manque de respect."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanann cúrsaí príobháideacha príobháideach. Nuair a cháintear go poiblí thú, braitheann sé mar shárú bunúsach ar an meas."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O privado queda no privado. Que che chamen a atención en público paréceche unha falta de respecto fundamental."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અંગત વાતો અંગત જ રહેવી જોઈએ. બધાંની સામે ટોકવામાં આવે એ તમને સન્માનનો મૂળભૂત ભંગ લાગે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abin sirri ya zauna a sirri. Kunyatar da ku a bainar jama'a na zama kamar keta girmamawa ta asali."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עניינים פרטיים נשארים פרטיים. ביקורת בפומבי מרגישה לך כמו פגיעה בסיסית בכבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी बातें निजी रहनी चाहिए। सबके सामने टोका जाना आपको सम्मान का बुनियादी उल्लंघन लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privatne stvari ostaju privatne. Javno prozivanje doživljavaš kao temeljno kršenje poštovanja."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ki prive rete prive. Lè yo repwoche ou devan moun, ou santi se yon gwo mank respè."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A magánügy maradjon magánügy. Ha nyilvánosan tesznek szóvá valamit, azt a tisztelet súlyos megsértéseként éled meg."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անձնականը պետք է անձնական մնա։ Հրապարակավ նկատողություն ստանալը քեզ համար հարգանքի կոպիտ խախտում է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urusan pribadi tetap pribadi. Ditegur di depan umum terasa seperti pelanggaran rasa hormat yang mendasar."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe nzuzo ka bụ nzuzo. Ịkatọ gị n'ihu ọha na-adị ka imebi nkwanye ugwu n'isi ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einkamál eiga að vera einkamál. Opinber gagnrýni er grundvallarbrot á virðingu að þínu mati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cose private restano private. Una critica in pubblico ti sembra una profonda mancanza di rispetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりのことはふたりの間で。人前で責められるのは、根本的に敬意を欠いた行為だと感じます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bab pribadi tetep pribadi. Diunekake ing ngarepe wong akeh rasane kaya nglanggar rasa ajen sing paling dhasar."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პირადი პირადად უნდა დარჩეს. საჯაროდ შენიშვნა პატივისცემის ფუნდამენტურ დარღვევად გეჩვენება."
