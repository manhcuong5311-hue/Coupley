        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du liker dyr uten å ville binde deg helt akkurat nå. Det kan endre seg – eller ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt van dieren, maar wilt nu nog niet de volle verantwoordelijkheid. Dat kan veranderen – of niet."
