    "The most balanced take. Possibly the most well-adjusted person in this quiz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقف الأكثر توازنًا. ربما أكثر الناس اتزانًا في هذا الاختبار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejvyváženější postoj. Možná nejvyrovnanější člověk v celém kvízu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mest afbalancerede holdning. Muligvis den mest velfungerende person i hele quizzen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
