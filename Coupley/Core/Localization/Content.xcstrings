        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزانہ دیکھ بھال کے بجائے وقفے وقفے سے محنت۔ جب تک توقعات ایک جیسی ہوں، یہ ٹھیک چلتا ہے۔"
