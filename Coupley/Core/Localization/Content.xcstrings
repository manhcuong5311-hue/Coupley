    "Join them wherever they are. Don't fill the air — just be there." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaan sit by jou maat, waar ook al. Moenie die stilte vul nie – wees net daar."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባሉበት ቦታ አብረዋቸው ይሁኑ። ዝምታውን ለመሙላት አይሞክሩ — እዚያ ብቻ ይሁኑ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضموا إلى شريكك أينما كان. لا تملؤوا الأجواء بالكلام، فقط كونوا هناك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তেওঁ য'তেই থাকক, তাতে গৈ লগ দিয়ক। কথাৰে বতাহ ভৰাব নালাগে — মাথোঁ কাষত থাকক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harada olursa, yanına get. Sükutu doldurmağa çalışma — sadəcə yanında ol."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далучыся да палавінкі, дзе б яна ні была. Не запаўняй цішыню — проста будзь побач."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иди при нея, където и да е. Не пълни тишината – просто бъди там."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ও যেখানে আছে, সেখানে গিয়ে যোগ দাও। কথায় ভরিয়ে দিয়ো না — শুধু পাশে থাকো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridruži se voljenoj osobi gdje god da je. Ne popunjavaj tišinu – samo budi tu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes-li companyia allà on sigui. No cal omplir el silenci — només ser-hi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej se k protějšku, ať je kdekoli. Nevyplňuj ticho – prostě buď nablízku."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd gyda dy bartner, lle bynnag y bo. Paid â llenwi'r tawelwch — dim ond bod yno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dig ned, hvor din partner er. Du behøver ikke fylde stilheden – bare vær der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh dahin, wo dein Schatz gerade ist. Füll die Stille nicht – sei einfach da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πήγαινε δίπλα στο ταίρι σου, όπου κι αν είναι. Μη γεμίζεις τη σιωπή — απλώς να είσαι εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a donde esté tu pareja. No llenes el silencio: solo quédate ahí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mine tema juurde, kus iganes ta on. Ära täida vaikust — lihtsalt ole seal."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egon dagoen tokian berarekin. Ez bete isiltasuna: egon besterik ez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر جا هست، کنارش برو. لازم نیست سکوت را پر کنی — فقط باش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liity hänen seuraansa, missä hän onkin. Älä täytä hiljaisuutta – ole vain läsnä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samahan siya kung nasaan man siya. Hindi kailangang punuin ang katahimikan — nandiyan ka lang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va retrouver l'autre, où que ce soit. Pas besoin de meubler : sois juste là."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téigh chuig do pháirtí cibé áit a bhfuil. Ná líon an t-aer — bí ann, sin é."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompáñaa onde estea. Non enchas o silencio: simplemente está aí."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ જ્યાં હોય ત્યાં એમની સાથે જોડાઓ. વાતોથી ખાલી જગ્યા ન ભરો — બસ સાથે રહો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku je inda abokin zamanku yake. Kada ku cika iska da magana — kawai ku kasance a wurin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להצטרף, איפה שזה לא יהיה. לא למלא את השקט — פשוט להיות שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे जहाँ हों, वहीं उनके पास चले जाएँ। बातों से ख़ामोशी न भरें — बस साथ रहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridruži se voljenoj osobi, gdje god da je. Ne popunjavaj tišinu – samo budi tu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al jwenn li kote l ye a. Pa ranpli silans lan — jis la."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozz hozzá, bárhol is van. Ne töltsd ki a csendet – csak légy ott."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միացիր նրան, որտեղ էլ լինի։ Մի՛ լցրու լռությունը, պարզապես եղիր կողքին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temani dia di mana pun dia berada. Tak perlu mengisi suasana — cukup ada."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonyere ya ebe ọ bụla ọ nọ. Ejila okwu mejupụta ebe ahụ — naanị nọrọ ebe ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komdu þangað sem makinn þinn er. Ekki fylla þögnina – vertu bara til staðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungi il tuo partner ovunque sia. Non riempire il silenzio — stai lì e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーのいるところへ行って、無理に話さず、ただそばにいましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kancani ing ngendi wae pasangan ana. Ora usah ngisi sepi — cukup ana."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეუერთდი, სადაც არ უნდა იყოს. სიჩუმეს ნუ შეავსებ — უბრალოდ იქ იყავი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ол қай жерде болса, соның қасына бар. Үнсіздікті толтырма, жай қасында бол."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទៅនៅជាមួយគាត់ទោះនៅទីណាក៏ដោយ។ កុំនិយាយបំពេញភាពស្ងាត់ — គ្រាន់តែនៅទីនោះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅವರು ಎಲ್ಲಿದ್ದಾರೋ ಅಲ್ಲಿಗೇ ಹೋಗಿ ಜೊತೆಯಾಗಿ. ಮಾತಿನಿಂದ ತುಂಬಬೇಡಿ — ಸುಮ್ಮನೆ ಜೊತೆಗಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인이 있는 곳으로 가서 함께해 주세요. 굳이 말로 채우지 않아도 돼요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li ku dibe bila bibe, here ba hevjînê xwe. Bêdengiyê tije neke — tenê li wir be."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ал кайда болсо, ошол жерге бар. Аба сөз менен толтурба — жөн гана жанында бол."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesell dech zu dengem Schatz, egal wou. Fëll d'Stëllt net mat Wierder — sief einfach do."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໄປຢູ່ນຳລາວບໍ່ວ່າລາວຈະຢູ່ໃສ ບໍ່ຕ້ອງຫາເລື່ອງລົມ — ພຽງແຕ່ຢູ່ທີ່ນັ້ນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijunk ten, kur yra antroji pusė. Nebūtina kalbėti – tiesiog būk šalia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nāc turp, kur ir otrs. Nepiepildi klusumu – vienkārši esi klāt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mankanesa any amin'izay misy azy. Aza fenoina teny ny rivotra — eo fotsiny."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haere atu ki a ia, ahakoa kei hea. Kaua e whakakī i te wā ki te kōrero — noho mai noa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Придружи ѝ се каде и да е. Не полни ја тишината — само биди тука."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവർ എവിടെയാണോ അവിടെ ചേരൂ. വാക്കുകൾ കൊണ്ട് നിറയ്ക്കേണ്ട — വെറുതെ കൂടെയിരിക്കൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хаана ч байсан дэргэд нь оч. Ярьж дүүргэх хэрэггүй — зүгээр байгаарай."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ते जिथे आहेत तिथे त्यांच्यासोबत जा. शांतता भरून काढू नका — फक्त सोबत राहा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temani dia di mana saja dia berada. Tak perlu isi kesunyian — hadir saja."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingħaqad mal-partner tiegħek. Timliex is-skiet — sempliċement kun hemm."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချစ်သူ ရှိရာကို သွားပါ။ စကားနဲ့ ဖြည့်စရာ မလိုဘူး — အနားမှာ ရှိနေရုံပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med der partneren din er. Ikke fyll stillheten – bare vær der."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उहाँ जहाँ हुनुहुन्छ त्यहीँ साथ दिनुहोस्। कुराले मौनता भर्न नखोज्नुहोस् — बस साथमा हुनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga bij je partner zitten, waar die ook is. Vul de stilte niet – wees er gewoon."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitani komwe ali. Musadzaze mpweya ndi mawu — ingokhalani nawo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakka kamiyyuu taanaan, jaalallee kee bira dhaqi. Callisa hin guutin — achi jiraadhu qofa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେ ଯେଉଁଠି ଅଛନ୍ତି, ସେଠି ତାଙ୍କ ପାଖରେ ରୁହନ୍ତୁ। କଥାରେ ଭରିବାକୁ ଚେଷ୍ଟା କରନ୍ତୁ ନାହିଁ — କେବଳ ପାଖରେ ରୁହନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਹ ਜਿੱਥੇ ਵੀ ਹੋਣ, ਉਨ੍ਹਾਂ ਕੋਲ ਜਾ ਬੈਠੋ। ਗੱਲਾਂ ਨਾਲ ਚੁੱਪ ਨਾ ਭਰੋ — ਬੱਸ ਕੋਲ ਰਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do drugiej połówki, gdziekolwiek jest. Nie zagaduj ciszy – po prostu bądź."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر چېرې چې وي، ورسره یوځای شئ. چوپتیا په خبرو مه ډکوئ — یوازې هلته اوسئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça companhia onde seu amor estiver. Não precisa falar — só esteja ali."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta-te ao teu par onde quer que esteja. Não enchas o ar — fica só ali."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mergi lângă partenerul tău, oriunde ar fi. Nu umple tăcerea — doar fii acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь там же, где партнёр. Не заполняй тишину — просто будь рядом."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musange aho ari hose. Ntuzuzemo amagambo — ba uhari gusa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔවුන් ඉන්න තැනට ඔබත් යන්න. කතාවෙන් පුරවන්න එපා — ළඟින් ඉන්න විතරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridaj sa tam, kde práve je. Nevypĺňaj ticho – len buď pri tom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridruži se partnerju, kjerkoli že je. Ne zapolnjuj tišine – samo bodi tam."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enda kwaari chero kwaari. Usazadza nzvimbo nemashoko — ingovapo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku biir meel kasta oo la joogo. Ha buuxin aamusnaanta — uun joog."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shko aty ku është partneri. Mos e mbush heshtjen – thjesht ji aty."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Придружи се својој половини где год да је. Не попуњавај тишину — само буди ту."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baturan anjeunna di mana waé ayana. Teu kedah seueur nyarios; cekap aya di dinya."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dig ner där din partner är. Fyll inte tystnaden – bara var där."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiunge naye popote alipo. Usijaze ukimya — kuwa pale tu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவர் எங்கிருந்தாலும் அங்கே சேர்ந்துகொள்ளுங்கள். பேச்சால் நிரப்ப வேண்டாம் — இருந்தால் போதும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వారు ఎక్కడ ఉంటే అక్కడ చేరండి. మాటలతో నింపకండి — తోడుగా ఉంటే చాలు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳар ҷо ки ёрат бошад, ба ӯ ҳамроҳ шав. Хомӯширо пур накун — танҳо бош."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไปอยู่ข้างๆ คนรักไม่ว่าจะอยู่ตรงไหน ไม่ต้องหาเรื่องคุย แค่อยู่ด้วย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ዘለውዎ ተጸንበርዎም። ነቲ ስቕታ ኣይትምልእዎ — ጥራይ ኣብኡ ኩኑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nirede bolsa, ýanyna bar. Howany söz bilen doldurma — diňe ýanynda bol."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede olursa olsun yanına git. Sessizliği doldurmaya çalışma, sadece orada ol."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто приєднайся до половинки, де б вона не була. Не заповнюй тишу — просто будь поруч."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاں وہ ہوں، وہیں ان کے پاس چلے جائیں۔ خاموشی کو بھرنے کی کوشش نہ کریں، بس ساتھ رہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sherigingiz qayerda boʻlsa, oʻsha yerga boring. Jimlikni toʻldirishga urinmang — shunchaki yonida boʻling."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đến bên người ấy dù đang ở đâu. Không cần lấp đầy khoảng lặng — chỉ cần ở đó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamba uye apho likhona. Sukuzalisa ukuthula — yiba khona nje."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ dara pọ̀ mọ́ ọn níbikíbi tí ó wà. Ẹ má fi ọ̀rọ̀ kún afẹ́fẹ́ — ẹ kàn wà níbẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方在哪裏，你就去哪裏陪着。不用找話題——在就好。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去另一半身边待着。不用找话说，在就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去對方身邊就好。不用找話題，陪著就夠了。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlanganyela naye noma ngabe ukuphi. Ungagcwalisi umoya ngamazwi — vele ube khona."
          }
        }
      }
    },
