        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umzamo omkhulu, umvuzo omkhulu. Mhlawumbi uneenjongo ezinkulu kwaye uzimisele ukuzincama ngenxa yazo. Iqabane kufuneka livumelane naloo nto."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akitiyan ńlá, èrè ńlá. Ó ṣeé ṣe kí ẹ ní àfojúsùn ńlá, kí ẹ sì ṣetán láti fi nǹkan rúbọ fún wọn. Olólùfẹ́ yín gbọ́dọ̀ gbà bẹ́ẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
