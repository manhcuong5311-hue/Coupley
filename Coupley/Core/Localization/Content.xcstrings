        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刷手机（有点惭愧）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑手機（不太光彩）"
          }
        }
      }
    },
    "Security gives you peace of mind. You may need to loosen up around a partner who values experiences — and help them understand why savings matter to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأمان يمنحكم راحة البال. قد تحتاجون إلى بعض المرونة مع شريك يقدّر التجارب، وإلى مساعدته على فهم أهمية الادخار بالنسبة إليكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jistota ti dává klid. Možná budeš muset trochu povolit vedle protějšku, který si cení zážitků – a pomoct mu pochopit, proč jsou pro tebe úspory důležité."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryghed giver dig ro i sindet. Du skal måske slække lidt på det over for en partner, der sætter oplevelser højt – og hjælpe vedkommende med at forstå, hvorfor opsparing betyder noget for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit gibt dir Ruhe. Mit jemandem, dem Erlebnisse wichtig sind, darfst du ruhig lockerer werden – und erklären, warum dir Rücklagen so viel bedeuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ασφάλεια σού δίνει ηρεμία. Ίσως χρειαστεί να χαλαρώσεις λίγο με ένα ταίρι που εκτιμά τις εμπειρίες — και να το βοηθήσεις να καταλάβει γιατί μετράνε για σένα οι αποταμιεύσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguridad te da tranquilidad. Quizá necesites soltarte un poco con una pareja que valora las experiencias, y ayudarle a entender por qué el ahorro te importa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvallisuus tuo sinulle mielenrauhaa. Saatat joutua joustamaan, jos kumppanisi arvostaa elämyksiä – ja auttamaan häntä ymmärtämään, miksi säästäminen on sinulle tärkeää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatag ka kapag may seguridad. Baka kailangan mong lumuwag nang kaunti sa partner na pinahahalagahan ang mga karanasan — at tulungan siyang maintindihan kung bakit mahalaga sa’yo ang ipon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sécurité te tranquillise. Avec quelqu'un qui privilégie les expériences, tu devras peut-être lâcher un peu de lest, et l'aider à comprendre pourquoi l'épargne compte pour toi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטחון נותן לך שקט. ייתכן שיהיה צורך להשתחרר קצת מול מי שמעדיף חוויות — ולהסביר למה חיסכון חשוב לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षा से आपके मन को सुकून मिलता है। अनुभवों को अहमियत देने वाले पार्टनर के साथ आपको थोड़ी ढील देनी पड़ सकती है — और उन्हें समझाना होगा कि बचत आपके लिए क्यों ज़रूरी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonság nyugalmat ad. Lehet, hogy lazítanod kell, ha a párod inkább az élményeket értékeli – és segítened kell neki megérteni, miért fontos neked a megtakarítás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa aman memberimu ketenangan. Kamu mungkin perlu sedikit lebih santai dengan pasangan yang menghargai pengalaman — dan bantu dia paham kenapa tabungan penting bagimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sicurezza ti dà serenità. Con un partner che dà valore alle esperienze potresti dover allentare un po’ la presa — e spiegare perché i risparmi contano tanto per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓄えがあることで安心できるタイプです。体験を大切にするパートナーとなら、少し肩の力を抜きつつ、貯金が大切な理由もわかってもらいましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정감이 마음을 편하게 해 줘요. 경험을 중시하는 연인과 함께라면 조금 여유를 가질 필요도 있어요. 나에게 저축이 왜 중요한지 연인이 이해할 수 있게 도와주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa terjamin memberi anda ketenangan. Anda mungkin perlu lebih santai dengan pasangan yang menghargai pengalaman — dan bantu dia faham mengapa simpanan penting bagi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trygghet gir deg ro. Du må kanskje løsne litt på grepet hvis partneren din verdsetter opplevelser – og hjelpe den andre å forstå hvorfor sparing betyr mye for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zekerheid geeft je rust. Misschien moet je wat losser worden met een partner die van belevenissen houdt – en de ander helpen begrijpen waarom sparen voor jou belangrijk is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpieczeństwo daje ci spokój ducha. Przy drugiej połówce, która ceni przeżycia, przyda się trochę luzu – i wytłumaczenie, dlaczego oszczędności są dla ciebie ważne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurança traz paz de espírito para você. Talvez seja bom relaxar um pouco com um amor que valoriza experiências — e explicar por que guardar dinheiro importa para você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguranța îți dă liniște. S-ar putea să fie nevoie să te relaxezi puțin alături de un partener care prețuiește experiențele — și să-l ajuți să înțeleagă de ce contează economiile pentru tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Финансовая подушка даёт тебе спокойствие. Возможно, рядом с партнёром, который ценит впечатления, стоит немного расслабиться — и объяснить, почему сбережения для тебя важны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trygghet ger dig sinnesro. Du kan behöva släppa lite på det med en partner som värdesätter upplevelser – och förklara varför sparandet är viktigt för dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความมั่นคงทำให้คุณสบายใจ คุณอาจต้องผ่อนคลายลงบ้างถ้าคนรักให้คุณค่ากับประสบการณ์ และช่วยให้อีกฝ่ายเข้าใจว่าทำไมการออมจึงสำคัญกับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvence sana huzur veriyor. Deneyimlere değer veren bir partnerle biraz gevşemen ve birikimin senin için neden önemli olduğunu anlatman gerekebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова безпека дає тобі спокій. Можливо, з половинкою, яка цінує враження, варто трохи розслабитися — і пояснити їй, чому заощадження для тебе важливі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự an toàn mang lại cho bạn cảm giác yên tâm. Có thể bạn cần nới lỏng hơn với người ấy nếu người ấy coi trọng trải nghiệm — và giúp người ấy hiểu vì sao tiết kiệm quan trọng với bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全感让你安心。如果另一半更看重体验，你可能需要放松一点，也帮对方理解存钱为什么对你重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有保障才讓你安心。如果另一半重視體驗，你可能需要放鬆一點，也幫對方了解存錢對你為什麼重要。"
          }
        }
      }
    },
    "Self-aware about what you need but still working on it. That honesty is its own kind of health." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وعي بما تحتاجه مع استمرار العمل عليه. وهذه الصراحة نوع من الصحة بحد ذاتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víš, co potřebuješ, jen na tom ještě pracuješ. Ta upřímnost je sama o sobě známkou zdraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ved, hvad du har brug for, men arbejder stadig på det. Den ærlighed er en slags sundhed i sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weißt, was du brauchst, bist aber noch dabei. Diese Ehrlichkeit ist schon eine Form von Gesundheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξέρεις τι χρειάζεσαι, αλλά ακόμα το δουλεύεις. Αυτή η ειλικρίνεια είναι από μόνη της ένα είδος υγείας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabes lo que necesitas, aunque todavía estás en ello. Esa sinceridad ya es una forma de salud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedät, mitä tarvitset, mutta työstät sitä vielä. Se rehellisyys on jo oma laatuaan hyvinvointia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alam mo ang kailangan mo pero ginagawa mo pa. Ang katapatang iyon ay isang uri na rin ng kalusugan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sais ce dont tu as besoin, mais tu y travailles encore. Cette honnêteté est déjà une forme de bonne santé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודעות למה שחשוב לך, גם אם זה עדיין בעבודה. הכנות הזו היא סוג של בריאות בפני עצמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको पता है कि क्या चाहिए, बस उस पर काम जारी है। यह ईमानदारी अपने आप में सेहत की निशानी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudod, mire van szükséged, de még alakítod. Ez az őszinteség önmagában is egészséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sadar apa yang kamu butuhkan, tapi masih berproses. Kejujuran itu sendiri adalah bentuk kesehatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai di cosa hai bisogno, ma ci stai ancora lavorando. Questa onestà è già una forma di benessere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分に必要なものはわかっていて、まだ取り組んでいる途中です。その正直さも、ひとつの健やかさです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 걸 알고 있지만 아직 노력 중이에요. 그 솔직함도 하나의 건강함이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedar apa yang anda perlukan tetapi masih berusaha. Kejujuran itu sendiri satu tanda sihat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vet hva du trenger, men jobber fortsatt med det. Den ærligheten er en slags helse i seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je weet wat je nodig hebt, maar je werkt er nog aan. Die eerlijkheid is op zich al gezond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiesz, czego potrzebujesz, ale wciąż nad tym pracujesz. Ta szczerość to też forma zdrowia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabe do que precisa, mas ainda está chegando lá. Essa sinceridade já é um tipo de saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Știi de ce ai nevoie, dar încă lucrezi la asta. Sinceritatea asta e și ea o formă de sănătate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты понимаешь, что тебе нужно, но всё ещё над этим работаешь. Такая честность — уже своего рода здоровье."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vet vad du behöver men jobbar fortfarande på det. Den ärligheten är en sorts hälsa i sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรู้ว่าตัวเองต้องการอะไร แต่ยังพยายามอยู่ ความซื่อตรงแบบนี้ก็เป็นสุขภาพใจที่ดีแบบหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neye ihtiyacın olduğunun farkındasın ama hâlâ üzerinde çalışıyorsun. Bu dürüstlük de başlı başına bir sağlık göstergesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти розумієш, що тобі потрібно, але ще над цим працюєш. Така чесність — теж прояв здоров’я."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu mình cần gì nhưng vẫn đang cố gắng. Sự thành thật đó cũng là một kiểu khỏe mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你清楚自己需要什么，只是还在努力。这份坦诚本身就是一种健康。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道自己需要什麼，只是還在努力。這份誠實本身就是一種健康。"
          }
        }
      }
    },
    "Self-aware about where you come from. The good and difficult parts of your story are both visible to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وعي بالجذور. ترون الجوانب الجميلة والصعبة من قصتكم بوضوح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víš, odkud pocházíš. Vidíš dobré i těžké části svého příběhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ved, hvor du kommer fra. Både de gode og de svære dele af din historie er synlige for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weißt, woher du kommst. Die schönen und die schwierigen Seiten deiner Geschichte sind dir beide bewusst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις επίγνωση του από πού έρχεσαι. Βλέπεις καθαρά και τα καλά και τα δύσκολα κομμάτια της ιστορίας σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conoces bien de dónde vienes. Ves tanto las partes buenas como las difíciles de tu historia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedät, mistä tulet. Näet tarinasi sekä hyvät että vaikeat puolet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alam mo kung saan ka nanggaling. Kita mo pareho ang maganda at mahirap na bahagi ng kuwento mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sais d'où tu viens. Tu vois clairement les beaux côtés comme les parts difficiles de ton histoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודעות עצמית למקום שממנו באת. גם החלקים הטובים וגם הקשים בסיפור שלך גלויים לעיניך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको पता है कि आपकी जड़ें कहाँ हैं। आपकी कहानी के अच्छे और मुश्किल, दोनों हिस्से आपको साफ़ दिखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tisztában vagy vele, honnan jössz. A történeted jó és nehéz részeit is látod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sadar dari mana kamu berasal. Bagian yang baik maupun yang sulit dari kisahmu sama-sama terlihat olehmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai bene da dove vieni. Vedi con chiarezza sia le parti belle sia quelle difficili della tua storia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のルーツをよくわかっている人。物語の良いところも、つらいところも、どちらも見えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디서 왔는지 잘 알고 있어요. 이야기의 좋은 부분도 힘든 부분도 모두 또렷이 보고 있죠."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedar tentang asal-usul anda. Bahagian yang indah dan yang sukar dalam kisah anda, kedua-duanya jelas bagi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er bevisst på hvor du kommer fra. Både de gode og de vanskelige delene av historien din er synlige for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
