          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλα, θορυβώδη οικογενειακά τραπέζια — όσο πιο πολλοί, τόσο καλύτερα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes reuniones familiares, cuanta más gente mejor"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isoja, äänekkäitä sukujuhlia – mitä enemmän, sen parempi"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malalaki at maiingay na salo-salo ng pamilya — mas marami, mas masaya"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grandes tablées bruyantes, plus on est de fous…"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפגשים משפחתיים גדולים ורועשים — כמה שיותר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े, चहल-पहल वाले पारिवारिक जमावड़े — जितने ज़्यादा, उतना अच्छा"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagy, hangos családi összejövetelek – minél többen, annál jobb"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul keluarga besar yang ramai — makin banyak makin seru"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandi riunioni di famiglia — più siamo, meglio è"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大勢でにぎやかに。多いほど楽しい"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북적북적 대가족 모임, 많을수록 좋아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpul keluarga besar yang meriah — makin ramai makin seronok"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store, høylytte familieselskaper – jo flere, jo bedre"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote, luidruchtige familiefeesten – hoe meer zielen…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duże, głośne zjazdy rodzinne – im więcej, tym lepiej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes festas em família — quanto mais, melhor"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reuniuni mari de familie, gălăgioase — cu cât mai mulți, cu atât mai bine"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
