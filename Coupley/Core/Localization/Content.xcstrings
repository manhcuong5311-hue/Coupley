        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li ser îro. Tu ji bo plansaziya demdirêj nehatiyî afirandin — an tu hê ewqas ciwan î ku ev teorîk xuya dike."
