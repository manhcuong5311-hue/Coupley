            "value" : "Гастротур — пізнавати місце на смак"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lịch ẩm thực — ăn khắp nơi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美食之旅——一路吃过去"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美食為主，一路吃遍當地"
          }
        }
      }
    },
    "Forward-looking questions deepen connection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسئلة المتطلعة إلى الأمام تعمّق التواصل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otázky, které hledí dopředu, prohlubují blízkost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørgsmål om fremtiden styrker forbindelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragen nach vorn vertiefen die Verbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ερωτήσεις για το μέλλον βαθαίνουν τη σύνδεση."
