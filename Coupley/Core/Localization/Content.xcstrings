        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಮತೋಲಿತ ಮತ್ತು ವಾಸ್ತವಿಕ. ನೀವು ಅತಿರೇಕಕ್ಕೆ ಹೋಗುವುದಿಲ್ಲ — ಆಹಾರವನ್ನು ಆನಂದಿಸುತ್ತೀರಿ, ನಿಮ್ಮ ಆರೋಗ್ಯವನ್ನೂ ಕಾಪಾಡಿಕೊಳ್ಳುತ್ತೀರಿ."
