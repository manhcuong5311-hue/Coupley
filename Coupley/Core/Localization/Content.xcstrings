        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbang. Panjenengan bangga karo gaweyan tanpa kelangan awak dhewe. Panjenengan mbokmenawa gampang diajak sesambungan ing bab iki."
