        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լուծումը գիտես, բայց չես կիրառում։ Շուտ պառկող զուգընկերը կարող է իսկապես օգնել, կամ էլ քեզ խելքից հանել։"
