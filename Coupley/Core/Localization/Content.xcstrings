        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սկզբունքային։ Ունես չափանիշներ և կիրառում ես դրանք նույնիսկ պիցցայի վրա։ Մրգերի տեղն այլ տեղ է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berprinsip. Kamu punya standar dan menerapkannya pada pizza. Buah ada tempatnya sendiri."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị nwere ụkpụrụ. I nwere ihe ị chọrọ, ị na-etinyekwa ha na pizza. Mkpụrụ osisi kwesịrị ịnọ ebe ọzọ."
