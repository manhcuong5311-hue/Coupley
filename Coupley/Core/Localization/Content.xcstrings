        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bona disposició i ganes. Només assegura't que ho dius de veritat — una mascota és un compromís llarg."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstřícný a ochotný postoj. Jen se ujisti, že to myslíš vážně – mazlíček je závazek na dlouho."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parod i addasu a bodlon. Gwna'n siŵr dy fod yn ei feddwl go iawn — mae anifail anwes yn ymrwymiad hir."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imødekommende og villig. Sørg bare for, at du virkelig mener det – kæledyr er en lang forpligtelse."
