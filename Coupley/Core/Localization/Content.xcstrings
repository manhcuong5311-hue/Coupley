        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კონფლიქტების უმეტესობა იმაზე არაა, ვინ არის მართალი — ეს ორი განსხვავებული სტილის შეჯახებაა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көп дау кімнің дұрыс екенінде емес — екі түрлі стильдің соқтығысында."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជម្លោះភាគច្រើនមិនមែននិយាយពីថាអ្នកណាត្រូវទេ — វាជាការប៉ះទង្គិចគ្នានៃរបៀបពីរខុសគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೆಚ್ಚಿನ ಜಗಳಗಳು ಯಾರು ಸರಿ ಎಂಬುದರ ಬಗ್ಗೆ ಅಲ್ಲ — ಎರಡು ಬೇರೆ ಬೇರೆ ಶೈಲಿಗಳು ಡಿಕ್ಕಿಯಾಗುವುದರ ಬಗ್ಗೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 갈등은 누가 옳은지가 아니라, 서로 다른 방식이 부딪히면서 생겨요."
