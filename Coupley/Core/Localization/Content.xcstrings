        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда руки заняты, тихий разговор складывается сам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När händerna är upptagna öppnar sig lugna samtal."
