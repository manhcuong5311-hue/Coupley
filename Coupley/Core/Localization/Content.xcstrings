    "You see the relationship as a joint project. Major decisions involve both of you — and that's how you want it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترون العلاقة مشروعًا مشتركًا. القرارات الكبيرة تشملكما معًا، وهكذا تريدونها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vztah vnímáš jako společný projekt. Na velkých rozhodnutích se podílíte oba – a tak to chceš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser forholdet som et fælles projekt. Store beslutninger træffer I sammen – og sådan vil du have det."
