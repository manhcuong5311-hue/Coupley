            "value" : "Kirim satu kalimat: “nggak usah dibalas — lagi mikirin kamu.”"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zipu otu ahịrị: ‘ị zaghị azaghị — ana m eche gị.’"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendu eina línu: „Þú þarft ekki að svara – ég er að hugsa til þín.“"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manda una riga: «Non serve rispondere, ti penso»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「返信はいらないよ。想ってるよ」とひとことだけ送りましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
