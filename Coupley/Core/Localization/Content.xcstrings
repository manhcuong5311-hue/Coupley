        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близькість — не лише фізична. Різні люди відчувають її по-різному."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự gần gũi không chỉ là thể xác — mỗi người cảm nhận nó theo một cách khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亲近不只是身体上的，每个人感受亲近的方式都不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親近不只是身體上的，每個人感受到親近的方式都不一樣。"
          }
        }
      }
    },
    "Coastline. Pasta. Two weeks of sunset light." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
