    "Put a hand on their back or shoulder, no words needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit ’n hand op jou maat se rug of skouer, geen woorde nodig nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እጅዎን ጀርባቸው ወይም ትከሻቸው ላይ ያሳርፉ፤ ቃል አያስፈልግም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضعوا يدًا على ظهر شريكك أو كتفه، بلا حاجة إلى كلمات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তেওঁৰ পিঠিত বা কান্ধত হাত এখন ৰাখক, কথাৰ দৰকাৰ নাই।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əlini onun kürəyinə və ya çiyninə qoy, söz lazım deyil."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакладзі руку палавінцы на спіну ці плячо — без слоў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сложи ръка на гърба или рамото ѝ – без думи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওর পিঠে বা কাঁধে হাত রাখো, কোনো কথার দরকার নেই।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavi ruku na leđa ili rame, bez riječi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa-li la mà a l'esquena o a l'espatlla, sense paraules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polož protějšku ruku na záda nebo na rameno, slova nejsou potřeba."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rho law ar gefn neu ysgwydd dy bartner — does dim angen geiriau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg en hånd på ryggen eller skulderen – der er ikke brug for ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg eine Hand auf Rücken oder Schulter – Worte braucht es nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακούμπησε το χέρι σου στην πλάτη ή στον ώμο του ταιριού σου, χωρίς λόγια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una mano en su espalda o su hombro, sin necesidad de palabras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane käsi tema seljale või õlale, sõnu pole vaja."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarri eskua bizkarrean edo sorbaldan, hitzik behar gabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستت را روی کمر یا شانه‌اش بگذار، بی‌هیچ حرفی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita käsi hänen selälleen tai olalleen, sanoja ei tarvita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipatong ang kamay sa likod o balikat niya, hindi kailangan ng salita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose une main sur son dos ou son épaule, sans un mot."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuir lámh ar dhroim nó ar ghualainn do pháirtí, gan gá le focail."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon unha man nas súas costas ou no seu ombro; non fan falta palabras."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એમની પીઠ કે ખભા પર હાથ મૂકો, શબ્દોની જરૂર નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku ɗora hannu a bayan abokin zamanku ko kafaɗa, ba sai an yi magana ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להניח יד על הגב או על הכתף, בלי צורך במילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी पीठ या कंधे पर हाथ रखें, शब्दों की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavi ruku na leđa ili rame, riječi nisu potrebne."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete men ou sou do l oswa sou zepòl li, pa bezwen pawòl."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd a kezed a hátára vagy a vállára, szavak nélkül."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեռքդ դիր նրա մեջքին կամ ուսին, բառերն ավելորդ են։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan tangan di punggung atau bahunya, tanpa kata-kata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinye aka n'azụ ma ọ bụ n'ubu ya, okwu adịghị mkpa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggðu hönd á bak eða öxl makans, engin orð þarf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoggia una mano sulla sua schiena o sulla spalla, senza bisogno di parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背中や肩にそっと手を置きましょう。言葉はいりません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selehna tangan ing geger utawa pundhake pasangan, ora usah ngomong."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხელი ზურგზე ან მხარზე დაადე, სიტყვები საჭირო არ არის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арқасына не иығына қолыңды қой, сөз керек емес."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដាក់ដៃលើខ្នង ឬស្មារបស់គាត់ មិនបាច់និយាយអ្វីទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅವರ ಬೆನ್ನಿನ ಮೇಲೋ ಭುಜದ ಮೇಲೋ ಕೈ ಇಡಿ, ಮಾತು ಬೇಕಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말없이 등이나 어깨에 손을 얹어 주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
