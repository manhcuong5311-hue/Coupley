        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያደገ ያለና የሚያፈሱበት ችሎታ። ይህ ምርጥ የጋራ ተግባር ነው — በተለይ አጋርዎ ሊያስተምሩዎት ከቻሉ።"
