        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ದಿನವನ್ನು ಮುಗಿಸುವುದು ಬಾಂಧವ್ಯದ ಮೂಲಕ. ಇದು ಸುಂದರವಾದ ಜೋಡಿಯ ರೂಢಿ — ಅದು ನಿಮಗೆ ಎಷ್ಟು ಮುಖ್ಯ ಎಂದು ನಿಮ್ಮ ಸಂಗಾತಿಗೆ ತಿಳಿದಿರಲಿ."
