        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화로 하루를 마무리해요. 정말 아름다운 커플 의식이에요. 이 시간이 얼마나 소중한지 연인에게도 알려 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhubung dengan pasangan ialah cara anda menutup hari. Ini rutin pasangan yang indah — pastikan pasangan anda tahu betapa bermaknanya ia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærhet er måten du runder av dagen på. Det er et vakkert ritual for dere to – sørg for at partneren din vet hvor mye det betyr."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding is jouw manier om de dag af te sluiten. Dit is een prachtig ritueel voor jullie samen – zorg dat je partner weet hoeveel het je betekent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliskość to twój sposób na domknięcie dnia. To piękny rytuał pary – upewnij się, że druga połówka wie, ile to dla ciebie znaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão é como você fecha o dia. É um ritual lindo de casal — garanta que seu amor saiba o quanto isso significa."
