    "Couple time vs social time is one of the most negotiated parts of a relationship." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paartjietyd teenoor sosiale tyd is een van die dinge waaroor die meeste in ’n verhouding onderhandel word."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የጥንዶች ጊዜና የማኅበራዊ ጊዜ በግንኙነት ውስጥ በጣም ከሚደራደሩባቸው ጉዳዮች አንዱ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوازن بين الوقت الثنائي والوقت الاجتماعي من أكثر ما يتفاوض عليه الشريكان."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুয়োৰে নিজা সময় বনাম সামাজিক সময় — সম্পৰ্কত আটাইতকৈ বেছি বুজাবুজি কৰিবলগীয়া বিষয়বোৰৰ এটা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkilikdə və dostlarla keçən vaxt münasibətdə ən çox razılaşdırılan mövzulardan biridir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час удваіх і час з іншымі — адна з тых рэчаў, пра якія ў адносінах дамаўляюцца найчасцей."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Времето за двама срещу времето с другите е едно от най-обсъжданите неща във връзката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুজনের সময় বনাম সবার সাথে সময় — সম্পর্কে এটা নিয়েই সবচেয়ে বেশি দরকষাকষি চলে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijeme u dvoje naspram vremena s drugima jedan je od najčešćih predmeta pregovora u vezi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
