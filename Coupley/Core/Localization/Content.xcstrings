        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwuh kanthi nyata. Panjenengan wis ngerti bab sing ora pengin diwarisake — lan panjenengan lagi ngupayakake. Iku gedhe banget."
