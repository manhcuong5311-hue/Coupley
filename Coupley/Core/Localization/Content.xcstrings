            "value" : "איזון זה בטבע שלך. כנראה ששיחות על כסף זורמות לך בקלות יחסית כמעט עם כל אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वभाव से संतुलित। ज़्यादातर पार्टनर्स के साथ पैसों की बातचीत आप शायद आसानी से कर लेते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravnoteža ti je u prirodi. Razgovori o novcu vjerojatno ti relativno lako idu s većinom ljudi."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekilibre pa nati. Ou pwobableman fè konvèsasyon sou lajan san twòp difikilte ak pifò patnè."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Természetedből fakadóan kiegyensúlyozott vagy. Valószínűleg szinte bárkivel viszonylag könnyen megbeszéled a pénzügyeket egy kapcsolatban."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բնույթով հավասարակշռված ես։ Հավանաբար փողի մասին զրույցները գրեթե ցանկացած զուգընկերոջ հետ համեմատաբար հեշտ են անցնում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang secara alami. Kamu mungkin cukup mudah membicarakan uang dengan hampir semua pasangan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-enwe nguzozi n'onwe gị. O nwere ike ịbụ na mkparịta ụka gbasara ego anaghị esi gị ike na ọtụtụ mmadụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jafnvægi að eðlisfari. Þú átt líklega frekar auðvelt með peningasamtöl við flesta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’equilibrio ce l’hai nel sangue. Probabilmente parlare di soldi ti riesce piuttosto facile con quasi ogni partner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生まれつきのバランス派です。たいていのパートナーとは、お金の話も比較的スムーズにできるでしょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbang saka sanubari. Panjenengan mesthine gampang ngrembug bab dhuwit karo meh kabeh pasangan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ბუნებით დაბალანსებული ხარ. ფულზე საუბარი, ალბათ, თითქმის ნებისმიერ პარტნიორთან შედარებით ადვილად გამოგდის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табиғатыңнан теңгерімдісің. Ақша туралы әңгімелерді көп серікпен салыстырмалы түрде оңай жүргізетін шығарсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានតុល្យភាពពីធម្មជាតិ។ អ្នកប្រហែលជាអាចនិយាយពីលុយកាក់ជាមួយដៃគូភាគច្រើនបានយ៉ាងងាយស្រួល។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ವಭಾವತಃ ಸಮತೋಲಿತ. ಹೆಚ್ಚಿನ ಸಂಗಾತಿಗಳ ಜೊತೆ ಹಣದ ಮಾತುಕತೆಗಳನ್ನು ನೀವು ಬಹುಶಃ ಸುಲಭವಾಗಿ ನಿಭಾಯಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타고난 균형형이에요. 어떤 연인과도 돈 이야기를 비교적 수월하게 나눌 수 있을 거예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ji xwezayê hevseng. Belkî tu bi piraniya hevjînan re sohbetên li ser pereyan bi hêsanî birêve dibî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табиятыңдан тең салмактуусуң. Көп адамдар менен акча жөнүндө салыштырмалуу оңой сүйлөшө аласың го."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vun Natur aus ausgeglach. Gespréicher iwwer Geld falen dir mat de meeschte Leit wuel relativ liicht."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າສົມດຸນໂດຍທຳມະຊາດ ເຈົ້າອາດລົມເລື່ອງເງິນກັບຄູ່ໄດ້ຂ້ອນຂ້າງງ່າຍ ບໍ່ວ່າຄູ່ຈະເປັນແບບໃດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusiausvyra tau prigimtinė. Pokalbiai apie pinigus tau tikriausiai sekasi gana lengvai su daugeliu žmonių."
