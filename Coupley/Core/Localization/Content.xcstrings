        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gonest. Felly mae'r rhan fwyaf o bobl. Y parodrwydd i edrych arno yw'r rhan bwysicaf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærligt. Sådan har de fleste det. Viljen til at se nærmere på det er det vigtigste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehrlich. Den meisten geht es so. Die Bereitschaft, genau hinzuschauen, ist das Wichtigste."
