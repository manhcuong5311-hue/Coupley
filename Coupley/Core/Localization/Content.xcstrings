        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le luci di Tokyo. Le mattine a Kyoto. I ciliegi in fiore con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "東京の夜景。京都の朝。あなたと見る桜。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도쿄의 불빛, 교토의 아침, 함께 보는 벚꽃."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
