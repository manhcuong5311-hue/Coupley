        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දේවල් නිර්මාණය කිරීම. තවම ප්‍රකාශ කරන්න ක්‍රමයක් හොයාගන්න බැරි වුණු අදහස් ඔබ ඇතුළේ තියෙනවා ඇති."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvorenie. Asi v sebe nosíš nápady, ktoré ešte nenašli cestu von."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarjanje. Verjetno v sebi nosiš ideje, ki še čakajo, da jih izraziš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugadzira zvinhu. Zvimwe une pfungwa mukati mako dzausati wawana nzira yekudziratidza."
