        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qabatamaa. Maatiin adda addaa karaa adda addaa barbaadu. Inni barbaachisu lamaan keessan yaada tokko irra jiraachuu keessani."
