        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նրբերանգներով պատասխան, և հաճախ՝ ամենաառողջը։ Միասին՝ որտեղ դա կարևոր է, անկախ՝ որտեղ դա է կարևոր։"
