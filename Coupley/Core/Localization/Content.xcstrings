        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በአሁኑ ላይ ያተኮሩ። ለረጅም ጊዜ ዕቅድ አልተፈጠሩም — ወይም ይህ ገና ንድፈ ሀሳብ ብቻ እስኪመስል ድረስ ወጣት ነዎት።"
