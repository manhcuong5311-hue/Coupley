        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantika kimi birgə iş. Mətbəx özünəməxsus keyfiyyətli vaxta çevrilir — sonda da yemək əldə edirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумесная справа як рамантыка. Кухня ператвараецца ў асаблівы час удваіх — і ў выніку ёсць вячэра."
          }
