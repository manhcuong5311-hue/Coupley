          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যত্নের ছোট ছোট ব্যক্তিগত কাজেই তোমার ভালোবাসার ভাষা ফুটে ওঠে। তোমার প্রিয় জিনিসগুলো মনে রাখার খুঁটিনাটিটাই আসল।"
