        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng. Bạn không muốn kiểm soát, nhưng bạn nhận ra khi ai đó chỉ để tâm nửa vời."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukulinganisela. Akufuni ukuba lipolisa, kodwa uyaqaphela xa umntu ekhona ngesiqingatha."
