        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usabela emva kokuba kwenzeke into endaweni yokuqala kwangaphambili — kuyasebenza oko ukuba nobabini nilungile ekuphakamiseni izinto xa zisenzeka."
