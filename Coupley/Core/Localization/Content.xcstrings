        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyazi ukuthi uvelaphi. Izingxenye ezinhle nezinzima zendaba yakho zombili ziyabonakala kuwe."
          }
        }
      }
