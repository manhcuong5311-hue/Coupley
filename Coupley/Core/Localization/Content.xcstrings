        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moldakorra eta prest. Ziurtatu benetan esaten duzula — maskotak konpromiso luzea dira."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سازگار و راغب. فقط مطمئن شو واقعاً منظورت همین است — حیوان خانگی تعهدی طولانی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautuvaa ja halukasta. Varmista vain, että tarkoitat sitä oikeasti – lemmikki on pitkä sitoumus."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maunawain at handa. Siguraduhin lang na totoo ito sa’yo — matagal na commitment ang alagang hayop."
