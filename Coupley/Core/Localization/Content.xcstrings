        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ප්‍රායෝගිකයි. ඔබේ සැබෑ ජීවිතය ගත වන්නේ රැකියාවෙන් පිටතදී. රැකියාව ඔබේ දැක්මට සේවය කරයි."
