        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপুনি সহজাতভাৱে কেনেকৈ সঁহাৰি দিয়ে — সংগীক কি লাগে ভবাৰ আগতেই আপুনি কি আগবঢ়ায়।"
