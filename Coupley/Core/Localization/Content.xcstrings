    "Emergency presence is your love language of support. You show up fully when it matters most." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om in ’n krisis daar te wees, is jou liefdestaal van ondersteuning. Jy daag ten volle op wanneer dit die meeste saak maak."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በችግር ጊዜ መገኘት የድጋፍ የፍቅር ቋንቋዎ ነው። ከሁሉ በላይ በሚያስፈልግበት ጊዜ ሙሉ በሙሉ ይገኛሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحضور وقت الشدة هو لغة الدعم عندكم. تحضرون بكل كيانكم حين يكون الأمر مهمًا حقًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংকটৰ সময়ত উপস্থিত থকাটোৱেই আপোনাৰ সমৰ্থনৰ প্ৰেমৰ ভাষা। আটাইতকৈ দৰকাৰী সময়ত আপুনি সম্পূৰ্ণৰূপে উপস্থিত থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çətin anda yanında olmaq — sənin dəstək dilin budur. Ən vacib anda tamamilə orada olursan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быць побач у крызісны момант — твая мова падтрымкі. Ты выкладваешся напоўніцу, калі гэта найбольш важна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присъствието в труден момент е твоят език на подкрепата. Отдаваш се изцяло, когато е най-важно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিপদের সময় পাশে থাকাই তোমার সাপোর্টের ভালোবাসার ভাষা। সবচেয়ে জরুরি মুহূর্তে তুমি পুরোপুরি হাজির হও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisutnost u kriznim trenucima tvoj je jezik ljubavi kad je podrška u pitanju. Kad je najvažnije, tu si svim srcem."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser-hi en les urgències és la teva manera d'estimar. Hi ets del tot quan més importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Být po ruce v krizi – to je tvůj jazyk podpory. Když na tom nejvíc záleží, jsi tu naplno."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bod yno mewn argyfwng yw dy iaith cariad o ran cefnogaeth. Rwyt ti yno'n llwyr pan mae'n cyfrif fwyaf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du viser din støtte ved at rykke ud, når det brænder på. Når det virkelig gælder, er du der helt og fuldt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Notfall bist du voll da – so zeigst du Liebe. Wenn es wirklich zählt, bist du ganz präsent."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παρουσία στα δύσκολα είναι ο δικός σου τρόπος στήριξης. Όταν μετράει πραγματικά, είσαι εκεί με όλη σου την ψυχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente en las urgencias es tu forma de apoyar. Cuando más importa, apareces por completo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hädaolukorras kohal olemine on sinu toetuse armastuse keel. Oled täiega kohal siis, kui see kõige rohkem loeb."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larrialdian agertzea da laguntzeko zure maitasun-hizkuntza. Osorik agertzen zara gehien axola duenean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حضور در لحظهٔ بحران، زبان حمایت توست. وقتی بیشترین اهمیت را دارد، با تمام وجود حاضر می‌شوی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hätähetken läsnäolo on sinun tapasi tukea. Olet täysillä paikalla silloin, kun sillä on eniten väliä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang presensya sa oras ng kagipitan ang paraan mo ng pagsuporta. Buong-buo kang dumarating kapag pinakakailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton soutien, c'est la présence dans l'urgence. Quand ça compte vraiment, tu es là à cent pour cent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Láithreacht i nguais is ea do theanga tacaíochta. Bíonn tú ann go hiomlán nuair is mó a bhíonn gá leis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente nas emerxencias é a túa linguaxe do amor á hora de apoiar. Dálo todo cando máis importa."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મુશ્કેલીમાં હાજર રહેવું એ તમારા સાથની ભાષા છે. સૌથી વધુ જરૂર હોય ત્યારે તમે પૂરેપૂરા હાજર રહો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasancewa a lokacin gaggawa shi ne harshen soyayyarku na tallafi. Kuna zuwa da dukkan zuciyarku a lokacin da ya fi muhimmanci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נוכחות ברגעי חירום היא שפת התמיכה שלך. כשזה הכי חשוב, יש שם מאה אחוז ממך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुश्किल घड़ी में मौजूद रहना ही आपके साथ देने का तरीक़ा है। जब सबसे ज़्यादा ज़रूरत हो, तब आपका पूरा साथ मिलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisutnost u kriznim trenucima tvoj je jezik ljubavi kad je riječ o podršci. Potpuno si tu kad je najvažnije."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezans nan moman ijans se langaj lanmou ou pou soutni. Ou la nèt lè sa pi konte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha baj van, azonnal ott termsz – így támogatsz. Amikor a legnagyobb szükség van rád, teljes szívvel jelen vagy."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճգնաժամային պահին կողքին լինելը քո աջակցության սիրո լեզուն է։ Դու ամբողջովին ներկա ես, երբ դա ամենից շատ է պետք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadir saat genting adalah bahasa cintamu dalam mendukung. Kamu datang sepenuhnya di saat paling penting."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịbịa ozugbo n'oge mkpa bụ asụsụ ịhụnanya gị maka nkwado. Ị na-abịa zuru oke mgbe ọ kacha mkpa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú sýnir umhyggju með því að mæta þegar neyðin kallar. Þú ert fullkomlega til staðar þegar mest liggur við."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esserci nelle emergenze è il tuo modo di sostenere. Quando conta davvero, ci sei al cento per cento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いざというときに駆けつけるのが、あなたなりの支え方。いちばん大事な場面で、全力でそばにいられる人です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana nalika kahanan genting iku basa tresna panjenengan ing bab nyengkuyung. Panjenengan teka kanthi wutuh nalika paling dibutuhake."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადაუდებელ დროს გვერდით დგომა — ასე გამოხატავ მხარდაჭერას. მთელი არსებით იქ ხარ, როცა ეს ყველაზე მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қиын сәтте қасында болу — сенің қолдау тілің. Ең маңызды кезде толықтай жанында боласың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការនៅក្បែរក្នុងគ្រាអាសន្ន គឺជាភាសាស្នេហានៃការគាំទ្ររបស់អ្នក។ អ្នកមកនៅក្បែរពេញលេញ នៅពេលដែលសំខាន់បំផុត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಷ್ಟದ ಹೊತ್ತಿನಲ್ಲಿ ಜೊತೆಗಿರುವುದೇ ನಿಮ್ಮ ಬೆಂಬಲದ ಪ್ರೀತಿಯ ಭಾಷೆ. ಮುಖ್ಯವಾದಾಗ ನೀವು ಸಂಪೂರ್ಣವಾಗಿ ಜೊತೆಗಿರುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위기의 순간에 곁을 지키는 게 사랑을 표현하는 방식이에요. 가장 중요할 때 온전히 함께해 주죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebûna di demên acil de zimanê te yê piştgiriyê ye. Dema herî girîng e, tu bi tevahî li wir î."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кыйын учурда жанында болуу — сенин колдоо тилиң. Эң маанилүү учурда толугу менен жанында болосуң."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do sinn, wann et brennt, ass deng Léiftsprooch vun Ënnerstëtzung. Du bass voll do, wann et am meeschten drop ukënnt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການມາທັນທີໃນຍາມຈຳເປັນ ຄືວິທີສະແດງຄວາມຮັກຂອງເຈົ້າ ເຈົ້າມາຢ່າງເຕັມທີ່ໃນເວລາທີ່ສຳຄັນທີ່ສຸດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buvimas šalia ištikus bėdai – tavo palaikymo meilės kalba. Kai svarbiausia, atsiduodi visa širdimi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Būt klāt ārkārtas brīžos – tā ir tava atbalsta valoda. Tu esi pilnībā līdzās tad, kad tas ir vissvarīgāk."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fanatrehana amin'ny fotoan-tsarotra no fitenin'ny fitiavanao amin'ny fanohanana. Eo tanteraka ianao rehefa tena ilaina."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te tae tonu mai i te wā ohotata tō reo aroha mō te tautoko. Ka tino tae mai koe ina tino nui te take."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присуството во кризи е твојот јазик на поддршка. Целосно си тука кога е најважно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അത്യാവശ്യ ഘട്ടങ്ങളിൽ ഒപ്പമുണ്ടാകലാണ് പിന്തുണയിൽ നിങ്ങളുടെ സ്നേഹഭാഷ. ഏറ്റവും പ്രധാനപ്പെട്ട നിമിഷങ്ങളിൽ നിങ്ങൾ പൂർണമായി ഒപ്പമുണ്ടാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хэцүү үед дэргэд нь очих нь чиний дэмжлэгийн хайрын хэл. Хамгийн чухал үед чи бүрэн дүүрэн хүрээд ирдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संकटात सोबत असणे, ही तुमची आधार देण्याची प्रेमाची भाषा आहे. सर्वात जास्त गरज असते तेव्हा तुम्ही पूर्णपणे हजर असता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadir ketika kecemasan ialah bahasa cinta sokongan anda. Anda hadir sepenuhnya saat ia paling penting."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-preżenza fl-emerġenza hija l-lingwa tal-imħabba tiegħek fl-appoġġ. Tkun hemm bis-sħiħ meta l-aktar ikun jgħodd."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အရေးပေါ်အချိန် အနားရောက်လာခြင်းက သင့်ရဲ့ အားပေးမှု အချစ်ဘာသာစကားပါ။ အရေးအကြီးဆုံးအချိန်မှာ အပြည့်အဝ ရောက်လာတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å stille opp når det brenner, er ditt støttespråk. Du er der helt og fullt når det betyr mest."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संकटमा उपस्थित हुनु नै तपाईंको साथ दिने तरिका हो। सबैभन्दा जरुरी बेला तपाईं पूरै मनले आइपुग्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn als het erop aankomt, dat is jouw manier van steunen. Op de momenten die er het meest toe doen, ben je er helemaal."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukhalapo pa nthawi ya mavuto ndiye chilankhulo chanu cha chikondi pothandiza. Mumafika ndi mtima wonse pamene zikufunika kwambiri."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeroo rakkoo argamuun afaan jaalalaa deeggarsa keeti. Yeroo baay'ee barbaachisu guutummaatti argamta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଙ୍କଟ ସମୟରେ ପାଖରେ ରହିବା ହିଁ ଆପଣଙ୍କ ସାହାଯ୍ୟର ପ୍ରେମର ଭାଷା। ସବୁଠାରୁ ଦରକାରୀ ମୁହୂର୍ତ୍ତରେ ଆପଣ ପୂରା ମନ ଦେଇ ପହଞ୍ଚିଯାଆନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਔਖੀ ਘੜੀ ਵਿੱਚ ਹਾਜ਼ਰ ਹੋਣਾ ਹੀ ਤੁਹਾਡੇ ਸਾਥ ਦੀ ਭਾਸ਼ਾ ਹੈ। ਜਦੋਂ ਸਭ ਤੋਂ ਵੱਧ ਲੋੜ ਹੋਵੇ, ਤੁਸੀਂ ਪੂਰੇ ਦਿਲ ਨਾਲ ਪਹੁੰਚਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecność w kryzysie to twój język wsparcia. Gdy naprawdę trzeba, jesteś w stu procentach."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په بېړني وخت کې شتون ستاسو د ملاتړ د مینې ژبه ده. کله چې تر ټولو ډېر مهم وي، په بشپړه توګه حاضرېږئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente na hora do aperto é o seu jeito de apoiar. Você aparece por inteiro quando mais importa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar presente nas emergências é a tua linguagem de apoio. Apareces por inteiro quando mais importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezența în momentele grele e felul tău de a sprijini. Când contează cel mai mult, ești acolo cu totul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой язык поддержки — быть рядом в трудную минуту. Когда это важнее всего, ты отдаёшься полностью."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuboneka mu bihe bikomeye ni bwo buryo bwawe bwo gushyigikira. Uhaba byuzuye igihe bikenewe cyane."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "හදිසියේ ළඟට එන එක තමයි ඔබ සහාය දෙන ආදර භාෂාව. වැඩියෙන්ම වැදගත් වෙලාවට ඔබ මුළු හදවතින්ම ඉන්නවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byť tu v kritických chvíľach je tvoj jazyk podpory. Keď na tom najviac záleží, si tu naplno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisotnost v stiski je tvoj jezik ljubezni pri podpori. Ko je najbolj pomembno, si povsem tu."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvapo panguva yedambudziko ndiwo mutauro wako werudo wekutsigira. Unouya wakazara panguva yazvinonyanya kukosha."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joogitaanka xilliga xaaladda degdegga ah waa sida aad u muujiso taageeradaada. Si buuxda ayaad u timaaddaa marka ay ugu muhiimsan tahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prania në çaste të vështira është gjuha jote e mbështetjes. Je plotësisht aty kur ka më shumë rëndësi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присуство у кризи је твој језик подршке. Појављујеш се целим бићем кад је најважније."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadir dina kaayaan darurat téh basa cinta anjeun dina ngarojong. Anjeun hadir pinuh nalika paling diperyogikeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ställa upp när det krisar är ditt sätt att stötta. Du finns där helt och fullt när det verkligen gäller."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuwepo wakati wa dharura ndiyo lugha yako ya upendo katika kusaidia. Unajitokeza kikamilifu wakati ni muhimu zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவசரத்தில் உடனிருப்பதுதான் உங்கள் ஆதரவின் அன்பு மொழி. மிக முக்கியமான நேரத்தில் முழுமையாக வந்து நிற்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అత్యవసరంలో తోడుగా ఉండటమే మద్దతులో మీ ప్రేమ భాష. ఎక్కువ అవసరమైనప్పుడు మీరు పూర్తిగా అండగా నిలుస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳузур дар лаҳзаи душвор забони дастгирии туст. Вақте аз ҳама муҳим аст, ту пурра меоӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การมาหาทันทียามฉุกเฉินคือภาษารักในแบบของคุณ คุณพร้อมอยู่ตรงนั้นเต็มที่ในวันที่สำคัญที่สุด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ህጹጽ እዋን ምህላው ቋንቋ ፍቕሪ ደገፍኩም እዩ። ኣብቲ ዝበለጸ ኣገዳሲ እዋን ምሉእ ብምሉእ ትቐርቡ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyn pursatda ýanynda bolmak — seniň goldaw diliň. Iň möhüm wagtda bütin ýüregiň bilen gelýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin destek dilin, zor anda orada olmak. En önemli anda tüm benliğinle yanındasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя мова підтримки — бути поруч у критичну мить. Коли це найважливіше, ти віддаєшся повністю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشکل گھڑی میں موجود ہونا ہی آپ کا سہارا دینے کا انداز ہے۔ جب سب سے زیادہ ضرورت ہو، تب آپ کی موجودگی مکمل ہوتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favqulodda paytda yonida boʻlish — sizning qoʻllab-quvvatlash tilingiz. Eng muhim paytda butun borligʻingiz bilan yetib kelasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có mặt lúc khẩn cấp là cách bạn yêu thương và nâng đỡ. Bạn dốc hết lòng vào những lúc quan trọng nhất."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubakho ngexesha likaxakeka lulwimi lwakho lothando lwenkxaso. Uzinikela ngokupheleleyo xa kubaluleke kakhulu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wíwà níbẹ̀ ní àkókò pàjáwìrì ni èdè ìfẹ́ àtìlẹ́yìn yín. Ẹ máa ń dé ní kíkún nígbà tó ṣe pàtàkì jù."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急時刻挺身而出，就是你表達支持的愛之語。在最重要的時候，你會全情投入。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
