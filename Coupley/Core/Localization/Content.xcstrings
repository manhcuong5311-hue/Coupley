        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ნორმალურია. ოღონდ კარგია იცოდე, თუ შენს პარტნიორს კითხვა ძალიან უყვარს — შეიძლება, თავისი სამყაროს ამ ნაწილის გაზიარება მოუნდეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл қалыпты. Бірақ серігің кітапқұмар болса, мұны білген жөн: ол өз әлемінің сол бөлігімен бөліскісі келуі мүмкін."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនអីទេ។ គួរដឹងបើដៃគូរបស់អ្នកចូលចិត្តអានខ្លាំង — គាត់ប្រហែលចង់ចែករំលែកផ្នែកនោះនៃពិភពរបស់គាត់ជាមួយអ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪರವಾಗಿಲ್ಲ. ನಿಮ್ಮ ಸಂಗಾತಿ ಓದಿನ ಪ್ರೇಮಿಯಾಗಿದ್ದರೆ ಇದು ತಿಳಿದಿರಲಿ — ಅವರು ತಮ್ಮ ಪ್ರಪಂಚದ ಆ ಭಾಗವನ್ನು ನಿಮ್ಮೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲು ಬಯಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "괜찮아요. 연인이 책을 정말 좋아한다면 알아 두면 좋아요. 자기 세계의 그 부분을 나누고 싶어 할 수도 있으니까요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev baş e. Hêja ye ku tu zanibî eger hevjînê te pir dixwîne — dibe ku ew bixwaze wê beşa dinyaya xwe bi te re parve bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул кадимки нерсе. Бирок сүйгөнүң көп окуса, муну билип койгон жакшы — ал дүйнөсүнүн ошол бөлүгүн сени менен бөлүшкүсү келиши мүмкүн."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat ass an der Rei. Gutt ze wëssen, wann däi Schatz vill liest — vläicht wëll däi Schatz déi Welt mat dir deelen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບໍ່ເປັນຫຍັງ ແຕ່ກໍຄວນຮູ້ໄວ້ ຖ້າຄູ່ຂອງເຈົ້າມັກອ່ານຫຼາຍ — ລາວອາດຢາກແບ່ງປັນໂລກສ່ວນນັ້ນກັບເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir gerai. Tik verta žinoti, jei tavo antroji pusė daug skaito – gal ji norės pasidalyti šia savo pasaulio dalimi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ir normāli. Vērts zināt, ja tava otrā puse daudz lasa – varbūt viņa gribēs ar tevi dalīties ar šo savas pasaules daļu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsy maninona. Tsara ho fantatra raha tia mamaky boky be ny olon-tianao — mety te hizara aminao io ampahany amin'ny tontolony io izy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei te pai tēnā. He pai kia mōhio mēnā he kaipānui nui tō hoa aroha — tērā pea ka hiahia ia ki te tiri i taua wāhanga o tōna ao."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоа е во ред. Добро е да знаеш ако половинката многу чита — можеби ќе сака да го сподели тој дел од својот свет."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അതിൽ കുഴപ്പമില്ല. പങ്കാളി ധാരാളം വായിക്കുന്ന ആളാണെങ്കിൽ അത് അറിഞ്ഞിരിക്കുന്നത് നല്ലതാണ് — അവരുടെ ലോകത്തിന്റെ ആ ഭാഗം നിങ്ങളുമായി പങ്കിടാൻ അവർ ആഗ്രഹിച്ചേക്കാം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зүгээр дээ. Хань чинь их уншдаг бол мэдэж байх нь зүйтэй — тэр ертөнцийнхөө энэ хэсгийг чамтай хуваалцахыг хүсэж магадгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काही हरकत नाही. पण जोडीदाराला वाचनाची खूप आवड असेल, तर हे माहीत असलेले बरे — त्यांना त्यांच्या जगाचा तो भाग तुमच्यासोबत वाटून घ्यायचा असेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak mengapa. Elok tahu jika pasangan anda kuat membaca — mereka mungkin mahu berkongsi bahagian dunia itu dengan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'hemm xejn ħażin. Ta' min tkun taf jekk il-qari huwiex parti kbira mill-ħajja tal-partner tiegħek — forsi hemm dinja sħiħa x'taqsmu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရပါတယ်။ ချစ်သူက စာဖတ်ဝါသနာကြီးသူဆိုရင်တော့ သိထားသင့်တယ် — ချစ်သူ့ကမ္ဘာရဲ့ အဲဒီအပိုင်းကို သင်နဲ့ မျှဝေချင်လောက်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt greit. Verdt å vite om partneren din er en storleser – den andre vil kanskje dele den delen av sin verden."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठिकै छ। तर तपाईंको पार्टनर धेरै पढ्ने हुनुहुन्छ भने यो जान्नु राम्रो — उहाँ आफ्नो संसारको त्यो पाटो तपाईंसँग बाँड्न चाहनुहुन्छ होला।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima. Wel goed om te weten als je partner een echte lezer is – misschien wil je partner die wereld graag met je delen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palibe vuto. Ndi bwino kudziwa ngati wokondedwa wanu amakonda kuwerenga kwambiri — angafune kugawana nanu mbali imeneyo ya moyo wake."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakkoo miti. Garuu dubbisuun jireenya jaalallee kee keessatti iddoo guddaa yoo qabaate beekuun gaarii dha — kutaa jireenyaa sana si wajjin qooddachuun ni barbaadama ta'a."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଠିକ୍ ଅଛି। ଆପଣଙ୍କ ସାଥୀ ବହୁତ ପଢ଼ନ୍ତି କି ନାହିଁ ଜାଣିବା ଭଲ — ସେ ହୁଏତ ନିଜ ଦୁନିଆର ସେହି ଅଂଶ ଆପଣଙ୍କ ସହ ବାଣ୍ଟିବାକୁ ଚାହିଁବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਗੱਲ ਨਹੀਂ। ਪਰ ਇਹ ਜਾਣਨਾ ਚੰਗਾ ਹੈ ਕਿ ਕੀ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਨੂੰ ਪੜ੍ਹਨ ਦਾ ਬਹੁਤ ਸ਼ੌਕ ਹੈ — ਸ਼ਾਇਦ ਉਹ ਆਪਣੀ ਦੁਨੀਆ ਦਾ ਉਹ ਹਿੱਸਾ ਤੁਹਾਡੇ ਨਾਲ ਸਾਂਝਾ ਕਰਨਾ ਚਾਹੁਣ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To w porządku. Warto wiedzieć, czy twoja druga połówka dużo czyta – może zechcieć podzielić się z tobą tą częścią swojego świata."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمه ده. خو ښه ده پوه شئ که ستاسو ملګری ډېر لوستونکی وي — شاید وغواړي د خپلې نړۍ دا برخه درسره شریکه کړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo bem. Vale saber se seu amor lê muito — talvez queira dividir com você essa parte do próprio mundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo bem. Vale a pena saber se o teu par lê muito — pode querer partilhar contigo essa parte do seu mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E în regulă. Merită știut dacă partenerul tău citește mult — poate vrea să împartă cu tine partea asta din lumea sa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нормально. Но стоит знать, если партнёр много читает: возможно, ему захочется поделиться с тобой этой частью своего мира."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nta kibazo. Ni byiza kumenya niba umukunzi wawe akunda gusoma cyane — ashobora kwifuza kugusangiza icyo gice cy'isi ye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඒකත් හරි. ඔබේ සහකරු ගොඩක් කියවන කෙනෙක් නම් ඒක දැනගන්න වටිනවා — ඔවුන්ගේ ලෝකයේ ඒ කොටස ඔබ එක්ක බෙදාගන්න ඔවුන් කැමති වෙන්න පුළුවන්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je v poriadku. Dobré je vedieť, či tvoja polovička veľa číta – možno sa s tebou bude chcieť podeliť o tento kúsok svojho sveta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čisto v redu. Dobro pa je vedeti, ali tvoj partner veliko bere – morda si želi s tabo deliti ta del svojega sveta."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazvina mhosva. Zvakanaka kuziva kana mudiwa wako achiverenga zvakanyanya — angada kugovana newe chikamu ichocho chehupenyu hwake."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taasi waa caadi. Waa wax mudan in la ogaado haddii lammaanahaagu yahay akhriste weyn — malaha waxa la rabaa in qaybtaas adduunka laguula wadaago."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Në rregull. Ia vlen ta dish nëse partneri yt lexon shumë – mund të dojë ta ndajë me ty atë pjesë të botës së vet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сасвим у реду. Добро је да знаш ако твоја половина много чита — можда жели да подели с тобом тај део свог света."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teu nanaon. Saé terang upami pasangan anjeun resep pisan maca; anjeunna meureun hoyong ngabagi bagian dunya éta ka anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är helt okej. Bra att veta om din partner läser mycket – kanske vill din partner dela den delen av sin värld."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilo ni sawa. Inafaa kujua kama mwenzi wako anapenda sana kusoma — huenda angependa kushiriki nawe sehemu hiyo ya ulimwengu wake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பரவாயில்லை. உங்கள் துணை தீவிர வாசகர் என்றால் இதைத் தெரிந்துகொள்வது நல்லது — அவர் தன் உலகின் அந்தப் பகுதியை உங்களுடன் பகிர விரும்பலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అది ఫర్వాలేదు. మీ భాగస్వామికి చదవడం అంటే చాలా ఇష్టమైతే, అది తెలుసుకోవడం మంచిది — వారు తమ ప్రపంచంలోని ఆ భాగాన్ని మీతో పంచుకోవాలనుకోవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳеҷ гап не. Танҳо донистан муфид аст, ки ёрат китобхони калон бошад — шояд мехоҳад он гӯшаи дунёи худро бо ту бинад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่เป็นไรเลย แค่ควรรู้ไว้ถ้าคนรักเป็นนักอ่านตัวยง อีกฝ่ายอาจอยากแบ่งปันโลกส่วนนั้นกับคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጸገም የብሉን። ንባብ ንመጻምድኹም ዓቢ ነገር እንተኾይኑ ግን ምፍላጡ ይጠቅም — ነቲ ክፋል ዓለም ምክፋል ይድለ ይኸውን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadaly. Söýgüliň kitapsöýüji bolsa, muny bilmek gowy — ol öz dünýäsiniň şol bölegini seniň bilen paýlaşmak isläp biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunda sorun yok. Partnerin çok kitap okuyorsa bilmekte fayda var; dünyasının bu kısmını seninle paylaşmak isteyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "І це нормально. Варто знати, якщо твоя половинка завзято читає — їй може хотітися поділитися цією частиною свого світу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی بات نہیں۔ اگر آپ کے ساتھی کو پڑھنے کا بہت شوق ہے تو یہ جاننا اچھا ہے، شاید وہ اپنی دنیا کا یہ حصہ آپ کے ساتھ بانٹنا چاہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu normal. Sherigingiz kitobni juda sevsa, buni bilgan yaxshi — balki sherigingiz oʻz dunyosining shu qismini siz bilan boʻlishmoqchidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không sao cả. Chỉ nên biết nếu người ấy là mọt sách — người ấy có thể muốn chia sẻ phần thế giới đó với bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulungile oko. Kufanelekile ukwazi ukuba iqabane lakho lithanda ukufunda kakhulu — linokufuna ukwabelana nawe ngelo cala lehlabathi lalo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kò burú. Ó dára láti mọ̀ tí olólùfẹ́ yín bá fẹ́ràn kíkàwé gidigidi — ó lè fẹ́ pín apá ayé rẹ̀ yẹn pẹ̀lú yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒關係。如果另一半很愛看書，值得知道一下——對方可能想跟你分享那部分的世界。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
