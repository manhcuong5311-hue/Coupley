    "A period of flux and possibility. Your partner needs to know this is coming — in terms of income, time, and emotional bandwidth." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’n Tyd van beweging en moontlikhede. Jou maat moet weet dit kom – wat inkomste, tyd en emosionele ruimte betref."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የለውጥና የዕድል ወቅት። አጋርዎ ይህ እየመጣ መሆኑን ማወቅ አለባቸው — ከገቢ፣ ከጊዜና ከስሜታዊ አቅም አንጻር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحلة تقلّب واحتمالات. يحتاج شريكك إلى معرفة ما هو قادم، من حيث الدخل والوقت والطاقة العاطفية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সলনি আৰু সম্ভাৱনাৰ এটা সময়। আপোনাৰ সংগীয়ে আগতীয়াকৈ জনা দৰকাৰ — উপাৰ্জন, সময় আৰু মানসিক শক্তি, সকলোৰে ক্ষেত্ৰত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dəyişkənlik və imkanlar dövrü. Partnyorun bunun gəldiyini bilməlidir — gəlir, vaxt və emosional güc baxımından."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час пераменаў і магчымасцей. Твая палавінка павінна ведаць, што яны набліжаюцца, — і пра грошы, і пра час, і пра эмацыйныя сілы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Период на промени и възможности. Половинката ти трябва да знае какво предстои – откъм доходи, време и емоционален ресурс."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অস্থিরতা আর সম্ভাবনার একটা সময়। তোমার পার্টনারের আগে থেকেই জানা দরকার — আয়, সময় আর মানসিক শক্তি, সবকিছুর ওপর এর প্রভাব পড়বে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Period previranja i mogućnosti. Tvoja voljena osoba treba znati šta dolazi – kad su u pitanju prihodi, vrijeme i emocionalna snaga."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una etapa de moviment i de possibilitats. La teva parella ha de saber què s'acosta — en ingressos, en temps i en energia emocional."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Období změn a možností. Tvůj protějšek by měl vědět, co přichází – v příjmech, čase i emoční kapacitě."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyfnod o newid a phosibiliadau. Mae angen i dy bartner wybod bod hyn ar y ffordd — o ran incwm, amser ac egni emosiynol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En periode med forandring og muligheder. Din partner skal vide, at det kommer – både hvad angår indkomst, tid og mentalt overskud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeit voller Umbrüche und Möglichkeiten. Dein Schatz sollte wissen, was kommt – beim Einkommen, bei der Zeit und bei deiner emotionalen Kraft."
