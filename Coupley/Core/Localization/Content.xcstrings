        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintu sentiasa terbuka. Ini berkesan apabila anda berdua selesa membangkitkan sesuatu tanpa perlu dijemput secara rasmi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpen dør. Det fungerer fint når dere begge er komfortable med å ta opp ting uten en formell invitasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De deur staat altijd open. Dat werkt goed als jullie allebei dingen durven aan te kaarten zonder officiële uitnodiging."
