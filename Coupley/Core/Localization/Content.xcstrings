    "Moving forward together, doing something light — that's how you reset the energy between you." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saam vorentoe beweeg, iets ligs doen – só stel jy die energie tussen julle weer reg."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አብሮ ወደፊት መቀጠል፣ ቀለል ያለ ነገር ማድረግ — በመካከላችሁ ያለውን መንፈስ የሚያድሱት በዚህ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المضي قدمًا معًا بشيء خفيف ومرح، هكذا تعيدون ضبط الطاقة بينكما."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একেলগে আগবাঢ়ি যোৱা, কিবা পাতল কাম কৰা — এনেদৰেই আপুনি দুয়োৰে মাজৰ পৰিৱেশ সতেজ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikdə irəli getmək, yüngül bir şey etmək — aranızdakı enerjini belə təzələyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухацца далей разам, займаючыся нечым лёгкім, — так ты аднаўляеш атмасферу паміж вамі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да продължите заедно с нещо леко – така рестартираш енергията помежду ви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথে এগিয়ে যাওয়া, হালকা কিছু করা — এভাবেই তোমরা নিজেদের মধ্যের আবহটা আবার ঠিক করে নাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajedno ići dalje, raditi nešto lagano – tako vraćaš dobru energiju među vama."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirar endavant junts fent alguna cosa lleugera — així és com renoves l'energia entre vosaltres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jít spolu dál a dělat něco odlehčeného – takhle mezi sebou obnovujete energii."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symud ymlaen gyda'ch gilydd, gwneud rhywbeth ysgafn — dyna sut rwyt ti'n newid yr egni rhyngoch chi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At komme videre sammen med noget let – det er sådan, du nulstiller stemningen mellem jer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsam weitergehen und etwas Leichtes unternehmen – so bringst du die Stimmung zwischen euch wieder ins Lot."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να προχωράτε μαζί, κάνοντας κάτι ανάλαφρο — έτσι ανανεώνεις την ενέργεια ανάμεσά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir adelante juntos haciendo algo ligero: así renuevas la energía entre los dos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koos edasi liikumine, midagi kerget tehes — nii lähtestad sa teievahelise energia."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elkarrekin aurrera egitea, zerbait arina eginez — horrela berritzen duzu zuen arteko energia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با هم جلو رفتن و یک کار سبک کردن — این‌طوری حال‌وهوای بینتان را دوباره تازه می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eteenpäin yhdessä, jotain kevyttä tehden – niin nollaat tunnelman välillänne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabay na pagsulong, paggawa ng magaan na bagay — ganyan mo nire-reset ang enerhiya sa pagitan ninyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancer ensemble avec quelque chose de léger : c'est comme ça que tu changes l'énergie entre vous."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogadh ar aghaidh le chéile, rud éadrom a dhéanamh — sin mar a athshocraíonn tú an fuinneamh eadraibh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir adiante xuntos, facendo algo lixeiro: así renovades a enerxía entre vós."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાથે આગળ વધવું, કંઈક હળવું કરવું — આ રીતે તમે તમારી વચ્ચેની ઊર્જા ફરી તાજી કરો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci gaba tare, yin wani abu mai sauƙi — haka kuke sabunta yanayin da ke tsakaninku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להמשיך הלאה יחד, לעשות משהו קליל — ככה מתאפסת אצלכם האנרגיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ आगे बढ़ना, कुछ हल्का-फुल्का करना — इसी तरह आप दोनों के बीच का माहौल फिर से ताज़ा होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krenuti dalje zajedno, uz nešto lagano – tako vraćaš dobru energiju među vama."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanse ansanm, fè yon bagay lejè — se konsa ou chanje enèji ant nou de a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Együtt továbblépni, valami könnyed dologgal – így frissíted fel a köztetek lévő energiát."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միասին առաջ գնալ, ինչ-որ թեթև բան անել — այսպես ես դու թարմացնում ձեր միջև մթնոլորտը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melangkah bersama, melakukan sesuatu yang ringan — begitulah caramu menyegarkan suasana di antara kalian."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịga n'ihu ọnụ, ime ihe dị mfe — otú ahụ ka ị si eme ka ume dị n'etiti unu laghachi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að halda áfram saman og gera eitthvað létt – þannig endurstillið þið orkuna á milli ykkar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andare avanti insieme, facendo qualcosa di leggero — è così che rimetti in circolo la giusta energia tra voi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりで気軽に楽しめることをして、一緒に前へ進む。それがふたりの空気をリセットする方法です。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maju bareng, nglakoni bab sing entheng — kuwi cara panjenengan nyegerake maneh swasana ing antarane panjenengan sakloron."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ერთად წინ წასვლა, რამე მსუბუქის კეთება — ასე აახლებ თქვენ შორის ენერგიას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бірге алға жүру, жеңіл бір іс істеу — араларыңдағы көңіл күйді осылай жаңартасың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បន្តទៅមុខជាមួយគ្នា ធ្វើអ្វីស្រាលៗ — នោះជារបៀបដែលអ្នកកែប្រែថាមពលរវាងអ្នកទាំងពីរឡើងវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಜೊತೆಯಾಗಿ ಮುಂದೆ ಸಾಗುವುದು, ಹಗುರವಾದ ಏನನ್ನಾದರೂ ಮಾಡುವುದು — ನಿಮ್ಮಿಬ್ಬರ ನಡುವಿನ ಭಾವವನ್ನು ನೀವು ಹೀಗೆ ಮತ್ತೆ ಸರಿಮಾಡುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가벼운 일을 함께하며 앞으로 나아가는 것. 그게 두 사람 사이의 분위기를 되돌리는 방법이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi hev re pêş de çûn, kirina tiştekî sivik — bi vî awayî tu enerjiya di navbera we de nû dikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бирге алдыга жылуу, жеңил бир нерсе кылуу — ушинтип экөөңдүн ортоңдогу маанайды жаңылайсың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zesummen no vir kucken an eppes Liichtes maachen — esou bréngs du d'Energie tëscht iech erëm an d'Rei."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ກ້າວໄປຂ້າງໜ້ານຳກັນ ເຮັດຫຍັງເບົາໆ — ນັ້ນຄືວິທີທີ່ເຈົ້າປັບພະລັງລະຫວ່າງກັນໃຫ້ກັບມາດີ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judėti pirmyn kartu, daryti ką nors lengvo – taip atnaujinate energiją tarp jūsų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iet tālāk kopā, darot kaut ko vieglu, – tā jūs atjaunojat enerģiju starp jums."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandroso miaraka, manao zavatra maivana — izany no fomba hamelomanao indray ny hery eo aminareo."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te haere whakamua tahi, ko te mahi i tētahi mea ngāwari — koinā tō huarahi e whakahou ai i te wairua i waenga i a kōrua."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да продолжите заедно, правејќи нешто лесно — така ја освежуваш енергијата меѓу вас."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ലഘുവായ എന്തെങ്കിലും ചെയ്ത് ഒരുമിച്ച് മുന്നോട്ട് നീങ്ങുക — അങ്ങനെയാണ് നിങ്ങൾക്കിടയിലെ അന്തരീക്ഷം നിങ്ങൾ വീണ്ടും ശരിയാക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хамтдаа урагшилж, хөнгөхөн юм хийх — та хоёрын хоорондох уур амьсгалыг чи ингэж сэргээдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकत्र पुढे जाणे, काहीतरी हलकेफुलके करणे — असेच तुम्ही दोघांमधले वातावरण पुन्हा ताजे करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melangkah ke hadapan bersama, melakukan sesuatu yang ringan — itulah cara anda menyegarkan semula suasana antara anda berdua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timxu 'l quddiem flimkien, tagħmlu xi ħaġa ħafifa — hekk terġa' tibdel l-enerġija ta' bejnietkom."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပေါ့ပါးတဲ့ တစ်ခုခုကို အတူလုပ်ရင်း ရှေ့ဆက်တာ — ဒါက နှစ်ယောက်ကြားက လေထုကို သင် ပြန်ကြည်လင်စေတဲ့ နည်းပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å gå videre sammen og gjøre noe lett – det er sånn du nullstiller energien mellom dere."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सँगै अघि बढ्दै, केही हलुका काम गर्दै — यसरी नै तपाईं आफूहरूबीचको ऊर्जा फेरि ताजा बनाउनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samen verder, iets luchtigs doen – zo zet jij de energie tussen jullie weer goed."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupita patsogolo limodzi, kuchita chinthu chopepuka — umu ndi mmene mumabwezeretsera mtendere pakati panu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waliin fuulduratti tarkaanfachuu, waan salphaa gochuu — karaa ati humna gidduu keessanii itti haaromsitu kana."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକାଠି ଆଗକୁ ବଢ଼ିବା, କିଛି ହାଲୁକା କାମ କରିବା — ଏହିପରି ଆପଣ ଦୁହିଁଙ୍କ ମଝିର ଶକ୍ତିକୁ ପୁଣି ସଜାଡ଼ନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਕੱਠੇ ਅੱਗੇ ਵਧਣਾ, ਕੁਝ ਹਲਕਾ-ਫੁਲਕਾ ਕਰਨਾ — ਇਸੇ ਤਰ੍ਹਾਂ ਤੁਸੀਂ ਆਪਸ ਦੀ ਊਰਜਾ ਨੂੰ ਮੁੜ ਠੀਕ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iść razem dalej, robiąc coś lekkiego – tak odświeżasz energię między wami."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یوځای مخکې تلل، یو سپک کار کول — همداسې تاسو د خپل منځ انرژي بېرته تازه کوئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir em frente juntos, fazendo algo leve — é assim que você renova a energia entre vocês."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir em frente a dois, a fazer algo leve — é assim que renovas a energia entre vocês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să mergeți mai departe împreună, făcând ceva lejer — așa resetezi energia dintre voi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигаться дальше вместе, заняться чем-то лёгким — так ты обновляешь атмосферу между вами."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gukomeza imbere hamwe, mukora ikintu cyoroheje — ubwo ni bwo buryo usubiza umwuka mwiza hagati yanyu."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එක්ව ඉදිරියට යාම, සැහැල්ලු දෙයක් කිරීම — ඔබ දෙදෙනා අතර ශක්තිය අලුත් කරගන්නේ එහෙමයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohnúť sa spolu ďalej, urobiť niečo ľahké – takto medzi vami obnovíš energiu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupaj naprej, z nečim lahkotnim – tako ponastaviš energijo med vama."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuenda mberi pamwe chete, muchiita chimwe chinhu chakareruka — ndiyo nzira yaunodzosa nayo mufaro pakati penyu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wadajir hore u socodka, wax fudud oo la sameeyo — taasi waa sida aad dib ugu habayso tamarta idinka dhexeysa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të ecni përpara bashkë, duke bërë diçka të lehtë – kështu e rifreskon energjinë mes jush."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кренути даље заједно, уз нешто лагано — тако враћаш енергију међу вама у равнотежу."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maju babarengan, ngalakukeun hal anu hampang — éta cara anjeun nyegerkeun deui suasana di antawis aranjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att gå vidare tillsammans med något lättsamt – det är så du nollställer energin mellan er."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusonga mbele pamoja, mkifanya kitu chepesi — hivyo ndivyo mnavyorejesha hali nzuri kati yenu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இலகுவான ஒன்றைச் செய்தபடி ஒன்றாக முன்னேறுவது — இப்படித்தான் உங்களுக்கிடையிலான மனநிலையைப் புதுப்பிக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కలిసి ముందుకు సాగుతూ, ఏదైనా తేలికైన పని చేయడం — అలాగే మీ మధ్య వాతావరణాన్ని మళ్లీ సరిచేస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якҷоя пеш рафтан, кори сабуке кардан — ҳамин тавр ту фазои байни шуморо нав мекунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก้าวต่อไปด้วยกันด้วยการทำอะไรเบาๆ สบายๆ นั่นคือวิธีที่คุณรีเซ็ตบรรยากาศระหว่างกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብሓባር ንቕድሚት ምኻድ፣ ፈኲስ ነገር ምግባር — ከምኡ ኢኹም ነቲ ኣብ መንጎኹም ዘሎ ሃዋህው እትሕድስዎ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bile öňe gitmek, ýeňil bir zat etmek — araňyzdaky keýpi şeýdip täzeleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte ilerlemek, hafif bir şey yapmak; aranızdaki enerjiyi böyle tazeliyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухатися далі разом і зайнятися чимось легким — так ти оновлюєш енергію між вами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساتھ آگے بڑھنا، کوئی ہلکا پھلکا کام کرنا — یوں آپ دونوں کے درمیان ماحول پھر سے خوشگوار ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birga oldinga yurish, yengil bir ish qilish — oranigizdagi kayfiyatni shunday yangilaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng nhau bước tiếp, làm điều gì đó nhẹ nhàng — đó là cách bạn làm mới bầu không khí giữa hai người."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuqhubela phambili kunye, nisenza into elula — yindlela obuyisela ngayo amandla aphakathi kwenu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títẹ̀síwájú papọ̀, ṣíṣe nǹkan fúyẹ́ — ọ̀nà tí ẹ fi ń tún afẹ́fẹ́ àárín yín ṣe nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起向前走、做點輕鬆的事，是你們重新調整氣氛的方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起往前走，做点轻松的事——这就是你让彼此气氛回暖的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起往前走、做點輕鬆的事，是你們重新調整氣氛的方式。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuqhubekela phambili ndawonye, nenza okuthile okulula — yindlela evuselela ngayo amandla phakathi kwenu."
          }
        }
      }
    },
