        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անկեղծ անորոշություն։ Դա նորմալ է, հատկապես եթե անցումային փուլում ես։ Աջակցող զուգընկերը կարող է հենարան դառնալ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketidakpastian yang jujur. Itu nggak apa-apa — apalagi kalau kamu sedang di masa transisi. Pasangan yang suportif bisa jadi penopangmu."
