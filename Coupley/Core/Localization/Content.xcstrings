          "stringUnit" : {
            "state" : "translated",
            "value" : "Bab sing angel kanggoku — ngomong ing ngarep umum, percaya dhiri"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რაღაც, რაც მიჭირს — საჯარო გამოსვლა, თავდაჯერებულობა"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзіме қиын бір нәрсе: көпшілік алдында сөйлеу, сенімділік"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្វីដែលខ្ញុំយល់ថាពិបាក — និយាយជាសាធារណៈ ទំនុកចិត្ត"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನನಗೆ ಕಷ್ಟವೆನಿಸುವುದು — ಸಭೆಯಲ್ಲಿ ಮಾತಾಡುವುದು, ಆತ್ಮವಿಶ್ವಾಸ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어려워하는 것(발표, 자신감)"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiştekî ku ji min re zehmet e — axaftina li ber gel, xwebawerî"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мага кыйын болгон нерсе — эл алдында сүйлөө, өзүнө ишеним"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eppes, wat mer schwéier fält — viru Leit schwätzen, Selbstvertrauen"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສິ່ງທີ່ຂ້ອຍຮູ້ສຶກວ່າຍາກ — ເວົ້າຕໍ່ໜ້າຄົນ ຄວາມໝັ້ນໃຈ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas man sunku – viešas kalbėjimas, pasitikėjimas savimi"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaut kas, kas man grūti – publiska runa, pārliecība"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavatra sarotra amiko — miteny imason'ny besinimaro, fahatokisan-tena"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mea uaua ki ahau — kōrero ki te marea, te māia"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нешто што ми е тешко — јавен говор, самодоверба"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എനിക്ക് ബുദ്ധിമുട്ടുള്ള ഒന്ന് — പൊതുവേദിയിലെ സംസാരം, ആത്മവിശ്വാസം"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надад хэцүү зүйл — олны өмнө ярих, өөртөө итгэх"
