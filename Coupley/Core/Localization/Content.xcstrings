          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾರಾದರೂ ಕಿರಿಕಿರಿಯಲ್ಲಿದ್ದಾಗ, ಪರಿಹಾರಕ್ಕಿಂತ ಅರ್ಥ ಮಾಡಿಕೊಳ್ಳುವುದೇ ಮುಖ್ಯ."
