    "Romantic and adaptable. You can be happy anywhere with the right person — and that's genuinely true for some people." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanties en aanpasbaar. Jy kan oral gelukkig wees met die regte mens – en vir sommige mense is dit regtig waar."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሮማንቲክና ተለማማጅ። ከትክክለኛው ሰው ጋር የትም ደስተኛ መሆን ይችላሉ — ይህም ለአንዳንድ ሰዎች በእርግጥ እውነት ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رومانسية ومرونة. السعادة عندك ممكنة في أي مكان مع الشخص المناسب، وهذا صحيح فعلًا لدى بعض الناس."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ৰোমাণ্টিক আৰু খাপ খুৱাব পৰা। সঠিক মানুহজনৰ লগত আপুনি যিকোনো ঠাইতে সুখী হ'ব পাৰে — আৰু কিছুমান মানুহৰ বাবে এয়া সঁচাকৈয়ে সত্য।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantik və uyğunlaşansan. Doğru insanla hər yerdə xoşbəxt ola bilərsən — və bəzi insanlar üçün bu, həqiqətən doğrudur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рамантычна і гнутка. Шчасце для цябе магчымае дзе заўгодна, калі побач правільны чалавек, — і для некаторых гэта сапраўды так."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтично и гъвкаво. Щастието за теб е навсякъде, стига да е с правилния човек – и за някои хора това наистина е така."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রোমান্টিক আর মানিয়ে নিতে পারো। ঠিক মানুষটার সাথে তুমি যেকোনো জায়গায় খুশি থাকতে পারো — আর কিছু মানুষের ক্ষেত্রে এটা সত্যিই সত্যি।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantičnost i prilagodljivost. Sreću možeš naći bilo gdje uz pravu osobu – a za neke ljude to je zaista istina."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanticisme i adaptabilitat. Pots ser feliç a qualsevol lloc amb la persona adequada — i per a algunes persones això és ben cert."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantika a přizpůsobivost. Se správným člověkem najdeš štěstí kdekoli – a pro někoho to opravdu platí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhamantus a hyblyg. Gallet ti fod yn hapus yn unrhyw le gyda'r person iawn — ac mae hynny wir yn wir i rai pobl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk og tilpasningsdygtig. Du kan være glad hvor som helst med den rette person – og for nogle er det helt sandt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisch und anpassungsfähig. Mit dem richtigen Menschen kannst du überall glücklich sein – und für manche stimmt das wirklich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρομαντισμός και προσαρμοστικότητα. Μπορείς να βρεις την ευτυχία οπουδήποτε με τον σωστό άνθρωπο — και για κάποιους αυτό ισχύει πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanticismo y adaptabilidad. Puedes ser feliz en cualquier sitio con la persona adecuada — y para algunas personas eso es completamente cierto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiline ja kohanemisvõimeline. Õige inimesega võid olla õnnelik kus iganes — ja mõne inimese puhul on see päriselt tõsi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erromantikoa eta egokigarria. Edonon izan zaitezke zoriontsu pertsona egokiarekin, eta hori benetan egia da jende batzuentzat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمانتیک و سازگار. با آدم درست هر جایی می‌توانی خوشحال باشی — و برای بعضی آدم‌ها این واقعاً حقیقت دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanttista ja sopeutuvaa. Voit olla onnellinen missä vain oikean ihmisen kanssa – ja joillekin se on aidosti totta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiko at madaling umangkop. Kaya mong maging masaya kahit saan basta tamang tao ang kasama — at totoo talaga ’yan para sa ilan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantique et adaptable. Avec la bonne personne, tu peux trouver le bonheur n'importe où — et pour certaines personnes, c'est vraiment le cas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rómánsúil agus solúbtha. Is féidir leat a bheith sona áit ar bith leis an duine ceart — agus is fíor é sin do dhaoine áirithe."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanticismo e adaptabilidade. Podes ser feliz en calquera sitio coa persoa axeitada, e para algunha xente iso é verdade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રોમેન્ટિક અને અનુકૂળ થનારા. યોગ્ય વ્યક્તિ સાથે તમે ક્યાંય પણ ખુશ રહી શકો — અને અમુક લોકો માટે એ સાચે જ સાચું છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu zuciyar soyayya da sauƙin sabawa. Kuna iya farin ciki a ko'ina tare da mutumin da ya dace — kuma hakan gaskiya ne ga wasu mutane."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רומנטיות וגמישות. עם האדם הנכון, טוב לך בכל מקום — ולאנשים מסוימים זה באמת נכון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोमांटिक और लचीला दिल। सही इंसान साथ हो, तो आपकी ख़ुशी कहीं भी मुमकिन है — और कुछ लोगों के साथ सच में ऐसा होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantičnost i prilagodljivost. Sreća ti je moguća bilo gdje s pravom osobom – a za neke ljude to je stvarno istina."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Womantik e adaptab. Ou ka kontan nenpòt kote ak bon moun nan — e pou kèk moun, se laverite toutbon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantikus és alkalmazkodó vagy. A megfelelő emberrel bárhol boldog tudsz lenni – és van, akire ez tényleg igaz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ռոմանտիկ և ճկուն։ Կարող ես երջանիկ լինել ցանկացած տեղ ճիշտ մարդու հետ, և որոշ մարդկանց համար դա իսկապես այդպես է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantis dan mudah beradaptasi. Kamu bisa bahagia di mana saja bersama orang yang tepat — dan bagi sebagian orang, itu memang benar."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị hụrụ ịhụnanya n'anya ma na-agbanwe onwe gị. Obi nwere ike ịdị gị ụtọ n'ebe ọ bụla na onye kwesịrị ekwesị — nke ahụ bụkwa eziokwu maka ụfọdụ mmadụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rómantískt og sveigjanlegt. Þú getur fundið hamingjuna hvar sem er með réttu manneskjunni – og það á í alvöru við um sumt fólk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanticismo e adattabilità. Puoi essere felice ovunque con la persona giusta — e per qualcuno è davvero così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロマンチストで柔軟な人です。ぴったりの相手がいればどこでも幸せになれる。それが本当に当てはまる人もいます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantis lan gampang nyesuekake. Panjenengan bisa seneng ing ngendi wae karo wong sing pas — lan iku pancen bener kanggo sawetara wong."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რომანტიკული და მოქნილი. სწორ ადამიანთან ერთად ყველგან შეგიძლია ბედნიერი იყო — და ზოგისთვის ეს მართლაც ასეა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтик әрі бейімделгіш жансың. Дұрыс адаммен кез келген жерде бақытты бола аласың, ал кейбір адамдар үшін бұл шынымен солай."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រ៉ូមែនទិក និងងាយសម្របខ្លួន។ អ្នកអាចសប្បាយចិត្តនៅកន្លែងណាក៏បាន ជាមួយមនុស្សត្រឹមត្រូវ — ហើយវាពិតជាពិតសម្រាប់មនុស្សខ្លះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಣಯಭರಿತ, ಹೊಂದಿಕೊಳ್ಳುವ ಸ್ವಭಾವ. ಸರಿಯಾದ ವ್ಯಕ್ತಿ ಜೊತೆಗಿದ್ದರೆ ನೀವು ಎಲ್ಲಿದ್ದರೂ ಸಂತೋಷವಾಗಿರಬಲ್ಲಿರಿ — ಕೆಲವರಿಗೆ ಅದು ನಿಜಕ್ಕೂ ಸತ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로맨틱하고 적응력이 좋아요. 맞는 사람과 함께라면 어디서든 행복할 수 있어요. 실제로 그런 사람들도 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantîk û xweguncîn. Tu dikarî bi kesê rast re li her derê bextewar bî — û ev ji bo hin kesan bi rastî rast e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтик жана ыңгайлашкыч. Туура адам менен каалаган жерде бактылуу боло аласың — кээ бир адамдар үчүн бул чындап эле ушундай."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantesch a flexibel. Du kanns mat der richteger Persoun iwwerall glécklech sinn — an dat ass bei verschiddene Leit wierklech esou."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໂຣແມນຕິກ ແລະ ປັບຕົວໄດ້ ເຈົ້າມີຄວາມສຸກໄດ້ທຸກບ່ອນ ຖ້າຢູ່ກັບຄົນທີ່ໃຊ່ — ແລະ ສຳລັບບາງຄົນ ນັ້ນເປັນຄວາມຈິງແທ້ໆ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiškumas ir prisitaikymas. Su tinkamu žmogumi tau gera bet kur – ir kai kuriems žmonėms tai iš tiesų tiesa."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantika un pielāgošanās. Ar īsto cilvēku tev var būt labi jebkur – un dažiem tā tiešām ir patiesība."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantika sy mora mampifanaraka. Afaka ho sambatra na aiza na aiza ianao miaraka amin'ilay olona mety — ary marina tokoa izany ho an'ny olona sasany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ngākau aroha, he ngāwari ki te urutau. Ka harikoa koe ki hea rānei me te tangata tika — ā, he pono tēnā mō ētahi tāngata."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтика и прилагодливост. Со вистинската личност, среќата за тебе е насекаде — а кај некои луѓе тоа навистина е така."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "റൊമാന്റിക്, എവിടെയും ഇണങ്ങുന്ന സ്വഭാവം. ശരിയായ ആളോടൊപ്പം എവിടെയും നിങ്ങൾക്ക് സന്തോഷിക്കാം — ചിലർക്ക് അത് ശരിക്കും സത്യമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтик, дасан зохицдог. Зөв хүнтэйгээ хаана ч аз жаргалтай байж чадна — зарим хүмүүст энэ үнэхээр үнэн."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोमँटिक आणि जुळवून घेणारे. योग्य व्यक्तीसोबत तुम्ही कुठेही आनंदी राहू शकता — आणि काही लोकांसाठी हे खरोखरच खरे असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantik dan mudah menyesuaikan diri. Anda boleh bahagia di mana saja dengan orang yang tepat — dan bagi sesetengah orang, itu memang benar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiċiżmu u adattabbiltà. Tista' ssib il-ferħ kullimkien mal-persuna t-tajba — u għal xi nies dan verament minnu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရိုမန်းတစ်ဆန်ပြီး လိုက်လျောညီထွေ ရှိတယ်။ မှန်ကန်တဲ့သူနဲ့ဆို ဘယ်နေရာမှာမဆို ပျော်နိုင်တယ် — တချို့လူတွေအတွက် ဒါ တကယ် မှန်ပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk og tilpasningsdyktig. Du kan være lykkelig hvor som helst med rett person – og for noen er det helt sant."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोमान्टिक र अनुकूल। सही मान्छेसँग तपाईं जहाँ पनि खुसी हुन सक्नुहुन्छ — र केही मान्छेका लागि यो साँच्चै सत्य हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisch en flexibel. Je kunt overal gelukkig zijn met de juiste persoon – en voor sommige mensen is dat echt zo."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachikondi ndi wozolowera. Mungakhale osangalala kulikonse ndi munthu woyenera — ndipo kwa anthu ena zimenezo ndi zoonadi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaalalaa fi kan of madaqsu. Nama sirrii wajjin bakka kamittuu gammaduu dandeessa — kunis namoota tokko tokkoof dhugumaan dhugaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ରୋମାଣ୍ଟିକ୍ ଓ ଖାପ ଖୁଆଇପାରନ୍ତି। ଠିକ୍ ମଣିଷ ସହ ଆପଣ ଯେକୌଣସି ଜାଗାରେ ଖୁସି ରହିପାରିବେ — ଆଉ କିଛି ଲୋକଙ୍କ ପାଇଁ ଏହା ସତରେ ସତ୍ୟ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰੋਮਾਂਟਿਕ ਅਤੇ ਲਚਕੀਲਾ ਸੁਭਾਅ। ਸਹੀ ਇਨਸਾਨ ਨਾਲ ਤੁਸੀਂ ਕਿਤੇ ਵੀ ਖ਼ੁਸ਼ ਰਹਿ ਸਕਦੇ ਹੋ — ਅਤੇ ਕੁਝ ਲੋਕਾਂ ਲਈ ਇਹ ਸੱਚਮੁੱਚ ਸੱਚ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantycznie i elastycznie. Z właściwą osobą szczęście znajdziesz wszędzie – i niektórzy naprawdę tak mają."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رومانس او انعطاف. له سم کس سره هر چېرې خوشحالي موندلای شئ — او دا د ځینو خلکو لپاره رښتیا هم سمه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantismo e adaptação. Você consegue ser feliz em qualquer lugar com a pessoa certa — e para algumas pessoas isso é bem verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantismo e capacidade de adaptação. Podes ser feliz em qualquer lado com a pessoa certa — e para algumas pessoas isso é mesmo verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantism și adaptabilitate. Poți găsi fericirea oriunde, cu persoana potrivită — și pentru unii oameni asta chiar e adevărat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтично и гибко. С правильным человеком тебе может быть хорошо где угодно — и для некоторых людей это действительно так."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urakunda kandi wihuza n'ibihe. Ushobora kwishima aho ari ho hose uri kumwe n'umuntu ukwiye — kandi ku bantu bamwe ibyo ni ukuri koko."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ආදරණීය සහ අනුවර්තනශීලී. හරි කෙනා එක්ක ඕනෑම තැනක ඔබට සතුටින් ඉන්න පුළුවන් — සමහර අයට ඒක ඇත්තටම ඇත්ත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantika a prispôsobivosť. So správnym človekom ti môže byť dobre kdekoľvek – a pre niektorých ľudí to naozaj platí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantično in prilagodljivo. S pravo osebo lahko srečo najdeš kjerkoli – in za nekatere ljudi to resnično drži."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une rudo uye unochinjika. Unogona kufara chero kupi nemunhu akakodzera — uye izvi ndezvechokwadi kune vamwe vanhu."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jacayl leh oo la qabsada. Meel kasta waad ku farxi kartaa haddii aad la joogto qofka saxda ah — taasina runtii waa run dadka qaar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantizëm dhe përshtatshmëri. Mund ta gjesh lumturinë kudo me personin e duhur – dhe për disa njerëz kjo është vërtet e vërtetë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтично и прилагодљиво. Уз праву особу свуда ти је добро — и за неке људе то је заиста тачно."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantis sareng gampil adaptasi. Anjeun tiasa bagja di mana waé sareng jalma anu pas, sareng éta leres-leres kajantenan pikeun sawaréh jalma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk och anpassningsbar. Du kan vara lycklig var som helst med rätt person – och för vissa stämmer det verkligen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wa kimapenzi na mwepesi wa kubadilika. Unaweza kuwa na furaha popote ukiwa na mtu sahihi — na kwa baadhi ya watu hilo ni kweli kabisa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காதல் மனமும் தகவமைப்பும். சரியான நபருடன் எங்கும் மகிழ்ச்சியாக இருக்க முடியும் — சிலருக்கு அது உண்மையாகவே உண்மை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రొమాంటిక్, సర్దుకుపోయే గుణం. సరైన వ్యక్తితో మీరు ఎక్కడైనా సంతోషంగా ఉండగలరు — కొంతమందికి అది నిజంగా నిజమే."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошиқона ва мутобиқшаванда. Ту бо одами дуруст дар ҳар ҷо хушбахт буда метавонӣ — ва барои баъзеҳо ин воқеан рост аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โรแมนติกและปรับตัวได้ คุณมีความสุขได้ทุกที่ถ้าอยู่กับคนที่ใช่ และสำหรับบางคนนั่นคือความจริง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፍቕራውያንን ተላመድትን። ምስቲ ቅኑዕ ሰብ ኣብ ዝኾነ ቦታ ሕጉሳት ክትኮኑ ትኽእሉ — እዚ ድማ ንገሊኦም ሰባት ብሓቂ ሓቂ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantik we uýgunlaşýan. Dogry adam bilen islendik ýerde bagtly bolup bilýärsiň — we käbir adamlar üçin bu hakykatdan şeýle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantik ve uyumlu. Doğru kişiyle her yerde mutlu olabilirsin; bu bazı insanlar için gerçekten doğru."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтично й гнучко. Поруч із потрібною людиною тобі добре будь-де — і для декого це справді так."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رومانوی اور لچکدار۔ صحیح انسان ساتھ ہو تو آپ کے لیے ہر جگہ خوشی ہے، اور کچھ لوگوں کے لیے یہ واقعی سچ ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantik va moslashuvchan. Toʻgʻri odam bilan istalgan joyda baxtli boʻla olasiz — va baʼzi odamlar uchun bu chindan ham haqiqat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lãng mạn và dễ thích nghi. Bạn có thể hạnh phúc ở bất cứ đâu khi ở bên đúng người — và với một số người, điều đó là thật."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unothando kwaye uyaziqhelanisa. Ungonwaba naphi na nomntu ofanelekileyo — kwaye oko kuyinyani ngokwenene kwabanye abantu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ jẹ́ ẹni ìfẹ́, ẹ sì lè bá ipò mu. Ẹ lè láyọ̀ níbikíbi pẹ̀lú ẹni tó tọ́ — èyí sì jẹ́ òtítọ́ fún àwọn kan."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浪漫又隨遇而安。只要跟對的人一起，你在哪裏都能快樂——對有些人來說，這是真的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浪漫又随遇而安。和对的人在一起，你在哪儿都能开心，对有些人来说这是真的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浪漫又能適應。和對的人在一起，你在哪裡都能很快樂，對有些人來說這真的是事實。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
