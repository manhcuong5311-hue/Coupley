        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባህል በእውነት የሚኖረው ማዕድ ላይ ነው። ከበረራ በፊት ምግብ ቤት ያስይዛሉ፣ ያ ደግሞ ትክክል ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المائدة هي حيث تعيش الثقافة حقًا. تحجزون المطاعم قبل تذاكر الطيران، وهذا هو الصواب."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আচল সংস্কৃতি সাঁজৰ মেজতহে বাস কৰে। আপুনি বিমানৰ আগতে ৰেষ্টুৰেণ্ট বুক কৰে, আৰু সেয়াই শুদ্ধ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mədəniyyət əslində süfrədə yaşayır. Restoranları biletlərdən əvvəl bron edirsən və bu, tamamilə doğrudur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапраўдная культура жыве за сталом. Ты бранюеш рэстараны раней за білеты — і гэта правільна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Културата всъщност живее на масата. Резервираш ресторантите преди полетите – и това е правилно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংস্কৃতি আসলে থাকে খাবারের টেবিলে। তুমি ফ্লাইটের আগে রেস্তোরাঁ বুক করো, আর সেটাই ঠিক।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za stolom zapravo živi kultura. Restorane rezervišeš prije letova i to je sasvim ispravno."
