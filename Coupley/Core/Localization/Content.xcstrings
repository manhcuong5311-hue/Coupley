        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጥልቅ መልስ — ብዙ ጊዜም ከሁሉ ጤናማው። በሚቆጠርበት ቦታ አብሮ፣ በሚያስፈልግበት ቦታ ራስን ችሎ።"
