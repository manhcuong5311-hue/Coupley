    "Middle ground. You appreciate order but you're not going to fight about a dish in the sink." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل وسط. تقدّرون النظام، لكنكم لن تتشاجروا بسبب طبق في المغسلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlatá střední cesta. Ceníš si pořádku, ale kvůli jednomu talíři ve dřezu se hádat nebudeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gyldne middelvej. Du sætter pris på orden, men du starter ikke et skænderi over en tallerken i vasken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mittelweg. Du magst Ordnung, aber wegen einer Tasse in der Spüle streitest du nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μέση οδός. Εκτιμάς την τάξη, αλλά δεν θα τσακωθείς για ένα πιάτο στον νεροχύτη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punto intermedio. Aprecias el orden, pero no vas a discutir por un plato en el fregadero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kultainen keskitie. Arvostat järjestystä, mutta et ala riidellä yhdestä likaisesta astiasta tiskialtaassa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitna. Gusto mo ng kaayusan pero hindi ka makikipag-away dahil sa isang plato sa lababo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le juste milieu. Tu apprécies l'ordre, mais tu ne vas pas te disputer pour une assiette dans l'évier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרך האמצע. סדר חשוב לך, אבל כוס אחת בכיור לא תוביל אצלך למריבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीच का रास्ता। आपको व्यवस्था अच्छी लगती है, पर सिंक में पड़ी एक प्लेट पर आप झगड़ा नहीं करेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arany középút. Értékeled a rendet, de egy mosatlan bögre miatt nem fogsz veszekedni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan tengah. Kamu menghargai keteraturan, tapi nggak akan ribut gara-gara satu piring di wastafel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una via di mezzo. Apprezzi l’ordine, ma non farai una lite per un piatto nel lavandino."
