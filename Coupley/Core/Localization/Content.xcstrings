    "Do something together that asks nothing — cook, fold laundry, draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افعلوا معًا شيئًا لا يتطلب جهدًا: الطبخ، طي الغسيل، الرسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dělejte spolu něco, co nic nežádá – vařte, skládejte prádlo, kreslete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør noget sammen, der ikke kræver noget – lav mad, fold vasketøj, tegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht etwas zusammen, das nichts verlangt – kochen, Wäsche falten, zeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε μαζί κάτι που δεν ζητάει τίποτα — μαγείρεμα, δίπλωμα ρούχων, ζωγραφική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca algo que hacer juntos que no exija nada: cocinar, doblar ropa, dibujar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehkää yhdessä jotain, joka ei vaadi mitään – kokatkaa, viikatkaa pyykkiä, piirtäkää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumawa nang magkasama ng bagay na walang hinihingi — magluto, magtupi ng damit, gumuhit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites ensemble quelque chose qui ne demande rien : cuisiner, plier le linge, dessiner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לעשות ביחד משהו שלא דורש כלום — לבשל, לקפל כביסה, לצייר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ मिलकर कोई ऐसा काम करें जिसमें कुछ माँगा न जाए — खाना बनाना, कपड़े तह करना, ड्रॉइंग।"
