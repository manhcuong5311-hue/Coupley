        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn cảnh quyết định. Một chuyến cuối tuần ở thành phố khác với tuần trăng mật, ngân sách cũng phải khác. Rất thực tế."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imeko ibalulekile. Impelaveki esixekweni neholide yomtshato zifanelwe luhlahlo-lwabiwo mali olwahlukileyo. Uyaqiqa."
