        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองตามความเป็นจริง ครอบครัวต่างกันก็ต้องใช้วิธีต่างกัน สิ่งสำคัญคือคุณทั้งสองเห็นตรงกัน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክውን። ዝተፈላለዩ ስድራታት ዝተፈላለየ ኣገባብ ይሓቱ። ኣገዳሲ ዝኾነ ክልቴኹም ሓደ ሓሳብ ምህላውኩም እዩ።"
