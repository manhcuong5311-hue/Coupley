    "How people recharge tells you a lot about what they need week to week." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طريقة استعادة الطاقة تكشف الكثير عمّا يحتاجه المرء أسبوعًا بعد أسبوع."
          }
        },
        "cs" : {
          "stringUnit" : {
