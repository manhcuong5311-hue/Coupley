        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Атмосфера важливіша за формальності. Тобі хочеться відчути енергію міста без церемоній ресторанного вечора."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không khí hơn nghi thức. Bạn muốn sự sôi động của việc ra ngoài mà không cần trịnh trọng ngồi bàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氛围比排场重要。你想要出门的热闹劲儿，又不想正襟危坐吃一顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氣氛比排場重要。你想感受外出的熱鬧，又不想正襟危坐吃一頓。"
          }
        }
      }
    },
