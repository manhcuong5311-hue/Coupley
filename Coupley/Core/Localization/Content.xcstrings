    "Open to change but within familiar culture. You want a fresh start without full relocation uncertainty." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oop vir verandering, maar binne ’n bekende kultuur. Jy wil ’n nuwe begin sonder die onsekerheid van ’n volledige verhuising."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለለውጥ ክፍት፣ ግን በሚያውቁት ባህል ውስጥ። ሙሉ በሙሉ የመዛወር እርግጠኛ አለመሆን ሳይኖር አዲስ ጅማሬ ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انفتاح على التغيير ضمن ثقافة مألوفة. بداية جديدة من دون مجهول الانتقال الكامل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সলনিৰ বাবে মুকলি, কিন্তু চিনাকি সংস্কৃতিৰ ভিতৰত। সম্পূৰ্ণ নতুন ঠাইলৈ যোৱাৰ অনিশ্চয়তা নোহোৱাকৈ আপুনি নতুনকৈ আৰম্ভ কৰিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dəyişikliyə açıqsan, amma tanış mədəniyyət daxilində. Tam köçün qeyri-müəyyənliyi olmadan yeni başlanğıc istəyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкрытасць да пераменаў, але ў знаёмай культуры. Табе хочацца пачаць нанова без усіх нявызначанасцей поўнага пераезду."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвореност за промяна, но в позната култура. Искаш ново начало без несигурността на пълно преместване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বদলের জন্য তৈরি, তবে চেনা সংস্কৃতির মধ্যে। পুরোপুরি অন্য জায়গায় যাওয়ার অনিশ্চয়তা ছাড়াই নতুন শুরু চাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorenost za promjenu, ali u poznatoj kulturi. Želiš novi početak bez neizvjesnosti potpunog preseljenja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obertura al canvi, però dins d'una cultura coneguda. Vols començar de nou sense la incertesa d'un trasllat complet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřenost změně, ale ve známém prostředí. Chceš nový začátek bez nejistoty úplného přesídlení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agored i newid, ond o fewn diwylliant cyfarwydd. Rwyt ti eisiau dechrau newydd heb ansicrwydd symud yn llwyr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åben for forandring, men i en kendt kultur. Du vil have en ny start uden al usikkerheden ved at flytte helt væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offen für Veränderung, aber in vertrauter Kultur. Du willst einen Neuanfang, ohne gleich ganz ins Ungewisse auszuwandern."
