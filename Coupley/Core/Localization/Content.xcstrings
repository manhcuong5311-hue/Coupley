        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Específico acima de genérico. “Você é incrível” não chega a tocar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concretul bate generalul. „Ești o minune” sună gol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретное лучше общего. «Ты супер» звучит плоско."
          }
