        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принципиалдуу. Сенин стандарттарың бар жана аларды пиццага да колдоносуң. Жемиштин орду башка жерде."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat Prinzipien. Du hues Standarden an du wends se och op Pizza un. Uebst gehéiert soss iergendwou hin."
