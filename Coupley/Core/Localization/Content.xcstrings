    "Flexible but not indifferent. You're not actively wanting or avoiding — you're open to what the relationship calls for." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرونة لا لامبالاة. لا سعي ولا تجنّب، بل انفتاح على ما تحتاجه العلاقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilní, ale ne lhostejný postoj. Aktivně po tom netoužíš ani se tomu nevyhýbáš – necháváš to na tom, co vztah přinese."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, men ikke ligeglad. Du hverken ønsker eller undgår det aktivt – du er åben for, hvad forholdet lægger op til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel, aber nicht gleichgültig. Du willst es weder unbedingt noch vermeidest du es – du bist offen für das, was die Beziehung braucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευελιξία, όχι αδιαφορία. Ούτε το επιδιώκεις ούτε το αποφεύγεις — αφήνεις χώρο σε ό,τι ζητήσει η σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad, no indiferencia. No lo buscas ni lo evitas — te abres a lo que pida la relación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joustava mutta ei välinpitämätön. Et aktiivisesti halua etkä vältä – olet avoin sille, mitä suhde tuo tullessaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible pero hindi walang pakialam. Hindi mo ito aktibong hinahanap o iniiwasan — bukas ka sa kung ano ang hinihingi ng relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la souplesse, pas de l'indifférence. Tu n'en veux pas à tout prix, mais tu ne l'exclus pas : tu laisses de la place à ce que la relation demandera."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות, לא אדישות. אין כאן רצון עז או הימנעות — יש פתיחות למה שהקשר יזמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लचीलापन, बेपरवाही नहीं। न बच्चों की तीव्र चाह है, न उनसे परहेज़ — रिश्ता जो माँगे, उसके लिए आपका मन खुला है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugalmas vagy, de nem közömbös. Nem vágysz rá kifejezetten, de nem is kerülöd – nyitott vagy arra, amit a kapcsolat kíván."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, tapi bukan berarti cuek. Kamu nggak sedang mengejar atau menghindarinya — kamu terbuka pada apa yang dibutuhkan hubungan kalian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibilità, non indifferenza. Non li cerchi né li eviti attivamente — lasci spazio a ciò che la relazione chiederà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔軟だけど、どうでもいいわけではありません。強く望むわけでも避けるわけでもなく、ふたりの関係に合わせて考えたいのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유연하지만 무관심한 건 아니에요. 적극적으로 원하지도 피하지도 않고, 관계가 이끄는 방향에 열려 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel tetapi bukan tidak peduli. Anda tidak bersungguh mahu atau mengelak — anda terbuka mengikut keperluan hubungan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, men ikke likegyldig. Du verken ønsker eller unngår det aktivt – du er åpen for det forholdet trenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel, maar niet onverschillig. Je wilt het niet per se, en je vermijdt het ook niet – je staat open voor wat de relatie vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastycznie, ale nie obojętnie. Ani tego aktywnie nie chcesz, ani nie unikasz – zostawiasz miejsce na to, czego będzie potrzebował związek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade, não indiferença. Você não está buscando nem evitando — tem abertura para o que a relação pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate, nu indiferență. Nici nu îți dorești activ, nici nu eviți — rămâi cu mintea deschisă la ce cere relația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гибкость, но не безразличие. Ты не стремишься к этому и не избегаешь — всё зависит от того, чего потребуют отношения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel men inte likgiltig. Du varken längtar efter eller undviker det – du är öppen för vad relationen behöver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นแต่ไม่ได้เฉยเมย คุณไม่ได้อยากมีเป็นพิเศษหรือพยายามเลี่ยง คุณเปิดรับสิ่งที่ความสัมพันธ์ต้องการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esneksin ama kayıtsız değilsin. Ne özellikle istiyor ne de kaçıyorsun; ilişkinin gerektirdiğine açıksın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнучко, але не байдуже. Ти не прагнеш цього й не уникаєш — а відкриваєшся тому, чого потребуватимуть ваші стосунки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt nhưng không thờ ơ. Bạn không chủ động mong cũng chẳng né tránh — bạn mở lòng với điều mối quan hệ cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵活，但并非无所谓。你不是特别想要，也没有刻意回避，而是看这段关系需要什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有彈性，但不是無所謂。你不特別想要也不刻意避免，而是看這段感情需要什麼。"
          }
        }
      }
    },
    "Flexible within structure. You want a safety net but you don't need a script. Most people find this easy to work with." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرونة داخل إطار. تريدون شبكة أمان دون نص مكتوب، ومعظم الناس يجدون ذلك سهلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volnost v rámci struktury. Chceš záchrannou síť, ale scénář nepotřebuješ. S tím se většině lidí pracuje snadno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel inden for en ramme. Du vil gerne have et sikkerhedsnet, men du behøver ikke et manuskript. Det har de fleste let ved at indrette sig efter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel mit Struktur. Du willst ein Sicherheitsnetz, aber kein Drehbuch. Damit kommen die meisten gut klar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευελιξία μέσα σε ένα πλαίσιο. Θέλεις δίχτυ ασφαλείας, αλλά όχι σενάριο. Με αυτό οι περισσότεροι συνεννοούνται εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad dentro de una estructura. Quieres una red de seguridad, pero no necesitas un guion. Con eso, casi todo el mundo se siente a gusto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joustava raamien sisällä. Haluat turvaverkon, mutta et käsikirjoitusta. Useimpien on helppo toimia kanssasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible sa loob ng balangkas. Gusto mo ng safety net pero hindi mo kailangan ng script. Madali kang pakisamahan ng karamihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la souplesse dans un cadre. Tu veux un filet de sécurité, pas un scénario. La plupart des gens s'y retrouvent facilement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות בתוך מסגרת. רשת ביטחון זה כן, תסריט זה לא. לרוב האנשים קל לעבוד עם זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढाँचे के भीतर लचीलापन। आपको सहारा चाहिए, पर पूरी स्क्रिप्ट नहीं। ज़्यादातर लोगों को आपके साथ चलना आसान लगता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugalmas vagy egy kereten belül. Kell a biztonsági háló, de forgatókönyv nem. A legtöbben könnyen alkalmazkodnak ehhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel dalam struktur. Kamu ingin ada jaring pengaman, tapi tidak butuh naskah. Kebanyakan orang mudah menyesuaikan diri dengan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibilità con una struttura. Vuoi una rete di sicurezza, ma non un copione. Con te è facile organizzarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枠のなかで柔軟に動けるタイプ。安心できる備えはほしいけれど、台本までは要りません。たいていの人が合わせやすいスタイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "틀 안에서 유연해요. 안전망은 원하지만 대본까지는 필요 없죠. 대부분의 사람이 맞추기 편한 스타일이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel dalam struktur. Anda mahukan jaring keselamatan tetapi tidak perlukan skrip. Kebanyakan orang mudah bekerjasama dengan cara ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel innenfor rammer. Du vil ha et sikkerhetsnett, men trenger ikke manus. De fleste synes det er lett å forholde seg til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel binnen een structuur. Je wilt een vangnet, maar geen draaiboek. De meeste mensen vinden dat makkelijk om mee om te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastyczność w ramach struktury. Chcesz mieć siatkę bezpieczeństwa, ale nie potrzebujesz scenariusza. Większości ludzi łatwo się z tobą współpracuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade com estrutura. Você quer uma rede de segurança, mas não precisa de roteiro. A maioria das pessoas acha isso fácil de acompanhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate într-un cadru. Vrei o plasă de siguranță, dar nu ai nevoie de scenariu. Cei mai mulți oameni se înțeleg ușor cu asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гибкость в рамках. Тебе нужна страховка, но не сценарий. С таким подходом легко ладить большинству людей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel inom ramarna. Du vill ha ett skyddsnät men behöver inget manus. De flesta har lätt att anpassa sig till det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นในกรอบ คุณอยากมีตาข่ายรองรับแต่ไม่ต้องมีบท คนส่วนใหญ่ปรับเข้าหาแบบนี้ได้ง่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapı içinde esneklik. Bir güvenlik ağı istiyorsun ama senaryoya ihtiyacın yok. Çoğu insan bununla rahatça uyum sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнучкість у межах структури. Тобі потрібна страховка, але не сценарій. З цим більшості людей легко."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt trong khuôn khổ. Bạn muốn có lưới an toàn nhưng không cần kịch bản. Hầu hết mọi người đều thấy dễ phối hợp với bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在框架里保持灵活。你想要一张安全网，但不需要剧本。大多数人都觉得和你很好相处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在架構中保有彈性。你想要一張安全網，但不需要劇本。大多數人都覺得這樣很好相處。"
          }
        }
      }
    },
    "Flow state is your kind of weekend. Productive rest — doing something meaningful even when you don't have to — is your thing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانغماس في العمل هو عطلتكم المثالية. الراحة المنتجة، أي فعل شيء ذي معنى حتى دون إلزام، هي ما يناسبكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj ideální víkend je ponořit se do něčeho naplno. Produktivní odpočinek – dělat něco smysluplného, i když nemusíš – to je tvoje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow er din slags weekend. Produktiv hvile – at lave noget meningsfuldt, selvom du ikke behøver – er lige dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Flow zu sein ist dein Wochenende. Produktive Erholung – etwas Sinnvolles tun, auch wenn du nicht musst – ist genau dein Ding."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να χάνεσαι σε κάτι είναι το δικό σου Σαββατοκύριακο. Η παραγωγική ξεκούραση — να κάνεις κάτι με νόημα ακόμα κι όταν δεν χρειάζεται — είναι το στοιχείο σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fin de semana ideal es entrar en estado de flujo. El descanso productivo —hacer algo con sentido aunque no tengas que hacerlo— es lo tuyo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow-tila on sinun viikonloppusi. Tuottava lepo – jonkin merkityksellisen tekeminen silloinkin, kun ei ole pakko – on sinun juttusi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow state ang uri mo ng weekend. Produktibong pahinga — paggawa ng makabuluhang bagay kahit hindi mo kailangan — iyan ang hilig mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être dans ta bulle, c'est ton week-end idéal. Un repos productif, faire quelque chose qui a du sens même sans obligation : c'est tout toi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרימה היא סוף השבוע המושלם בשבילך. מנוחה פרודוקטיבית — לעשות משהו משמעותי גם כשלא חייבים — זה בדיוק הסגנון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी काम में डूब जाना ही आपका वीकेंड है। सुकून भरी मेहनत — ज़रूरत न होने पर भी कुछ सार्थक करना — यही आपको भाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked az a jó hétvége, amikor belefeledkezel valamibe. Az aktív pihenés – valami értelmeset csinálni akkor is, ha nem muszáj – a te műfajod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenggelam dalam hal yang kamu pedulikan, itulah akhir pekan versimu. Istirahat yang produktif — melakukan hal bermakna meski nggak harus — itu kamu banget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo weekend ideale è immergerti in ciò che fai. Il riposo produttivo — fare qualcosa di significativo anche quando non devi — fa proprio per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢中になれることが最高の週末。やらなくてもいい、意味のあることに取り組む「生産的な休息」があなたのスタイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몰입하는 시간이 나만의 주말이에요. 하지 않아도 되는 의미 있는 일을 하며 쉬는 생산적인 휴식이 딱 내 스타일이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asyik melakukan sesuatu ialah hujung minggu ideal anda. Rehat yang produktif — melakukan sesuatu yang bermakna walaupun tidak perlu — memang gaya anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt er din type helg. Produktiv hvile – å gjøre noe meningsfullt selv når du ikke må – er din greie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een flow raken is jouw soort weekend. Productief rusten – iets zinvols doen, ook als het niet hoeft – is helemaal jouw ding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan flow to twój sposób na weekend. Produktywny odpoczynek – robienie czegoś ważnego, nawet gdy nie musisz – to coś dla ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar no fluxo é seu tipo de fim de semana. Descanso produtivo — fazer algo significativo mesmo sem precisar — é a sua cara."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să te cufunzi complet într-o activitate — asta e weekendul tău ideal. Odihna productivă — să faci ceva care contează chiar dacă nu trebuie — e stilul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои идеальные выходные — в потоке. Продуктивный отдых, когда делаешь что-то значимое, даже если это необязательно, — это про тебя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow är din sorts helg. Produktiv vila – att göra något meningsfullt även när du inte måste – är din grej."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจดจ่อจนลืมเวลาคือสุดสัปดาห์ในแบบของคุณ การพักผ่อนอย่างมีคุณค่า ได้ทำสิ่งที่มีความหมายแม้ไม่จำเป็นต้องทำ คือสิ่งที่ใช่สำหรับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akışta olmak senin hafta sonu tarzın. Üretken dinlenme, yani zorunda olmasan da anlamlı bir şey yapmak, tam sana göre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стан потоку — твій ідеальний вікенд. Продуктивний відпочинок — займатися чимось значущим, навіть коли не мусиш, — це про тебе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đắm mình vào việc mình thích chính là kiểu cuối tuần của bạn. Nghỉ ngơi một cách hiệu quả — làm điều ý nghĩa dù chẳng ai bắt — là phong cách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全情投入就是你理想的周末。高效的休息——哪怕没人要求，也去做点有意义的事——才是你的风格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全心投入就是你的週末。有生產力的休息，在不必做的時候做點有意義的事，就是你的風格。"
          }
        }
      }
    },
