        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürümek stres hormonunu düşürür ve yan yana olmak karşı karşıya olmaktan iyidir."
          }
        },
        "uk" : {
          "stringUnit" : {
