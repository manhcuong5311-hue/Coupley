        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առավելագույն ճկունություն, կամ իրական անորոշություն։ Ամեն դեպքում դու կապված չես որոշակի վայրի, և դա իսկական ազատություն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat fleksibel — atau memang belum pasti. Apa pun itu, kamu nggak terikat pada satu tempat, dan itu kebebasan yang nyata."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị nwere ike ịgbanwe nke ukwuu — ma ọ bụ ị maghị n'ezie. N'ụzọ ọ bụla, ebe ọ bụla ejideghị gị, nke ahụ bụ ezigbo nnwere onwe."
