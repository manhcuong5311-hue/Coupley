            "value" : "Strādāt cītīgi, atpūsties pa īstam – atdodu visu"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miasa mafy, miala voly mafy — omeko ny heriko rehetra"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahi kaha, tākaro kaha — ka hoatu au i ngā mea katoa"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Многу работам, многу уживам — давам сè од себе"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കഠിനാധ്വാനം, നന്നായി ആസ്വാദനം — ഞാൻ എല്ലാം നൽകും"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ажилдаа ч, амралтдаа ч бүх хүчээ — би бүгдийг зориулдаг"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जीव तोडून काम, मनसोक्त मजा — सर्वस्व झोकून"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja kuat, berseronok pun kuat — saya beri segalanya"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naħdem iebes, niddeverti iebes — nagħti kollox"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အလုပ်လည်း အပြင်း၊ ပျော်လည်း အပြင်း — အကုန်ပေးတယ်"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full gass på jobb og fritid – jeg gir alt"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कडा मेहनत, भरपूर मोज — म सबै दिन्छु"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard werken, hard genieten – ik geef alles"
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulimbikira ntchito, kusangalala kwambiri — ndimapereka zonse"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimsee hojjechuu, cimsee gammaduu — waan hunda nan kenna"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଜୋରରେ କାମ, ଜୋରରେ ମଜା — ମୁଁ ସବୁକିଛି ଦିଏ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਡਟ ਕੇ ਕੰਮ, ਰੱਜ ਕੇ ਮੌਜ — ਪੂਰਾ ਜ਼ੋਰ ਲਾਈਦਾ ਹੈ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciężko pracuję, ostro się bawię – daję z siebie wszystko"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سخت کار، سخته تفریح — هر څه ورکوم"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho duro, curto muito — dou tudo de mim"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar muito, divertir-me muito — dou tudo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muncesc din greu, mă distrez din plin — dau totul"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работаю и отдыхаю на полную — выкладываюсь целиком"
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nkora cyane, nkinezeza cyane — mbiha byose"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මහන්සියෙන් වැඩ, හිත් පිරෙන්න විනෝදය — මම හැමදේම දෙනවා"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvrdo pracovať, naplno žiť – dávam do toho všetko"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trdo delo, trda zabava – dam vse od sebe"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shanda nesimba, farira nesimba — ndinopa zvose"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shaqo adag, madadaalo adag — wax walba waan siiyaa"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punoj fort, argëtohem fort – jap gjithçka"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радим пуном паром, уживам пуним плућима — дајем све од себе"
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja keras, senang-senang ogé keras — abdi masihan sagalana"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobba hårt, festa hårt – jag ger allt"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kufanya kazi kwa bidii, kustarehe kwa bidii — natoa kila kitu"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடுமையாக உழைத்து, மகிழ்ச்சியாக வாழ்வது — எல்லாவற்றையும் கொடுப்பேன்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కష్టపడి పని, మనసారా ఆనందం — అన్నీ పెట్టేస్తాను"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сахт кор мекунам, хуб истироҳат мекунам — ҳама чизро медиҳам"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานเต็มที่ เที่ยวเต็มที่ ทุ่มสุดตัว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብትሪ ምስራሕ፣ ብትሪ ምዝናይ — ኩሉ እህቦ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp işle, köp dynç al — hemme zadymy berýärin"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok çalışır, dolu dolu yaşarım, her şeyimi veririm"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працюю на повну, відпочиваю на повну"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوب محنت، خوب مزہ — پوری جان لگا دینا"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qattiq ishlash, maroqli dam olish — butun kuchimni beraman"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm hết sức, chơi hết mình — mình dốc toàn lực"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebenza nzima, wonwabe kakhulu — ndinika konke"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iṣẹ́ kára, ìgbádùn kára — mo ń fi gbogbo ara ṣe é"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力工作，盡情玩樂，我全力以赴"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼命工作，尽情玩乐，全力以赴"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拚命工作也盡情玩，全力以赴"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngisebenza kanzima, ngizijabulise kakhulu — ngiwunika konke"
          }
        }
      }
    },
    "Work is a means, not the point. You protect your evenings and weekends. That's a mature, healthy boundary." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk is ’n middel, nie die doel nie. Jy beskerm jou aande en naweke. Dis ’n volwasse, gesonde grens."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሥራ መንገድ እንጂ ግብ አይደለም። ምሽቶችዎንና የሳምንት መጨረሻዎችዎን ይጠብቃሉ። ያ የበሰለና ጤናማ ድንበር ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل وسيلة لا غاية. أمسياتك وعطلاتك محميّة، وهذه حدود ناضجة وصحية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাম এক মাধ্যম, লক্ষ্য নহয়। আপুনি সন্ধিয়া আৰু সপ্তাহান্তবোৰ ৰক্ষা কৰে। এয়া এক পৰিপক্ক, সুস্থ সীমা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş məqsəd yox, vasitədir. Axşamlarını və həftəsonlarını qoruyursan. Bu, yetkin, sağlam sərhəddir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Праца — сродак, а не сэнс. Ты беражэш вечары і выхадныя. Гэта сталая, здаровая мяжа."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата е средство, не цел. Пазиш вечерите и уикендите си. Това е зряла, здрава граница."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজ একটা মাধ্যম, লক্ষ্য নয়। তুমি তোমার সন্ধ্যা আর উইকেন্ড আগলে রাখো। এটা পরিণত, সুস্থ একটা সীমা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posao je sredstvo, ne cilj. Čuvaš večeri i vikende. To je zrela, zdrava granica."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La feina és un mitjà, no la finalitat. Protegeixes els vespres i els caps de setmana. És un límit madur i sa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práce je prostředek, ne cíl. Chráníš si večery a víkendy. To je zralá a zdravá hranice."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modd i gyrraedd y nod yw gwaith, nid y nod ei hun. Rwyt ti'n gwarchod dy nosweithiau a dy benwythnosau. Mae hynny'n ffin aeddfed, iach."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejde er et middel, ikke målet. Du værner om dine aftener og weekender. Det er en moden og sund grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit ist Mittel zum Zweck, nicht der Sinn. Du schützt deine Abende und Wochenenden. Eine reife, gesunde Grenze."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δουλειά είναι μέσο, όχι σκοπός. Προστατεύεις τα βράδια και τα Σαββατοκύριακά σου. Αυτό είναι ώριμο και υγιές όριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo es un medio, no el fin. Proteges tus tardes y tus fines de semana. Es un límite maduro y sano."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töö on vahend, mitte eesmärk. Sa hoiad oma õhtuid ja nädalavahetusi. See on küps ja terve piir."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lana bitartekoa da, ez helburua. Zure arratsaldeak eta asteburuak babesten dituzu. Muga heldu eta osasungarria da hori."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کار وسیله است، نه هدف. از عصرها و آخر هفته‌هایت محافظت می‌کنی. این مرزی پخته و سالم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työ on keino, ei päämäärä. Suojelet iltojasi ja viikonloppujasi. Se on kypsä ja terve raja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paraan lang ang trabaho, hindi ang punto. Pinoprotektahan mo ang mga gabi at weekend mo. Mature at malusog na hangganan ’yan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail est un moyen, pas une fin. Tu protèges tes soirées et tes week-ends. C'est une limite mûre et saine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is modh í an obair, ní an pointe. Cosnaíonn tú do thráthnónta agus do dheirí seachtaine. Teorainn aibí, shláintiúil í sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O traballo é un medio, non o fin. Protexes as tardes e as fins de semana. Iso é un límite maduro e san."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કામ સાધન છે, મંઝિલ નહીં. તમે તમારી સાંજ અને વીકએન્ડ સાચવી રાખો છો. એ પરિપક્વ, તંદુરસ્ત મર્યાદા છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiki hanya ce, ba shi ne manufa ba. Kuna kare maraicenku da ƙarshen mako. Wannan iyaka ce mai lafiya ta manya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבודה היא אמצעי, לא העיקר. הערבים וסופי השבוע שלך מוגנים. זה גבול בוגר ובריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम एक ज़रिया है, मंज़िल नहीं। आपकी शामें और वीकेंड सिर्फ़ आपके हैं। यह एक परिपक्व, सेहतमंद सीमा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posao je sredstvo, a ne cilj. Čuvaš svoje večeri i vikende. To je zrela, zdrava granica."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travay se yon mwayen, se pa bi a. Ou pwoteje aswè ak wikenn ou. Se yon limit ki mi e an sante."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munka eszköz, nem cél. Véded az estéidet és a hétvégéidet. Ez érett, egészséges határ."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Աշխատանքը միջոց է, ոչ թե նպատակ։ Դու պաշտպանում ես երեկոներդ ու հանգստյան օրերդ։ Սա հասուն ու առողջ սահման է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan adalah sarana, bukan tujuan. Kamu menjaga malam dan akhir pekanmu. Itu batasan yang dewasa dan sehat."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọrụ bụ ụzọ, ọ bụghị isi ihe. Ị na-echekwa mgbede gị na ngwụcha izu gị. Nke ahụ bụ oke dị mma nke onye tozuru etozu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinnan er leið, ekki takmark. Þú verndar kvöldin og helgarnar. Það eru þroskuð og heilbrigð mörk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro è un mezzo, non il fine. Difendi le tue serate e i tuoi weekend. È un confine maturo e sano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事は手段であって、目的ではありません。夜と週末をしっかり守る、大人で健全な線引きです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaweyan iku sarana, dudu tujuan. Panjenengan njaga wayah bengi lan akhir minggu. Kuwi wates sing diwasa lan sehat."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სამსახური საშუალებაა და არა მიზანი. საღამოებსა და შაბათ-კვირას იცავ. ეს მომწიფებული, ჯანსაღი საზღვარია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жұмыс — мақсат емес, құрал. Кештерің мен демалыс күндеріңді қорғайсың. Бұл — кемел әрі сау шекара."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការងារជាមធ្យោបាយ មិនមែនជាគោលដៅទេ។ អ្នកការពារពេលល្ងាច និងចុងសប្ដាហ៍របស់អ្នក។ នោះជាព្រំដែនដែលចាស់ទុំ និងល្អ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೆಲಸ ಒಂದು ಸಾಧನ, ಗುರಿಯಲ್ಲ. ನಿಮ್ಮ ಸಂಜೆ ಮತ್ತು ವಾರಾಂತ್ಯಗಳನ್ನು ಕಾಪಾಡುತ್ತೀರಿ. ಅದು ಪ್ರಬುದ್ಧ, ಆರೋಗ್ಯಕರ ಮಿತಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일은 수단이지 목적이 아니에요. 저녁과 주말을 지켜요. 성숙하고 건강한 선 긋기예요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kar amûrek e, ne armanc. Tu êvar û dawiya hefteyên xwe diparêzî. Ev sînorekî gihîştî û tendurist e."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иш — максат эмес, каражат. Кечтериңди жана дем алыштарыңды коргойсуң. Бул жетилген, дени сак чек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aarbecht ass e Mëttel, net den Zweck. Du schützt deng Owender a Weekender. Dat ass eng reif, gesond Grenz."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ວຽກຄືເຄື່ອງມື ບໍ່ແມ່ນເປົ້າໝາຍ ເຈົ້າຮັກສາຕອນແລງ ແລະ ທ້າຍອາທິດໄວ້ ນັ້ນຄືຂອບເຂດທີ່ເປັນຜູ້ໃຫຍ່ ແລະ ດີຕໍ່ສຸຂະພາບ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbas – priemonė, ne tikslas. Saugai savo vakarus ir savaitgalius. Tai brandi, sveika riba."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbs ir līdzeklis, ne mērķis. Tu sargā savus vakarus un nedēļas nogales. Tā ir nobriedusi, veselīga robeža."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitaovana ny asa, fa tsy tanjona. Arovanao ny hariva sy ny faran'ny herinandro. Fetra matotra sy mahasalama izany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He huarahi te mahi, ehara i te tino take. Ka tiaki koe i ō ahiahi me ō mutunga wiki. He rohe pakeke, hauora hoki tēnā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата е средство, а не цел. Ги чуваш вечерите и викендите. Тоа е зрела, здрава граница."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ജോലി ഒരു മാർഗമാണ്, ലക്ഷ്യമല്ല. നിങ്ങളുടെ വൈകുന്നേരങ്ങളും വീക്കെൻഡുകളും നിങ്ങൾ കാത്തുസൂക്ഷിക്കുന്നു. പക്വവും ആരോഗ്യകരവുമായ ഒരു അതിരാണത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ажил бол зорилго биш, хэрэгсэл. Чи орой, амралтын өдрүүдээ хамгаалдаг. Энэ бол төлөвшсөн, эрүүл хил хязгаар."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम हे साधन आहे, साध्य नाही. तुम्ही तुमच्या संध्याकाळी आणि वीकेंड जपता. ही परिपक्व, निरोगी मर्यादा आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja ialah alat, bukan matlamat. Anda menjaga waktu petang dan hujung minggu. Itu batasan yang matang dan sihat."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ix-xogħol huwa mezz, mhux il-għan. Tħares il-filgħaxijiet u l-weekends tiegħek. Dan huwa limitu matur u b'saħħtu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အလုပ်က နည်းလမ်းပါ၊ ပန်းတိုင် မဟုတ်ဘူး။ ညနေခင်းတွေနဲ့ ပိတ်ရက်တွေကို ကာကွယ်ထားတယ်။ ဒါက ရင့်ကျက်ပြီး ကျန်းမာတဲ့ နယ်နိမိတ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobben er et middel, ikke målet. Du verner om kvelder og helger. Det er en moden og sunn grense."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम साधन हो, लक्ष्य होइन। तपाईं आफ्ना साँझ र सप्ताहान्त जोगाउनुहुन्छ। यो परिपक्व र स्वस्थ सीमा हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk is een middel, geen doel. Je beschermt je avonden en weekenden. Dat is een volwassen, gezonde grens."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntchito ndi njira, osati cholinga. Mumateteza madzulo anu ndi kumapeto kwa sabata. Ndi malire okhwima ndi athanzi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hojiin meeshaa dha, kaayyoo miti. Galgalaa fi dhuma torbanii kee ni eegda. Kun daangaa bilchaataa fi fayya-qabeessa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କାମ ଏକ ମାଧ୍ୟମ, ଲକ୍ଷ୍ୟ ନୁହେଁ। ଆପଣ ନିଜ ସନ୍ଧ୍ୟା ଓ ସପ୍ତାହାନ୍ତକୁ ସୁରକ୍ଷିତ ରଖନ୍ତି। ଏହା ଏକ ପରିପକ୍ୱ, ସୁସ୍ଥ ସୀମା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੰਮ ਇੱਕ ਸਾਧਨ ਹੈ, ਮਕਸਦ ਨਹੀਂ। ਤੁਸੀਂ ਆਪਣੀਆਂ ਸ਼ਾਮਾਂ ਅਤੇ ਵੀਕਐਂਡ ਬਚਾ ਕੇ ਰੱਖਦੇ ਹੋ। ਇਹ ਸਿਆਣੀ ਅਤੇ ਸਿਹਤਮੰਦ ਹੱਦ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca to środek, nie cel. Chronisz swoje wieczory i weekendy. To dojrzała, zdrowa granica."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کار وسیله ده، نه موخه. تاسو خپل ماښامونه او د اونۍ پای ساتئ. دا یوه پخه او روغه پوله ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho é um meio, não o objetivo. Você protege suas noites e fins de semana. Um limite maduro e saudável."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho é um meio, não o objetivo. Proteges as tuas noites e fins de semana. É um limite maduro e saudável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munca e un mijloc, nu scopul. Îți protejezi serile și weekendurile. E o limită matură și sănătoasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа — средство, а не цель. Ты бережёшь вечера и выходные. Это зрелая и здоровая граница."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akazi ni inzira, si yo ntego. Urinda imigoroba yawe n'impera z'icyumweru. Izo ni imbibi nzima kandi z'umuntu ukuze."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වැඩ කියන්නේ මාර්ගයක්, අරමුණ නෙවෙයි. ඔබ ඔබේ සවස් කාලය සහ සති අන්ත රැකගන්නවා. ඒක පරිණත, සෞඛ්‍ය සම්පන්න සීමාවක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práca je prostriedok, nie cieľ. Chrániš si večery a víkendy. To je zrelá, zdravá hranica."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delo je sredstvo, ne cilj. Varuješ svoje večere in vikende. To je zrela, zdrava meja."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basa inzira, kwete chinangwa. Unochengetedza manheru ako nemugovera nesvondo. Iwo muganhu une utano wemunhu akakura."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shaqadu waa dariiq, ma aha ujeeddada. Waxaad ilaalisaa fiidadkaaga iyo dhammaad-toddobaadyadaada. Taasi waa xad bislaaday oo caafimaad leh."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puna është mjet, jo qëllim. I mbron mbrëmjet dhe fundjavat. Ky është një kufi i pjekur dhe i shëndetshëm."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посао је средство, а не циљ. Чуваш вечери и викенде. То је зрела, здрава граница."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagawéan téh sarana, sanés tujuan. Anjeun ngajaga wengi sareng sabtu-minggu anjeun. Éta wates anu déwasa sareng séhat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbet är ett medel, inte målet. Du skyddar dina kvällar och helger. Det är en mogen och sund gräns."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazi ni njia, si lengo. Unalinda jioni na wikendi zako. Hiyo ni mipaka iliyokomaa na yenye afya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வேலை ஒரு வழி, அதுவே இலக்கு அல்ல. உங்கள் மாலைகளையும் வார இறுதிகளையும் காக்கிறீர்கள். அது முதிர்ச்சியான, ஆரோக்கியமான எல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పని ఒక సాధనం, లక్ష్యం కాదు. మీరు మీ సాయంత్రాలను, వీకెండ్‌లను కాపాడుకుంటారు. అది పరిపక్వమైన, ఆరోగ్యకరమైన హద్దు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кор восита аст, на мақсад. Ту шомҳо ва рӯзҳои истироҳатро ҳифз мекунӣ. Ин ҳудуди солим ва бокамол аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานคือเครื่องมือ ไม่ใช่เป้าหมาย คุณปกป้องเวลาเย็นและวันหยุดของตัวเอง นั่นคือขอบเขตที่เป็นผู้ใหญ่และดีต่อใจ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ስራሕ መሳርሒ እዩ እምበር ዕላማ ኣይኮነን። ምሸታትኩምን ቀዳመ-ሰንበትኩምን ትሕልዉ። እዚ በሲሉን ጥዑይን ደረት እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iş — maksat däl, serişde. Sen agşamlaryňy we dynç günleriňi goraýarsyň. Bu kämil we sagdyn araçäk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş bir araç, amaç değil. Akşamlarını ve hafta sonlarını koruyorsun. Bu olgun ve sağlıklı bir sınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота — засіб, а не мета. Ти бережеш вечори й вихідні. Це зріла, здорова межа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کام ایک ذریعہ ہے، مقصد نہیں۔ شامیں اور ویک اینڈ آپ کے لیے محفوظ رہتے ہیں۔ یہ ایک پختہ اور صحت مند حد ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ish — maqsad emas, vosita. Kechki vaqt va dam olish kunlaringizni asraysiz. Bu yetuk va sogʻlom chegara."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc là phương tiện, không phải đích đến. Bạn giữ gìn buổi tối và cuối tuần. Đó là ranh giới trưởng thành, lành mạnh."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umsebenzi yindlela, hayi injongo. Uyabakhusela ubusuku neempelaveki zakho. Lowo ngumda okhulileyo nosempilweni."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iṣẹ́ jẹ́ ọ̀nà, kì í ṣe òpin. Ẹ ń dáàbò bo ìrọ̀lẹ́ àti òpin ọ̀sẹ̀ yín. Ààlà tó dára, tó fi ìdàgbàdénú hàn nìyẹn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，不是目的。你會守住晚上和週末。這是成熟又健康的界線。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，不是目的。你会守护自己的晚上和周末。这是成熟又健康的边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，不是目的。你會守住晚上和週末，這是成熟又健康的界線。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umsebenzi uyindlela, hhayi inhloso. Uvikela ubusuku bakho nezimpelasonto. Lowo mngcele ovuthiwe futhi onempilo."
          }
        }
      }
    },
    "Work stress is inevitable — knowing how to support each other makes a real difference." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkstres is onvermydelik – as julle weet hoe om mekaar te ondersteun, maak dit ’n groot verskil."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሥራ ጭንቀት የማይቀር ነው — እርስ በርስ እንዴት መደጋገፍ እንዳለባችሁ ማወቅ እውነተኛ ለውጥ ያመጣል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغط العمل لا مفر منه، ومعرفة كيف يدعم كل منكما الآخر تصنع فرقًا حقيقيًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কামৰ চাপ আহিবই — ইজনে সিজনক কেনেকৈ সহায় কৰিব লাগে জানিলে সঁচাকৈয়ে বহুত পাৰ্থক্য হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş stresi qaçılmazdır — bir-birinizə necə dəstək olacağınızı bilmək böyük fərq yaradır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стрэсу на працы не пазбегнуць — але калі ведаеш, як падтрымаць адно аднаго, гэта сапраўды мяняе справу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стресът в работата е неизбежен – а да знаете как да се подкрепяте, наистина променя нещата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজের চাপ আসবেই — একে অপরকে কীভাবে সাপোর্ট করতে হয়, সেটা জানা থাকলে সত্যিই অনেক তফাত হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stres na poslu je neizbježan – kad znate kako da se podržite, to zaista mijenja stvari."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
