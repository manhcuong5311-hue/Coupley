        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ማንነትዎ በአካባቢዎ። የተቀየረ መጋዘን፣ ጀልባ፣ ከዋናው መስመር የራቀ ጎጆ — ቦታው ስለ እርስዎ የሆነ ነገር እንዲናገር ይፈልጋሉ።"
