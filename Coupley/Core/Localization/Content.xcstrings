        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ધીરજની પણ હદ હોય છે, અને મનમાં દબાવેલી વાતો મોટા ઝઘડામાં ફેરવાય છે. નાની, વહેલી વાતચીત સામાન્ય રીતે બધા માટે વધુ નરમ હોય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haƙuri yana da iyaka, kuma danne abubuwa na kai ga fashewa mafi girma. Ƙananan tattaunawa tun da wuri sun fi sauƙi ga kowa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לסבלנות יש גבול, ודברים שנאגרים מתפוצצים בגדול. שיחות קטנות ומוקדמות בדרך כלל עדינות יותר לכולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्र की भी हद होती है, और बातें मन में दबाते रहने से आगे चलकर बड़े झगड़े होते हैं। शुरुआत में ही छोटी-छोटी बातचीत अक्सर सबके लिए ज़्यादा आसान रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strpljenje ima granice, a potiskivanje vodi do većih eksplozija. Mali, rani razgovori obično su nježniji za sve."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasyans gen limit, e kenbe bagay nan kè ka mennen nan pi gwo eksplozyon. Ti konvèsasyon bonè yo souvan pi dous pou tout moun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A türelemnek is van határa, és az elfojtott dolgokból nagyobb robbanás lesz. A kicsi, korai beszélgetések általában mindenkinek kíméletesebbek."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Համբերությունն ունի սահմաններ, իսկ զսպված զգացմունքներն ավելի մեծ պայթյունների են հանգեցնում։ Փոքր ու վաղ զրույցները սովորաբար ավելի մեղմ են բոլորի համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesabaran ada batasnya, dan memendam perasaan bisa berujung ledakan yang lebih besar. Obrolan kecil sejak awal biasanya terasa lebih ringan bagi semua."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndidi nwere oke, ma ihe e kpuchiri n'obi na-eweta nnukwu ọgbaghara. Obere mkparịta ụka n'oge na-adịkarị nwayọọ maka onye ọ bụla."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þolinmæðin hefur sín takmörk og það sem er byrgt inni getur sprungið út stærra. Lítil samtöl snemma eru yfirleitt mildari fyrir alla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pazienza ha un limite, e tenersi tutto dentro porta a esplosioni più grandi. Le conversazioni piccole e tempestive di solito sono più gentili per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我慢には限界があり、ため込むほど爆発も大きくなりがちです。小さなうちに早めに話すほうが、ふたりともやさしくいられます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabar iku ana watese, lan ngempet terus marakake njeblug luwih gedhe. Omong-omongan cilik sing luwih awal biasane luwih alus kanggo kabeh."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოთმინებას საზღვარი აქვს, ჩაგუბებული გრძნობები კი დიდ აფეთქებებამდე მიდის. პატარა, დროული საუბრები, როგორც წესი, ყველასთვის უფრო რბილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шыдамның да шегі бар, ал іште жиналған нәрсе үлкен жарылысқа әкеледі. Ерте әрі шағын әңгімелер әдетте бәріне жеңілірек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការអត់ធ្មត់មានដែនកំណត់ ហើយការទប់ទុកក្នុងចិត្តនាំឲ្យផ្ទុះធំជាងមុន។ ការនិយាយគ្នាតូចៗតាំងពីដំបូង ជាធម្មតាស្រាលជាងសម្រាប់គ្រប់គ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತಾಳ್ಮೆಗೂ ಮಿತಿ ಇದೆ, ಮತ್ತು ಒಳಗೇ ಅದುಮಿಟ್ಟರೆ ದೊಡ್ಡ ಸ್ಫೋಟಗಳಾಗುತ್ತವೆ. ಬೇಗನೆ ಆಡುವ ಪುಟ್ಟ ಮಾತುಕತೆಗಳು ಎಲ್ಲರಿಗೂ ಹೆಚ್ಚು ಮೃದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인내에도 한계가 있고, 꾹 참다 보면 더 크게 터지기 쉬워요. 일찍, 가볍게 나누는 대화가 서로에게 훨씬 부드러워요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebir jî xwedî sînor e, û tiştên di dil de mayî dibin teqînên mezintir. Sohbetên biçûk û zû bi gelemperî ji bo her kesî nermtir in."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чыдамдын да чеги бар, ичке катылган нерсе кийин чоң жарылууга алып келет. Эрте, кичинекей сүйлөшүүлөр адатта баарына жумшагыраак тиет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedold huet hir Grenzen, an alles eraschlécken féiert zu méi groussen Explosiounen. Kleng, fréi Gespréicher si meeschtens fir jiddereen méi sanft."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມອົດທົນມີຂີດຈຳກັດ ແລະ ການເກັບກົດໄວ້ມັກນຳໄປສູ່ການລະເບີດທີ່ໃຫຍ່ກວ່າ ການລົມກັນແຕ່ເນີ່ນໆໃນເລື່ອງນ້ອຍໆມັກອ່ອນໂຍນກວ່າສຳລັບທຸກຄົນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantrybė turi ribas, o užgniaužti dalykai virsta didesniais sprogimais. Maži, ankstyvi pokalbiai paprastai švelnesni visiems."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacietībai ir robežas, un aprītas lietas beigās uzsprāgst vēl lielākas. Nelielas, laicīgas sarunas parasti ir saudzīgākas visiem."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manana fetrany ny faharetana, ary ny fitanana ao am-po dia miteraka fipoahana lehibe kokoa. Ny resaka kely sy aloha dia malefaka kokoa ho an'ny rehetra matetika."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He rohe tō te manawanui, ā, ko te pupuri i ngā mea ka puta he pakarutanga nui ake. Ko ngā kōrero iti, moata hoki, he ngāwari ake mō te katoa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трпението има граници, а насобраното води кон поголеми експлозии. Малите, навремени разговори обично се понежни за сите."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്ഷമയ്ക്ക് പരിധിയുണ്ട്, ഉള്ളിലൊതുക്കുന്നത് വലിയ പൊട്ടിത്തെറികളിലേക്ക് നയിക്കും. നേരത്തെയുള്ള ചെറിയ സംസാരങ്ങളാണ് മിക്കപ്പോഴും എല്ലാവർക്കും കൂടുതൽ മൃദുവായത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэвчээр хязгаартай, дотроо дарж байх нь илүү том дэлбэрэлтэд хүргэдэг. Эрт, жижиг яриа хүн бүрт илүү зөөлөн байдаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संयमालाही मर्यादा असतात, आणि गोष्टी मनात दाबून ठेवल्या की नंतर मोठा स्फोट होतो. लवकर केलेले छोटे संवाद सगळ्यांसाठीच सौम्य असतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesabaran ada hadnya, dan memendam perasaan boleh membawa kepada letusan yang lebih besar. Perbualan kecil dari awal biasanya lebih lembut untuk semua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-paċenzja għandha l-limiti tagħha, u ż-żamma tal-affarijiet ġewwa twassal għal splużjonijiet akbar. Konversazzjonijiet żgħar u kmieni normalment ikunu aktar ħelwin għal kulħadd."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သည်းခံမှုမှာ အကန့်အသတ်ရှိတယ်၊ မျိုသိပ်ထားတာက ပိုကြီးတဲ့ ပေါက်ကွဲမှုတွေ ဖြစ်စေတယ်။ စောစောစီးစီး ပြောတဲ့ စကားဝိုင်းလေးတွေက လူတိုင်းအတွက် ပိုနူးညံ့ပါတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighet har sine grenser, og det du holder inne, kan eksplodere senere. Små, tidlige samtaler er som regel skånsommere for alle."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धैर्यको पनि सीमा हुन्छ, र कुरा मनमै थुपार्दा पछि ठूलो विस्फोट हुन्छ। सुरुमै गरिएका साना कुराकानी सबैका लागि प्रायः नरम हुन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld heeft grenzen, en opkroppen leidt tot grotere uitbarstingen. Kleine gesprekken in een vroeg stadium zijn meestal zachter voor iedereen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuleza mtima kuli ndi malire, ndipo kusunga zinthu mumtima kumabweretsa kuphulika kwakukulu. Kukambirana msanga zinthu zikadali zing'ono nthawi zambiri kumakhala kofatsa kwa aliyense."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsi daangaa qaba, waan garaa keessatti kuusuun dhoh'insa guddaatti geessa. Haasaawwan xixiqqoo fi dursanii godhaman yeroo baay'ee nama hundaaf laafaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଧୈର୍ଯ୍ୟର ବି ସୀମା ଅଛି, ଆଉ ମନରେ ଚାପି ରଖିଲେ ବଡ଼ ବିସ୍ଫୋରଣ ହୁଏ। ଛୋଟ, ଆଗୁଆ କଥାବାର୍ତ୍ତା ସାଧାରଣତଃ ସମସ୍ତଙ୍କ ପାଇଁ ନରମ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਬਰ ਦੀ ਵੀ ਹੱਦ ਹੁੰਦੀ ਹੈ, ਅਤੇ ਗੱਲਾਂ ਮਨ ਵਿੱਚ ਦੱਬੀ ਰੱਖਣ ਨਾਲ ਵੱਡੇ ਝਗੜੇ ਹੁੰਦੇ ਹਨ। ਛੋਟੀਆਂ, ਵੇਲੇ ਸਿਰ ਕੀਤੀਆਂ ਗੱਲਾਂ ਅਕਸਰ ਸਭ ਲਈ ਸੌਖੀਆਂ ਹੁੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwość ma granice, a tłumienie emocji kończy się większymi wybuchami. Krótkie rozmowy na wczesnym etapie są zwykle łagodniejsze dla wszystkich."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صبر حد لري، او په زړه کې ساتل یې لویو چاودنو ته رسېږي. وړې او وختي خبرې معمولاً د ټولو لپاره نرمې وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paciência tem limite, e guardar tudo leva a explosões maiores. Conversas pequenas e logo no começo costumam ser mais leves para todo mundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paciência tem limites, e guardar tudo leva a explosões maiores. Conversas pequenas e cedo costumam ser mais suaves para todos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răbdarea are limite, iar lucrurile ținute în tine duc la explozii mai mari. Discuțiile mici și din timp sunt de obicei mai blânde pentru toată lumea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У терпения есть предел, а сдерживаемое потом выливается в большие ссоры. Короткие разговоры на раннем этапе обычно бережнее для всех."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwihangana kugira aho kugarukira, kandi kubika ibintu ku mutima bitera guturika gukomeye. Ibiganiro bito kandi bikozwe kare akenshi byorohera buri wese."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉවසීමටත් සීමාවක් තියෙනවා, දේවල් හිතේ හිරකරගෙන ඉන්න එක ලොකු පුපුරා යාම්වලට මඟ පාදනවා. කලින්ම කරන පොඩි කතාබහ සාමාන්‍යයෙන් හැමෝටම වඩා මෘදුයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trpezlivosť má hranice a dusenie vecí v sebe vedie k väčším výbuchom. Malé, včasné rozhovory sú zvyčajne šetrnejšie pre všetkých."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrpežljivost ima meje in zadrževanje vodi v večje izbruhe. Majhni, zgodnji pogovori so običajno nežnejši za vse."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwoyo murefu une miganhu, uye kuvharira zvinhu mukati kunozoputika zvakanyanya. Hurukuro diki dzekutanga kazhinji dzinova nyoro kune wese."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dulqaadku xad buu leeyahay, wax la qariyana waxay keenaan qaraxyo waaweyn. Wada-hadallo yaryar oo hore ayaa badanaa u debecsan qof walba."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durimi ka kufij, dhe gjërat e mbajtura brenda çojnë në shpërthime më të mëdha. Bisedat e vogla e të hershme zakonisht janë më të buta për të gjithë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стрпљење има границе, а гомилање води у веће свађе. Мали, рани разговори су обично нежнији за све."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasabaran aya watesna, sareng nyimpen-nyimpen rasa tiasa ngabeledug langkung ageung. Obrolan leutik ti awal biasana langkung lemes pikeun sadayana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålamod har sina gränser, och att hålla saker inom sig leder till större utbrott. Små samtal i tid är oftast mjukare för alla."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subira ina mipaka, na kuficha mambo moyoni huleta milipuko mikubwa. Mazungumzo madogo ya mapema kwa kawaida ni ya upole zaidi kwa kila mtu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பொறுமைக்கும் எல்லை உண்டு; மனதுக்குள் அடக்கி வைப்பது பெரிய வெடிப்புகளுக்கு வழிவகுக்கும். ஆரம்பத்திலேயே நடக்கும் சிறிய உரையாடல்கள் எல்லோருக்கும் மென்மையானவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఓపికకూ హద్దులు ఉంటాయి, లోపల దాచుకుంటే పెద్ద గొడవలు అవుతాయి. ముందుగానే చిన్నగా మాట్లాడుకోవడం అందరికీ మృదువుగా ఉంటుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сабр ҳад дорад ва дар дил нигоҳ доштан ба таркишҳои калонтар мебарад. Сӯҳбатҳои хурду барвақт одатан барои ҳама нармтаранд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความอดทนมีขีดจำกัด และการเก็บกดมักนำไปสู่การระเบิดที่ใหญ่กว่าเดิม การคุยกันเร็วๆ ตั้งแต่เรื่องยังเล็กมักนุ่มนวลกว่าสำหรับทุกคน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትዕግስቲ ደረት ኣለዋ፣ ነገራት ምዕፋን ድማ ናብ ዝዓበየ ምትኳስ የብጽሕ። ንኣሽቱን ኣቐዲሞም ዝግበሩን ዕላላት ንኹሉ ዝለዝቡ እዮም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabryň hem çägi bar, içiňde saklamak bolsa has uly partlamalara getirýär. Kiçi, wagtynda edilen söhbetler köplenç hemmeler üçin ýumşak geçýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabrın da bir sınırı var ve içine atmak daha büyük patlamalara yol açıyor. Küçük ve erken konuşmalar genelde herkes için daha yumuşak geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпіння має межі, а стримане всередині згодом вибухає сильніше. Невеликі розмови на ранньому етапі зазвичай м’якші для всіх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صبر کی بھی حد ہوتی ہے، اور باتیں دل میں دبانے سے بڑے جھگڑے ہوتے ہیں۔ چھوٹی، بروقت بات چیت عموماً سب کے لیے نرم ثابت ہوتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabrning ham chegarasi bor, ichga yutilgan gaplar esa kattaroq janjalga aylanadi. Erta va qisqa suhbatlar odatda hamma uchun yumshoqroq kechadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiên nhẫn cũng có giới hạn, và dồn nén dễ dẫn đến những lần bùng nổ lớn hơn. Nói sớm từ khi chuyện còn nhỏ thường nhẹ nhàng hơn cho cả hai."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umonde unemida, kwaye ukufihla izinto kukhokelela ekuqhumeni okukhulu. Iincoko ezincinci zakwangoko zihlala zithambile kuye wonke umntu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sùúrù ní ààlà, fífi nǹkan pamọ́ sínú sì máa ń yọrí sí ìbínú ńlá. Ìjíròrò kékeré ní kùtùkùtù sábà máa ń rọ̀ fún gbogbo ènìyàn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐有限度，把事情憋著只會換來更大的爆發。及早、輕輕地談，通常對大家都溫和得多。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耐心是有限的，憋着容易酿成更大的爆发。早一点、轻一点地聊，通常对谁都更温和。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
