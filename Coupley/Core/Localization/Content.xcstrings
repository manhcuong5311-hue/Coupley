            "value" : "Il preciso batte il generico. «Sei speciale» non lascia il segno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありきたりより具体的に。「すごいね」だけでは響きません。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartamtu > umum. “Panjenengan nggumunake” krasa ampang."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კონკრეტული > ზოგადი. „საოცარი ხარ“ უფერულად ჟღერს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нақтысы жалпыдан жақсы. «Сен кереметсің» онша әсер етпейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជាក់លាក់ > ទូទៅ។ “អ្នកអស្ចារ្យណាស់” ស្ដាប់ទៅស្រពោន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
