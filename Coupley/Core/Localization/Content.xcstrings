        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпочинок без провини. Мабуть, протягом тижня тобі його бракує, і неділя — час надолужити це для себе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghỉ ngơi không áy náy. Có lẽ bạn không được nghỉ đủ trong tuần, và Chủ nhật là lúc bạn bù lại cho chính mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毫无负罪感地休息。你平时多半休息不够，周日正好把自己补回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息不必有罪惡感。你平日大概休息得不夠，星期天就是你把自己補回來的時候。"
