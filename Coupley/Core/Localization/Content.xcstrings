        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muvozanat. Siz nazoratchi boʻlishni istamaysiz, lekin kimdir faqat yarim yoningizda boʻlsa, darhol sezasiz."
