        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengarkan sebagai teman, bukan sebagai pemberi solusi. Ulangi apa yang dia rasakan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gee ntị dị ka enyi, ọ bụghị onye na-arụzi ihe. Kwughachi ihe ọ na-enwe n'obi."
