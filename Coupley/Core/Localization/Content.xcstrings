    "Side-by-side talks are easier than face-to-face ones." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحديث جنبًا إلى جنب أسهل من الحديث وجهًا لوجه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozhovory bok po boku jdou snáz než tváří v tvář."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er lettere at tale side om side end ansigt til ansigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebeneinander redet es sich leichter als gegenüber."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κουβέντες δίπλα-δίπλα είναι πιο εύκολες από τις κουβέντες πρόσωπο με πρόσωπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablar lado a lado es más fácil que cara a cara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinnakkain on helpompi puhua kuin kasvokkain."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas madali ang usapang magkatabi kaysa magkaharap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On se parle plus facilement côte à côte que face à face."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קל יותר לדבר זה לצד זה מאשר פנים מול פנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ-साथ चलते हुए बात करना आमने-सामने बैठकर बात करने से आसान है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egymás mellett könnyebb beszélgetni, mint szemtől szemben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngobrol berdampingan lebih mudah daripada berhadapan."
          }
        },
        "it" : {
          "stringUnit" : {
