    "Tackling the uncomfortable. This is growth at its most valuable — and often the hardest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواجهة ما يزعج. هذا هو النمو في أثمن صوره، وغالبًا أصعبها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouštíš se do toho, co je ti nepříjemné. To je nejcennější druh růstu – a často ten nejtěžší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tager fat på det ubehagelige. Det er den mest værdifulde form for vækst – og ofte den sværeste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gehst das Unbequeme an. Das ist Wachstum in seiner wertvollsten Form – und oft der schwerste Weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιμετωπίζεις το άβολο. Αυτή είναι η πιο πολύτιμη εξέλιξη — και συχνά η πιο δύσκολη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrontar lo incómodo. Es el crecimiento más valioso — y muchas veces, el más difícil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epämukavuuden kohtaamista. Tämä on kasvua arvokkaimmillaan – ja usein vaikeimmillaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinaharap ang hindi komportable. Ito ang pinakamahalagang uri ng paglago — at madalas, ang pinakamahirap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affronter l'inconfort. C'est la forme de progrès la plus précieuse — et souvent la plus dure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתמודד עם הלא נוח. זו צמיחה במיטבה — ולרוב גם הקשה ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असहज चीज़ों का सामना। ख़ुद को निखारने का यही सबसे क़ीमती रूप है — और अक्सर सबसे मुश्किल भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szembenézel a kényelmetlennel. Ez a legértékesebb fejlődés – és gyakran a legnehezebb is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghadapi hal yang nggak nyaman. Inilah pertumbuhan yang paling berharga — dan sering kali yang paling sulit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affrontare il disagio. È la crescita più preziosa — e spesso la più difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居心地の悪さに向き合う人です。これこそいちばん価値のある成長で、たいていいちばん難しいものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불편한 것에 맞서요. 가장 값지면서도 가장 어려운 성장이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdepan dengan yang tidak selesa. Inilah pertumbuhan yang paling bernilai — dan selalunya paling sukar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar tak i det ubehagelige. Dette er vekst når den er mest verdifull – og ofte vanskeligst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ongemak aangaan. Dit is groei op z’n waardevolst – en vaak op z’n moeilijkst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmierzenie się z tym, co niewygodne. To najcenniejszy rodzaj rozwoju – i często najtrudniejszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encarar o desconfortável. É o crescimento mais valioso — e muitas vezes o mais difícil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să înfrunți ce e incomod. E creșterea cea mai valoroasă — și adesea cea mai grea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг навстречу дискомфорту. Это самый ценный рост — и часто самый трудный."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta sig an det obekväma. Det är utveckling när den är som mest värdefull – och ofta som svårast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้าเผชิญสิ่งที่ไม่สบายใจ นี่คือการเติบโตที่มีค่าที่สุด และมักยากที่สุดด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni zorlayanla yüzleşmek. Gelişimin en değerli hâli bu ve çoğu zaman en zoru."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крок назустріч дискомфорту. Це найцінніший різновид зростання — і часто найважчий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đối mặt với điều khó chịu. Đây là kiểu trưởng thành quý giá nhất — và thường cũng khó nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走出舒适区。这是最有价值的成长，往往也是最难的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勇敢面對不舒服的事。這是最有價值、也常常最難的成長。"
          }
        }
      }
    },
    "Take one small thing off their plate today, silently." : {
      "extractionState" : "manual",
      "localizations" : {
