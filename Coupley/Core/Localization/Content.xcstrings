        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छिटोछरितो। हलुका हुन तपाईंलाई कुनै रीत चाहिँदैन — वा प्रायः यति थाकेको हुनुहुन्छ कि चाहिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficiënt. Je hebt geen rituelen nodig om tot rust te komen – of je bent meestal moe genoeg om ze niet nodig te hebben."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwachangu. Simufunika miyambo kuti mupumule — kapena nthawi zambiri mumakhala otopa kwambiri moti simuifuna."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu'a qabeessa. Boqochuuf sirni si hin barbaachisu — ykn yeroo baay'ee dadhabbiin ga'aan si qaba."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦକ୍ଷ। ଆରାମ ପାଇଁ ଆପଣଙ୍କୁ ଅଭ୍ୟାସ ଦରକାର ନାହିଁ — ବା ସାଧାରଣତଃ ଆପଣ ଏତେ କ୍ଲାନ୍ତ ଥାଆନ୍ତି ଯେ ଦରକାର ପଡ଼େ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿੱਧਾ ਕੰਮ। ਹਲਕਾ ਹੋਣ ਲਈ ਤੁਹਾਨੂੰ ਰਸਮਾਂ ਦੀ ਲੋੜ ਨਹੀਂ — ਜਾਂ ਤੁਸੀਂ ਅਕਸਰ ਇੰਨੇ ਥੱਕੇ ਹੁੰਦੇ ਹੋ ਕਿ ਲੋੜ ਹੀ ਨਹੀਂ ਪੈਂਦੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektywnie. Nie potrzebujesz rytuałów, by się wyciszyć – albo zwykle masz tak dość, że po prostu padasz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اغېزمن. تاسو د آرامېدو لپاره عادتونو ته اړتیا نه لرئ — یا معمولاً دومره ستړیا لرئ چې اړتیا ورته نه وي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiência. Você não precisa de rituais para desacelerar — ou normalmente o cansaço já resolve."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiência. Não precisas de rituais para descomprimir — ou o cansaço costuma ser tanto que nem precisas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiență. Nu ai nevoie de ritualuri ca să te relaxezi — sau, de obicei, oboseala e atât de mare încât nici nu-ți trebuie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффективно. Тебе не нужны ритуалы, чтобы расслабиться, — или к вечеру ты обычно слишком устаёшь, чтобы в них нуждаться."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntutinda. Ntukeneye imigenzo ngo uruhuke — cyangwa akenshi uba unaniwe ku buryo utayikeneye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කාර්යක්ෂමයි. සැහැල්ලු වෙන්න ඔබට පුරුදු ඕනේ නැහැ — නැත්නම් සාමාන්‍යයෙන් ඒවා ඕනේ නැති තරමටම ඔබ වෙහෙසට පත්වෙලා ඉන්නවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektívne. Na upokojenie nepotrebuješ rituály – alebo ťa únava zvyčajne zmôže tak, že ich netreba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učinkovito. Za sprostitev ne potrebuješ ritualov – ali pa te utrujenost običajno kar sama odnese."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unokurumidza. Haudi tsika kuti uzorore — kana kuti kazhinji unenge waneta zvekuti hauzvidi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hufan. Uma baahnid caadooyin aad ku degto — ama badanaa waad daallan tahay oo uma baahnid."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efikasitet. Nuk të duhen rituale për t’u çlodhur – ose zakonisht lodhja të mund aq sa s’të duhen."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ефикасно. Не требају ти ритуали да се опустиш — или те умор обично савлада пре него што би ти затребали."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éfisién. Anjeun teu peryogi kabiasaan pikeun nenangkeun diri — atanapi biasana anjeun parantos capé teuing dugi ka teu peryogi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektivt. Du behöver inga ritualer för att varva ner – eller så är du oftast så trött att du inte behöver dem."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufanisi. Huhitaji desturi ili kupumzika — au kwa kawaida umechoka kiasi kwamba huzihitaji."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திறமையானவர். மனதை இலகுவாக்க உங்களுக்குச் சடங்குகள் தேவையில்லை — அல்லது அவை தேவைப்படாத அளவுக்கு நீங்கள் வழக்கமாகக் களைத்திருப்பீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమర్థవంతం. సేదతీరడానికి మీకు అలవాట్లు అవసరం లేదు — లేదా సాధారణంగా అవి అక్కర్లేనంత అలసిపోతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самаранок. Барои ором шудан ба ту анъана лозим нест — ё одатан он қадар хаста мешавӣ, ки лозимат намешавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีประสิทธิภาพ คุณไม่ต้องมีพิธีกรรมเพื่อผ่อนคลาย หรือไม่ก็เหนื่อยจนไม่ต้องใช้มันอยู่แล้ว"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀልጣፋት። ክትዛሓሉ ልምድታት ኣየድልየኩምን — ወይ ድማ ብዙሕ ግዜ ኣየድልየኩምን ክሳብ ዝብል ደኺምኩም ኢኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netijeli. Köşeşmek üçin saňa däp gerek däl — ýa-da köplenç oňa mätäç bolmaz ýaly ýadaw bolýansyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratiksin. Gevşemek için ritüellere ihtiyacın yok ya da genelde onlara gerek kalmayacak kadar yorgun oluyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ефективно. Тобі не потрібні ритуали, щоб розслабитися, — або зазвичай ти настільки втомлюєшся, що вони й не потрібні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارآمد۔ سکون کے لیے آپ کو کسی رسم کی ضرورت نہیں — یا عموماً تھکن اتنی ہوتی ہے کہ ضرورت ہی نہیں پڑتی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samarali. Boʻshashish uchun sizga marosim kerak emas — yoki odatda shunchalik charchaysizki, ularga hojat qolmaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gọn lẹ. Bạn không cần nghi thức để thả lỏng — hoặc thường đã đủ mệt để chẳng cần đến."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukhawuleza. Awudingi masiko ukuze uzole — okanye uhlala udiniwe ngokwaneleyo ukuba ungawadingi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó yára. Ẹ kò nílò àṣà láti sinmi — tàbí ó máa ń rẹ̀ yín tó láti má nílò rẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有效率。你不需要儀式來放鬆，又或者你通常累得根本不需要。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高效。你不需要仪式来放松——或者通常已经累到不需要了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很有效率。你不需要儀式來放鬆，或是你通常累到根本不需要。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usebenza kahle. Awudingi imikhuba ukuze uphumule — noma uvame ukukhathala ngokwanele ukuthi ungayidingi."
          }
        }
      }
    },
    "Effort should go both ways. When it feels one-sided, you start questioning where you stand." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moeite moet albei kante toe gaan. As dit eensydig voel, begin jy wonder waar jy staan."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጥረት ከሁለቱም ወገን መሆን አለበት። በአንድ ወገን ብቻ የሆነ ሲመስል የት እንደቆሙ መጠራጠር ይጀምራሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجهد يجب أن يكون متبادلًا. حين يبدو من طرف واحد، تبدؤون بالتساؤل عن مكانتكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ৰচেষ্টা দুয়োফালৰ পৰা হ'ব লাগে। একপক্ষীয় যেন লাগিলে আপুনি নিজৰ স্থান ক'ত তাক লৈ প্ৰশ্ন কৰিবলৈ ধৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səy qarşılıqlı olmalıdır. Birtərəfli hiss olunanda harada dayandığını sorğulamağa başlayırsan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намаганні павінны быць узаемнымі. Калі ўсё ў адзін бок, ты пачынаеш сумнявацца, дзе ты насамрэч."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усилието трябва да е взаимно. Когато е едностранно, започваш да се питаш какво място заемаш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেষ্টা দুদিক থেকেই আসা উচিত। একতরফা মনে হলে তুমি ভাবতে শুরু করো, তোমার জায়গাটা আসলে কোথায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trud treba ići u oba smjera. Kad je jednostran, počneš se pitati gdje stojiš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esforç hauria d'anar en les dues direccions. Quan sembla que va només en un sentit, comences a dubtar d'on et trobes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snaha by měla jít oběma směry. Když je jednostranná, začneš si klást otázku, kde vlastně stojíš."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dylai ymdrech fynd y ddwy ffordd. Pan fydd yn teimlo'n unochrog, rwyt ti'n dechrau amau ble rwyt ti'n sefyll."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsatsen skal gå begge veje. Når den føles ensidig, begynder du at tvivle på, hvor du står."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einsatz sollte von beiden kommen. Wenn es sich einseitig anfühlt, fragst du dich, wo du eigentlich stehst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσπάθεια πρέπει να είναι αμοιβαία. Όταν μοιάζει μονόπλευρη, αρχίζεις να αναρωτιέσαι τι θέση έχεις στη σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo debería ir en las dos direcciones. Cuando parece que va en una sola, empiezas a preguntarte qué lugar ocupas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pingutus peaks käima mõlemat pidi. Kui see tundub ühepoolne, hakkad mõtlema, kus sa õieti seisad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahaleginak bi norabideetan joan behar du. Alde bakarrekoa iruditzen zaizunean, non zauden zalantzan jartzen hasten zara."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاش باید دوطرفه باشد. وقتی یک‌طرفه به نظر برسد، شروع می‌کنی به شک کردن که جایگاهت کجاست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaivannäön pitäisi kulkea molempiin suuntiin. Kun se tuntuu yksipuoliselta, alat miettiä, missä asemassa olet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat galing sa dalawang panig ang effort. Kapag parang isang panig lang, napapaisip ka kung ano ba talaga ang lugar mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les efforts doivent venir des deux côtés. Quand ça semble à sens unique, tu commences à te demander quelle place tu occupes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba chóir go rachadh an iarracht sa dá threo. Nuair a bhraitheann sé leataobhach, tosaíonn tú ag ceistiú cá seasann tú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esforzo debe ir nas dúas direccións. Cando parece que vai nunha soa, comezas a preguntarte onde estás."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્રયાસ બંને તરફથી થવો જોઈએ. એકતરફી લાગે ત્યારે તમે વિચારવા લાગો છો કે તમારું સ્થાન ક્યાં છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ƙoƙari ya kamata ya kasance daga ɓangarorin biyu. Idan ya zama na ɓangare ɗaya, kukan fara tambayar matsayinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאמץ צריך לבוא משני הכיוונים. כשזה מרגיש חד־צדדי, מתחילות לעלות אצלך שאלות לגבי המקום שלך בקשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोशिश दोनों तरफ़ से होनी चाहिए। जब यह एकतरफ़ा लगे, तो आप सोचने लगते हैं कि रिश्ते में आप कहाँ हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trud bi trebao ići u oba smjera. Kad se čini jednostranim, počneš se pitati gdje stojiš."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efò dwe sòti nan toude bò. Lè sa sanble se yon sèl bò, ou kòmanse mande tèt ou ki kote ou kanpe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az erőfeszítésnek kölcsönösnek kell lennie. Ha egyoldalúnak érzed, elkezded kérdezni magadtól, hol is állsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ջանքերը պետք է փոխադարձ լինեն։ Երբ դա միակողմանի է թվում, սկսում ես կասկածել, թե որտեղ ես կանգնած։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha harus datang dari dua arah. Saat terasa sepihak, kamu mulai mempertanyakan posisimu."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgbalị kwesịrị isi n'akụkụ abụọ. Mgbe ọ dị ka ọ bụ naanị otu akụkụ, ị na-amalite ịjụ onwe gị ebe ị guzo."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrirhöfnin á að vera gagnkvæm. Þegar hún virðist einhliða ferðu að efast um hvar þú stendur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impegno deve venire da entrambe le parti. Quando sembra a senso unico, cominci a chiederti a che punto siete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力はお互いさまであってほしいタイプです。一方通行だと感じると、自分の立ち位置がわからなくなります。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha kudune saka loro-lorone. Yen rasane mung sepihak, panjenengan wiwit takon-takon ana ing ngendi panggonan panjenengan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ძალისხმევა ორმხრივი უნდა იყოს. როცა ცალმხრივად გეჩვენება, იწყებ ფიქრს, სად დგახარ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Талпыныс екі жақты болуы керек. Бір жақты сияқты көрінсе, қай жерде тұрғаныңа күмәндана бастайсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការខិតខំគួរតែមកពីភាគីទាំងពីរ។ ពេលវាហាក់ដូចជាម្ខាងៗ អ្នកចាប់ផ្ដើមសង្ស័យថាខ្លួនឯងនៅត្រង់ណា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಯತ್ನ ಎರಡೂ ಕಡೆಯಿಂದ ಇರಬೇಕು. ಅದು ಒಂದೇ ಕಡೆಯದು ಅನಿಸಿದಾಗ, ನಿಮ್ಮ ಸ್ಥಾನ ಏನು ಎಂದು ನೀವು ಪ್ರಶ್ನಿಸತೊಡಗುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노력은 양쪽에서 해야 해요. 한쪽으로 기운 느낌이 들면 내가 연인에게 어떤 존재인지 의문이 들기 시작하죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewl divê ji herdu aliyan be. Dema ew yekalî xuya dike, tu dest pê dikî bipirsî ka tu li ku yî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аракет эки тараптан болушу керек. Бир тараптуу сезилгенде, кайда турганыңа шек санай баштайсың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méi sollt vu béide Säite kommen. Wann et sech eesäiteg ufillt, fänks du un ze zweiwelen, wou s du stees."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມພະຍາຍາມຄວນມາຈາກທັງສອງຝ່າຍ ເມື່ອມັນຮູ້ສຶກຄືມີແຕ່ຝ່າຍດຽວ ເຈົ້າເລີ່ມສົງໄສວ່າຕົວເອງຢູ່ຈຸດໃດ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastangos turi būti abipusės. Kai jos atrodo vienpusės, pradedi abejoti, kur esi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pūlēm jābūt abpusējām. Kad tas šķiet vienpusēji, tu sāc šaubīties, kur esi."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokony ho avy amin'ny andaniny roa ny ezaka. Rehefa tsapa ho avy amin'ny andaniny iray ihany, dia manomboka manontany tena ianao hoe aiza ianao no misy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me rere te kaha ki ngā taha e rua. Ina rongo he taha kotahi anake, ka tīmata koe ki te pātai kei hea koe e tū ana."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трудот треба да оди во двете насоки. Кога е еднострано, почнуваш да се прашуваш каде стоиш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിശ്രമം ഇരുവശത്തുനിന്നും വേണം. അത് ഒരു ഭാഗത്തുനിന്ന് മാത്രമാണെന്ന് തോന്നുമ്പോൾ, നിങ്ങളുടെ സ്ഥാനം എവിടെയെന്ന് നിങ്ങൾ സംശയിച്ചുതുടങ്ങും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хичээл зүтгэл хоёр талаас байх ёстой. Нэг талын санагдахад чи хаана байгаагаа эргэлзэж эхэлдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रयत्न दोन्ही बाजूंनी व्हायला हवेत. ते एकतर्फी वाटू लागले की तुम्ही नात्यात नेमके कुठे आहात, असा प्रश्न पडू लागतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha sepatutnya datang dari kedua-dua pihak. Apabila ia terasa berat sebelah, anda mula tertanya-tanya di mana kedudukan anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-isforz għandu jkun miż-żewġ naħat. Meta jidher minn naħa waħda, tibda tistaqsi fejn tinsab."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကြိုးစားမှုက နှစ်ဖက်စလုံးက လာသင့်တယ်။ တစ်ဖက်သတ်လို ခံစားရရင် ကိုယ် ဘယ်နေရာမှာ ရှိနေလဲလို့ သံသယဝင်လာတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innsats skal gå begge veier. Når det føles ensidig, begynner du å lure på hvor du står."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेहनत दुवैतर्फबाट हुनुपर्छ। एकतर्फी लाग्न थालेपछि तपाईं आफ्नो ठाउँ कहाँ छ भनेर प्रश्न गर्न थाल्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moeite moet van twee kanten komen. Als het eenzijdig voelt, ga je twijfelen waar je staat."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khama liyenera kuchokera mbali zonse ziwiri. Likakhala la mbali imodzi, mumayamba kudzifunsa kuti muli pati."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carraaqqiin gama lamaanuu irraa ta'uu qaba. Yeroo gama tokkoon qofa ta'e sitti dhaga'amu, iddoo ati jirtu shakkuu eegalta."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚେଷ୍ଟା ଦୁଇ ପଟରୁ ହେବା ଉଚିତ। ଏକପାଖିଆ ଲାଗିଲେ, ଆପଣ ନିଜ ସ୍ଥାନ ନେଇ ସନ୍ଦେହ କରିବାକୁ ଲାଗନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਸ਼ਿਸ਼ ਦੋਵਾਂ ਪਾਸਿਆਂ ਤੋਂ ਹੋਣੀ ਚਾਹੀਦੀ ਹੈ। ਜਦੋਂ ਇਹ ਇੱਕ-ਪਾਸੜ ਲੱਗਦੀ ਹੈ, ਤੁਸੀਂ ਸੋਚਣ ਲੱਗਦੇ ਹੋ ਕਿ ਤੁਸੀਂ ਕਿੱਥੇ ਖੜ੍ਹੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starania powinny być obustronne. Gdy tak nie jest, zaczynasz się zastanawiać, na czym stoisz."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هڅه باید له دواړو خواوو وي. کله چې یو اړخیزه ښکاري، له ځانه پوښتنه کوئ چې ستاسو ځای چېرته دی."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esforço tem que vir dos dois lados. Quando parece unilateral, você começa a questionar seu lugar na relação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esforço deve vir dos dois lados. Quando parece unilateral, começas a questionar em que pé estás."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efortul ar trebui să vină din ambele părți. Când pare unilateral, începi să te întrebi ce loc ai în relație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усилия должны быть взаимными. Когда всё в одни ворота, ты начинаешь сомневаться, какое место занимаешь в этих отношениях."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umuhate ukwiye kuva ku mpande zombi. Iyo wumva ari uruhande rumwe, utangira kwibaza aho uhagaze."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "උත්සාහය දෙපැත්තෙන්ම එන්න ඕනේ. ඒක එක පැත්තකට විතරක් බර වගේ දැනෙනකොට, ඔබ කොහෙද ඉන්නේ කියලා ඔබ ප්‍රශ්න කරන්න පටන් ගන්නවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snaha by mala ísť oboma smermi. Keď to pôsobí jednostranne, začneš pochybovať, kde vlastne stojíš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trud mora teči v obe smeri. Ko se zdi enostranski, se začneš spraševati, kje sploh stojiš."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushanda nesimba kunofanira kubva kumativi ese. Kana zvichinzwika sezvine divi rimwe chete, unotanga kuzvibvunza kuti umire papi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadaalku waa inuu labada dhinac ka yimaado. Marka uu dhinac keliya noqdo, waxaad bilaabaysaa inaad is weydiiso halka aad taagan tahay."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përpjekja duhet të jetë nga të dyja anët. Kur duket e njëanshme, fillon të pyesësh veten ku qëndron."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Труд треба да иде у оба смера. Кад делује једнострано, почињеш да се питаш где ти је место."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha kedahna ti dua arah. Upami karaos ngan ti hiji pihak, anjeun mimiti naroskeun dimana kalungguhan anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansträngningen ska gå åt båda hållen. När det känns ensidigt börjar du undra var du står."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhudi zinapaswa kutoka pande zote mbili. Zinapoonekana za upande mmoja, unaanza kujiuliza uko wapi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முயற்சி இருபக்கமும் இருக்க வேண்டும். அது ஒருபக்கமாகத் தோன்றும்போது, உறவில் உங்கள் இடம் என்ன என்று கேள்வி எழத் தொடங்குகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రయత్నం రెండు వైపుల నుంచీ ఉండాలి. ఒకవైపే అనిపిస్తే, మీ స్థానం ఎక్కడ అని ప్రశ్నించుకోవడం మొదలుపెడతారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заҳмат бояд аз ҳар ду тараф бошад. Вақте он якҷониба менамояд, ту ба шубҳа меафтӣ, ки дар куҷо истодаӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความพยายามควรมาจากทั้งสองฝ่าย เมื่อรู้สึกว่ามีแต่ฝ่ายเดียว คุณจะเริ่มสงสัยว่าตัวเองอยู่ตรงไหน"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጻዕሪ ካብ ክልቲኡ ወገን ክኸውን ኣለዎ። ናይ ሓደ ወገን ምስ ዝመስል፣ ኣበይ ከም ዘለኹም ክትሓቱ ትጅምሩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagalla iki taraplaýyn bolmaly. Ol bir taraplaýyn duýulanda, sen öz ýeriňi sorag astyna alyp başlaýarsyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emek iki taraflı olmalı. Tek taraflı hissettiğinde nerede durduğunu sorgulamaya başlıyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зусилля мають бути взаємними. Коли все однобічно, ти починаєш сумніватися, яке місце займаєш."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوشش دونوں طرف سے ہونی چاہیے۔ جب یہ یک طرفہ لگے تو آپ کے ذہن میں سوال اٹھنے لگتا ہے کہ رشتے میں آپ کی جگہ کیا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harakat ikki tomonlama boʻlishi kerak. Bir tomonlama tuyulsa, munosabatlarda oʻrningiz qayerda ekaniga shubha qila boshlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nỗ lực phải đến từ cả hai phía. Khi thấy chỉ một bên cố gắng, bạn bắt đầu tự hỏi mình đang ở đâu trong lòng người ấy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umzamo kufuneka uvela kumacala omabini. Xa kuvakala kungathi licala elinye, uqala ukuzibuza ukuba umi phi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akitiyan gbọ́dọ̀ wá láti ẹ̀gbẹ́ méjèèjì. Nígbà tí ó bá dà bí ti ẹ̀gbẹ́ kan, ẹ máa ń bẹ̀rẹ̀ sí í ṣiyèméjì nípa ipò yín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付出應該是雙向的。一旦感覺只有自己在努力，你就會開始懷疑自己在對方心中的位置。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
