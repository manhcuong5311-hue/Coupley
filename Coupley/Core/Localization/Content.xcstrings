        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভারসাম্য আর বাস্তবতা। তুমি চরমপন্থী নও — খাবার উপভোগ করো, আবার নিজের যত্নও নাও।"
