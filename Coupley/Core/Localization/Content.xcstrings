        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciyaaruhu waa qayb dhab ah oo ka mid ah noloshaada bulsho iyo madadaalo. Lammaane ahaan waa in la fahmo waqtiga ay qaataan iyo bulshada la socota."
