        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түсінікті. Тек серігің сенімен бірге ойнағысы келе ме, әлде ойын уақытын құрметтеуің керек пе, соны білген жөн."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សមហេតុផល។ គ្រាន់តែគួរដឹងថាដៃគូរបស់អ្នកចង់លេងជាមួយអ្នក — ឬត្រូវការឲ្យអ្នកគោរពពេលលេងហ្គេមរបស់គាត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸರಿ. ನಿಮ್ಮ ಸಂಗಾತಿ ನಿಮ್ಮ ಜೊತೆ ಆಡಲು ಇಷ್ಟಪಡುತ್ತಾರೆಯೇ — ಅಥವಾ ಅವರ ಆಟದ ಸಮಯವನ್ನು ನೀವು ಗೌರವಿಸಬೇಕೇ ಎಂದು ತಿಳಿದಿರುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럴 수 있어요. 다만 연인이 함께 게임하고 싶어 하거나, 게임 시간을 존중받고 싶어 한다면 알아 두면 좋아요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rast e. Tenê hêja ye ku tu zanibî eger hevjînê te dixwaze bi te re bilîze — an jî eger ew dixwaze tu rêzê li wextê lîstikê bigirî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түшүнүктүү. Бирок сүйгөнүң сени менен ойногусу келеби — же оюн убактысын сыйлашыңды каалайбы, билип койгон жакшы."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fair. Just gutt ze wëssen, ob däi Schatz gär mat dir spille géif — oder Zäit fir Gaming brauch, déi s de respektéiere solls."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ກໍຍຸດຕິທຳດີ ພຽງແຕ່ຄວນຮູ້ໄວ້ວ່າຄູ່ຂອງເຈົ້າຢາກຫຼິ້ນນຳເຈົ້າບໍ — ຫຼື ລາວຕ້ອງການໃຫ້ເຈົ້າເຄົາລົບເວລາຫຼິ້ນເກມຂອງລາວ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprantama. Tik verta žinoti, ar tavo antroji pusė norėtų žaisti su tavimi – ar jai reikia, kad gerbtum jos žaidimų laiką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saprotams. Tikai vērts zināt, vai tava otrā puse labprāt spēlētu kopā ar tevi – vai arī vēlas, lai tu cieni viņas spēļu laiku."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara-drariny. Tsara ho fantatra fotsiny raha te hiara-milalao aminao ny olon-tianao — na raha mila hajaina ny fotoana filalaovany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei te tika. He pai noa kia mōhio mēnā ka pai rawa ki tō hoa aroha te tākaro tahi me koe — mēnā rānei me whakaute tōna wā kēmu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фер. Само добро е да знаеш дали половинката би сакала да игра со тебе — или ѝ треба почит за нејзиното време за игри."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ന്യായം. പങ്കാളി നിങ്ങളോടൊപ്പം കളിക്കാൻ ആഗ്രഹിക്കുന്നുണ്ടോ — അല്ലെങ്കിൽ അവരുടെ ഗെയിമിങ് സമയം മാനിക്കപ്പെടണമെന്ന് ആഗ്രഹിക്കുന്നുണ്ടോ എന്ന് അറിഞ്ഞിരിക്കുന്നത് നല്ലതാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойлгомжтой. Хань чинь чамтай тоглохыг хүсдэг эсэх, эсвэл тоглох цагаа хүндлүүлэхийг хүсдэг эсэхийг л мэдэж байх нь зүйтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठीक आहे. फक्त जोडीदाराला तुमच्यासोबत खेळायला आवडेल का — किंवा त्यांच्या गेमिंगच्या वेळेचा आदर व्हायला हवा का — हे जाणून घेतलेले बरे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak mengapa. Cuma elok tahu jika pasangan anda teringin bermain bersama anda — atau perlukan masa bermainnya dihormati."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ġust. Imma staqsi lill-partner tiegħek: forsi tixtiequ tilagħbu flimkien — jew forsi l-ħin tal-gaming għandu jiġi rispettat."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရပါတယ်။ ချစ်သူက သင်နဲ့ ကစားချင်လား — ဒါမှမဟုတ် ဂိမ်းကစားချိန်ကို လေးစားပေးဖို့ လိုလားဆိုတာတော့ သိထားသင့်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt greit. Bare verdt å vite om partneren din gjerne vil spille med deg – eller trenger at spilletiden blir respektert."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठिकै छ। बस, तपाईंको पार्टनर तपाईंसँग खेल्न मन पराउनुहुन्छ कि, वा उहाँको गेमिङ समयको सम्मान चाहनुहुन्छ कि भन्ने जान्नु राम्रो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima. Wel goed om te weten of je partner graag met je zou spelen – of juist wil dat je die gametijd respecteert."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zili bwino. Koma ndi bwino kudziwa ngati wokondedwa wanu angakonde kusewera nanu — kapena ngati akufuna kuti nthawi yake yosewera ilemekezedwe."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirrii dha. Garuu si wajjin taphachuun jaalallee keetiif gammachuu yoo ta'e — ykn yeroon taphaa jaalallee kee kabajamuu yoo qabaate — beekuun gaarii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଠିକ୍ କଥା। କେବଳ ଜାଣିବା ଭଲ ଯେ ଆପଣଙ୍କ ସାଥୀ ଆପଣଙ୍କ ସହ ଖେଳିବାକୁ ଭଲପାଆନ୍ତି କି — କିମ୍ବା ତାଙ୍କ ଗେମିଂ ସମୟକୁ ସମ୍ମାନ ଦେବା ଦରକାର କି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਠੀਕ ਹੈ। ਬੱਸ ਇਹ ਜਾਣਨਾ ਚੰਗਾ ਹੈ ਕਿ ਕੀ ਤੁਹਾਡੇ ਪਾਰਟਨਰ ਤੁਹਾਡੇ ਨਾਲ ਖੇਡਣਾ ਪਸੰਦ ਕਰਨਗੇ — ਜਾਂ ਕੀ ਉਹ ਚਾਹੁੰਦੇ ਹਨ ਕਿ ਉਨ੍ਹਾਂ ਦੇ ਗੇਮਿੰਗ ਦੇ ਸਮੇਂ ਦੀ ਕਦਰ ਕੀਤੀ ਜਾਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W porządku. Warto tylko wiedzieć, czy twoja druga połówka chciałaby grać razem z tobą – albo czy potrzebuje, żeby szanować jej czas na granie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمه ده. یوازې ښه ده پوه شئ چې ستاسو ملګری غواړي درسره لوبې وکړي — یا دا چې د لوبو وخت یې باید درناوی شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justo. Só vale saber se seu amor adoraria jogar com você — ou se precisa ter o próprio tempo de jogo respeitado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justo. Vale só a pena saber se o teu par adorava jogar contigo — ou se precisa que respeitem o tempo de jogo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal. Doar că e bine de știut dacă partenerului tău i-ar plăcea să vă jucați împreună — sau dacă are nevoie să-i respecți timpul de joc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справедливо. Просто стоит знать, хочет ли партнёр играть вместе с тобой — или ему важно, чтобы уважали его игровое время."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birumvikana. Ni byiza gusa kumenya niba umukunzi wawe yakwishimira gukina nawe — cyangwa niba akeneye ko igihe cye cyo gukina cyubahwa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සාධාරණයි. ඔබේ සහකරු ඔබ එක්ක සෙල්ලම් කරන්න කැමතිද — නැත්නම් ඔවුන්ගේ ගේම් කාලයට ගරු කරන්න ඕනේද කියලා දැනගන්න එක විතරක් වටිනවා."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V poriadku. Len je dobré vedieť, či by sa s tebou tvoja polovička rada hrala – alebo či potrebuje rešpekt k svojmu času na hranie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošteno. Le dobro je vedeti, ali bi se tvoj partner rad igral s tabo – ali pa potrebuje, da spoštuješ čas, ki ga nameni igranju."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvakanaka. Chete zvakakodzera kuziva kana mudiwa wako angada kutamba newe — kana kuti anoda kuti nguva yake yemitambo iremekedzwe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waa caadi. Kaliya ogow haddii lammaanahaagu jecel yahay in wadajir loo ciyaaro — ama haddii loo baahan yahay in waqtiga ciyaarta la ixtiraamo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E drejtë. Thjesht ia vlen ta dish nëse partneri yt do të donte të luante me ty – ose nëse i duhet respektuar koha e lojës."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фер. Само је добро знати да ли би твоја половина волела да игра с тобом — или јој треба да поштујеш њено време за игрице."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajar. Ngan saé terang upami pasangan anjeun hoyong ulin babarengan, atanapi upami anjeunna peryogi waktos ulin game-na dihargaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt rimligt. Bara bra att veta om din partner gärna vill spela med dig – eller behöver få sin speltid respekterad."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sawa kabisa. Inafaa tu kujua kama mwenzi wako angependa kucheza nawe — au kama anahitaji muda wake wa michezo uheshimiwe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நியாயம்தான். உங்கள் துணை உங்களுடன் விளையாட விரும்புகிறாரா, அல்லது அவரது கேமிங் நேரம் மதிக்கப்பட வேண்டுமா என்று தெரிந்துகொள்வது நல்லது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సరే. మీ భాగస్వామి మీతో కలిసి ఆడాలని కోరుకుంటారేమో — లేదా వారి గేమింగ్ సమయాన్ని గౌరవించాలని కోరుకుంటారేమో తెలుసుకోవడం మంచిది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дуруст. Танҳо донистан муфид аст, ки оё ёрат мехоҳад бо ту бозӣ кунад — ё ба ӯ лозим аст, ки вақти бозиашро эҳтиром кунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก็ไม่แปลก แค่ควรรู้ไว้ว่าคนรักอยากเล่นด้วยกันกับคุณหรือเปล่า หรือต้องการให้คุณเคารพเวลาเล่นเกมของอีกฝ่าย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ርትዓዊ። ጸወታ ንመጻምድኹም ዘሐጕስ እንተኾይኑ — ብሓባር ንምጽዋት ይኹን ንግዜ ጸወታ ክብሪ ንምሃብ — ምፍላጡ ጥራይ ይጠቅም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşnükli. Diňe söýgüliň seniň bilen oýnamagy halaýan bolsa — ýa-da oýun wagtyna hormat goýulmagyny isleýän bolsa, muny bilmek gowy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlaşılır. Yalnızca partnerin seninle oynamayı çok istiyorsa ya da oyun zamanına saygı bekliyorsa bilmekte fayda var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цілком зрозуміло. Просто варто знати, чи хотіла б половинка грати разом із тобою — або чи потрібно поважати її ігровий час."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹھیک ہے۔ بس یہ جاننا اچھا ہے کہ کیا آپ کے ساتھی کو آپ کے ساتھ کھیلنا اچھا لگے گا، یا اس کے گیمنگ کے وقت کا احترام ضروری ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tushunarli. Faqat sherigingiz siz bilan oʻynashni juda xohlashini — yoki oʻyin vaqtini hurmat qilishingizni kutishini bilib qoʻyish foydali."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng hợp lý. Chỉ nên biết liệu người ấy có muốn chơi cùng bạn không — hay cần bạn tôn trọng giờ chơi game của người ấy."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulungile. Kufanelekile nje ukwazi ukuba iqabane lakho lingathanda ukudlala nawe — okanye lifuna ixesha lalo lokudlala lihlonitshwe."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó yẹ. Ó kàn dára láti mọ̀ bóyá olólùfẹ́ yín yóò fẹ́ bá yín ṣeré — tàbí bóyá ó nílò kí ẹ bọ̀wọ̀ fún àkókò eré rẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明白。只是值得知道另一半會不會很想跟你一起玩，或者需要你尊重對方的打機時間。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这很正常。只是值得知道另一半是不是很想和你一起玩，或者需要你尊重对方的游戏时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很合理。只是值得知道另一半是不是很想和你一起玩，或需要你尊重對方的遊戲時間。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulungile. Kuhle nje ukwazi uma umlingani wakho angathanda ukudlala nawe — noma uma edinga ukuthi isikhathi sakhe semidlalo sihlonishwe."
          }
        }
      }
    },
