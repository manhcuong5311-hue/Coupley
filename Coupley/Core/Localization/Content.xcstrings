          "stringUnit" : {
            "state" : "translated",
            "value" : "సరళంగా, రిమోట్‌గా — ఎక్కడి నుంచైనా పని చేసే స్వేచ్ఛ ముఖ్యం"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чандир ва фосилавӣ — озодии ҷой муҳим аст"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นและทำงานรีโมต อิสระเรื่องสถานที่สำคัญ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተጣጣፍን ካብ ርሑቕን — ናጽነት ቦታ ኣገዳሲ እዩ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeýe we uzakdan — ýer erkinligi möhüm"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esnek ve uzaktan, yer özgürlüğü önemli"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнучко й віддалено — щоб працювати звідусіль"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لچک دار اور ریموٹ — جگہ کی آزادی اہم ہے"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moslashuvchan va masofaviy — joydan erkinlik muhim"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt, làm từ xa — tự do nơi chốn là quan trọng"
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngokuguquguqukayo nakude — inkululeko yendawo ibalulekile"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iṣẹ́ tí kò le koko, láti ibikíbi — òmìnira ibi ṣe pàtàkì"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彈性和遙距工作，地點自由很重要"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵活远程，想在哪儿就在哪儿"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彈性遠距，地點自由很重要"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuguquguqukayo nokusebenza ukude — inkululeko yendawo ibalulekile"
          }
        }
      }
    },
    "Flexible but not indifferent. You're not actively wanting or avoiding — you're open to what the relationship calls for." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buigsaam, maar nie onverskillig nie. Jy wil dit nie aktief hê of vermy nie – jy’s oop vir wat die verhouding vra."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተለዋዋጭ ግን ግድየለሽ ያልሆኑ። በንቃት እየፈለጉም እየሸሹም አይደለም — ግንኙነቱ ለሚጠይቀው ክፍት ነዎት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرونة لا لامبالاة. لا سعي ولا تجنّب، بل انفتاح على ما تحتاجه العلاقة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নমনীয়, কিন্তু উদাসীন নহয়। আপুনি সক্ৰিয়ভাৱে বিচৰাও নাই, এৰাইও চলা নাই — সম্পৰ্কটোৱে যি বিচাৰে তাৰ প্ৰতি আপুনি মুকলি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevik, amma laqeyd deyil. Nə fəal şəkildə istəyirsən, nə də qaçırsan — münasibətin tələb etdiyinə açıqsan."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнутка, але не абыякава. Ты не імкнешся да гэтага і не пазбягаеш — ты адкрыта прымаеш тое, што падкажуць адносіны."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гъвкаво, но не безразлично. Нито активно го искаш, нито го избягваш – приемаш това, което връзката покаже."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নমনীয়, তবে উদাসীন নয়। তুমি সক্রিয়ভাবে চাইছও না, এড়াচ্ছও না — সম্পর্ক যা চায়, তার জন্য খোলা মনে আছ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilno, ali ne ravnodušno. Niti aktivno želiš niti izbjegavaš – otvoreno je za ono što veza donese."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitat, no indiferència. Ni ho busques activament ni ho evites — tens obertura al que demani la relació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilní, ale ne lhostejný postoj. Aktivně po tom netoužíš ani se tomu nevyhýbáš – necháváš to na tom, co vztah přinese."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyblyg ond nid difater. Dwyt ti ddim yn mynd ati i'w eisiau na'i osgoi — rwyt ti'n agored i beth mae'r berthynas yn galw amdano."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, men ikke ligeglad. Du hverken ønsker eller undgår det aktivt – du er åben for, hvad forholdet lægger op til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel, aber nicht gleichgültig. Du willst es weder unbedingt noch vermeidest du es – du bist offen für das, was die Beziehung braucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευελιξία, όχι αδιαφορία. Ούτε το επιδιώκεις ούτε το αποφεύγεις — αφήνεις χώρο σε ό,τι ζητήσει η σχέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad, no indiferencia. No lo buscas ni lo evitas — te abres a lo que pida la relación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paindlik, aga mitte ükskõikne. Sa ei taha seda aktiivselt ega väldi — oled avatud sellele, mida suhe kutsub."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malgua, baina ez axolagabea. Ez duzu aktiboki nahi, ez saihesten — harremanak eskatzen duenera irekita zaude."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منعطف ولی نه بی‌تفاوت. نه فعالانه دنبالش هستی نه از آن فرار می‌کنی — پذیرای چیزی هستی که رابطه می‌طلبد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joustava mutta ei välinpitämätön. Et aktiivisesti halua etkä vältä – olet avoin sille, mitä suhde tuo tullessaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible pero hindi walang pakialam. Hindi mo ito aktibong hinahanap o iniiwasan — bukas ka sa kung ano ang hinihingi ng relasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la souplesse, pas de l'indifférence. Tu n'en veux pas à tout prix, mais tu ne l'exclus pas : tu laisses de la place à ce que la relation demandera."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solúbtha ach ní neamhshuimiúil. Níl tú á lorg ná á sheachaint go gníomhach — tá tú oscailte don rud a éilíonn an caidreamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade, pero non indiferenza. Nin o buscas activamente nin o evitas: deixas a porta aberta ao que a relación pida."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "લવચીક, પણ ઉદાસીન નહીં. તમે સક્રિયપણે ઇચ્છતા પણ નથી અને ટાળતા પણ નથી — સંબંધ જે માગે એ માટે તમે તૈયાર છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna da sassauci amma ba ko-in-kula ba. Ba kwa nema ko gujewa — kuna buɗe ga abin da dangantakar ta buƙata."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות, לא אדישות. אין כאן רצון עז או הימנעות — יש פתיחות למה שהקשר יזמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लचीलापन, बेपरवाही नहीं। न बच्चों की तीव्र चाह है, न उनसे परहेज़ — रिश्ता जो माँगे, उसके लिए आपका मन खुला है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilno, ali ne ravnodušno. Niti to aktivno želiš niti izbjegavaš – otvoreno pristupaš onome što veza donese."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksib men pa endiferan. Ou pa ap chèche l, ni ou pa ap evite l — ou louvri a sa relasyon an mande."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugalmas vagy, de nem közömbös. Nem vágysz rá kifejezetten, de nem is kerülöd – nyitott vagy arra, amit a kapcsolat kíván."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճկուն, բայց ոչ անտարբեր։ Ոչ ակտիվորեն ձգտում ես, ոչ էլ խուսափում — բաց ես այն ամենի համար, ինչ կպահանջեն հարաբերությունները։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, tapi bukan berarti cuek. Kamu nggak sedang mengejar atau menghindarinya — kamu terbuka pada apa yang dibutuhkan hubungan kalian."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-agbanwe agbanwe mana ọ bụghị na ọ dịghị gị mkpa. Ị naghị achọsi ike ma ọ bụ na-ezere ya — obi gị ghere oghe n'ihe mmekọrịta ahụ chọrọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveigjanleiki en ekki áhugaleysi. Þú ert hvorki að sækjast eftir því né forðast það – þú tekur opnum huga því sem sambandið kallar á."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibilità, non indifferenza. Non li cerchi né li eviti attivamente — lasci spazio a ciò che la relazione chiederà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔軟だけど、どうでもいいわけではありません。強く望むわけでも避けるわけでもなく、ふたりの関係に合わせて考えたいのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luwes nanging ora cuek. Panjenengan ora ngoyo pengin utawa nyingkiri — panjenengan terbuka marang apa sing dibutuhake sesambungan."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოქნილი, მაგრამ არა გულგრილი. აქტიურად არც გინდა და არც გაურბიხარ — ღია ხარ იმისთვის, რასაც ურთიერთობა მოითხოვს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Икемдісің, бірақ немқұрайлы емессің. Белсенді түрде қаламайсың да, қашпайсың да — қарым-қатынас не талап етсе, соған ашықсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បត់បែន តែមិនព្រងើយ។ អ្នកមិនមែនចង់ខ្លាំង ឬជៀសវាងទេ — អ្នកបើកចិត្តចំពោះអ្វីដែលទំនាក់ទំនងត្រូវការ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೊಂದಿಕೊಳ್ಳುವ, ಆದರೆ ಉದಾಸೀನವಲ್ಲ. ನೀವು ಸಕ್ರಿಯವಾಗಿ ಬಯಸುತ್ತಲೂ ಇಲ್ಲ, ತಪ್ಪಿಸುತ್ತಲೂ ಇಲ್ಲ — ಸಂಬಂಧ ಏನು ಕೇಳುತ್ತದೋ ಅದಕ್ಕೆ ತೆರೆದಿದ್ದೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유연하지만 무관심한 건 아니에요. 적극적으로 원하지도 피하지도 않고, 관계가 이끄는 방향에 열려 있어요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerm lê ne bêxem. Tu ne bi çalakî dixwazî, ne jî jê direvî — tu ji tiştê ku têkilî dixwaze re vekirî yî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ийкемдүү, бирок кайдыгер эмес. Атайын каалабайсың да, качпайсың да — мамиле эмнени талап кылса, ага ачыксың."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel, mee net egal. Du wëlls et net onbedéngt, an du wiers dech och net — du bass op fir dat, wat är Bezéiung brauch."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຍືດຫຍຸ່ນແຕ່ບໍ່ແມ່ນບໍ່ສົນໃຈ ເຈົ້າບໍ່ໄດ້ຢາກ ຫຼື ຫຼີກລ່ຽງ — ເຈົ້າເປີດໃຈຕາມທີ່ຄວາມສຳພັນພາໄປ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanksčiai, bet ne abejingai. Aktyviai nei sieki, nei vengi – priimsi tai, ko pareikalaus santykiai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastīgi, bet ne vienaldzīgi. Tu ne aktīvi to vēlies, ne no tā izvairies – tu ļauj attiecībām pašām parādīt ceļu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malefaka nefa tsy tsy miraharaha. Tsy maniry mafy na mialana ianao — misokatra amin'izay ilain'ny fifandraisana ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ngāwari, engari ehara i te kore aro. Kāore koe e tino hiahia ana, e karo ana rānei — kei te tuwhera koe ki tā te hononga e karanga ai."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флексибилно, но не рамнодушно. Ниту активно сакаш, ниту избегнуваш — отворено е за она што ќе го побара врската."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വഴക്കമുണ്ട്, പക്ഷേ നിസ്സംഗതയില്ല. നിങ്ങൾ സജീവമായി ആഗ്രഹിക്കുകയോ ഒഴിവാക്കുകയോ ചെയ്യുന്നില്ല — ബന്ധം ആവശ്യപ്പെടുന്നതിനോട് തുറന്ന മനസ്സാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уян хатан ч хайхрамжгүй биш. Чи идэвхтэй хүсэхгүй, зайлсхийхгүй ч байна — харилцаа юу шаардахад нээлттэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लवचीक, पण बेफिकीर नाही. तुम्ही ते मुद्दाम हवेही म्हणत नाही आणि टाळतही नाही — नात्याला जे योग्य वाटेल त्यासाठी तुम्ही खुले आहात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel tetapi bukan tidak peduli. Anda tidak bersungguh mahu atau mengelak — anda terbuka mengikut keperluan hubungan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibbiltà iżda mhux indifferenza. M'intix qed tfittex jew tevita b'mod attiv — tħalli l-bieb miftuħ għal dak li titlob ir-relazzjoni."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လိုက်လျောညီထွေ ရှိပေမဲ့ ဂရုမစိုက်တာ မဟုတ်ဘူး။ တက်ကြွစွာ လိုချင်တာလည်း မဟုတ်၊ ရှောင်တာလည်း မဟုတ် — ဆက်ဆံရေး လိုအပ်တာကို ဖွင့်ထားတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel, men ikke likegyldig. Du verken ønsker eller unngår det aktivt – du er åpen for det forholdet trenger."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लचिलो तर उदासीन होइन। तपाईं सक्रिय रूपमा चाहनु वा टार्नु भएको छैन — सम्बन्धले जे माग्छ त्यसका लागि खुला हुनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel, maar niet onverschillig. Je wilt het niet per se, en je vermijdt het ook niet – je staat open voor wat de relatie vraagt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wosinthasintha koma osati wosasamala. Simukufunitsitsa kapena kupewa — ndinu omasuka ku zomwe ubale wanu udzafuna."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jijjiiramaa garuu kan hin dagatne. Hin barbaaddu, hin dhiiftus — waan hariiroon barbaadu fudhachuuf qophii dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନମନୀୟ, କିନ୍ତୁ ଉଦାସୀନ ନୁହେଁ। ଆପଣ ସକ୍ରିୟ ଭାବେ ଚାହୁଁ ନାହାଁନ୍ତି ବା ଏଡ଼ାଉ ନାହାଁନ୍ତି — ସମ୍ପର୍କ ଯାହା ଚାହେଁ ସେଥିପାଇଁ ଖୋଲା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਲਚਕਦਾਰ, ਪਰ ਬੇਪਰਵਾਹ ਨਹੀਂ। ਤੁਸੀਂ ਨਾ ਤਾਂ ਸ਼ਿੱਦਤ ਨਾਲ ਚਾਹੁੰਦੇ ਹੋ ਅਤੇ ਨਾ ਹੀ ਬਚਦੇ ਹੋ — ਰਿਸ਼ਤਾ ਜੋ ਮੰਗੇ, ਉਸ ਲਈ ਤੁਸੀਂ ਖੁੱਲ੍ਹੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastycznie, ale nie obojętnie. Ani tego aktywnie nie chcesz, ani nie unikasz – zostawiasz miejsce na to, czego będzie potrzebował związek."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انعطاف، خو نه بې‌پروايي. تاسو نه په فعاله توګه یې غواړئ او نه ترې ډډه کوئ — هغه څه ته چمتو یاست چې اړیکه یې غواړي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade, não indiferença. Você não está buscando nem evitando — tem abertura para o que a relação pedir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade, mas não indiferença. Não estás ativamente a querer nem a evitar — dás espaço ao que a relação pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate, nu indiferență. Nici nu îți dorești activ, nici nu eviți — rămâi cu mintea deschisă la ce cere relația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гибкость, но не безразличие. Ты не стремишься к этому и не избегаешь — всё зависит от того, чего потребуют отношения."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uroroshye ariko ntiwirengagiza. Ntubishaka cyane kandi ntubihunga — witeguye icyo umubano uzasaba."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නම්‍යශීලී, ඒත් උදාසීන නැහැ. ඔබ ක්‍රියාශීලීව ඕනේ කරන්නෙත් නැහැ, මඟ හරින්නෙත් නැහැ — සබඳතාවට ඕනේ දේට ඔබ විවෘතයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilne, no nie ľahostajne. Deti aktívne nechceš ani sa im nevyhýbaš – necháš to na to, čo prinesie vzťah."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prožno, a ne brezbrižno. Otrok si dejavno ne želiš niti se jim ne izogibaš – ostajaš odprte glave za to, kar prinese odnos."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unochinjika asi hausi kungoshaya basa. Hausi kuzvida kana kuzvinzvenga — wakavhurika kune zvinodiwa neukama."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabacsan laakiin aan dan la'aan ahayn. Si firfircoon uma rabtid umana cararaysid — waxaad u furan tahay waxa xiriirku u baahdo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilitet, por jo indiferencë. Nuk po e kërkon aktivisht dhe as po e shmang – pranon atë që kërkon marrëdhënia."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флексибилно, али не равнодушно. Нити то активно желиш нити избегаваш — отворено је за оно што веза донесе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luwes tapi sanés teu paduli. Anjeun teu aktip hoyong atanapi ngajauhan — anjeun kabuka kana naon anu dipikabutuh ku hubungan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel men inte likgiltig. Du varken längtar efter eller undviker det – du är öppen för vad relationen behöver."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabadilika lakini hujali kidogo. Hutaki wala hukwepi kwa nguvu — uko wazi kwa kile uhusiano unachohitaji."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நெகிழ்வானவர், ஆனால் அக்கறையற்றவர் அல்ல. நீங்கள் தீவிரமாக விரும்பவும் இல்லை, தவிர்க்கவும் இல்லை — உறவு எதைக் கோருகிறதோ அதற்குத் திறந்த மனதுடன் இருக்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సరళంగా, కానీ పట్టించుకోకుండా కాదు. మీరు చురుకుగా కోరుకోవడం లేదు, తప్పించుకోవడమూ లేదు — బంధానికి ఏది అవసరమో దానికి సిద్ధంగా ఉన్నారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чандир, вале на бепарво. Ту на фаъолона мехоҳӣ ва на канорагирӣ мекунӣ — ба он чи муносибат талаб кунад, кушодаӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นแต่ไม่ได้เฉยเมย คุณไม่ได้อยากมีเป็นพิเศษหรือพยายามเลี่ยง คุณเปิดรับสิ่งที่ความสัมพันธ์ต้องการ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተጣጣፍቲ ግን ዘይግደሱ ኣይኮንኩምን። ብንጥፈት ኣይትደልዩዎን ኣይትሃድምዎን — ርክብኩም ንዝሓቶ ክፉታት ኢኹም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeýe, ýöne parhsyz däl. Sen işjeň islemeýärsiň hem, gaça hem durmaýarsyň — gatnaşygyňyzyň talap edýän zadyna açyk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esneksin ama kayıtsız değilsin. Ne özellikle istiyor ne de kaçıyorsun; ilişkinin gerektirdiğine açıksın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнучко, але не байдуже. Ти не прагнеш цього й не уникаєш — а відкриваєшся тому, чого потребуватимуть ваші стосунки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لچک دار مگر لاتعلق نہیں۔ نہ آپ کو شدید خواہش ہے نہ گریز — رشتہ جو تقاضا کرے، اس کے لیے آپ کا ذہن کھلا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moslashuvchan, lekin befarq emas. Faol xohlamaysiz ham, qochmaysiz ham — munosabatlar nimani taqozo qilsa, shunga ochiqsiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt nhưng không thờ ơ. Bạn không chủ động mong cũng chẳng né tránh — bạn mở lòng với điều mối quan hệ cần."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaguquguquka kodwa awukhathali. Awufuni ngamandla kwaye awukuphepheli — uvulelekile koko kufunwa bubudlelwane."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ kò le koko, ṣùgbọ́n kì í ṣe àìbìkítà. Ẹ kò fi taratara wá a, ẹ kò sì sá fún un — ọkàn yín ṣí sí ohun tí ìbáṣepọ̀ yín bá béèrè."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有彈性但不是無所謂。你沒有特別想要或迴避，而是看這段感情需要甚麼。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵活，但并非无所谓。你不是特别想要，也没有刻意回避，而是看这段关系需要什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有彈性，但不是無所謂。你不特別想要也不刻意避免，而是看這段感情需要什麼。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaguquguquka kodwa awunganaki. Awufisi ngamandla futhi awugwemi — uvulekele lokho ubudlelwano obukudingayo."
          }
        }
      }
    },
    "Flexible within structure. You want a safety net but you don't need a script. Most people find this easy to work with." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buigsaam binne ’n struktuur. Jy wil ’n vangnet hê, maar jy het nie ’n draaiboek nodig nie. Die meeste mense vind dit maklik om mee saam te werk."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በመዋቅር ውስጥ ተለዋዋጭ። የደኅንነት መረብ ይፈልጋሉ፣ ግን ዝርዝር ስክሪፕት አያስፈልግዎትም። አብዛኞቹ ሰዎች ከዚህ ጋር መሥራት ቀላል ሆኖ ያገኙታል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرونة داخل إطار. تريدون شبكة أمان دون نص مكتوب، ومعظم الناس يجدون ذلك سهلًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গাঁথনিৰ ভিতৰত নমনীয়। আপুনি এখন সুৰক্ষাৰ জাল বিচাৰে, কিন্তু লিখা চিত্ৰনাট্য নালাগে। বেছিভাগ মানুহৰ বাবে এনে মানুহৰ লগত চলা সহজ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çərçivə daxilində çeviklik. Təhlükəsizlik toru istəyirsən, amma ssenariyə ehtiyacın yoxdur. Çoxları ilə bu, asan alınır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнуткасць у межах структуры. Табе патрэбна страхоўка, але не сцэнарый. Большасці людзей з гэтым лёгка."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гъвкавост в рамки. Искаш предпазна мрежа, но не ти трябва сценарий. На повечето хора им е лесно с това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাঠামোর মধ্যে নমনীয়। একটা ভরসার জাল চাও, কিন্তু পুরো চিত্রনাট্য লাগে না। বেশিরভাগ মানুষের কাছে এর সাথে মানিয়ে নেওয়া সহজ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilnost unutar strukture. Treba ti sigurnosna mreža, ali ne i scenarij. Većini ljudi je s tim lako."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitat dins d'una estructura. Vols una xarxa de seguretat, però no et cal un guió. A la majoria de gent li és fàcil entendre-s'hi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volnost v rámci struktury. Chceš záchrannou síť, ale scénář nepotřebuješ. S tím se většině lidí pracuje snadno."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyblyg o fewn strwythur. Rwyt ti eisiau rhwyd ddiogelwch, ond does dim angen sgript arnat ti. Mae'r rhan fwyaf o bobl yn gweld hynny'n hawdd byw gydag e."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel inden for en ramme. Du vil gerne have et sikkerhedsnet, men du behøver ikke et manuskript. Det har de fleste let ved at indrette sig efter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel mit Struktur. Du willst ein Sicherheitsnetz, aber kein Drehbuch. Damit kommen die meisten gut klar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευελιξία μέσα σε ένα πλαίσιο. Θέλεις δίχτυ ασφαλείας, αλλά όχι σενάριο. Με αυτό οι περισσότεροι συνεννοούνται εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidad dentro de una estructura. Quieres una red de seguridad, pero no necesitas un guion. Con eso, casi todo el mundo se siente a gusto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paindlik raamides. Tahad turvavõrku, aga stsenaariumi sul vaja pole. Enamikul inimestel on sinuga lihtne koostööd teha."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malgua egitura baten barruan. Babes-sare bat nahi duzu, baina ez gidoirik. Jende gehienari erraza egiten zaio horrekin moldatzea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منعطف در یک چارچوب. تور ایمنی می‌خواهی ولی به فیلمنامه نیازی نداری. بیشتر آدم‌ها با این راحت کنار می‌آیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joustava raamien sisällä. Haluat turvaverkon, mutta et käsikirjoitusta. Useimpien on helppo toimia kanssasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible sa loob ng balangkas. Gusto mo ng safety net pero hindi mo kailangan ng script. Madali kang pakisamahan ng karamihan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la souplesse dans un cadre. Tu veux un filet de sécurité, pas un scénario. La plupart des gens s'y retrouvent facilement."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solúbtha laistigh de struchtúr. Teastaíonn líon sábhála uait ach ní script. Is furasta le formhór na ndaoine oibriú leis sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade dentro dunha estrutura. Queres unha rede de seguridade, pero non necesitas un guión. Á maioría da xente resúltalle doado."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "માળખામાં રહીને લવચીક. તમને સલામતીની જાળ જોઈએ, પણ સ્ક્રિપ્ટ નહીં. મોટા ભાગના લોકોને આ સાથે ફાવી જાય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu sassauci cikin tsari. Kuna son a sami abin dogaro amma ba ku buƙatar rubutaccen shiri. Yawancin mutane na samun sauƙin aiki da hakan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גמישות בתוך מסגרת. רשת ביטחון זה כן, תסריט זה לא. לרוב האנשים קל לעבוד עם זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढाँचे के भीतर लचीलापन। आपको सहारा चाहिए, पर पूरी स्क्रिप्ट नहीं। ज़्यादातर लोगों को आपके साथ चलना आसान लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilnost unutar strukture. Želiš sigurnosnu mrežu, ali ne trebaš scenarij. Većini ljudi s tim je lako."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksib nan yon estrikti. Ou vle yon filè sekirite men ou pa bezwen yon senaryo. Pifò moun twouve sa fasil pou travay avè l."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugalmas vagy egy kereten belül. Kell a biztonsági háló, de forgatókönyv nem. A legtöbben könnyen alkalmazkodnak ehhez."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճկունություն՝ կառուցվածքի ներսում։ Քեզ պետք է ապահովագրություն, բայց սցենար պետք չէ։ Մարդկանց մեծ մասի համար հեշտ է այսպես համագործակցել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel dalam struktur. Kamu ingin ada jaring pengaman, tapi tidak butuh naskah. Kebanyakan orang mudah menyesuaikan diri dengan ini."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị na-agbanwe n'ime usoro. Ị chọrọ ihe nchekwa mana ị chọghị ka e dee ihe niile. Ọtụtụ mmadụ na-ahụ nke a ka ihe dị mfe."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveigjanleiki innan ramma. Þú vilt öryggisnet en þarft ekki handrit. Flestum finnst auðvelt að vinna með það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibilità con una struttura. Vuoi una rete di sicurezza, ma non un copione. Con te è facile organizzarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枠のなかで柔軟に動けるタイプ。安心できる備えはほしいけれど、台本までは要りません。たいていの人が合わせやすいスタイルです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luwes ing sajrone tatanan. Panjenengan pengin pengaman nanging ora butuh naskah. Umume wong gampang cocog karo iki."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოქნილი, მაგრამ გარკვეულ ჩარჩოში. დაზღვევა გინდა, თუმცა სცენარი არ გჭირდება. ადამიანების უმეტესობისთვის ამასთან შეგუება ადვილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құрылым ішіндегі икемділік. Саған қауіпсіздік торы керек, бірақ сценарий қажет емес. Көп адам мұндай адаммен оңай тіл табысады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បត់បែនក្នុងក្របខណ្ឌមួយ។ អ្នកចង់មានសំណាញ់សុវត្ថិភាព ប៉ុន្តែមិនត្រូវការស្គ្រីបទេ។ មនុស្សភាគច្រើនយល់ថាងាយស្រួលនៅជាមួយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚೌಕಟ್ಟಿನೊಳಗೆ ಹೊಂದಿಕೊಳ್ಳುವಿಕೆ. ನಿಮಗೆ ಒಂದು ಆಸರೆ ಬೇಕು, ಆದರೆ ಪೂರ್ತಿ ಸ್ಕ್ರಿಪ್ಟ್ ಬೇಕಿಲ್ಲ. ಹೆಚ್ಚಿನವರಿಗೆ ಇದರ ಜೊತೆ ಹೊಂದಿಕೊಳ್ಳುವುದು ಸುಲಭ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "틀 안에서 유연해요. 안전망은 원하지만 대본까지는 필요 없죠. 대부분의 사람이 맞추기 편한 스타일이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerm di nav çarçoveyekê de. Tu toreke ewlehiyê dixwazî, lê ne senaryoyekê. Piraniya mirovan bi vê re bi hêsanî li hev dikin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алкак ичинде ийкемдүү. Коопсуздук торун каалайсың, бирок сценарий керек эмес. Мындай адам менен көпчүлүккө ыңгайлуу."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel mat Struktur. Du wëlls e Sécherheetsnetz, mee keen Dréibuch. Domat kommen déi meescht Leit gutt eens."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຢືດຢຸ່ນພາຍໃນກອບ ເຈົ້າຢາກມີທາງສຳຮອງ ແຕ່ບໍ່ຕ້ອງການບົດທີ່ຂຽນໄວ້ ຄົນສ່ວນຫຼາຍຢູ່ນຳແບບນີ້ໄດ້ງ່າຍ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lankstumas tam tikruose rėmuose. Nori apsauginio tinklo, bet scenarijaus nereikia. Daugeliui žmonių su tuo lengva sutarti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastība struktūras ietvaros. Tev vajag drošības tīklu, bet ne scenāriju. Ar to vairumam cilvēku ir viegli sadzīvot."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mora mampifanaraka ao anatin'ny rafitra. Mila fiarovana ianao nefa tsy mila soratra voafaritra. Mora iarahana amin'izany ny ankamaroan'ny olona."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He ngāwari i roto i te anga. E hiahia ana koe ki tētahi kupenga haumaru, engari kāore koe e hiahia ki tētahi tuhinga. He māmā tēnei ki te nuinga o te tangata."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флексибилност во рамки. Сакаш заштитна мрежа, но не ти треба сценарио. На повеќето луѓе ова лесно им одговара."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചട്ടക്കൂടിനുള്ളിലെ വഴക്കം. ഒരു സുരക്ഷാവല വേണം, പക്ഷേ തിരക്കഥ വേണ്ട. മിക്കവർക്കും ഇതുമായി ഒത്തുപോകാൻ എളുപ്പമാണ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бүтэц доторх уян хатан байдал. Хамгаалалтын тор хүсдэг ч зохиол хэрэггүй. Ихэнх хүмүүст ийм хүнтэй ажиллахад амархан."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चौकटीत राहूनही लवचीक. तुम्हाला सुरक्षिततेचे जाळे हवे, पण ठरलेली संहिता नको. बहुतेकांना तुमच्यासोबत सहज जमते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel dalam struktur. Anda mahukan jaring keselamatan tetapi tidak perlukan skrip. Kebanyakan orang mudah bekerjasama dengan cara ini."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessibbiltà fi ħdan struttura. Trid xibka ta' sigurtà imma m'għandekx bżonn skript. Ħafna nies isibuha faċli jaħdmu ma' dan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘောင်ထဲမှာ လိုက်လျောညီထွေ ရှိတယ်။ အာမခံချက်လေး လိုချင်ပေမဲ့ ဇာတ်ညွှန်း မလိုဘူး။ လူအများစုက ဒါမျိုးနဲ့ အလွယ်တကူ တွဲနိုင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibel innenfor rammer. Du vil ha et sikkerhetsnett, men trenger ikke manus. De fleste synes det er lett å forholde seg til."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संरचनाभित्र लचिलो। तपाईंलाई सुरक्षाको जाल चाहिन्छ, तर स्क्रिप्ट चाहिँदैन। धेरैजसो मान्छेलाई यससँग काम गर्न सजिलो लाग्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel binnen een structuur. Je wilt een vangnet, maar geen draaiboek. De meeste mensen vinden dat makkelijk om mee om te gaan."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wosinthasintha mkati mwa dongosolo. Mumafuna chokugwirani koma simufuna zolembedwa zonse. Anthu ambiri amaona izi zosavuta kugwirizana nazo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caasaa keessatti of madaqsita. Eegumsa barbaadda, garuu barreeffama qophaa'e hin barbaaddu. Namoota baay'eef kun waliin hojjechuuf salphaa dha."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଢାଞ୍ଚା ଭିତରେ ନମନୀୟତା। ଆପଣ ଏକ ସୁରକ୍ଷା ଜାଲ ଚାହାନ୍ତି, କିନ୍ତୁ ଲେଖା ପଟକଥା ଦରକାର ନାହିଁ। ଅଧିକାଂଶ ଲୋକଙ୍କୁ ଏହା ସହ ଚଳିବା ସହଜ ଲାଗେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਢਾਂਚੇ ਵਿੱਚ ਲਚਕ। ਤੁਹਾਨੂੰ ਸੁਰੱਖਿਆ-ਜਾਲ ਚਾਹੀਦਾ ਹੈ, ਪਰ ਪੂਰੀ ਸਕ੍ਰਿਪਟ ਨਹੀਂ। ਜ਼ਿਆਦਾਤਰ ਲੋਕਾਂ ਨੂੰ ਇਸ ਨਾਲ ਚੱਲਣਾ ਸੌਖਾ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elastyczność w ramach struktury. Chcesz mieć siatkę bezpieczeństwa, ale nie potrzebujesz scenariusza. Większości ludzi łatwo się z tobą współpracuje."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په چوکاټ کې انعطاف. د خوندیتوب جال غواړئ، خو لیکلي سکرېپټ ته اړتیا نه لرئ. ډېری خلک ورسره په اسانۍ کار کولای شي."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade com estrutura. Você quer uma rede de segurança, mas não precisa de roteiro. A maioria das pessoas acha isso fácil de acompanhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilidade dentro de uma estrutura. Queres uma rede de segurança, mas não precisas de um guião. É fácil para a maioria das pessoas lidar com isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate într-un cadru. Vrei o plasă de siguranță, dar nu ai nevoie de scenariu. Cei mai mulți oameni se înțeleg ușor cu asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гибкость в рамках. Тебе нужна страховка, но не сценарий. С таким подходом легко ладить большинству людей."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woroshye muri gahunda. Ushaka icyo wishingikiriza ariko ntukeneye ibyanditswe byose. Abantu benshi babona ibi byoroshye gukorana nabyo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "රාමුවක් ඇතුළේ නම්‍යශීලී. ඔබට ආරක්ෂිත දැලක් ඕනේ, ඒත් පිටපතක් ඕනේ නැහැ. බොහෝ දෙනෙකුට මේ එක්ක වැඩ කරන එක පහසුයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilita v rámci štruktúry. Chceš záchrannú sieť, no scenár nepotrebuješ. S tým sa väčšine ľudí ľahko spolupracuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodljivost znotraj strukture. Želiš si varnostno mrežo, scenarija pa ne potrebuješ. Večina ljudi s tem zlahka sodeluje."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unochinjika mukati mehurongwa. Unoda chekudzokera kwachiri asi haudi zvekutevera zvakanyorwa. Vanhu vazhinji vanozviwana zviri nyore kushanda nazvo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabacsanaan nidaam gudihiis ah. Waxaad rabtaa shabag badbaado, balse uma baahnid qoraal dhammaystiran. Dadka badankood way fududaataa inay sidan kula shaqeeyaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleksibilitet brenda një strukture. Do një rrjet sigurie, por s’të duhet skenar. Shumica e njerëzve e kanë të lehtë të përshtaten me këtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флексибилност унутар структуре. Желиш сигурносну мрежу, али не треба ти сценарио. Са тим се већини људи лако ради."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléksibel dina struktur. Anjeun hoyong aya cadangan, tapi teu peryogi naskah. Seueur jalma anu ngaraos gampil kana ieu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibel inom ramarna. Du vill ha ett skyddsnät men behöver inget manus. De flesta har lätt att anpassa sig till det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mnyumbufu ndani ya mpangilio. Unataka kinga ya usalama lakini huhitaji hati ya kufuata. Watu wengi huona hili rahisi kuendana nalo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கட்டமைப்புக்குள் நெகிழ்வு. பாதுகாப்பு வலை வேண்டும், ஆனால் முழு ஸ்கிரிப்ட் தேவையில்லை. பெரும்பாலானோருக்கு இது ஒத்துப்போக எளிதானது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక చట్రంలోనే సరళత. మీకు ఒక భద్రతా వలయం కావాలి, కానీ స్క్రిప్ట్ అక్కర్లేదు. చాలామందికి మీతో కలిసి సాగడం సులభం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чандир дар доираи сохтор. Ба ту тӯри бехатарӣ лозим аст, вале сенария не. Бо ин аксари одамон осон кор мекунанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นในกรอบ คุณอยากมีตาข่ายรองรับแต่ไม่ต้องมีบท คนส่วนใหญ่ปรับเข้าหาแบบนี้ได้ง่าย"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ ውሽጢ ስርዓት ተዓጻጻፍ። መከላኸሊ መርበብ ትደልዩ፣ ግን ጽሑፍ መደብ ኣየድልየኩምን። መብዛሕትኦም ሰባት ምስዚ ብቐሊሉ ይሰርሑ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belli bir çägiň içinde çeýe. Saňa ätiýaçlyk tory gerek, ýöne ssenariý gerek däl. Köp adam üçin seniň bilen ylalaşmak aňsat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapı içinde esneklik. Bir güvenlik ağı istiyorsun ama senaryoya ihtiyacın yok. Çoğu insan bununla rahatça uyum sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гнучкість у межах структури. Тобі потрібна страховка, але не сценарій. З цим більшості людей легко."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈھانچے کے اندر لچک۔ آپ کو حفاظتی جال چاہیے، مگر اسکرپٹ نہیں۔ زیادہ تر لوگوں کو اس کے ساتھ چلنا آسان لگتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuzilma ichida moslashuvchan. Sizga himoya toʻri kerak, lekin ssenariy shart emas. Koʻpchilikka siz bilan til topishish oson."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linh hoạt trong khuôn khổ. Bạn muốn có lưới an toàn nhưng không cần kịch bản. Hầu hết mọi người đều thấy dễ phối hợp với bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaguquguquka ngaphakathi kolungelelwano. Ufuna into ekukhuselayo kodwa akufuni iskripthi. Abantu abaninzi bakufumana kulula oku."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ rọ̀ nínú ètò. Ẹ fẹ́ ààbò, ṣùgbọ́n ẹ kò nílò àkọsílẹ̀ ìlànà. Ọ̀pọ̀ èèyàn rí i pé èyí rọrùn láti bá ṣiṣẹ́."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有框架又靈活。你想要安全網，但不需要劇本。大部分人都覺得這樣很好相處。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在框架里保持灵活。你想要一张安全网，但不需要剧本。大多数人都觉得和你很好相处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在架構中保有彈性。你想要一張安全網，但不需要劇本。大多數人都覺得這樣很好相處。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyaguquguquka ngaphakathi kohlaka. Ufuna okuthile okukuvikelayo kodwa awudingi umbhalo. Abantu abaningi kulula ukusebenzisana nalokhu."
          }
        }
      }
    },
    "Flow state is your kind of weekend. Productive rest — doing something meaningful even when you don't have to — is your thing." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om in die vloei te wees is jou soort naweek. Produktiewe rus – iets betekenisvols doen selfs al hoef jy nie – is jou ding."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙሉ በሙሉ ተመስጦ መሥራት የእርስዎ የሳምንት መጨረሻ ነው። ፍሬያማ እረፍት — ባይገደዱም ትርጉም ያለው ነገር ማድረግ — የእርስዎ ነገር ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانغماس في العمل هو عطلتكم المثالية. الراحة المنتجة، أي فعل شيء ذي معنى حتى دون إلزام، هي ما يناسبكم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কামত মগ্ন হৈ থকাটোৱেই আপোনাৰ সপ্তাহান্ত। ফলপ্ৰসূ জিৰণি — নালাগিলেও কিবা অৰ্থপূৰ্ণ কাম কৰা — এয়াই আপোনাৰ ধৰণ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Axın halı sənin həftəsonu tərzindir. Məhsuldar istirahət — məcbur olmasan da mənalı bir iş görmək — məhz sənlikdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стан патоку — вось твае выхадныя. Прадуктыўны адпачынак, калі робіш нешта значнае, нават калі не абавязкова, — гэта пра цябе."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потокът е твоят тип уикенд. Продуктивната почивка – нещо смислено, дори когато не се налага – е твоето нещо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজে ডুবে থাকাই তোমার উইকেন্ড। কাজের মধ্যে বিশ্রাম — দরকার না থাকলেও অর্থবহ কিছু করা — এটাই তোমার ধরন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuna zaokupljenost je tvoj vikend. Produktivan odmor – raditi nešto smisleno i kad ne moraš – to je tvoja stvar."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'estat de flux és el teu tipus de cap de setmana. El descans productiu — fer alguna cosa amb sentit encara que no calgui — és el teu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj ideální víkend je ponořit se do něčeho naplno. Produktivní odpočinek – dělat něco smysluplného, i když nemusíš – to je tvoje."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymgolli mewn rhywbeth yw dy fath di o benwythnos. Gorffwys cynhyrchiol — gwneud rhywbeth ystyrlon hyd yn oed pan nad oes rhaid — dyna dy beth di."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow er din slags weekend. Produktiv hvile – at lave noget meningsfuldt, selvom du ikke behøver – er lige dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Flow zu sein ist dein Wochenende. Produktive Erholung – etwas Sinnvolles tun, auch wenn du nicht musst – ist genau dein Ding."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το να χάνεσαι σε κάτι είναι το δικό σου Σαββατοκύριακο. Η παραγωγική ξεκούραση — να κάνεις κάτι με νόημα ακόμα κι όταν δεν χρειάζεται — είναι το στοιχείο σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fin de semana ideal es entrar en estado de flujo. El descanso productivo —hacer algo con sentido aunque no tengas que hacerlo— es lo tuyo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voogu sattumine on sinu moodi nädalavahetus. Produktiivne puhkus — midagi tähendusrikast tehes ka siis, kui ei pea — on just sinu asi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerbaitetan murgilduta egotea da zure asteburua. Atseden emankorra — beharrik ez duzunean ere zerbait esanguratsua egitea — zure kontua da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غرق شدن در کار، آخر هفتهٔ دلخواه توست. استراحتِ پربار — انجام کاری معنادار حتی وقتی مجبور نیستی — دقیقاً سبک توست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow-tila on sinun viikonloppusi. Tuottava lepo – jonkin merkityksellisen tekeminen silloinkin, kun ei ole pakko – on sinun juttusi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow state ang uri mo ng weekend. Produktibong pahinga — paggawa ng makabuluhang bagay kahit hindi mo kailangan — iyan ang hilig mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être dans ta bulle, c'est ton week-end idéal. Un repos productif, faire quelque chose qui a du sens même sans obligation : c'est tout toi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é staid an tsrutha do chineál deireadh seachtaine. Scíth tháirgiúil — rud fiúntach a dhéanamh fiú nuair nach gá — sin é do rogha."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrarte en algo que che enche é a túa clase de fin de semana. Descanso produtivo: facer algo con sentido aínda que non teñas que facelo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કામમાં ખોવાઈ જવું એ તમારો વીકએન્ડ છે. ફળદાયી આરામ — કરવું ન પડે ત્યારે પણ કંઈક અર્થપૂર્ણ કરવું — એ તમારી ઓળખ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitsuwa cikin aiki ita ce irin ƙarshen makonku. Hutu mai amfani — yin wani abu mai ma'ana ko da ba dole ba ne — shi ne abinku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרימה היא סוף השבוע המושלם בשבילך. מנוחה פרודוקטיבית — לעשות משהו משמעותי גם כשלא חייבים — זה בדיוק הסגנון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी काम में डूब जाना ही आपका वीकेंड है। सुकून भरी मेहनत — ज़रूरत न होने पर भी कुछ सार्थक करना — यही आपको भाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuna zaokupljenost nečim tvoja je vrsta vikenda. Produktivan odmor – raditi nešto smisleno i kad ne moraš – to je tvoja stvar."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè ou plonje nan yon bagay, se wikenn ou. Yon repo pwodiktif — fè yon bagay ki gen sans menm lè ou pa oblije — se bagay pa ou."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neked az a jó hétvége, amikor belefeledkezel valamibe. Az aktív pihenés – valami értelmeset csinálni akkor is, ha nem muszáj – a te műfajod."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո տեսակի հանգստյան օրը տարվածության վիճակն է։ Արդյունավետ հանգիստը — իմաստալից բան անել, նույնիսկ երբ պարտավոր չես — հենց քոնն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenggelam dalam hal yang kamu pedulikan, itulah akhir pekan versimu. Istirahat yang produktif — melakukan hal bermakna meski nggak harus — itu kamu banget."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ịbanye n'ihe kpamkpam bụ ụdị ngwụcha izu gị. Izu ike na-amị mkpụrụ — ime ihe bara uru ọbụlagodi mgbe ọ dịghị mkpa — bụ ihe gị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flæði er þín tegund af helgi. Hvíld með tilgangi – að gera eitthvað merkingarbært þótt þú þurfir þess ekki – er alveg þitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo weekend ideale è immergerti in ciò che fai. Il riposo produttivo — fare qualcosa di significativo anche quando non devi — fa proprio per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢中になれることが最高の週末。やらなくてもいい、意味のあることに取り組む「生産的な休息」があなたのスタイルです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larut ing gaweyan iku akhir minggu gaya panjenengan. Ngaso sing produktif — nglakoni bab sing nduweni teges senajan ora kudu — iku panjenengan banget."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩართულობის მდგომარეობა შენი შაბათ-კვირაა. პროდუქტიული დასვენება — რამე მნიშვნელოვანის კეთება მაშინაც, როცა არ გევალება — სწორედ შენი სტილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ағынға ену — сенің демалысың. Өнімді демалыс — міндетті болмаса да мәнді бірдеңе істеу — саған жарасады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការផ្ចង់អារម្មណ៍ទាំងស្រុងលើអ្វីមួយ គឺជាចុងសប្ដាហ៍បែបអ្នក។ ការសម្រាកដែលមានផលិតភាព — ធ្វើអ្វីដែលមានន័យ ទោះមិនបាច់ធ្វើក៏ដោយ — គឺជាអ្វីដែលអ្នកចូលចិត្ត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತಲ್ಲೀನತೆಯೇ ನಿಮ್ಮ ವಾರಾಂತ್ಯ. ಮಾಡಲೇಬೇಕಿಲ್ಲದಿದ್ದರೂ ಅರ್ಥಪೂರ್ಣವಾದ ಏನನ್ನಾದರೂ ಮಾಡುವ ಫಲಪ್ರದ ವಿಶ್ರಾಂತಿ — ಅದೇ ನಿಮ್ಮ ಶೈಲಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몰입하는 시간이 나만의 주말이에요. 하지 않아도 되는 의미 있는 일을 하며 쉬는 생산적인 휴식이 딱 내 스타일이에요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawiya hefteya te ya bijare ew e ku tu di nav herikînê de bî. Bêhnvedana berhemdar — kirina tiştekî watedar dema ku ne mecbûr î jî — tiştê te ye."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ишке берилип кетүү — сенин дем алышың. Пайдалуу эс алуу — милдеттүү болбосо да маанилүү бир нерсе кылуу — сага жагат."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Flow ze sinn ass däi Weekend. Aktiv Erhuelung — eppes Sënnvolles maachen, och wann s du net muss — dat ass däint."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຈົມຢູ່ກັບສິ່ງທີ່ເຮັດຄືທ້າຍອາທິດແບບເຈົ້າ ການພັກຜ່ອນແບບມີຜົນງານ — ເຮັດສິ່ງທີ່ມີຄວາມໝາຍ ເຖິງບໍ່ຈຳເປັນຕ້ອງເຮັດ — ຄືແບບຂອງເຈົ້າ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įsitraukimo būsena – tavo savaitgalis. Produktyvus poilsis – daryti ką nors prasmingo, net kai nebūtina, – tai tavo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plūsmas stāvoklis – tā ir tava nedēļas nogale. Produktīva atpūta – darīt ko jēgpilnu pat tad, kad nav jādara, – tas ir tavējais."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fifantohana feno amin'ny zavatra iray no faran'ny herinandro aminao. Fialan-tsasatra mamokatra — manao zavatra misy dikany na dia tsy voatery aza — no tianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te rere o te mahi tō momo mutunga wiki. He okiokinga whai hua — te mahi i tētahi mea whai tikanga ahakoa kāore e tika ana — koinā tāu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состојбата на целосна вдлабоченост е твојот тип викенд. Продуктивен одмор — да правиш нешто значајно и кога не мораш — е твое нешто."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എല്ലാം മറന്ന് മുഴുകുന്നതാണ് നിങ്ങളുടെ വീക്കെൻഡ്. ഫലപ്രദമായ വിശ്രമം — നിർബന്ധമില്ലാത്തപ്പോഴും അർഥവത്തായ എന്തെങ്കിലും ചെയ്യുന്നത് — അതാണ് നിങ്ങളുടെ ശൈലി."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Урсгалд орох нь чиний амралт. Үр бүтээлтэй амралт — заавал биш ч утга учиртай зүйл хийх — чиний л хэв маяг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कामात रंगून जाणे हाच तुमचा वीकेंड. गरज नसतानाही काहीतरी अर्थपूर्ण करत केलेली विश्रांती — हीच तुमची खासियत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asyik melakukan sesuatu ialah hujung minggu ideal anda. Rehat yang produktif — melakukan sesuatu yang bermakna walaupun tidak perlu — memang gaya anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-flow huwa t-tip ta' weekend tiegħek. Mistrieħ produttiv — tagħmel xi ħaġa li tfisser xi ħaġa anke meta m'għandekx għalfejn — dak hu tiegħek."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စိတ်နစ်မြုပ်ပြီး လုပ်ရတာက သင့်ရဲ့ ပိတ်ရက်ပုံစံပါ။ အကျိုးရှိတဲ့ အနားယူမှု — မလုပ်မနေရ မဟုတ်ပေမဲ့ အဓိပ္ပာယ်ရှိတာ တစ်ခုခု လုပ်တာ — ဒါ သင့်ပုံစံပဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt er din type helg. Produktiv hvile – å gjøre noe meningsfullt selv når du ikke må – er din greie."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काममा डुब्नु नै तपाईंको खालको सप्ताहान्त हो। उत्पादक आराम — गर्नै नपर्दा पनि केही अर्थपूर्ण गर्नु — तपाईंको रुचि हो।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een flow raken is jouw soort weekend. Productief rusten – iets zinvols doen, ook als het niet hoeft – is helemaal jouw ding."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumizidwa mu ntchito ndiwo mtundu wanu wa kumapeto kwa sabata. Kupuma kopindulitsa — kuchita chinthu chatanthauzo ngakhale simukukakamizidwa — ndi zanu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hojii keessa dhabamuun dhuma torbanii kee ti. Boqonnaa bu'a qabeessa — waan hiika qabu gochuu, dirqama ta'uu baatus — kun kan kee ti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମଗ୍ନ ହୋଇ କାମ କରିବା ହିଁ ଆପଣଙ୍କ ସପ୍ତାହାନ୍ତ। ଉତ୍ପାଦନଶୀଳ ବିଶ୍ରାମ — ଦରକାର ନ ଥିଲେ ବି କିଛି ଅର୍ଥପୂର୍ଣ୍ଣ କରିବା — ଆପଣଙ୍କ ପସନ୍ଦ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਿਸੇ ਕੰਮ ਵਿੱਚ ਪੂਰੀ ਤਰ੍ਹਾਂ ਖੁੱਭ ਜਾਣਾ ਹੀ ਤੁਹਾਡਾ ਵੀਕਐਂਡ ਹੈ। ਕੰਮ ਵਾਲਾ ਆਰਾਮ — ਲੋੜ ਨਾ ਹੋਣ ਉੱਤੇ ਵੀ ਕੁਝ ਮਾਇਨੇ ਭਰਿਆ ਕਰਨਾ — ਤੁਹਾਡੀ ਪਸੰਦ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan flow to twój sposób na weekend. Produktywny odpoczynek – robienie czegoś ważnego, nawet gdy nie musisz – to coś dla ciebie."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "په یو کار کې ډوبېدل ستاسو د رخصتۍ ډول دی. ګټوره دمه — یو با معنا کار کول، حتی کله چې اړتیا نه وي — ستاسو خوښه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar no fluxo é seu tipo de fim de semana. Descanso produtivo — fazer algo significativo mesmo sem precisar — é a sua cara."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado de fluxo é o teu tipo de fim de semana. Descanso produtivo — fazer algo com significado mesmo sem ser preciso — é a tua cena."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să te cufunzi complet într-o activitate — asta e weekendul tău ideal. Odihna productivă — să faci ceva care contează chiar dacă nu trebuie — e stilul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои идеальные выходные — в потоке. Продуктивный отдых, когда делаешь что-то значимое, даже если это необязательно, — это про тебя."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwibira mu gikorwa ukunda ni bwo buryo bwawe bw'impera z'icyumweru. Ikiruhuko gitanga umusaruro — gukora ikintu gifite agaciro n'iyo bitari ngombwa — ni byo bikubereye."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "යමක ගිලී වැඩ කරන එක තමයි ඔබේ සති අන්තය. ඵලදායී විවේකය — කරන්නම ඕනේ නැති වෙලාවෙත් අර්ථවත් දෙයක් කරන එක — ඔබේ විදිහයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav plynutia je tvoj typ víkendu. Produktívny oddych – robiť niečo zmysluplné, aj keď nemusíš – to je presne pre teba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatopljenost v delo je tvoj vikend. Produktiven počitek – nekaj smiselnega, tudi ko ni treba – je tvoja stvar."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunyura mubasa raunoda ndiko kuzorora kwako kwemugovera nesvondo. Kuzorora uchibereka — kuita chimwe chinhu chine revo kunyange usingamanikidzwe — ndizvo zvaunoda."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku milmidda shaqo aad jeceshahay ayaa ah dhammaad-toddobaadkaaga. Nasasho wax soo saar leh — samaynta wax macno leh xitaa marka aan lagu qasbin — waa waxaaga."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhytja e plotë në diçka është fundjava jote. Pushimi produktiv – të bësh diçka me kuptim edhe kur s’ka nevojë – është stili yt."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стање потпуне задубљености је твој тип викенда. Продуктиван одмор — нешто смислено чак и кад не мораш — то је твоје."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teuleum dina hiji pagawéan téh sabtu-minggu ala anjeun. Istirahat anu produktif — ngalakukeun hal anu bermakna sanajan teu kedah — éta pisan anjeun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow är din sorts helg. Produktiv vila – att göra något meningsfullt även när du inte måste – är din grej."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuzama katika jambo ndiyo aina yako ya wikendi. Mapumziko yenye tija — kufanya kitu chenye maana hata usipolazimika — ndiyo staili yako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழு ஈடுபாட்டில் மூழ்குவதுதான் உங்கள் வார இறுதி. கட்டாயம் இல்லாதபோதும் அர்த்தமுள்ள ஒன்றைச் செய்யும் பயனுள்ள ஓய்வுதான் உங்கள் பாணி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పనిలో లీనమవడమే మీ వీకెండ్. చేయాల్సిన అవసరం లేకపోయినా అర్థవంతమైనదేదో చేయడం — అదే మీ విశ్రాంతి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ғарқ шудан дар кори дӯстдошта — ин истироҳати туст. Истироҳати пурсамар — кори пурмаъно кардан ҳатто вақте маҷбур нестӣ — ин хоси туст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจดจ่อจนลืมเวลาคือสุดสัปดาห์ในแบบของคุณ การพักผ่อนอย่างมีคุณค่า ได้ทำสิ่งที่มีความหมายแม้ไม่จำเป็นต้องทำ คือสิ่งที่ใช่สำหรับคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምሉእ ተመስጦ ናትኩም ዓይነት ቀዳመ-ሰንበት እዩ። ፍርያም ዕረፍቲ — ከይተገደድኩም ትርጉም ዘለዎ ነገር ምግባር — እዚ እዩ ናትኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Işe gümra bolmak — seniň dynç günüň şeýle. Hökman bolmasa-da manyly bir zat etmek — seniň üçin peýdaly dynç alyş."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akışta olmak senin hafta sonu tarzın. Üretken dinlenme, yani zorunda olmasan da anlamlı bir şey yapmak, tam sana göre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стан потоку — твій ідеальний вікенд. Продуктивний відпочинок — займатися чимось значущим, навіть коли не мусиш, — це про тебе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی کام میں کھو جانا ہی آپ کا ویک اینڈ ہے۔ بامقصد آرام — ضرورت نہ ہو تب بھی کچھ بامعنی کرنا — یہی آپ کا انداز ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishga berilib ketish — sizning dam olishingiz. Unumli hordiq — shart boʻlmasa ham maʼnoli ish qilish — aynan sizga mos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đắm mình vào việc mình thích chính là kiểu cuối tuần của bạn. Nghỉ ngơi một cách hiệu quả — làm điều ý nghĩa dù chẳng ai bắt — là phong cách của bạn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuntywila kwinto oyithandayo luhlobo lwakho lwempelaveki. Ukuphumla ngemveliso — ukwenza into enentsingiselo nokuba akunyanzelekanga — yinto yakho leyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kíkó ọkàn sínú iṣẹ́ ni irú òpin ọ̀sẹ̀ yín. Ìsinmi oníṣẹ́ — ṣíṣe nǹkan tó ní ìtumọ̀ kódà nígbà tí kò pọn dandan — ni tiyín."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全情投入就是你的週末。有生產力的休息，在不必做的時候做點有意義的事，就是你的風格。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全情投入就是你理想的周末。高效的休息——哪怕没人要求，也去做点有意义的事——才是你的风格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全心投入就是你的週末。有生產力的休息，在不必做的時候做點有意義的事，就是你的風格。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukugxila ngokuphelele kuwuhlobo lwakho lwempelasonto. Ukuphumula okunomkhiqizo — ukwenza okuthile okunomqondo ngisho noma ungaphoqelekile — yinto yakho."
          }
        }
      }
    },
    "Following a specific diet for health or fitness goals" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek volg ’n spesifieke dieet vir gesondheid of fiksheid"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለጤና ወይም ለአካል ብቃት ግቦች የተለየ አመጋገብ መከተል"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظام غذائي محدد لأهداف صحية أو رياضية"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাস্থ্য বা সুস্থতাৰ লক্ষ্যৰ বাবে নিৰ্দিষ্ট আহাৰ-তালিকা মানি চলোঁ"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlamlıq və ya idman hədəfləri üçün xüsusi pəhriz saxlayıram"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пэўная дыета дзеля здароўя ці спартыўных мэт"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Специален режим заради здраве или спорт"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাস্থ্য বা ফিটনেসের জন্য নির্দিষ্ট ডায়েট মেনে চলি"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratim posebnu ishranu zbog zdravlja ili forme"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dieta concreta per salut o per objectius esportius"
          }
