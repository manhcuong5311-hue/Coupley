        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bầu trời nơi bạn đang ở."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isibhakabhaka apho ukhoyo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ojú ọ̀run níbi tí ẹ wà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你那邊的天空。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你那边的天空。"
