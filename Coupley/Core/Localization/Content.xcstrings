    "Gratitude said out loud reshapes the room." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الامتنان المنطوق يغيّر أجواء المكان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vděčnost vyslovená nahlas promění atmosféru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taknemmelighed sagt højt ændrer stemningen i rummet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut ausgesprochene Dankbarkeit verändert die Stimmung im Raum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ευγνωμοσύνη που λέγεται φωναχτά αλλάζει την ατμόσφαιρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitud dicha en voz alta transforma el ambiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ääneen sanottu kiitollisuus muuttaa koko tunnelman."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag isinatinig mo ang pasasalamat, nagbabago ang buong paligid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitude dite à voix haute change l'atmosphère."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכרת תודה שנאמרת בקול משנה את האווירה בחדר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुलकर कहा गया शुक्रिया पूरा माहौल बदल देता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangosan kimondott hála megváltoztatja a légkört."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa syukur yang diucapkan mengubah suasana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitudine detta ad alta voce cambia l’atmosfera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感謝を声に出すと、その場の空気が変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리 내어 말한 감사는 분위기를 바꿔요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasa syukur yang diluahkan mengubah suasana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takknemlighet sagt høyt forandrer stemningen i rommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardop uitgesproken dankbaarheid verandert de sfeer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wdzięczność wypowiedziana na głos zmienia atmosferę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratidão dita em voz alta muda o clima."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recunoștința spusă cu voce tare schimbă atmosfera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодарность, сказанная вслух, меняет атмосферу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
