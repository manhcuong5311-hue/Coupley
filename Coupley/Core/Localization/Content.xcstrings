    "Honest self-awareness. You admire spontaneity but practically function better with lead time." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlike selfkennis. Jy bewonder spontaniteit, maar funksioneer prakties beter met ’n bietjie voorsprong."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቅን ራስን ማወቅ። ድንገተኛነትን ያደንቃሉ፣ በተግባር ግን ቀድሞ ሲነገርዎ የተሻለ ይሠራሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وعي صادق بالذات. تُعجبكم العفوية، لكنكم عمليًا تعملون أفضل حين يتوفر وقت للاستعداد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৎ আত্মসচেতনতা। আপুনি স্বতঃস্ফূৰ্ততাক প্ৰশংসা কৰে, কিন্তু বাস্তৱত আগতীয়া সময় পালেহে ভালকৈ চলিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səmimi özünüdərk. Spontanlığa heyransan, amma praktikada əvvəlcədən xəbərdar olanda daha yaxşı işləyirsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шчырае разуменне сябе. Спантаннасць табе падабаецца, але на справе табе лепш, калі ёсць час падрыхтавацца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честно самопознание. Възхищаваш се на спонтанността, но на практика се справяш по-добре, когато знаеш отрано."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিজেকে সৎভাবে চেনো। হুটহাট ব্যাপারটা তোমার ভালো লাগে, কিন্তু বাস্তবে আগে থেকে সময় পেলেই তুমি ভালো চলো।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskrena samosvijest. Diviš se spontanosti, ali u praksi bolje funkcionišeš kad znaš unaprijed."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoconeixement sincer. Admires l'espontaneïtat, però a la pràctica funciones millor amb temps per preparar-te."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřímné sebepoznání. Spontánnost obdivuješ, ale v praxi ti líp funguje, když víš věci dopředu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunanymwybyddiaeth onest. Rwyt ti'n edmygu bod yn ddigymell, ond yn ymarferol rwyt ti'n gweithio'n well gydag amser i baratoi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ærlig selvindsigt. Du beundrer spontanitet, men fungerer i praksis bedre med lidt tid til at forberede dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehrliche Selbsterkenntnis. Du bewunderst Spontaneität, funktionierst aber mit etwas Vorlauf einfach besser."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειλικρινής αυτογνωσία. Θαυμάζεις τον αυθορμητισμό, αλλά στην πράξη λειτουργείς καλύτερα όταν το ξέρεις από πριν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoconocimiento sincero. Admiras la espontaneidad, pero en la práctica funcionas mejor con tiempo de antelación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus eneseteadlikkus. Imetled spontaansust, aga praktikas toimid paremini, kui aega on ette."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norbere buruaren ezagutza zintzoa. Bat-batekotasuna miresten duzu, baina praktikan hobeto zabiltza aurrez abisatuta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودآگاهی صادقانه. خودجوشی را تحسین می‌کنی ولی در عمل وقتی از قبل خبر داری بهتر عمل می‌کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehellistä itsetuntemusta. Ihailet spontaaniutta, mutta käytännössä toimit paremmin, kun saat aikaa valmistautua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapat na pagkakilala sa sarili. Hinahangaan mo ang pagiging spontaneous pero mas gumagana ka kapag may sapat na abiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une belle lucidité. Tu admires la spontanéité, mais en pratique tu fonctionnes mieux quand on te prévient."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Féinfheasacht ionraic. Tá meas agat ar an spontáineacht ach is fearr a fheidhmíonn tú go praiticiúil nuair a bhíonn fógra agat."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coñécesche e dilo con sinceridade. Admiras a espontaneidade, pero na práctica funcionas mellor con tempo de marxe."
