    "Give them space but leave a door open: 'here when you want me.'" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gee jou maat ruimte, maar laat ’n deur oop: “Ek is hier as jy my wil hê.”"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቦታ ይስጧቸው፣ ግን በሩን ክፍት ይተዉ፦ «ሲፈልጉኝ እዚህ ነኝ።»"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنحوا شريكك مساحة واتركوا الباب مفتوحًا: «أنا هنا متى احتجتني»."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তেওঁক ঠাই দিয়ক, কিন্তু দুৱাৰখন খোলা ৰাখক: “মোক বিচাৰিলে মই ইয়াতে আছোঁ।”"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona yer ver, amma qapını açıq saxla: “İstəsən, buradayam.”"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай прастору, але пакінь дзверы адчыненымі: «я побач, калі захочаш»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай ѝ пространство, но остави вратата отворена: „Тук съм, когато ме потърсиш.“"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওকে নিজের মতো থাকতে দাও, কিন্তু দরজা খোলা রাখো: “যখন চাইবে, আমি আছি।”"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj prostor, ali ostavi otvorena vrata: „Tu sam kad me zatrebaš.”"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dona-li espai, però deixa la porta oberta: «aquí em tens quan vulguis»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej protějšku prostor, ale nech otevřené dveře: „Jsem tu, až budeš chtít.“"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rho le i dy bartner ond gad y drws ar agor: ‘dw i yma pan fyddi di eisiau.’"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv plads, men lad døren stå på klem: »Jeg er her, når du vil.«"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Raum, aber halte die Tür offen: „Ich bin da, wenn du mich brauchst.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε χώρο, αλλά άφησε μια πόρτα ανοιχτή: «Είμαι εδώ όποτε με θέλεις.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale espacio, pero deja la puerta abierta: “Aquí estoy cuando me necesites”."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna talle ruumi, aga jäta uks lahti: „Olen siin, kui mind vajad.“"
