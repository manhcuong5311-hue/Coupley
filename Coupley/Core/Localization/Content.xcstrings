        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карьера — это средство: она оплачивает жизнь, которую я хочу"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriären är ett medel – den finansierar livet jag vill ha"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาชีพเป็นแค่ทางผ่าน หาเงินมาใช้ชีวิตที่อยากได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariyer bir araç, istediğim hayatı finanse ediyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар’єра — лише засіб для життя, якого я хочу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự nghiệp là phương tiện — nó nuôi cuộc sống mình muốn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事业只是手段，为了过上想要的生活"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作是手段，用來支撐我想要的生活"
