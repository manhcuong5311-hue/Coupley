        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوره انرژي، پوره غږ. ښايي له وتلو په پرتله په ښه مزاج ورسېږئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
