        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruke koje ništa ne traže ne troše praznu bateriju."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon siy ki pa mande anyen pa fatige yon batri ki fin bout."
