        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह न पूछें कि क्या हुआ। बस कुछ ले आएँ — पानी, खाना, एक कंबल।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pitaj što nije u redu. Samo donesi nešto – vodu, hranu, deku."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa mande l sa k genyen. Jis pote yon bagay — dlo, manje, yon lenn."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kérdezd, mi a baj. Csak vigyél neki valamit – vizet, ennivalót, egy takarót."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի՛ հարցրու, թե ինչ է պատահել։ Պարզապես ինչ-որ բան բեր՝ ջուր, ուտելիք, վերմակ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan tanya ada apa. Bawakan saja sesuatu — air, makanan, selimut."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajụla ihe mere. Naanị weta ihe — mmiri, nri, blanket."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki spyrja hvað sé að. Komdu bara með eitthvað – vatn, mat, teppi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiedere cosa c’è che non va. Porta qualcosa e basta — acqua, cibo, una coperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「どうしたの？」とは聞かずに、水や食べもの、ブランケットなど何かを持っていきましょう。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aja takon ana apa. Gawakna wae apa-apa — banyu, panganan, kemul."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნუ ჰკითხავ, რა მოხდა. უბრალოდ მიუტანე რამე — წყალი, საჭმელი, პლედი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не болғанын сұрама. Жай бір нәрсе әкеле сал: су, тамақ, жамылғы."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កុំសួរថាមានរឿងអ្វី។ គ្រាន់តែយកអ្វីមួយមកឲ្យ — ទឹក អាហារ ឬភួយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಏನಾಯಿತು ಎಂದು ಕೇಳಬೇಡಿ. ಸುಮ್ಮನೆ ಏನಾದರೂ ತನ್ನಿ — ನೀರು, ಊಟ, ಒಂದು ಹೊದಿಕೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무슨 일이냐고 묻지 말고, 물이나 먹을 것, 담요 같은 걸 그냥 가져다주세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepirse ka çi bûye. Tenê tiştekî bîne — av, xwarin, betaniyek."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмне болду деп сураба. Жөн гана бир нерсе алып кел — суу, тамак, жууркан."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fro net, wat lass ass. Bréng einfach eppes — Waasser, eppes z'iessen, eng Decken."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບໍ່ຕ້ອງຖາມວ່າເປັນຫຍັງ ພຽງແຕ່ເອົາບາງຢ່າງມາໃຫ້ — ນ້ຳ ອາຫານ ຜ້າຫົ່ມ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neklausk, kas negerai. Tiesiog atnešk ką nors – vandens, užkandžių, pledą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejautā, kas noticis. Vienkārši atnes kaut ko – ūdeni, ēdienu, segu."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aza anontaniana hoe inona no tsy mety. Mitondrà zavatra fotsiny — rano, sakafo, bodofotsy."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaua e pātai he aha te raru. Kawea noa mai tētahi mea — he wai, he kai, he paraikete."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не прашувај што не е во ред. Само донеси нешто — вода, храна, ќебе."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എന്തുപറ്റി എന്ന് ചോദിക്കേണ്ട. എന്തെങ്കിലും കൊണ്ടുവന്ന് കൊടുക്കൂ — വെള്ളം, ഭക്ഷണം, ഒരു പുതപ്പ്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Юу болсныг бүү асуу. Зүгээр л ус, хоол, хөнжил гэх мэт юм авчраарай."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काय झाले असे विचारू नका. फक्त काहीतरी घेऊन या — पाणी, खाणे, एखादे पांघरूण."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan tanya apa yang tak kena. Bawakan saja sesuatu — air, makanan, selimut."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tistaqsix x'ġara. Sempliċement ġib xi ħaġa — ilma, ikel, kutra."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘာဖြစ်လဲလို့ မမေးပါနဲ့။ တစ်ခုခု ယူလာပေးလိုက်ပါ — ရေ၊ အစားအစာ၊ စောင်တစ်ထည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke spør hva som er galt. Bare kom med noe – vann, mat, et pledd."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "के भयो भनेर नसोध्नुहोस्। बस केही ल्याइदिनुहोस् — पानी, खाना, कम्बल।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag niet wat er is. Breng gewoon iets – water, eten, een dekentje."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musafunse kuti chavuta nchiyani. Ingobweretsani kanthu — madzi, chakudya, bulangeti."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaltu ta'e hin gaafatin. Waan tokko qofa fidi — bishaan, nyaata, uffata ho'aa."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କ’ଣ ହେଲା ପଚାରନ୍ତୁ ନାହିଁ। କେବଳ କିଛି ନେଇଆସନ୍ତୁ — ପାଣି, ଖାଇବା, ଗୋଟିଏ କମ୍ବଳ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਨਾ ਪੁੱਛੋ ਕਿ ਕੀ ਹੋਇਆ। ਬੱਸ ਕੁਝ ਲੈ ਆਓ — ਪਾਣੀ, ਖਾਣਾ, ਇੱਕ ਕੰਬਲ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pytaj, co się stało. Po prostu coś przynieś – wodę, jedzenie, koc."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مه پوښتئ چې څه شوي. یوازې یو څه ورته راوړئ — اوبه، خواړه، یوه کمپله."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pergunte o que houve. Só leve algo — água, comida, uma manta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não perguntes o que se passa. Leva só alguma coisa — água, comida, uma manta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu întreba ce s-a întâmplat. Doar adu ceva — apă, mâncare, o pătură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не спрашивай, что случилось. Просто принеси что-нибудь — воду, еду, плед."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntubaze ikibazo gihari. Zana ikintu gusa — amazi, ibiryo, uburingiti."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මොකද වුණේ කියලා අහන්න එපා. මොනවහරි අරන් එන්න විතරයි — වතුර, කෑම, බ්ලැන්කට් එකක්."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepýtaj sa, čo sa deje. Proste niečo prines – vodu, jedlo, deku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne sprašuj, kaj je narobe. Samo prinesi nekaj – vodo, hrano, odejo."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usabvunza kuti chii chakaipa. Ingounza chimwe chinhu — mvura, chikafu, gumbeze."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha weydiin waxa dhacay. Uun wax u keen — biyo, cunto, buste."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mos pyet çfarë nuk shkon. Thjesht sill diçka – ujë, ushqim, një batanije."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не питај шта није у реду. Само донеси нешто — воду, храну, ћебе."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulah naros aya naon. Cekap bawakeun hiji hal: cai, tuangeun, simbut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga inte vad som är fel. Kom bara med något – vatten, mat, en filt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiulize kuna nini. Mletee tu kitu — maji, chakula, blanketi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என்ன ஆச்சு என்று கேட்காதீர்கள். ஏதாவது கொண்டு வாருங்கள் — தண்ணீர், உணவு, ஒரு போர்வை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఏమైందని అడగకండి. ఏదైనా తీసుకెళ్లండి — నీళ్లు, తిండి, ఒక దుప్పటి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напурс, ки чӣ шуд. Танҳо чизе биёр — об, хӯрок, кампал."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องถามว่าเป็นอะไร แค่หยิบอะไรไปให้ เช่น น้ำ ของกิน หรือผ้าห่ม"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንታይ ኮይኑ ኢልኩም ኣይትሕተቱ። ገለ ነገር ጥራይ ኣምጽኡ — ማይ፣ መግቢ፣ ኮበርታ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näme boldy diýip soraşdyrma. Diňe bir zat getir — suw, iýmit, ýorgan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin var diye sorma. Sadece bir şey getir: su, yemek, bir battaniye."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не питай, що сталося. Просто принеси щось — воду, їжу, плед."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ نہ پوچھیں کہ کیا ہوا۔ بس کچھ لے آئیں: پانی، کھانا، کمبل۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nima boʻldi, deb soʻramang. Shunchaki biror narsa olib keling — suv, ovqat, adyol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng hỏi có chuyện gì. Cứ mang đến cho người ấy một thứ gì đó — nước, đồ ăn, một tấm chăn."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukubuza ukuba kwenzeke ntoni. Yiza nje nento — amanzi, ukutya, ingubo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ má béèrè ohun tó ṣẹlẹ̀. Ẹ kàn mú nǹkan wá — omi, oúnjẹ, aṣọ ìbora."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要問發生甚麼事，直接帶點東西過去——一杯水、一點食物、一張毯子。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别问怎么了，直接带点东西过去：一杯水、一点吃的、一条毯子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別問怎麼了，直接帶點東西過去：水、食物、一條毯子。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungabuzi ukuthi yini engalungile. Vele umlethele okuthile — amanzi, ukudla, ingubo."
          }
        }
      }
    },
