          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณชอบสัตว์ แต่ยังไม่อยากผูกมัดเต็มตัวตอนนี้ ซึ่งอาจเปลี่ยนไปก็ได้ หรืออาจไม่เปลี่ยน"
