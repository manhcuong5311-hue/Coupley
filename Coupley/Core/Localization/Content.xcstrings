        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorizas a independência financeira. Funciona bem com acordos claros sobre como gerir as despesas partilhadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețuiești independența financiară. Merge bine cu înțelegeri clare despre cum se împart cheltuielile comune."
