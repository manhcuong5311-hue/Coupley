        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymarferol. Mae dy fywyd go iawn yn digwydd y tu allan i'r gwaith. Mae'r swydd yn gwasanaethu'r weledigaeth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatisk. Dit egentlige liv foregår uden for arbejdet. Jobbet tjener visionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pragmatisch. Dein echtes Leben findet außerhalb der Arbeit statt. Der Job dient dem Leben, das du dir vorstellst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πραγματισμός. Η πραγματική σου ζωή συμβαίνει έξω από τη δουλειά. Η δουλειά υπηρετεί το όραμα."
