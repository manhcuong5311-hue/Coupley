        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल आपको पता है, पर उस पर अमल नहीं होता। जल्दी सोने की आदत वाले पार्टनर से सच में मदद मिल सकती है — या झुंझलाहट भी हो सकती है।"
