        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flaithiúil le heispéiris — is le haghaidh maireachtála an t-airgead"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastar en experiencias: os cartos son para vivir"
