        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omimi karịa njem nlegharị anya. Ị chọrọ ịghọta ebe, ọ bụghị naanị ịse ya foto."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dýpt frekar en túrismi. Þú vilt skilja staðinn, ekki bara taka myndir af honum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondità più che turismo. Vuoi capire un luogo, non solo fotografarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "観光より深さ。写真を撮るだけでなく、その土地を理解したいタイプです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jero luwih saka wisata. Panjenengan pengin ngerti sawijining panggonan, ora mung motret."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიღრმე ტურიზმზე მეტია. გინდა, ადგილი გაიგო და არა უბრალოდ გადაიღო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туризмнен гөрі тереңдік. Жерді жай суретке түсіріп қана қоймай, түсінгің келеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភាពស៊ីជម្រៅលើសការធ្វើទេសចរណ៍។ អ្នកចង់យល់ពីកន្លែងមួយ មិនមែនគ្រាន់តែថតរូបវាទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರವಾಸೋದ್ಯಮಕ್ಕಿಂತ ಆಳ. ಸ್ಥಳವನ್ನು ಫೋಟೋ ತೆಗೆಯುವುದಷ್ಟೇ ಅಲ್ಲ, ಅದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಬೇಕು ನಿಮಗೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관광보다 깊이예요. 사진만 찍기보다 그곳을 이해하고 싶어 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kûrahî ji tûrîzmê girîngtir e. Tu dixwazî cihekî fêm bikî, ne tenê wêneyê wî bikişînî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туризмден көрө тереңдик. Жерди жөн эле сүрөткө тартпай, түшүнгүң келет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déift virun Tourismus. Du wëlls eng Plaz verstoen, net se just fotograféieren."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄວາມເລິກສຳຄັນກວ່າການທ່ອງທ່ຽວ ເຈົ້າຢາກເຂົ້າໃຈສະຖານທີ່ ບໍ່ແມ່ນແຄ່ຖ່າຍຮູບມັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gylis svarbiau už turizmą. Nori vietą suprasti, o ne tik ją nufotografuoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziļums pār tūrismu. Tu gribi vietu saprast, ne tikai nofotografēt."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halalina toy izay fizahantany. Te hahatakatra ny toerana iray ianao, fa tsy haka sary azy fotsiny."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te hōhonu i mua i te tūruhi. E hiahia ana koe kia mārama ki tētahi wāhi, kaua kia whakaahuatia noa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длабочина наместо туризам. Сакаш да го разбереш местото, не само да го фотографираш."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ടൂറിസത്തെക്കാൾ ആഴം. ഒരിടം ഫോട്ടോയെടുക്കുക മാത്രമല്ല, അത് മനസ്സിലാക്കാനാണ് നിങ്ങൾ ആഗ്രഹിക്കുന്നത്."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жуулчлалаас илүү гүн. Чи газрыг зүгээр зураг авах биш, ойлгохыг хүсдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्यटनापेक्षा खोली. तुम्हाला ठिकाण फक्त फोटोत टिपायचे नाही, तर समजून घ्यायचे असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyelami, bukan sekadar melancong. Anda mahu memahami sesuatu tempat, bukan sekadar mengambil gambarnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-profondità qabel it-turiżmu. Trid tifhem post, mhux sempliċiment tieħu ritratt tiegħu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခရီးသွားဟန်ထက် နက်ရှိုင်းမှု။ နေရာတစ်ခုကို ဓာတ်ပုံရိုက်ရုံ မဟုတ်ဘဲ နားလည်ချင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dybde framfor turisme. Du vil forstå et sted, ikke bare ta bilder av det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्यटनभन्दा गहिराइ। तपाईं कुनै ठाउँको फोटो मात्र होइन, त्यसलाई बुझ्न चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diepgang boven toerisme. Je wilt een plek begrijpen, niet alleen fotograferen."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuzama kuposa kungoyendera. Mumafuna kumvetsa malo, osati kungowajambula."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turizimii caalaa gadi fagoo. Bakka tokko hubachuu barbaadda, suuraa kaasuu qofa miti."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପର୍ଯ୍ୟଟନଠୁ ଗଭୀରତା ବଡ଼। ଆପଣ ଏକ ଜାଗାକୁ କେବଳ ଫଟୋ ଉଠାଇବାକୁ ନୁହେଁ, ବୁଝିବାକୁ ଚାହାଁନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੈਰ-ਸਪਾਟੇ ਨਾਲੋਂ ਡੂੰਘਾਈ। ਤੁਸੀਂ ਕਿਸੇ ਥਾਂ ਨੂੰ ਸਿਰਫ਼ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਨਹੀਂ ਕੈਦ ਕਰਨਾ, ਸਮਝਣਾ ਚਾਹੁੰਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębia ponad turystykę. Chcesz zrozumieć miejsce, a nie tylko je sfotografować."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ژوروالی له ګرځندویۍ غوره. تاسو غواړئ یو ځای وپېژنئ، نه یوازې انځور یې واخلئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade mais que turismo. Você quer entender um lugar, não só tirar fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade acima de turismo. Queres perceber um lugar, não só fotografá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profunzime, nu turism. Vrei să înțelegi un loc, nu doar să-l fotografiezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубина важнее туризма. Тебе хочется понять место, а не только его сфотографировать."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubwimbitse buruta ubukerarugendo. Ushaka gusobanukirwa ahantu, atari ukuhafotora gusa."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සංචාරයට වඩා ගැඹුර. ඔබට ඕනේ තැනක් තේරුම් ගන්න, ඡායාරූප ගන්න විතරක් නෙවෙයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hĺbka namiesto turizmu. Miesto chceš pochopiť, nielen odfotiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globina pred turizmom. Kraj želiš razumeti, ne le fotografirati."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kudzama pane kungoshanya. Unoda kunzwisisa nzvimbo, kwete kungoitora mifananidzo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoto-dheeri, ma aha dalxiis. Waxaad rabtaa inaad meel fahanto, ma aha inaad sawir uun ka qaado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thellësia mbi turizmin. Do ta kuptosh një vend, jo vetëm ta fotografosh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дубина пре туризма. Желиш да разумеш неко место, а не само да га фотографишеш."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kajeroan langkung ti wisata. Anjeun hoyong ngartos hiji tempat, sanés ngan saukur motrétna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djup före turism. Du vill förstå en plats, inte bara fotografera den."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kina kuliko utalii. Unataka kuielewa sehemu, si kuipiga picha tu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சுற்றுலாவை விட ஆழம். ஒரு இடத்தைப் புகைப்படம் எடுப்பது மட்டுமல்ல, அதைப் புரிந்துகொள்ள விரும்புகிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పర్యాటకం కంటే లోతు. ఒక ప్రదేశాన్ని ఫోటో తీయడం మాత్రమే కాదు, అర్థం చేసుకోవాలని మీకు ఉంటుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амиқӣ аз сайёҳӣ болотар. Ту мехоҳӣ ҷойро бифаҳмӣ, на танҳо аксашро гирӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความลึกซึ้งสำคัญกว่าการท่องเที่ยว คุณอยากเข้าใจสถานที่ ไม่ใช่แค่ถ่ายรูปเก็บไว้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ቱሪዝም ዕምቆት። ንሓደ ቦታ ክትርድእዎ ትደልዩ እምበር ስእሊ ጥራይ ክተልዕሉሉ ኣይኮነን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syýahatçylykdan çuňluk öňde. Sen bir ýeri diňe surata düşürmek däl, oňa düşünmek isleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turistlikten çok derinlik. Bir yerin sadece fotoğrafını çekmek değil, onu anlamak istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибина замість туризму. Тобі хочеться зрозуміти місце, а не просто його сфотографувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیاحت سے زیادہ گہرائی۔ آپ کے لیے کسی جگہ کو سمجھنا اہم ہے، صرف اس کی تصویر لینا نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turizmdan koʻra chuqurlik. Siz bir joyni shunchaki suratga olishni emas, tushunishni xohlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều sâu hơn tham quan. Bạn muốn hiểu một nơi, không chỉ chụp ảnh nó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubunzulu kunokhenketho. Ufuna ukuyiqonda indawo, hayi nje ukuyifota."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jíjinlẹ̀ ju ìrìnkiri lọ. Ẹ fẹ́ lóye ibì kan, kì í ṣe kí ẹ kàn ya fọ́tò rẹ̀."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度勝過觀光。你想了解一個地方，而不只是拍下它。"
