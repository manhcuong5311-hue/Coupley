        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E vlerëson pavarësinë financiare. Kjo funksionon mirë me marrëveshje të qarta se si trajtohen shpenzimet e përbashkëta."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цениш финансијску независност. То добро функционише уз јасне договоре о заједничким трошковима."
