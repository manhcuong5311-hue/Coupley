          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan impian, tanpa batasan apa pun. Walaupun terasa mustahil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro dei sogni, senza alcun limite. Anche se sembra irraggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なんの制約もない、夢の仕事。手が届かないように思えても大丈夫。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 제약 없는 꿈의 직업이요. 닿지 않을 것 같아도 괜찮아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja impian, tanpa sebarang batasan. Walaupun rasa macam di luar jangkauan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drømmejobben, helt uten begrensninger. Selv om den føles utenfor rekkevidde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je droombaan, zonder enige beperking. Ook al voelt het onbereikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca marzeń, bez żadnych ograniczeń. Nawet jeśli wydaje się poza zasięgiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O emprego dos sonhos, sem nenhum limite. Mesmo que pareça fora de alcance."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobul de vis, fără nicio limită. Chiar dacă pare de neatins."
          }
        },
        "ru" : {
          "stringUnit" : {
