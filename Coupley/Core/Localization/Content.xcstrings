        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertolak ansur dan sanggup. Cuma pastikan anda benar-benar maksudkannya — haiwan peliharaan ialah komitmen jangka panjang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imøtekommende og villig. Bare sørg for at du virkelig mener det – kjæledyr er en lang forpliktelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inschikkelijk en bereidwillig. Zorg wel dat je het echt meent – een huisdier is een lange verbintenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugodowo i z chęcią. Upewnij się tylko, że naprawdę tak myślisz – zwierzak to zobowiązanie na długie lata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposição e flexibilidade. Só garanta que é de coração — pet é um compromisso longo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilitate și bunăvoință. Doar asigură-te că o spui din inimă — un animal e un angajament pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уступчивость и готовность. Только убедись, что ты действительно этого хочешь: питомец — это надолго."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillmötesgående och villig. Se bara till att du verkligen menar det – husdjur är ett långt åtagande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืดหยุ่นและเต็มใจ แค่ให้แน่ใจว่าคุณตั้งใจจริง เพราะสัตว์เลี้ยงคือความผูกพันระยะยาว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu ve istekli. Sadece bunu gerçekten istediğinden emin ol; evcil hayvan uzun soluklu bir sorumluluk."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поступливо й охоче. Просто переконайся, що ти справді цього хочеш, — улюбленець — це надовго."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều lòng và sẵn sàng. Chỉ cần chắc rằng bạn thật lòng — thú cưng là cam kết lâu dài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包容又愿意配合。只是要确定你是真心的，毕竟养宠物是长期的承诺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包容又願意配合。只是要確定你是真心的，寵物是很長久的承諾。"
          }
        }
      }
    },
