        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposobnost je, motivacije za kuhanje zase pa ne. Prava oseba v kuhinji bi to lahko spremenila."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unokwanisa asi hauna shungu uri woga. Munhu akakodzera mukicheni angachinja izvi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awood leh laakiin kaligaa dhiirrigelin ma lihid. Qofka saxda ah ee jikada ku jira ayaa tan beddeli kara."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke aftësi, por vetëm s’ke motivim. Personi i duhur në kuzhinë mund ta ndryshojë këtë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умеш, али кад је само за тебе, не да ти се. Права особа у кухињи могла би то да промени."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanggup tapi teu sumanget upami nyalira. Jalma anu pas di dapur panginten tiasa ngarobih ieu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan, men saknar motivation på egen hand. Rätt person i köket kan ändra på det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una uwezo lakini huna hamu ukiwa peke yako. Mtu sahihi jikoni anaweza kubadilisha hilo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திறமை உண்டு, தனியாக இருக்கும்போது ஆர்வம் இல்லை. சமையலறையில் சரியான துணை இருந்தால் இது மாறலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సామర్థ్యం ఉంది, కానీ ఒంటరిగా ఉత్సాహం లేదు. వంటగదిలో సరైన మనిషి ఉంటే ఇది మారవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қобил, вале танҳо ангеза надорӣ. Одами мувофиқ дар ошхона метавонад инро тағйир диҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีฝีมือแต่ไม่มีแรงจูงใจถ้าต้องทำคนเดียว คนที่ใช่ในครัวอาจเปลี่ยนเรื่องนี้ได้"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብቑዓት ግን በይንኹም ድሌት የብልኩምን። ቅኑዕ ሰብ ኣብ ክሽነ እዚ ክቕይሮ ይኽእል።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başarýarsyň, ýöne ýeke özüň höwesiň ýok. Aşhanada dogry adam muny üýtgedip biler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elinden geliyor ama tek başına pek hevesin yok. Mutfakta doğru kişi bunu değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уміння є, а от мотивації готувати лише для себе бракує. Поруч із потрібною людиною на кухні все може змінитися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صلاحیت ہے، مگر اکیلے میں دل نہیں کرتا۔ باورچی خانے میں صحیح ساتھ شاید یہ بدل دے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoʻlingizdan keladi, lekin yolgʻiz oʻzingizga ishtiyoq yoʻq. Oshxonada toʻgʻri inson buni oʻzgartirishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có tay nghề nhưng nấu một mình thì lười. Có đúng người vào bếp cùng, biết đâu sẽ khác."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakwazi kodwa akunamdla xa uwedwa. Umntu ofanelekileyo ekhitshini angakutshintsha oku."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẹ lè ṣe é, ṣùgbọ́n kò wù yín láti ṣe é nìkan. Ẹni tó tọ́ nínú ilé ìdáná lè yí èyí padà."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有能力，只是一個人時沒動力。廚房裡有對的人，可能會改變這一點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有能力，只是一个人提不起劲。厨房里有对的人，也许会改变这一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有能力，只是一個人時提不起勁。廚房裡有對的人，也許就不一樣了。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyakwazi kodwa awunagqozi uwedwa. Umuntu ofanele ekhishini angakushintsha lokhu."
          }
        }
      }
    },
