        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iżżommha għalik. Hemm xi ħaġa intenzjonata f'li żżomm dik is-sensazzjoni u tagħtiha wiċċ imb wiċċ."
