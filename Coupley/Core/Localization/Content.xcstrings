          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri əsəbi olanda anlaşılmaq problemin həllindən daha vacibdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі чалавек на нервах, разуменне важнейшае за рашэнне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато някой е раздразнен, разбирането е по-ценно от решението."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ অস্থির থাকলে, সমাধানের চেয়ে বুঝতে পারাটাই বেশি কাজে দেয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je neko uznemiren, razumijevanje vrijedi više od rješenja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
