        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በትልልቅ ነገሮች ላይ መስማማት — እንዴት መኖር እንደምትፈልጉ፣ ምን እየገነባችሁ እንደሆነ። የራዕይ መጣጣም አስፈላጊ ነው።"
