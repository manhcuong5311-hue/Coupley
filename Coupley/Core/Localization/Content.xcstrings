        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзгеріске ашықсың, бірақ таныс мәдениет аясында. Мүлде басқа жаққа көшудің белгісіздігінсіз жаңа бастама қалайсың."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បើកចិត្តចំពោះការផ្លាស់ប្ដូរ ប៉ុន្តែក្នុងវប្បធម៌ដែលធ្លាប់ស្គាល់។ អ្នកចង់ចាប់ផ្ដើមថ្មី ដោយមិនចាំបាច់ប្រឈមនឹងភាពមិនច្បាស់លាស់នៃការផ្លាស់ទីទាំងស្រុង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬದಲಾವಣೆಗೆ ಸಿದ್ಧ, ಆದರೆ ಪರಿಚಿತ ಸಂಸ್ಕೃತಿಯೊಳಗೆ. ಸಂಪೂರ್ಣ ಸ್ಥಳಾಂತರದ ಅನಿಶ್ಚಿತತೆ ಇಲ್ಲದೆ ಹೊಸ ಆರಂಭ ನಿಮಗೆ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변화에 열려 있지만 익숙한 문화 안에서요. 완전히 떠나는 불확실함 없이 새 출발을 하고 싶어 해요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ji guhertinê re vekirî yî, lê di nav çanda nas de. Tu destpêkeke nû dixwazî bêyî nezelaliya barkirineke tevahî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзгөрүүгө ачыксың, бирок тааныш маданиятта. Таптакыр көчүп кетүүнүн белгисиздигисиз жаңыдан баштагың келет."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op fir Verännerung, mee an enger vertrauter Kultur. Du wëlls en Neiufank ouni déi ganz Onsécherheet vun engem Auswanderen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເປີດຮັບການປ່ຽນແປງ ແຕ່ໃນວັດທະນະທຳທີ່ຄຸ້ນເຄີຍ ເຈົ້າຢາກເລີ່ມຕົ້ນໃໝ່ ໂດຍບໍ່ຕ້ອງເຈິຄວາມບໍ່ແນ່ນອນຂອງການຍ້າຍໄປໄກ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atvirumas pokyčiams, bet pažįstamoje kultūroje. Nori naujos pradžios be visiško persikraustymo netikrumo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atvērtība pārmaiņām, bet pazīstamā kultūrā. Tu gribi jaunu sākumu bez pilnīgas pārcelšanās nenoteiktības."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misokatra amin'ny fiovana nefa ao anatin'ny kolontsaina mahazatra. Fanombohana vaovao no tianao, tsy misy ny tsy fahazoana antoka amin'ny fifindrana lavitra."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E tuwhera ana ki te panoni, engari i roto i tētahi ahurea mōhio. Ko tāu he tīmatanga hou, kāore he rangirua o te nuku tawhiti."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвореност за промени, но во позната култура. Сакаш нов почеток без целосната неизвесност на преселбата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മാറ്റത്തിന് തയ്യാറാണ്, പക്ഷേ പരിചിതമായ സംസ്കാരത്തിനുള്ളിൽ. പൂർണമായി മാറിത്താമസിക്കുന്നതിന്റെ അനിശ്ചിതത്വമില്ലാതെ ഒരു പുതിയ തുടക്കം നിങ്ങൾ ആഗ്രഹിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өөрчлөлтөд нээлттэй ч танил соёл дотроо. Бүрэн нүүхийн тодорхойгүй байдалгүйгээр шинээр эхлэхийг хүсдэг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलासाठी तयार, पण ओळखीच्या संस्कृतीत. पूर्ण स्थलांतराच्या अनिश्चिततेशिवाय तुम्हाला नवी सुरुवात हवी आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terbuka kepada perubahan tetapi dalam budaya yang biasa. Anda mahu permulaan baharu tanpa ketidakpastian berpindah sepenuhnya ke tempat asing."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidla, imma f'kultura familjari. Trid bidu ġdid mingħajr l-inċertezza ta' rilokazzjoni sħiħa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပြောင်းအလဲကို လက်ခံပေမဲ့ ရင်းနှီးပြီးသား ယဉ်ကျေးမှုထဲမှာပဲ။ လုံးဝ ပြောင်းရွှေ့ရတဲ့ မသေချာမှု မပါဘဲ အစအသစ်ကို လိုချင်တယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpen for endring, men innenfor en kjent kultur. Du vil ha en ny start uten all usikkerheten ved å flytte helt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवर्तनका लागि तयार, तर चिनेजानेको संस्कृतिभित्र। तपाईं पूरै बसाइँसराइको अनिश्चितताबिना नयाँ सुरुवात चाहनुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open voor verandering, maar binnen een vertrouwde cultuur. Je wilt een frisse start zonder de onzekerheid van een grote verhuizing."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndinu okonzeka kusintha koma mu chikhalidwe chodziwika. Mukufuna chiyambi chatsopano popanda kukayikira kwa kusamukira kutali kotheratu."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jijjiiramaaf banaa dha, garuu aadaa beektu keessatti. Jalqaba haaraa barbaadda, shakkii guutummaatti bakka jijjiiruu malee."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିବର୍ତ୍ତନ ପାଇଁ ଖୋଲା, କିନ୍ତୁ ପରିଚିତ ସଂସ୍କୃତି ଭିତରେ। ପୂରା ସ୍ଥାନାନ୍ତରର ଅନିଶ୍ଚିତତା ବିନା ଆପଣ ଏକ ନୂଆ ଆରମ୍ଭ ଚାହାନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਦਲਾਅ ਲਈ ਤਿਆਰ, ਪਰ ਜਾਣੇ-ਪਛਾਣੇ ਸੱਭਿਆਚਾਰ ਵਿੱਚ। ਤੁਸੀਂ ਨਵੀਂ ਸ਼ੁਰੂਆਤ ਚਾਹੁੰਦੇ ਹੋ, ਪੂਰੀ ਤਰ੍ਹਾਂ ਨਵੀਂ ਥਾਂ ਵਸਣ ਦੀ ਬੇਯਕੀਨੀ ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwartość na zmianę, ale w znajomej kulturze. Chcesz nowego startu bez niepewności związanej z emigracją."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدلون ته چمتو، خو په پېژندل شوي کلتور کې. تاسو نوی پیل غواړئ، پرته له دې چې د بشپړې کډې ناڅرګندتیا ومنئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abertura para mudar, mas dentro de uma cultura conhecida. Você quer recomeçar sem a incerteza de uma mudança radical."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abertura à mudança, mas dentro de uma cultura familiar. Queres recomeçar sem a incerteza de mudar de vida por completo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschidere spre schimbare, dar într-o cultură familiară. Vrei un nou început fără incertitudinea unei mutări complete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемены — да, но в привычной культуре. Тебе хочется начать с чистого листа без неизвестности полного переезда."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witeguye impinduka ariko mu muco umenyereye. Ushaka gutangira bushya nta mpungenge zo kwimukira kure burundu."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වෙනසට විවෘතයි, ඒත් හුරු පුරුදු සංස්කෘතිය ඇතුළේ. මුළුමනින්ම පදිංචිය වෙනස් කිරීමේ අවිනිශ්චිතතාවක් නැතිව ඔබට අලුත් ආරම්භයක් ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorenosť zmene, ale v známej kultúre. Chceš nový začiatok bez neistoty úplného presťahovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprtost za spremembe, a znotraj znane kulture. Želiš si nov začetek brez vse negotovosti popolne selitve."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakavhurika kuchinja asi mutsika dzaunoziva. Unoda kutanga patsva usingatami zvachose usina chokwadi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isbeddel waad u furan tahay, balse dhaqan aad taqaan gudihiisa. Waxaad rabtaa bilow cusub adigoon la kulmin hubanti la'aanta guur dhammaystiran."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapje ndaj ndryshimit, por brenda një kulture të njohur. Do një fillim të ri pa pasigurinë e një shpërnguljeje të plotë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвореност за промену, али у познатој култури. Желиш нови почетак без неизвесности потпуног пресељења."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuka kana parobahan, tapi dina budaya anu wawuh. Anjeun hoyong ngamimitian anyar tanpa kedah pindah jauh pisan anu teu pasti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppen för förändring, men inom en bekant kultur. Du vill ha en nystart utan all osäkerhet som en stor flytt innebär."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uko tayari kwa mabadiliko lakini ndani ya utamaduni unaoufahamu. Unataka mwanzo mpya bila wasiwasi wa kuhamia mbali kabisa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாற்றத்திற்குத் தயார், ஆனால் பழகிய கலாச்சாரத்திற்குள். முழுமையாக இடம்பெயரும் நிச்சயமின்மை இல்லாத ஒரு புதிய தொடக்கம் வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మార్పుకు సిద్ధమే, కానీ తెలిసిన సంస్కృతిలోనే. పూర్తిగా వేరే చోటుకు వెళ్లే అనిశ్చితి లేకుండా కొత్త ప్రారంభం కావాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба тағйирот кушода, вале дар фарҳанги ошно. Ту оғози нав мехоҳӣ, бе номуайянии кӯчидани пурра."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดรับการเปลี่ยนแปลงแต่ในวัฒนธรรมที่คุ้นเคย คุณอยากเริ่มต้นใหม่โดยไม่ต้องเจอความไม่แน่นอนของการย้ายไปไกล"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ንለውጢ ክፉታት፣ ግን ኣብ ውሽጢ ፍሉጥ ባህሊ። ብዘይ ምሉእ ዘይርጉእነት ምግዓዝ ሓድሽ መጀመርታ ትደልዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üýtgeşmä açyk, ýöne tanyş medeniýetiň içinde. Doly göçmegiň näbelliligi bolmazdan, täze başlangyç isleýärsiň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişime açıksın ama tanıdık bir kültür içinde. Tamamen yer değiştirmenin belirsizliği olmadan yeni bir başlangıç istiyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкритість до змін, але в знайомій культурі. Тобі хочеться нового старту без невизначеності повного переїзду."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدیلی کے لیے تیار، مگر جانی پہچانی ثقافت کے اندر۔ آپ کو نئی شروعات چاہیے، مکمل نقل مکانی کی بے یقینی کے بغیر۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻzgarishga ochiqsiz, lekin tanish madaniyat doirasida. Toʻliq koʻchishning noaniqliklarisiz yangi boshlanishni xohlaysiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẵn lòng thay đổi nhưng trong nền văn hóa quen thuộc. Bạn muốn khởi đầu mới mà không phải đối mặt với mọi bất định của việc chuyển hẳn đi xa."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvulekile kutshintsho kodwa ngaphakathi kwenkcubeko oyaziyo. Ufuna isiqalo esitsha ngaphandle kokungaqiniseki kokufudukela kude ngokupheleleyo."
