    "Do something together that asks nothing — cook, fold laundry, draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doen iets saam wat niks vra nie – kook, wasgoed vou, teken."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምንም የማይጠይቅ ነገር አብረው ያድርጉ — ምግብ ማብሰል፣ ልብስ ማጠፍ፣ መሳል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افعلوا معًا شيئًا لا يتطلب جهدًا: الطبخ، طي الغسيل، الرسم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একেলগে এনে কিবা কৰক যাৰ বাবে একো নালাগে — ৰন্ধা, কাপোৰ জাপা, ছবি আঁকা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikdə heç nə tələb etməyən bir şey et — yemək bişir, paltar qatla, rəsm çək."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Займіцеся разам чымсьці, што нічога не патрабуе, — гатуйце, складайце бялізну, малюйце."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложи нещо заедно, което не изисква усилие – готвене, сгъване на пране, рисуване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথে এমন কিছু করো যাতে কোনো চাপ নেই — রান্না, কাপড় ভাঁজ করা, আঁকা।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radite zajedno nešto što ništa ne traži – kuhajte, slažite veš, crtajte."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartiu alguna cosa que no demani res — cuinar, plegar la roba, dibuixar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dělejte spolu něco, co nic nežádá – vařte, skládejte prádlo, kreslete."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwna rywbeth gyda'ch gilydd sy'n gofyn dim — coginio, plygu dillad, darlunio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør noget sammen, der ikke kræver noget – lav mad, fold vasketøj, tegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht etwas zusammen, das nichts verlangt – kochen, Wäsche falten, zeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε μαζί κάτι που δεν ζητάει τίποτα — μαγείρεμα, δίπλωμα ρούχων, ζωγραφική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca algo que hacer juntos que no exija nada: cocinar, doblar ropa, dibujar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehke koos midagi, mis ei nõua midagi — kokake, voltige pesu, joonistage."
