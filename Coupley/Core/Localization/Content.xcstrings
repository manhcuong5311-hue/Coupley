    "Eye contact, genuine words, no deflection — that's what lands for you. You need to feel the weight of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oogkontak, opregte woorde, geen ontwyking nie – dís wat by jou tuisbring. Jy moet die gewig daarvan voel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዓይን ለዓይን መተያየት፣ እውነተኛ ቃላት፣ ማሳበብ የለም — ለእርስዎ የሚደርሰው ይሄ ነው። ክብደቱ ሊሰማዎት ይገባል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظرة في العين وكلمات صادقة بلا تهرّب، هذا ما يصل إليكم. تحتاجون إلى الشعور بثقل الاعتذار."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চকুত চকু থৈ, আন্তৰিক শব্দ, কোনো অজুহাত নোহোৱাকৈ — এয়াই আপোনাৰ মনত পৰশ কৰে। আপুনি ইয়াৰ গুৰুত্ব অনুভৱ কৰিব বিচাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göz təması, səmimi sözlər, bəhanəsiz — sənə təsir edən budur. Bunun ağırlığını hiss etməlisən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позірк у вочы, шчырыя словы, ніякіх адгаворак — вось што да цябе даходзіць. Табе трэба адчуць іх вагу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поглед в очите, искрени думи, без увъртане – това стига до теб. Трябва да усетиш тежестта му."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চোখে চোখ রেখে, মন থেকে বলা কথা, কোনো পাশ কাটানো নয় — এটাই তোমার মনে পৌঁছায়। তুমি এর ভারটা অনুভব করতে চাও।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogled u oči, iskrene riječi, bez izvlačenja – to do tebe dopire. Moraš osjetiti njegovu težinu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacte visual, paraules sinceres, sense excuses — això és el que t'arriba. Necessites sentir-ne el pes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oční kontakt, opravdová slova, žádné vytáčky – to na tebe zabírá. Potřebuješ cítit jejich váhu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyswllt llygad, geiriau go iawn, dim osgoi — dyna sy'n taro deuddeg i ti. Mae angen i ti deimlo'i bwysau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øjenkontakt, ægte ord, ingen bortforklaringer – det er det, der rammer dig. Du har brug for at mærke vægten af det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blickkontakt, echte Worte, keine Ausflüchte – das kommt bei dir an. Du musst spüren, dass es ernst gemeint ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βλέμμα στα μάτια, αληθινά λόγια, χωρίς υπεκφυγές — αυτό σε αγγίζει. Χρειάζεται να νιώσεις το βάρος της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacto visual, palabras sinceras, sin excusas: eso es lo que te llega. Necesitas sentir el peso de la disculpa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silmside, siirad sõnad, ei mingit kõrvalepõiklemist — see jõuab sinuni. Sa pead tundma, et see on kaalukas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begietara begiratzea, hitz zintzoak, aitzakiarik ez — hori da zuregana iristen dena. Haren pisua sentitu behar duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تماس چشمی، حرف از ته دل، بدون طفره رفتن — این است که به دلت می‌نشیند. باید سنگینی‌اش را حس کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katsekontakti, aidot sanat, ei selittelyä – juuri se uppoaa sinuun. Sinun täytyy tuntea sen paino."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagtingin sa mata, totoong salita, walang palusot — iyan ang tumatama sa’yo. Kailangan mong maramdaman ang bigat nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regard franc, mots sincères, pas d'esquive : c'est ce qui te touche. Tu as besoin d'en sentir tout le poids."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teagmháil súl, focail fhírinneacha, gan seachaint — sin a théann i bhfeidhm ort. Caithfidh tú meáchan an leithscéil a mhothú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirada directa, palabras sinceras, sen evasivas: iso é o que che chega. Precisas sentir o peso do que se di."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આંખમાં આંખ નાખીને, સાચા શબ્દો, કોઈ બહાનાં નહીં — તમને એ જ સ્પર્શે છે. તમારે એનું વજન અનુભવવું હોય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kallon ido, kalmomi na gaskiya, babu kauce wa magana — wannan ne ke ratsa ku. Kuna buƙatar jin nauyin lamarin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קשר עין, מילים אמיתיות, בלי התחמקויות — זה מה שנוגע בך. יש לך צורך להרגיש את המשקל של זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आँखों में आँखें डालकर, सच्चे शब्द, बिना बात टाले — यही आपके दिल तक पहुँचता है। आपको उसकी गंभीरता महसूस होनी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogled u oči, iskrene riječi, bez izvlačenja – to do tebe doista dopire. Moraš osjetiti njihovu težinu."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nan je, pawòl sensè, san detou — se sa ki touche ou. Ou bezwen santi pwa l."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szemkontaktus, őszinte szavak, kibúvók nélkül – ez az, ami nálad célba ér. Érezned kell a súlyát."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Աչքերի մեջ նայել, անկեղծ խոսքեր, առանց արդարանալու — ահա թե ինչն է քեզ հասնում։ Քեզ պետք է զգալ դրա կշիռը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontak mata, kata-kata tulus, tanpa mengelak — itu yang sampai ke hatimu. Kamu perlu merasakan kesungguhannya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilekọ anya, okwu ezi okwu, ọ dịghị ịgbagọ okwu — nke ahụ na-eru gị n'obi. Ị chọrọ ịhụ ịdị arọ ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augnsamband, einlæg orð, engar undanfærslur – það er það sem nær til þín. Þú þarft að finna þungann í því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sguardo negli occhi, parole autentiche, niente scappatoie — è questo che ti arriva. Hai bisogno di sentirne il peso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目を見て、心からの言葉で、ごまかさずに。そういう謝罪が響くタイプです。その重みを感じたいのです。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adu mripat, tembung tulus, ora ngeles — kuwi sing tekan ati panjenengan. Panjenengan butuh ngrasakake abote."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თვალებში ყურება, გულწრფელი სიტყვები, თავის მართლების გარეშე — აი, რა გწვდება. ბოდიშის წონა უნდა იგრძნო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көзге қарап, шын жүректен, сылтаусыз — саған осы әсер етеді. Оның салмағын сезінуің керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សម្លឹងភ្នែក ពាក្យពិតៗ មិនគេចវេស — នោះហើយជាអ្វីដែលប៉ះចិត្តអ្នក។ អ្នកត្រូវការមានអារម្មណ៍ពីទម្ងន់របស់វា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಣ್ಣಲ್ಲಿ ಕಣ್ಣಿಟ್ಟು, ಮನಸಾರೆ ಮಾತುಗಳು, ನುಣುಚಿಕೊಳ್ಳದೆ — ಅದೇ ನಿಮ್ಮನ್ನು ತಲುಪುವುದು. ಅದರ ಆಳವನ್ನು ನೀವು ಅನುಭವಿಸಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눈을 맞추고, 진심으로, 핑계 없이. 그래야 마음에 와닿아요. 사과의 무게가 느껴져야 하죠."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Têkiliya çavan, gotinên rastîn, bê revîn — ev e ya ku digihîje te. Divê tu giraniya wê hîs bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көзгө тике кароо, чын сөздөр, шылтоосуз — сага ушул жетет. Анын салмагын сезишиң керек."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bléckkontakt, éierlech Wierder, keng Ausrieden — dat kënnt bei dir un. Du muss spieren, datt et eescht gemengt ass."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສົບຕາກັນ, ຄຳເວົ້າຈາກໃຈ, ບໍ່ປັດຄວາມຮັບຜິດຊອບ — ນັ້ນຄືສິ່ງທີ່ເຂົ້າເຖິງໃຈເຈົ້າ ເຈົ້າຕ້ອງການຮູ້ສຶກເຖິງນ້ຳໜັກຂອງມັນ"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akių kontaktas, tikri žodžiai, jokio išsisukinėjimo – štai kas tave pasiekia. Tau reikia pajusti jų svorį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acu kontakts, patiesi vārdi, bez izvairīšanās – tas tevi aizsniedz. Tev vajag sajust, cik tas ir nopietni."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mifampijery maso, teny marina, tsy misy fialana — izany no tonga aminao. Mila mahatsapa ny lanjany ianao."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He titiro kanohi, he kupu pono, kāore he karo — koinā e tau ana ki a koe. Me rongo koe i tōna taumaha."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поглед в очи, искрени зборови, без избегнување — тоа те допира. Треба да ја почувствуваш тежината."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കണ്ണിൽ നോക്കി, ഒഴിഞ്ഞുമാറാതെ, ആത്മാർഥമായ വാക്കുകൾ — അതാണ് നിങ്ങളുടെ മനസ്സിൽ തൊടുന്നത്. അതിന്റെ ആഴം നിങ്ങൾക്ക് അനുഭവപ്പെടണം."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нүдээ харж, чин сэтгэлээсээ, бултахгүйгээр — энэ л чамд хүрдэг. Чи түүний жинг мэдрэх хэрэгтэй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डोळ्यांत डोळे घालून, खरे शब्द, कोणतीही टाळाटाळ नाही — हेच तुमच्या मनापर्यंत पोहोचते. त्यामागचे गांभीर्य तुम्हाला जाणवायला हवे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertentang mata, kata-kata ikhlas, tanpa berdalih — itulah yang menyentuh hati anda. Anda perlu rasa betapa seriusnya ia."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuntatt bl-għajnejn, kliem ġenwin, l-ebda skuża — dak li jasal għandek. Għandek bżonn tħoss il-piż tiegħu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မျက်လုံးချင်းဆုံ၊ စိတ်ရင်းစကား၊ ရှောင်လွှဲမှု မရှိ — ဒါက သင့်ကို ထိတယ်။ အဲဒီ တောင်းပန်မှုရဲ့ အလေးချိန်ကို သင် ခံစားရဖို့ လိုတယ်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øyekontakt, ekte ord, ingen bortforklaringer – det er det som treffer deg. Du må kjenne tyngden i det."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आँखामा आँखा जुधाएर, सच्चा शब्दमा, कुरा नपन्छाई — तपाईंको मनमा त्यही पुग्छ। तपाईंलाई त्यसको गहिराइ महसुस हुनुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oogcontact, gemeende woorden, niet uitwijken – dat komt bij jou binnen. Je moet voelen hoe zwaar het weegt."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuyang'anana m'maso, mawu enieni, osazemba — ndizo zimakufikani. Mumafunika kumva kulemera kwake."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ija walitti laaluu, jechoota dhugaa, of irraa dabarsuu dhiisuu — kun si tuqa. Ulfaatina isaa dhaga'uu qabda."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଖିରେ ଆଖି ରଖି, ସଚ୍ଚା ଶବ୍ଦ, କୌଣସି ବାହାନା ନାହିଁ — ଏଇଆ ଆପଣଙ୍କ ମନକୁ ଛୁଏଁ। ଆପଣ ଏହାର ଗୁରୁତ୍ୱ ଅନୁଭବ କରିବା ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਖਾਂ ਵਿੱਚ ਅੱਖਾਂ ਪਾ ਕੇ, ਸੱਚੇ ਸ਼ਬਦ, ਕੋਈ ਬਹਾਨਾ ਨਹੀਂ — ਇਹੀ ਤੁਹਾਡੇ ਦਿਲ ਤੱਕ ਪਹੁੰਚਦਾ ਹੈ। ਤੁਹਾਨੂੰ ਇਸ ਦਾ ਵਜ਼ਨ ਮਹਿਸੂਸ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt wzrokowy, prawdziwe słowa, żadnych wykrętów – to do ciebie trafia. Musisz poczuć wagę tych słów."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سترګې په سترګو، رښتینې خبرې، بې له تېښتې — همدا ستاسو زړه ته رسېږي. تاسو اړتیا لرئ چې د هغې وزن احساس کړئ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olho no olho, palavras verdadeiras, sem desviar — é isso que toca você. Você precisa sentir o peso do pedido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacto visual, palavras genuínas, sem fugir ao assunto — é isso que te chega. Precisas de sentir o peso daquilo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privire în ochi, cuvinte sincere, fără eschivă — asta ajunge la tine. Ai nevoie să simți greutatea scuzei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Взгляд в глаза, честные слова, никаких увёрток — вот что для тебя по-настоящему работает. Тебе нужно почувствовать их вес."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurebana mu maso, amagambo nyakuri, nta kwigira ntibindeba — ibyo ni byo bikugeraho. Ukeneye kumva uburemere bwabyo."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඇස් දිහා බලාගෙන, අවංක වචනවලින්, මඟ නොහැර — ඔබේ හිතට දැනෙන්නේ ඒකයි. ඒකේ බරපතළකම ඔබට දැනෙන්න ඕනේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očný kontakt, úprimné slová, žiadne vyhováranie – to na teba platí. Potrebuješ cítiť, akú to má váhu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogled v oči, iskrene besede, brez izmikanja – to te doseže. Začutiti moraš težo izrečenega."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutarisana mumaziso, mazwi echokwadi, pasina kunzvenga — ndizvo zvinokusvika. Unoda kunzwa kurema kwazvo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indho is eegaya, erayo dhab ah, iska-leexin la'aan — taasi ayaa ku gaarta. Waxaad u baahan tahay inaad dareento miisaankeeda."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt me sy, fjalë të sinqerta, pa shmangie – kjo të prek. Të duhet ta ndiesh peshën e saj."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакт очима, искрене речи, без изговора — то до тебе допире. Треба да осетиш тежину тих речи."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silih teuteup, kecap anu tulus, teu ngélak — éta anu nepi ka haté anjeun. Anjeun peryogi ngaraos beuratna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögonkontakt, ärliga ord, inga bortförklaringar – det är det som når fram till dig. Du behöver känna tyngden i den."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutazamana machoni, maneno ya kweli, bila kukwepa — hivyo ndivyo yanavyokugusa. Unahitaji kuhisi uzito wake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கண்ணோடு கண் பார்த்து, உண்மையான வார்த்தைகள், சாக்குப்போக்கு இல்லாமல் — அதுதான் உங்களைச் சென்றடையும். அதன் கனத்தை நீங்கள் உணர வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కళ్లలోకి చూసి, మనస్ఫూర్తిగా, తప్పించుకోకుండా — అదే మీకు చేరుతుంది. దాని బరువు మీకు అనిపించాలి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нигоҳ ба чашм, суханони самимӣ, бе баҳона — ҳамин ба ту мерасад. Ба ту лозим аст, ки вазни онро ҳис кунӣ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สบตา พูดจากใจ ไม่เลี่ยง นั่นคือสิ่งที่เข้าถึงใจคุณ คุณต้องรู้สึกได้ว่าคำขอโทษนั้นหนักแน่นจริง"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዓይኒ ንዓይኒ፣ ሓቀኛ ቃላት፣ ብዘይ ምህዳም — እዚ እዩ ዝትንክፈኩም። ክብደቱ ክስምዓኩም የድልየኩም።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gözme-göz seretmek, çyn sözler, bahana ýok — saňa täsir edýän şol. Onuň agramyny duýmak saňa gerek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göz teması, samimi sözler, kaçamak yok; sana ulaşan bu. Ağırlığını hissetmen gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Погляд в очі, щирі слова, жодних викрутів — ось що до тебе доходить. Тобі треба відчути вагу цих слів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آنکھوں میں آنکھیں، سچے الفاظ، کوئی بہانہ نہیں — یہی آپ کے دل تک پہنچتا ہے۔ آپ کو اس کا وزن محسوس ہونا چاہیے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koʻzga qarab, samimiy soʻzlar bilan, bahona qilmasdan — sizga aynan shu taʼsir qiladi. Uzrning salmogʻini his qilishingiz kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn vào mắt, lời thật lòng, không né tránh — đó là điều chạm tới bạn. Bạn cần cảm nhận được sức nặng của nó."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukujongana emehlweni, amazwi okwenyani, ukungazibaleki — yiloo nto ekuchukumisayo. Kufuneka uve ubunzima bayo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wíwo ojú, ọ̀rọ̀ òtítọ́, láìyí ọ̀rọ̀ padà — ìyẹn ló ń wọ̀ yín lọ́kàn. Ẹ nílò láti rí bí ó ti wúwo tó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看著你的眼睛、真心的話、不找藉口，這樣才打動得了你。你需要感受到這份道歉的分量。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看着你的眼睛、真心的话、不找借口——这才能打动你。你需要感受到它的分量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看著你的眼睛、真心的話、不找藉口，這樣才打動得了你。你需要感受到這份道歉的重量。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukubhekana emehlweni, amazwi aqotho, ukungabaleki — yikho okuthinta wena. Udinga ukuzwa isisindo sakho."
          }
        }
      }
    },
    "Fair. Just worth knowing if your partner would love to play with you — or if they need their gaming time respected." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regverdig. Net goed om te weet of jou maat graag saam met jou sou wil speel – of dalk eerder wil hê jy moet daardie speeltyd respekteer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምንም አይደለም። አጋርዎ ከእርስዎ ጋር መጫወት ቢወዱ — ወይም የጨዋታ ጊዜያቸው እንዲከበር ቢፈልጉ ማወቁ ጥሩ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفهوم. فقط من المفيد معرفة ما إذا كان شريكك يحب أن يلعب معك، أو يحتاج إلى احترام وقت لعبه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঠিকেই। মাথোঁ জানি থোৱা ভাল, আপোনাৰ সংগীয়ে আপোনাৰ লগত খেলিব বিচাৰে নেকি — বা তেওঁৰ গেমিঙৰ সময়খিনিক সন্মান দিয়াটো দৰকাৰ নেকি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlaşılandır. Sadəcə bilmək yaxşıdır: partnyorun səninlə oynamağı çox istəyirmi — yoxsa öz oyun vaxtına hörmət gözləyir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справядліва. Але варта ведаць, ці хоча палавінка гуляць разам з табой — ці ёй трэба, каб паважалі яе час на гульні."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разбираемо. Просто е добре да знаеш дали половинката ти би искала да играете заедно – или иска времето ѝ за игри да се уважава."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঠিক আছে। শুধু জেনে রাখা ভালো, তোমার পার্টনার তোমার সাথে খেলতে ভালোবাসবে কি না — কিংবা ওর গেমিংয়ের সময়টাকে সম্মান দেওয়া দরকার কি না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fer. Samo je dobro znati da li bi se tvoja voljena osoba rado igrala s tobom – ili želi da poštuješ njeno vrijeme za igrice."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'acord. Només val la pena saber si a la teva parella li encantaria jugar amb tu — o si necessita que li respectis el seu temps de joc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fér. Jen je dobré vědět, jestli by si tvůj protějšek s tebou rád zahrál – nebo jestli potřebuje respekt ke svému času na hraní."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digon teg. Dim ond gwerth gwybod a fyddai dy bartner yn dwlu chwarae gyda ti — neu a oes angen parchu amser gemau dy bartner."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fair nok. Bare godt at vide, hvis din partner ville elske at spille med dig – eller har brug for, at du respekterer vedkommendes spilletid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fair. Nur gut zu wissen, ob dein Schatz gern mit dir spielen würde – oder sich Respekt für die eigene Spielzeit wünscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λογικό. Απλώς καλό είναι να ξέρεις αν το ταίρι σου θα ήθελε πολύ να παίζετε μαζί — ή αν χρειάζεται να σεβαστείς τον χρόνο του για gaming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente válido. Solo conviene saber si a tu pareja le encantaría jugar contigo — o si necesita que respetes su tiempo de juego."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõistetav. Tasub lihtsalt teada, kas su partner tahaks sinuga koos mängida — või vajab ta, et tema mänguaega austataks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidezkoa. Merezi du jakitea zure bikotekideak zurekin jolastea maiteko lukeen, edo bere jolas-denbora errespetatzea behar duen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصفانه است. فقط خوب است بدانی پارتنرت دوست دارد با تو بازی کند — یا لازم است به وقت بازی‌اش احترام بگذاری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reilua. Hyvä vain tietää, haluaisiko kumppanisi pelata kanssasi – tai haluaako hän, että hänen peliaikaansa kunnioitetaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayos lang ’yan. Magandang malaman lang kung gusto ng partner mo na makipaglaro sa’yo — o kung kailangan niyang respetuhin mo ang oras niya sa paglalaro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça se comprend. Bon à savoir si l'autre adorerait jouer avec toi — ou a besoin qu'on respecte son temps de jeu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cothrom go leor. Fiú a fhios a bheith agat ar bhreá le do pháirtí imirt leat — nó an gá meas a bheith agat ar am cluichíochta do pháirtí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xusto. Só convén saber se á túa parella lle encantaría xogar contigo, ou se necesita que respectes o seu tempo de xogo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વાજબી. બસ જાણી રાખવું કે તમારા પાર્ટનરને તમારી સાથે રમવું ગમશે કે નહીં — અથવા એમના ગેમિંગના સમયનું માન રાખવાનું છે કે નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babu laifi. Kawai yana da kyau ku sani ko abokin zamanku na son yin wasa tare da ku — ko kuma lokacin wasan abokin zamanku na buƙatar a mutunta shi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוגן. רק כדאי לדעת אם הצד השני היה שמח לשחק איתך — או אם חשוב לו שיכבדו את זמן הגיימינג שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठीक है। बस यह जानना अच्छा है कि कहीं आपके पार्टनर का मन आपके साथ खेलने का तो नहीं — या उन्हें चाहिए कि आप उनके गेमिंग के समय का सम्मान करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošteno. Samo je dobro znati bi li se voljena osoba rado igrala s tobom – ili treba poštovati vrijeme koje provodi u igri."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa jis. Men li bon pou konnen si patnè ou ta renmen jwe avè ou — oswa si li bezwen ou respekte tan jwèt li."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogos. Csak jó tudni, ha a párod szívesen játszana veled – vagy ha azt szeretné, hogy tiszteld a játékra szánt idejét."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հասկանալի է։ Պարզապես արժե իմանալ՝ զուգընկերդ կուզե՞ր քեզ հետ խաղալ, թե՞ պարզապես ուզում է, որ հարգես իր խաղի ժամանակը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajar. Tapi ada baiknya kamu tahu kalau pasanganmu ingin main bareng kamu — atau kalau dia butuh waktu main game-nya dihargai."
