        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അപ്പപ്പോഴുള്ളതും കൂസലില്ലാത്തതും. ഏതാണ്ട് എന്തും നിങ്ങൾക്ക് ആസ്വദിക്കാനാകും. നിർബന്ധങ്ങളില്ലാത്ത അഭിരുചി."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аяндаа, санаа зоволтгүй. Чи бараг юунд ч дуртай. Сонголт хийхэд амархан."
