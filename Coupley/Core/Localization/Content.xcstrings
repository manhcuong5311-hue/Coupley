        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nid y pris sy'n cyfri — mae'n brawf bod rhywun wedi meddwl amdanat ti pan nad oeddet ti yno. Y meddylgarwch yw'r holl bwynt."
