        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്വഭാവത്താൽത്തന്നെ സന്തുലിതർ. മിക്ക പങ്കാളികളുമായും പണത്തെക്കുറിച്ചുള്ള സംസാരങ്ങൾ നിങ്ങൾ താരതമ്യേന എളുപ്പത്തിൽ കൈകാര്യം ചെയ്യുന്നുണ്ടാകും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Угаасаа тэнцвэртэй. Ихэнх ханьтай мөнгөний талаар харьцангуй амархан ярилцдаг байх."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
