        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spise eller drikke noe trøstende"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets troostends eten of drinken"
