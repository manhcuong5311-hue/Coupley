        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valami, ami nehezen megy – nyilvános beszéd, magabiztosság"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի բան, որ ինձ համար դժվար է՝ հրապարակային ելույթ, ինքնավստահություն"
