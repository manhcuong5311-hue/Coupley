        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie chodzi o cenę – to dowód, że ktoś myślał o tobie, gdy nie było cię obok. Liczy się właśnie ta pamięć i troska."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خبره د بیې نه ده — دا ثبوت دی چې څوک تاسو هغه وخت هم یادوي چې ورسره نه یاست. اصلي خبره همدا پاملرنه ده."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é sobre o preço — é a prova de que alguém lembrou de você mesmo longe. O carinho da intenção é o que importa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é pelo preço — é a prova de que alguém pensou em ti quando não estavas lá. A atenção é o que importa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu e vorba de preț — e dovada că cineva s-a gândit la tine când nu erai acolo. Tocmai atenția asta contează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дело не в цене, а в доказательстве, что о тебе думали, даже когда тебя не было рядом. Весь смысл — во внимании."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntibireba igiciro — ni ikimenyetso cy'uko hari wagutekereje igihe utari uhari. Kwitaho ni byo by'ingenzi."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙතන වැදගත් මිල නෙවෙයි — ඔබ ළඟ නොසිටි වෙලාවෙත් කවුරුහරි ඔබ ගැන හිතුවා කියන සාක්ෂියයි. සැලකිලිමත්කමම තමයි මුළු අර්ථයම."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejde o cenu – je to dôkaz, že na teba niekto myslí, aj keď nie si nablízku. Celé je to o pozornosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne gre za ceno – gre za dokaz, da je nekdo mislil nate, ko te ni bilo zraven. Pozornost je bistvo vsega."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazvisi nezvemutengo — ndiwo uchapupu hwekuti mumwe akafunga nezvako iwe usipo. Kufunga nezvemumwe ndiko kwakakosha."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma aha qiimaha — waa caddayn in qof ku xusuustay adigoo aan joogin. Ujeeddadu oo dhan waa xusuusnaanta iyo daryeelka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk ka të bëjë me çmimin – është provë se dikush të mendoi kur nuk ishe aty. Vëmendja është gjithë thelbi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Није ствар у цени — то је доказ да је неко мислио на тебе и кад ниси ту. Пажња је суштина свега."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanés perkawis hargana — éta bukti yén aya anu émut ka anjeun nalika anjeun teu aya. Perhatosan téh intina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det handlar inte om priset – det är ett bevis på att någon tänkte på dig när du inte var där. Omtanken är hela poängen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si kuhusu bei — ni ushahidi kwamba mtu alikuwaza hata ulipokuwa haupo. Kufikiriwa ndilo jambo kuu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விலை முக்கியமல்ல — நீங்கள் அருகில் இல்லாதபோதும் ஒருவர் உங்களை நினைத்தார் என்பதற்கான சான்று அது. அந்த அக்கறைதான் முழு அர்த்தமும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విషయం ధర కాదు — మీరు లేనప్పుడూ ఎవరో మిమ్మల్ని తలచుకున్నారనడానికి అది రుజువు. ఆ ఆలోచనే అసలు విషయం."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гап дар нарх нест — ин далел аст, ки касе ҳангоми дур будан дар фикри ту будааст. Тамоми маъно дар ҳамин диққат аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้อยู่ที่ราคา แต่เป็นหลักฐานว่ามีคนนึกถึงคุณแม้ตอนที่คุณไม่ได้อยู่ตรงนั้น ความใส่ใจคือหัวใจของทั้งหมด"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ብዛዕባ ዋጋ ኣይኮነን — ኣብ ዘይነበርኩምሉ ሓደ ሰብ ከም ዝሓሰበልኩም መርትዖ እዩ። እቲ ቀንዲ ነገር ምሕሳብ እዩ።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gep bahasynda däl — bu sen ýanynda bolmadyk wagtyň hem biriniň seni ýatlandygynyň subutnamasy. Bütin many şol ünsde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesele fiyatı değil; sen yokken birinin seni düşündüğünün kanıtı. Asıl önemli olan o incelik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справа не в ціні — це доказ, що про тебе думають, навіть коли тебе немає поруч. Уважність — ось що головне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بات قیمت کی نہیں — یہ ثبوت ہے کہ آپ کی غیر موجودگی میں بھی کسی نے آپ کو یاد رکھا۔ اصل بات خیال رکھنے کی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gap narxida emas — bu siz yoʻqligingizda ham kimdir sizni oʻylaganining isboti. Butun maʼno — eʼtiborda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều quan trọng không phải giá tiền — mà là bằng chứng có người nghĩ đến bạn cả khi bạn không ở đó. Sự chu đáo mới là tất cả."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayingonxabiso — bubungqina bokuba umntu ebecinga ngawe ungekho. Ukucinga ngomnye yeyona nto ibalulekileyo."
