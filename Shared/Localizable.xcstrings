        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편지를 열면 꽃이 피어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebaik sahaja surat dibuka, ia mekar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et brev er åpnet, blomstrer det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
