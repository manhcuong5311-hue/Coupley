          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoja käytetään vain vastauksen kirjoittamiseen. OpenAI:n mukaan näin lähetettyjä tietoja ei käytetä sen mallien kouluttamiseen. Valmentajahistoriasi tallennetaan vain tälle laitteelle."
