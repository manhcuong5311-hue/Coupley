    "Private insights that read your patterns and recommend the right next move." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رؤى خاصة تقرأ أنماطكما وتقترح الخطوة التالية المناسبة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromé postřehy, které rozpoznají vaše vzorce a doporučí správný další krok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private indsigter, der aflæser jeres mønstre og anbefaler det rette næste skridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Einblicke, die eure Muster erkennen und den richtigen nächsten Schritt empfehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιδιωτικά ευρήματα που διαβάζουν τα μοτίβα σας και προτείνουν το σωστό επόμενο βήμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Análisis privados que leen los patrones de los dos y recomiendan el siguiente paso adecuado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityisiä oivalluksia, jotka lukevat tapojanne ja suosittelevat oikeaa seuraavaa siirtoa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga pribadong insight na bumabasa sa mga pattern ninyo at nagmumungkahi ng tamang susunod na hakbang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des éclairages privés qui lisent vos habitudes et recommandent la bonne prochaine étape."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תובנות פרטיות שקוראות את הדפוסים שלכם וממליצות על הצעד הנכון הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी इनसाइट्स जो आपके पैटर्न समझकर सही अगला क़दम सुझाती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privát meglátások, amelyek kiolvassák a mintáitokat, és javasolják a következő jó lépést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insight pribadi yang membaca pola kalian dan menyarankan langkah berikutnya yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunti privati che leggono le vostre abitudini e suggeriscono la mossa giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの傾向を読み取り、次の一歩を提案するプライベートなインサイト。"
          }
        },
        "ko" : {
