        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลที่แชร์กันยังถูกเก็บไว้ คุณสามารถดูหรือลบได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak verilerin hâlâ kayıtlı; Ayarlar'dan inceleyebilir veya silebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші спільні дані збережено — їх можна переглянути або видалити в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu chung của hai bạn vẫn được lưu — bạn có thể xem lại hoặc xóa trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们的共享数据仍然保留，你可以在“设置”中查看或删除。"
          }
