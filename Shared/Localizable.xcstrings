    "Enter your password above so we can verify your identity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخلوا كلمة السر أعلاه لنتحقّق من هويتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadej výše své heslo, abychom mohli ověřit tvou totožnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast din adgangskode ovenfor, så vi kan bekræfte din identitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib oben dein Passwort ein, damit wir deine Identität prüfen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε τον κωδικό σου παραπάνω για να επαληθεύσουμε την ταυτότητά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce tu contraseña arriba para que podamos verificar tu identidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä salasanasi yllä, jotta voimme vahvistaa henkilöllisyytesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
