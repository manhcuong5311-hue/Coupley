    "There's no wrong answer — this just helps us match the tone of nudges and prompts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد إجابة خاطئة — هذا يساعدنا فقط على ضبط نبرة التذكيرات والاقتراحات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špatná odpověď neexistuje – jen nám to pomůže vyladit tón připomínek a podnětů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen forkerte svar – det hjælper os bare med at ramme tonen i puf og oplæg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine falsche Antwort – so treffen wir einfach den Ton der Stupser und Impulse."
          }
