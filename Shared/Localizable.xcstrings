    "Consistency is the rarest thing. You're doing the rare thing together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستمرار أندر الأشياء، وأنتم تفعلون هذا الأمر النادر معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytrvalost je vzácná. A vy ji máte spolu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedholdenhed er det sjældneste af alt. I gør det sjældne sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beständigkeit ist selten. Und ihr schafft sie gemeinsam."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνέπεια είναι το πιο σπάνιο πράγμα. Κι εσείς το κάνετε μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constancia es lo más difícil. Y los dos lo están logrando juntos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinnikkyys on harvinaista. Te onnistutte siinä yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bihira ang pagiging consistent. At ginagawa ninyo ang bihirang iyon nang magkasama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La régularité, c'est ce qu'il y a de plus rare. Et vous la cultivez ensemble."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמדה היא הדבר הנדיר ביותר. ואתם עושים את הדבר הנדיר הזה ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार बने रहना सबसे दुर्लभ बात है। और आप दोनों साथ मिलकर यही कर रहे हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kitartás a legritkább dolog. Ti együtt csináljátok ezt a ritka dolgot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsistensi itu hal paling langka. Dan kalian melakukannya bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costanza è la cosa più rara. E voi la state coltivando insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けることは何より難しいこと。その難しいことを、ふたりでやり遂げています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾸준함은 정말 드문 일이에요. 두 사람은 그 드문 일을 함께 해내고 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsisten itu perkara yang paling jarang. Anda melakukannya bersama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilitet er det sjeldneste som finnes. Dere gjør det sjeldne sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volhouden is het zeldzaamste wat er is. En jullie doen het samen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsekwencja to rzadkość. A wy razem ją macie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constância é a coisa mais rara. E vocês estão fazendo isso juntos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constanța e lucrul cel mai rar. Iar voi o aveți împreună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постоянство — редкая вещь. А вы делаете эту редкую вещь вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthållighet är det mest sällsynta. Ni gör det sällsynta tillsammans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสม่ำเสมอเป็นสิ่งที่หายากที่สุด และคุณทั้งสองกำลังทำสิ่งนั้นด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstikrar en nadir şeydir. Siz o nadir şeyi birlikte yapıyorsunuz."
