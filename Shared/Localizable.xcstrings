    "Once a letter is opened, it blooms." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حين تُفتح الرسالة، تتفتّح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile se dopis otevře, rozkvete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et brev er åbnet, springer det ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald ein Brief geöffnet ist, blüht er auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις ανοίξει ένα γράμμα, ανθίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se abre una carta, florece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kirje avataan, se puhkeaa kukkaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag nabuksan na ang liham, namumukadkad ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois ouverte, une lettre fleurit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמכתב נפתח, הוא פורח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़त खुलते ही खिल उठता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor egy levelet kinyitnak, kivirágzik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begitu surat dibuka, surat itu mekar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una lettera viene aperta, sboccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手紙が開封されると、花が咲きます。"
