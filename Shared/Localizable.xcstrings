    "No notes this month. Anything you jot down with a check-in lives here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ملاحظات هذا الشهر. كل ما تدوّنونه مع تسجيل المزاج يُحفظ هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento měsíc žádné poznámky. Všechno, co si poznamenáš k záznamu nálady, najdeš tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen noter denne måned. Alt, hvad du skriver ned med et check-in, samles her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Monat keine Notizen. Was du bei einem Check-in notierst, landet hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία σημείωση αυτόν τον μήνα. Ό,τι γράφεις μαζί με μια καταγραφή μένει εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay notas este mes. Lo que anotes al registrar tu ánimo aparecerá aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei muistiinpanoja tässä kuussa. Kaikki, mitä kirjoitat mielialamerkinnän yhteydessä, tallentuu tänne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang tala ngayong buwan. Dito mapupunta ang anumang isusulat mo kasama ng check-in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune note ce mois-ci. Tout ce que tu notes avec un check-in se retrouve ici."
          }
        },
        "he" : {
