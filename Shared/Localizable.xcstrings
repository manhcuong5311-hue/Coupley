    "Know how they feel,\neven when you can't ask." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرفوا شعور شريكك،\nحتى حين يتعذّر السؤال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věz, jak se cítí,\ni když se nemůžeš zeptat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærk, hvordan din partner har det,\nogså når du ikke kan spørge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spür, wie es deinem Schatz geht,\nauch wenn du nicht fragen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθε πώς νιώθει το ταίρι σου,\nακόμα κι όταν δεν μπορείς να ρωτήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre cómo se siente,\naunque no puedas preguntar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedä, miltä hänestä tuntuu,\nvaikket voisi kysyä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamin ang nararamdaman niya,\nkahit hindi mo siya matanong."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sache ce que l'autre ressent,\nmême sans pouvoir demander."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לדעת מה עובר על הצד השני,\nגם כשאי אפשר לשאול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनका हाल जानें,\nतब भी जब पूछ न सकें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudd, hogy érzi magát,\nakkor is, ha nem kérdezheted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu perasaannya,\nbahkan saat kamu tak bisa bertanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri come si sente,\nanche quando non puoi chiederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞けないときも、\n相手の気持ちがわかる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물어보지 못할 때도\n연인의 기분을 알 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu perasaannya,\nwalaupun anda tidak dapat bertanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vit hvordan partneren din har det,\nselv når du ikke kan spørre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet hoe je partner zich voelt,\nook als je het niet kunt vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedz, jak się czuje,\nnawet gdy nie możesz zapytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiba como seu amor está,\nmesmo quando não dá para perguntar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Află cum se simte,\nchiar și când nu poți întreba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знай, что чувствует партнёр,\nдаже когда спросить нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hur din partner mår,\näven när du inte kan fråga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ว่าคนรักรู้สึกอย่างไร\nแม้ในวันที่ถามไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soramadığında bile\nnasıl hissettiğini bil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знай, як почувається половинка,\nнавіть коли не можеш спитати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết người ấy cảm thấy thế nào,\nngay cả khi không thể hỏi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使没法问出口，\n也能知道另一半的感受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就算沒辦法問，\n也知道另一半的感受。"
          }
        }
      }
    },
    "Knowing this helps us suggest the right support" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفة ذلك تساعدنا على اقتراح الدعم المناسب"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díky tomu ti můžeme navrhnout tu správnou podporu"
