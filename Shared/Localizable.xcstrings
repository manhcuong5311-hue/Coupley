    "A balanced contribution makes the win feel mutual. Add a little when you can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساهمة المتوازنة تجعل الفوز مشتركًا. أضيفوا القليل متى استطعتم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyrovnané příspěvky dělají z vítězství společnou věc. Přidej trochu, až to půjde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ligeligt bidrag får sejren til at føles fælles. Tilføj lidt, når du kan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beide etwas beitragen, fühlt sich der Erfolg gemeinsam an. Steuer etwas bei, wenn du kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ισορροπημένη συνεισφορά κάνει τη νίκη κοινή. Πρόσθεσε λίγο όταν μπορείς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aporte equilibrado hace que el logro sea de los dos. Añade un poco cuando puedas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasainen panos tekee voitosta yhteisen. Lisää vähän, kun pystyt."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag balanse ang ambag, pareho ninyong ramdam ang tagumpay. Mag-ambag nang kaunti kapag kaya mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des contributions équilibrées rendent la victoire vraiment commune. Ajoute un peu quand tu peux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תרומה מאוזנת הופכת את הניצחון למשותף. אפשר להוסיף קצת כשמתאפשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बराबर का योगदान जीत को दोनों की जीत बनाता है। जब हो सके, थोड़ा-सा जोड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiegyensúlyozott hozzájárulástól közösnek érződik a siker. Tegyél hozzá egy keveset, amikor tudsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontribusi yang seimbang bikin kemenangan terasa milik berdua. Tambah sedikit kalau bisa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contributo equilibrato rende la vittoria davvero condivisa. Aggiungi qualcosa quando puoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスよく貢献すると、達成の喜びもふたりのものに。できるときに少しずつ加えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "균형 있게 기여하면 성취를 함께 나눌 수 있어요. 여유가 될 때 조금씩 보태 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumbangan yang seimbang menjadikan kejayaan itu milik bersama. Tambah sedikit bila anda mampu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et jevnt bidrag gjør at seieren føles felles. Legg til litt når du kan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een evenwichtige bijdrage maakt de overwinning van jullie allebei. Draag een beetje bij wanneer het kan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równy wkład sprawia, że sukces jest naprawdę wspólny. Dorzuć coś, kiedy możesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contribuições equilibradas fazem a conquista ser dos dois. Contribua um pouco quando puder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O contribuție echilibrată face ca reușita să fie a amândurora. Adaugă și tu puțin când poți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вклад равный, победа ощущается общей. Добавь немного, когда сможешь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämna bidrag gör att vinsten känns gemensam. Lägg till lite när du kan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การมีส่วนร่วมที่สมดุลทำให้ความสำเร็จเป็นของทั้งคู่ ช่วยเติมสักนิดเมื่อสะดวก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengeli katkı, başarıyı ortak hissettirir. Fırsat buldukça biraz ekle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли внески збалансовані, перемога відчувається спільною. Додай трохи, коли зможеш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng góp sức đều tay thì niềm vui mới trọn vẹn cho cả hai. Góp một chút khi bạn có thể nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两人投入均衡，成功才更像共同的成果。有空时也添一点吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙方都有貢獻，成果才更像兩人一起贏來的。有空時也出一點力吧。"
          }
        }
      }
    },
