          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobní postřehy, které rozpoznají vaše vzorce a řeknou vám správný další krok – společně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlige indsigter, der aflæser jeres mønstre og fortæller jer det rette næste skridt – sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persönliche Einblicke, die eure Muster erkennen und euch den richtigen nächsten Schritt zeigen – gemeinsam."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξατομικευμένα ευρήματα που διαβάζουν τα μοτίβα σας και σας λένε το σωστό επόμενο βήμα — μαζί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Análisis personalizados que leen los patrones de los dos y te dicen el siguiente paso adecuado — juntos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilökohtaisia oivalluksia, jotka lukevat tapojanne ja kertovat oikean seuraavan siirron – yhdessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga personalized na insight na bumabasa sa mga pattern ninyo at nagsasabi ng tamang susunod na hakbang — nang magkasama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des éclairages personnalisés qui lisent vos habitudes et vous indiquent la bonne prochaine étape — ensemble."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תובנות אישיות שקוראות את הדפוסים שלכם ומראות לכם את הצעד הנכון הבא — ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्सनल इनसाइट्स जो आपके पैटर्न समझकर बताती हैं कि साथ मिलकर अगला सही क़दम क्या है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Személyre szabott meglátások, amelyek kiolvassák a mintáitokat, és megmutatják a következő jó lépést – együtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insight personal yang membaca pola kalian dan memberi tahu langkah berikutnya yang tepat — bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunti personalizzati che leggono le vostre abitudini e vi indicano la mossa giusta — insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの傾向を読み取り、次の一歩を教えてくれるパーソナライズされたインサイト。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사람의 패턴을 읽고 다음에 함께할 일을 알려 주는 맞춤 인사이트."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandangan peribadi yang membaca corak anda dan memberitahu langkah seterusnya yang tepat — bersama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlig innsikt som leser mønstrene deres og viser riktig neste steg – sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoonlijke inzichten die jullie patronen lezen en de juiste volgende stap aanraden – samen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spersonalizowane spostrzeżenia, które odczytują wasze wzorce i podpowiadają właściwy następny krok – razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights personalizados que leem os padrões de vocês e mostram o próximo passo certo — juntos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observații personalizate care vă citesc tiparele și vă arată următorul pas potrivit — împreună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Персональные инсайты, которые замечают ваши закономерности и подсказывают верный следующий шаг — вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personliga insikter som läser era mönster och visar rätt nästa steg – tillsammans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อินไซต์เฉพาะคุณที่อ่านรูปแบบของคุณ และบอกก้าวต่อไปที่ใช่ เพื่อคุณทั้งสอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örüntülerinizi okuyan ve doğru sonraki adımı söyleyen kişisel içgörüler — birlikte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Персональні інсайти, що бачать ваші закономірності й підказують правильний наступний крок — разом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận định cá nhân hóa, đọc thói quen của hai bạn và gợi ý bước tiếp theo phù hợp — cho cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
