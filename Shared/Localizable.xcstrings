    "A few well-asked questions can move a relationship forward more than a hundred small talks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بضعة أسئلة في محلها قد تدفع العلاقة إلى الأمام أكثر من مئة حديث عابر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pár dobře položených otázek posune vztah dál než sto povrchních rozhovorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle få velvalgte spørgsmål kan bringe et forhold længere end hundrede gange small talk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar gut gestellte Fragen bringen eine Beziehung weiter als hundert Mal Smalltalk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λίγες καλές ερωτήσεις μπορούν να πάνε μια σχέση πιο μπροστά από εκατό κουβεντούλες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas pocas preguntas bien hechas pueden hacer avanzar una relación más que cien charlas triviales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutama hyvin kysytty kysymys voi viedä suhdetta eteenpäin enemmän kuin sata kevyttä jutustelua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang ilang mahusay na tanong ay mas makapagpapausad sa relasyon kaysa sa isang daang maliliit na usapan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques questions bien posées peuvent faire plus avancer une relation qu'une centaine de banalités."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה שאלות טובות יכולות לקדם קשר יותר ממאה שיחות חולין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सही ढंग से पूछे गए कुछ सवाल किसी रिश्ते को सौ छोटी-मोटी बातों से ज़्यादा आगे ले जा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány jól feltett kérdés többet lendíthet egy kapcsolaton, mint száz üres csevegés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa pertanyaan yang tepat bisa memajukan hubungan lebih dari seratus obrolan basa-basi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poche domande ben fatte possono far crescere una relazione più di cento chiacchiere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく考えられたいくつかの質問は、百回の雑談よりも関係を前に進めてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘 던진 질문 몇 개가 백 번의 가벼운 대화보다 관계를 더 깊게 만들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa soalan yang baik boleh memajukan hubungan lebih daripada seratus perbualan kosong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen få godt stilte spørsmål kan ta et forhold lenger enn hundre runder med småprat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar goed gestelde vragen brengen een relatie verder dan honderd keer small talk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilka dobrze zadanych pytań może posunąć związek naprzód bardziej niż sto pogawędek o niczym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas perguntas bem feitas podem levar uma relação mais longe do que cem conversas superficiais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câteva întrebări bine puse pot duce o relație mai departe decât o sută de discuții banale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько удачных вопросов продвинут отношения дальше, чем сотня разговоров ни о чём."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några väl valda frågor kan föra en relation framåt mer än hundra ytliga samtal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำถามดีๆ ไม่กี่ข้ออาจพาความสัมพันธ์ไปข้างหน้าได้มากกว่าการคุยเล่นเป็นร้อยครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İyi sorulmuş birkaç soru, bir ilişkiyi yüzlerce sohbetten daha çok ilerletebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кілька влучних запитань можуть просунути стосунки далі, ніж сотня балачок ні про що."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vài câu hỏi đúng lúc có thể đưa mối quan hệ tiến xa hơn cả trăm câu chuyện phiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几个问对了的问题，比上百次闲聊更能让感情向前一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾個問得好的問題，比上百次閒聊更能讓感情往前走。"
          }
        }
      }
    },
