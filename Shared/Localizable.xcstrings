        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kenangan yang anda tambah menjadi bintang di sekeliling pokok anda. Pasangan anda melihatnya serta-merta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert minne du legger til, blir en stjerne rundt treet deres. Partneren din ser det med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke herinnering die je toevoegt, wordt een ster rond je boom. Je partner ziet hem meteen."
