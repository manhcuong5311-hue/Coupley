            "value" : "ป้อนรหัสผ่านด้านบนเพื่อให้เรายืนยันตัวตนของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimliğini doğrulayabilmemiz için parolanı yukarıya gir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи пароль вище, щоб ми могли підтвердити твою особу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mật khẩu ở trên để chúng mình xác minh danh tính của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在上方输入密码，以便我们验证你的身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在上方輸入密碼，以便我們驗證你的身分。"
          }
        }
      }
    },
