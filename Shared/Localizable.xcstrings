    "You will stop syncing with this person. Your shared data will be kept unless you choose to remove it later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف التناغم مع هذا الشخص. ستبقى بياناتكما المشتركة محفوظة ما لم تختاروا حذفها لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace s touto osobou skončí. Sdílená data zůstanou zachovaná, dokud se je později nerozhodneš odstranit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du holder op med at synkronisere med denne person. Jeres fælles data bevares, medmindre du vælger at fjerne dem senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr seid dann nicht mehr synchronisiert. Eure gemeinsamen Daten bleiben erhalten, solange du sie nicht später entfernst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σταματήσει ο συγχρονισμός με αυτό το άτομο. Τα κοινά σας δεδομένα θα διατηρηθούν, εκτός αν επιλέξεις να τα αφαιρέσεις αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejarás de sincronizar con esta persona. Tus datos compartidos se conservarán a menos que decidas eliminarlos más adelante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietojasi ei enää synkronoida tämän henkilön kanssa. Yhteiset tietonne säilyvät, ellet myöhemmin päätä poistaa niitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihinto ka nang mag-sync sa taong ito. Mananatili ang inyong shared data maliban kung piliin mong alisin ito mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchro avec cette personne s'arrêtera. Vos données partagées seront conservées, sauf si tu choisis de les supprimer plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנכרון עם האדם הזה ייפסק. הנתונים המשותפים יישמרו עד שבוחרים להסיר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस व्यक्ति के साथ आपका सिंक रुक जाएगा। आपका साझा डेटा तब तक रखा रहेगा, जब तक आप उसे बाद में हटाना न चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszűnik a szinkronizálás ezzel a személlyel. A közös adataitok megmaradnak, hacsak később nem döntesz a törlésükről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak akan lagi sinkron dengan orang ini. Data bersama kalian tetap disimpan, kecuali kamu memilih menghapusnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetterai di sincronizzarti con questa persona. I dati condivisi verranno conservati, a meno che tu non scelga di rimuoverli in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパートナーとのシンクロが停止します。共有データは、あとで削除を選ばない限り保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사람과 더 이상 동기화되지 않아요. 함께한 데이터는 나중에 직접 삭제하기 전까지 보관돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan berhenti menyegerak dengan orang ini. Data kongsi anda akan disimpan melainkan anda memilih untuk membuangnya kemudian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du slutter å synkronisere med denne personen. De felles dataene deres beholdes, med mindre du velger å fjerne dem senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je synchroniseert niet meer met deze persoon. Jullie gedeelde gegevens blijven bewaard, tenzij je ze later verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja z tą osobą zostanie zatrzymana. Wasze wspólne dane zostaną zachowane, chyba że później zdecydujesz się je usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sintonia com essa pessoa vai parar. Seus dados compartilhados serão mantidos, a menos que você decida removê-los depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu te vei mai sincroniza cu această persoană. Datele voastre comune rămân păstrate, dacă nu alegi să le ștergi mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация с этим человеком прекратится. Общие данные сохранятся, если только ты не решишь удалить их позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni slutar synka med varandra. Er gemensamma data sparas om du inte väljer att ta bort den senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะหยุดซิงค์กับคนนี้ ข้อมูลที่แชร์กันจะยังถูกเก็บไว้ เว้นแต่คุณเลือกลบในภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kişiyle senkronizasyon duracak. Ortak verilerin, sonradan kaldırmayı seçmediğin sürece saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію з цією людиною буде зупинено. Ваші спільні дані залишаться, доки ти не вирішиш їх видалити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ ngừng đồng bộ với người này. Dữ liệu chung vẫn được giữ lại, trừ khi sau này bạn chọn xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将停止与对方同步。你们的共享数据会被保留，除非你之后选择删除。"
