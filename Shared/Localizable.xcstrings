            "value" : "बचत वाला लक्ष्य खोलें — हमने शुरुआत कर दी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyisd meg a megtakarítási célt – már el is kezdtük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka target tabungannya — kita sudah mulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri l’obiettivo di risparmio — abbiamo già iniziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貯金の目標を開こう。もう始めてるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저축 목표 열어 보기 — 이미 시작했어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka matlamat simpanan — kita sudah pun mula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne sparemålet – vi har allerede begynt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het spaardoel – we zijn al begonnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz cel oszczędnościowy – już na niego odkładamy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir a meta de economia — já começamos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschidem obiectivul de economii — am început deja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть цель накоплений — мы уже начали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna sparmålet – vi har redan börjat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดเป้าหมายการออม เราเริ่มกันแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birikim hedefini aç — çoktan başladık."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрити ціль заощаджень — ми вже почали."
