          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão da conta ainda não está disponível para o método de login %@. Entre em contato com o suporte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergerea contului nu e încă disponibilă pentru metoda de conectare %@. Contactează asistența."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление аккаунта со способом входа %@ пока не поддерживается. Напиши в поддержку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att radera konton med inloggningsmetoden %@ än. Kontakta supporten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่รองรับการลบบัญชีสำหรับวิธีเข้าสู่ระบบ %@ โปรดติดต่อฝ่ายสนับสนุน"
