        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După ce e sigilată, nu o mai poți edita. Poți anula trimiterea până se deschide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запечатанное письмо нельзя изменить. Отозвать его можно до открытия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När brevet är förseglat kan du inte redigera det. Du kan dra tillbaka det tills det öppnas."
