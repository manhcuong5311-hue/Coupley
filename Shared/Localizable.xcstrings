    "%@ will see it's on its way, but can't read a word until the moment you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر لدى %@ أنها في طريقها، لكن لن تُقرأ منها كلمة واحدة قبل اللحظة التي تختارونها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uvidí, že je dopis na cestě, ale nepřečte z něj ani slovo, dokud nenastane chvíle, kterou zvolíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan se, at det er på vej, men kan ikke læse et ord før det øjeblik, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sieht, dass der Brief unterwegs ist, kann aber kein Wort lesen, bis der von dir gewählte Moment da ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα φαίνεται ότι το γράμμα έρχεται, αλλά για %@ θα μείνει σφραγισμένο μέχρι τη στιγμή που θα διαλέξεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verá que va en camino, pero no podrá leer ni una palabra hasta el momento que elijas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ näkee, että kirje on tulossa, mutta ei voi lukea sanaakaan ennen valitsemaasi hetkeä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makikita ni %@ na papunta na ito, pero wala siyang mababasa hanggang sa sandaling pipiliin mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verra qu'elle est en route, mais ne pourra pas en lire un mot avant le moment que tu as choisi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצל %@ יופיע שהמכתב בדרך, אבל אי אפשר יהיה לקרוא בו אף מילה עד הרגע שבחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को दिखेगा कि ख़त आ रहा है, पर आपके चुने हुए पल तक उसका एक शब्द भी पढ़ा नहीं जा सकेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ látni fogja, hogy úton van, de egy szót sem olvashat el belőle az általad választott pillanatig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan tahu suratnya sedang dalam perjalanan, tapi tidak bisa membaca satu kata pun sampai momen yang kamu pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vedrà che è in arrivo, ma non potrà leggerne una parola fino al momento che scegli tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には手紙が届くことだけが伝わり、選んだ日時が来るまで中身は一文字も読めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 편지가 오고 있다는 건 알 수 있지만, 정한 순간이 오기 전까지는 한 글자도 읽을 수 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan tahu surat ini sedang dalam perjalanan, tetapi tidak dapat membaca sepatah pun sehingga saat yang anda pilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ser at det er på vei, men kan ikke lese et ord før øyeblikket du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ziet dat er een brief onderweg is, maar kan er geen woord van lezen tot het moment dat jij kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zobaczy, że list jest w drodze, ale nie przeczyta ani słowa aż do wybranej przez ciebie chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vai ver que a carta está a caminho, mas só vai poder ler no momento que você escolher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va vedea că e pe drum, dar nu va putea citi niciun cuvânt până în momentul ales de tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ увидит, что письмо в пути, но не прочтёт ни слова до выбранного тобой момента."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ser att det är på väg, men kan inte läsa ett ord förrän i det ögonblick du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จะเห็นว่าจดหมายกำลังมา แต่อ่านไม่ได้สักคำจนถึงเวลาที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mektubun yolda olduğunu görecek ama seçtiğin ana kadar tek kelimesini okuyamayacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ бачитиме, що лист уже в дорозі, але не прочитає жодного слова до обраного тобою моменту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ biết có thư đang đến, nhưng không đọc được chữ nào cho đến lúc bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@会知道有一封信正在路上，但在你选定的时刻之前，一个字也看不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@會知道有封信正在路上，但在你選定的時刻之前，一個字也看不到。"
          }
        }
      }
    },
