    "Less misreading.\nMore being heard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوء فهم أقل.\nوإصغاء أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méně nepochopení.\nVíc naslouchání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Færre misforståelser.\nMere følelsen af at blive hørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Missverstehen.\nMehr Gehörtwerden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λιγότερες παρανοήσεις.\nΠερισσότερη κατανόηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos malentendidos.\nMás sentir que te escuchan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähemmän väärintulkintoja.\nEnemmän kuulluksi tulemista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas kaunting maling basa.\nMas madalas na napapakinggan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de malentendus.\nPlus d'écoute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פחות פרשנויות שגויות.\nיותר הקשבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम ग़लतफ़हमियाँ।\nज़्यादा सुने जाने का एहसास।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevesebb félreértés.\nTöbb meghallgatás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih sedikit salah tangkap.\nLebih banyak didengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno fraintendimenti.\nPiù ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤解は少なく、\nもっと伝わる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오해는 줄이고,\n마음은 더 잘 전해지게."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang salah faham.\nLebih didengari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre feiltolking.\nMer lydhørhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder verkeerd begrijpen.\nMeer gehoord worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniej nieporozumień.\nWięcej wzajemnego słuchania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos mal-entendidos.\nMais escuta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai puține neînțelegeri.\nMai multă ascultare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше недопонимания.\nБольше понимания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färre missförstånd.\nOch att verkligen bli hörd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข้าใจผิดน้อยลง\nได้รับการรับฟังมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha az yanlış anlaşılma.\nDaha çok duyulma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менше непорозумінь.\nБільше почутого."
          }
        },
        "vi" : {
          "stringUnit" : {
