    "Pick the day your story began. Your tree grows from it, and %@ sees it too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا اليوم الذي بدأت فيه قصتكما. منه تنمو شجرتكما، وهو ظاهر لـ %@ أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber den, kdy začal váš příběh. Od něj poroste váš strom a uvidí ho i %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg den dag, jeres historie begyndte. Jeres træ vokser fra den, og %@ kan også se den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Tag, an dem eure Geschichte begann. Euer Baum wächst ab diesem Tag, und %@ sieht das Datum auch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε τη μέρα που ξεκίνησε η ιστορία σας. Το δέντρο σας μεγαλώνει από τότε και το βλέπει και %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el día en que empezó la historia de los dos. Tu árbol crece desde ese día, y %@ también lo ve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse päivä, jona tarinanne alkoi. Puunne kasvaa siitä, ja %@ näkee sen myös."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang araw na nagsimula ang kuwento ninyo. Diyan lalaki ang puno ninyo, at makikita rin ito ni %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis le jour où votre histoire a commencé. Votre arbre grandit à partir de là, et %@ le voit aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוחרים את היום שבו הסיפור שלכם התחיל. העץ גדל ממנו, והוא גלוי גם ל־%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह दिन चुनें जब आपकी कहानी शुरू हुई। आपका पेड़ उसी दिन से बढ़ता है, और %@ को भी यह दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki a napot, amikor a történetetek elkezdődött. A fátok ettől a naptól nő, és %@ is látja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih hari kisah kalian dimulai. Pohonmu tumbuh dari hari itu, dan %@ juga bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il giorno in cui è iniziata la vostra storia. Il vostro albero cresce da lì, e lo vede anche %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの物語が始まった日を選んでください。その日からツリーが育ち、%@さんにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사람의 이야기가 시작된 날을 골라 주세요. 그날부터 나무가 자라고, %@ 님도 함께 볼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih hari kisah anda bermula. Pokok anda membesar dari hari itu, dan %@ juga dapat melihatnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg dagen historien deres begynte. Treet vokser fra den dagen, og %@ ser den også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de dag waarop jullie verhaal begon. Je boom groeit vanaf die dag, en %@ ziet hem ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz dzień, w którym zaczęła się wasza historia. Od niego rośnie twoje drzewo, a %@ też go widzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o dia em que a história de vocês começou. Sua árvore cresce a partir dele, e %@ também vê."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege ziua în care a început povestea voastră. Copacul crește din ea, iar data e vizibilă și pentru %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери день, когда началась ваша история. Дерево будет расти с него, и %@ тоже его увидит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj dagen er berättelse började. Ert träd växer från den, och %@ ser den också."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกวันที่เรื่องราวของคุณเริ่มต้น ต้นไม้จะเติบโตจากวันนั้น และ %@ ก็เห็นด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hikâyenizin başladığı günü seç. Ağacın o günden itibaren büyür ve bu tarih %@ için de görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обери день, коли почалася ваша історія. Від нього росте ваше дерево, і %@ теж це бачить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngày câu chuyện của hai bạn bắt đầu. Cây sẽ lớn lên từ ngày đó, và %@ cũng thấy được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你们故事开始的那一天。你们的树会从那天开始生长，%@也能看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你們故事開始的那一天。你們的樹會從那天開始長大，%@也看得到。"
          }
        }
      }
    },
