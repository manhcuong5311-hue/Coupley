    "%@ already answered. Yours stays hidden until you do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت إجابة %@. ستبقى مخفية حتى تُجيبوا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už má odpovězeno. Odpověď zůstane skrytá, dokud neodpovíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har allerede svaret. Svaret forbliver skjult, indtil du svarer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat schon geantwortet. Deine Antwort bleibt verborgen, bis du antwortest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ απάντησε ήδη. Η απάντησή σου μένει κρυφή μέχρι να απαντήσεις κι εσύ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya respondió. Su respuesta seguirá oculta hasta que respondas tú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vastasi jo. Vastaus pysyy piilossa, kunnes vastaat itse."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakasagot na si %@. Nakatago ang sagot mo hanggang sumagot ka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a déjà répondu. Sa réponse reste cachée jusqu'à ce que tu répondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשובה של %@ כבר כאן. התשובה שלך תישאר מוסתרת עד שגם היא תישלח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ जवाब दे चुके हैं। जब तक आप जवाब नहीं देते, उनका जवाब छिपा रहेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ már válaszolt. A válasza rejtve marad, amíg meg nem adod a tiédet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah menjawab. Jawabannya tetap tersembunyi sampai kamu menjawab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha già risposto. La sua risposta resta nascosta finché non rispondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんはもう答えました。あなたが答えるまで、あなたの答えは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 이미 답했어요. 내가 답하기 전까지 내 답은 가려져 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah menjawab. Jawapan anda kekal tersembunyi sehingga anda menjawab."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har allerede svart. Ditt svar forblir skjult til du svarer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft al geantwoord. Jouw antwoord blijft verborgen tot jij hebt geantwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – odpowiedź już jest. Twoja pozostanie ukryta, dopóki nie odpowiesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já respondeu. A resposta fica escondida até você responder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a răspuns deja. Răspunsul tău rămâne ascuns până răspunzi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ответ уже есть. Он скрыт, пока ты не ответишь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har redan svarat. Ditt svar är dolt tills du svarar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ตอบแล้ว คำตอบของคุณจะถูกซ่อนไว้จนกว่าคุณจะตอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıtladı. Yanıtı, sen yanıtlayana kadar gizli kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: відповідь уже є. Вона прихована, доки ти не відповіси."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã trả lời rồi. Câu trả lời của người ấy sẽ ẩn cho đến khi bạn trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已经回答了。你回答之前，答案都会保持隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已經回答了。在你作答之前，對方的答案會先隱藏。"
          }
        }
      }
