    "Opens %@, for both of you." : {
      "comment" : "VoiceOver: when a memory capsule opens. %@ is a date such as 'January 26, 2027'.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح في %@، لكليكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře se %@, pro vás oba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner %@, for jer begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet sich am %@, für euch beide."
          }
        },
