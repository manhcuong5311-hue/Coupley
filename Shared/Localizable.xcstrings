    "Add the Coupley widget so you can see their day at a glance — without ever opening the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفوا أداة Coupley لرؤية يوم شريكك بنظرة — دون فتح التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej si widget Coupley a uvidíš den svého protějšku na první pohled – bez otevírání aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj Coupley-widgetten, så du kan se din partners dag med et blik – uden nogensinde at åbne appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füg das Coupley-Widget hinzu, dann siehst du den Tag deines Schatzes auf einen Blick – ohne die App zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε το widget του Coupley για να βλέπεις τη μέρα του ταιριού σου με μια ματιά — χωρίς να ανοίγεις καν την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el widget de Coupley para ver su día de un vistazo — sin abrir la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää Coupley-widget, niin näet hänen päivänsä yhdellä silmäyksellä – avaamatta sovellusta lainkaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang Coupley widget para makita mo ang araw niya sa isang sulyap — nang hindi binubuksan ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute le widget Coupley pour voir sa journée en un coup d'œil — sans même ouvrir l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיפים את הווידג'ט של Coupley ורואים את היום של הצד השני במבט אחד — בלי לפתוח את האפליקציה."
          }
        },
        "hi" : {
