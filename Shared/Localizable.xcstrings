    "%lld days together. %@. %@" : {
      "comment" : "VoiceOver summary of the Journey hero: day count, then the tree stage name, then its caption (a full sentence).",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld أيام معًا. %2$@. %3$@"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld يومًا معًا. %2$@. %3$@"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يوم واحد معًا. %2$@. %3$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld يوم معًا. %2$@. %3$@"
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يومان معًا. %2$@. %3$@"
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld يوم معًا. %2$@. %3$@"
                }
