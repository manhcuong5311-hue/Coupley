    "The yes you'll never forget." : {
      "comment" : "Placeholder for the note of a Proposal memory",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الـ«نعم» التي لن تُنسى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ano, na které nikdy nezapomeneš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ja, I aldrig glemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ja, das ihr nie vergessen werdet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «ναι» που δεν θα ξεχάσετε ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sí que nunca olvidarás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ”kyllä”, jota ette koskaan unohda."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang “oo” na hindi mo malilimutan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le oui que tu n'oublieras jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה\"כן\" שלעולם לא תשכחו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह ‘हाँ’ जिसे आप कभी नहीं भूलेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az igen, amit sosem felejtesz el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ya” yang tak akan pernah kamu lupakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sì che non dimenticherete mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一生忘れない「イエス」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 잊지 못할 그 대답."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ya” yang tidak akan anda lupakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaet du aldri vil glemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ja dat je nooit vergeet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To „tak”, którego nigdy nie zapomnisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sim que vocês nunca vão esquecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acel „da” pe care nu-l veți uita niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То самое «да», которое не забыть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ja du aldrig kommer att glömma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำว่า “ตกลง” ที่จะไม่มีวันลืม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla unutmayacağın o “evet”."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Так», яке ви ніколи не забудете."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời “đồng ý” bạn sẽ không bao giờ quên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那个永远难忘的“我愿意”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那個你永遠不會忘記的「我願意」。"
          }
        }
      }
    },
