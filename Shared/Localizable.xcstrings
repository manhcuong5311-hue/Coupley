    "Set the cadence and time that fits your day. You can always change it later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا الوتيرة والوقت المناسبين ليومكم. يمكن تغييرهما لاحقًا في أي وقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav frekvenci a čas, které ti sedí. Kdykoli to můžeš změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg den hyppighed og det tidspunkt, der passer til din dag. Du kan altid ændre det senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg Rhythmus und Uhrzeit fest, wie es zu deinem Tag passt. Du kannst das jederzeit ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρισε τη συχνότητα και την ώρα που ταιριάζουν στη μέρα σου. Μπορείς πάντα να τα αλλάξεις αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la frecuencia y la hora que mejor encajen en tu día. Puedes cambiarlo cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse sinun päivääsi sopiva tiheys ja kellonaika. Voit aina muuttaa niitä myöhemmin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itakda ang dalas at oras na bagay sa araw mo. Puwede mo itong baguhin anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis la fréquence et l'heure qui conviennent à ta journée. Tu pourras toujours les modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוחרים את התדירות והשעה שמתאימות ליום שלך. תמיד אפשר לשנות אחר כך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने दिन के हिसाब से कितनी बार और किस समय, यह चुनें। इसे बाद में कभी भी बदला जा सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsd be a gyakoriságot és az időpontot, ami illik a napodhoz. Később bármikor módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur frekuensi dan waktu yang pas dengan harimu. Kamu selalu bisa mengubahnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta frequenza e orario adatti alla tua giornata. Potrai sempre cambiarli in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日に合った頻度と時間を設定しましょう。あとからいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 맞는 빈도와 시간을 정해 주세요. 언제든 나중에 바꿀 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan kekerapan dan masa yang sesuai dengan hari anda. Anda sentiasa boleh mengubahnya kemudian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hyppighet og tidspunkt som passer dagen din. Du kan alltid endre det senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe vaak en hoe laat het in je dag past. Je kunt het altijd later wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw częstotliwość i porę, które pasują do twojego dnia. Zawsze możesz to później zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a frequência e o horário que combinam com seu dia. Dá para mudar depois quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege frecvența și ora potrivite zilei tale. Le poți schimba oricând mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери частоту и время, которые подходят твоему дню. Это всегда можно изменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj hur ofta och när det passar din dag. Du kan alltid ändra det senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งความถี่และเวลาที่เข้ากับวันของคุณ เปลี่ยนภายหลังได้เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gününe uyan sıklığı ve saati ayarla. İstediğin zaman değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обери частоту й час, що пасують твоєму дню. Це завжди можна змінити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tần suất và thời gian hợp với ngày của bạn. Bạn luôn có thể đổi sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置适合你的提醒频率和时间，之后随时可以更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定適合你生活的頻率和時間，之後隨時可以更改。"
          }
        }
      }
    },
    "Set the day it started" : {
