    "Opens %@ your time. %@ sees it in their own time zone." : {
      "comment" : "Under the date picker. The first %@ is a moment, such as 'tomorrow at 9:00 AM'; the second is the partner's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح %1$@ بتوقيتك، ولدى %2$@ وفق التوقيت المحلي هناك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře se %1$@ podle tvého času. %2$@ ho uvidí ve svém časovém pásmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner %1$@ din tid. %2$@ ser det i sin egen tidszone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet sich %1$@ nach deiner Zeit. %2$@ sieht ihn in der eigenen Zeitzone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει %1$@ με τη δική σου ώρα. Για %2$@ ισχύει η τοπική ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opens %1$@ your time. %2$@ sees it in their own time zone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abre %1$@ (tu hora). %2$@ la verá en su propia zona horaria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeaa %1$@ sinun aikavyöhykkeesi mukaan. %2$@ näkee sen oman aikavyöhykkeensä mukaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabubuksan %1$@ sa oras mo. Makikita ito ni %2$@ sa sarili niyang time zone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ouvre %1$@ (ton heure). %2$@ la recevra selon son propre fuseau horaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייפתח %1$@ לפי השעה שלך. אצל %2$@ — לפי אזור הזמן המקומי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके समय के हिसाब से %1$@ को खुलेगा। %2$@ को यह उनके अपने टाइम ज़ोन में दिखेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyílik: %1$@ (a te időd szerint). %2$@ a saját időzónája szerint látja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuka %1$@ waktumu. %2$@ melihatnya sesuai zona waktunya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si apre %1$@ secondo il tuo orario. %2$@ la vedrà nel proprio fuso orario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの時間で%1$@に開封されます。%2$@には相手のタイムゾーンで届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 시간 기준 %1$@에 열려요. %2$@ 님은 자신의 시간대로 보게 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuka %1$@ waktu anda. %2$@ akan melihatnya mengikut zon waktunya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpnes %1$@ etter din tid. %2$@ ser det i sin egen tidssone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat %1$@ open in jouw tijd. %2$@ ziet hem in de eigen tijdzone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera się %1$@ według twojego czasu. %2$@ zobaczy go w swojej strefie czasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre %1$@ no seu horário. %2$@ recebe no próprio fuso horário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deschide %1$@, ora ta. %2$@ o vede în propriul fus orar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откроется %1$@ по твоему времени. %2$@ увидит его по своему часовому поясу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnas %1$@ din tid. %2$@ ser det i sin egen tidszon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดได้ %1$@ ตามเวลาของคุณ %2$@ จะเห็นตามเขตเวลาของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senin saatinle açılış: %1$@. %2$@ kendi saat diliminde görecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриється %1$@ за твоїм часом. %2$@ побачить його за своїм часовим поясом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở vào %1$@ theo giờ của bạn. %2$@ sẽ thấy theo múi giờ của người ấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的时间，%1$@开启。%2$@会按自己的时区看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依你的時間%1$@開啟。%2$@會在自己的時區看到。"
          }
        }
      }
    },
