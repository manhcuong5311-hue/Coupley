          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों पार्टनर यह लक्ष्य देख सकते हैं और इसमें योगदान दे सकते हैं। आप इसे कभी भी बदल या हटा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
