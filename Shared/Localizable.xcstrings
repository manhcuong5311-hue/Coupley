    "Removes messages, moods, quizzes, letters, and insights tied to this connection from the server. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف من الخادم الرسائل والحالات المزاجية والاختبارات والرسائل للمستقبل والرؤى المرتبطة بهذا الارتباط. لا يمكن التراجع عن ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze serveru se odstraní zprávy, nálady, kvízy, dopisy a postřehy spojené s tímto propojením. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner beskeder, humør, quizzer, breve og indsigter knyttet til denne forbindelse fra serveren. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Nachrichten, Stimmungen, Quizze, Briefe und Einblicke dieser Verbindung vom Server. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί από τον διακομιστή μηνύματα, διαθέσεις, κουίζ, γράμματα και ευρήματα που συνδέονται με αυτή τη σύνδεση. Δεν μπορεί να αναιρεθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina del servidor los mensajes, estados de ánimo, tests, cartas y análisis vinculados a esta conexión. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa palvelimelta tähän yhteyteen liittyvät viestit, mielialat, visat, kirjeet ja oivallukset. Tätä ei voi kumota."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaalis sa server ang mga mensahe, mood, quiz, liham, at insight na konektado sa koneksyong ito. Hindi na ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime du serveur les messages, humeurs, quiz, lettres et éclairages liés à cette connexion. Action irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההודעות, מצבי הרוח, החידונים, המכתבים והתובנות של החיבור הזה יימחקו מהשרת. אי אפשר לבטל את הפעולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कनेक्शन से जुड़े मैसेज, मूड, क्विज़, ख़त और इनसाइट्स सर्वर से हटा दिए जाएँगे। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
