    "Invite your partner in — even a small contribution makes this *theirs* too." : {
      "comment" : "Coach insight detail. The asterisks are shown as typed (emphasis)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
