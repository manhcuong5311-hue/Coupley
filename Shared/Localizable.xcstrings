    "Prefers quiet, thoughtful exchanges" : {
      "comment" : "Description of the 'Introvert' communication style",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفضيل الأحاديث الهادئة المتأنية"
