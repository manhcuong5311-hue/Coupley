    "Your account and all your data have been removed. You'll be signed out automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف حسابك وكل بياناتك. سيتم تسجيل خروجك تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj účet a všechna data byla odstraněna. Za chvíli dojde k automatickému odhlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto og alle dine data er fjernet. Du bliver logget ud automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Account und alle deine Daten wurden entfernt. Du wirst automatisch abgemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός σου και όλα τα δεδομένα σου αφαιρέθηκαν. Θα αποσυνδεθείς αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos tus datos se han eliminado. Se cerrará tu sesión automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi ja kaikki tietosi on poistettu. Sinut kirjataan ulos automaattisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naalis na ang account mo at lahat ng data mo. Awtomatiko kang masa-sign out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte et toutes tes données ont été supprimés. La déconnexion va se faire automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון שלך וכל הנתונים שלך הוסרו. ההתנתקות תתבצע אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका अकाउंट और आपका सारा डेटा हटा दिया गया है। आप अपने-आप साइन आउट हो जाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiókodat és minden adatodat eltávolítottuk. Automatikusan kijelentkeztetünk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun dan semua datamu sudah dihapus. Kamu akan otomatis keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account e tutti i tuoi dati sono stati rimossi. La sessione verrà chiusa automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとすべてのデータを削除しました。自動的にサインアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 모든 데이터가 삭제됐어요. 곧 자동으로 로그아웃돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun anda dan semua data anda telah dibuang. Anda akan dilog keluar secara automatik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din og alle dataene dine er fjernet. Du blir logget ut automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account en al je gegevens zijn verwijderd. Je wordt automatisch uitgelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto i wszystkie dane zostały usunięte. Nastąpi automatyczne wylogowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta e todos os seus dados foram removidos. Sua sessão será encerrada automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contul tău și toate datele tale au fost șterse. Vei ieși automat din cont."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой аккаунт и все данные удалены. Выход из аккаунта произойдёт автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto och all din data har tagits bort. Du loggas ut automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชีและข้อมูลทั้งหมดของคุณถูกลบแล้ว คุณจะออกจากระบบโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın ve tüm verilerin kaldırıldı. Otomatik olarak çıkış yapılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій акаунт і всі дані видалено. Вихід відбудеться автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản và toàn bộ dữ liệu của bạn đã được xóa. Bạn sẽ được đăng xuất tự động."
          }
        },
        "zh-Hans" : {
