        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อผนึกแล้วจะแก้ไขไม่ได้ แต่ยกเลิกการส่งได้จนกว่าจะถึงเวลาเปิด"
