    "Healthy but uneven — room to deepen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علاقة صحية لكن غير متوازنة، وفيها مجال للتعمّق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravé, ale nevyrovnané – je co prohlubovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sundt, men ujævnt – plads til at gå dybere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesund, aber unausgeglichen – da geht noch mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υγιής αλλά άνιση — έχει περιθώριο να βαθύνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana pero desigual: hay margen para profundizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terve mutta epätasainen – varaa syventää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malusog pero hindi pantay — may puwang pang lumalim."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une relation saine mais inégale : il y a de quoi approfondir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בריא אבל לא אחיד — יש מקום להעמיק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेहतमंद, पर सब बराबर नहीं — गहराई की गुंजाइश है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egészséges, de egyenetlen – van hová mélyülni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehat tapi belum merata — masih bisa diperdalam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ma disomogenea — c’è spazio per crescere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康的ですが、ばらつきがあります。もっと深め合える余地があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강하지만 고르지 않아요. 더 깊어질 여지가 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sihat tetapi tidak seimbang — masih boleh diperdalam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt, men ujevnt – rom for å gå dypere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezond maar ongelijk – ruimte om te verdiepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowo, ale nierówno – jest co pogłębiać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saudável, mas desigual — dá para aprofundar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sănătoasă, dar inegală — e loc de mai multă profunzime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё хорошо, но неровно — есть куда расти."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sund men ojämn – utrymme att fördjupa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุขภาพดีแต่ยังไม่สม่ำเสมอ ยังลึกซึ้งได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlıklı ama dengesiz; derinleşmeye alan var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здорові, але нерівномірні — є куди рости."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tốt nhưng chưa đều — vẫn có thể gắn bó sâu hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
