        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điểm danh mỗi ngày tạo nên những thói quen nhỏ — chất liệu của tình yêu lâu dài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
