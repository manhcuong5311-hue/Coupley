    "Seven years. Rare, and still growing." : {
      "comment" : "Crown celebration subtitle: 7 years together",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبعة أعوام. نادرة، وما زالت تنمو."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedm let. Vzácnost, která pořád roste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syv år. Sjældent, og stadig i vækst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieben Jahre. Selten, und ihr wachst weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επτά χρόνια. Κάτι σπάνιο που ακόμα μεγαλώνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete años. Algo poco común, y sigue creciendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitsemän vuotta. Harvinaista – ja yhä kasvussa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitong taon. Bihira, at lumalago pa rin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sept ans. Rare, et ça grandit encore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שבע שנים. נדיר, ועדיין צומח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सात साल। दुर्लभ, और अब भी बढ़ता हुआ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hét év. Ritka, és még mindig nő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuh tahun. Langka, dan masih terus tumbuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sette anni. Una rarità, e cresce ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7年。かけがえのない、まだ育つツリー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7년. 귀하고, 여전히 자라고 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuh tahun. Jarang ditemui, dan masih terus membesar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sju år. Sjeldent, og fortsatt i vekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeven jaar. Zeldzaam, en nog steeds groeiend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
