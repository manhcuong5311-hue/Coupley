        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah mengirim fotonya. Fotonya tetap tersembunyi sampai kamu mengirim juga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha già inviato la sua. Resta nascosta finché non invii la tua."
