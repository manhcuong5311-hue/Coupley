    },
    "Help on important moments — birthdays, fights, the in-between" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عون في اللحظات المهمة — أعياد الميلاد، والخلافات، وما بينهما"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomoc v důležitých chvílích – narozeniny, hádky i všechno mezi tím"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælp i vigtige øjeblikke – fødselsdage, skænderier og alt derimellem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfe in wichtigen Momenten – bei Geburtstagen, Streit und allem dazwischen"
