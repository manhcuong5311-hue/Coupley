    "The person who bought Remove Ads stays ad-free on any new pairing. The other partner sees ads again until they pair with someone who bought it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من اشترى «إزالة الإعلانات» يبقى بلا إعلانات في أي ارتباط جديد. أما الشريك الآخر فتعود إليه الإعلانات حتى يرتبط بشخص اشتراها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo má zakoupenou funkci Odstranit reklamy, zůstává bez reklam i v každém novém propojení. Druhá strana bude reklamy znovu vidět, dokud se nepropojí s někým, kdo ji má zakoupenou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der købte Fjern reklamer, forbliver reklamefri i enhver ny forbindelse. Den anden ser reklamer igen, indtil vedkommende forbinder med en, der har købt det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer „Werbung entfernen“ gekauft hat, bleibt auch bei jeder neuen Verbindung werbefrei. Die andere Person sieht wieder Werbung, bis sie sich mit jemandem verbindet, der den Kauf getätigt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος αγόρασε την Αφαίρεση διαφημίσεων μένει χωρίς διαφημίσεις σε κάθε νέα σύνδεση. Το άλλο ταίρι βλέπει ξανά διαφημίσεις μέχρι να συνδεθεί με κάποιον που την έχει αγοράσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien compró Quitar anuncios sigue sin anuncios en cualquier conexión nueva. La otra persona vuelve a ver anuncios hasta que se conecte con alguien que lo haya comprado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista mainokset -oston tehnyt pysyy mainoksettomana myös uusissa yhteyksissä. Toinen osapuoli näkee taas mainoksia, kunnes hän yhdistyy jonkun oston tehneen kanssa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatiling walang ads ang taong bumili ng Alisin ang ads sa anumang bagong pagkonekta. Makakakita ulit ng ads ang isa pang partner hanggang makakonekta siya sa taong bumili nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne qui a acheté Supprimer les pubs reste sans pub avec toute nouvelle connexion. L'autre revoit des pubs jusqu'à se connecter avec quelqu'un qui l'a acheté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שרכש את הסרת הפרסומות נשאר בלי פרסומות גם בכל חיבור חדש. הצד השני יראה שוב פרסומות, עד שיתחבר למישהו שרכש אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिसने विज्ञापन हटाएँ ख़रीदा है, वह किसी भी नई जोड़ी में विज्ञापन-मुक्त रहता है। दूसरे पार्टनर को फिर से विज्ञापन दिखेंगे, जब तक वे किसी ऐसे व्यक्ति से नहीं जुड़ते जिसने इसे ख़रीदा हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aki megvásárolta a Reklámok eltávolítását, az minden új összekapcsolásnál reklámmentes marad. A másik fél újra reklámokat lát, amíg nem kapcsolódik valakihez, aki megvásárolta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang membeli Hapus Iklan tetap bebas iklan di koneksi baru mana pun. Pasangan satunya akan melihat iklan lagi sampai terhubung dengan seseorang yang sudah membelinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha acquistato Rimuovi pubblicità resta senza pubblicità anche con un nuovo collegamento. L’altro partner rivede la pubblicità finché non si collega con qualcuno che l’ha acquistato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「広告を削除」を購入した人は、新しくペアリングしても広告なしのままです。もう一方のパートナーは、購入した人とペアリングするまで再び広告が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 제거를 구매한 사람은 새로 연결해도 계속 광고 없이 이용할 수 있어요. 다른 한 사람은 광고 제거를 구매한 사람과 연결하기 전까지 다시 광고가 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang membeli Buang Iklan kekal bebas iklan dalam sebarang sambungan baharu. Pasangan yang satu lagi akan melihat iklan semula sehingga dia bersambung dengan seseorang yang telah membelinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som kjøpte Fjern reklame, forblir reklamefri ved enhver ny sammenkobling. Den andre ser reklame igjen frem til en ny sammenkobling med noen som har kjøpt det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Verwijder advertenties heeft gekocht, blijft advertentievrij bij elke nieuwe koppeling. De ander ziet weer advertenties, tot die koppelt met iemand die het heeft gekocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, która kupiła Usuń reklamy, nadal nie widzi reklam w każdym nowym połączeniu. Druga osoba znów widzi reklamy, dopóki nie połączy się z kimś, kto je kupił."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem comprou o Remover anúncios continua sem anúncios em qualquer nova conexão. A outra pessoa volta a ver anúncios até se conectar com alguém que tenha comprado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cine a cumpărat Elimină reclamele rămâne fără reclame la orice nouă conectare. Celălalt partener vede din nou reclame până se conectează cu cineva care a făcut achiziția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У того, кто купил «Убрать рекламу», реклама не появится и в новой паре. Другой партнёр снова будет видеть рекламу, пока не объединится с тем, у кого есть эта покупка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som köpte Ta bort annonser förblir reklamfri i varje ny koppling. Den andra personen ser annonser igen tills den kopplas ihop med någon som har köpt det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ซื้อลบโฆษณาจะไม่มีโฆษณาต่อไปแม้จับคู่ใหม่ ส่วนอีกฝ่ายจะเห็นโฆษณาอีกครั้งจนกว่าจะจับคู่กับคนที่ซื้อไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklamları Kaldır'ı satın alan kişi, yeni eşleşmelerde de reklamsız kalır. Diğer partner, bunu satın almış biriyle eşleşene kadar yeniden reklam görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той, хто купив «Без реклами», лишається без реклами в будь-якій новій парі. Інший партнер знову бачитиме рекламу, доки не створить пару з кимось, хто має цю покупку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người đã mua Gỡ quảng cáo vẫn không thấy quảng cáo khi kết nối với người mới. Người còn lại sẽ thấy quảng cáo trở lại cho đến khi kết nối với người đã mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买了“去除广告”的一方，在任何新的配对中都保持无广告。另一方会重新看到广告，直到与购买过的人配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買「移除廣告」的人在任何新配對中都會維持免廣告。另一方則會再次看到廣告，直到與有購買的人配對為止。"
          }
        }
      }
    },
