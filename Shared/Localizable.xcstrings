          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi kỷ niệm bạn thêm sẽ thành một ngôi sao quanh cây. Người ấy thấy ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你添加的每段回忆，都会化作树周围的一颗星星。另一半会立刻看到。"
