    "Press and hold to meet them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغطوا مطوّلًا للقاء شريكك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst, ať se potkáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold for at mødes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten, um euch zu treffen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα παρατεταμένα για να συναντηθείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado para encontrarte con tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ja pidä, niin kohtaatte."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal para magtagpo kayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens appuyé pour vous retrouver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה ארוכה כדי להיפגש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनसे मिलने के लिए दबाकर रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd nyomva, hogy találkozzatok."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan untuk bertemu dia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per incontrarvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押ししてパートナーとつながりましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 눌러 연인과 만나 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan untuk bertemu dengannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold for å møtes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ingedrukt om elkaar te ontmoeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj, by się spotkać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure para se encontrarem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat ca să vă întâlniți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми и удерживай, чтобы встретиться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll för att mötas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างไว้เพื่อพบกับคนรัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla buluşmak için basılı tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисни й утримуй, щоб зустрітися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ để gặp người ấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住屏幕，和另一半相遇。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按來與另一半相遇。"
          }
        }
      }
    },
    "Press and hold. When %@ holds too, you'll both feel it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغطوا مطوّلًا. ومع ضغط %@ أيضًا، يشعر كلاكما بذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst. Až bude držet i %@, ucítíte to společně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold. Når %@ også holder, mærker I det begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten. Wenn %@ auch gedrückt hält, spürt ihr es beide."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα παρατεταμένα. Όταν κρατάτε ταυτόχρονα εσύ και %@, θα το νιώσετε κι οι δυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado. Cuando %@ también presione, los dos lo sentirán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ja pidä. Kun %@ pitää myös kiinni, tunnette sen molemmat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal. Kapag humawak din si %@, pareho ninyong mararamdaman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens appuyé. Quand %@ appuiera aussi, vous le sentirez, vous deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוחצים ומחזיקים. כשגם האצבע של %@ תהיה על המסך, שניכם תרגישו את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दबाकर रखें। %@ के भी दबाने पर आप दोनों को महसूस होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd nyomva. Ha %@ is nyomva tartja, mindketten érezni fogjátok."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan. Saat %@ ikut menyentuh, kalian berdua akan merasakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto. Quando lo farà anche %@, lo sentirete insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押ししてください。%@も押すと、ふたりに伝わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 눌러 주세요. %@ 님도 함께 누르면 두 사람 모두 느낄 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan. Apabila %@ turut menekan, anda berdua akan merasainya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold. Når %@ også holder inne, kjenner dere det begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ingedrukt. Als %@ ook vasthoudt, voelen jullie het allebei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj. Gdy %@ też przytrzyma, poczujecie to razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure. Quando %@ segurar também, vocês vão sentir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat. Când ține apăsat și %@, o să simțiți amândoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми и удерживай. Когда %@ тоже нажмёт, вы оба это почувствуете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
