    "%@ already sent theirs. It stays hidden until you do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت صورة %@. ستبقى مخفية حتى ترسلوا صورتكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už má fotku odeslanou. Zůstane skrytá, dokud nepošleš svou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har allerede sendt sit. Det forbliver skjult, indtil du sender dit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat schon ein Foto gesendet. Es bleibt verborgen, bis du deins sendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ έστειλε ήδη φωτογραφία. Μένει κρυφή μέχρι να στείλεις κι εσύ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya envió la suya. Seguirá oculta hasta que envíes la tuya."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lähetti jo oman kuvansa. Se pysyy piilossa, kunnes lähetät omasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakapagpadala na si %@. Nakatago ito hanggang magpadala ka."
