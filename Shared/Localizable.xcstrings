    "Even a small step counts. Add a contribution to keep the momentum." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى الخطوة الصغيرة تُحتسب. أضيفوا مساهمة للحفاظ على الزخم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá se i malý krok. Přidej příspěvek a udrž tempo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv et lille skridt tæller. Tilføj et bidrag for at holde farten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ein kleiner Schritt zählt. Tragt etwas bei, damit ihr in Schwung bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε μικρό βήμα μετράει. Πρόσθεσε μια συνεισφορά για να μη χαθεί η φόρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta un paso pequeño cuenta. Añade un aporte para no perder el impulso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienikin askel on tärkeä. Lisää osuus, niin vauhti säilyy."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahalaga kahit maliit na hakbang. Mag-ambag para tuloy-tuloy ang momentum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même un petit pas compte. Ajoute une contribution pour garder l'élan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם צעד קטן נחשב. אפשר להוסיף תרומה כדי לשמור על התנופה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा-सा क़दम भी मायने रखता है। रफ़्तार बनाए रखने के लिए कुछ योगदान जोड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kis lépés is számít. Tegyél hozzá valamit, hogy megmaradjon a lendület."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah kecil pun berarti. Tambah kontribusi biar semangatnya tetap jalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche un piccolo passo conta. Aggiungi un contributo per non perdere lo slancio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな一歩でも大丈夫。少しでも追加して、勢いを保ちましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 한 걸음도 의미 있어요. 기여를 추가해서 흐름을 이어 가세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah kecil pun bermakna. Tambah sumbangan untuk mengekalkan momentum."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv et lite steg teller. Legg til et bidrag for å holde farten oppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke kleine stap telt. Voeg een bijdrage toe om het momentum vast te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się nawet mały krok. Dodaj wkład, by nie stracić tempa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até um passo pequeno conta. Faça uma contribuição para manter o ritmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contează și un pas mic. Adaugă o contribuție ca să nu pierdeți avântul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже маленький шаг важен. Добавь вклад, чтобы не терять темп."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även ett litet steg räknas. Lägg till ett bidrag för att hålla farten uppe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ก้าวเล็กๆ ก็มีความหมาย เพิ่มยอดสมทบเพื่อรักษาแรงส่งไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük bir adım bile sayılır. İvmeyi korumak için bir katkı ekle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навіть маленький крок важливий. Додай внесок, щоб не втратити темп."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bước nhỏ cũng đáng kể. Góp thêm một chút để giữ đà nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再小的一步也算数。添加一笔贡献，保持势头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再小的一步都算數。貢獻一點，讓動力延續下去。"
          }
        }
      }
    },
    "Every Coupley feature is free for both of you.\nRemove ads once — for you and your partner." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ميزات Coupley مجانية لكليكما.\nأزيلوا الإعلانات مرة واحدة، لكم ولشريكك أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny funkce Coupley jsou pro vás oba zdarma.\nOdstraň reklamy jednou – pro sebe i svůj protějšek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle funktioner i Coupley er gratis for jer begge.\nFjern reklamer én gang – for dig og din partner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Funktionen von Coupley sind für euch beide kostenlos.\nEntferne die Werbung einmal – für dich und deinen Schatz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι λειτουργίες του Coupley είναι δωρεάν και για τους δυο σας.\nΑφαίρεσε τις διαφημίσεις μία φορά — για σένα και για το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las funciones de Coupley son gratis para los dos.\nQuita los anuncios una vez, para ti y para tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki Coupleyn ominaisuudet ovat ilmaisia teille molemmille.\nPoista mainokset yhdellä ostolla – sinulta ja kumppaniltasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libre ang bawat feature ng Coupley para sa inyong dalawa.\nAlisin ang ads nang isang beses — para sa iyo at sa partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les fonctionnalités de Coupley sont gratuites pour vous deux.\nSupprime les pubs une seule fois, pour toi et ton/ta partenaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל התכונות של Coupley בחינם לשניכם.\nמסירים פרסומות פעם אחת — גם לך וגם לבן/בת הזוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley का हर फ़ीचर आप दोनों के लिए मुफ़्त है।\nएक बार विज्ञापन हटाएँ — आपके और आपके पार्टनर, दोनों के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Coupley minden funkciója ingyenes mindkettőtöknek.\nEgyszer távolítsd el a reklámokat – neked és a párodnak is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua fitur Coupley gratis untuk kalian berdua.\nHapus iklan sekali bayar — untukmu dan pasanganmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le funzioni di Coupley sono gratuite per voi due.\nRimuovi la pubblicità una volta sola — per te e per il tuo partner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupleyの機能はすべて、ふたりとも無料で使えます。\n一度の購入で、あなたとパートナーの広告を削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley의 모든 기능은 두 사람 모두 무료예요.\n한 번만 결제하면 나와 연인 모두 광고가 사라져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap ciri Coupley percuma untuk anda berdua.\nBuang iklan sekali sahaja — untuk anda dan pasangan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle funksjoner i Coupley er gratis for dere begge.\nFjern reklamen én gang – for deg og partneren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle functies van Coupley zijn gratis voor jullie allebei.\nVerwijder advertenties één keer – voor jou en je partner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie funkcje Coupley są dla was bezpłatne.\nUsuń reklamy raz – dla siebie i drugiej połówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os recursos do Coupley são gratuitos para vocês.\nRemova os anúncios uma vez — para você e seu amor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate funcțiile Coupley sunt gratuite pentru amândoi.\nElimină reclamele o singură dată — pentru tine și partenerul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все функции Coupley бесплатны для вас обоих.\nУбери рекламу один раз — для себя и партнёра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla funktioner i Coupley är gratis för er båda.\nTa bort annonser en gång – för dig och din partner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกฟีเจอร์ของ Coupley ใช้ได้ฟรีสำหรับคุณทั้งสอง\nลบโฆษณาครั้งเดียว ทั้งสำหรับคุณและคนรัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley'nin tüm özellikleri ikiniz için de ücretsiz.\nReklamları bir kez kaldır; hem senin hem partnerin için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі функції Coupley безкоштовні для вас обох.\nВимкни рекламу один раз — для себе й половинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi tính năng Coupley đều miễn phí cho cả hai bạn.\nGỡ quảng cáo một lần — cho cả bạn và người ấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley的所有功能对你们俩都免费。\n只需一次去除广告，你和另一半都能享受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley 所有功能都免費給你們兩人使用。\n只要買斷一次，就能為你和另一半移除廣告。"
          }
        }
      }
    },
