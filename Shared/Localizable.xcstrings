    "Notifications are off. Turn them on in Settings to know the moment it opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة. فعّلوها من الإعدادات لتعرفوا لحظة فتحها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou vypnutá. Zapni je v Nastavení a dozvíš se, jakmile se otevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra. Slå dem til i Indstillinger for at vide det, i samme øjeblik det åbner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind aus. Aktiviere sie in den Einstellungen, um sofort zu erfahren, wenn er sich öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις είναι απενεργοποιημένες. Ενεργοποίησέ τες στις Ρυθμίσεις για να μάθεις τη στιγμή που ανοίγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas. Actívalas en Ajustes para enterarte en cuanto se abra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset ovat pois päältä. Laita ne päälle Asetuksissa, niin tiedät heti, kun se aukeaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang notifications. I-on ito sa Mga Setting para malaman agad kapag nabuksan na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées. Active-les dans Réglages pour savoir dès qu'elle s'ouvre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתראות כבויות. אפשר להפעיל אותן בהגדרות כדי לדעת ברגע שהמכתב נפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफ़िकेशन बंद हैं। खुलते ही पता चले, इसके लिए सेटिंग्स में इन्हें चालू करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értesítések ki vannak kapcsolva. Kapcsold be őket a Beállításokban, hogy tudd, mikor nyílik ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi mati. Nyalakan di Pengaturan supaya tahu saat surat ini dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate. Attivale in Impostazioni per sapere quando si apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がオフになっています。開封の瞬間を知るには、設定で通知をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 꺼져 있어요. 설정에서 알림을 켜면 열리는 순간 바로 알 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan dimatikan. Hidupkannya dalam Tetapan untuk tahu sebaik ia dibuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler er av. Slå dem på i Innstillinger for å få beskjed med en gang det åpnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit. Zet ze aan in Instellingen om te weten wanneer hij opengaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia są wyłączone. Włącz je w Ustawieniach, by wiedzieć, kiedy list się otworzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas. Ative nos Ajustes para saber na hora em que ela abrir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificările sunt dezactivate. Activează-le în Setări ca să afli exact când se deschide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления выключены. Включи их в Настройках, чтобы узнать, как только письмо откроется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda. Slå på dem i Inställningar så får du veta direkt när det öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนปิดอยู่ เปิดได้ในการตั้งค่าเพื่อรู้ทันทีที่จดหมายเปิดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler kapalı. Açıldığı anda haberin olsun diye Ayarlar'dan bildirimleri aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення вимкнено. Увімкни їх у Налаштуваннях, щоб дізнатися, щойно він відкриється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đang tắt. Bật trong Cài đặt để biết ngay lúc thư được mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已关闭。在设置中打开通知，信开启的那一刻就能知道。"
          }
