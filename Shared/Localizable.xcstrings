    "We saved your disconnect request. Sync will finish when you're back online." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظنا طلب فك الارتباط. ستكتمل المزامنة عند عودة الاتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádost o odpojení je uložená. Synchronizace se dokončí, až budeš znovu online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har gemt din anmodning om at afbryde forbindelsen. Synkroniseringen afsluttes, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Trennungsanfrage ist gespeichert. Der Abgleich wird abgeschlossen, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύσαμε το αίτημα διακοπής σύνδεσης. Ο συγχρονισμός θα ολοκληρωθεί όταν συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos tu solicitud de desconexión. La sincronización terminará cuando vuelvas a tener conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyden katkaisupyyntösi on tallennettu. Synkronointi valmistuu, kun olet taas verkossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-save namin ang request mong magdiskonekta. Matatapos ang sync kapag online ka na ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta demande de déconnexion est enregistrée. La synchro se terminera dès que tu seras de nouveau en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרנו את בקשת הניתוק. הסנכרון יושלם כשהחיבור לאינטרנט יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने आपका डिस्कनेक्ट अनुरोध सेव कर लिया है। आपके ऑनलाइन आने पर सिंक पूरा होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elmentettük a kapcsolatbontási kérésed. A szinkronizálás befejeződik, amint újra online leszel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan pemutusan koneksi sudah disimpan. Sinkronisasi akan selesai saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo salvato la tua richiesta di scollegamento. La sincronizzazione terminerà quando tornerai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続解除のリクエストを保存しました。オンラインに戻ると同期が完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 끊기 요청을 저장했어요. 다시 온라인이 되면 동기화가 마무리돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami telah menyimpan permintaan pemutusan sambungan anda. Penyegerakan akan selesai apabila anda kembali dalam talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har lagret forespørselen om å koble fra. Synkroniseringen fullføres når du er på nett igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben je verzoek om te ontkoppelen bewaard. De sync wordt afgerond zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisaliśmy prośbę o rozłączenie. Synchronizacja zakończy się, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu pedido de desconexão foi salvo. A sincronização termina quando você voltar a ficar online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am salvat cererea de deconectare. Sincronizarea se va încheia când revii online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос на отключение сохранён. Синхронизация завершится, когда ты снова будешь в сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har sparat din begäran om att koppla från. Synkningen slutförs när du är online igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราบันทึกคำขอยกเลิกการเชื่อมต่อแล้ว การซิงค์จะเสร็จสิ้นเมื่อคุณกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı kesme isteğin kaydedildi. Tekrar çevrimiçi olduğunda eşitleme tamamlanacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запит на від’єднання збережено. Синхронізація завершиться, коли ти знову будеш онлайн."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu yêu cầu ngắt kết nối. Việc đồng bộ sẽ hoàn tất khi bạn có mạng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存你的解除连接请求。恢复网络后会完成同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存你的解除連結要求。恢復連線後就會完成同步。"
          }
        }
      }
    },
    "We'll ask you to confirm with Apple before deleting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنطلب منكم التأكيد عبر Apple قبل الحذف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před smazáním tě požádáme o potvrzení přes Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi beder dig bekræfte med Apple, før vi sletter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Löschen bitten wir dich, dies bei Apple zu bestätigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σου ζητήσουμε επιβεβαίωση μέσω Apple πριν από τη διαγραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te pediremos que confirmes con Apple antes de eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydämme sinua vahvistamaan Applella ennen poistamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihilingin naming kumpirmahin mo sa Apple bago magbura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te demandera de confirmer avec Apple avant la suppression."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפני המחיקה נבקש אישור דרך Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाने से पहले हम आपसे Apple के साथ पुष्टि करने को कहेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törlés előtt megkérünk, hogy erősítsd meg az Apple-lel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan memintamu mengonfirmasi dengan Apple sebelum menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti chiederemo di confermare con Apple prima dell’eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除の前に、Appleでの確認をお願いします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제하기 전에 Apple에서 확인을 요청할게요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan meminta anda mengesahkan dengan Apple sebelum memadam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ber deg bekrefte med Apple før vi sletter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vragen je eerst om te bevestigen bij Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed usunięciem poprosimy o potwierdzenie przez Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos pedir para você confirmar com a Apple antes de excluir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți vom cere să confirmi cu Apple înainte de ștergere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед удалением мы попросим подтвердить действие через Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ber dig bekräfta med Apple innan kontot raderas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะขอให้คุณยืนยันกับ Apple ก่อนลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silmeden önce Apple ile onaylamanı isteyeceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед видаленням ми попросимо підтвердити дію через Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng mình sẽ yêu cầu bạn xác nhận với Apple trước khi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除前，我们会请你通过Apple进行确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除前，我們會請你透過 Apple 確認。"
          }
        }
      }
    },
