    "You see %@ a little differently — might be worth a chat." : {
      "comment" : "Quiz result when the partners answered differently. The placeholder is the quiz topic, e.g. “Finance” or “Love & Emotion”.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختلف نظرتكما إلى %@ قليلًا، وربما يستحق الأمر حديثًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téma %@ vidíte trochu jinak – možná stojí za to si o tom promluvit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ser lidt forskelligt på %@ – måske værd at tale om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr seht %@ etwas unterschiedlich – vielleicht ein Thema für ein Gespräch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βλέπετε το θέμα «%@» λίγο διαφορετικά — ίσως αξίζει μια κουβέντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos ven %@ de forma un poco distinta; quizá valga la pena hablarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näette aiheen %@ hieman eri tavoin – siitä voisi olla hyvä jutella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medyo magkaiba ang tingin ninyo sa %@ — baka sulit pag-usapan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Côté %@, vous n'avez pas tout à fait le même avis : ça vaut peut-être la peine d'en parler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בנושא %@ אתם רואים דברים קצת אחרת — אולי שווה לדבר על זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर आप दोनों की नज़र थोड़ी अलग है — इस पर बात करना अच्छा रहेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt kicsit másképp látjátok: %@ – érdemes lehet beszélni róla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandangan kalian soal %@ sedikit berbeda — mungkin layak diobrolkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedete %@ in modo un po’ diverso — forse vale la pena parlarne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@について少し見方が違うようです。話してみるといいかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대해 생각이 조금 달라요. 이야기해 보면 좋을 것 같아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandangan anda tentang %@ sedikit berbeza — mungkin wajar dibincangkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere ser litt ulikt på %@ – kan være verdt en prat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jullie kijken net iets anders naar %@ – misschien goed om erover te praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temat %@: patrzycie na to trochę inaczej – warto o tym porozmawiać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocês veem %@ de um jeito um pouco diferente — vale uma conversa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aveți păreri puțin diferite despre %@ — poate merită o discuție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема «%@»: ваши взгляды немного расходятся — стоит поговорить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ser lite olika på %@ – kan vara värt att prata om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณทั้งสองมองเรื่อง%@ต่างกันนิดหน่อย ลองคุยกันดูก็น่าจะดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konusunda biraz farklı düşünüyorsunuz; konuşmaya değer olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви трохи по-різному бачите тему «%@» — можливо, варто поговорити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai bạn nhìn nhận %@ hơi khác nhau — có lẽ nên trò chuyện thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们对%@的看法有点不同，或许值得聊一聊。"
          }
