    "Set the day your story began. Your tree grows from it, and your partner sees it too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّدوا اليوم الذي بدأت فيه قصتكما. منه تنمو شجرتكما، ويظهر لشريكك أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav den, kdy začal váš příběh. Roste z něj váš strom a uvidí ho i tvůj protějšek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg dagen, hvor jeres historie begyndte. Jeres træ vokser fra den, og din partner kan også se den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg den Tag fest, an dem eure Geschichte begann. Euer Baum wächst ab diesem Tag, und dein Schatz sieht das Datum auch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρισε τη μέρα που ξεκίνησε η ιστορία σας. Από αυτήν μεγαλώνει το δέντρο σας, και τη βλέπει και το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el día en que empezó la historia de los dos. Tu árbol crece a partir de él, y tu pareja también lo ve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse päivä, jolloin tarinanne alkoi. Puunne kasvaa siitä, ja kumppanisi näkee sen myös."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itakda ang araw na nagsimula ang kuwento ninyo. Dito lalaki ang puno ninyo, at makikita rin ito ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis le jour où votre histoire a commencé. Votre arbre grandit à partir de là, et l'autre le voit aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לקבוע את היום שבו הסיפור שלכם התחיל. ממנו העץ צומח, והוא מוצג לשניכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह दिन चुनें जब आपकी कहानी शुरू हुई। आपका पेड़ उसी दिन से बढ़ता है, और आपके पार्टनर को भी यह दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg a napot, amikor a történetetek elkezdődött. Ebből nő a fátok, és a párod is látja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur hari kisah kalian dimulai. Pohonmu tumbuh dari situ, dan pasanganmu juga bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il giorno in cui è iniziata la vostra storia. Il vostro albero cresce da lì, e lo vede anche il tuo partner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの物語が始まった日を設定しましょう。ツリーはその日から育ち、パートナーにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사람의 이야기가 시작된 날을 설정해 주세요. 그날부터 나무가 자라고, 연인도 함께 볼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan hari kisah anda bermula. Pokok anda membesar dari situ, dan pasangan anda juga dapat melihatnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg dagen historien deres begynte. Treet vokser fra den, og partneren din ser den også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de dag waarop jullie verhaal begon. Je boom groeit vanaf die dag, en je partner ziet hem ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw dzień, w którym zaczęła się wasza historia. Od niego rośnie wasze drzewo, a twoja druga połówka też go zobaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o dia em que a história de vocês começou. Sua árvore cresce a partir dele, e seu amor também vê."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege ziua în care a început povestea voastră. Copacul vostru crește din ea, iar data e vizibilă și pentru partenerul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажи день, когда началась ваша история. От него растёт ваше дерево, и твой партнёр тоже его видит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj dagen då er berättelse började. Ert träd växer från den, och din partner ser den också."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งวันที่เรื่องราวของคุณเริ่มต้น ต้นไม้ของคุณจะเติบโตจากวันนั้น และคนรักของคุณก็จะเห็นวันนี้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hikâyenizin başladığı günü belirle. Ağacın o günden itibaren büyür, partnerin de görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкажи день, коли почалася ваша історія. З нього росте ваше дерево, і твоя половинка теж його бачить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngày câu chuyện của hai bạn bắt đầu. Cây sẽ lớn lên từ ngày đó, và người ấy cũng thấy được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定你们故事开始的那一天。你们的树从这天开始生长，另一半也能看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定你們故事開始的那一天。樹會從那天開始成長，另一半也看得到。"
          }
        }
      }
