    "Remember to cancel your subscription in Settings → Apple ID → Subscriptions if you no longer want to be charged." : {
      "comment" : "The arrows name iOS Settings screens: use the names iOS shows in your language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنسوا إلغاء اشتراكك من الإعدادات ← Apple ID ← الاشتراكات إن لم تعودوا ترغبون في الدفع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud už nechceš platit, nezapomeň zrušit předplatné v Nastavení → Apple ID → Předplatné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk at opsige dit abonnement under Indstillinger → Apple-id → Abonnementer, hvis du ikke længere vil betale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk daran, dein Abo unter Einstellungen → Apple-Account → Abonnements zu kündigen, wenn du nicht mehr belastet werden möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θυμήσου να ακυρώσεις τη συνδρομή σου στις Ρυθμίσεις → Apple ID → Συνδρομές, αν δεν θέλεις να χρεώνεσαι άλλο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda cancelar tu suscripción en Ajustes → Apple ID → Suscripciones si ya no quieres que se te cobre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista perua tilauksesi kohdassa Asetukset → Apple ID → Tilaukset, jos et enää halua maksaa siitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandaang kanselahin ang subscription mo sa Settings → Apple ID → Subscriptions kung ayaw mo nang masingil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pense à résilier ton abonnement dans Réglages → Identifiant Apple → Abonnements si tu ne veux plus payer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם כבר לא רוצים לשלם, חשוב לזכור לבטל את המינוי בהגדרות ← Apple ID ← מינויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप आगे भुगतान नहीं करना चाहते, तो सेटिंग्स → Apple ID → सब्सक्रिप्शन में जाकर अपना सब्सक्रिप्शन रद्द करना न भूलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne felejtsd el lemondani az előfizetésedet itt: Beállítások → Apple ID → Előfizetések, ha nem szeretnéd, hogy további díjat számoljanak fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan lupa batalkan langgananmu di Pengaturan → Apple ID → Langganan kalau tidak ingin ditagih lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricordati di annullare l’abbonamento in Impostazioni → ID Apple → Abbonamenti se non vuoi più ricevere addebiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の請求を止めたい場合は、設定 → Apple ID → サブスクリプションからサブスクリプションを解約するのをお忘れなく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 결제되지 않게 하려면 설정 → Apple ID → 구독에서 구독을 꼭 취소해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingat untuk membatalkan langganan anda dalam Seting → Apple ID → Langganan jika anda tidak mahu dicaj lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk å si opp abonnementet ditt i Innstillinger → Apple-ID → Abonnementer hvis du ikke vil bli belastet lenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeet niet je abonnement op te zeggen via Instellingen → Apple ID → Abonnementen als je niet meer wilt betalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamiętaj, aby anulować subskrypcję w Ustawienia → Apple ID → Subskrypcje, jeśli nie chcesz, by naliczano kolejne opłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembre-se de cancelar sua assinatura em Ajustes → Apple ID → Assinaturas se não quiser mais cobranças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu uita să-ți anulezi abonamentul din Configurări → ID Apple → Abonamente dacă nu mai vrei să plătești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не забудь отменить подписку в разделе Настройки → Apple ID → Подписки, если больше не хочешь платить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom ihåg att säga upp din prenumeration i Inställningar → Apple-ID → Prenumerationer om du inte längre vill debiteras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าลืมยกเลิกการสมัครสมาชิกที่ การตั้งค่า → Apple ID → การสมัครรับ หากไม่ต้องการถูกเรียกเก็บเงินอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık ücret ödemek istemiyorsan aboneliğini Ayarlar → Apple Hesabı → Abonelikler'den iptal etmeyi unutma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не забудь скасувати підписку в розділі Параметри → Apple ID → Підписки, якщо більше не хочеш, щоб із тебе списували кошти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhớ hủy gói đăng ký trong Cài đặt → Apple ID → Đăng ký nếu bạn không muốn bị tính phí nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不想再被扣费，记得前往“设置 → Apple账户 → 订阅”取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不想再被扣款，記得到「設定」→「Apple ID」→「訂閱項目」取消訂閱。"
          }
        }
      }
    },
