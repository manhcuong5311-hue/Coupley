    "Anniversaries, first dates, the little inside-joke days. We'll remember them — quietly, in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذكريات السنوية، والمواعيد الأولى، وأيام النكات الخاصة بكما. سنتذكّرها نحن — بهدوء، في الخلفية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výročí, první rande, dny vašich soukromých vtípků. Zapamatujeme si je – nenápadně, na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsdage, første dates, de små dage med interne jokes. Vi husker dem – stille og roligt i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahrestage, erste Dates, die kleinen Insider-Tage. Wir behalten sie im Blick – leise, im Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επέτειοι, πρώτα ραντεβού, οι μικρές μέρες με τα εσωτερικά σας αστεία. Θα τις θυμόμαστε εμείς — αθόρυβα, στο παρασκήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aniversarios, primeras citas, esos días de bromas internas. Los recordaremos — en silencio, en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuosipäivät, ensitreffit, pienet sisäpiirin merkkipäivät. Me muistamme ne – hiljaa, taustalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga anibersaryo, unang date, ang maliliit na araw ng inside joke. Aalalahanin namin ang mga ito — tahimik, sa background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anniversaires, premiers rendez-vous, les petits jours de blagues complices. On s'en souvient pour vous — en douceur, en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ימי שנה, דייטים ראשונים, הימים הקטנים של הבדיחות הפרטיות. אנחנו נזכור אותם — בשקט, ברקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सालगिरह, पहली डेट, आपसी मज़ाक वाले छोटे-छोटे दिन। हम इन्हें याद रखेंगे — चुपचाप, बैकग्राउंड में।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évfordulók, első randik, a belsős poénok napjai. Mi emlékezni fogunk rájuk – csendben, a háttérben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari jadi, kencan pertama, hari-hari lelucon berdua. Kami akan mengingatnya — diam-diam, di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anniversari, primi appuntamenti, i giorni delle vostre battute segrete. Li ricorderemo noi — con discrezione, in sottofondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記念日、初デート、ふたりだけの小さな記念日。Coupleyがそっと覚えておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기념일, 첫 데이트, 둘만 아는 소소한 날들. 저희가 뒤에서 조용히 기억해 둘게요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulang tahun, janji temu pertama, hari-hari jenaka sesama sendiri. Kami akan mengingatinya — secara senyap, di latar belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsdager, første dater, de små dagene med interne vitser. Vi husker dem – stille, i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jubilea, eerste dates, de kleine dagen vol inside jokes. Wij onthouden ze – rustig, op de achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rocznice, pierwsze randki, dni waszych wspólnych żartów. Zapamiętamy je – po cichu, w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aniversários de namoro, primeiros encontros, os dias das piadas internas. A gente lembra por vocês — sem alarde, em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aniversări, primele întâlniri, zilele cu glume doar ale voastre. Le ținem minte noi — discret, în fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годовщины, первые свидания, дни ваших личных шуток. Мы их запомним — тихо, в фоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsdagar, första dejter, de små dagarna med internskämt. Vi kommer ihåg dem – diskret, i bakgrunden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันครบรอบ เดตแรก และวันเล็กๆ ที่มีมุกรู้กันสองคน เราจะจำไว้ให้อย่างเงียบๆ อยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıl dönümleri, ilk buluşmalar, iç şakalarla dolu küçük günler. Biz hatırlarız — sessizce, arka planda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Річниці, перші побачення, дні ваших особливих жартів. Ми пам’ятатимемо їх — тихо, у фоні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày kỷ niệm, buổi hẹn đầu, những ngày có chuyện đùa riêng. Chúng mình sẽ nhớ giúp — lặng lẽ, phía sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纪念日、第一次约会、专属小梗的日子。我们会在后台悄悄帮你记住。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紀念日、第一次約會、只有你們懂梗的小日子。我們會在背景默默幫你記住。"
          }
        }
      }
    },
