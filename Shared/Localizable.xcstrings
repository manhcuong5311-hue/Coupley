    "Add a dream or set a shared goal — even a small one starts the story." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفوا حلمًا أو حدّدوا هدفًا مشتركًا — حتى الصغير منه يبدأ القصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte sen nebo si dejte společný cíl – i malý začne váš příběh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en drøm, eller sæt et fælles mål – selv et lille et starter historien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Traum hinzu oder setzt euch ein gemeinsames Ziel – auch ein kleines beginnt die Geschichte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε ένα όνειρο ή όρισε έναν κοινό στόχο — ακόμα κι ένας μικρός ξεκινά την ιστορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un sueño o crea una meta compartida — hasta una pequeña empieza la historia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää unelma tai aseta yhteinen tavoite – pienikin aloittaa tarinan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng pangarap o magtakda ng layunin ninyong dalawa — kahit maliit ay simula na ng kuwento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un rêve ou fixe un objectif commun — même un petit suffit pour lancer l'histoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו חלום או הציבו מטרה משותפת — גם מטרה קטנה מתחילה את הסיפור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सपना जोड़ें या साझा लक्ष्य तय करें — छोटा-सा भी हो, कहानी शुरू हो जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzá egy álmot, vagy tűzzetek ki egy közös célt – már egy kicsi is elindítja a történetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah impian atau pasang target bersama — yang kecil pun bisa memulai cerita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un sogno o fissa un obiettivo comune — anche uno piccolo dà inizio alla storia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢を追加するか、共通の目標を立てましょう。小さなことでも、物語の始まりになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꿈을 추가하거나 공동 목표를 세워 보세요. 작은 것 하나로도 이야기가 시작돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah impian atau tetapkan matlamat bersama — yang kecil pun boleh memulakan kisahnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en drøm eller sett et felles mål – selv et lite mål starter historien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een droom toe of stel een gezamenlijk doel – zelfs een kleintje is het begin van jullie verhaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj marzenie albo wyznacz wspólny cel – nawet mały zaczyna waszą historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um sonho ou defina uma meta a dois — até uma pequena já começa a história."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un vis sau stabilește un obiectiv comun — chiar și unul mic începe povestea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь мечту или поставь общую цель — даже маленькая начинает историю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en dröm eller sätt ett gemensamt mål – även ett litet startar berättelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มความฝันหรือตั้งเป้าหมายร่วมกัน แม้เป้าหมายเล็กๆ ก็เป็นจุดเริ่มของเรื่องราวได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hayal ekle ya da ortak bir hedef koy — küçük bir tanesi bile hikâyeyi başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай мрію або постав спільну ціль — навіть маленька починає історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một ước mơ hoặc đặt mục tiêu chung — dù nhỏ cũng là khởi đầu của câu chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一个梦想，或设定一个共同目标——再小的目标，也是故事的开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增夢想或設定共同目標——再小的一個，都是故事的開始。"
          }
        }
      }
    },
