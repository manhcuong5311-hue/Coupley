    "Lots of \"I love you\" — sweet check-ins." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكثير من «أحبك» — وسؤال لطيف عن الحال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodně „miluju tě“ – sladké zprávy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masser af »jeg elsker dig« – søde check-ins."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele „Ich liebe dich“ – süße Check-ins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολλά «σ’ αγαπώ» — γλυκά μηνύματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muchos “te quiero” y mensajes tiernos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paljon ”rakastan sinua” -viestejä – suloisia kuulumisia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maraming “I love you” — matatamis na check-in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plein de « je t'aime » — des check-ins tout doux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרבה מילים של אהבה — עדכונים מתוקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढेर सारा “आई लव यू” — प्यारे-प्यारे चेक-इन।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sok „szeretlek” – kedves jelzések."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banyak “aku sayang kamu” — check-in yang manis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanti «ti amo» — check-in dolci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「愛してる」をたくさん。甘いチェックイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“사랑해”를 듬뿍 담은 달콤한 체크인."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banyak “Saya sayang awak” — sapaan yang manis."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mange «jeg elsker deg» – søte innsjekker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel “ik hou van je” – lieve check-ins."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dużo „kocham cię” – słodkie wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito “eu te amo” — check-ins fofos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multe „te iubesc” — check-in-uri dulci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Много «люблю тебя» и нежной заботы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massor av ”jag älskar dig” – söta incheckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“รักนะ” บ่อยๆ เช็กอินหวานๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bol bol “Seni seviyorum” — tatlı hal hatır sormalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багато «Я тебе кохаю» і ніжних «як ти?»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thật nhiều câu “Thương bạn” — những lời hỏi han ngọt ngào."
          }
        },
        "zh-Hans" : {
