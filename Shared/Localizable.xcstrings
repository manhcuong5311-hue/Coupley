    "Replies are written by OpenAI from what you send. Your coach history is saved only on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب OpenAI الردود بناءً على ما ترسلونه. يُحفظ سجل المدرب على هذا الجهاز فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovědi píše OpenAI na základě toho, co odešleš. Historie s koučem se ukládá jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarene skrives af OpenAI ud fra det, du sender. Din coachhistorik gemmes kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antworten schreibt OpenAI auf Basis dessen, was du sendest. Dein Coach-Verlauf wird nur auf diesem Gerät gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τις απαντήσεις τις γράφει η OpenAI με βάση όσα στέλνεις. Το ιστορικό του συμβούλου αποθηκεύεται μόνο σε αυτή τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas las escribe OpenAI a partir de lo que envías. Tu historial con el coach solo se guarda en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI kirjoittaa vastaukset lähettämäsi perusteella. Valmentajahistoriasi tallennetaan vain tälle laitteelle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga sagot ay isinusulat ng OpenAI batay sa ipinapadala mo. Sa device na ito lang naka-save ang history mo sa coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses sont rédigées par OpenAI à partir de ce que tu envoies. Ton historique avec le coach est enregistré uniquement sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשובות נכתבות על ידי OpenAI על סמך מה שנשלח. היסטוריית השיחות עם המאמן נשמרת רק במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब OpenAI आपके भेजे गए मैसेज के आधार पर लिखता है। आपकी कोच हिस्ट्री सिर्फ़ इसी डिवाइस पर सेव रहती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A válaszokat az OpenAI írja az általad küldött tartalom alapján. A coach-előzményeid csak ezen az eszközön vannak mentve."
          }
        },
        "id" : {
          "stringUnit" : {
