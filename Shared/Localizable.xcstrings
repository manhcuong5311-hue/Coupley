    "Daily check-ins build the small habits long-term love is made of." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيل اليومي يبني العادات الصغيرة التي يُصنع منها الحب الطويل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denní záznamy budují drobné návyky, ze kterých roste láska na celý život."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daglige check-ins bygger de små vaner, som langvarig kærlighed er lavet af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tägliche Check-ins formen die kleinen Gewohnheiten, aus denen dauerhafte Liebe entsteht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι καθημερινές καταγραφές χτίζουν τις μικρές συνήθειες από τις οποίες φτιάχνεται η αγάπη που κρατάει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros diarios crean los pequeños hábitos de los que está hecho el amor duradero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittäiset merkinnät rakentavat pieniä tapoja, joista pitkä rakkaus syntyy."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang araw-araw na check-in ang bumubuo sa maliliit na gawi na pundasyon ng pangmatagalang pag-ibig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les check-ins quotidiens créent les petites habitudes dont est fait un amour qui dure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכונים יומיים בונים את ההרגלים הקטנים שמהם עשויה אהבה ארוכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़ के चेक-इन वे छोटी आदतें बनाते हैं जिनसे लंबा प्यार बनता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A napi kipipálásokból épülnek azok az apró szokások, amelyekből a tartós szerelem áll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in harian membangun kebiasaan kecil yang membentuk cinta jangka panjang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I check-in quotidiani creano le piccole abitudini di cui è fatto l’amore duraturo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日のチェックインが、長く続く愛を支える小さな習慣を育てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일의 체크인이 오래가는 사랑을 이루는 작은 습관을 만들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan harian membina tabiat kecil yang menjadi asas cinta jangka panjang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daglige innsjekker bygger de små vanene langvarig kjærlighet består av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagelijkse check-ins bouwen de kleine gewoontes waar blijvende liefde van gemaakt is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne odhaczanie buduje drobne nawyki, z których składa się trwała miłość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-ins diários criam os pequenos hábitos de que o amor duradouro é feito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in-urile zilnice clădesc obiceiurile mici din care e făcută iubirea pe termen lung."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневные отметки создают маленькие привычки, из которых складывается долгая любовь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagliga incheckningar bygger de små vanor som långvarig kärlek består av."
          }
