        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постійність — найрідкісніша річ. І ви робите цю рідкісну річ разом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiên trì là điều hiếm có nhất. Và hai bạn đang cùng nhau làm được điều đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
