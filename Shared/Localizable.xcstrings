    "Start with one thing — a dream you share, or a goal you both want." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدؤوا بشيء واحد — حلم مشترك، أو هدف تريدانه كلاكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte jednou věcí – společným snem nebo cílem, který chcete oba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med én ting – en drøm, I deler, eller et mål, I begge ønsker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fangt mit einer Sache an – einem gemeinsamen Traum oder einem Ziel, das ihr beide wollt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε με ένα πράγμα — ένα όνειρο που μοιράζεστε ή έναν στόχο που θέλετε και οι δύο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza por una cosa — un sueño compartido o una meta de los dos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita yhdestä asiasta – yhteisestä unelmasta tai tavoitteesta, jota te molemmat haluatte."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsimula sa isang bagay — isang pangarap ninyong dalawa, o layuning pareho ninyong gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence par une chose — un rêve que vous partagez, ou un objectif qui vous tient à cœur à tous les deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחילים בדבר אחד — חלום משותף או מטרה ששניכם רוצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक चीज़ से शुरुआत करें — कोई साझा सपना, या कोई लक्ष्य जो आप दोनों चाहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdjétek egy dologgal – egy közös álommal vagy egy céllal, amit mindketten szeretnétek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari satu hal — impian yang kalian bagi, atau target yang kalian berdua inginkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da una cosa — un sogno che condividete o un obiettivo che volete entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずはひとつから。ふたりで共有する夢か、ふたりで叶えたい目標を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나부터 시작해 보세요. 함께 꾸는 꿈이나 둘 다 원하는 목표요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan dengan satu perkara — impian yang dikongsi, atau matlamat yang anda berdua mahukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynn med én ting – en drøm dere deler, eller et mål dere begge vil nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met één ding – een droom die jullie delen, of een doel dat jullie allebei willen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od jednej rzeczy – wspólnego marzenia albo celu, do którego chcecie razem dążyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comecem por uma coisa — um sonho em comum ou uma meta que os dois querem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începeți cu un singur lucru — un vis comun sau un obiectiv pe care îl vreți amândoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни с одного — с общей мечты или цели, которой хотите вы оба."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en sak – en dröm ni delar eller ett mål ni båda vill nå."
          }
        },
        "th" : {
          "stringUnit" : {
