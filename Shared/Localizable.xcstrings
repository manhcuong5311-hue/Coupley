    "We'll only nudge you for the things you actually care about — moods, anniversaries, sweet messages from your partner." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن ننبّهك إلا لما يهمك فعلًا — حالات المزاج، والذكريات السنوية، والرسائل اللطيفة من شريكك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorníme tě jen na to, na čem ti opravdu záleží – nálady, výročí, milé zprávy od tvého protějšku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi puffer kun til dig om det, du faktisk går op i – humør, årsdage, søde beskeder fra din partner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir stupsen dich nur für Dinge an, die dir wirklich wichtig sind – Stimmungen, Jahrestage, liebe Nachrichten von deinem Schatz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σε ειδοποιούμε μόνο για όσα σε ενδιαφέρουν πραγματικά — διαθέσεις, επετείους, γλυκά μηνύματα από το ταίρι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te avisaremos de lo que de verdad te importa — estados de ánimo, aniversarios, mensajes tiernos de tu pareja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutamme vain asioista, joista oikeasti välität – mielialoista, vuosipäivistä ja kumppanisi suloisista viesteistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpapaalala lang kami sa mga bagay na talagang mahalaga sa iyo — mga mood, anibersaryo, matatamis na mensahe mula sa partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne te fera signe que pour ce qui compte vraiment pour toi — les humeurs, les anniversaires, les mots doux de ton/ta partenaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נזכיר רק בדברים שבאמת חשובים לך — מצבי רוח, ימי שנה, הודעות מתוקות מהצד השני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम सिर्फ़ उन्हीं बातों के लिए याद दिलाएँगे जिनकी आपको सच में परवाह है — मूड, सालगिरह, आपके पार्टनर के प्यारे मैसेज।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak olyan dolgokról szólunk, amelyek tényleg érdekelnek – hangulatok, évfordulók, kedves üzenetek a párodtól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami hanya akan menyapamu untuk hal yang benar-benar kamu pedulikan — mood, hari jadi, pesan manis dari pasanganmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviseremo solo per ciò che ti sta davvero a cuore — umori, anniversari, messaggi dolci del tuo partner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムード、記念日、パートナーからのうれしいメッセージなど、本当に大切なことだけをお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분, 기념일, 연인의 다정한 메시지처럼 정말 중요한 것만 알려 드릴게요."
