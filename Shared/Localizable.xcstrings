        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjælper os med at foreslå den rette støtte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So können wir die passende Unterstützung vorschlagen"
