        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы будем напоминать только о том, что тебе правда важно, — настроение, годовщины, нежные сообщения от партнёра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi knuffar dig bara om sådant du faktiskt bryr dig om – humör, årsdagar, söta meddelanden från din partner."
