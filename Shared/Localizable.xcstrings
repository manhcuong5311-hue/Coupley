        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봉인하면 수정할 수 없어요. 열리기 전까지는 보내기를 취소할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah dimeterai, surat ini tidak boleh diedit. Anda boleh menarik baliknya sehingga ia dibuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er forseglet, kan du ikke redigere det. Du kan angre sendingen til det åpnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het verzegelen kun je hem niet meer wijzigen. Je kunt hem intrekken tot hij opengaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapieczętowaniu nie można go edytować. Możesz cofnąć wysłanie, dopóki się nie otworzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
