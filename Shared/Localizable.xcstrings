        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能現在都免費開放給每個人。身為進階版訂閱者，你會永久免廣告，所以隨時可以取消訂閱。"
          }
        }
      }
    },
    "Every memory you add becomes a star around your tree. Your partner sees it instantly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ذكرى تضيفونها تصبح نجمة حول شجرتكما. ويراها شريكك فورًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá přidaná vzpomínka se stane hvězdou kolem vašeho stromu. Tvůj protějšek ji hned uvidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert minde, du tilføjer, bliver til en stjerne omkring jeres træ. Din partner ser det med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Erinnerung, die du hinzufügst, wird zu einem Stern um euren Baum. Dein Schatz sieht sie sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ανάμνηση που προσθέτεις γίνεται ένα αστέρι γύρω από το δέντρο σας. Το ταίρι σου τη βλέπει αμέσως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada recuerdo que añades se convierte en una estrella alrededor de tu árbol. Tu pareja lo ve al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisesta lisäämästäsi muistosta tulee tähti puusi ympärille. Kumppanisi näkee sen heti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawat alaalang idaragdag mo ay nagiging bituin sa paligid ng puno ninyo. Agad itong makikita ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque souvenir que tu ajoutes devient une étoile autour de votre arbre. Ton/ta partenaire le voit instantanément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל זיכרון שמוסיפים הופך לכוכב סביב העץ שלכם. בן/בת הזוג רואים אותו מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी जोड़ी हर याद आपके पेड़ के आसपास एक सितारा बन जाती है। आपके पार्टनर को यह तुरंत दिखती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden hozzáadott emlék csillag lesz a fátok körül. A párod azonnal látja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kenangan yang kamu tambahkan jadi bintang di sekitar pohonmu. Pasanganmu langsung bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni ricordo che aggiungi diventa una stella attorno al vostro albero. Il tuo partner lo vede subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した思い出は、ツリーのまわりの星になります。パートナーにもすぐに表示されます。"
