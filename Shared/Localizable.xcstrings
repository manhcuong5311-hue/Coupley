    "Tell me what happened — as much or as little as you want. I'll help you work through it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبروني بما حدث، بالقدر الذي تريدونه. سأساعدكم على تجاوزه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni mi, co se stalo – klidně hodně, nebo jen málo. Pomůžu ti to zpracovat."
          }
        },
        "da" : {
          "stringUnit" : {
