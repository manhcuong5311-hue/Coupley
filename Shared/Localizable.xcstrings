    "Add at least two choices above, then pick the answer that's true for you. Your partner gets a 💖 if they match." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفوا خيارين على الأقل أعلاه، ثم اختاروا الإجابة الصحيحة بالنسبة إليكم. وعند تطابق الإجابتين، 💖 من نصيب شريكك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výše přidej aspoň dvě možnosti a pak vyber tu, která platí pro tebe. Když se tvůj protějšek trefí, získá 💖."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj mindst to svarmuligheder ovenfor, og vælg så det svar, der passer på dig. Din partner får et 💖, hvis svarene matcher."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge oben mindestens zwei Optionen hinzu und wähle dann die Antwort, die für dich stimmt. Dein Schatz bekommt ein 💖, wenn die Antworten übereinstimmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε τουλάχιστον δύο επιλογές παραπάνω και διάλεξε αυτή που ισχύει για σένα. Αν το ταίρι σου τη βρει, παίρνει ένα 💖."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al menos dos opciones arriba y elige la que sea cierta para ti. Tu pareja recibe un 💖 si coincide."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää yllä vähintään kaksi vaihtoehtoa ja valitse sitten se, joka pitää paikkansa sinun kohdallasi. Kumppanisi saa 💖, jos vastaukset osuvat yksiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng hindi bababa sa dalawang pagpipilian sa itaas, saka piliin ang sagot na totoo para sa iyo. Makakakuha ng 💖 ang partner mo kapag tumugma siya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute au moins deux choix ci-dessus, puis choisis la réponse qui est vraie pour toi. Ton/ta partenaire reçoit un 💖 si ça correspond."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להוסיף למעלה לפחות שתי אפשרויות, ואז לבחור את התשובה שנכונה לגביך. אם תהיה התאמה, הצד השני יקבל 💖."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर कम से कम दो विकल्प जोड़ें, फिर वह जवाब चुनें जो आपके लिए सच है। जवाब मिलने पर आपके पार्टनर को 💖 मिलेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj meg fent legalább két lehetőséget, majd válaszd ki, melyik igaz rád. Ha a párod eltalálja, kap egy 💖-t."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan minimal dua pilihan di atas, lalu pilih jawaban yang benar untukmu. Pasanganmu dapat 💖 kalau jawabannya cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi almeno due risposte qui sopra, poi scegli quella vera per te. Il tuo partner riceve un 💖 se indovina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上に選択肢を2つ以上追加して、自分に当てはまる答えを選んでください。パートナーの答えが一致すると💖がもらえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에 선택지를 두 개 이상 추가한 다음, 나에게 맞는 답을 골라 주세요. 연인의 답이 같으면 💖를 받아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah sekurang-kurangnya dua pilihan di atas, kemudian pilih jawapan yang benar bagi anda. Pasangan anda dapat 💖 jika jawapannya sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til minst to alternativer over, og velg så svaret som stemmer for deg. Partneren din får en 💖 hvis dere svarer likt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hierboven minstens twee opties toe en kies dan het antwoord dat voor jou klopt. Je partner krijgt een 💖 bij een match."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj powyżej co najmniej dwie odpowiedzi, a potem wybierz tę, która jest prawdziwa dla ciebie. Jeśli odpowiedzi się zgodzą, twoja druga połówka dostanie 💖."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pelo menos duas opções acima e escolha a que é verdade para você. Se acertar, seu amor ganha um 💖."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă mai sus cel puțin două variante, apoi alege răspunsul valabil pentru tine. Partenerul tău primește un 💖 dacă nimerește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь выше хотя бы два варианта, затем выбери тот, что верен для тебя. Если ответы совпадут, партнёр получит 💖."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till minst två alternativ ovan och välj sedan det svar som stämmer för dig. Din partner får ett 💖 om ni matchar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มตัวเลือกด้านบนอย่างน้อยสองข้อ แล้วเลือกคำตอบที่เป็นจริงสำหรับคุณ ถ้าคนรักตอบตรงกันจะได้ 💖"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıya en az iki seçenek ekle, sonra senin için doğru olanı seç. Partnerin bilirse 💖 kazanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай вище щонайменше два варіанти, а потім вибери той, що правдивий для тебе. Якщо відповідь половинки збіжеться, вона отримає 💖."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ít nhất hai lựa chọn ở trên, rồi chọn đáp án đúng với bạn. Người ấy sẽ nhận 💖 nếu chọn trùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在上方添加至少两个选项，再选出符合你的答案。另一半答对就能得到一个💖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在上方新增至少兩個選項，再選出符合你的答案。另一半答對就會得到 💖。"
          }
        }
      }
    },
    "Add hints about what they love — they'll see who added each one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفوا تلميحات عمّا يحبه شريكك، وسيظهر له من أضاف كل تلميح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávej tipy, co má tvůj protějšek rád – u každého uvidí, kdo ho přidal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
