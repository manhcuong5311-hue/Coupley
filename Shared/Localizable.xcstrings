    "This will permanently remove all shared messages, activities, and events." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف كل الرسائل والأنشطة والأحداث المشتركة نهائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale se odstraní všechny sdílené zprávy, aktivity a události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner permanent alle fælles beskeder, aktiviteter og begivenheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle gemeinsamen Nachrichten, Aktivitäten und Ereignisse endgültig entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αφαιρεθούν οριστικά όλα τα κοινά μηνύματα, οι δραστηριότητες και τα συμβάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán para siempre todos los mensajes, actividades y eventos compartidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa pysyvästi kaikki yhteiset viestit, aktiviteetit ja tapahtumat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanenteng aalisin nito ang lahat ng shared na mensahe, aktibidad, at event."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement tous les messages, activités et événements partagés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההודעות, הפעילויות והאירועים המשותפים יימחקו לצמיתות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे सभी साझा मैसेज, गतिविधियाँ और इवेंट हमेशा के लिए हट जाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez véglegesen eltávolítja az összes közös üzenetet, tevékenységet és eseményt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus permanen semua pesan, aktivitas, dan acara bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi definitivamente tutti i messaggi, le attività e gli eventi condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有したメッセージ、アクティビティ、イベントがすべて完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 나눈 메시지, 활동, 이벤트가 모두 영구적으로 삭제돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan membuang semua mesej, aktiviti dan acara kongsi secara kekal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner alle felles meldinger, aktiviteter og hendelser for godt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle gedeelde berichten, activiteiten en gebeurtenissen definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wspólne wiadomości, aktywności i wydarzenia zostaną trwale usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai remover para sempre todas as mensagens, atividades e eventos compartilhados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate mesajele, activitățile și evenimentele comune vor fi șterse definitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все общие сообщения, активности и события будут удалены навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tar bort alla gemensamma meddelanden, aktiviteter och händelser för gott."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความ กิจกรรม และอีเวนต์ที่แชร์กันทั้งหมดจะถูกลบอย่างถาวร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm ortak mesajları, etkinlikleri ve olayları kalıcı olarak kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі спільні повідомлення, активності й події буде видалено назавжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn mọi tin nhắn, hoạt động và sự kiện chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除所有共享的消息、活动和事件。"
