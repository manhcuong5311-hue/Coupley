    "Recent moods for both of you, your partner's latest mood note, how long you've been together, and your first anniversary" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر حالات المزاج لكليكما، وأحدث ملاحظة مزاج من شريكك، ومدة علاقتكما، وأول ذكرى سنوية لكما"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedávné nálady vás obou, poslední poznámka k náladě tvého protějšku, jak dlouho jste spolu a vaše první výročí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneste humør for jer begge, din partners seneste humørnote, hvor længe I har været sammen, og jeres første årsdag"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten Stimmungen von euch beiden, die neueste Stimmungsnotiz deines Schatzes, wie lange ihr schon zusammen seid und euer erster Jahrestag"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πρόσφατες διαθέσεις σας, η τελευταία σημείωση διάθεσης του ταιριού σου, πόσο καιρό είστε μαζί και η πρώτη σας επέτειος"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estados de ánimo recientes de los dos, la última nota de ánimo de tu pareja, el tiempo de relación y el primer aniversario"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molempien viimeaikaiset mielialat, kumppanisi uusin mielialamuistiinpano, kuinka kauan olette olleet yhdessä sekä ensimmäinen vuosipäivänne"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga kamakailang mood ninyong dalawa, ang pinakabagong mood note ng partner mo, gaano na kayo katagal na magkasama, at ang unang anibersaryo ninyo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos humeurs récentes à vous deux, la dernière note d'humeur de ton/ta partenaire, depuis combien de temps vous êtes ensemble et votre premier anniversaire"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצבי הרוח האחרונים של שניכם, הערת מצב הרוח האחרונה של הצד השני, כמה זמן אתם ביחד ויום השנה הראשון שלכם"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप दोनों के हाल के मूड, आपके पार्टनर का सबसे नया मूड नोट, आप कितने समय से साथ हैं, और आपकी पहली सालगिरह"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindkettőtök legutóbbi hangulatai, a párod legutóbbi hangulati jegyzete, hogy mióta vagytok együtt, és az első évfordulótok"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mood terbaru kalian berdua, catatan mood terakhir pasanganmu, sudah berapa lama kalian bersama, dan hari jadi pertama kalian"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’umore recente di voi due, l’ultima nota sull’umore del tuo partner, da quanto state insieme e il vostro primo anniversario"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりの最近のムード、パートナーの最新のムードメモ、交際期間、最初の記念日"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사람의 최근 기분, 연인의 최근 기분 메모, 함께한 기간, 첫 기념일"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perasaan terkini anda berdua, nota perasaan terbaharu pasangan anda, berapa lama anda sudah bersama, dan ulang tahun pertama anda"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylig humør for dere begge, partnerens siste humørnotat, hvor lenge dere har vært sammen, og deres første årsdag"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recente stemmingen van jullie allebei, de laatste stemmingsnotitie van je partner, hoelang jullie samen zijn en jullie eerste jubileum"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasze ostatnie nastroje, najnowsza notatka nastroju twojej drugiej połówki, długość związku i wasza pierwsza rocznica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os humores recentes de vocês, a última nota de humor do seu amor, há quanto tempo estão juntos e o primeiro aniversário de namoro"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stările recente ale amândurora, ultima notă a partenerului tău despre starea sa, de cât timp sunteți împreună și prima voastră aniversare"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши недавние настроения, последняя заметка партнёра о настроении, сколько вы вместе и дата вашей первой годовщины"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaste humöret för er båda, din partners senaste humöranteckning, hur länge ni har varit tillsammans och er första årsdag"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อารมณ์ล่าสุดของทั้งคู่ โน้ตอารมณ์ล่าสุดของคนรัก ระยะเวลาที่คบกัน และวันครบรอบแรกของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinizin son ruh halleri, partnerinin son ruh hali notu, ne zamandır birlikte olduğunuz ve ilk yıl dönümünüz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останні настрої вас обох, остання нотатка про настрій твоєї половинки, скільки ви разом і ваша перша річниця"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâm trạng gần đây của cả hai bạn, ghi chú tâm trạng mới nhất của người ấy, thời gian hai bạn bên nhau và ngày kỷ niệm đầu tiên"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们俩近期的心情、另一半最新的心情备注、在一起多久，以及你们的第一个纪念日"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你們兩人最近的心情、另一半最新的心情筆記、你們在一起多久，以及你們的第一個紀念日"
          }
        }
      }
    },
