        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igen – épp ez a lényeg. Minden hozzájárulásnál látszik, ki adta hozzá, így a célkártya mutatja, hogyan oszlik meg köztetek. Az összeg attól függetlenül viszi előre a haladássávot, hogy ki járult hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
