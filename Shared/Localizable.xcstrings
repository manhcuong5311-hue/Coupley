        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βοήθεια στις σημαντικές στιγμές — γενέθλια, καβγάδες, ό,τι είναι ανάμεσα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda en momentos importantes — cumpleaños, peleas, todo lo demás"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apua tärkeisiin hetkiin – syntymäpäiviin, riitoihin ja kaikkeen siltä väliltä"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulong sa mahahalagang sandali — kaarawan, away, at lahat ng nasa pagitan"
