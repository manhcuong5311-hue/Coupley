        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai đều có thể điểm danh. Lỡ một ngày vẫn giữ được chuỗi — lỡ hai ngày sẽ phải bắt đầu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们俩都可以打卡。连续打卡可以弥补中断的1天——中断2天就要重新开始。"
