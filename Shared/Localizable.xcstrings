    "Coupley quietly takes care of the small things — so you can focus on each other." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتني Coupley بهدوء بالأشياء الصغيرة — لتتفرّغا لبعضكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley se nenápadně postará o drobnosti – a vy se můžete věnovat sobě navzájem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley tager sig stille og roligt af de små ting – så I kan fokusere på hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley kümmert sich leise um die kleinen Dinge – damit ihr euch aufeinander konzentrieren könnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Coupley φροντίζει αθόρυβα τα μικρά — για να εστιάζετε ο ένας στον άλλον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley se ocupa en silencio de las pequeñas cosas — para que los dos puedan centrarse el uno en el otro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley hoitaa pienet asiat hiljaa taustalla – niin voitte keskittyä toisiinne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahimik na inaasikaso ng Coupley ang maliliit na bagay — para makapagtuon kayo sa isa't isa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley s'occupe discrètement des petites choses — pour que vous puissiez vous consacrer à vous deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley דואגת בשקט לדברים הקטנים — כדי שתוכלו להתמקד זה בזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley चुपचाप छोटी-छोटी बातों का ध्यान रखता है — ताकि आप एक-दूसरे पर ध्यान दे सकें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Coupley csendben elintézi az apróságokat – hogy egymásra figyelhessetek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley diam-diam mengurus hal-hal kecil — supaya kalian bisa fokus satu sama lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley si occupa con discrezione delle piccole cose — così potete dedicarvi a voi due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupleyが小さなことをそっと引き受けるので、ふたりはお互いに集中できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley가 사소한 일은 조용히 챙길게요. 두 사람은 서로에게만 집중하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley menguruskan perkara kecil secara senyap — supaya anda boleh fokus pada satu sama lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley tar seg stille av de små tingene – så dere kan fokusere på hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupley regelt stilletjes de kleine dingen – zodat jullie je op elkaar kunnen richten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
