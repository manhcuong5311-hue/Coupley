        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עזרה ברגעים החשובים — ימי הולדת, ריבים, וכל מה שביניהם"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ास पलों में मदद — जन्मदिन, झगड़े, और बीच का सब कुछ"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segítség a fontos pillanatokban – születésnapok, veszekedések és minden, ami köztük van"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bantuan di momen penting — ulang tahun, pertengkaran, dan di antaranya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuto nei momenti importanti — compleanni, litigi e tutto ciò che sta in mezzo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日、ケンカ、その間の大切な瞬間もサポート"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일, 다툼, 그 사이의 모든 중요한 순간에 도움"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bantuan pada saat penting — hari jadi, pertengkaran, dan waktu di antaranya"
