    "Crowns mark 100 days, 1 year, 500 days, 2 years, 1000 days and beyond." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُكلَّل بالتيجان عند 100 يوم وسنة و500 يوم وسنتين و1000 يوم وما بعدها."
          }
        },
        "cs" : {
