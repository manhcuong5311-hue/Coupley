    "Carry their mood\non your home screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزاج شريكك\nعلى شاشتك الرئيسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měj náladu protějšku\nna ploše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hav din partners humør\npå din hjemmeskærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmung deines Schatzes\nauf deinem Home-Bildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διάθεση του ταιριού σου\nστην οθόνη Αφετηρίας σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva su ánimo\nen tu pantalla de inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänen mielialansa\nKoti-valikossasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalhin ang mood niya\nsa home screen mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde son humeur\nsur ton écran d'accueil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב הרוח של הצד השני\nעל מסך הבית שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनका मूड अपनी\nहोम स्क्रीन पर रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A párod hangulata\na kezdőképernyődön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa mood-nya\nke layar utamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta il suo umore\nnella schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーのムードを\nホーム画面に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연인의 기분을\n홈 화면에 담아 두세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa perasaannya\nke skrin utama anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha humøret til partneren din\npå Hjem-skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stemming van je partner\nop je beginscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miej nastrój drugiej połówki\nna ekranie głównym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O humor do seu amor\nna sua tela de início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starea partenerului tău,\npe ecranul principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроение партнёра —\nна экране «Домой»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha din partners humör\npå hemskärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พกอารมณ์ของคนรัก\nไว้บนหน้าจอโฮม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onun ruh hali\nana ekranında olsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настрій половинки —\nна твоєму початковому екрані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mang tâm trạng người ấy\nlên màn hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把另一半的心情\n放在主屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
