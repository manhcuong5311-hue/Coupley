            "value" : "Каждое воспоминание становится звездой вокруг вашего дерева. Партнёр видит его сразу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje minne du lägger till blir en stjärna runt ert träd. Din partner ser det direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกความทรงจำที่คุณเพิ่มจะกลายเป็นดวงดาวรอบต้นไม้ คนรักของคุณจะเห็นทันที"
