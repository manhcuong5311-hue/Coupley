            "state" : "translated",
            "value" : "اكتبوا رسالة للمستقبل بدلًا من ذلك؛ لا يفتحها إلا شريكك، ولا قبل موعدها بلحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiš raději dopis do budoucnosti – otevřít ho může jen adresát, a ani o chvilku dřív."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv et fremtidsbrev i stedet – kun modtageren kan åbne det, og ikke et øjeblik for tidligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib lieber einen Zukunftsbrief – nur dein Schatz kann ihn öffnen, und keinen Moment zu früh."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε καλύτερα ένα γράμμα για το μέλλον — μόνο το ταίρι σου μπορεί να το ανοίξει, και ούτε στιγμή νωρίτερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor escribe una carta al futuro: solo tu pareja podrá abrirla, y ni un momento antes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita sen sijaan tulevaisuuskirje – vain hän voi avata sen, eikä hetkeäkään etuajassa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumulat na lang ng liham sa hinaharap — siya lang ang makakapagbukas nito, at hindi kahit isang saglit nang maaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris plutôt une lettre au futur : seule cette personne pourra l'ouvrir, et pas une seconde trop tôt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לכתוב מכתב לעתיד במקום — רק לצד השני תהיה אפשרות לפתוח אותו, ולא רגע אחד מוקדם מדי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी जगह भविष्य का ख़त लिखें — सिर्फ़ वही इसे खोल पाएँगे, और एक पल भी पहले नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írj inkább jövőbeli levelet – csak ő nyithatja ki, és egy pillanattal sem korábban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis surat masa depan saja — hanya dia yang bisa membukanya, dan tidak sedetik pun lebih awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi invece una lettera per il futuro — solo il tuo partner potrà aprirla, e non un attimo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに未来への手紙を書きましょう。開けられるのはパートナーだけで、1秒たりとも早くは開けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대신 미래 편지를 써 보세요. 받는 사람만 열 수 있고, 단 1초도 일찍 열리지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis surat masa depan — hanya dia boleh membukanya, dan tidak sesaat pun lebih awal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv et fremtidsbrev i stedet – bare mottakeren kan åpne det, og ikke et øyeblikk for tidlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf dan een toekomstbrief – alleen je partner kan die openen, en geen moment te vroeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz zamiast tego list na przyszłość – tylko adresat może go otworzyć, i ani chwili wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva uma carta para o futuro — só essa pessoa pode abrir, e nem um segundo antes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrie mai bine o scrisoare pentru viitor — doar destinatarul o poate deschide, și nicio clipă mai devreme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда лучше напиши письмо в будущее — открыть его сможет только адресат и ни минутой раньше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ett framtidsbrev i stället – bara mottagaren kan öppna det, och inte en sekund för tidigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนจดหมายอนาคตแทน มีแค่คนรักที่เปิดได้ และเปิดก่อนเวลาไม่ได้แม้แต่วินาทีเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine bir geleceğe mektup yaz; yalnızca o açabilir, hem de bir an bile erken değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоді напиши лист у майбутнє — відкрити його зможе лише адресат, і ні миті раніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy viết thư tương lai — chỉ người ấy mở được, và không sớm một giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那就写一封未来信吧：只有对方能打开，而且一刻也不会提前。"
