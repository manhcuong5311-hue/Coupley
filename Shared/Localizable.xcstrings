        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми нагадуватимемо лише про те, що для тебе справді важливо — настрої, річниці, ніжні повідомлення від твоєї половинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng mình chỉ nhắc bạn về những điều bạn thật sự quan tâm — tâm trạng, ngày kỷ niệm, lời nhắn ngọt ngào từ người ấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们只会为你真正在意的事提醒你：心情、纪念日，还有另一半发来的甜蜜消息。"
