    "Values independence, needs space under pressure" : {
      "comment" : "Description of the 'Avoidant' attachment style",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير للاستقلالية وحاجة إلى مساحة تحت الضغط"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cení si nezávislosti, pod tlakem potřebuje prostor"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdsætter selvstændighed, har brug for plads under pres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzt Unabhängigkeit, braucht unter Druck Raum"
