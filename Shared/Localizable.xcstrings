    "Disconnecting stops real-time sync immediately. Your shared data stays in storage until you choose to delete it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فك الارتباط يوقف المزامنة الفورية مباشرةً. تبقى بياناتكما المشتركة محفوظة حتى تختاروا حذفها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpojením se synchronizace v reálném čase okamžitě zastaví. Sdílená data zůstanou uložená, dokud je nesmažeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du afbryder, stopper synkroniseringen i realtid med det samme. Jeres fælles data forbliver gemt, indtil du vælger at slette dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Trennen endet die Echtzeit-Synchronisierung sofort. Eure gemeinsamen Daten bleiben gespeichert, bis du sie löschst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διακοπή σύνδεσης σταματά αμέσως τον συγχρονισμό σε πραγματικό χρόνο. Τα κοινά σας δεδομένα μένουν αποθηκευμένα μέχρι να επιλέξεις να τα διαγράψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desconectar, la sincronización en tiempo real se detiene de inmediato. Tus datos compartidos se guardan hasta que decidas eliminarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyden katkaiseminen lopettaa reaaliaikaisen synkronoinnin heti. Yhteiset tietonne säilyvät, kunnes päätät poistaa ne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag nagdiskonekta, agad na humihinto ang real-time sync. Mananatili ang inyong shared data hanggang piliin mong burahin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion arrête immédiatement la synchro en temps réel. Vos données partagées restent stockées jusqu'à ce que tu choisisses de les supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הניתוק עוצר מיד את הסנכרון בזמן אמת. הנתונים המשותפים נשארים שמורים עד שבוחרים למחוק אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्कनेक्ट करते ही रियल-टाइम सिंक तुरंत रुक जाता है। आपका साझा डेटा तब तक स्टोरेज में रहता है, जब तक आप उसे हटाना न चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat bontása azonnal leállítja a valós idejű szinkront. A közös adataitok tárolva maradnak, amíg nem döntesz a törlésükről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutuskan koneksi langsung menghentikan sinkronisasi real time. Data bersama kalian tetap tersimpan sampai kamu memilih menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scollegarsi interrompe subito la sincronizzazione in tempo reale. I dati condivisi restano archiviati finché non scegli di eliminarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を解除すると、リアルタイムのシンクロはすぐに停止します。共有データは削除を選ぶまで保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 끊으면 실시간 동기화가 바로 중단돼요. 함께한 데이터는 직접 삭제하기 전까지 저장소에 남아 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutuskan sambungan akan menghentikan penyegerakan masa nyata serta-merta. Data kongsi anda kekal dalam storan sehingga anda memilih untuk memadamnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du kobler fra, stopper synkroniseringen i sanntid med en gang. De felles dataene deres blir liggende lagret til du velger å slette dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontkoppelen stopt de realtime sync meteen. Jullie gedeelde gegevens blijven bewaard tot je ze verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłączenie natychmiast zatrzymuje synchronizację na żywo. Wasze wspólne dane pozostają zapisane, dopóki nie zdecydujesz się ich usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao desconectar, a sincronização em tempo real para na hora. Seus dados compartilhados ficam guardados até você decidir excluí-los."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deconectarea oprește imediat sincronizarea în timp real. Datele voastre comune rămân stocate până alegi să le ștergi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После отключения синхронизация сразу остановится. Общие данные будут храниться, пока ты не решишь их удалить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du kopplar från slutar synken i realtid direkt. Er gemensamma data sparas tills du väljer att radera den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การยกเลิกการเชื่อมต่อจะหยุดการซิงค์แบบเรียลไทม์ทันที ข้อมูลที่แชร์กันจะยังถูกเก็บไว้จนกว่าคุณจะเลือกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı kesmek gerçek zamanlı senkronizasyonu hemen durdurur. Ortak verilerin, silmeyi seçene kadar saklanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від’єднання одразу зупиняє синхронізацію в реальному часі. Ваші спільні дані зберігаються, доки ти не вирішиш їх видалити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngắt kết nối sẽ dừng đồng bộ thời gian thực ngay lập tức. Dữ liệu chung vẫn được lưu trữ cho đến khi bạn chọn xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除连接后会立即停止实时同步。你们的共享数据会一直保存，直到你选择删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除連結後會立即停止即時同步。共享資料會一直保存，直到你選擇刪除。"
          }
        }
      }
    },
