    "Focus is a love language. Picking one to lead with usually moves them all." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التركيز لغة حب. اختيار هدف واحد تبدؤون به يحرّك البقية عادةً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soustředění je jazyk lásky. Když si vyberete jeden cíl jako hlavní, obvykle se pohnou všechny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus er et kærlighedssprog. Vælg ét at gå forrest med – så rykker de typisk alle sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus ist eine Liebessprache. Wenn ihr ein Ziel vorzieht, kommen meist alle voran."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εστίαση είναι γλώσσα αγάπης. Αν διαλέξεις έναν να προηγηθεί, συνήθως προχωρούν όλοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfocarse también es un lenguaje del amor. Elegir una para empezar suele mover todas las demás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskittyminen on rakkauden kieli. Kun valitsette yhden kärkeen, kaikki yleensä etenevät."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang focus ay isang love language. Kapag pumili kayo ng isang uunahin, kadalasan ay sumusulong ang lahat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se concentrer est un langage de l'amour. En choisir un pour commencer fait souvent avancer tous les autres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיקוד הוא שפת אהבה. בחירה במטרה אחת שתוביל בדרך כלל מקדמת את כולן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान देना भी प्रेम की एक भाषा है। किसी एक को आगे रखने से अक्सर सभी आगे बढ़ते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fókusz is szeretetnyelv. Ha kiválasztotok egyet, ami elöl jár, általában a többi is halad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus juga bahasa cinta. Memilih satu untuk diutamakan biasanya ikut menggerakkan semuanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche concentrarsi è un linguaggio dell’amore. Sceglierne uno da cui partire di solito fa avanzare tutti gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中することも愛の言語のひとつ。優先する目標をひとつ選ぶと、たいていすべてが前に進みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중도 사랑의 언어예요. 먼저 하나를 정해서 이끌면 대개 나머지도 함께 움직여요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus juga satu bahasa cinta. Memilih satu untuk didahulukan biasanya menggerakkan semuanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus er et kjærlighetsspråk. Satser dere på ett først, flytter de andre seg ofte også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus is ook een liefdestaal. Kies er één om mee te beginnen, dan komen ze meestal allemaal in beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupienie to też język miłości. Wybranie jednego celu na start zwykle popycha do przodu wszystkie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco também é uma linguagem do amor. Escolher uma para puxar a fila costuma fazer todas andarem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrarea e un limbaj al iubirii. Când alegeți unul ca prioritate, de obicei le mișcați pe toate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокус — тоже язык любви. Выбери одну главную цель — и обычно с места сдвинутся все."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus är ett kärleksspråk. Att välja ett mål att börja med brukar föra dem alla framåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การโฟกัสก็เป็นภาษารักอย่างหนึ่ง เลือกเป้าหมายหนึ่งให้นำ แล้วเป้าหมายอื่นมักจะขยับตามไปด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaklanmak da bir sevgi dili. Önceliği birine vermek çoğu zaman hepsini ilerletir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокус — теж мова кохання. Обери одну головну ціль — і зазвичай зрушать з місця всі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập trung cũng là một ngôn ngữ tình yêu. Chọn một mục tiêu dẫn đầu thường giúp mọi mục tiêu cùng tiến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注也是一种爱的语言。先挑一个重点推进，往往能带动所有目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專注也是一種愛之語。先挑一個帶頭，通常全部都會跟著前進。"
          }
        }
      }
    },
