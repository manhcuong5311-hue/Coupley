    "Account deletion isn't supported yet for the %@ sign-in method. Please contact support." : {
      "comment" : "The placeholder is a technical sign-in method id, such as phone or github.com",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف الحساب غير مدعوم بعد لطريقة تسجيل الدخول %@. يُرجى التواصل مع الدعم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání účtu zatím není pro způsob přihlášení %@ podporováno. Kontaktuj podporu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning af kontoen understøttes endnu ikke for loginmetoden %@. Kontakt support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Anmeldemethode %@ wird das Löschen des Accounts noch nicht unterstützt. Bitte wende dich an den Support."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή λογαριασμού δεν υποστηρίζεται ακόμα για τη μέθοδο σύνδεσης %@. Επικοινώνησε με την υποστήριξη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se puede eliminar la cuenta con el método de inicio de sesión %@. Contacta con soporte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilin poistoa ei vielä tueta kirjautumistavalle %@. Ota yhteyttä tukeen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa suportado ang pagbura ng account para sa sign-in method na %@. Makipag-ugnayan sa support."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression du compte n'est pas encore possible avec la méthode de connexion %@. Contacte l'assistance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אי אפשר למחוק חשבון עם שיטת ההתחברות %@. אפשר לפנות לתמיכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ साइन-इन तरीके के लिए अकाउंट हटाने की सुविधा अभी उपलब्ध नहीं है। कृपया सपोर्ट से संपर्क करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fióktörlés ennél a bejelentkezési módnál még nem támogatott: %@. Fordulj az ügyfélszolgálathoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghapusan akun belum didukung untuk metode masuk %@. Hubungi dukungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione dell’account non è ancora supportata per il metodo di accesso %@. Contatta l’assistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のサインイン方法では、アカウントの削除にまだ対応していません。サポートにお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 로그인 방식은 아직 계정 삭제를 지원하지 않아요. 고객 지원팀에 문의해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemadaman akaun belum disokong untuk kaedah log masuk %@. Hubungi sokongan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletting av konto støttes ikke ennå for innloggingsmetoden %@. Kontakt kundestøtte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account verwijderen wordt nog niet ondersteund voor de inlogmethode %@. Neem contact op met support."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
