    "More of the good stuff,\nless of the noise." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزيد من الأشياء الجميلة،\nوضجيج أقل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víc toho dobrého,\nméně šumu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere af det gode,\nmindre af støjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr vom Schönen,\nweniger vom Lärm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περισσότερα από τα καλά,\nλιγότερος θόρυβος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de lo bueno,\nmenos ruido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enemmän hyvää,\nvähemmän hälyä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas maraming maganda,\nmas kaunting ingay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de bons moments,\nmoins de bruit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מהדברים הטובים,\nפחות מהרעש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अच्छी चीज़ें ज़्यादा,\nशोर कम।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Több jó dolog,\nkevesebb zaj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak hal baik,\nlebih sedikit keributan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più cose belle,\nmeno rumore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うれしいことはもっと、\n雑音はもっと少なく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 건 더 많이,\n번거로운 건 더 적게."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih banyak perkara indah,\nkurang gangguan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer av det gode,\nmindre støy."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer van het goede,\nminder van de ruis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej tego, co dobre,\nmniej szumu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais do que é bom,\nmenos barulho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai mult din ce e bun,\nmai puțin zgomot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше хорошего,\nменьше шума."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer av det fina,\nmindre av bruset."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรื่องดีๆ มากขึ้น\nเรื่องวุ่นวายน้อยลง"
          }
        },
