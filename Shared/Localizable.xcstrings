    "Create your first shared moment.\nYour partner will see it instantly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئوا أول لحظة مشتركة.\nسيراها شريكك فورًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoř svůj první společný okamžik.\nTvůj protějšek ho hned uvidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret jeres første fælles øjeblik.\nDin partner kan se det med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg euren ersten gemeinsamen Moment an.\nDein Schatz sieht ihn sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε την πρώτη σας κοινή στιγμή.\nΤο ταίρι σου θα τη δει αμέσως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu primer momento compartido.\nTu pareja lo verá al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo ensimmäinen yhteinen hetkenne.\nKumppanisi näkee sen heti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gawin ang una ninyong pinagsasaluhang sandali.\nMakikita ito agad ng partner mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée votre premier moment à partager.\nTon/ta partenaire le verra aussitôt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר ליצור את הרגע המשותף הראשון שלכם.\nגם הצד השני יראה אותו מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पहला साझा पल बनाएँ।\nयह आपके पार्टनर को तुरंत दिखेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
