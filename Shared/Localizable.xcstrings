          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тільки знайомимося з вами — відповідайте далі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mới bắt đầu làm quen với hai bạn — cứ tiếp tục trả lời nhé."
          }
