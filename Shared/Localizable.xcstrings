    "Anniversaries sync between both of you —\npair up to start sharing countdowns." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتزامن الذكريات السنوية بينكما،\nاربطوا الحسابين لبدء مشاركة العدّادات التنازلية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výročí se synchronizují mezi vámi oběma –\npropojte se a sdílejte odpočty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsdage synkroniseres mellem jer begge –\nforbind jer for at dele nedtællinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahrestage werden zwischen euch beiden synchronisiert –\nverbindet euch, um Countdowns zu teilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επέτειοι συγχρονίζονται και στους δυο σας —\nσυνδεθείτε για να μοιράζεστε αντίστροφες μετρήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los aniversarios se sincronizan entre los dos —\nconéctate para empezar a compartir cuentas regresivas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuosipäivät synkronoituvat teidän molempien välillä –\nyhdistäkää tilit, niin voitte jakaa lähtölaskentoja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagsi-sync ang mga anibersaryo sa inyong dalawa —\nmagkonekta para magsimulang magbahagi ng countdown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anniversaires se synchronisent entre vous deux.\nConnectez vos comptes pour partager vos comptes à rebours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ימי השנה מסונכרנים בין שניכם —\nאחרי חיבור החשבונות אפשר לשתף ספירות לאחור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सालगिरह आप दोनों के बीच सिंक होती हैं —\nउलटी गिनतियाँ शेयर करने के लिए जुड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az évfordulók szinkronizálódnak kettőtök között –\nkapcsolódjatok össze, és osszátok meg a visszaszámlálásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari jadi tersinkron di antara kalian berdua —\nhubungkan akun untuk mulai berbagi hitung mundur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli anniversari si sincronizzano tra voi due —\ncollegatevi per condividere i conti alla rovescia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記念日はふたりの間で同期されます。\nペアリングしてカウントダウンを共有しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기념일은 두 사람 사이에 동기화돼요.\n연결하고 카운트다운을 함께 나눠 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulang tahun disegerakkan antara anda berdua —\nsambung untuk mula berkongsi kira detik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsdager synkroniseres mellom dere begge –\nkoble dere sammen for å dele nedtellinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jubilea worden tussen jullie allebei gesynct –\nkoppel om samen af te tellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rocznice synchronizują się między wami –\npołączcie się, by wspólnie odliczać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As datas especiais ficam sincronizadas entre vocês —\nconectem-se para compartilhar contagens regressivas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aniversările se sincronizează între voi —\nconectați-vă ca să împărțiți numărătorile inverse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годовщины синхронизируются у вас обоих —\nподключи партнёра, чтобы вести общие отсчёты."
