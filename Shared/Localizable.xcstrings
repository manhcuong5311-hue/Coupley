    "Both partners can see this goal and contribute to it. You can edit or delete it anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لكلا الشريكين رؤية هذا الهدف والمساهمة فيه. ويمكنكم تعديله أو حذفه في أي وقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento cíl vidíte oba a oba do něj můžete přispívat. Kdykoli ho můžeš upravit nebo smazat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kan begge se målet og bidrage til det. Du kan redigere eller slette det når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr beide könnt dieses Ziel sehen und dazu beitragen. Du kannst es jederzeit bearbeiten oder löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και οι δύο μπορείτε να βλέπετε αυτόν τον στόχο και να συνεισφέρετε. Μπορείς να τον επεξεργαστείς ή να τον διαγράψεις όποτε θέλεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos pueden ver esta meta y aportar. Puedes editarla o eliminarla cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te molemmat näette tämän tavoitteen ja voitte osallistua siihen. Voit muokata tai poistaa sen milloin tahansa."
