    "%@ ended the connection. Your shared data is still saved — you can review or delete it from Settings." : {
      "comment" : "Banner after a partner disconnects. The placeholder is the partner's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى الارتباط بقرار من %@. بياناتكما المشتركة ما زالت محفوظة، ويمكن مراجعتها أو حذفها من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – propojení ukončeno. Vaše sdílená data zůstávají uložená – můžeš je zkontrolovat nebo smazat v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har afbrudt forbindelsen. Jeres fælles data er stadig gemt – du kan gennemse eller slette dem under Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Verbindung getrennt. Eure gemeinsamen Daten sind weiterhin gespeichert – du kannst sie in den Einstellungen ansehen oder löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ διέκοψε τη σύνδεση. Τα κοινά σας δεδομένα παραμένουν αποθηκευμένα — μπορείς να τα δεις ή να τα διαγράψεις από τις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terminó la conexión. Tus datos compartidos siguen guardados: puedes revisarlos o eliminarlos en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ katkaisi yhteyden. Yhteiset tietonne ovat yhä tallessa – voit tarkastella tai poistaa niitä asetuksissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinapos ni %@ ang koneksyon. Naka-save pa rin ang inyong shared data — puwede mo itong tingnan o burahin sa Mga Setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a mis fin à la connexion. Vos données partagées sont toujours enregistrées : tu peux les consulter ou les supprimer dans les Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור נותק על ידי %@. הנתונים המשותפים עדיין שמורים, ואפשר לעיין בהם או למחוק אותם בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने कनेक्शन ख़त्म कर दिया। आपका साझा डेटा अब भी सेव है — आप सेटिंग्स में जाकर उसे देख या हटा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bontotta a kapcsolatot. A közös adataitok megmaradtak – a Beállításokban áttekintheted vagy törölheted őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ memutuskan koneksi. Data bersama kalian masih tersimpan — kamu bisa meninjau atau menghapusnya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha chiuso il collegamento. I vostri dati condivisi sono ancora salvati — puoi rivederli o eliminarli dalle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんが接続を解除しました。共有データは保存されたままです。設定から確認・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 연결을 끊었어요. 함께한 데이터는 그대로 저장되어 있으니 설정에서 확인하거나 삭제할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ telah memutuskan sambungan. Data kongsi anda masih disimpan — anda boleh menyemak atau memadamnya dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avsluttet tilkoblingen. De felles dataene deres er fortsatt lagret – du kan se gjennom eller slette dem i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de verbinding verbroken. Jullie gedeelde gegevens zijn nog bewaard – je kunt ze bekijken of verwijderen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie z drugą połówką (%@) zostało zakończone. Wasze wspólne dane są nadal zapisane – możesz je przejrzeć lub usunąć w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ encerrou a conexão. Seus dados compartilhados continuam salvos — você pode revisá-los ou excluí-los em Ajustes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a încheiat conexiunea. Datele voastre comune sunt încă salvate — le poți revedea sau șterge din Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: связь разорвана. Ваши общие данные сохранены — их можно посмотреть или удалить в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har kopplat från er. Er gemensamma data finns kvar – du kan granska eller radera den i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ยกเลิกการเชื่อมต่อแล้ว ข้อมูลที่แชร์กันยังถูกเก็บไว้ คุณสามารถดูหรือลบได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantıyı sonlandırdı. Ortak verilerin hâlâ kayıtlı; Ayarlar'dan inceleyebilir veya silebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: з’єднання завершено. Ваші спільні дані збережено — їх можна переглянути або видалити в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã ngắt kết nối. Dữ liệu chung của hai bạn vẫn được lưu — bạn có thể xem lại hoặc xóa trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已解除连接。你们的共享数据仍然保留，你可以在“设置”中查看或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已解除連結。你們的共享資料仍保留著，可以到「設定」查看或刪除。"
          }
        }
      }
    },
