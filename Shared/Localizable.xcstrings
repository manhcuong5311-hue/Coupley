    "Seal a letter for %@ to open on a day you pick. Letters %@ writes you show up here too." : {
      "comment" : "Journey letters section with no letters yet. Both %@ are the partner's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختموا رسالة إلى %1$@ تُفتح في يوم تختارونه. وتظهر هنا أيضًا رسائل %2$@ إليك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapečeť dopis, který %1$@ otevře v den, který zvolíš. Objeví se tu i dopisy, které ti napíše %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsegl et brev, som %1$@ kan åbne på en dag, du vælger. Breve, som %2$@ skriver til dig, dukker også op her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiegle einen Brief, den %1$@ an einem Tag deiner Wahl öffnen kann. Briefe, die %2$@ dir schreibt, erscheinen auch hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σφράγισε ένα γράμμα για %1$@, να το ανοίξει τη μέρα που θα διαλέξεις. Τα γράμματα που σου γράφει %2$@ εμφανίζονται κι αυτά εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Seal a letter for %1$@ to open on a day you pick. Letters %2$@ writes you show up here too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sella una carta para que %1$@ la abra el día que elijas. Las cartas que %2$@ te escriba también aparecen aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinetöi kirje, jonka %1$@ saa avata valitsemanasi päivänä. Myös kirjeet, jotka %2$@ kirjoittaa sinulle, näkyvät täällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magselyo ng liham para kay %1$@ na mabubuksan sa araw na pipiliin mo. Lalabas din dito ang mga liham na isinusulat sa iyo ni %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scelle une lettre que %1$@ ouvrira le jour que tu choisis. Les lettres que %2$@ t'écrit apparaissent ici aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לחתום מכתב ל־%1$@ שייפתח ביום שבוחרים. גם מכתבים מ־%2$@ אליך יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ के लिए एक ख़त बंद करें, जो आपके चुने दिन खुलेगा। %2$@ आपके लिए जो ख़त लिखेंगे, वे भी यहीं दिखेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pecsételj le egy levelet %1$@ számára, amelyet egy általad választott napon nyithat ki. Azok a levelek is itt jelennek meg, amelyeket %2$@ ír neked."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segel surat untuk dibuka %1$@ di hari yang kamu pilih. Surat yang ditulis %2$@ untukmu juga muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigilla una lettera che %1$@ potrà aprire il giorno che scegli. Anche le lettere che %2$@ scrive a te compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@さんへの手紙に封をして、選んだ日に開封されるようにしましょう。%2$@さんからの手紙もここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 날에 %1$@ 님이 열 수 있도록 편지를 봉인해 보세요. %2$@ 님이 쓴 편지도 여기에 나타나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meterai surat untuk dibuka oleh %1$@ pada hari yang anda pilih. Surat yang %2$@ tulis untuk anda juga akan muncul di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsegl et brev som %1$@ kan åpne på en dag du velger. Brev %2$@ skriver til deg, dukker også opp her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzegel een brief die %1$@ op een dag naar keuze opent. Brieven die %2$@ jou schrijft, staan hier ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapieczętuj list, który %1$@ otworzy w wybranym przez ciebie dniu. Tu pojawią się też listy, które %2$@ pisze do ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lacre uma carta para %1$@ abrir no dia que você escolher. As cartas que %2$@ escrever para você também aparecem aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigilează o scrisoare pe care %1$@ s-o deschidă într-o zi aleasă de tine. Scrisorile pe care ți le scrie %2$@ apar tot aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запечатай письмо — %1$@ откроет его в выбранный тобой день. Письма, которые пишет тебе %2$@, тоже появятся здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försegla ett brev som %1$@ får öppna en dag du väljer. Brev som %2$@ skriver till dig visas också här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผนึกจดหมายให้ %1$@ เปิดในวันที่คุณเลือก จดหมายที่ %2$@ เขียนถึงคุณก็จะแสดงที่นี่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ için, seçtiğin bir günde açılacak bir mektup mühürle. %2$@ sana yazdığında o mektuplar da burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запечатай лист, який %1$@ відкриє в обраний тобою день. Листи, які %2$@ пише тобі, теж з’являться тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niêm phong một lá thư để %1$@ mở vào ngày bạn chọn. Thư %2$@ viết cho bạn cũng sẽ hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存一封信，让%1$@在你选定的日子打开。%2$@写给你的信也会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存一封信，讓%1$@在你選定的日子開啟。%2$@寫給你的信也會出現在這裡。"
          }
        }
      }
    },
