    "An old tree. Remarkable, rare." : {
      "comment" : "Journey hero caption for the Ancient tree stage",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شجرة معمّرة. استثنائية ونادرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starý strom. Výjimečný, vzácný."
          }
