    "Both partners can check in. Streaks recover one missed day — break two and you'll restart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لكلا الشريكين التسجيل. تصمد السلسلة أمام يوم فائت واحد — وإن فاتكم يومان تبدأ من جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisovat můžete oba. Série vydrží jeden vynechaný den – vynecháte-li dva, začínáte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kan begge tjekke ind. En stribe tåler én glemt dag – glemmer I to dage, starter den forfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr könnt beide einchecken. Ein verpasster Tag wird verziehen – bei zwei fangt ihr neu an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να κάνετε καταγραφή και οι δύο. Το σερί αντέχει μία χαμένη μέρα — αν χάσετε δύο, ξεκινάτε από την αρχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos pueden registrar. Las rachas aguantan un día perdido — si se pierden dos, empiezan de cero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te molemmat voitte tehdä merkintöjä. Putki kestää yhden väliin jääneen päivän – kahden jälkeen aloitatte alusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwedeng mag-check-in ang inyong dalawa. Nababawi ang streak kapag isang araw ang na-miss — kapag dalawa, magsisimula ulit kayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez faire le check-in tous les deux. Une série survit à un jour manqué — au bout de deux, elle repart de zéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שניכם יכולים לעדכן. רצף שורד יום אחד שהוחמץ — אחרי יומיים הוא מתחיל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों पार्टनर चेक-इन कर सकते हैं। एक दिन छूटने पर स्ट्रीक बची रहती है — दो दिन छूटे तो फिर से शुरू करना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindketten kipipálhatjátok. Egy kihagyott napot elnéz a sorozat – kettő után újraindul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalian berdua bisa check-in. Runtunan bisa pulih dari satu hari terlewat — terlewat dua hari, runtunan mulai dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi potete fare il check-in. La serie sopravvive a un giorno saltato — saltane due e si ricomincia da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりともチェックインできます。1日の抜けなら連続記録は続きますが、2日抜けるとリセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사람 모두 체크인할 수 있어요. 하루를 놓쳐도 연속 기록은 이어지지만, 이틀을 놓치면 처음부터 다시 시작해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua-dua pasangan boleh mencatat. Rentetan boleh pulih daripada satu hari yang terlepas — terlepas dua hari dan anda akan bermula semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere kan begge sjekke inn. En rekke tåler én tapt dag – mister dere to, starter dere på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jullie kunnen allebei inchecken. Een reeks overleeft één gemiste dag – mis je er twee, dan begin je opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde z was może odhaczać. Seria przetrwa jeden pominięty dzień – po dwóch zaczynasz od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois podem fazer check-in. A sequência perdoa um dia perdido — perca dois e ela recomeça."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amândoi puteți face check-in. Seria trece peste o zi ratată — dacă ratați două, o luați de la capăt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечаться могут оба. Серия переживёт один пропущенный день — после двух пропусков она начнётся заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni kan båda checka in. En missad dag förlåts – missar ni två börjar sviten om."
