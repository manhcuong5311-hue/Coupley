    "Answer a few quizzes together to start building your profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجيبا عن بعض الاختبارات معًا لبدء بناء ملفكما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
