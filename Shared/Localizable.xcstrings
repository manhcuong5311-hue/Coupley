    "For your security, please sign out and sign back in, then try deleting again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفاظًا على أمانكم، يُرجى تسجيل الخروج ثم تسجيل الدخول من جديد، ثم إعادة محاولة الحذف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli zabezpečení se odhlas, znovu přihlas a pak zkus smazání znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af hensyn til din sikkerhed skal du logge ud og ind igen og derefter prøve at slette igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu deiner Sicherheit: Bitte melde dich ab und wieder an und versuch das Löschen dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την ασφάλειά σου, αποσυνδέσου και συνδέσου ξανά και μετά δοκίμασε πάλι τη διαγραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por tu seguridad, cierra sesión, vuelve a iniciarla e intenta eliminar la cuenta de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu turvallisuussyistä ulos ja takaisin sisään ja yritä poistoa sitten uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa seguridad mo, mag-sign out at mag-sign in ulit, saka subukang burahin muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ta sécurité, déconnecte-toi puis reconnecte-toi, et réessaie la suppression."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מטעמי אבטחה, צריך להתנתק ולהתחבר מחדש, ואז לנסות למחוק שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सुरक्षा के लिए, कृपया साइन आउट करके फिर से साइन इन करें, फिर दोबारा हटाने की कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztonsági okból jelentkezz ki, majd be újra, és próbáld meg ismét a törlést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi keamananmu, keluar lalu masuk lagi, kemudian coba hapus lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la tua sicurezza, esci e accedi di nuovo, poi riprova a eliminare l’account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティのため、一度サインアウトしてから再度サインインし、もう一度削除をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안을 위해 로그아웃 후 다시 로그인한 다음, 삭제를 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi keselamatan anda, log keluar dan log masuk semula, kemudian cuba padam lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av sikkerhetshensyn må du logge ut og inn igjen før du prøver å slette på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log voor je veiligheid uit en weer in, en probeer het dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze względów bezpieczeństwa wyloguj się, zaloguj ponownie i spróbuj usunąć konto jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por segurança, saia e entre de novo na sua conta, depois tente excluir outra vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru siguranța ta, ieși din cont și intră din nou, apoi încearcă iar ștergerea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В целях безопасности выйди из аккаунта, войди снова и повтори удаление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av säkerhetsskäl behöver du logga ut och logga in igen och sedan försöka radera på nytt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อความปลอดภัย โปรดออกจากระบบแล้วเข้าสู่ระบบใหม่ จากนั้นลองลบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenliğin için lütfen çıkış yapıp tekrar giriş yap, sonra silmeyi yeniden dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З міркувань безпеки вийди й увійди знову, а потім спробуй видалити ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để bảo mật, vui lòng đăng xuất rồi đăng nhập lại, sau đó thử xóa lần nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了你的账户安全，请先退出登录再重新登录，然后再次尝试删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了你的安全，請先登出再重新登入，然後再試一次刪除。"
          }
        }
      }
    },
