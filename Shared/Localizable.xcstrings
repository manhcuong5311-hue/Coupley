          "stringUnit" : {
            "state" : "translated",
            "value" : "היי %@! אפשר ליצור קוד הזמנה או להזין\nאת הקוד של הצד השני כדי להתחיל בסנכרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते %@! इनवाइट कोड बनाएँ या सिंक शुरू करने के लिए\nअपने पार्टनर का कोड डालें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia, %@! Hozz létre egy meghívókódot, vagy add meg\na párod kódját az összekapcsoláshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Buat kode undangan atau masukkan\nkode pasanganmu untuk mulai sinkron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Crea un codice invito o inserisci\nquello del tuo partner per iniziare a sincronizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さん、こんにちは！招待コードを作成するか、\nパートナーのコードを入力してシンクロを始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님, 안녕하세요! 초대 코드를 만들거나\n연인의 코드를 입력해 연결해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Cipta kod jemputan atau masukkan\nkod pasangan anda untuk mula menyegerak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei, %@! Lag en invitasjonskode eller skriv inn\nkoden til partneren din for å komme i gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %@! Maak een uitnodigingscode of voer\nde code van je partner in om te gaan syncen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %@! Utwórz kod zaproszenia lub wpisz\nkod drugiej połówki, by zacząć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, %@! Crie um código de convite ou digite\no código do seu amor para entrar em sintonia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut, %@! Creează un cod de invitație sau introdu\ncodul partenerului tău ca să vă sincronizați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет, %@! Создай код приглашения или введи\nкод партнёра, чтобы начать синхронизацию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej %@! Skapa en inbjudningskod eller ange\ndin partners kod för att komma igång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวัสดี %@ สร้างรหัสเชิญหรือกรอก\nรหัสของคนรักเพื่อเริ่มซิงค์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba %@! Bir davet kodu oluştur ya da\nbağlanmak için partnerinin kodunu gir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт, %@! Створи код запрошення або введи\nкод половинки, щоб почати синхронізацію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào %@! Tạo mã mời hoặc nhập\nmã của người ấy để bắt đầu đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨，%@！创建邀请码，或输入\n另一半的邀请码，开始同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨，%@！建立邀請碼，或輸入\n另一半的邀請碼來開始同步。"
          }
        }
      }
    },
