    "%@'s photo appears the moment they send one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر صورة %@ لحظة إرسالها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile %@ pošle fotku, hned se tu objeví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@s foto dukker op, så snart det er sendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto von %@ erscheint, sobald es gesendet wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φωτογραφία από %@ θα εμφανιστεί μόλις τη στείλει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto de %@ aparecerá en cuanto la envíe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva tulee näkyviin heti, kun %@ lähettää sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalabas ang litrato ni %@ sa sandaling magpadala siya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo de %@ apparaîtra dès son envoi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה של %@ תופיע ברגע שתישלח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के फ़ोटो भेजते ही वह यहाँ दिखेगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fotója abban a pillanatban megjelenik, amint elküldi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto %@ akan muncul begitu dia mengirimnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto di %@ comparirà non appena verrà inviata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんが送ると、すぐに写真が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 사진을 보내면 바로 여기에 나타나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto %@ akan muncul sebaik sahaja dia menghantarnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet til %@ dukker opp i det øyeblikket det sendes."
          }
        },
