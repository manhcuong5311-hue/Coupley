        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il coach AI di Coupley e i suggerimenti sull’umore sono scritti da OpenAI. Per ottenere una risposta, questi dati vengono inviati a OpenAI tramite i nostri server:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoupleyのAIコーチとムードの提案はOpenAIが作成しています。返答を得るため、以下の情報が当社のサーバーを通じてOpenAIに送信されます："
          }
