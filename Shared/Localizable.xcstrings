          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat momen bersama pertama kalian.\nPasanganmu langsung bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea il vostro primo momento condiviso.\nIl tuo partner lo vedrà subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のふたりの瞬間を作りましょう。\nパートナーにもすぐに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 특별한 순간을 만들어 보세요.\n연인에게도 바로 보여요."
          }
        },
        "ms" : {
