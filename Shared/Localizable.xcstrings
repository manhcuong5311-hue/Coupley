        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde dodane wspomnienie staje się gwiazdą wokół twojego drzewa. Twoja druga połówka widzi je od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lembrança que você adiciona vira uma estrela ao redor da sua árvore. Seu amor vê na hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
