    "Just getting to know you two — keep answering." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما زلنا نتعرّف إليكما، واصلا الإجابة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teprve vás dva poznáváme – odpovídejte dál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi er lige begyndt at lære jer to at kende – bliv ved med at svare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir lernen euch gerade erst kennen – antwortet weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις αρχίζουμε να σας γνωρίζουμε — συνεχίστε να απαντάτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía estamos conociendo a los dos. Sigue respondiendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasta tutustumme teihin – jatkakaa vastaamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinikilala pa lang namin kayong dalawa — sumagot pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On commence tout juste à vous connaître : continuez à répondre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק מתחילים להכיר אתכם — כדאי להמשיך לענות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी हमने आप दोनों को जानना शुरू ही किया है — जवाब देते रहें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még csak most ismerkedünk veletek – válaszoljatok tovább."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baru mulai mengenal kalian berdua — terus jawab ya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiamo appena iniziando a conoscervi — continuate a rispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたりのことを知り始めたところです。回答を続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 막 두 사람을 알아가는 중이에요. 계속 답해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baru mula mengenali anda berdua — teruskan menjawab."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har så vidt begynt å bli kjent med dere to – fortsett å svare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We leren jullie net kennen – blijf antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopiero was poznajemy – odpowiadajcie dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda estamos conhecendo vocês — continuem respondendo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abia începem să vă cunoaștem — continuați să răspundeți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы только знакомимся с вами — отвечайте дальше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har precis börjat lära känna er två – fortsätt svara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่งเริ่มรู้จักคุณทั้งสอง ตอบต่อไปเรื่อยๆ นะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
