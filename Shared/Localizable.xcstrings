    "Delivered quietly — tap to grant full access" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل بهدوء: اضغطوا لمنح الوصول الكامل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doručováno potichu – klepni a povol plný přístup"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leveres lydløst – tryk for at give fuld adgang"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird still zugestellt – tippen für vollen Zugriff"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραδίδονται αθόρυβα — πάτησε για πλήρη πρόσβαση"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega silenciosa: toca para dar acceso completo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset tulevat hiljaa – anna täysi lupa napauttamalla"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahimik na dumarating — i-tap para magbigay ng buong access"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribuées discrètement : touche pour autoriser l'accès complet"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נמסרות בשקט — הקשה תעניק גישה מלאה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुपचाप डिलीवर होते हैं — पूरी अनुमति देने के लिए टैप करें"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csendes kézbesítés – koppints a teljes hozzáféréshez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikirim diam-diam — ketuk untuk memberi akses penuh"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recapitate in modo silenzioso — tocca per concedere l’accesso completo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目立たない形で配信中 — タップしてすべて許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용히 전달 중 — 탭해서 모든 권한 허용하기"
