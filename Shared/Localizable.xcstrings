        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami hanya akan mencuit anda untuk perkara yang benar-benar anda pedulikan — perasaan, ulang tahun, mesej manis daripada pasangan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
