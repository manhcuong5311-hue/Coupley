    "As many as you like. Goals, challenges and the full Dream Board with photos are free for everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقدر ما تشاؤون. الأهداف والتحديات ولوحة الأحلام الكاملة بالصور مجانية للجميع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik chcete. Cíle, výzvy i celá nástěnka snů s fotkami jsou zdarma pro všechny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mange, I vil. Mål, udfordringer og hele drømmetavlen med fotos er gratis for alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viele ihr wollt. Ziele, Challenges und das komplette Traumboard mit Fotos sind für alle kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσους θέλετε. Οι στόχοι, οι προκλήσεις και ολόκληρος ο πίνακας ονείρων με φωτογραφίες είναι δωρεάν για όλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los que quieras. Las metas, los retos y el tablero de sueños completo con fotos son gratis para todos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niin monta kuin haluatte. Tavoitteet, haasteet ja koko unelmataulu kuvineen ovat ilmaisia kaikille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit ilan. Libre para sa lahat ang mga layunin, hamon, at buong Dream Board na may mga litrato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autant que vous voulez. Les objectifs, les défis et le tableau des rêves complet avec photos sont gratuits pour tout le monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה שרוצים. מטרות, אתגרים ולוח החלומות המלא עם תמונות — הכול בחינם לכולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जितने चाहें। लक्ष्य, चैलेंज और फ़ोटो के साथ पूरा ड्रीम बोर्ड सबके लिए मुफ़्त है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amennyit csak szeretnétek. A célok, a kihívások és a teljes álomtábla fotókkal mindenkinek ingyenes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebanyak yang kalian mau. Target, tantangan, dan Papan Impian lengkap dengan foto gratis untuk semua orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti ne volete. Obiettivi, sfide e la bacheca dei sogni completa con foto sono gratuiti per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつでも作れます。目標、チャレンジ、写真付きのドリームボードはすべて、誰でも無料で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 만큼 만들 수 있어요. 목표, 챌린지, 사진이 포함된 꿈 보드 전체를 누구나 무료로 쓸 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa banyak yang anda mahu. Matlamat, cabaran dan Papan Impian penuh dengan foto adalah percuma untuk semua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mange dere vil. Mål, utfordringer og hele drømmetavlen med bilder er gratis for alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoveel je wilt. Doelen, uitdagingen en het volledige droombord met foto’s zijn gratis voor iedereen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile tylko chcecie. Cele, wyzwania i pełna Tablica marzeń ze zdjęciami są bezpłatne dla wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos quiserem. Metas, desafios e o Mural dos sonhos completo com fotos são gratuitos para todo mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câte vreți. Obiectivele, provocările și panoul viselor complet, cu poze, sunt gratuite pentru toată lumea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько угодно. Цели, челленджи и вся доска мечт с фото бесплатны для всех."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så många ni vill. Mål, utmaningar och hela drömtavlan med foton är gratis för alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีได้ไม่จำกัด เป้าหมาย ชาเลนจ์ และบอร์ดความฝันพร้อมรูปภาพเต็มรูปแบบใช้ได้ฟรีสำหรับทุกคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz kadar. Hedefler, görevler ve fotoğraflı Hayal Panosu'nun tamamı herkes için ücretsiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки завгодно. Цілі, челенджі та повна дошка мрій із фото безкоштовні для всіх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao nhiêu tùy thích. Mục tiêu, thử thách và Bảng ước mơ đầy đủ kèm ảnh đều miễn phí cho mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要多少都可以。目标、挑战以及带照片的完整梦想板，对所有人都免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想建立幾個都可以。目標、挑戰和含照片的完整夢想板，全部免費開放給每個人。"
          }
        }
      }
    },
