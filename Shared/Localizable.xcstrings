          "stringUnit" : {
            "state" : "translated",
            "value" : "Șapte ani. Rar, și încă în creștere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семь лет. Редкость — и всё ещё растёт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sju år. Sällsynt, och ni växer fortfarande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เจ็ดปี หาได้ยาก และยังคงเติบโต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedi yıl. Nadir ve hâlâ büyüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сім років. Рідкість — і досі росте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảy năm. Hiếm có, và vẫn đang lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "七年了，难得，而且仍在生长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "七年了，難能可貴，仍在成長。"
          }
        }
      }
    },
