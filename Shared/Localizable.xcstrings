    "Once it's sealed you can't edit it. You can unsend it until it opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ختمها لا يمكن تعديلها، لكن يمكن إلغاء إرسالها حتى موعد فتحها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapečetěný dopis už nejde upravit. Odeslání můžeš zrušit, dokud se neotevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er forseglet, kan du ikke redigere det. Du kan trække det tilbage, indtil det åbner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Versiegeln kannst du ihn nicht mehr bearbeiten. Zurückziehen geht, bis er sich öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις σφραγιστεί, δεν μπορείς να το επεξεργαστείς. Μπορείς να το ανακαλέσεις μέχρι να ανοίξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando esté sellada no podrás editarla. Puedes anular el envío hasta que se abra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinetöityä kirjettä ei voi muokata. Voit perua lähetyksen, kunnes se aukeaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag naselyuhan na, hindi mo na ito mae-edit. Puwede mo itong bawiin hangga't hindi pa nabubuksan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois scellée, tu ne pourras plus la modifier. Tu peux annuler l'envoi jusqu'à son ouverture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי החתימה אי אפשר לערוך. אפשר לבטל את השליחה עד שהמכתב ייפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने के बाद इसे बदला नहीं जा सकता। खुलने से पहले तक इसे वापस लिया जा सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepecsételés után már nem szerkesztheted. Amíg ki nem nyílik, visszavonhatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah disegel, surat tidak bisa diedit. Kamu bisa menariknya kembali sebelum dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta sigillata non potrai modificarla. Puoi annullare l’invio finché non si apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封をしたあとは編集できません。開封されるまでは送信を取り消せます。"
