        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sturen je alleen een seintje voor wat je echt belangrijk vindt – stemmingen, jubilea, lieve berichten van je partner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Będziemy przypominać tylko o tym, na czym ci naprawdę zależy – nastrojach, rocznicach, czułych wiadomościach od drugiej połówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
