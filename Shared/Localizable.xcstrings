    "e.g. Direct, playful, needs space when stressed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثلًا: صراحة، مرح، حاجة إلى مساحة عند التوتر"
          }
        },
        "cs" : {
          "stringUnit" : {
