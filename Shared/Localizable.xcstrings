            "value" : "Akar yang kukuh, kanopi yang luas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterke røtter, en vid krone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterke wortels, een brede kruin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mocne korzenie, szeroka korona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raízes fortes, copa larga."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rădăcini puternice, coroană largă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крепкие корни, широкая крона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starka rötter, en vid krona."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รากแข็งแรง ร่มเงากว้างใหญ่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlü kökler, geniş bir taç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Міцне коріння, широка крона."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rễ vững, tán rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根深叶茂，树冠宽广。"
