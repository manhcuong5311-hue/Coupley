    "Come back tomorrow to share how you're feeling. Your partner can still see your moods." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عودوا غدًا لمشاركة ما تشعرون به. ما زال بإمكان شريكك رؤية حالاتك المزاجية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrať se zítra a poděl se o to, jak se cítíš. Tvůj protějšek tvoje nálady pořád uvidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tilbage i morgen og del, hvordan du har det. Din partner kan stadig se dit humør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm morgen wieder, um zu teilen, wie es dir geht. Dein Schatz kann deine Stimmungen weiterhin sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλα ξανά αύριο να πεις πώς νιώθεις. Το ταίρι σου μπορεί ακόμα να βλέπει τις διαθέσεις σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve mañana para contar cómo te sientes. Tu pareja aún puede ver tus estados de ánimo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tule huomenna takaisin kertomaan, miltä sinusta tuntuu. Kumppanisi näkee silti mielialasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumalik bukas para ibahagi ang nararamdaman mo. Nakikita pa rin ng partner mo ang mga mood mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reviens demain pour partager ce que tu ressens. L'autre peut toujours voir tes humeurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לחזור מחר ולשתף איך ההרגשה. מצבי הרוח שלך עדיין גלויים לצד השני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना हाल बताने के लिए कल फिर आएँ। आपके मूड अब भी आपके पार्टनर को दिखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyere vissza holnap, és oszd meg, hogy érzed magad. A párod továbbra is látja a hangulataidat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali lagi besok untuk berbagi perasaanmu. Pasanganmu tetap bisa melihat mood-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna domani per condividere come ti senti. Il tuo partner può comunque vedere i tuoi stati d’animo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また明日、気持ちをシェアしてください。パートナーは引き続きあなたのムードを見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 다시 와서 기분을 나눠 주세요. 연인은 계속 내 기분을 볼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali esok untuk berkongsi perasaan anda. Pasangan anda masih boleh melihat perasaan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tilbake i morgen for å dele hvordan du har det. Partneren din kan fortsatt se humøret ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom morgen terug om te delen hoe je je voelt. Je partner kan je stemmingen nog steeds zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć jutro, by podzielić się nastrojem. Twoja druga połówka nadal widzi twoje nastroje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte amanhã para contar como você está. Seu amor ainda pode ver seus humores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revino mâine ca să spui cum te simți. Partenerul tău îți poate vedea în continuare stările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращайся завтра, чтобы рассказать о своём настроении. Партнёр по-прежнему видит твои отметки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tillbaka i morgon och berätta hur du mår. Din partner kan fortfarande se ditt humör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลับมาแชร์ความรู้สึกใหม่พรุ่งนี้ คนรักของคุณยังเห็นอารมณ์ของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasıl hissettiğini paylaşmak için yarın tekrar gel. Partnerin ruh hallerini yine görebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертайся завтра, щоб поділитися настроєм. Твоя половинка й далі бачить твої настрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày mai quay lại chia sẻ cảm xúc nhé. Người ấy vẫn xem được tâm trạng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天再来分享你的感受吧。另一半仍然可以看到你的心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天再來分享你的感受吧。另一半仍然看得到你的心情。"
          }
        }
      }
    },
    "Comfortable with closeness and independence" : {
