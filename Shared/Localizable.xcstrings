    "Permanently delete your account and all your data. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف حسابك وكل بياناتك نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smazat účet a všechna tvoje data. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet din konto og alle dine data permanent. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche deinen Account und alle deine Daten endgültig. Das kann nicht rückgängig gemacht werden."
