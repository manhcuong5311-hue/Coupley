    "💌 I sealed a letter for you. It's pinned on Home until it opens." : {
      "comment" : "Chat message the sender posts when sealing a future letter.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 ختمت رسالة لك. ستبقى مثبّتة في الرئيسية حتى تُفتح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Mám pro tebe zapečetěný dopis. Až do otevření bude připnutý na kartě Domů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Jeg har forseglet et brev til dig. Det er fastgjort på Hjem, indtil det åbner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Ich habe einen Brief für dich versiegelt. Er ist unter „Start“ angepinnt, bis er sich öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Σφράγισα ένα γράμμα για σένα. Είναι καρφιτσωμένο στην Αρχική μέχρι να ανοίξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Sellé una carta para ti. Estará fijada en Inicio hasta que se abra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Sinetöin sinulle kirjeen. Se on kiinnitetty Koti-välilehdelle, kunnes se aukeaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💌 Nagselyo ako ng liham para sa iyo. Naka-pin ito sa Home hanggang sa mabuksan."
          }
