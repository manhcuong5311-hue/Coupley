rules_version = '2';

// Firestore security rules for Coupley.
//
// Data model:
//   /users/{uid}                                       — user profile + tokens
//   /pairingCodes/{code}                               — ephemeral invite codes
//   /couples/{coupleId}                                — userIds: [uidA, uidB]
//     /moods/{moodId}                                  — author: userId
//       /reactions/{reactionId}                        — author: userId
//     /syncScores/{date}                               — daily rollup
//     /messages/{msgId}                                — chat messages
//     /quizzes/{quizId}                                — chat quizzes
//     /liveState/{docId}                               — typing / touch signals
//     /photoOfDay/{photoId}                            — daily photo prompt
//     /coupleProfile/{docId}                           — aggregated insights
//     /anniversaries/{id}                              — anniversary events
//     /memories/{id}                                   — Time Tree memories
//     /timeTreeMeta/{id}                               — Time Tree config
//     /pings/{pingId}                                  — presence heartbeats
//     /nudges/{nudgeId}                                — author: fromUserId
//     /togetherGoals/{id}                              — author: createdBy
//     /coupleChallenges/{id}                           — author: createdBy
//     /dreams/{id}                                     — author: createdBy
//     /futureLetters/{letterId}                        — sealed-letter envelope (both partners read)
//     /futureLetterBodies/{letterId}                   — letter text; get-only, recipient after opensAt (server time)
//     /notifications/{id}                              — in-app notifications
//   /ai_usage_daily/{docId}                            — server-only usage counters
//   /ai_coach_sessions/{sessionId}                     — coach session logs (owner-read)
//   /abuse_logs/{logId}                                — server-only abuse records
//   /notifications/{id}                                — global push-notification log (server-write)
//   /aiSuggestionLogs/{id}                             — server-only analytics
//
// Security model:
//   * Couple membership is the primary gate on all couple sub-collections.
//   * ai_usage_daily, abuse_logs, aiSuggestionLogs are server-admin only (deny all client).
//   * ai_coach_sessions are owner-readable (the authenticated user whose userId matches).
//   * Hard-delete of shared data is ONLY allowed when the couple doc status == "disconnected".
//   * futureLetterBodies are never listable; the recipient's get is gated on request.time >= opensAt.
//   * memories never change createdBy or id; while a capsule is sealed (request.time < unlockDate), only its author can move or remove its unlockDate.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() { return request.resource.data; }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && ('userIds' in coupleDoc(coupleId))
        && request.auth.uid in coupleDoc(coupleId).userIds;
    }

    function isDisconnectedCouple(coupleId) {
      return isCoupleMember(coupleId)
        && coupleDoc(coupleId).get('status', 'active') == 'disconnected';
    }

    function isUnpaired(userData) {
      return !('coupleId' in userData)
        || userData.coupleId == null
        || userData.coupleId == '';
    }

    // ------------------------------------------------------------------
    // /users/{userId}
    // ------------------------------------------------------------------
    //
    // Read: self, or a verified couple-member doing a partner lookup.
    // This is tightened from the original "any signed-in user" to prevent
    // unauthenticated enumeration of all user profiles.

    match /users/{userId} {
      // Allow read if the requester is the owner, OR is already in the same
      // couple (partner lookup), OR the target is still unpaired (pairing flow).
      allow read: if isSelf(userId)
                  || (isSignedIn() && resource.data.get('coupleId', '') != ''
                      && isCoupleMember(resource.data.coupleId))
                  || (isSignedIn() && isUnpaired(resource.data));

      allow create: if isSelf(userId);

      allow update: if isSignedIn() && (
        isSelf(userId)

        // Pairing join — attaching as the partner of an unpaired user.
        || (
          isUnpaired(resource.data)
          && 'partnerId' in incoming()
          && incoming().partnerId == request.auth.uid
        )

        // Disconnect — the current partner clearing the pairing fields.
        || (
          'partnerId' in resource.data
          && resource.data.partnerId == request.auth.uid
        )
      );

      allow delete: if isSelf(userId);
    }

    // ------------------------------------------------------------------
    // /pairingCodes/{code}
    // ------------------------------------------------------------------

    match /pairingCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && incoming().creatorId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.creatorId == request.auth.uid
                    && incoming().creatorId == request.auth.uid;

      allow delete: if isSignedIn();
    }

    // ------------------------------------------------------------------
    // /couples/{coupleId}
    // ------------------------------------------------------------------

    match /couples/{coupleId} {

      allow get, list: if isSignedIn()
                       && resource != null
                       && 'userIds' in resource.data
                       && request.auth.uid in resource.data.userIds;

      allow create: if isSignedIn()
                    && incoming().userIds is list
                    && incoming().userIds.size() == 2
                    && request.auth.uid in incoming().userIds;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.userIds
                    && (
                      !('userIds' in incoming())
                      || (
                        incoming().userIds is list
                        && incoming().userIds.hasAll(resource.data.userIds)
                      )
                    );

      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.userIds
                    && resource.data.get('status', 'active') == 'disconnected';

      // ---- Shared mood feed ----
      match /moods/{moodId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && incoming().userId == request.auth.uid;
        allow update: if isCoupleMember(coupleId)
                      && resource.data.userId == request.auth.uid;
        allow delete: if isCoupleMember(coupleId) && (
          resource.data.userId == request.auth.uid
          || isDisconnectedCouple(coupleId)
        );

        match /reactions/{reactionId} {
          allow read: if isCoupleMember(coupleId);
          allow create: if isCoupleMember(coupleId)
                        && incoming().userId == request.auth.uid;
          allow update: if isCoupleMember(coupleId)
                        && resource.data.userId == request.auth.uid;
          allow delete: if isCoupleMember(coupleId) && (
            resource.data.userId == request.auth.uid
            || isDisconnectedCouple(coupleId)
          );
        }
      }

      // ---- Daily sync score rollups ----
      match /syncScores/{date} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Chat messages ----
      match /messages/{messageId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('senderId' in incoming())
                        || incoming().senderId == null
                        || incoming().senderId == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Photo of the day ----
      match /photoOfDay/{photoId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Live room (typing / touch-together signals) ----
      // Ephemeral, cosmetic, and rewritten every couple of seconds. Nothing
      // here is read back as a fact about the relationship, so couple
      // membership is the whole gate.
      match /liveState/{docId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Chat quizzes ----
      match /quizzes/{quizId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Aggregated couple insight profile ----
      match /coupleProfile/{docId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Anniversary countdowns ----
      match /anniversaries/{anniversaryId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Time Tree memories (past moments + capsules) ----
      // A capsule is a memory with an unlockDate. It is sealed for BOTH
      // partners until that moment by the SERVER clock (request.time), and
      // until then only its author can move or remove its unlockDate.
      // Nobody can reassign createdBy, and the id field always names its own
      // document (the app reads a memory's identity from that field).
      //
      // Only unlockDate is guarded. The note and photo travel in this same
      // document, so before the unlock they are hidden by the app, not by
      // these rules; future letters are the server-locked kind.
      //
      // 1.1 and 1.2 clients re-send every field on each edit via
      // setData(merge:), unlockDate included, after a Date <-> Timestamp
      // round trip that can move it by a microsecond. The ±1 s window in
      // unlockDateHeld absorbs that, so their edits of a partner's sealed
      // capsule still land as long as they leave the date alone.
      //
      // Delete stays open to both members, because 1.2 offered it to both.
      match /memories/{memoryId} {
        function memorySealed(data) {
          return data.get('unlockDate', null) is timestamp
            && data.unlockDate > request.time;
        }

        function unlockDateHeld(before, after) {
          return after.get('unlockDate', null) is timestamp
            && after.unlockDate >= before.unlockDate - duration.value(1, 's')
            && after.unlockDate <= before.unlockDate + duration.value(1, 's');
        }

        allow read:   if isCoupleMember(coupleId);

        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      )
                      && (
                        !('id' in incoming())
                        || incoming().id == memoryId
                      );

        allow update: if isCoupleMember(coupleId)
                      && incoming().get('createdBy', null) == resource.data.get('createdBy', null)
                      && incoming().get('id', memoryId) == resource.data.get('id', memoryId)
                      && (
                        !memorySealed(resource.data)
                        || resource.data.get('createdBy', null) == request.auth.uid
                        || unlockDateHeld(resource.data, incoming())
                      );

        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Time Tree metadata (relationship anchor + future tree config) ----
      match /timeTreeMeta/{docId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Presence / ping firehose ----
      match /pings/{pingId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('fromUserId' in incoming())
                        || incoming().fromUserId == request.auth.uid
                      );
        allow update: if false;
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- In-app notifications ----
      match /notifications/{notifId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Nudges (poke-style messages between partners) ----
      match /nudges/{nudgeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('fromUserId' in incoming())
                        || incoming().fromUserId == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Together goals ----
      match /togetherGoals/{goalId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Couple challenges (shared streak / check-in tracking) ----
      match /coupleChallenges/{challengeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Dream board ----
      match /dreams/{dreamId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Future letters ----
      // One partner seals a letter for the other and picks a moment (opensAt).
      // Two documents per letter, same id, created in ONE batch:
      //
      //   futureLetters/{letterId}       the envelope: who, to whom, when.
      //                                  Both partners read it (Home pins it
      //                                  with a countdown). Never any text.
      //   futureLetterBodies/{letterId}  the words. Single-document get only:
      //                                  rules see no data when they authorise
      //                                  a list, so a time-gated read can never
      //                                  be a query. The recipient's get needs
      //                                  the SERVER clock past opensAt.
      //
      // Nothing is editable after sealing except the recipient stamping
      // openedAt once. The sender can unsend (both docs, one batch) only
      // before opensAt; a disconnected couple can purge everything.
      match /futureLetters/{letterId} {
        allow read: if isCoupleMember(coupleId);

        // No minimum lead: a seal queued offline may reach the server after
        // its moment, and must still land (it simply arrives ready).
        allow create: if isCoupleMember(coupleId)
                      && coupleDoc(coupleId).get('status', 'active') != 'disconnected'
                      && incoming().keys().hasOnly(['id', 'fromUserId', 'toUserId', 'opensAt', 'sealedAt'])
                      && incoming().id == letterId
                      && incoming().fromUserId == request.auth.uid
                      && incoming().toUserId is string
                      && incoming().toUserId != request.auth.uid
                      && incoming().toUserId in coupleDoc(coupleId).userIds
                      && incoming().opensAt is timestamp
                      && incoming().opensAt < request.time + duration.value(3700, 'd')
                      && incoming().sealedAt == request.time
                      && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetterBodies/$(letterId));

        // The recipient breaks the seal: once, only after opensAt by the
        // server clock, only that field, stamped with the server time.
        allow update: if isCoupleMember(coupleId)
                      && resource.data.toUserId == request.auth.uid
                      && request.time >= resource.data.opensAt
                      && !('openedAt' in resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])
                      && incoming().openedAt == request.time;

        // Purge after a disconnect, or the sender unsending (with its body,
        // same batch) while it is still sealed.
        allow delete: if isDisconnectedCouple(coupleId)
                      || (isCoupleMember(coupleId)
                          && resource.data.fromUserId == request.auth.uid
                          && request.time < resource.data.opensAt
                          && !existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetterBodies/$(letterId)));
      }

      match /futureLetterBodies/{letterId} {
        // THE TIME LOCK. Reads this document's own copy of from/to/opensAt,
        // which nobody can change (there is no update path).
        allow get: if isCoupleMember(coupleId)
                   && (resource.data.fromUserId == request.auth.uid
                       || (resource.data.toUserId == request.auth.uid
                           && request.time >= resource.data.opensAt
                           && coupleDoc(coupleId).get('status', 'active') != 'disconnected'));

        allow list: if false;

        // Only inside the batch that creates its envelope, by its sender,
        // with the envelope's exact recipient and opening time.
        allow create: if isCoupleMember(coupleId)
                      && incoming().keys().hasOnly(['fromUserId', 'toUserId', 'opensAt', 'text'])
                      && incoming().fromUserId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 100000
                      && !exists(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId))
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.fromUserId == request.auth.uid
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.toUserId == incoming().toUserId
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.opensAt == incoming().opensAt;

        allow update: if false;

        allow delete: if isDisconnectedCouple(coupleId)
                      || (isCoupleMember(coupleId)
                          && resource.data.fromUserId == request.auth.uid
                          && request.time < resource.data.opensAt
                          && !existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)));
      }
    }

    // ------------------------------------------------------------------
    // /ai_usage_daily/{docId}
    // ------------------------------------------------------------------
    // Written and read exclusively by Cloud Functions (Admin SDK).
    // Clients cannot read, write, or infer their own quota state from here —
    // the 429 response from the function is the only signal they get.

    match /ai_usage_daily/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /ai_coach_sessions/{sessionId}
    // ------------------------------------------------------------------
    // Clients may read their own session logs (for history / stats) but
    // may never write — the server is the only writer.

    match /ai_coach_sessions/{sessionId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // /abuse_logs/{logId}
    // ------------------------------------------------------------------
    // Strictly server-only. Never exposed to clients.

    match /abuse_logs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /aiSuggestionLogs/{logId}
    // ------------------------------------------------------------------
    // Analytics — server-only.

    match /aiSuggestionLogs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /notifications/{id}  (global push-notification log)
    // ------------------------------------------------------------------
    // Written by Cloud Functions via Admin SDK.
    // Not exposed to clients (couple-scoped in-app notifications live
    // under couples/{id}/notifications instead).

    match /notifications/{notifId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Catch-all: deny everything not explicitly allowed above.
    // ------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
