rules_version = '2';

// Firestore security rules for Coupley.
//
// Data model:
//   /users/{uid}                                       — user profile + tokens
//   /pairingCodes/{code}                               — ephemeral invite codes
//   /couples/{coupleId}                                — userIds: [uidA, uidB]
//     /moods/{moodId}                                  — author: userId
//       /reactions/{reactionId}                        — author: userId
//     /syncScores/{date}                               — daily rollup
//     /messages/{msgId}                                — chat messages
//     /quizzes/{quizId}                                — chat quizzes
//     /liveState/{docId}                               — typing / touch signals
//     /photoOfDay/{photoId}                            — daily photo prompt
//     /coupleProfile/{docId}                           — aggregated insights
//     /anniversaries/{id}                              — anniversary events
//     /memories/{id}                                   — Time Tree memories
//     /timeTreeMeta/{id}                               — the start date (open, 1.1/1.2 write it) and the garden (trees, proposals, waterings, waterers)
//     /pings/{pingId}                                  — presence heartbeats
//     /nudges/{nudgeId}                                — author: fromUserId
//     /togetherGoals/{id}                              — author: createdBy
//     /coupleChallenges/{id}                           — author: createdBy
//     /dreams/{id}                                     — author: createdBy
//     /futureLetters/{letterId}                        — sealed-letter envelope (both partners read)
//     /futureLetterBodies/{letterId}                   — letter text; get-only, recipient after opensAt (server time)
//     /notifications/{id}                              — in-app notifications
//   /ai_usage_daily/{docId}                            — server-only usage counters
//   /ai_coach_sessions/{sessionId}                     — coach session logs (owner-read)
//   /abuse_logs/{logId}                                — server-only abuse records
//   /notifications/{id}                                — global push-notification log (server-write)
//   /aiSuggestionLogs/{id}                             — server-only analytics
//   /appConfig/{docId}                                 — read-only app switches
//
// Security model:
//   * Couple membership is the primary gate on all couple sub-collections.
//   * ai_usage_daily, abuse_logs, aiSuggestionLogs are server-admin only (deny all client).
//   * ai_coach_sessions are owner-readable (the authenticated user whose userId matches).
//   * A couple's userIds never change after pairing, and its status only ever moves to "disconnected".
//   * Hard-delete of shared data is ONLY allowed when the couple doc status == "disconnected".
//   * futureLetterBodies are never listable; the recipient's get is gated on request.time >= opensAt.
//   * memories never change createdBy or id; while a capsule is sealed (request.time < unlockDate), only its author can move or remove its unlockDate.
//   * timeTreeMeta: config stays open; garden trees are written only by the member who did not make the proposal (or recorded from an existing start date), one watering per member per 12 hours, all times request.time.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() { return request.resource.data; }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && ('userIds' in coupleDoc(coupleId))
        && request.auth.uid in coupleDoc(coupleId).userIds;
    }

    function isDisconnectedCouple(coupleId) {
      return isCoupleMember(coupleId)
        && coupleDoc(coupleId).get('status', 'active') == 'disconnected';
    }

    function isUnpaired(userData) {
      return !('coupleId' in userData)
        || userData.coupleId == null
        || userData.coupleId == '';
    }

    // ------------------------------------------------------------------
    // /users/{userId}
    // ------------------------------------------------------------------
    //
    // Read: self, or a verified couple-member doing a partner lookup.
    // This is tightened from the original "any signed-in user" to prevent
    // unauthenticated enumeration of all user profiles.

    match /users/{userId} {
      // Allow read if the requester is the owner, OR is already in the same
      // couple (partner lookup), OR the target is still unpaired (pairing flow).
      allow read: if isSelf(userId)
                  || (isSignedIn() && resource.data.get('coupleId', '') != ''
                      && isCoupleMember(resource.data.coupleId))
                  || (isSignedIn() && isUnpaired(resource.data));

      allow create: if isSelf(userId);

      allow update: if isSignedIn() && (
        isSelf(userId)

        // Pairing join — attaching as the partner of an unpaired user.
        || (
          isUnpaired(resource.data)
          && 'partnerId' in incoming()
          && incoming().partnerId == request.auth.uid
        )

        // Disconnect — the current partner clearing the pairing fields.
        || (
          'partnerId' in resource.data
          && resource.data.partnerId == request.auth.uid
        )
      );

      allow delete: if isSelf(userId);
    }

    // ------------------------------------------------------------------
    // /pairingCodes/{code}
    // ------------------------------------------------------------------

    match /pairingCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && incoming().creatorId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.creatorId == request.auth.uid
                    && incoming().creatorId == request.auth.uid;

      allow delete: if isSignedIn();
    }

    // ------------------------------------------------------------------
    // /couples/{coupleId}
    // ------------------------------------------------------------------

    match /couples/{coupleId} {

      allow get, list: if isSignedIn()
                       && resource != null
                       && 'userIds' in resource.data
                       && request.auth.uid in resource.data.userIds;

      allow create: if isSignedIn()
                    && incoming().userIds is list
                    && incoming().userIds.size() == 2
                    && request.auth.uid in incoming().userIds;

      // Pairing creates the couple with both ids; after that the ids never
      // change, and status moves one way: once 'disconnected', a couple never
      // becomes active again (a new pairing is a new couple). "The partner"
      // (garden consent, places, notes) is the one other id, and every
      // shared-data gate reads status, so neither may be rewritten. Every app
      // version updates the couple with setData(merge: true), which keeps
      // both: disconnect, premium, streak, chat, daily question and photo.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.userIds
                    && incoming().get('userIds', null) == resource.data.userIds
                    && (
                      resource.data.get('status', 'active') != 'disconnected'
                      || incoming().get('status', 'active') == 'disconnected'
                    );

      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.userIds
                    && resource.data.get('status', 'active') == 'disconnected';

      // ---- Shared mood feed ----
      match /moods/{moodId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && incoming().userId == request.auth.uid;
        allow update: if isCoupleMember(coupleId)
                      && resource.data.userId == request.auth.uid;
        allow delete: if isCoupleMember(coupleId) && (
          resource.data.userId == request.auth.uid
          || isDisconnectedCouple(coupleId)
        );

        match /reactions/{reactionId} {
          allow read: if isCoupleMember(coupleId);
          allow create: if isCoupleMember(coupleId)
                        && incoming().userId == request.auth.uid;
          allow update: if isCoupleMember(coupleId)
                        && resource.data.userId == request.auth.uid;
          allow delete: if isCoupleMember(coupleId) && (
            resource.data.userId == request.auth.uid
            || isDisconnectedCouple(coupleId)
          );
        }
      }

      // ---- Daily sync score rollups ----
      match /syncScores/{date} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Chat messages ----
      match /messages/{messageId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('senderId' in incoming())
                        || incoming().senderId == null
                        || incoming().senderId == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Photo of the day ----
      match /photoOfDay/{photoId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Live room (typing / touch-together signals) ----
      // Ephemeral, cosmetic, and rewritten every couple of seconds. Nothing
      // here is read back as a fact about the relationship, so couple
      // membership is the whole gate.
      match /liveState/{docId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Chat quizzes ----
      match /quizzes/{quizId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Aggregated couple insight profile ----
      match /coupleProfile/{docId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- Anniversary countdowns ----
      match /anniversaries/{anniversaryId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Time Tree memories (past moments + capsules) ----
      // A capsule is a memory with an unlockDate. It is sealed for BOTH
      // partners until that moment by the SERVER clock (request.time), and
      // until then only its author can move or remove its unlockDate.
      // Nobody can reassign createdBy, and the id field always names its own
      // document (the app reads a memory's identity from that field).
      //
      // Only unlockDate is guarded. The note and photo travel in this same
      // document, so before the unlock they are hidden by the app, not by
      // these rules; future letters are the server-locked kind.
      //
      // 1.1 and 1.2 clients re-send every field on each edit via
      // setData(merge:), unlockDate included, after a Date <-> Timestamp
      // round trip that can move it by a microsecond. The ±1 s window in
      // unlockDateHeld absorbs that, so their edits of a partner's sealed
      // capsule still land as long as they leave the date alone.
      //
      // Delete stays open to both members, because 1.2 offered it to both.
      match /memories/{memoryId} {
        function memorySealed(data) {
          return data.get('unlockDate', null) is timestamp
            && data.unlockDate > request.time;
        }

        function unlockDateHeld(before, after) {
          return after.get('unlockDate', null) is timestamp
            && after.unlockDate >= before.unlockDate - duration.value(1, 's')
            && after.unlockDate <= before.unlockDate + duration.value(1, 's');
        }

        allow read:   if isCoupleMember(coupleId);

        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      )
                      && (
                        !('id' in incoming())
                        || incoming().id == memoryId
                      );

        allow update: if isCoupleMember(coupleId)
                      && incoming().get('createdBy', null) == resource.data.get('createdBy', null)
                      && incoming().get('id', memoryId) == resource.data.get('id', memoryId)
                      && (
                        !memorySealed(resource.data)
                        || resource.data.get('createdBy', null) == request.auth.uid
                        || unlockDateHeld(resource.data, incoming())
                      );

        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Time Tree metadata: the start date and the shared garden ----
      //
      // ONE flat collection, never a subcollection: every shared-data purge
      // since 1.2 deletes this collection page by page, so the garden's
      // places and notes leave with it.
      //
      //   config            The start date. Exactly as open as 1.1/1.2 need it
      //                     (they set it directly). Every day count reads it.
      //   tree_our          Our tree; tree_p1 … tree_p7 place trees. The slot is
      //                     the id, so a garden holds 8 trees at most; a new
      //                     place tree takes the lowest free slot.
      //   seed_our          A proposal to plant Our tree (only while no config).
      //   seed_<uid>_<n>    A proposal to plant a place tree; n is 1-3 and a
      //                     member creates only their own ids (3 open at most).
      //   change_<slot>     A proposed new name / place / moment / look.
      //   rest_p1 … p7      A proposal to let a place tree go.
      //   startdate         A proposed new start date.
      //   water_<20>        One watering: who, server time, note, effect.
      //   waterer_<uid>     That member's last watering (one per 12 hours).
      //
      // A tree is planted or changed only by the member who did NOT make the
      // proposal's latest version, in ONE transaction that copies it exactly
      // and deletes it. Every time a partner is shown is request.time.
      match /timeTreeMeta/{docId} {

        function meta(id) {
          return /databases/$(database)/documents/couples/$(coupleId)/timeTreeMeta/$(id);
        }
        function me() { return request.auth.uid; }
        function active() {
          return isCoupleMember(coupleId)
            && coupleDoc(coupleId).get('status', 'active') != 'disconnected';
        }
        function changed() { return incoming().diff(resource.data).affectedKeys(); }

        // Within a second: Date <-> Timestamp round trips in the iOS SDK can
        // move an instant by a microsecond, and 1.1/1.2 store raw instants.
        function sameInstant(a, b) {
          return a is timestamp && b is timestamp
            && a > b - duration.value(1, 's')
            && a < b + duration.value(1, 's');
        }
        // A calendar day (JourneyCalendarDay.storedMoment, 10:00 UTC today).
        // The hour is NEVER checked.
        function isDay(t) {
          return t is timestamp
            && t > timestamp.date(1900, 1, 1)
            && t < request.time + duration.value(2, 'd');
        }
        function isText(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
        function optText(m, k, max) { return !(k in m) || isText(m[k], max); }
        function isToken(s) { return s is string && s.matches('^[a-zA-Z]{1,32}$'); }
        function isKey(s) { return s is string && s.matches('^[A-Za-z0-9-]{8,64}$'); }
        function isRounded(x, scale) {
          return math.abs(x * scale - math.round(x * scale)) < 0.000001;
        }

        // A place the couple chose. "Only the area" is a promise the server keeps.
        function isPlace(p) {
          return p is map
            && p.keys().hasAll(['name', 'lat', 'lng', 'precision'])
            && p.keys().hasOnly(['name', 'locality', 'lat', 'lng', 'precision', 'poi', 'tz'])
            && isText(p.name, 320)
            && optText(p, 'locality', 320)
            && optText(p, 'poi', 64)
            && optText(p, 'tz', 64)
            && p.lat is number && p.lat >= -90 && p.lat <= 90
            && p.lng is number && p.lng >= -180 && p.lng <= 180
            && ((p.precision == 'exact' && isRounded(p.lat, 10000) && isRounded(p.lng, 10000))
                || (p.precision == 'area' && isRounded(p.lat, 100) && isRounded(p.lng, 100)));
        }

        // What a tree is. `slot`: 'our', 'new' (a place seed) or 'p1'…'p7'.
        // Scene, species and preset are tokens, not lists: a later app may add
        // looks without a rules deploy (unknown ones draw as Meadow / oak).
        function isContent(m, slot) {
          return isText(m.title, 160)
            && isToken(m.preset) && isToken(m.scene) && isToken(m.species)
            && (!('place' in m) || isPlace(m.place))
            && (slot == 'our'
                  ? (m.preset == 'ourTree' && !('momentDay' in m))
                  : (m.preset != 'ourTree' && (!('momentDay' in m) || isDay(m.momentDay))));
        }
        function sameDay(a, b) {
          return (!('momentDay' in a) && !('momentDay' in b))
            || ('momentDay' in a && 'momentDay' in b && sameInstant(a.momentDay, b.momentDay));
        }
        function sameContent(a, b) {
          return a.title == b.title && a.preset == b.preset
            && a.scene == b.scene && a.species == b.species
            && a.get('place', null) == b.get('place', null)
            && sameDay(a, b);
        }

        function isTreeDoc() { return docId.matches('^tree_(our|p[1-7])$'); }
        function isPlaceSeedDoc() { return docId.matches('^seed_[A-Za-z0-9]{1,128}_[1-3]$'); }
        // Creating a place seed: only my own three ids (string equality, no
        // regex built from the uid), so open seeds are bounded by construction.
        function isMySeedDoc() {
          return docId == 'seed_' + me() + '_1' || docId == 'seed_' + me() + '_2'
            || docId == 'seed_' + me() + '_3';
        }
        function isProposalDoc() {
          return docId == 'seed_our' || docId == 'startdate' || isPlaceSeedDoc()
            || docId.matches('^change_(our|p[1-7])$') || docId.matches('^rest_p[1-7]$');
        }
        function isWaterDoc() { return docId.matches('^water_[A-Za-z0-9]{20}$'); }
        function isWatererDoc() { return docId == 'waterer_' + me(); }

        // ---------- proposals ----------

        function proposalKeys() {
          return ['docType', 'kind', 'slot', 'key', 'by', 'at', 'rev', 'note',
                  'startDay', 'fromStartDay',
                  'title', 'preset', 'momentDay', 'place', 'scene', 'species'];
        }
        function treeOf(slot) { return get(meta('tree_' + slot)).data; }

        // The id says what a proposal is about, so two of a kind collide
        // instead of piling up. Our tree's seed is void once a start date
        // exists; a start-date suggestion is void once the date moves.
        function proposalFits(m) {
          return (docId == 'seed_our' && m.kind == 'plant' && m.slot == 'our'
                    && !exists(meta('config'))
                    && isDay(m.startDay) && !('fromStartDay' in m)
                    && isContent(m, 'our'))
            || (isPlaceSeedDoc() && m.kind == 'plant' && m.slot == 'new'
                    && exists(meta('config'))
                    && !m.keys().hasAny(['startDay', 'fromStartDay'])
                    && isContent(m, 'new'))
            || (docId == 'change_' + m.slot && m.kind == 'change'
                    && exists(meta('tree_' + m.slot)) && m.key == treeOf(m.slot).key
                    && !m.keys().hasAny(['startDay', 'fromStartDay'])
                    && isContent(m, m.slot))
            || (docId == 'rest_' + m.slot && m.kind == 'rest' && m.slot != 'our'
                    && exists(meta('tree_' + m.slot)) && m.key == treeOf(m.slot).key
                    && !m.keys().hasAny(['startDay', 'fromStartDay', 'title', 'preset',
                                         'momentDay', 'place', 'scene', 'species']))
            || (docId == 'startdate' && m.kind == 'startDate' && m.slot == 'our'
                    && exists(meta('tree_our')) && m.key == treeOf('our').key
                    && isDay(m.startDay)
                    && sameInstant(m.fromStartDay, get(meta('config')).data.startDate)
                    && !m.keys().hasAny(['title', 'preset', 'momentDay', 'place',
                                         'scene', 'species']));
        }

        // Created by its proposer, or answered with a new version: whoever
        // writes it becomes the proposer, and the OTHER member must answer.
        function isProposal(m, previousRev) {
          return m.keys().hasOnly(proposalKeys())
            && m.docType == 'proposal'
            && isKey(m.key)
            && m.by == me()
            && m.at == request.time
            && m.rev == previousRev + 1
            && optText(m, 'note', 560)
            && proposalFits(m);
        }

        // ---------- trees ----------

        function treeKeys() {
          return ['docType', 'slot', 'key', 'title', 'preset', 'momentDay', 'place',
                  'scene', 'species', 'origin', 'plantedAt', 'plantedBy', 'agreedStartDay',
                  'agreementKind', 'agreementBy', 'agreementAt', 'fromProposal',
                  'lookBy', 'lookAt', 'prevScene', 'prevSpecies', 'updatedAt'];
        }
        function isTree(m) {
          return m.keys().hasOnly(treeKeys())
            && m.docType == 'tree'
            && docId == 'tree_' + m.slot
            && isKey(m.key)
            && isContent(m, m.slot)
            && ((m.slot == 'our') == ('agreedStartDay' in m))
            && m.updatedAt == request.time;
        }

        // A place tree takes the lowest free slot, as the app plants it
        // (GardenTransactions.plantPlaceTree): every slot below `s` was
        // planted BEFORE this commit (exists() reads the state before it), so
        // one commit plants at most one place tree and one seed becomes one
        // tree. `s` is 'p1' … 'p7' (one digit: they compare as strings).
        // The paths share one prefix string: a planting into p7 is the
        // garden's costliest write against the 1,000-expression budget of a
        // request, and six meta() paths cost about 30 expressions more.
        function lowerSlotsFilled(s) {
          let t = '/databases/' + database + '/documents/couples/' + coupleId + '/timeTreeMeta/tree_';
          return (s <= 'p1' || exists(path(t + 'p1')))
            && (s <= 'p2' || exists(path(t + 'p2')))
            && (s <= 'p3' || exists(path(t + 'p3')))
            && (s <= 'p4' || exists(path(t + 'p4')))
            && (s <= 'p5' || exists(path(t + 'p5')))
            && (s <= 'p6' || exists(path(t + 'p6')));
        }

        // Planted together: the partner's seed, exactly, deleted in this same
        // transaction, stamped with the server's time and both names. Our
        // tree's first planting also writes the start date, in the 1.2 format.
        function plantedFrom(m) {
          let id = m.fromProposal;
          let p = get(meta(id)).data;
          return (id == 'seed_our' || id.matches('^seed_[A-Za-z0-9]{1,128}_[1-3]$'))
            && exists(meta(id)) && !existsAfter(meta(id))
            && p.kind == 'plant'
            && p.by != me()
            && p.by in coupleDoc(coupleId).userIds
            && ((m.slot == 'our') == (p.slot == 'our'))
            && (m.slot == 'our' || lowerSlotsFilled(m.slot))
            && m.key == p.key
            && sameContent(m, p)
            && m.origin == 'together'
            && m.plantedAt == request.time
            && m.plantedBy == [p.by, me()]
            && m.agreementKind == 'plant'
            && m.agreementBy == [p.by, me()]
            && m.agreementAt == request.time
            && !m.keys().hasAny(['lookBy', 'lookAt', 'prevScene', 'prevSpecies'])
            && (m.slot != 'our'
                || (!exists(meta('config'))
                    && sameInstant(getAfter(meta('config')).data.startDate, p.startDay)
                    && sameInstant(m.agreedStartDay, p.startDay)));
        }

        // Our tree from a start date set before the garden (or by an older
        // app): recorded as it is, by either partner. Never with a place.
        function recordedLegacy(m) {
          return m.slot == 'our'
            && exists(meta('config'))
            && m.origin == 'legacy'
            && !m.keys().hasAny(['momentDay', 'place', 'plantedAt', 'plantedBy', 'fromProposal',
                                 'lookBy', 'lookAt', 'prevScene', 'prevSpecies'])
            && sameInstant(m.agreedStartDay, get(meta('config')).data.startDate)
            && m.agreementKind == 'recorded'
            && m.agreementBy == [me()]
            && m.agreementAt == request.time;
        }

        function keepsIdentity() {
          return incoming().slot == resource.data.slot
            && incoming().key == resource.data.key
            && incoming().origin == resource.data.origin
            && incoming().get('plantedAt', null) == resource.data.get('plantedAt', null)
            && incoming().get('plantedBy', null) == resource.data.get('plantedBy', null);
        }
        // A new look, by either of you, at any time: only the look changes.
        function looksChanged() {
          return changed().hasOnly(['scene', 'species', 'prevScene', 'prevSpecies',
                                    'lookBy', 'lookAt', 'updatedAt'])
            && isToken(incoming().prevScene) && isToken(incoming().prevSpecies)
            && incoming().lookBy == me()
            && incoming().lookAt == request.time;
        }
        // A change the partner proposed: exactly its content, deleted with it.
        function changedFrom(m) {
          let id = 'change_' + m.slot;
          let p = get(meta(id)).data;
          return m.fromProposal == id
            && exists(meta(id)) && !existsAfter(meta(id))
            && p.by != me() && p.by in coupleDoc(coupleId).userIds
            && p.key == m.key
            && sameContent(m, p)
            && m.agreementKind == 'change'
            && m.agreementBy == [p.by, me()]
            && m.agreementAt == request.time
            && changed().hasOnly(['title', 'preset', 'momentDay', 'place', 'scene', 'species',
                                  'fromProposal', 'agreementKind', 'agreementBy',
                                  'agreementAt', 'updatedAt']);
        }
        // A start date the partner proposed against the date as it STILL is,
        // written to config in the same transaction.
        function startDateFrom(m) {
          let p = get(meta('startdate')).data;
          return m.slot == 'our'
            && m.fromProposal == 'startdate'
            && exists(meta('startdate')) && !existsAfter(meta('startdate'))
            && p.by != me() && p.by in coupleDoc(coupleId).userIds
            && p.key == m.key
            && sameInstant(get(meta('config')).data.startDate, p.fromStartDay)
            && sameInstant(getAfter(meta('config')).data.startDate, p.startDay)
            && sameInstant(m.agreedStartDay, p.startDay)
            && m.agreementKind == 'startDate'
            && m.agreementBy == [p.by, me()]
            && m.agreementAt == request.time
            && changed().hasOnly(['agreedStartDay', 'fromProposal', 'agreementKind',
                                  'agreementBy', 'agreementAt', 'updatedAt']);
        }
        // An older app changed config directly: recorded as it now is.
        function reRecorded(m) {
          return m.slot == 'our'
            && sameInstant(m.agreedStartDay, get(meta('config')).data.startDate)
            && m.agreementKind == 'recorded'
            && m.agreementBy == [me()]
            && m.agreementAt == request.time
            && changed().hasOnly(['agreedStartDay', 'agreementKind', 'agreementBy',
                                  'agreementAt', 'updatedAt']);
        }

        // ---------- waterings ----------

        // The watering and the waterer's own turn travel in one batch; the
        // time is the server's; Our tree must exist.
        function isWatering(m) {
          return m.keys().hasOnly(['docType', 'by', 'wateredAt', 'note', 'effect'])
            && m.docType == 'water'
            && m.by == me()
            && m.wateredAt == request.time
            && optText(m, 'note', 400)
            && isToken(m.effect)
            && exists(meta('config'))
            && getAfter(meta('waterer_' + me())).data.lastWateringId == docId
            && getAfter(meta('waterer_' + me())).data.lastWateredAt == request.time;
        }
        function isTurn(m) {
          return m.keys().hasOnly(['docType', 'lastWateredAt', 'lastWateringId'])
            && m.docType == 'waterer'
            && m.lastWateredAt == request.time
            && m.lastWateringId is string
            && m.lastWateringId.matches('^water_[A-Za-z0-9]{20}$')
            && !exists(meta(m.lastWateringId))
            && existsAfter(meta(m.lastWateringId));
        }

        // ---------- access ----------

        allow read: if isCoupleMember(coupleId);

        allow create: if (docId == 'config' && isCoupleMember(coupleId))   // unchanged since 1.2
          || (isProposalDoc() && active() && isProposal(incoming(), 0)
              && (!isPlaceSeedDoc() || isMySeedDoc()))
          || (isTreeDoc() && active() && isTree(incoming())
              && (plantedFrom(incoming()) || recordedLegacy(incoming())))
          || (isWaterDoc() && active() && isWatering(incoming()))
          || (isWatererDoc() && active() && isTurn(incoming()));

        allow update: if (docId == 'config' && isCoupleMember(coupleId))   // unchanged since 1.2
          || (isProposalDoc() && active()
              && isProposal(incoming(), resource.data.rev)
              && incoming().kind == resource.data.kind
              && incoming().slot == resource.data.slot
              && incoming().key == resource.data.key)
          || (isTreeDoc() && active() && isTree(incoming()) && keepsIdentity()
              && (looksChanged() || changedFrom(incoming())
                  || startDateFrom(incoming()) || reRecorded(incoming())))
          // Once per 12 hours per person (11 h 50 min of grace).
          || (isWatererDoc() && active() && isTurn(incoming())
              && request.time > resource.data.lastWateredAt + duration.value(710, 'm'));

        // The purge (any app version) right after config, so a 300-document
        // batch costs one couple read; then the garden's own deletes: any
        // member may delete a proposal (taken back, let go, kept, carried
        // out: the tree rules check that write); a place tree goes only with
        // the partner's rest request, in the same transaction.
        allow delete: if (docId == 'config' && isCoupleMember(coupleId))   // unchanged since 1.2
          || isDisconnectedCouple(coupleId)
          || (isProposalDoc() && isCoupleMember(coupleId))
          || (docId.matches('^tree_p[1-7]$') && active()
              && exists(meta('rest_' + docId.split('_')[1]))
              && !existsAfter(meta('rest_' + docId.split('_')[1]))
              && get(meta('rest_' + docId.split('_')[1])).data.by != me()
              && get(meta('rest_' + docId.split('_')[1])).data.key == resource.data.key);
      }

      // ---- Presence / ping firehose ----
      match /pings/{pingId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('fromUserId' in incoming())
                        || incoming().fromUserId == request.auth.uid
                      );
        allow update: if false;
        allow delete: if isDisconnectedCouple(coupleId);
      }

      // ---- In-app notifications ----
      match /notifications/{notifId} {
        allow read:   if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Nudges (poke-style messages between partners) ----
      match /nudges/{nudgeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('fromUserId' in incoming())
                        || incoming().fromUserId == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Together goals ----
      match /togetherGoals/{goalId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Couple challenges (shared streak / check-in tracking) ----
      match /coupleChallenges/{challengeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Dream board ----
      match /dreams/{dreamId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
                      && (
                        !('createdBy' in incoming())
                        || incoming().createdBy == request.auth.uid
                      );
        allow update: if isCoupleMember(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      // ---- Future letters ----
      // One partner seals a letter for the other and picks a moment (opensAt).
      // Two documents per letter, same id, created in ONE batch:
      //
      //   futureLetters/{letterId}       the envelope: who, to whom, when.
      //                                  Both partners read it (Home pins it
      //                                  with a countdown). Never any text.
      //   futureLetterBodies/{letterId}  the words. Single-document get only:
      //                                  rules see no data when they authorise
      //                                  a list, so a time-gated read can never
      //                                  be a query. The recipient's get needs
      //                                  the SERVER clock past opensAt.
      //
      // Nothing is editable after sealing except the recipient stamping
      // openedAt once. The sender can unsend (both docs, one batch) only
      // before opensAt; a disconnected couple can purge everything.
      match /futureLetters/{letterId} {
        allow read: if isCoupleMember(coupleId);

        // No minimum lead: a seal queued offline may reach the server after
        // its moment, and must still land (it simply arrives ready).
        allow create: if isCoupleMember(coupleId)
                      && coupleDoc(coupleId).get('status', 'active') != 'disconnected'
                      && incoming().keys().hasOnly(['id', 'fromUserId', 'toUserId', 'opensAt', 'sealedAt'])
                      && incoming().id == letterId
                      && incoming().fromUserId == request.auth.uid
                      && incoming().toUserId is string
                      && incoming().toUserId != request.auth.uid
                      && incoming().toUserId in coupleDoc(coupleId).userIds
                      && incoming().opensAt is timestamp
                      && incoming().opensAt < request.time + duration.value(3700, 'd')
                      && incoming().sealedAt == request.time
                      && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetterBodies/$(letterId));

        // The recipient breaks the seal: once, only after opensAt by the
        // server clock, only that field, stamped with the server time.
        allow update: if isCoupleMember(coupleId)
                      && resource.data.toUserId == request.auth.uid
                      && request.time >= resource.data.opensAt
                      && !('openedAt' in resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])
                      && incoming().openedAt == request.time;

        // Purge after a disconnect, or the sender unsending (with its body,
        // same batch) while it is still sealed.
        allow delete: if isDisconnectedCouple(coupleId)
                      || (isCoupleMember(coupleId)
                          && resource.data.fromUserId == request.auth.uid
                          && request.time < resource.data.opensAt
                          && !existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetterBodies/$(letterId)));
      }

      match /futureLetterBodies/{letterId} {
        // THE TIME LOCK. Reads this document's own copy of from/to/opensAt,
        // which nobody can change (there is no update path).
        allow get: if isCoupleMember(coupleId)
                   && (resource.data.fromUserId == request.auth.uid
                       || (resource.data.toUserId == request.auth.uid
                           && request.time >= resource.data.opensAt
                           && coupleDoc(coupleId).get('status', 'active') != 'disconnected'));

        allow list: if false;

        // Only inside the batch that creates its envelope, by its sender,
        // with the envelope's exact recipient and opening time.
        allow create: if isCoupleMember(coupleId)
                      && incoming().keys().hasOnly(['fromUserId', 'toUserId', 'opensAt', 'text'])
                      && incoming().fromUserId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 100000
                      && !exists(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId))
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.fromUserId == request.auth.uid
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.toUserId == incoming().toUserId
                      && getAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)).data.opensAt == incoming().opensAt;

        allow update: if false;

        allow delete: if isDisconnectedCouple(coupleId)
                      || (isCoupleMember(coupleId)
                          && resource.data.fromUserId == request.auth.uid
                          && request.time < resource.data.opensAt
                          && !existsAfter(/databases/$(database)/documents/couples/$(coupleId)/futureLetters/$(letterId)));
      }
    }

    // ------------------------------------------------------------------
    // /ai_usage_daily/{docId}
    // ------------------------------------------------------------------
    // Written and read exclusively by Cloud Functions (Admin SDK).
    // Clients cannot read, write, or infer their own quota state from here —
    // the 429 response from the function is the only signal they get.

    match /ai_usage_daily/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /ai_coach_sessions/{sessionId}
    // ------------------------------------------------------------------
    // Clients may read their own session logs (for history / stats) but
    // may never write — the server is the only writer.

    match /ai_coach_sessions/{sessionId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // /abuse_logs/{logId}
    // ------------------------------------------------------------------
    // Strictly server-only. Never exposed to clients.

    match /abuse_logs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /aiSuggestionLogs/{logId}
    // ------------------------------------------------------------------
    // Analytics — server-only.

    match /aiSuggestionLogs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /notifications/{id}  (global push-notification log)
    // ------------------------------------------------------------------
    // Written by Cloud Functions via Admin SDK.
    // Not exposed to clients (couple-scoped in-app notifications live
    // under couples/{id}/notifications instead).

    match /notifications/{notifId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // /appConfig/{docId}
    // ------------------------------------------------------------------
    // Read-only app switches. appConfig/garden doubles as the probe that
    // tells the app the garden rules are deployed (they ship together).
    match /appConfig/{docId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ------------------------------------------------------------------
    // Catch-all: deny everything not explicitly allowed above.
    // ------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
